<script>
(function () {
  'use strict';
  var SID = '{{ sid }}';

  function ready(fn) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn, { once: true });
    else fn();
  }

  ready(function initOrbit() {
    var root = document.querySelector('.orbit-master-' + SID);
    var track = document.getElementById('OrbitTrack-' + SID);
    var ring = document.getElementById('OrbitRing-' + SID);
    var leftInd = document.getElementById('EdgeLeft-' + SID);
    var rightInd = document.getElementById('EdgeRight-' + SID);
    var counter = document.getElementById('OrbitCount-' + SID);
    var live = document.getElementById('OrbitLive-' + SID);
    var dotsEl = document.getElementById('OrbitDots-' + SID);
    if (!track || !root) return;

    var cards = Array.prototype.slice.call(track.querySelectorAll('.orbit-card'));
    var dots = dotsEl ? Array.prototype.slice.call(dotsEl.querySelectorAll('.orbit-dot')) : [];
    var total = cards.length;
    if (!total) return;
    var activeIdx = -1;
    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
    var sectionVisible = true;
    var autoTimer = null;
    var dragging = false;
    var swipeLocked = false;
    var axis = null;
    var startX = 0;
    var startY = 0;
    var startScroll = 0;
    var startIdx = 0;
    var lastX = 0;
    var lastY = 0;
    var lastT = 0;
    var vel = 0;
    var pointerId = null;
    var ignoreClick = false;
    var programmatic = false;
    var scrollRaf = 0;


    function playVideo(v) {
      if (!v || reducedMotion || isTouch) return;
      v.muted = true;
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
    function pauseVideo(v) {
      if (v && !v.paused) { try { v.pause(); } catch (e) {} }
    }

    function maxScroll() {
      return Math.max(0, track.scrollWidth - track.clientWidth);
    }

    function cardTargetLeft(card) {
      if (!card) return 0;
      var sl = track.scrollLeft;
      var cRect = card.getBoundingClientRect();
      var tRect = track.getBoundingClientRect();
      var center = sl + (cRect.left - tRect.left) + cRect.width / 2;
      return Math.max(0, Math.min(maxScroll(), center - track.clientWidth / 2));
    }

    function nearestIndex() {
      var tRect = track.getBoundingClientRect();
      var mid = tRect.left + tRect.width / 2;
      var best = 0;
      var bestDist = Infinity;
      for (var i = 0; i < cards.length; i++) {
        var r = cards[i].getBoundingClientRect();
        if (r.width < 2) continue;
        var dist = Math.abs((r.left + r.width / 2) - mid);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      }
      return best;
    }

    function updateEdges() {
      var sl = track.scrollLeft;
      var mx = maxScroll();
      if (leftInd) leftInd.style.opacity = sl > 24 ? '0.6' : '0';
      if (rightInd) rightInd.style.opacity = sl < (mx - 24) ? '0.6' : '0';
    }

    function setActive(idx) {
      if (idx < 0) idx = 0;
      if (idx > total - 1) idx = total - 1;
      var same = idx === activeIdx && cards[idx] && cards[idx].classList.contains('is-active');
      activeIdx = idx;
      if (!same) {
        for (var i = 0; i < cards.length; i++) {
          var on = i === idx;
          var c = cards[i];
          if (on) {
            c.classList.add('is-active');
            c.setAttribute('aria-current', 'true');
          } else {
            c.classList.remove('is-active');
            c.removeAttribute('aria-current');
            var pv = c.querySelector('video');
            if (pv) { pauseVideo(pv); pv.style.opacity = '0'; }
          }
        }
        if (counter) counter.textContent = (idx + 1 < 10 ? '0' : '') + (idx + 1);
        var card = cards[idx];
        if (live && card) live.textContent = (card.getAttribute('data-collection-title') || '') + ', ' + (idx + 1) + ' of ' + total;
        for (var d = 0; d < dots.length; d++) {
          var don = d === idx;
          dots[d].classList.toggle('is-active', don);
          dots[d].setAttribute('aria-selected', don ? 'true' : 'false');
        }
        if (card && sectionVisible && !document.hidden) {
          var v = card.querySelector('video');
          if (v) playVideo(v);
        }
        if (ring) ring.style.transform = 'rotate(' + ((360 / Math.max(total, 1)) * idx) + 'deg)';
      }
      updateEdges();
    }

    function goTo(idx, instant) {
      setActive(idx);
      var card = cards[activeIdx];
      if (!card) return;
      var left = cardTargetLeft(card);
      programmatic = true;
      try {
        track.scrollTo({ left: left, behavior: instant || reducedMotion || isTouch ? 'auto' : 'smooth' });
      } catch (err) {
        track.scrollLeft = left;
      }
      window.setTimeout(function () { programmatic = false; }, instant ? 40 : 420);
    }

    function decideIndex(dx, v) {
      if (dx < -40 || v < -0.3) return Math.min(total - 1, startIdx + 1);
      if (dx > 40 || v > 0.3) return Math.max(0, startIdx - 1);
      return startIdx;
    }

    function syncFromScroll() {
      updateEdges();
      if (dragging && axis === 'y') return;
      var idx = nearestIndex();
      if (idx !== activeIdx) setActive(idx);
    }

    function onTrackScroll() {
      if (scrollRaf) return;
      scrollRaf = requestAnimationFrame(function () {
        scrollRaf = 0;
        syncFromScroll();
      });
    }

    function beginSwipe(x, y, id) {
      dragging = true;
      swipeLocked = false;
      axis = null;
      startX = lastX = x;
      startY = lastY = y;
      startScroll = track.scrollLeft;
      startIdx = activeIdx < 0 ? nearestIndex() : activeIdx;
      lastT = performance.now();
      vel = 0;
      pointerId = id == null ? 'touch' : id;
    }

    function moveSwipe(x, y, e) {
      if (!dragging) return;
      var dx = x - startX;
      var dy = y - startY;
      if (!axis) {
        if (Math.abs(dx) < 10 && Math.abs(dy) < 10) return;
        axis = Math.abs(dx) > Math.abs(dy) * 1.15 ? 'x' : 'y';
      }
      if (axis !== 'x') {
        lastX = x;
        lastY = y;
        return;
      }
      if (e && e.cancelable) e.preventDefault();
      swipeLocked = true;
      ignoreClick = true;
      track.style.scrollSnapType = 'none';
      track.style.scrollBehavior = 'auto';
      track.scrollLeft = startScroll - dx;
      var now = performance.now();
      var dt = now - lastT;
      if (dt > 0) vel = vel * 0.6 + ((x - lastX) / dt) * 0.4;
      lastX = x;
      lastY = y;
      lastT = now;
      if (!scrollRaf) {
        scrollRaf = requestAnimationFrame(function () {
          scrollRaf = 0;
          setActive(nearestIndex());
        });
      }
    }

    function endSwipe() {
      if (!dragging) return;
      dragging = false;
      var usedAxis = axis;
      var locked = swipeLocked;
      var dx = lastX - startX;
      var held = performance.now() - lastT;
      if (held > 90) vel = 0;
      pointerId = null;
      axis = null;
      swipeLocked = false;
      track.style.scrollSnapType = '';
      track.style.scrollBehavior = '';
      if (usedAxis === 'x' && locked) {
        goTo(decideIndex(dx, vel), false);
      }
      window.setTimeout(function () { ignoreClick = false; }, 80);
    }

    track.addEventListener('scroll', onTrackScroll, { passive: true });

    if (!isTouch) {
      track.addEventListener('touchstart', function (e) {
        if (!e.changedTouches || !e.changedTouches[0]) return;
        beginSwipe(e.changedTouches[0].clientX, e.changedTouches[0].clientY, 'touch');
      }, { passive: true });
      track.addEventListener('touchmove', function (e) {
        if (!e.changedTouches || !e.changedTouches[0]) return;
        moveSwipe(e.changedTouches[0].clientX, e.changedTouches[0].clientY, e);
      }, { passive: false });
      track.addEventListener('touchend', endSwipe, { passive: true });
      track.addEventListener('touchcancel', endSwipe, { passive: true });
    }

    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'touch' || e.pointerType === 'pen') return;
      if (e.button !== 0) return;
      if (e.target && e.target.closest && e.target.closest('.orbit-dot, button, input, .m-card')) return;
      beginSwipe(e.clientX, e.clientY, e.pointerId);
    });

    track.addEventListener('pointermove', function (e) {
      if (e.pointerType === 'touch' || e.pointerType === 'pen') return;
      if (!dragging || pointerId !== e.pointerId) return;
      moveSwipe(e.clientX, e.clientY, e);
      if (swipeLocked) {
        try { track.setPointerCapture(e.pointerId); } catch (err) {}
      }
    });

    function endPointer(e) {
      if (e.pointerType === 'touch' || e.pointerType === 'pen') return;
      if (!dragging) return;
      if (pointerId !== e.pointerId && pointerId !== 'touch') return;
      try { track.releasePointerCapture(e.pointerId); } catch (err) {}
      endSwipe();
    }
    track.addEventListener('pointerup', endPointer);
    track.addEventListener('pointercancel', endPointer);

    track.addEventListener('click', function (e) {
      if (!ignoreClick && !swipeLocked) return;
      e.preventDefault();
      e.stopPropagation();
    }, true);

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(dot.getAttribute('data-dot-index'), 10) || 0, false);
      });
    });

    track.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      goTo(e.key === 'ArrowRight' ? activeIdx + 1 : activeIdx - 1, false);
    });

    var skipVideo = reducedMotion || isTouch;
    if (!skipVideo) {
      var injected = false;
      function injectVideos() {
        if (injected) return; injected = true;
        track.querySelectorAll('.orbit-media[data-video-src]').forEach(function (mediaDiv) {
          var src = mediaDiv.getAttribute('data-video-src');
          if (!src) return;
          var video = document.createElement('video');
          ['muted','playsinline','webkit-playsinline','loop'].forEach(function (a) { video.setAttribute(a, ''); });
          video.muted = true; video.loop = true; video.playsInline = true; video.preload = 'none';
          var se = document.createElement('source'); se.src = src; se.type = 'video/mp4';
          video.appendChild(se);
          video.addEventListener('playing', function () { video.style.opacity = '1'; });
          mediaDiv.appendChild(video);
          if (mediaDiv.closest('.orbit-card.is-active')) playVideo(video);
        });
      }
      if ('IntersectionObserver' in window) {
        var sectionObs = new IntersectionObserver(function (entries) {
          if (entries[0] && entries[0].isIntersecting) { injectVideos(); sectionObs.disconnect(); }
        }, { rootMargin: '200px' });
        sectionObs.observe(root);
      } else {
        injectVideos();
      }
    }

    var autoSec = parseFloat(root.getAttribute('data-autoscroll') || '0');
    function startAuto() {
      if (autoTimer || !autoSec || total < 2 || reducedMotion) return;
      autoTimer = setInterval(function () {
        if (!sectionVisible || document.hidden || dragging) return;
        goTo((Math.max(activeIdx, 0) + 1) % total, false);
      }, Math.max(3, autoSec) * 1000);
    }
    function stopAuto() {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    }
    startAuto();

    if ('IntersectionObserver' in window) {
      var visObs = new IntersectionObserver(function (entries) {
        sectionVisible = !!(entries[0] && entries[0].isIntersecting);
        if (sectionVisible && !document.hidden) {
          startAuto();
          var av = cards[activeIdx] && cards[activeIdx].querySelector('video');
          if (av) playVideo(av);
          syncFromScroll();
        } else {
            stopAuto();
          cards.forEach(function (c) { pauseVideo(c.querySelector('video')); });
        }
      }, { threshold: 0.08 });
      visObs.observe(root);
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        stopAuto();
        cards.forEach(function (c) { pauseVideo(c.querySelector('video')); });
      } else if (sectionVisible) {
        startAuto();
        var av = cards[activeIdx] && cards[activeIdx].querySelector('video');
        if (av) playVideo(av);
      }
    });

    /* Login gate: logged-out visitors opening a login-only collection get the shared pop-up (snippets/lexe-login-gate, window.LexeGate). */
    cards.forEach(function (card) {
      if (card.getAttribute('data-login-required') !== '1') return;
      card.addEventListener('click', function (e) {
        if (ignoreClick || swipeLocked || !window.LexeGate) return;
        e.preventDefault();
        window.LexeGate.open(card.getAttribute('href'), card.getAttribute('data-collection-title'), card);
      });
    });

    function settleStart() {
      setActive(nearestIndex());
      goTo(Math.max(activeIdx, 0), true);
    }

    settleStart();
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        settleStart();
        root.classList.add('is-ready');
      });
    });
    window.addEventListener('load', function () {
      settleStart();
      root.classList.add('is-ready');
    }, { once: true });

    var resizeTimer = null;
    function onResize() {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(function () {
        goTo(Math.max(activeIdx, 0), true);
      }, 80);
    }
    window.addEventListener('resize', onResize);
  });
})();
</script>
