{% style %}
  {{ section.settings.title_font | font_face: font_display: 'swap' }}

  .orbit-master-{{ sid }} {
    --accent: {{ accent }};
    --bg: {{ bg }};
    --title-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    --title-weight: {{ section.settings.title_font.weight }};
    --title-base-size: {{ section.settings.title_size }}px;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-apple: cubic-bezier(0.22, 1, 0.36, 1);
    --inactive-scale: {{ section.settings.inactive_scale }};
    --card-radius: {{ card_radius }}px;
    --card-w-desktop: {{ card_width_pct }}%;
    --card-w-mobile: {{ card_width_mob }}%;
    --card-gap: {{ card_gap_px }}px;
    --fade-to: {{ section.settings.fade_to_color | default: '#ffffff' }};
    --fade-h: {{ section.settings.fade_height | default: 140 }}px;
    --orbit-fade-from: {{ bg }};
    --orbit-fade-to: {{ section.settings.fade_to_color | default: '#ffffff' }};
    --orbit-fade-h: {% if section.settings.bottom_fade == false %}0px{% else %}{{ section.settings.fade_height | default: 140 }}px{% endif %};
    background: var(--bg);
    padding: {{ section.settings.padding_v }}px 0 {% if section.settings.bottom_fade != false %}{{ section.settings.padding_v | default: 0 | plus: 28 }}{% else %}{{ section.settings.padding_v }}{% endif %}px;
    overflow: hidden;
    position: relative;
    user-select: none;
    isolation: isolate;
    content-visibility: auto;
    contain-intrinsic-block-size: 900px;
  }

  {%- if show_noise -%}
  .orbit-master-{{ sid }}::before {
    content: "";
    position: absolute; inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/></svg>");
    opacity: 0.055;
    pointer-events: none;
    z-index: 30;
  }
  {%- endif -%}

  {%- if section.settings.bottom_fade != false -%}
  .orbit-master-{{ sid }}::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0; top: auto;
    height: var(--fade-h);
    pointer-events: none;
    z-index: 25;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0) 0%,
      color-mix(in srgb, var(--fade-to) 8%, transparent) 30%,
      color-mix(in srgb, var(--fade-to) 22%, transparent) 50%,
      color-mix(in srgb, var(--fade-to) 48%, transparent) 70%,
      color-mix(in srgb, var(--fade-to) 78%, transparent) 88%,
      var(--fade-to) 100%
    );
  }
  {%- endif -%}

  .orbit-master-{{ sid }} .orbit-header {
    text-align: center; max-width: 820px;
    margin: 0 auto {{ section.settings.header_gap | default: 56 }}px;
    padding: 0 24px; position: relative; z-index: 2;
  }
  .orbit-master-{{ sid }} .orbit-eyebrow {
    display: inline-flex; align-items: center; gap: 14px;
    font-size: 10px; font-weight: 900; letter-spacing: 0.45em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 18px;
  }
  .orbit-master-{{ sid }} .orbit-eyebrow-glyph {
    width: 30px; height: 1px;
    background: linear-gradient(to right, transparent, var(--accent), transparent);
  }
  .orbit-master-{{ sid }} .orbit-heading {
    font-family: var(--title-family); font-weight: var(--title-weight);
    font-size: clamp(1.8rem, 5.5vw, 3.4rem); line-height: 1.02;
    color: #fff; margin: 0 0 14px; text-transform: uppercase;
  }
  .orbit-master-{{ sid }} .orbit-tagline {
    font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.55);
    margin: 0 auto; max-width: 560px;
  }

  .orbit-master-{{ sid }} .orbit-counter {
    position: absolute; top: {{ section.settings.padding_v | plus: 12 }}px; right: 40px; z-index: 15;
    display: flex; align-items: baseline; gap: 6px;
    font-family: var(--title-family); color: rgba(255,255,255,0.7);
    font-size: 11px; letter-spacing: 0.3em;
  }
  .orbit-master-{{ sid }} .orbit-counter-current {
    font-size: 28px; font-weight: 900; color: var(--accent); min-width: 2.2ch; text-align: right;
  }

  .orbit-master-{{ sid }} .edge-indicator {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 2px; height: 60px; background: var(--accent);
    z-index: 10; pointer-events: none;
  }
  .orbit-master-{{ sid }} .edge-left { left: 15px; opacity: 0; }
  .orbit-master-{{ sid }} .edge-right { right: 15px; opacity: 0.6; }

  .orbit-master-{{ sid }} .orbital-scanner {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 60vh; height: 60vh; border: 1px solid rgba(255,255,255,0.03);
    border-radius: 50%; pointer-events: none; z-index: 0;
    display: {% if section.settings.show_ring %}block{% else %}none{% endif %};
  }
  .orbit-master-{{ sid }} .orbital-ring-active {
    position: absolute; inset: -2px; border: 2px solid transparent;
    border-top-color: var(--accent); border-radius: 50%; opacity: 0.2;
  }

  .orbit-master-{{ sid }} .orbit-track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; gap: var(--card-gap);
    padding: 16px calc((100% - var(--card-w-desktop)) / 2) 50px;
    -webkit-overflow-scrolling: touch; scroll-behavior: smooth;
    position: relative; z-index: 1;
    scroll-padding-inline: calc((100% - var(--card-w-desktop)) / 2);
  }
  .orbit-master-{{ sid }} .orbit-track::-webkit-scrollbar { display: none; }

  .orbit-master-{{ sid }} .orbit-card {
    flex: 0 0 var(--card-w-desktop);
    scroll-snap-align: center; position: relative;
    aspect-ratio: {{ section.settings.aspect_ratio | replace: '/', ' / ' }};
    background: #050505;
    transition: transform 0.9s var(--ease-apple), filter 0.9s var(--ease-apple), border-color 0.6s, box-shadow 0.6s;
    filter: grayscale(1) brightness(0.35) {% if section.settings.enable_blur %}blur(3px){% endif %};
    transform: scale(var(--inactive-scale));
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: var(--card-radius);
    overflow: hidden; cursor: pointer;
    contain: layout style paint;
  }
  .orbit-master-{{ sid }} .orbit-card.is-active {
    will-change: transform, filter;
    filter: grayscale(0) brightness(1) blur(0);
    transform: scale(1.04);
    border-color: var(--accent);
    box-shadow: 0 30px 60px -15px rgba(0,0,0,0.6), 0 10px 20px -5px rgba(0,0,0,0.4);
  }
  .orbit-master-{{ sid }} .orbit-card.is-locked.is-active {
    border-color: var(--lock-color, #888);
  }
  .orbit-master-{{ sid }} .orbit-card:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 6px;
  }

  .orbit-master-{{ sid }} .hud-corners {
    position: absolute; inset: 10px; pointer-events: none; z-index: 6; opacity: 0;
    display: {% if section.settings.show_hud %}block{% else %}none{% endif %};
  }
  .orbit-master-{{ sid }} .orbit-card.is-active .hud-corners { opacity: 1; }
  .orbit-master-{{ sid }} .hud-corner { position: absolute; width: 22px; height: 22px; border: 1.5px solid var(--accent); }
  .orbit-master-{{ sid }} .hud-tl { top: 0; left: 0; border-right: none; border-bottom: none; }
  .orbit-master-{{ sid }} .hud-tr { top: 0; right: 0; border-left: none; border-bottom: none; }
  .orbit-master-{{ sid }} .hud-bl { bottom: 0; left: 0; border-right: none; border-top: none; }
  .orbit-master-{{ sid }} .hud-br { bottom: 0; right: 0; border-left: none; border-top: none; }

  .orbit-master-{{ sid }} .orbit-media { width: 100%; height: 100%; position: absolute; inset: 0; z-index: 1; overflow: hidden; }
  .orbit-master-{{ sid }} .orbit-media img,
  .orbit-master-{{ sid }} .orbit-media video {
    width: 100%; height: 100%; object-fit: cover;
    position: absolute; inset: 0;
    transition: transform 1.5s var(--ease-apple);
    transform: scale(1.08);
  }
  .orbit-master-{{ sid }} .orbit-media video { z-index: 2; opacity: 0; pointer-events: none; }
  .orbit-master-{{ sid }} .orbit-card.is-active .orbit-media img,
  .orbit-master-{{ sid }} .orbit-card.is-active .orbit-media video { transform: scale(1); }

  .orbit-master-{{ sid }} .orbit-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.35) 48%, transparent 88%);
    z-index: 4; display: flex; flex-direction: column; justify-content: flex-end;
    padding: 44px; opacity: 0; transition: opacity 0.6s ease; pointer-events: none;
  }
  .orbit-master-{{ sid }} .orbit-card.is-active .orbit-overlay { opacity: 1; pointer-events: auto; }

  .orbit-master-{{ sid }} .orbit-badge,
  .orbit-master-{{ sid }} .orbit-committed {
    position: absolute; top: 20px; left: 20px; z-index: 5;
    padding: 6px 12px; font-size: 9px; font-weight: 900;
    letter-spacing: 1.5px; text-transform: uppercase; border-radius: 100px;
    opacity: 0;
  }
  .orbit-master-{{ sid }} .orbit-card.is-active .orbit-badge,
  .orbit-master-{{ sid }} .orbit-card.is-active .orbit-committed { opacity: 1; }
  .orbit-master-{{ sid }} .orbit-committed {
    background: rgba(52,199,89,0.18); color: rgb(52,199,89);
    border: 1px solid rgba(52,199,89,0.4); display: none;
  }
  .orbit-master-{{ sid }} .orbit-card[data-committed="1"] .orbit-committed { display: inline-block; }

  .orbit-master-{{ sid }} .orbit-meta {
    display: flex; align-items: center; gap: 14px; margin: 0 0 10px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase;
    color: rgba(255,255,255,0.65); opacity: 0;
  }
  .orbit-master-{{ sid }} .orbit-card.is-active .orbit-meta { opacity: 1; }
  .orbit-master-{{ sid }} .orbit-meta-price { color: var(--accent); }

  .orbit-master-{{ sid }} .orbit-cta {
    display: inline-flex; align-items: center; gap: 10px; margin-top: 14px;
    font-size: 11px; font-weight: 900; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--accent); opacity: 0;
  }
  .orbit-master-{{ sid }} .orbit-card.is-active .orbit-cta { opacity: 1; }
  .orbit-master-{{ sid }} .orbit-cta-arrow { display: inline-block; width: 20px; height: 1px; background: var(--accent); position: relative; }
  .orbit-master-{{ sid }} .orbit-cta-arrow::after {
    content: ""; position: absolute; right: 0; top: -3px; width: 7px; height: 7px;
    border-top: 1px solid var(--accent); border-right: 1px solid var(--accent); transform: rotate(45deg);
  }

  .orbit-master-{{ sid }} .orbit-lock-veil {
    position: absolute; inset: 0; z-index: 3;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0.85) 100%);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    opacity: 0; pointer-events: none;
  }
  .orbit-master-{{ sid }} .orbit-card.is-active .orbit-lock-veil { opacity: 1; }
  .orbit-master-{{ sid }} .lock-icon { width: 36px; height: 36px; }
  .orbit-master-{{ sid }} .lock-label {
    font-size: 9px; font-weight: 900; letter-spacing: 3px; text-transform: uppercase;
    color: var(--lock-color, #888);
  }
  .orbit-master-{{ sid }} .lock-countdown { display: none; gap: 10px; margin-top: 6px; }
  .orbit-master-{{ sid }} .lock-countdown.is-active { display: flex; }
  .orbit-master-{{ sid }} .lock-count-unit { display: flex; flex-direction: column; align-items: center; min-width: 42px; }
  .orbit-master-{{ sid }} .lock-count-num { font-size: 22px; font-weight: 900; color: var(--lock-color, #888); }
  .orbit-master-{{ sid }} .lock-count-lbl { font-size: 8px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.45); }
  .orbit-master-{{ sid }} .lock-cta-hint {
    margin-top: 8px; font-size: 9px; font-weight: 800; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(255,255,255,0.7); padding: 7px 14px; border-radius: 100px;
    border: 1px solid rgba(255,255,255,0.25); background: rgba(0,0,0,0.4);
    pointer-events: auto; cursor: pointer;
  }

  .orbit-master-{{ sid }} .status-wrapper { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .orbit-master-{{ sid }} .status-led { width: 6px; height: 6px; border-radius: 50%; }
  .orbit-master-{{ sid }} .orbit-status-text { font-size: 10px; letter-spacing: 4px; font-weight: bold; }
  .orbit-master-{{ sid }} .orbit-title {
    color: #fff; font-family: var(--title-family); font-weight: var(--title-weight);
    font-size: clamp(1.2rem, 3.5vw, var(--title-base-size));
    letter-spacing: 0.12em; text-transform: uppercase; margin: 0; line-height: 1.1;
  }

  .orbit-master-{{ sid }} .orbit-dots {
    display: flex; justify-content: center; align-items: center;
    gap: 8px; margin-top: 36px; padding: 0 20px; position: relative; z-index: 2;
  }
  .orbit-master-{{ sid }} .orbit-dot {
    width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.2);
    border: 0; padding: 0; cursor: pointer;
  }
  .orbit-master-{{ sid }} .orbit-dot.is-active {
    background: var(--accent); width: 22px; border-radius: 100px;
  }

  .orbit-modal-{{ sid }} {
    --m-bg: {{ modal_bg }}; --m-fg: {{ modal_fg }}; --m-accent: {{ modal_accent }};
    --m-radius: {{ modal_radius }}px;
    --m-muted: {{ modal_fg }}7a; --m-subtle: {{ modal_fg }}0f;
    position: fixed; inset: 0; z-index: 9999; display: none;
    align-items: center; justify-content: center; padding: 20px;
  }
  .orbit-modal-{{ sid }}.is-open { display: flex; }
  .orbit-modal-{{ sid }} .m-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.55); }
  .orbit-modal-{{ sid }} .m-card {
    position: relative; background: var(--m-bg); color: var(--m-fg);
    border-radius: var(--m-radius); width: 100%; max-width: 440px; padding: 44px 36px 32px;
  }
  .orbit-modal-{{ sid }} .m-close {
    position: absolute; top: 14px; right: 14px; width: 32px; height: 32px;
    border-radius: 50%; border: 0; background: var(--m-subtle); color: var(--m-fg); cursor: pointer;
  }
  .orbit-modal-{{ sid }} .m-title { font-size: 26px; font-weight: 700; margin: 0 0 8px; }
  .orbit-modal-{{ sid }} .m-sub { font-size: 15px; color: var(--m-muted); margin: 0 0 26px; }
  .orbit-modal-{{ sid }} .m-fields { display: flex; flex-direction: column; gap: 14px; }
  .orbit-modal-{{ sid }} .m-label { display: block; font-size: 12px; color: var(--m-muted); margin-bottom: 6px; }
  .orbit-modal-{{ sid }} .m-input {
    width: 100%; font-size: 16px; padding: 14px 16px; background: var(--m-subtle);
    border: 1px solid transparent; border-radius: 12px; box-sizing: border-box; color: var(--m-fg);
  }
  .orbit-modal-{{ sid }} .m-error { font-size: 12px; color: #ff3b30; margin-top: 6px; display: none; }
  .orbit-modal-{{ sid }} .m-error.is-visible { display: block; }
  .orbit-modal-{{ sid }} .m-toggle { display: flex; align-items: center; gap: 12px; margin-top: 18px; cursor: pointer; }
  .orbit-modal-{{ sid }} .m-btn-primary {
    width: 100%; padding: 14px 20px; font-size: 15px; font-weight: 600; border: 0; border-radius: 12px;
    background: var(--m-accent); color: #fff; cursor: pointer; margin-top: 24px;
  }
  .orbit-modal-{{ sid }} .m-privacy { font-size: 11px; color: var(--m-muted); margin-top: 14px; }
  .orbit-master-{{ sid }} .sr-only,
  .orbit-modal-{{ sid }} .sr-only {
    position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0);
  }

  @media (max-width: 768px) {
    .orbit-master-{{ sid }} .orbit-track {
      padding: 16px calc((100% - var(--card-w-mobile)) / 2) 50px;
      scroll-padding-inline: calc((100% - var(--card-w-mobile)) / 2);
    }
    .orbit-master-{{ sid }} .orbit-card { flex: 0 0 var(--card-w-mobile); }
    .orbit-master-{{ sid }} .orbit-overlay { padding: 28px; }
  }
{% endstyle %}
