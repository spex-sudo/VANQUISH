{%- comment -%} LEXE preview 2026-10-15: preview-only cleanup. (1) hides fake trust signals (compare-at strike-through, % off badges, low-stock counter, "Protected By Capcha" banner line). (2) hides needs-clean-image + branded-review products from homepage cards. {%- endcomment -%}
{%- assign lexe_checkout_live = shop.metafields.lexe.checkout_live.value | default: false -%}
{%- unless lexe_checkout_live == true -%}
<style id="lexe-checkout-off">
  /* SWITCH: shop metafield lexe.checkout_live is not true -> checkout off: hide every add-to-cart / buy-now, incl. Specs free-pair bar */
  form[action*="/cart/add"] [type="submit"], form[action*="/cart/add"] [name="add"],
  .shopify-payment-button, .lx-buy, .lx-buy-btn,
  [class^="ap-bar"], [class^="ap-atc"], [class^="apex-gqa"], .quick-add, [class*="quick-add__"],
  [class^="ap-buy"], [class*=" ap-buy"], [data-ap-buy], [data-ap-buy-lbl],
  a.apex-qa, .apex-qa, :has(> [data-ap-buy]){display:none!important}
</style>
<script>
(function(){
  function hideBuy(){
    document.querySelectorAll('[data-ap-buy], [data-ap-buy-lbl], a.apex-qa').forEach(function(el){
      var box = el.closest('[class^="ap-buy"]') || el.closest('button') || el;
      if (box.closest('#lexe-notify-drop')) return;
      box.style.setProperty('display','none','important');
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',hideBuy); else hideBuy();
  new MutationObserver(hideBuy).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>
{%- endunless -%}
<style id="lexe-trust-clean">
  .lock-countdown, [data-personal-countdown]{display:none!important}
  .compare-at-price, s.price-item, .price__compare, [class*="compare-at"], [class*="price-compare"],
  [id^="ap-stock"], [class^="ap-stock"]{display:none!important}
</style>
