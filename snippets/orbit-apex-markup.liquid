{%- if enable_schema and rendered_count > 0 -%}
  {%- capture items_json -%}
    [{%- assign _first = true -%}{%- for block in section.blocks -%}{%- assign c = collections[block.settings.collection] -%}{%- if c != blank -%}{%- unless _first %},{%- endunless -%}{"@type":"ListItem","position":{{ forloop.index }},"url":{{ shop.url | append: c.url | json }},"name":{{ c.title | json }}{%- if c.description != blank -%},"description":{{ c.description | strip_html | truncatewords: 30 | json }}{%- endif -%}{%- if c.featured_image != blank -%},"image":{{ c.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif -%}}{%- assign _first = false -%}{%- endif -%}{%- endfor -%}]
  {%- endcapture -%}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"ItemList","name":{{ heading | default: shop.name | json }}{%- if tagline != blank -%},"description":{{ tagline | json }}{%- endif -%},"numberOfItems":{{ rendered_count }},"itemListElement":{{ items_json }}}</script>
{%- endif -%}

<section
  class="orbit-master orbit-master-{{ sid }}"
  {% if heading != blank %}aria-labelledby="orbit-h-{{ sid }}"{% else %}aria-label="Collections"{% endif %}
  data-section-id="{{ sid }}"
  {% if enable_autoscroll %}data-autoscroll="{{ autoscroll_interval }}"{% endif %}
  {% if enable_nudge %}data-nudge="1"{% endif %}
>
  {%- if eyebrow != blank or heading != blank or tagline != blank -%}
    <header class="orbit-header">
      {%- if eyebrow != blank -%}
        <p class="orbit-eyebrow">
          <span class="orbit-eyebrow-glyph" aria-hidden="true"></span>
          <span>{{ eyebrow | escape }}</span>
          <span class="orbit-eyebrow-glyph" aria-hidden="true"></span>
        </p>
      {%- endif -%}
      {%- if heading != blank -%}<h2 id="orbit-h-{{ sid }}" class="orbit-heading">{{ heading | escape }}</h2>{%- endif -%}
      {%- if tagline != blank -%}<p class="orbit-tagline">{{ tagline | escape }}</p>{%- endif -%}
    </header>
  {%- endif -%}

  {%- if show_counter and rendered_count > 1 -%}
    <div class="orbit-counter" aria-hidden="true">
      <span class="orbit-counter-current" id="OrbitCount-{{ sid }}">01</span>
      <span class="orbit-counter-sep">/</span>
      <span class="orbit-counter-total">{{ rendered_count | prepend: '00' | slice: -2, 2 }}</span>
    </div>
  {%- endif -%}

  <div class="edge-indicator edge-left"  id="EdgeLeft-{{ sid }}"  aria-hidden="true"></div>
  <div class="edge-indicator edge-right" id="EdgeRight-{{ sid }}" aria-hidden="true"></div>

  <div class="orbital-scanner" aria-hidden="true">
    <div class="orbital-ring-active" id="OrbitRing-{{ sid }}"></div>
  </div>

  <div
    class="orbit-track"
    id="OrbitTrack-{{ sid }}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ heading | default: 'Collections' | escape }}"
    tabindex="0"
  >
    {%- assign first_rendered = true -%}
    {% for block in section.blocks %}
      {%- liquid
        assign c = collections[block.settings.collection]
        if c == blank or c == empty
          continue
        endif
        assign node_color   = block.settings.status_color | default: section.settings.accent_color
        assign coll_handle  = c.handle | default: 'unknown'
        assign coll_title   = c.title | default: 'Collection'
        assign coll_count   = c.products_count | default: 0
        assign cta_label    = block.settings.cta_label | default: 'Enter'
        assign needs_login  = false
        if customer == blank
          if block.settings.lock_collection or login_handles contains coll_handle
            assign needs_login = true
          endif
        endif
        assign aria_label = coll_title
      -%}

        <a
          href="{{ c.url | default: '#' }}"
          class="orbit-card{% if first_rendered %} is-active{% endif %}"
          {{ block.shopify_attributes }}
          data-index="{{ forloop.index0 }}"
          data-collection-title="{{ coll_title | escape }}"
          data-collection-handle="{{ coll_handle }}"
          {% if needs_login %}data-login-required="1"{% endif %}
          aria-label="{{ aria_label | escape }}"
          {% if first_rendered %}aria-current="true"{% endif %}
        >

        <div class="hud-corners" aria-hidden="true">
          <span class="hud-corner hud-tl"></span><span class="hud-corner hud-tr"></span>
          <span class="hud-corner hud-bl"></span><span class="hud-corner hud-br"></span>
        </div>

        {% if block.settings.badge_text != blank %}
          <div class="orbit-badge is-active-pulse"
            style="background:{{ block.settings.badge_bg | color_modify: 'alpha', 0.85 }};color:{{ block.settings.badge_text_color }};border:1px solid {{ block.settings.badge_text_color }};">
            {{ block.settings.badge_text | escape }}
          </div>
        {% endif %}

        {%- assign video_src = '' -%}
        {%- assign video_poster_url = '' -%}
        {%- if block.settings.video_url != blank -%}
          {%- assign _vobj = block.settings.video_url -%}
          {%- assign _mp4 = _vobj.sources | where: 'format', 'mp4' | first -%}
          {%- if _mp4 -%}{%- assign video_src = _mp4.url -%}
          {%- elsif _vobj.sources.size > 0 -%}{%- assign video_src = _vobj.sources[0].url -%}
          {%- endif -%}
          {%- if _vobj.preview_image != blank -%}{%- assign video_poster_url = _vobj.preview_image | image_url: width: 800 -%}{%- endif -%}
        {%- endif -%}

        <div class="orbit-media"
          {% if video_src != blank %}data-video-src="{{ video_src }}"{% endif %}
          {% if video_poster_url != blank %}data-video-poster="{{ video_poster_url }}"{% endif %}
        >
          {%- if block.settings.custom_image != blank -%}
            {%- assign img_src = block.settings.custom_image -%}
          {%- elsif c.featured_image != blank -%}
            {%- assign img_src = c.featured_image -%}
          {%- else -%}
            {%- assign img_src = nil -%}
          {%- endif -%}
          {%- if img_src != blank -%}
            {%- assign _ratio = img_src.aspect_ratio | default: 0.8 -%}
            <img
              src="{{ img_src | image_url: width: 800 }}"
              width="800" height="{{ 800 | divided_by: _ratio | ceil }}"
              srcset="{{ img_src | image_url: width: 400 }} 400w, {{ img_src | image_url: width: 800 }} 800w, {{ img_src | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 768px) calc({{ card_width_mob }}vw * 0.8), {{ card_width_pct }}vw"
              loading="{% if first_rendered %}eager{% else %}lazy{% endif %}"
              decoding="async"
              {% if first_rendered %}fetchpriority="high"{% endif %}
              alt="{{ block.settings.custom_image.alt | default: coll_title | escape }}"
              data-poster>
          {%- endif -%}
        </div>

        <div class="orbit-overlay">
          <div class="status-wrapper">
            <div class="status-led" style="background:{{ node_color }};color:{{ node_color }};box-shadow:0 0 10px {{ node_color }};" aria-hidden="true"></div>
            <div class="orbit-status-text" style="color:{{ node_color }};">{{ block.settings.status_text | default: 'READY' | escape }}</div>
          </div>
          <h3 class="orbit-title">{{ coll_title | escape }}</h3>
          {%- if show_meta -%}
            <div class="orbit-meta" aria-hidden="true">
              {%- if coll_count > 0 -%}<span>{{ coll_count }} {% if coll_count == 1 %}{{ unit_singular | escape }}{% else %}{{ unit_plural | escape }}{% endif %}</span>{%- endif -%}
              {%- if block.settings.price_from != blank -%}
                {%- if coll_count > 0 -%}<span class="orbit-meta-dot"></span>{%- endif -%}
                <span class="orbit-meta-price">{{ price_prefix | escape }} {{ block.settings.price_from | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
          <span class="orbit-cta" aria-hidden="true"><span>{{ cta_label | escape }}</span><span class="orbit-cta-arrow"></span></span>
        </div>

      </a>
      {%- assign first_rendered = false -%}
    {% endfor %}
  </div>

  {%- if show_dots and rendered_count > 1 -%}
    <div class="orbit-dots" role="tablist" aria-label="Carousel navigation" id="OrbitDots-{{ sid }}">
      {%- assign dot_idx = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign _c = collections[block.settings.collection] -%}
        {%- if _c != blank and _c != empty -%}
          <button type="button"
            class="orbit-dot{% if dot_idx == 0 %} is-active{% endif %}"
            data-dot-index="{{ dot_idx }}"
            aria-label="Go to {{ _c.title | default: 'collection' | escape }} ({{ dot_idx | plus: 1 }} of {{ rendered_count }})"
            role="tab"
            aria-selected="{% if dot_idx == 0 %}true{% else %}false{% endif %}"
          ></button>
          {%- assign dot_idx = dot_idx | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="sr-only" aria-live="polite" id="OrbitLive-{{ sid }}"></div>
</section>
