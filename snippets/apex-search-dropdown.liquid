{%- comment -%}
  SHEIN-style search: field lives in the header pill.
  Submit goes to /search?q=keyword — a product grid, not an overlay.
{%- endcomment -%}
<style>
#ApexSearch{display:none !important;}
.apex-inline-search{
  display:flex; align-items:center; gap:8px;
  min-width:0; flex:1 1 220px; max-width:420px;
  margin:0 8px 0 12px; height:36px;
  padding:0 12px 0 12px;
  border-radius:100px;
  background:rgba(255,255,255,.18);
  border:1px solid rgba(255,255,255,.28);
}
#ApexRoot:not(.apex-at-top) .apex-inline-search,
.apex-shell.scrolled .apex-inline-search{
  background:rgba(0,0,0,.06);
  border-color:rgba(0,0,0,.08);
}
.apex-inline-search input{
  flex:1; min-width:0; height:36px; border:0; outline:0; background:transparent;
  color:inherit; font-size:14px; font-family:inherit; -webkit-appearance:none;
}
.apex-inline-search input::placeholder{color:currentColor; opacity:.45;}
.apex-inline-search button{
  border:0; background:transparent; color:inherit; cursor:pointer;
  font-size:10px; font-weight:800; letter-spacing:.14em; text-transform:uppercase;
  padding:0; height:36px;
}
@media (max-width:900px){
  .apex-inline-search{display:none;}
}
</style>
<script>
(function(){
  var SEARCH_URL='{{ routes.search_url }}';
  function go(q){
    var url=SEARCH_URL+'?q='+encodeURIComponent(q||'')+'&type=product&options[prefix]=last';
    window.location.href=url;
  }
  function boot(){
    var btn=document.getElementById('ApexSearchBtn');
    var right=document.querySelector('#ApexRoot .apex-right');
    var overlay=document.getElementById('ApexSearch');
    if(overlay) overlay.setAttribute('hidden','hidden');

    if(right && !document.querySelector('.apex-inline-search')){
      var form=document.createElement('form');
      form.className='apex-inline-search';
      form.setAttribute('role','search');
      form.action=SEARCH_URL;
      form.method='get';
      form.innerHTML='<input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last"><input type="search" name="q" placeholder="Search products" autocomplete="off" enterkeyhint="search" aria-label="Search products"><button type="submit">Go</button>';
      if(btn) right.insertBefore(form, btn);
      else right.appendChild(form);
      form.addEventListener('submit',function(e){
        e.preventDefault();
        go((form.querySelector('[name="q"]').value||'').trim());
      });
    }

    window.apexOpenSearch=function(){
      var field=document.querySelector('.apex-inline-search input');
      if(field && window.matchMedia('(min-width:901px)').matches){
        field.focus();
        field.select();
        return;
      }
      go('');
    };
    window.apexCloseSearch=function(){};

    if(btn){
      btn.addEventListener('click',function(e){
        e.preventDefault();
        e.stopImmediatePropagation();
        window.apexOpenSearch();
      }, true);
    }
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
