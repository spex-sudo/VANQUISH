{%- comment -%} Converts Apex header search overlay into a dropdown with live product results. {%- endcomment -%}
<style>
#ApexSearch.apex-search{
  position:absolute !important; inset:auto 0 auto 0 !important; top:100% !important;
  left:0 !important; right:0 !important; bottom:auto !important;
  display:block !important; align-items:stretch !important; justify-content:flex-start !important;
  background:#fff !important; z-index:980 !important; padding:0 !important;
  opacity:0; pointer-events:none; visibility:hidden; transform:translateY(-8px);
  transition:opacity .18s ease, transform .18s ease, visibility .18s;
  border-bottom:1px solid #ececec; box-shadow:0 18px 40px rgba(0,0,0,.12);
  max-height:min(78vh,740px); overflow:auto;
}
#ApexSearch.apex-search.open{opacity:1 !important; pointer-events:auto !important; visibility:visible; transform:translateY(0);}
#ApexSearch .apex-search-inner{width:100% !important; max-width:1280px !important; margin:0 auto !important; padding:16px 20px 22px !important; position:relative;}
#ApexSearch .apex-search-eyebrow{display:none !important;}
#ApexSearch .apex-search-field{
  width:100% !important; background:#fff !important; border:1px solid #111 !important;
  border-bottom:1px solid #111 !important; border-radius:8px !important; padding:14px 16px !important;
  font-size:16px !important; font-weight:500 !important; color:#111 !important; letter-spacing:0 !important;
}
#ApexSearch .apex-search-field::placeholder{color:#9a9a9a !important; opacity:1 !important;}
#ApexSearch .apex-search-esc{margin-top:10px !important; opacity:.45 !important;}
#ApexSearchResults{margin-top:16px; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px;}
#ApexSearchResults[hidden]{display:none;}
.apex-search-hit{display:flex; flex-direction:column; text-decoration:none; color:#111;}
.apex-search-hit img{width:100%; aspect-ratio:3/4; object-fit:cover; background:#f6f6f6; border-radius:4px;}
.apex-search-hit span{margin-top:8px; font-size:13px; font-weight:500; line-height:1.3;}
.apex-search-hit b{margin-top:4px; font-size:13px;}
.apex-search-empty,.apex-search-more{grid-column:1/-1; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:#6b6b6b; text-align:center; padding:6px 0;}
.apex-search-more a{color:#111; font-weight:700;}
@media (max-width:768px){#ApexSearchResults{grid-template-columns:repeat(2,minmax(0,1fr));}}
</style>
<script>
(function(){
  function money(cents){
    try{return (cents/100).toLocaleString(undefined,{style:'currency',currency:(window.Shopify&&Shopify.currency&&Shopify.currency.active)||'USD'});}
    catch(e){return '$'+(cents/100).toFixed(2);}
  }
  function boot(){
    var el=document.getElementById('ApexSearch');
    var input=document.getElementById('ApexSearchInput');
    if(!el) return;
    var inner=el.querySelector('.apex-search-inner')||el;
    var results=document.getElementById('ApexSearchResults');
    if(!results){ results=document.createElement('div'); results.id='ApexSearchResults'; results.hidden=true; inner.appendChild(results); }
    var form=el.querySelector('form');
    if(form && !form.querySelector('[name="options[prefix]"]')){
      var pref=document.createElement('input'); pref.type='hidden'; pref.name='options[prefix]'; pref.value='last'; form.appendChild(pref);
    }
    var timer=null;
    function render(products,q){
      if(!q){results.hidden=true;results.innerHTML='';return;}
      results.hidden=false;
      if(!products.length){ results.innerHTML='<p class="apex-search-empty">No products found</p>'; return; }
      results.innerHTML=products.map(function(p){
        var img=p.image||p.featured_image||'';
        if(img && img.indexOf('width=')===-1) img+=(img.indexOf('?')>-1?'&':'?')+'width=500';
        var url=p.url||('/products/'+(p.handle||''));
        var price=typeof p.price==='number'?p.price:(p.price_min||0);
        return '<a class="apex-search-hit" href="'+url+'">'+(img?'<img src="'+img+'" alt="">':'')+'<span>'+String(p.title||'').replace(/</g,'')+'</span><b>'+money(price)+'</b></a>';
      }).join('')+'<p class="apex-search-more"><a href="/search?q='+encodeURIComponent(q)+'&type=product&options[prefix]=last">View all results</a></p>';
    }
    function suggest(q){
      if(!q){render([],'');return;}
      fetch('/search/suggest.json?q='+encodeURIComponent(q)+'&resources[type]=product&resources[limit]=8&resources[options][fields]=title,product_type,vendor,variants.title')
        .then(function(r){return r.json();})
        .then(function(data){
          var products=(data&&data.resources&&data.resources.results&&data.resources.results.products)||[];
          render(products,q);
        }).catch(function(){});
    }
    if(input && !input.dataset.apexBound){
      input.dataset.apexBound='1';
      input.addEventListener('input',function(){
        var q=input.value.trim();
        clearTimeout(timer);
        timer=setTimeout(function(){suggest(q);},160);
      });
    }
    window.apexOpenSearch=function(){
      el.classList.add('open');
      document.body.style.overflow='';
      setTimeout(function(){ if(input) input.focus(); },40);
    };
    window.apexCloseSearch=function(){
      el.classList.remove('open');
      document.body.style.overflow='';
    };
    document.addEventListener('click',function(e){
      if(!el.classList.contains('open')) return;
      var btn=document.getElementById('ApexSearchBtn');
      if(el.contains(e.target) || (btn && btn.contains(e.target))) return;
      window.apexCloseSearch();
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot);
  else boot();
})();
</script>
