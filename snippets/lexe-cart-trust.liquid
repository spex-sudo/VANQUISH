{%- comment -%} LEXE 2026-10-16: card-processor (Scotiabank e-commerce+/Fiserv) readiness block under the cart totals. Settings: Theme settings > LEXE checkout. {%- endcomment -%}
<div class="lexe-ct cart-primary-typography">
  {%- if settings.lexe_currency_note != blank -%}<p class="lexe-ct__cur">{{ settings.lexe_currency_note | escape }}</p>{%- endif -%}
  {%- assign lexe_brands = settings.lexe_card_brands | remove: ' ' | split: ',' -%}
  {%- if settings.lexe_card_brands != blank -%}
    <ul class="lexe-ct__cards" aria-label="Accepted cards">
      {%- for b in lexe_brands -%}{%- if b != blank -%}<li>{{ b | payment_type_svg_tag: class: 'lexe-ct__icon' }}</li>{%- endif -%}{%- endfor -%}
    </ul>
  {%- endif -%}
  {%- if settings.lexe_cart_terms -%}
    <label class="lexe-ct__terms"><input type="checkbox" id="LexeTermsAgree" form="cart-form" required> I agree to the <a href="/policies/terms-of-service" target="_blank">Terms of Service</a> and <a href="/policies/refund-policy" target="_blank">Refund Policy</a>.</label>
  {%- endif -%}
  <p class="lexe-ct__links">
    <a href="/policies/shipping-policy">Shipping</a> · <a href="/policies/refund-policy">Refunds</a> · <a href="/policies/terms-of-service">Terms</a> · <a href="/policies/privacy-policy">Privacy</a> · <a href="/pages/contact">Contact</a>
  </p>
  {%- if settings.lexe_contact_email != blank -%}<p class="lexe-ct__mail">Questions? <a href="mailto:{{ settings.lexe_contact_email | escape }}">{{ settings.lexe_contact_email | escape }}</a></p>{%- endif -%}
</div>
<style>
.lexe-ct{display:flex;flex-direction:column;gap:6px;margin-top:10px;font-size:12px;opacity:.85}
.lexe-ct p{margin:0}.lexe-ct a{text-decoration:underline}
.lexe-ct__cards{display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:0;padding:0}
.lexe-ct__icon{height:22px;width:auto}
.lexe-ct__terms{display:flex;gap:8px;align-items:flex-start}
</style>
