{%- comment -%}
  LEXE SEO pass 2 (2026-09-26): Organization + WebSite (home) and BreadcrumbList (product, collection, blog, article, page).
  Product JSON-LD lives in sections/product-information.liquid; Article JSON-LD in sections/main-blog-post.liquid.
{%- endcomment -%}
{%- assign lexe_origin = request.origin | default: shop.url -%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ lexe_origin | append: '/#organization' | json }},
      "name": "LEXE by Devici Studios",
      "alternateName": ["LEXE", "Devici Studios"],
      "url": {{ lexe_origin | append: '/' | json }},
      {%- if settings.logo != blank %}
      "logo": {
        "@type": "ImageObject",
        "url": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
        "width": 600
      },
      {%- endif %}
      "founder": { "@type": "Person", "name": "Jayden Devici Williams" },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "Devici.studios@outlook.com",
        "url": {{ lexe_origin | append: '/pages/contact' | json }}
      }
    },
    {
      "@type": "WebSite",
      "@id": {{ lexe_origin | append: '/#website' | json }},
      "name": "LEXE by Devici Studios",
      "alternateName": "LEXE",
      "url": {{ lexe_origin | append: '/' | json }},
      "publisher": { "@id": {{ lexe_origin | append: '/#organization' | json }} },
      "inLanguage": {{ request.locale.iso_code | default: 'en' | json }}
    }
  ]
}
</script>
{%- else -%}
  {%- liquid
    assign crumb_mid_name = blank
    assign crumb_mid_url = blank
    assign crumb_last_name = blank
    case request.page_type
      when 'product'
        if collection
          assign crumb_mid_name = collection.title
          assign crumb_mid_url = collection.url
        endif
        assign crumb_last_name = product.title
      when 'collection'
        assign crumb_last_name = collection.title
      when 'blog'
        assign crumb_last_name = blog.title
      when 'article'
        assign crumb_mid_name = blog.title
        assign crumb_mid_url = blog.url
        assign crumb_last_name = article.title
      when 'page'
        assign crumb_last_name = page.title
    endcase
  -%}
  {%- if crumb_last_name != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ lexe_origin | append: '/' | json }} },
    {%- if crumb_mid_name != blank %}
    { "@type": "ListItem", "position": 2, "name": {{ crumb_mid_name | strip_html | json }}, "item": {{ lexe_origin | append: crumb_mid_url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ crumb_last_name | strip_html | json }}, "item": {{ canonical_url | json }} }
    {%- else %}
    { "@type": "ListItem", "position": 2, "name": {{ crumb_last_name | strip_html | json }}, "item": {{ canonical_url | json }} }
    {%- endif %}
  ]
}
</script>
  {%- endif -%}
{%- endif -%}
