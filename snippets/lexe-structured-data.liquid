{%- comment -%}
  LEXE SEO pass 2 (2026-09-26): Organization + WebSite (home) and BreadcrumbList (product, collection, blog, article, page).
  Product JSON-LD lives in sections/product-information.liquid; Article JSON-LD in sections/main-blog-post.liquid.
{%- endcomment -%}
{%- assign lexe_origin = request.origin | default: shop.url -%}
{%- comment -%} 2026-10-06: one Person definition shared by home, About and name pages so name strings and sameAs stay identical. {%- endcomment -%}
{%- capture lexe_person_sameas -%}["https://www.instagram.com/y2k_spex/", "https://www.tiktok.com/@lexe.studio", "https://www.linkedin.com/in/ray-j-williams-32053b441"]{%- endcapture -%}
{%- capture lexe_person_body -%}
      "@type": "Person",
      "@id": {{ lexe_origin | append: '/#creative-director' | json }},
      "name": "Jayden Devici Williams",
      "givenName": "Jayden",
      "additionalName": "Devici",
      "familyName": "Williams",
      "alternateName": ["Ray-j Jayden Williams", "Ray-j Williams", "Spex"],
      "jobTitle": "Creative Director",
      "description": "Jayden Devici Williams, also known as Ray-j Jayden Williams, is a creative director at LEXE by Devici Studios. His official Instagram is @y2k_spex.",
      "url": {{ lexe_origin | append: '/blogs/news/ray-j-jayden-williams' | json }},
      "sameAs": {{ lexe_person_sameas }},
      "worksFor": { "@type": "Organization", "@id": {{ lexe_origin | append: '/#organization' | json }}, "name": "Devici Studios", "alternateName": ["LEXE by Devici Studios", "LEXE"], "url": {{ lexe_origin | append: '/' | json }} }
{%- endcapture -%}
{%- if request.page_type == 'index' -%}
{%- assign lexe_logo = 'devici-studios-logo.png' | file_url | prepend: 'https:' -%}
{%- assign lexe_mark = 'lexe-by-devici-studios-logo.png' | file_url | prepend: 'https:' -%}
{%- assign lexe_og = 'lexe-by-devici-studios-og.jpg' | file_url | prepend: 'https:' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ lexe_origin | append: '/#organization' | json }},
      "name": "Devici Studios",
      "alternateName": ["LEXE by Devici Studios", "LEXE"],
      "url": {{ lexe_origin | append: '/' | json }},
      "description": "Devici Studios is a fashion and web design studio. Its main line, LEXE, covers faux leather outerwear, streetwear, sunglasses and iPhone cases.",
      "disambiguatingDescription": "Devici Studios (spelled D-E-V-I-C-I) is the studio behind the LEXE fashion line and Devici web design services.",
      "logo": {
        "@type": "ImageObject",
        "@id": {{ lexe_origin | append: '/#logo' | json }},
        "url": {{ lexe_logo | json }},
        "contentUrl": {{ lexe_logo | json }},
        "width": 1024,
        "height": 1024,
        "caption": "Devici Studios logo"
      },
      "image": [{{ lexe_mark | json }}, {{ lexe_og | json }}],
      "brand": {
        "@type": "Brand",
        "@id": {{ lexe_origin | append: '/#brand' | json }},
        "name": "LEXE",
        "alternateName": "LEXE by Devici Studios",
        "logo": {{ lexe_mark | json }},
        "url": {{ lexe_origin | append: '/collections/lexe' | json }}
      },
      "employee": { "@id": {{ lexe_origin | append: '/#creative-director' | json }} },
      "sameAs": ["https://www.instagram.com/y2k_spex/", "https://www.tiktok.com/@lexe.studio"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "Devici.studios@outlook.com",
        "url": {{ lexe_origin | append: '/pages/contact-us' | json }}
      }
    },
    {
{{ lexe_person_body }}
    },
    {
      "@type": "WebSite",
      "@id": {{ lexe_origin | append: '/#website' | json }},
      "name": "LEXE by Devici Studios",
      "alternateName": ["Devici Studios", "LEXE"],
      "url": {{ lexe_origin | append: '/' | json }},
      "publisher": { "@id": {{ lexe_origin | append: '/#organization' | json }} },
      "inLanguage": {{ request.locale.iso_code | default: 'en' | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "{{ lexe_origin }}/search?q={% raw %}{search_term_string}{% endraw %}" },
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>
{%- else -%}
  {%- liquid
    assign crumb_mid_name = blank
    assign crumb_mid_url = blank
    assign crumb_last_name = blank
    case request.page_type
      when 'product'
        if collection
          assign crumb_mid_name = collection.title
          assign crumb_mid_url = collection.url
        endif
        assign crumb_last_name = product.title
      when 'collection'
        assign crumb_last_name = collection.title
      when 'blog'
        assign crumb_last_name = blog.title
      when 'article'
        assign crumb_mid_name = blog.title
        assign crumb_mid_url = blog.url
        assign crumb_last_name = article.title
      when 'page'
        assign crumb_last_name = page.title
    endcase
  -%}
  {%- if crumb_last_name != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ lexe_origin | append: '/' | json }} },
    {%- if crumb_mid_name != blank %}
    { "@type": "ListItem", "position": 2, "name": {{ crumb_mid_name | strip_html | json }}, "item": {{ lexe_origin | append: crumb_mid_url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ crumb_last_name | strip_html | json }}, "item": {{ canonical_url | json }} }
    {%- else %}
    { "@type": "ListItem", "position": 2, "name": {{ crumb_last_name | strip_html | json }}, "item": {{ canonical_url | json }} }
    {%- endif %}
  ]
}
</script>
  {%- endif -%}
  {%- if request.page_type == 'collection' and collection.handle != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": {{ canonical_url | append: '#collectionpage' | json }},
  "name": {{ collection.title | strip_html | json }},
  "url": {{ canonical_url | json }},
  {%- assign lexe_cdesc = page_description | default: collection.description | strip_html | strip_newlines | truncate: 300 -%}
  {%- if lexe_cdesc != blank %}"description": {{ lexe_cdesc | json }},{% endif %}
  "isPartOf": { "@id": {{ lexe_origin | append: '/#website' | json }} },
  "publisher": { "@id": {{ lexe_origin | append: '/#organization' | json }} },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for p in collection.products limit: 12 %}
      { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ lexe_origin | append: p.url | json }}, "name": {{ p.title | strip_html | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor %}
    ]
  }
}
</script>
  {%- endif -%}
  {%- if request.page_type == 'page' and page.handle == 'about' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": {{ canonical_url | append: '#aboutpage' | json }},
  "url": {{ canonical_url | json }},
  "name": "About Devici Studios",
  "isPartOf": { "@id": {{ lexe_origin | append: '/#website' | json }} },
  "about": {
    "@type": "Organization",
    "@id": {{ lexe_origin | append: '/#organization' | json }},
    "name": "Devici Studios",
    "alternateName": ["LEXE by Devici Studios", "LEXE"],
    "url": {{ lexe_origin | append: '/' | json }}
  }
}
</script>
  {%- endif -%}
  {%- comment -%} Name pages (About + articles about Jayden Devici Williams): Person node with the official Instagram. {%- endcomment -%}
  {%- assign lexe_name_page = false -%}
  {%- if request.page_type == 'page' and page.handle == 'about' -%}
    {%- assign lexe_name_page = true -%}
  {%- elsif request.page_type == 'article' -%}
    {%- if article.tags contains 'Jayden Devici Williams' or article.tags contains 'Ray-j Jayden Williams' or article.handle == 'jayden-devici-williams' -%}
      {%- assign lexe_name_page = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- if lexe_name_page -%}
{%- if request.page_type == 'article' and article.handle == 'ray-j-jayden-williams' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": {{ canonical_url | append: '#profilepage' | json }},
  "url": {{ canonical_url | json }},
  "name": {{ article.title | strip_html | json }},
  {%- if article.published_at %}"dateCreated": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},{% endif %}
  "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
  "isPartOf": { "@id": {{ lexe_origin | append: '/#website' | json }} },
  "mainEntity": {
{{ lexe_person_body }}
  }
}
</script>
{%- else -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
{{ lexe_person_body }}
}
</script>
{%- endif -%}
  {%- endif -%}
{%- endif -%}
