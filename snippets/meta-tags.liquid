{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="view-transition" content="same-origin">
<meta name="theme-color" content="">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

{%- liquid
  # LEXE SEO pass 2: brand-aware title + home override (Preferences field not exposed via API)
  assign lexe_title = page_title | default: shop.name
  assign lexe_desc = page_description
  if request.page_type == 'index'
    assign lexe_title = 'LEXE by Devici Studios | Fashion, Phone Cases & Web Design'
    assign lexe_desc = 'Faux leather jackets, streetwear, sunglasses and iPhone cases from LEXE by Devici Studios, plus custom web design. 30-day returns on eligible apparel.'
  endif
  assign og_title = lexe_title
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = lexe_desc | default: shop.description | default: shop.name
  assign og_image = page_image

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
    if og_description == blank or og_description == shop.name
      if article.excerpt != blank
        assign og_description = article.excerpt | strip_html | truncate: 160
      elsif article.content != blank
        assign og_description = article.content | strip_html | truncate: 160
      endif
    endif
    if article.image
      assign og_image = article.image
    endif
  elsif request.page_type == 'blog'
    if og_description == blank or og_description == shop.name
      if blog.articles.first.excerpt != blank
        assign og_description = blog.articles.first.excerpt | strip_html | truncate: 160
      endif
    endif
    if og_image == blank and blog.articles.first.image
      assign og_image = blog.articles.first.image
    endif
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

<meta property="og:site_name" content="LEXE by Devici Studios">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | default: 'en' | replace: '-', '_' }}">

{%- if request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  {%- if article.author != blank -%}
    <meta property="article:author" content="{{ article.author | escape }}">
  {%- endif -%}
  {%- if blog.title != blank -%}
    <meta property="article:section" content="{{ blog.title | escape }}">
  {%- endif -%}
  {%- for tag in article.tags limit: 8 -%}
    <meta property="article:tag" content="{{ tag | escape }}">
  {%- endfor -%}
{%- endif -%}

{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}

<title>
  {{ lexe_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless lexe_title contains 'LEXE' %} | LEXE{% endunless -%}
</title>

<link rel="canonical" href="{{ canonical_url }}">

{%- if lexe_desc != blank -%}
  <meta name="description" content="{{ lexe_desc | escape }}">
{%- elsif og_description != blank -%}
  <meta name="description" content="{{ og_description | escape }}">
{%- endif -%}
