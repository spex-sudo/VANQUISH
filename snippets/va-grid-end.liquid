<style>
.va-end{
  display:flex;justify-content:center;align-items:center;gap:16px;
  margin:40px 0 16px;flex-wrap:wrap;
}
.va-neo{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  min-width:148px;height:52px;padding:0 24px;border-radius:18px;
  text-decoration:none;color:#1a1a1a;
  font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  background:#ececec;border:0;cursor:pointer;
  box-shadow:8px 8px 16px #d4d4d4, -8px -8px 16px #ffffff;
  transition:box-shadow .2s ease, transform .2s ease;
  -webkit-tap-highlight-color:transparent;
}
.va-neo svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
.va-neo:hover{transform:translateY(-1px);box-shadow:10px 10px 20px #cfcfcf, -10px -10px 20px #ffffff;}
.va-neo:active{
  transform:translateY(1px);
  box-shadow:inset 6px 6px 12px #d0d0d0, inset -6px -6px 12px #ffffff;
}
</style>
<script>
window.vaGridEnd=function(el){
  if(!el) return;
  var host = (el.closest && (el.closest('[id^="ApexSentinel"], [id^="VsrSentinel"], [class*="status"]'))) || el;
  if(host.querySelector && host.querySelector('.va-end')) return;
  var pulse = host.querySelector && host.querySelector('.apex-pulse');
  if(pulse) pulse.remove();
  host.innerHTML='<div class="va-end">'+
    '<a class="va-neo" data-va-search href="{{ routes.search_url }}">'+
      '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>'+
      'Search</a>'+
    '<a class="va-neo" href="{{ routes.root_url }}">'+
      '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7"></path><path d="M6 10.5V20h12v-9.5"></path></svg>'+
      'Home</a>'+
  '</div>';
  var s=host.querySelector('[data-va-search]');
  if(s) s.addEventListener('click',function(e){
    if(typeof window.apexOpenSearch==='function'){ e.preventDefault(); window.apexOpenSearch(); }
  });
};
(function(){
  function looksLoaded(node){
    if(!node || node.querySelector && node.querySelector('.va-end')) return false;
    var t=(node.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();
    return t==='all products loaded' || t==='all results loaded';
  }
  function scan(){
    var nodes=document.querySelectorAll('span,div,p');
    for(var i=0;i<nodes.length;i++){
      if(looksLoaded(nodes[i])) window.vaGridEnd(nodes[i]);
    }
  }
  function boot(){
    scan();
    var mo=new MutationObserver(function(){ scan(); });
    mo.observe(document.body,{childList:true,subtree:true,characterData:true});
    setInterval(scan, 600);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot);
  else boot();
})();
</script>
