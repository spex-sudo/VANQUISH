PROBE lexe: {% for p in collections.lexe.products %}{% assign n = n | plus: 1 %}{% unless p.available %}{% assign so = so | plus: 1 %}{% endunless %}{% endfor %} total={{ n }} soldout={{ so }} count={{ collections.lexe.products_count }}
