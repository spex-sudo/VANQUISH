<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <meta name="google-site-verification" content="2zHRZT7mBbzwW6Kzmcx14FvgbH6z_bZYDonCjNMgyIg" />
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'lexe-structured-data' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}
    {%- unless template.name == 'index' -%}
      <style id="inbox-home-only">/* Shopify Inbox: home page only */ shopify-chat { display: none !important; }</style>
    {%- endunless -%}
    <style id="hit-area-coarse">
      /* Invisible touch-target expansion for touch screens only. Visible size and layout are unchanged. */
      @media (pointer: coarse) {
        :where(.apex-menu-btn, .social-glass-btn, .vq-soc, .vq-help) { position: relative; }
        .apex-icon-btn::after, .apex-menu-btn::after, .social-glass-btn::after, .vq-soc::after, .vq-help::after { content: ""; position: absolute; }
        .apex-icon-btn::after { inset: -4px -2px; }
        .apex-menu-btn::after { inset: -3px -3px; }
        .social-glass-btn::after { inset: -4px; }
        .vq-soc::after { inset: -6px -2px; }
        .vq-help::after { inset: -9px -3px; }
      }
    </style>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {%- comment -%} LEXE SEO pass 3: one H1 per template that has no visible heading tag {%- endcomment -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="visually-hidden">LEXE by Devici Studios</h1>
      {%- elsif request.page_type == 'collection' -%}
        <h1 class="visually-hidden">{{ page_title | split: ' | ' | first | default: collection.title | escape }}</h1>
      {%- endif -%}
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}
    {% render 'apex-search-dropdown' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
    {% render 'adb-tracker' %}
    {% render 'sticky-lock' %}
    {% render 'va-grid-end' %}
  </body>
</html>
