

<script
  src="{{ 'comparison-slider-cmptest.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign ratio = 1

  case block.settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'adapt'
      if block.settings.before_image
        assign ratio = block.settings.before_image.aspect_ratio
      elsif block.settings.after_image
        assign ratio = block.settings.after_image.aspect_ratio
      endif
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
%}

{%- liquid
  assign cs_accent = block.settings.accent_color | default: '#9966CC'
  assign cs_handle = block.settings.handle_style | default: 'ring'
  assign cs_start = block.settings.start_position | default: 50
  assign cs_label_bg = block.settings.text_background_color | default: '#111111'
  assign cs_label_fg = '#ffffff'
  if cs_label_bg != blank
    assign cs_bright = cs_label_bg | color_brightness
    if cs_bright > 160
      assign cs_label_fg = '#111111'
    endif
  endif
  assign cs_before_label = block.settings.before_text | default: 'Before'
  assign cs_after_label = block.settings.after_text | default: 'After'
-%}

<comparison-slider-component
  class="cmpx cmpx--{{ block.settings.slider_style }} spacing-style size-style border-style{% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }}{% endif %}"
  style="--ratio: {{ ratio }}; --cs-accent: {{ cs_accent }}; --text-background-color: {{ cs_label_bg }}; --cs-label-fg: {{ cs_label_fg }}; --text-corner-radius: {{ block.settings.text_corner_radius }}px; {% render 'spacing-style', settings: block.settings %} {% render 'size-style', settings: block.settings %} {% render 'border-override', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <div class="cmpx__container">
    <div
      class="cmpx__media-wrapper"
      ref="mediaWrapper"
      data-cmpx
      data-orientation="{{ block.settings.slider_style }}"
      data-handle="{{ cs_handle }}"
      data-start="{{ cs_start }}"
      data-hint="{% if block.settings.show_hint == false %}false{% else %}true{% endif %}"
      data-before-label="{{ cs_before_label | escape }}"
      data-after-label="{{ cs_after_label | escape }}"
      style="--pos: {{ cs_start }};"
      {% if block.settings.show_text %}
        {% if block.settings.slider_style == 'horizontal' %}
          data-text-position="{{ block.settings.text_position_horizontal }}"
        {% else %}
          data-text-position="{{ block.settings.text_position_vertical }}"
        {% endif %}
      {% endif %}
    >
      <div class="cmpx__layer cmpx__layer--before">
        {%- if block.settings.before_image != blank -%}
          {{
            block.settings.before_image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              decoding: 'async',
              draggable: 'false',
              class: 'cx-before-image',
              alt: block.settings.before_image.alt,
              widths: '480, 720, 960, 1280, 1600, 2000, 2400',
              sizes: 'auto, 100vw',
              width: block.settings.before_image.width,
              height: block.settings.before_image.height,
              ref: 'beforeImage'
          }}
        {%- else -%}
          <div
            class="cmpx__placeholder cx-before-image"
            ref="beforeImage"
          >
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}

        {% if block.settings.show_text and block.settings.before_text != blank %}
          <div class="cmpx__text cmpx__text--before{% if block.settings.text_background %} cmpx__text--with-bg{% endif %}">
            <div class="cmpx__text-inner{% if block.settings.text_preset != blank %} {{ block.settings.text_preset }}{% endif %}">{{ block.settings.before_text }}</div>
          </div>
        {% endif %}
      </div>

      <div class="cmpx__layer cmpx__layer--after">
        {%- if block.settings.after_image != blank -%}
          {{
            block.settings.after_image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              decoding: 'async',
              draggable: 'false',
              class: 'cx-after-image',
              alt: block.settings.after_image.alt,
              widths: '480, 720, 960, 1280, 1600, 2000, 2400',
              sizes: 'auto, 100vw',
              width: block.settings.after_image.width,
              height: block.settings.after_image.height,
              ref: 'afterImage'
          }}
        {%- else -%}
          <div
            class="cmpx__placeholder cx-after-image"
            ref="afterImage"
          >
            {{ 'product-apparel-2' | placeholder_svg_tag }}
          </div>
        {%- endif -%}

        {% if block.settings.show_text and block.settings.after_text != blank %}
          <div class="cmpx__text cmpx__text--after{% if block.settings.text_background %} cmpx__text--with-bg{% endif %}">
            <div class="cmpx__text-inner{% if block.settings.text_preset != blank %} {{ block.settings.text_preset }}{% endif %}">{{ block.settings.after_text }}</div>
          </div>
        {% endif %}
      </div>

      <span class="cx-slider__line" aria-hidden="true"></span>

      <div
        class="cx-slider__handle"
        ref="slider"
        role="slider"
        tabindex="0"
        aria-label="{{ 'blocks.slider_label' | t }}"
        aria-orientation="{{ block.settings.slider_style }}"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ cs_start }}"
        aria-valuetext="{{ cs_start }}% {{ cs_before_label | escape }}, {{ 100 | minus: cs_start }}% {{ cs_after_label | escape }}"
      >
        <svg class="cx-slider__chevron" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M7.5 2.25 3.75 6l3.75 3.75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <svg class="cx-slider__chevron cx-slider__chevron--next" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M4.5 2.25 8.25 6 4.5 9.75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
  </div>
</comparison-slider-component>

{% stylesheet %}
  comparison-slider-component {
    display: block;
  }

  .cmpx {
    --cs-accent: #9966cc;
    --cs-line: 2px;
    --cs-handle: 44px;

    position: relative;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: var(--ratio);
    font-family: var(--font-body--family, inherit);
    -webkit-tap-highlight-color: transparent;
  }

  .cmpx:not(:has(img)) {
    min-width: 25dvh;
  }

  .cmpx__container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Container and layout. --pos is the divider position (0-100) from the left/top edge. */
  .cmpx__media-wrapper {
    --pos: 50;

    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template: 1fr / 1fr;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
    cursor: ew-resize;
  }

  .cmpx__media-wrapper[data-orientation='vertical'] {
    touch-action: pan-x;
    cursor: ns-resize;
  }

  .cmpx__media-wrapper.is-dragging {
    cursor: grabbing;
  }

  .cmpx__layer {
    grid-area: 1 / 1;
    position: relative;
    width: 100%;
    height: 100%;
  }

  .cmpx__layer--after {
    z-index: 0;
  }

  .cmpx__layer--before {
    z-index: 1;
  }

  [data-orientation='horizontal'] .cmpx__layer--before {
    clip-path: inset(0 calc((100 - var(--pos)) * 1%) 0 0);
  }

  [data-orientation='vertical'] .cmpx__layer--before {
    clip-path: inset(0 0 calc((100 - var(--pos)) * 1%) 0);
  }

  [data-orientation='horizontal'] .cmpx__layer--after {
    clip-path: inset(0 0 0 calc(var(--pos) * 1%));
  }

  [data-orientation='vertical'] .cmpx__layer--after {
    clip-path: inset(calc(var(--pos) * 1%) 0 0 0);
  }

  .cx-before-image,
  .cx-after-image,
  .cmpx__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: var(--ratio);
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .cmpx__placeholder {
    position: absolute;
    inset: 0;
  }

  .cmpx__placeholder svg {
    width: 100%;
    height: 100%;
    background-color: var(--color-background);
    fill: var(--color-foreground);
  }

  /* Divider line: thin, soft shadow so it reads on light and dark images */
  .cx-slider__line {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.2), 0 0 14px rgb(0 0 0 / 0.3);
  }

  [data-orientation='horizontal'] .cx-slider__line {
    inset-block: 0;
    left: calc(var(--pos) * 1%);
    width: var(--cs-line);
    transform: translateX(-50%);
  }

  [data-orientation='vertical'] .cx-slider__line {
    inset-inline: 0;
    top: calc(var(--pos) * 1%);
    height: var(--cs-line);
    transform: translateY(-50%);
  }

  /* Handle: round, dark by default, accent ring, subtle arrows */
  .cx-slider__handle {
    --cs-handle-bg: rgb(17 17 17 / 0.92);
    --cs-handle-fg: #fff;
    --cs-handle-ring: var(--cs-accent);

    position: absolute;
    z-index: 3;
    width: var(--cs-handle);
    height: var(--cs-handle);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 50%;
    background: var(--cs-handle-bg);
    color: var(--cs-handle-fg);
    box-shadow:
      0 0 0 2px var(--cs-handle-ring),
      0 6px 18px rgb(0 0 0 / 0.32);
    cursor: grab;
    touch-action: none;
    outline: none;
    transition: box-shadow 0.2s ease, gap 0.2s ease, scale 0.2s ease;
  }

  [data-handle='accent'] .cx-slider__handle {
    --cs-handle-bg: var(--cs-accent);
    --cs-handle-ring: rgb(255 255 255 / 0.92);
  }

  [data-handle='light'] .cx-slider__handle {
    --cs-handle-bg: rgb(255 255 255 / 0.96);
    --cs-handle-fg: #111;
  }

  [data-orientation='horizontal'] .cx-slider__handle {
    top: 50%;
    left: clamp(calc(var(--cs-handle) / 2), calc(var(--pos) * 1%), calc(100% - var(--cs-handle) / 2));
    transform: translate(-50%, -50%);
  }

  [data-orientation='vertical'] .cx-slider__handle {
    left: 50%;
    top: clamp(calc(var(--cs-handle) / 2), calc(var(--pos) * 1%), calc(100% - var(--cs-handle) / 2));
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .cx-slider__chevron {
    flex: none;
    opacity: 0.85;
  }

  .cmpx__media-wrapper:hover .cx-slider__handle,
  .cx-slider__handle:focus-visible {
    gap: 2px;
    box-shadow:
      0 0 0 2px var(--cs-handle-ring),
      0 0 0 7px color-mix(in srgb, var(--cs-accent) 28%, transparent),
      0 6px 18px rgb(0 0 0 / 0.32);
  }

  .cx-slider__handle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .cmpx__media-wrapper.is-dragging .cx-slider__handle {
    cursor: grabbing;
    scale: 1.06;
  }

  /* Smooth only for taps, clicks and key presses; dragging stays 1:1 with the pointer */
  .cmpx__media-wrapper[data-smooth] .cmpx__layer,
  .cmpx__media-wrapper[data-smooth] .cx-slider__line,
  .cmpx__media-wrapper[data-smooth] .cx-slider__handle {
    transition: clip-path 0.22s ease-out, left 0.22s ease-out, top 0.22s ease-out, box-shadow 0.2s ease, gap 0.2s ease,
      scale 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .cmpx__media-wrapper[data-smooth] .cmpx__layer,
    .cmpx__media-wrapper[data-smooth] .cx-slider__line,
    .cmpx__media-wrapper[data-smooth] .cx-slider__handle,
    .cx-slider__handle {
      transition: none;
    }
  }

  /* Labels: styled like the site's small pill tags */
  .cmpx__text {
    position: absolute;
    z-index: 2;
    margin: var(--padding-sm, 12px);
    padding: 0;
    pointer-events: none;
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.55);
  }

  .cmpx__text-inner:not(.h1, .h2, .h3, .h4, .h5, .h6, .paragraph) {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cmpx__text--with-bg {
    padding: 5px 11px;
    color: var(--cs-label-fg, #fff);
    text-shadow: none;
    background: color-mix(in srgb, var(--text-background-color, #111) 78%, transparent);
    border-radius: var(--text-corner-radius, 50px);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  [data-orientation='horizontal'] .cmpx__text--before {
    inset-inline-start: 0;
  }

  [data-orientation='horizontal'] .cmpx__text--after {
    inset-inline-end: 0;
  }

  [data-orientation='horizontal'][data-text-position='start'] .cmpx__text {
    inset-block-start: 0;
  }

  [data-orientation='horizontal'][data-text-position='end'] .cmpx__text {
    inset-block-end: 0;
  }

  [data-orientation='vertical'] .cmpx__text--before {
    inset-block-start: 0;
  }

  [data-orientation='vertical'] .cmpx__text--after {
    inset-block-end: 0;
  }

  [data-orientation='vertical'][data-text-position='start'] .cmpx__text {
    inset-inline-start: 0;
  }

  [data-orientation='vertical'][data-text-position='end'] .cmpx__text {
    inset-inline-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.comparison_slider",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "t:settings.image_1"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "t:settings.image_2"
    },
    {
      "type": "select",
      "id": "slider_style",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "horizontal",
          "label": "t:options.horizontal"
        },
        {
          "value": "vertical",
          "label": "t:options.vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "start_position",
      "label": "Start position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "How much of the first image shows before anyone drags (0 shows only the second image)."
    },
    {
      "type": "checkbox",
      "id": "show_hint",
      "label": "Nudge the handle when first visible",
      "default": true,
      "info": "A short side-to-side movement. Skipped for visitors who prefer reduced motion."
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "t:settings.text_on_images",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.text",
      "visible_if": "{{ block.settings.show_text }}"
    },
    {
      "type": "text",
      "id": "before_text",
      "label": "t:settings.image_1",
      "default": "Before",
      "visible_if": "{{ block.settings.show_text }}"
    },
    {
      "type": "text",
      "id": "after_text",
      "label": "t:settings.image_2",
      "default": "After",
      "visible_if": "{{ block.settings.show_text }}"
    },
    {
      "type": "select",
      "id": "text_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "visible_if": "{{ block.settings.show_text }}"
    },
    {
      "type": "select",
      "id": "text_position_horizontal",
      "label": "t:settings.position",
      "options": [
        {
          "value": "start",
          "label": "t:options.top"
        },
        {
          "value": "end",
          "label": "t:options.bottom"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.show_text and block.settings.slider_style == \"horizontal\" }}"
    },
    {
      "type": "select",
      "id": "text_position_vertical",
      "label": "t:settings.position",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.show_text and block.settings.slider_style == \"vertical\" }}"
    },
    {
      "type": "checkbox",
      "id": "text_background",
      "label": "t:settings.background",
      "default": true,
      "visible_if": "{{ block.settings.show_text }}"
    },
    {
      "type": "color",
      "id": "text_background_color",
      "label": "t:settings.background_color",
      "default": "#111111",
      "visible_if": "{{ block.settings.text_background and block.settings.show_text }}"
    },
    {
      "type": "range",
      "id": "text_corner_radius",
      "label": "t:settings.corner_radius",
      "default": 50,
      "min": 0,
      "max": 50,
      "step": 1,
      "visible_if": "{{ block.settings.text_background and block.settings.show_text }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#9966CC",
      "info": "Handle ring, focus glow and accent handle."
    },
    {
      "type": "select",
      "id": "handle_style",
      "label": "Handle style",
      "options": [
        { "value": "ring", "label": "Dark with accent ring" },
        { "value": "accent", "label": "Solid accent" },
        { "value": "light", "label": "Light with accent ring" }
      ],
      "default": "ring"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
