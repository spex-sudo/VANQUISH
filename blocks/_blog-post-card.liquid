{%- assign block_settings = block.settings -%}

<article
  class="blog-post-card blog-post-card--liquid"
  style="--text-align: {{ block_settings.alignment }}"
>
  {% if article.image %}
    {% content_for 'block', id: 'image', type: '_blog-post-image', article: article %}
  {% endif %}

  <div class="blog-post-card__content">
    <a
      href="{{ article.url }}"
      class="blog-post-card__title-link"
      data-testid="blog-post-link"
    >
      {%- content_for 'block', id: 'heading', type: '_heading', text: article.title -%}
    </a>

    {% content_for 'block',
      id: 'blog-post-details',
      type: '_blog-post-info-text',
      alignment: block_settings.alignment,
      article: article
    %}

    {% content_for 'block', id: 'content', type: '_blog-post-description', article: article, show_read_more: true %}
  </div>
</article>

{% stylesheet %}
  .orbit-counter,
  .orbit-master .orbit-counter,
  [data-perf],
  .perf-counter,
  .fps-meter,
  .performance-hud {
    display: none !important;
  }

  .blog-post-card {
    display: flex;
    flex-direction: column;
    text-align: var(--text-align);
    column-gap: var(--columns-gap);
    position: relative;
    height: 100%;
  }

  .blog-post-card--liquid {
    isolation: isolate;
  }

  .blog-post-item--horizontal:has(.blog-post-card__image-container) .blog-post-card {
    & > *:first-child {
      flex-basis: 62%;
    }

    & > *:last-child {
      flex-basis: 38%;
    }
  }

  .blog-post-card__content {
    padding-block-start: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .blog-post-item .blog-post-card__image-container,
  .blog-post-item .blog-post-card__content {
    width: 100%;
  }

  .blog-post-item--horizontal .blog-post-card {
    flex-direction: row;
    align-items: stretch;
    gap: 1.75rem;

    @media screen and (max-width: 749px) {
      flex-direction: column;
      gap: 0.85rem;
    }
  }

  .blog-post-card__title-link {
    display: block;
    text-wrap: pretty;
    text-decoration: none;
    color: inherit;
    padding-block-start: 0.2rem;
    transition: opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .blog-post-card__title-link:hover {
    opacity: 0.62;
  }

  .blog-post-card__title-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    }
  ]
}
{% endschema %}
