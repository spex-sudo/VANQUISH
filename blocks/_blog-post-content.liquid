<div class="blog-post-content rte">
  <rte-formatter>
    {{ article.content }}
  </rte-formatter>
</div>

{% stylesheet %}
  .blog-post-content {
    max-width: min(42rem, var(--normal-content-width, 42rem));
    margin: 0 auto;
    width: 100%;
    font-size: clamp(1.02rem, 0.4vw + 0.96rem, 1.125rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .blog-post-content :is(h2, h3, h4) {
    text-wrap: balance;
    letter-spacing: -0.02em;
    margin-block: 1.6em 0.55em;
  }

  .blog-post-content p + p {
    margin-block-start: 1.1em;
  }

  .blog-post-content img,
  .blog-post-content video,
  .blog-post-content iframe {
    max-width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
  }

  .blog-post-content a {
    text-underline-offset: 0.18em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [],
  "presets": [
    {
      "name": "t:names.content"
    }
  ]
}
{% endschema %}
