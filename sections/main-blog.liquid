<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<blog-posts-list section-id="{{ section.id }}">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="
      section
      color-{{ section.settings.color_scheme }}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    <div ref="grid" class="blog-posts-container">
      {% liquid
        assign items_on_page = blog.articles.size
      %}
      {% for article in blog.articles %}
        {% liquid
          assign col_span = 2
          assign scale = 0.6
          assign is_horizontal = false

          case items_on_page
            when 1
              assign col_span = 6
              assign scale = 1
              assign is_horizontal = true
            when 2
              assign col_span = 3
              assign scale = 0.8
            when 3
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            when 4
              assign col_span = 3
              assign scale = 0.8
            when 5
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            else
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              elsif forloop.index <= 3
                assign col_span = 3
                assign scale = 0.8
              else
                assign col_span = 2
                assign scale = 0.6
              endif
          endcase
        %}
        {% style %}
          [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
            --col-span: {{ col_span }};
            --blog-post-card-scale: {{ scale }};
          }
          @media screen and (max-width: 749px) {
            [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
              --col-span: 6;
              --blog-post-card-scale: 0.72;
            }
          }
        {% endstyle %}
        <div
          class="blog-post-item{% if is_horizontal %} blog-post-item--horizontal{% endif %}"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ forloop.index }}"
        >
          {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
        </div>
      {% endfor %}
    </div>
  </div>
</blog-posts-list>

{%- if blog.articles.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": {{ blog.title | json }},
  "url": {{ request.origin | append: blog.url | json }},
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }}
  },
  "blogPost": [
    {%- for article in blog.articles limit: 20 -%}
    {
      "@type": "BlogPosting",
      "headline": {{ article.title | json }},
      "url": {{ request.origin | append: article.url | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }}
      {%- if article.excerpt != blank -%},
      "description": {{ article.excerpt | strip_html | truncate: 160 | json }}
      {%- endif -%}
      {%- if article.image -%},
      "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}
      {%- endif -%}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ blog.title | json }},
  "itemListElement": [
    {%- for article in blog.articles limit: 20 -%}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "url": {{ request.origin | append: article.url | json }},
      "name": {{ article.title | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% stylesheet %}
  .orbit-counter, .perf-counter, .fps-meter, [data-perf-hud] { display: none !important; }
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 28px;
    --rows-gap: 40px;
  }
  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }
  .blog-post-item { grid-column: span var(--col-span); min-width: 0; }
  .blog-post-item:not(:has(.blog-post-card__image-container)) {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20, 0.16));
    padding: 1.1rem 1.15rem 1.25rem;
  }
  .blog-post-item:has(.blog-post-card__image-container) { border: none; padding: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    { "type": "@theme" }, { "type": "@app" }, { "type": "text" }, { "type": "icon" },
    { "type": "image" }, { "type": "button" }, { "type": "video" }, { "type": "group" },
    { "type": "spacer" }, { "type": "_divider" }
  ],
  "disabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ]
}
{% endschema %}
