{%- style -%}
  :root { --bp-gold: {{ section.settings.accent }}; --bp-red: #ff4444; }
  .bp-master-wrapper {
    background: #000;
    padding: 60px 0;
    position: relative;
    font-family: monospace;
    color: #fff;
    overflow: hidden;
  }
  
  /* Indicators for swipe discovery */
  .swipe-indicator {
    position: absolute; top: 50%; transform: translateY(-50%);
    font-size: 20px; color: var(--bp-gold); opacity: 0;
    animation: ghost-swipe 4s infinite; pointer-events: none; z-index: 50;
  }
  .left-indicator { left: 20px; animation-name: ghost-swipe-left; }
  .right-indicator { right: 20px; }
  
  @keyframes ghost-swipe { 0%,100%{opacity:0;} 50%{opacity:0.2; transform:translateY(-50%) translateX(10px);} }
  @keyframes ghost-swipe-left { 0%,100%{opacity:0;} 50%{opacity:0.2; transform:translateY(-50%) translateX(-10px);} }

  .bp-carousel-track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .bp-carousel-track::-webkit-scrollbar { display: none; }
  
  .bp-slide { min-width: 100%; scroll-snap-align: start; display: flex; justify-content: center; }
  .bp-container { max-width: 800px; width: 100%; padding: 0 20px; position: relative; }
  
  /* Standard 1:1 Aspect Ratio */
  .bp-canvas {
    position: relative;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background:rgb(0, 0, 0);
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
  }
  
  .bp-main-img {
    width: 100%; height: 100%; object-fit: cover;
    display: block; filter: contrast(1.1) grayscale(0.2);
  }

  .bp-scanner-beam {
    position: absolute; top: 0; left: -100%; width: 45%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(131, 55, 212, 0.08), transparent);
    animation: scan-sweep 6s infinite linear; z-index: 2; pointer-events: none;
  }
  @keyframes scan-sweep { 0% { left: -100%; } 40% { left: 150%; } 100% { left: 150%; } }

  /* HOTSPOTS */
  .bp-point { position: absolute; width: 32px; height: 32px; z-index: 10; transform: translate(-50%, -50%); cursor: pointer; }
  .bp-pulse { width: 100%; height: 100%; border: 1px solid var(--bp-gold); border-radius: 50%; animation: p-ring 2.5s infinite; }
  .is-restricted .bp-pulse { border-color: var(--bp-red); animation: p-ring-red 1.2s infinite; }
  
  @keyframes p-ring { 0%{transform:scale(0.5); opacity:1;} 100%{transform:scale(2.4); opacity:0;} }
  @keyframes p-ring-red { 0%{transform:scale(0.5); opacity:1;} 100%{transform:scale(3); opacity:0;} }

  .bp-data {
    position: absolute; bottom: 40px; left: 0; width: 180px;
    opacity: 0; visibility: hidden; transition: 0.3s;
    background: rgba(1, 1, 1, 0.49); padding: 12px; border-left: 2px solid var(--bp-gold);
    z-index: 20; transform: translateY(10px); pointer-events: none;
  }
  .bp-point.is-active .bp-data { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; }
  .is-restricted .bp-data { border-left-color: var(--bp-red); }

  .bp-label { color: var(--bp-gold); font-size: 8px; display: block; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 5px; }
  .bp-desc { font-size: 10px; margin: 0; line-height: 1.3; color: #fff; }

  /* POPUP */
  .bp-popup-overlay { position: fixed; inset: 0; background: rgba(255, 255, 255, 0.98); z-index: 1000; display: none; align-items: center; justify-content: center; backdrop-filter: blur(10px); }
  .bp-popup-overlay.is-active { display: flex; }
  .bp-popup-content { width: 90%; max-width: 400px; padding: 40px; border: 1px solid var(--bp-gold); text-align: center; background: #000; }
{%- endstyle -%}

<div class="bp-master-wrapper" id="bp-{{ section.id }}">
  <div class="swipe-indicator left-indicator">‹</div>
  <div class="swipe-indicator right-indicator">›</div>

  <div class="bp-carousel-track">
    {% for block in section.blocks %}
      <div class="bp-slide" {{ block.shopify_attributes }}>
        <div class="bp-container">
          <div class="bp-canvas">
            <div class="bp-scanner-beam"></div>
            
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" class="bp-main-img" alt="{{ block.settings.image.alt }}" loading="lazy" width="1200" height="{{ 1200 | divided_by: block.settings.image.aspect_ratio | ceil }}">
            {%- endif -%}

            {% for i in (1..2) %}
              {% capture show %}show_p{{ i }}{% endcapture %}
              {% capture x %}p{{ i }}_x{% endcapture %}
              {% capture y %}p{{ i }}_y{% endcapture %}
              {% capture restricted %}p{{ i }}_restricted{% endcapture %}
              {% capture title %}p{{ i }}_title{% endcapture %}
              {% capture desc %}p{{ i }}_desc{% endcapture %}

              {% if block.settings[show] %}
                <div class="bp-point {% if block.settings[restricted] %}is-restricted{% endif %}"
                     style="top: {{ block.settings[y] }}%; left: {{ block.settings[x] }}%;"
                     onclick="togglePoint(this)">
                  <div class="bp-pulse"></div>
                  <div class="bp-data">
                    <span class="bp-label">{% if block.settings[restricted] %}[ RESTRICTED ]{% else %}{{ block.settings[title] }}{% endif %}</span>
                    <p class="bp-desc">
                      {% if block.settings[restricted] %}LEVEL_4_AUTH_REQUIRED <span style="color:var(--bp-red); cursor:pointer; text-decoration:underline;" onclick="openClearance(event)">REQUEST_ACCESS</span>{% else %}{{ block.settings[desc] }}{% endif %}
                    </p>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<div class="bp-popup-overlay" id="bp-popup-{{ section.id }}" onclick="closeClearance()">
  <div class="bp-popup-content" onclick="event.stopPropagation()">
    <div class="bp-popup-header">[ ACCESS_REQUEST ]</div>
    {% form 'customer', id: 'clearance_form' %}
      <input type="email" name="contact[email]" placeholder="ENTER_EMAIL" required style="background:#000; border:1px solid #333; color:#fff; padding:10px; width:100%; margin:20px 0;">
      <button type="submit" style="background:var(--bp-gold); color:#000; border:none; padding:10px 20px; width:100%; cursor:pointer;">SUBMIT_CREDENTIALS</button>
    {% endform %}
  </div>
</div>

<script>
  function togglePoint(el) {
    const active = el.classList.contains('is-active');
    document.querySelectorAll('.bp-point').forEach(p => p.classList.remove('is-active'));
    if (!active) el.classList.add('is-active');
  }
  function openClearance(e) { e.stopPropagation(); document.getElementById('bp-popup-{{ section.id }}').classList.add('is-active'); }
  function closeClearance() { document.getElementById('bp-popup-{{ section.id }}').classList.remove('is-active'); }
</script>

{% schema %}
{
  "name": "Sovereign Intel Engine",
  "settings": [
    {
      "type": "color",
      "id": "accent",
      "label": "Accent Color",
      "default": "#3100A4"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Intel Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "header", "content": "Hotspot 1" },
        { "type": "checkbox", "id": "show_p1", "label": "Show Point 1", "default": true },
        { "type": "range", "id": "p1_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "X Position", "default": 50 },
        { "type": "range", "id": "p1_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Y Position", "default": 50 },
        { "type": "checkbox", "id": "p1_restricted", "label": "Restrict Content", "default": false },
        { "type": "text", "id": "p1_title", "label": "Title", "default": "COMPONENT_INTEL" },
        { "type": "textarea", "id": "p1_desc", "label": "Description", "default": "Data stream verified." },
        { "type": "header", "content": "Hotspot 2" },
        { "type": "checkbox", "id": "show_p2", "label": "Show Point 2", "default": false },
        { "type": "range", "id": "p2_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "X Position", "default": 30 },
        { "type": "range", "id": "p2_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Y Position", "default": 30 },
        { "type": "checkbox", "id": "p2_restricted", "label": "Restrict Content", "default": true },
        { "type": "text", "id": "p2_title", "label": "Title", "default": "ENCRYPTED_DATA" },
        { "type": "textarea", "id": "p2_desc", "label": "Description", "default": "Access denied." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sovereign Intel Engine",
      "blocks": [ { "type": "slide" } ]
    }
  ]
}
{% endschema %}