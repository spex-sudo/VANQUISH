    { "type": "image_picker","id": "logo",              "label": "Logo Image" },
    { "type": "video",       "id": "logo_video",         "label": "Logo Video", "info": "Optional — takes priority over the logo image if both are set. Plays muted, looped, inline. Never cropped: the header automatically grows to fit it." },
    { "type": "range",       "id": "logo_height",       "label": "Max Logo Height (px)", "min": 16, "max": 80, "step": 2, "default": 26, "info": "The logo/video scales to fit inside this height without ever being cropped or stretched." },
    { "type": "text",        "id": "logo_subtext",      "label": "Logo Subtext",          "default": "{currency}", "info": "Use {currency} for live ISO code. Leave blank to hide." },
    { "type": "font_picker", "id": "text_logo_font",    "label": "Text Logo Font",        "default": "work_sans_n7" },
    { "type": "range",       "id": "text_logo_size",    "label": "Text Logo Size (px)",  "min": 14, "max": 40, "step": 1, "default": 22 },
    { "type": "range",       "id": "text_logo_spacing", "label": "Letter Spacing (px)",  "min": 0,  "max": 15, "step": 1, "default": 3 },

    { "type": "header", "content": "🔍 Search" },
    { "type": "text", "id": "search_placeholder", "label": "Search Placeholder", "default": "Search products…" },

    { "type": "header", "content": "🛒 Icons & Cart Badge" },
    { "type": "range", "id": "icon_size",        "label": "Icon Size (px)",        "min": 16, "max": 28, "step": 1, "default": 20 },
    { "type": "color", "id": "badge_bg_color",   "label": "Cart Badge Background", "default": "#e63946" },
    { "type": "color", "id": "badge_text_color", "label": "Cart Badge Text",        "default": "#ffffff" },
    { "type": "url",   "id": "custom_cart_url",  "label": "Custom Cart URL",        "info": "Leave blank for /cart." },

    { "type": "header", "content": "🔗 Drawer Footer Links" },
    { "type": "text", "id": "footer_link_1_text", "label": "Link 1 Label", "default": "Contact" },
    { "type": "url",  "id": "footer_link_1_url",  "label": "Link 1 URL" },
    { "type": "text", "id": "footer_link_2_text", "label": "Link 2 Label", "default": "About" },
    { "type": "url",  "id": "footer_link_2_url",  "label": "Link 2 URL" },

    { "type": "header", "content": "🎨 Search Overlay Colors" },
    { "type": "color", "id": "accent_color",      "label": "Accent",            "default": "#d4af37" },
    { "type": "color", "id": "scroll_bg_color",   "label": "Search Overlay BG", "default": "#ffffff" },
    { "type": "color", "id": "scroll_text_color", "label": "Search Overlay Text","default": "#000000" },

    { "type": "header", "content": "🗄 Vault" },
    { "type": "text",  "id": "vault_label",   "label": "Vault Section Title",     "default": "THE VAULT" },
    { "type": "range", "id": "vault_radius",  "label": "Vault Image Radius (px)", "min": 0, "max": 24, "step": 1, "default": 4 }
  ],
  "max_blocks": 16,
  "blocks": [
    {
      "type": "collection", "name": "Vault Collection", "limit": 4,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    },
    {
      "type": "quick_link", "name": "Quick-Nav Link", "limit": 7,
      "settings": [
        { "type": "text",     "id": "label",            "label": "Link Label",           "default": "New Arrivals" },
        { "type": "url",      "id": "url",              "label": "Link URL" },
        { "type": "header",   "content": "Optional Badge" },
        { "type": "text",     "id": "badge_text",       "label": "Badge Text",           "info": "E.g. NEW, HOT, -30%. Leave blank to hide." },
        { "type": "color",    "id": "badge_bg",         "label": "Badge Background",     "default": "#000000" },
