    { "type": "url",     "id": "notif_url",          "label": "Link URL",               "info": "Optional. Makes the pill clickable." },
    { "type": "color",   "id": "notif_pill_text",   "label": "Pill text color",        "default": "#ffffff" },

    { "type": "header",  "content": "🔔 Flash Notifications" },
    { "type": "paragraph", "content": "Add Flash Notification blocks below. They appear next to the mini header pill every N seconds for a short burst, regardless of scroll position." },
    { "type": "range",   "id": "flash_interval",    "label": "Interval between flashes", "min": 5,    "max": 60,    "step": 1,    "unit": "s",  "default": 15 },
    { "type": "range",   "id": "flash_duration",    "label": "How long each flash shows", "min": 2,    "max": 10,    "step": 1,    "unit": "s",  "default": 5 },
    { "type": "header",  "content": "🚚 Free Shipping Progress" },
