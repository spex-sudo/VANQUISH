    { "type": "range",    "id": "frosted_blur",         "label": "Frosted Blur Strength (px)", "min": 0, "max": 30, "step": 1, "default": 18 },
    { "type": "range",    "id": "drawer_radius",        "label": "Drawer Corner Radius (px)",  "min": 0, "max": 60, "step": 2, "default": 24 },
    { "type": "range",    "id": "drawer_width",         "label": "Drawer Width (% of screen)", "min": 30, "max": 80, "step": 5, "default": 50 },
    { "type": "range",    "id": "drawer_max_width",     "label": "Drawer Max Width (px)",      "min": 320, "max": 720, "step": 20, "default": 520 },
    { "type": "color",    "id": "pill_bg_color",        "label": "Pill Background",            "default": "#ececec" },
    { "type": "color",    "id": "pill_text_color",      "label": "Pill Text & Icons",          "default": "#000000" },

    { "type": "header", "content": "🧭 Quick-Nav Strip" },
    { "type": "paragraph", "content": "Collection links below the header. Add Quick-Nav Link blocks to populate." },
    { "type": "checkbox", "id": "show_qn",              "label": "Show Quick-Nav Strip",       "default": true },
    { "type": "select",   "id": "qn_alignment",         "label": "Alignment",
      "options": [
        { "value": "flex-end",      "label": "Right"   },
        { "value": "center",        "label": "Center"  },
        { "value": "flex-start",    "label": "Left"    },
        { "value": "space-between", "label": "Justify" }
      ], "default": "flex-end" },
    { "type": "range", "id": "qn_gap",       "label": "Gap Below Header (px)",      "min": 0,  "max": 24, "step": 1, "default": 6 },
    { "type": "range", "id": "qn_gap_x",     "label": "Spacing Between Links (px)", "min": 8,  "max": 48, "step": 2, "default": 22 },
    { "type": "range", "id": "qn_font_size", "label": "Link Font Size (px)",        "min": 9,  "max": 14, "step": 1, "default": 10 },
    { "type": "color", "id": "qn_text_color",  "label": "Link Color (Idle)",          "default": "#888888" },
    { "type": "color", "id": "qn_hover_color", "label": "Link Color (Hover/Active)",  "default": "#000000" },

    { "type": "header", "content": "↩ Back-Home Overlay" },
    { "type": "checkbox", "id": "show_back_home",     "label": "Show on Non-Home Pages", "default": true, "info": "Hidden on home and product pages. Disappears on scroll." },
    { "type": "text",     "id": "back_home_label",    "label": "Button Label",            "default": "Back Home" },
