{%- comment -%}
  VANQUISH — Product Atelier / Magazine carousel
  Selected products, or a random store sample when none are picked.
  No prices. Hovering rounded cards. Swipe + optional continuous rotation.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign name_font = section.settings.name_font
  assign heading_font = section.settings.heading_font
  assign limit = section.settings.card_count | default: 8
  assign mode = section.settings.display_mode | default: 'products'
  assign shape = section.settings.card_shape | default: 'squircle'
  assign bg = section.settings.bg_color | default: '#0a0a0a'
  assign ink = section.settings.text_color | default: '#f4f4f2'
  assign brightness = bg | color_brightness | default: 10
  if brightness > 140
    assign surface = 'light'
  else
    assign surface = 'dark'
  endif

  assign card_count = 0
  assign use_images = false

  if mode == 'magazine'
    assign use_images = true
  endif

  if use_images == false
    assign selected = section.settings.products
    if selected != blank and selected.size > 0
      assign pool = selected
      assign from_selected = true
    else
      assign from_selected = false
      if section.settings.collection != blank and section.settings.collection.products_count > 0
        assign pool = section.settings.collection.products
      else
        assign pool = collections.all.products
      endif
    endif
  endif
-%}

{%- if name_font != blank -%}
  <link rel="preload" as="font" href="{{ name_font | font_url }}" type="font/woff2" crossorigin>
  <style>{{ name_font | font_face: font_display: 'swap' }}</style>
{%- endif -%}
{%- if heading_font != blank -%}
  <style>{{ heading_font | font_face: font_display: 'swap' }}</style>
{%- endif -%}

<style>
  #shopify-section-{{ sid }},
  .va-atelier-section {
    margin: 0 !important;
    padding: 0 !important;
    --section-padding-top: 0px;
    --section-padding-bottom: 0px;
  }
  #va-{{ sid }} {
    --va-bg: {{ bg }};
    --va-ink: {{ ink }};
    --va-muted: {{ ink | color_modify: 'alpha', 0.55 }};
    --va-line: {{ ink | color_modify: 'alpha', 0.10 }};
    --va-name: {{ name_font.family | default: 'Bebas Neue' }}, {{ name_font.fallback_families | default: 'Impact, Haettenschweiler, Arial Narrow Bold' }}, sans-serif;
    --va-head: {{ heading_font.family | default: 'Bebas Neue' }}, {{ heading_font.fallback_families | default: 'Impact, Arial Narrow Bold' }}, sans-serif;
    --va-gap: {{ section.settings.card_gap }}px;
    --va-pad: {{ section.settings.section_padding }}px;
    --va-radius: {% if shape == 'squircle' %}{{ section.settings.squircle_radius }}px{% else %}{{ section.settings.landscape_radius }}px{% endif %};
    --va-card-w: {{ section.settings.card_width }}px;
    --va-ratio: {% if shape == 'landscape' %}{{ section.settings.landscape_ratio }}{% else %}1 / 1{% endif %};
    --va-name-size: {{ section.settings.name_size }}px;
    --va-lift: {{ section.settings.hover_lift }}px;
    --va-track-y: {{ section.settings.hover_lift | at_most: 6 }}px;
    background: var(--va-bg);
    color: var(--va-ink);
    padding: {{ section.settings.pad_top }}px 0 {{ section.settings.pad_bottom }}px;
    overflow: hidden;
    isolation: isolate;
    -webkit-font-smoothing: antialiased;
  }

  #va-{{ sid }} *,
  #va-{{ sid }} *::before,
  #va-{{ sid }} *::after { box-sizing: border-box; }

  #va-{{ sid }} .va-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 0 var(--va-pad) 10px;
  }

  #va-{{ sid }} .va-title {
    margin: 0;
    font-family: var(--va-head);
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--va-ink);
  }

  #va-{{ sid }} .va-nav {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  #va-{{ sid }} .va-btn {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--va-line);
    background: transparent;
    color: var(--va-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }
  #va-{{ sid }} .va-btn:hover {
    background: {{ ink | color_modify: 'alpha', 0.06 }};
    border-color: {{ ink | color_modify: 'alpha', 0.22 }};
  }
  #va-{{ sid }} .va-btn:focus-visible {
    outline: 2px solid var(--va-ink);
    outline-offset: 2px;
  }
  #va-{{ sid }} .va-btn svg {
    width: 14px;
    height: 14px;
    pointer-events: none;
  }

  #va-{{ sid }} .va-viewport { position: relative; }

  {% if section.settings.edge_fade %}
  #va-{{ sid }} .va-viewport {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 36px, #000 calc(100% - 36px), transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 36px, #000 calc(100% - 36px), transparent 100%);
  }
  {% endif %}

  #va-{{ sid }} .va-track {
    display: flex;
    align-items: flex-start;
    gap: var(--va-gap);
    padding: var(--va-track-y) var(--va-pad) var(--va-track-y);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--va-pad);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    touch-action: pan-x;
  }
  #va-{{ sid }} .va-track::-webkit-scrollbar { display: none; }
  #va-{{ sid }} .va-track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  #va-{{ sid }} .va-card {
    flex: 0 0 var(--va-card-w);
    width: var(--va-card-w);
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: {% if section.settings.show_names %}4px{% else %}0{% endif %};
    contain: layout style;
  }

  #va-{{ sid }} .va-media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--va-ratio);
    border-radius: var(--va-radius);
    overflow: hidden;
    background: {% if surface == 'dark' %}#141414{% else %}#ececec{% endif %};
    transform: translateZ(0);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 420ms cubic-bezier(0.22, 1, 0.36, 1);
    {% if surface == 'dark' %}
      box-shadow:
        0 1px 0 rgba(255,255,255,0.06) inset,
        0 6px 14px rgba(0,0,0,0.32),
        0 1px 3px rgba(0,0,0,0.22);
    {% else %}
      box-shadow:
        0 1px 0 rgba(255,255,255,0.85) inset,
        0 6px 14px rgba(0,0,0,0.08),
        0 1px 3px rgba(0,0,0,0.05);
    {% endif %}
  }

  #va-{{ sid }} .va-card:hover .va-media,
  #va-{{ sid }} .va-card:focus-visible .va-media {
    transform: translate3d(0, calc(var(--va-lift) * -1), 0);
    {% if surface == 'dark' %}
      box-shadow:
        0 1px 0 rgba(255,255,255,0.08) inset,
        0 10px 20px rgba(0,0,0,0.48),
        0 3px 8px rgba(0,0,0,0.28);
    {% else %}
      box-shadow:
        0 1px 0 rgba(255,255,255,0.95) inset,
        0 10px 22px rgba(0,0,0,0.12),
        0 3px 8px rgba(0,0,0,0.06);
    {% endif %}
  }

  #va-{{ sid }} .va-media img,
  #va-{{ sid }} .va-media .va-ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  #va-{{ sid }} .va-name {
    margin: 0;
    padding: 0 4px;
    font-family: var(--va-name);
    font-size: var(--va-name-size);
    font-weight: 400;
    letter-spacing: {{ section.settings.name_tracking | divided_by: 100.0 }}em;
    text-transform: {{ section.settings.name_transform }};
    line-height: 1;
    color: var(--va-ink);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 0;
    margin-bottom: 0;
  }

  #va-{{ sid }} .va-empty {
    margin: 0;
    padding: 8px var(--va-pad);
    color: var(--va-muted);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 749px) {
    #va-{{ sid }} {
      --va-card-w: {{ section.settings.card_width | times: 0.78 | round }}px;
      --va-pad: {{ section.settings.section_padding | at_most: 20 }}px;
    }
    #va-{{ sid }} .va-title { font-size: {{ section.settings.title_size | times: 0.78 | round }}px; }
    #va-{{ sid }} .va-name { font-size: {{ section.settings.name_size | times: 0.9 | round }}px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #va-{{ sid }} .va-media,
    #va-{{ sid }} .va-card:hover .va-media {
      transition: none;
      transform: none;
    }
  }
</style>
