{%- comment -%}
  VANQUISH — Product Atelier / Magazine carousel
  Selected products, or a random store sample when none are picked.
  No prices. Flat cards. Native swipe + continuous rotation.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign name_font = section.settings.name_font
  assign heading_font = section.settings.heading_font
  assign limit = section.settings.card_count | default: 8
  assign mode = section.settings.display_mode | default: 'products'
  assign shape = section.settings.card_shape | default: 'squircle'
  assign bg = section.settings.bg_color | default: '#0a0a0a'
  assign ink = section.settings.text_color | default: '#f4f4f2'
  assign brightness = bg | color_brightness | default: 10
  if brightness > 140
    assign surface = 'light'
  else
    assign surface = 'dark'
  endif

  assign card_count = 0
  assign use_images = false

  if mode == 'magazine'
    assign use_images = true
  endif

  if use_images == false
    assign selected = section.settings.products
    if selected != blank and selected.size > 0
      assign pool = selected
      assign from_selected = true
    else
      assign from_selected = false
      if section.settings.collection != blank and section.settings.collection.products_count > 0
        assign pool = section.settings.collection.products
      else
        assign pool = collections.all.products
      endif
    endif
  endif
-%}

{%- if name_font != blank -%}
  <link rel="preload" as="font" href="{{ name_font | font_url }}" type="font/woff2" crossorigin>
  <style>{{ name_font | font_face: font_display: 'swap' }}</style>
{%- endif -%}
{%- if heading_font != blank -%}
  <style>{{ heading_font | font_face: font_display: 'swap' }}</style>
{%- endif -%}

<style>
  #shopify-section-{{ sid }},
  .va-atelier-section {
    margin: 0 !important;
    padding: 0 !important;
    --section-padding-top: 0px;
    --section-padding-bottom: 0px;
  }
  #va-{{ sid }} {
    --va-bg: {{ bg }};
    --va-ink: {{ ink }};
    --va-muted: {{ ink | color_modify: 'alpha', 0.55 }};
    --va-line: {{ ink | color_modify: 'alpha', 0.10 }};
    --va-name: {{ name_font.family | default: 'Bebas Neue' }}, {{ name_font.fallback_families | default: 'Impact, Haettenschweiler, Arial Narrow Bold' }}, sans-serif;
    --va-head: {{ heading_font.family | default: 'Bebas Neue' }}, {{ heading_font.fallback_families | default: 'Impact, Arial Narrow Bold' }}, sans-serif;
    --va-gap: {{ section.settings.card_gap }}px;
    --va-pad: {{ section.settings.section_padding }}px;
    --va-radius: {% if shape == 'squircle' %}{{ section.settings.squircle_radius }}px{% else %}{{ section.settings.landscape_radius }}px{% endif %};
    --va-card-w: {{ section.settings.card_width }}px;
    --va-ratio: {% if shape == 'landscape' %}{{ section.settings.landscape_ratio }}{% else %}1 / 1{% endif %};
    --va-name-size: {{ section.settings.name_size }}px;
    background: var(--va-bg);
    color: var(--va-ink);
    padding: {{ section.settings.pad_top }}px 0 {{ section.settings.pad_bottom }}px;
    overflow: hidden;
    isolation: isolate;
    -webkit-font-smoothing: antialiased;
  }

  #va-{{ sid }} *,
  #va-{{ sid }} *::before,
  #va-{{ sid }} *::after { box-sizing: border-box; }

  #va-{{ sid }} .va-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 0 var(--va-pad) 10px;
  }

  #va-{{ sid }} .va-title {
    margin: 0;
    font-family: var(--va-head);
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--va-ink);
  }

  #va-{{ sid }} .va-nav {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  #va-{{ sid }} .va-btn {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--va-line);
    background: transparent;
    color: var(--va-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  #va-{{ sid }} .va-btn:hover {
    background: {{ ink | color_modify: 'alpha', 0.06 }};
    border-color: {{ ink | color_modify: 'alpha', 0.22 }};
  }
  #va-{{ sid }} .va-btn:focus-visible {
    outline: 2px solid var(--va-ink);
    outline-offset: 2px;
  }
  #va-{{ sid }} .va-btn svg {
    width: 14px;
    height: 14px;
    pointer-events: none;
  }

  #va-{{ sid }} .va-viewport { position: relative; }

  {% if section.settings.edge_fade %}
  #va-{{ sid }} .va-viewport {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 36px, #000 calc(100% - 36px), transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 36px, #000 calc(100% - 36px), transparent 100%);
  }
  {% endif %}

  #va-{{ sid }} .va-track {
    display: flex;
    align-items: flex-start;
    gap: var(--va-gap);
    padding: 4px var(--va-pad) 4px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: none;
    scroll-behavior: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    touch-action: pan-x;
    will-change: scroll-position;
  }
  #va-{{ sid }} .va-track::-webkit-scrollbar { display: none; }
  #va-{{ sid }} .va-track.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  #va-{{ sid }} .va-card {
    flex: 0 0 var(--va-card-w);
    width: var(--va-card-w);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: {% if section.settings.show_names %}4px{% else %}0{% endif %};
    contain: layout style;
  }

  #va-{{ sid }} .va-media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--va-ratio);
    border-radius: var(--va-radius);
    overflow: hidden;
    background: {% if surface == 'dark' %}#141414{% else %}#ececec{% endif %};
    transform: translateZ(0);
    {% if surface == 'dark' %}
      box-shadow:
        0 1px 0 rgba(255,255,255,0.06) inset,
        0 6px 14px rgba(0,0,0,0.32),
        0 1px 3px rgba(0,0,0,0.22);
    {% else %}
      box-shadow:
        0 1px 0 rgba(255,255,255,0.85) inset,
        0 6px 14px rgba(0,0,0,0.08),
        0 1px 3px rgba(0,0,0,0.05);
    {% endif %}
  }

  #va-{{ sid }} .va-media img,
  #va-{{ sid }} .va-media .va-ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  #va-{{ sid }} .va-name {
    margin: 0;
    padding: 0 4px;
    font-family: var(--va-name);
    font-size: var(--va-name-size);
    font-weight: 400;
    letter-spacing: {{ section.settings.name_tracking | divided_by: 100.0 }}em;
    text-transform: {{ section.settings.name_transform }};
    line-height: 1;
    color: var(--va-ink);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 0;
    margin-bottom: 0;
  }

  #va-{{ sid }} .va-empty {
    margin: 0;
    padding: 8px var(--va-pad);
    color: var(--va-muted);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 749px) {
    #va-{{ sid }} {
      --va-card-w: {{ section.settings.card_width | times: 0.78 | round }}px;
      --va-pad: {{ section.settings.section_padding | at_most: 20 }}px;
    }
    #va-{{ sid }} .va-title { font-size: {{ section.settings.title_size | times: 0.78 | round }}px; }
    #va-{{ sid }} .va-name { font-size: {{ section.settings.name_size | times: 0.9 | round }}px; }
  }
</style>

{% render 'vanquish-atelier-markup', sid: sid, surface: surface, use_images: use_images, pool: pool, from_selected: from_selected, limit: limit, card_count: card_count %}

{% schema %}
{
  "name": "Product Atelier",
  "tag": "section",
  "class": "va-atelier-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "select", "id": "display_mode", "label": "Display", "options": [ { "value": "products", "label": "Products" }, { "value": "magazine", "label": "Magazine images" } ], "default": "products", "info": "Magazine mode uses the image blocks below. Works on any page, including product." },
    { "type": "product_list", "id": "products", "label": "Selected products", "limit": 16, "info": "Leave empty to pull a random sample from the collection below, or from the whole catalog." },
    { "type": "collection", "id": "collection", "label": "Fallback collection" },
    { "type": "range", "id": "card_count", "min": 3, "max": 16, "step": 1, "label": "Max cards", "default": 8 },
    { "type": "header", "content": "Heading" },
    { "type": "checkbox", "id": "show_header", "label": "Show section title", "default": true },
    { "type": "text", "id": "title", "label": "Title", "default": "Atelier" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows when title is hidden", "default": true },
    { "type": "header", "content": "Cards" },
    { "type": "select", "id": "card_shape", "label": "Card shape", "options": [ { "value": "squircle", "label": "Squircle" }, { "value": "landscape", "label": "Landscape square" } ], "default": "squircle" },
    { "type": "select", "id": "landscape_ratio", "label": "Landscape ratio", "options": [ { "value": "4 / 3", "label": "4:3" }, { "value": "16 / 10", "label": "16:10" }, { "value": "3 / 2", "label": "3:2" }, { "value": "16 / 9", "label": "16:9" } ], "default": "4 / 3" },
    { "type": "range", "id": "card_width", "min": 160, "max": 420, "step": 10, "unit": "px", "label": "Card width", "default": 260 },
    { "type": "range", "id": "squircle_radius", "min": 16, "max": 64, "step": 2, "unit": "px", "label": "Squircle corner", "default": 36 },
    { "type": "range", "id": "landscape_radius", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Landscape corner", "default": 18 },
    { "type": "range", "id": "card_gap", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Gap", "default": 20 },
    { "type": "checkbox", "id": "show_names", "label": "Show product / caption name", "default": true },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "name_font", "label": "Product name font", "default": "bebas_neue_n4" },
    { "type": "font_picker", "id": "heading_font", "label": "Section title font", "default": "bebas_neue_n4" },
    { "type": "range", "id": "name_size", "min": 14, "max": 42, "step": 1, "unit": "px", "label": "Name size", "default": 22 },
    { "type": "range", "id": "title_size", "min": 16, "max": 56, "step": 2, "unit": "px", "label": "Title size", "default": 28 },
    { "type": "range", "id": "name_tracking", "min": 0, "max": 20, "step": 1, "label": "Name letter spacing", "default": 4 },
    { "type": "select", "id": "name_transform", "label": "Name capitalization", "options": [ { "value": "uppercase", "label": "Uppercase" }, { "value": "none", "label": "As written" }, { "value": "capitalize", "label": "Capitalize" } ], "default": "uppercase" },
    { "type": "header", "content": "Motion" },
    { "type": "checkbox", "id": "autoplay", "label": "Continuous rotation", "default": true, "info": "Seamless loop. Pauses while dragging. Stops when the section is off-screen. Honors reduced-motion." },
    { "type": "range", "id": "autoplay_speed", "min": 8, "max": 60, "step": 2, "label": "Rotation speed", "default": 22 },
    { "type": "checkbox", "id": "edge_fade", "label": "Fade carousel edges", "default": true },
    { "type": "header", "content": "Colors & space" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0a0a0a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f4f4f2" },
    { "type": "range", "id": "section_padding", "min": 12, "max": 80, "step": 4, "unit": "px", "label": "Side padding", "default": 32 },
    { "type": "range", "id": "pad_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 16 }
  ],
  "blocks": [
    { "type": "magazine", "name": "Magazine image", "settings": [ { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "caption", "label": "Caption" }, { "type": "url", "id": "link", "label": "Link" } ] }
  ],
  "presets": [
    { "name": "Product Atelier", "settings": { "display_mode": "products", "title": "Atelier", "card_shape": "squircle", "autoplay": true, "name_font": "bebas_neue_n4", "heading_font": "bebas_neue_n4", "bg_color": "#0a0a0a", "text_color": "#f4f4f2" } }
  ]
}
{% endschema %}
