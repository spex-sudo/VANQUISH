{%- comment -%} sections/main-product-atelier.liquid — production-grade {%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign sid         = section.id
  assign form_id     = 'pf-' | append: sid
  assign media_count = product.media | size

  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign sf = section.settings.script_font

  assign has_discount = false
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif

  assign inv          = current_variant.inventory_quantity
  assign low_stock_at = section.settings.low_stock_threshold | default: 5
  assign is_low_stock = false
  if section.settings.show_stock and current_variant.inventory_management == 'shopify' and inv > 0 and inv <= low_stock_at
    assign is_low_stock = true
  endif

  assign bg_brightness = section.settings.bg_color | color_brightness
  if bg_brightness > 50
    assign card_bg  = section.settings.bg_color | color_darken: 2
    assign hairline = section.settings.bg_color | color_darken: 11
  else
    assign card_bg  = section.settings.bg_color | color_lighten: 5
    assign hairline = section.settings.bg_color | color_lighten: 14
  endif

  assign sg_label = 'Size Guide'
  assign sg_content = ''
  assign sg_image = nil
  assign sg_redirect = ''
  assign sh_label = 'Shipping & Returns'
  assign sh_content = ''
  assign sh_image = nil
  assign sh_redirect = ''
  for block in section.blocks
    if block.type == 'size_guide_drawer'
      assign sg_label    = block.settings.title | default: 'Size Guide'
      assign sg_content  = block.settings.content
      assign sg_image    = block.settings.image
      assign sg_redirect = block.settings.redirect_url
    endif
    if block.type == 'shipping'
      assign sh_label    = block.settings.title | default: 'Shipping & Returns'
      assign sh_content  = block.settings.content
      assign sh_image    = block.settings.image
      assign sh_redirect = block.settings.redirect_url
    endif
  endfor
  assign show_sg = false
  if sg_content != blank or sg_redirect != blank
    assign show_sg = true
  endif
  assign show_sh = false
  if sh_content != blank or sh_redirect != blank
    assign show_sh = true
  endif

  assign desc_mode = section.settings.description_mode | default: 'inline'
  assign show_desc_drawer = false
  if desc_mode == 'drawer' and product.description != blank
    assign show_desc_drawer = true
  endif
  assign desc_label = section.settings.description_label | default: 'Description'

  assign back_url   = section.settings.back_url
  assign back_label = section.settings.back_label | default: 'Back'

  assign show_pill = section.settings.show_pill
  assign tags_str  = product.tags | join: ',' | downcase

  comment
    Gift PDP (specs-atc-restore 2026-10-07): if this product is an active free-glasses gift (cost on file + in
    gift_guard GET), show a separate optional "Claim free" card in the right column. The sticky bar, Duo/Trio,
    quantity and Add to cart stay exactly as on every other product (normal paid add, no _lexe_gift).
  endcomment
  assign lx_pdp_gift = false
  assign lx_pdp_min = -1
  capture lx_pdp_min_raw
    render 'lexe-gift-rules', product: product
  endcapture
  assign lx_pdp_min = lx_pdp_min_raw | strip | plus: 0
  if lx_pdp_min > 0
    assign lx_pdp_gift = true
  endif

  assign single_price = current_variant.price
  assign single_compare = current_variant.compare_at_price
  assign single_save = 0
  if single_compare > single_price
    assign single_save = single_compare | minus: single_price
  endif

  assign duo_visible = false
  if section.settings.duo_force_show
    assign duo_tag = section.settings.duo_show_tag | downcase
    if duo_tag != blank
      if tags_str contains duo_tag
        assign duo_visible = true
      endif
    else
      assign duo_visible = true
    endif
  endif

  assign triple_visible = false
  if section.settings.triple_force_show
    assign triple_tag = section.settings.triple_show_tag | downcase
    if triple_tag != blank
      if tags_str contains triple_tag
        assign triple_visible = true
      endif
    else
      assign triple_visible = true
    endif
  endif

  comment
    LEXE bundle pills: Duo and Trio add 1 or 2 add-on pieces from OTHER collections (picked in the browser).
    No bundle discount is applied or advertised. Source collections come from section.settings.bundle_collections.
  endcomment
  assign bp_sources = ''
  for bp_c in section.settings.bundle_collections
    assign bp_sources = bp_sources | append: bp_c.handle | append: ','
  endfor
  if bp_sources == blank
    assign bp_sources = 'maze,lexe,'
  endif
  assign bp_sources = bp_sources | remove_last: ','
  assign bp_cur_cols = product.collections | map: 'handle' | join: ','

  case section.settings.pill_thumb_source
    when 'variant'
      assign pill_thumb_img = current_variant.featured_image | default: product.featured_image
    when 'first'
      assign pill_thumb_img = product.images.first
    when 'second'
      assign pill_thumb_img = product.images[1]
    when 'last'
      assign pill_thumb_img = product.images.last
    else
      assign pill_thumb_img = product.featured_image
  endcase
  assign pill_thumb = pill_thumb_img | image_url: width: 120

  assign first_media = product.media | first
  assign first_image = product.featured_image | default: first_media.preview_image

  assign brand_col_title = product.collections.first.title | default: product.vendor
  assign brand_display   = section.settings.brand_name_override | default: brand_col_title
-%}

{%- comment -%} Performance: preconnect to Shopify CDN + preload first image (LCP) {%- endcomment -%}
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
{%- if first_image != blank -%}
  <link rel="preload" as="image"
    href="{{ first_image | image_url: width: 1400 }}"
    imagesrcset="{{ first_image | image_url: width: 600 }} 600w, {{ first_image | image_url: width: 1000 }} 1000w, {{ first_image | image_url: width: 1400 }} 1400w"
    imagesizes="(max-width:640px) 100vw, 44vw"
    fetchpriority="high">
{%- endif -%}

<style>{{ hf | font_face: font_display: 'swap' }}{{ bf | font_face: font_display: 'swap' }}{%- if section.settings.show_brand_overlay -%}{{ sf | font_face: font_display: 'swap' }}{%- endif -%}</style>

<style>
#ap{{ sid }},#ap{{ sid }} *,#ap{{ sid }} *::before,#ap{{ sid }} *::after{box-sizing:border-box;margin:0;padding:0}
.ap-bar{{ sid }} *,.ap-bar{{ sid }} *::before,.ap-bar{{ sid }} *::after{box-sizing:border-box;margin:0;padding:0}

#ap{{ sid }},.ap-bar{{ sid }}{
  --top:{{ section.settings.sticky_top }}px;
  --bar-h:{{ section.settings.bar_height | default: 160 }}px;
  --bg:{{ section.settings.bg_color }};
  --ink:{{ section.settings.text_color }};
  --sub:{{ section.settings.text_color | color_mix: section.settings.bg_color, 65 }};
  --dim:{{ section.settings.text_color | color_mix: section.settings.bg_color, 35 }};
  --ghost:{{ section.settings.bg_color | color_mix: section.settings.text_color, 95 }};
  --line:{{ hairline }};
  --acc:{{ section.settings.accent_color | default: '#b8865a' }};
  --card:{{ card_bg }};
  --pill-bg:{{ section.settings.pill_bg | default: '#f4f4f2' }};
  --pill-bg-on:{{ section.settings.pill_bg_on | default: '#eaeae6' }};
  --pill-text:{{ section.settings.pill_text | default: '#1a1a1a' }};
  --pill-accent:{{ section.settings.pill_accent | default: '#1a1a1a' }};
  --fh:{{ hf.family | default: "'Barlow Condensed'" }},{{ hf.fallback_families | default: 'Helvetica Neue' }},sans-serif;
  --fb:{{ bf.family | default: 'Barlow' }},{{ bf.fallback_families | default: 'Helvetica' }},sans-serif;
  --sf:{{ sf.family | default: 'Georgia' }},{{ sf.fallback_families | default: 'serif' }},cursive;
}
#ap{{ sid }}{
  background:var(--bg);color:var(--ink);font-family:var(--fb);
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
  text-rendering:optimizeLegibility;
}

/* ─── Grid (iOS-safe viewport) ─── */
.ap-grid{{ sid }}{
  display:grid;grid-template-columns:1fr 44% 1fr;grid-template-areas:"left center right";
  height:calc(100vh - var(--top) - var(--bar-h));
  height:calc(100svh - var(--top) - var(--bar-h));
  height:calc(100dvh - var(--top) - var(--bar-h));
  overflow:hidden;
  contain:layout style;
}
.ap-left{{ sid }}{grid-area:left;display:flex;flex-direction:column;overflow:hidden}
.ap-left-body{{ sid }}{
  flex:1;min-height:0;overflow-y:auto;scrollbar-width:none;
  padding:42px {{ section.settings.panel_padding }}px;
  display:flex;flex-direction:column;justify-content:center;
}
.ap-left-body{{ sid }}::-webkit-scrollbar{display:none}

/* ─── Back link ─── */
.ap-back{{ sid }}{
  display:inline-flex;align-items:center;gap:6px;
  font-family:var(--fb);font-size:13px;font-weight:400;
  color:var(--ink);text-decoration:none;
  padding:4px 0;margin-bottom:28px;width:fit-content;
  transition:opacity .18s;cursor:pointer;background:none;border:none;
  touch-action:manipulation;
}
.ap-back{{ sid }}:hover{opacity:.55}
.ap-back{{ sid }} svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:1.8}

/* ─── Title ─── */
.ap-name{{ sid }}{
  font-family:var(--fh);font-size:{{ section.settings.name_size }}px;
  font-weight:900;letter-spacing:-.01em;text-transform:uppercase;line-height:.94;
  color:var(--ink);margin-bottom:24px;
  word-break: normal !important; 
  overflow-wrap: normal !important;
  max-width: 100% !important; 
  width: 100% !important;
  clip-path:inset(0 100% 0 0);
  animation:_reveal{{ sid }} 1s cubic-bezier(.16,1,.3,1) .1s forwards;
}
@keyframes _reveal{{ sid }}{to{clip-path:inset(0 0% 0 0)}}

/* ─── Bullets / description ─── */
.ap-bullets{{ sid }}{list-style:disc;padding-left:18px;margin:0 0 18px;max-width:22ch}
.ap-bullets{{ sid }} li{
  font-family:var(--fb);font-size:{{ section.settings.bullet_size | default: 12 }}px;font-weight:400;
  text-transform:uppercase;letter-spacing:.02em;line-height:1.5;
  color:var(--ink);margin-bottom:1px;
}
.ap-bullets{{ sid }} li::marker{color:var(--ink)}
.ap-narrative{{ sid }}{
  font-family:var(--fb);font-size:{{ section.settings.bullet_size | default: 12 }}px;font-weight:400;
  text-transform:uppercase;letter-spacing:.02em;line-height:1.5;color:var(--ink);max-width:22ch;
}
.ap-narrative{{ sid }} p{margin:0}
.ap-desc{{ sid }}{
  font-family:var(--fb);font-size:12.5px;line-height:1.55;color:var(--ink);
  max-width:32ch;margin-top:16px;letter-spacing:.01em;
}
.ap-desc{{ sid }} p{margin:0 0 6px}
.ap-desc{{ sid }} ul{list-style:disc;padding-left:18px;margin:0 0 8px}
.ap-desc{{ sid }} em{font-style:italic}
.ap-desc{{ sid }} strong{font-weight:500}

/* ─── Center carousel (horizontal scroll, all viewports) ─── */
.ap-center{{ sid }}{
  grid-area:center;position:relative;overflow:hidden;background:var(--bg);
  contain:layout paint;
}
.ap-scroll{{ sid }}{
  display:flex;flex-direction:row;
  width:100%;height:100%;
  overflow-x:auto;overflow-y:hidden;
  scroll-snap-type:x mandatory;scroll-behavior:smooth;
  scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;
  /* No explicit touch-action here — default "auto" is what actually lets the
     browser chain an unhandled axis to the page. Explicitly declaring any
     touch-action value (even "pan-x pan-y", even "pan-x" alone) makes some
     WebKit/Chromium builds treat this element as fully owning the gesture,
     and since overflow-y is hidden the vertical swipe has nowhere to go —
     the touch gets swallowed instead of chaining to the document. */
}
.ap-scroll{{ sid }}::-webkit-scrollbar{display:none}
.ap-slide{{ sid }}{
  width:100%;height:100%;flex:0 0 100%;
  display:flex;align-items:center;justify-content:center;
  scroll-snap-align:start;scroll-snap-stop:always;
  contain:layout paint;
}
.ap-slide{{ sid }} img,.ap-slide{{ sid }} video{
  width:88%;height:88%;object-fit:contain;object-position:center;
  display:block;pointer-events:none;
  opacity:0;transition:opacity .4s ease;
}
.ap-slide{{ sid }} img.ap-loaded,.ap-slide{{ sid }} video.ap-loaded,
.ap-slide{{ sid }} img[loading="eager"]{opacity:1}

.ap-empty{{ sid }}{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  color:var(--dim);font-family:var(--fb);font-size:11px;letter-spacing:.18em;text-transform:uppercase;
}

.ap-arr{{ sid }}{
  position:absolute;top:50%;transform:translateY(-50%);
  background:transparent;border:none;cursor:pointer;
  padding:18px 12px;z-index:3;
  opacity:0;transition:opacity .2s;
  display:flex;align-items:center;justify-content:center;
  touch-action:manipulation;
}
.ap-center{{ sid }}:hover .ap-arr{{ sid }}{opacity:1}
.ap-arr{{ sid }}:focus-visible{opacity:1;outline:1px solid var(--ink);outline-offset:2px}
.ap-arr{{ sid }} svg{width:14px;height:14px;stroke:var(--ink);fill:none;stroke-width:1.3}
.ap-arr{{ sid }}.p{left:0}.ap-arr{{ sid }}.n{right:0}
.ap-arr{{ sid }}:disabled{opacity:.18 !important;cursor:default}
@media (hover:none){.ap-arr{{ sid }}{display:none}}

.ap-dots{{ sid }}{
  position:absolute;left:50%;bottom:14px;transform:translateX(-50%);
  display:flex;flex-direction:row;gap:6px;align-items:center;z-index:3;
  background:{{ section.settings.bg_color | color_modify: 'alpha', 0.55 }};
  padding:4px 8px;border-radius:100px;
}
.ap-dot{{ sid }}{
  width:3px;height:3px;border-radius:3px;background:var(--dim);
  border:none;padding:0;cursor:pointer;flex-shrink:0;
  transition:background .3s,width .3s cubic-bezier(.16,1,.3,1);
  touch-action:manipulation;
}
.ap-dot{{ sid }}.on{background:var(--ink);width:20px}
.ap-dot{{ sid }}:focus-visible{outline:1px solid var(--ink);outline-offset:2px}

/* ─── Brand overlay ─── */
.ap-brand{{ sid }}{
  position:absolute;
  bottom:{{ section.settings.brand_bottom | default: 52 }}px;
  left:{{ section.settings.brand_left | default: 16 }}px;
  z-index:4;
  display:flex;
  align-items:center;
  gap:{{ section.settings.brand_gap | default: 12 }}px;
  pointer-events:none;
  user-select:none;
  -webkit-user-select:none;
}
.ap-brand-name{{ sid }}{
  font-family:var(--sf);
  font-size:{{ section.settings.brand_name_size | default: 30 }}px;
  font-weight:{{ section.settings.brand_name_weight | default: 400 }};
  font-style:{{ section.settings.brand_name_style | default: 'normal' }};
  color:{{ section.settings.brand_text_color | default: '#111111' }};
  line-height:1;
  letter-spacing:{{ section.settings.brand_letter_spacing | default: 0 | append: 'em' }};
  white-space:nowrap;
}
.ap-brand-sep{{ sid }}{
  display:block;
  width:1px;
  height:{{ section.settings.brand_sep_height | default: 26 }}px;
  background:{{ section.settings.brand_sep_color | default: '#111111' }};
  opacity:{{ section.settings.brand_sep_opacity | default: 55 | divided_by: 100.0 }};
  flex-shrink:0;
}
.ap-brand-logo{{ sid }}{
  display:block;
  height:{{ section.settings.brand_logo_height | default: 22 }}px;
  width:auto;
  object-fit:contain;
  opacity:{{ section.settings.brand_logo_opacity | default: 90 | divided_by: 100.0 }};
}
@media (max-width:640px){
  .ap-brand{{ sid }}{
    bottom:{{ section.settings.brand_bottom_mobile | default: 46 }}px;
    left:{{ section.settings.brand_left_mobile | default: 14 }}px;
    gap:{{ section.settings.brand_gap_mobile | default: 9 }}px;
  }
  .ap-brand-name{{ sid }}{
    font-size:{{ section.settings.brand_name_size_mobile | default: 22 }}px;
  }
  .ap-brand-logo{{ sid }}{
    height:{{ section.settings.brand_logo_height_mobile | default: 18 }}px;
  }
  .ap-brand-sep{{ sid }}{
    height:{{ section.settings.brand_sep_height_mobile | default: 20 }}px;
  }
}

/* ─── Right column ─── */
.ap-right{{ sid }}{
  grid-area:right;display:flex;flex-direction:column;overflow:hidden;
  padding:0 {{ section.settings.panel_padding }}px 0 28px;
}
.ap-right-body{{ sid }}{
  flex:1;min-height:0;overflow-y:auto;scrollbar-width:none;
  padding:56px 8px 28px;display:flex;flex-direction:column;justify-content:flex-start;
}
.ap-right-body{{ sid }}::-webkit-scrollbar{display:none}

.ap-price-row{{ sid }}{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:24px}
.ap-price{{ sid }}{
  font-family:var(--fh);font-size:{{ section.settings.price_size | default: 26 }}px;font-weight:800;letter-spacing:.005em;
  color:var(--ink);transition:opacity .18s;text-transform:uppercase;
}
.ap-price{{ sid }}.flash{opacity:.25}
.ap-was{{ sid }}{font-size:14px;font-weight:300;color:var(--dim);text-decoration:line-through;font-family:var(--fb)}
.ap-badge{{ sid }}{font-family:var(--fb);font-size:8px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;background:var(--acc);color:#fff;padding:4px 8px;border-radius:2px;flex-shrink:0}

/* Stock urgency */
.ap-stock{{ sid }}{
  display:none;align-items:center;gap:6px;margin-bottom:18px;
  font-family:var(--fb);font-size:11px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;
  color:var(--acc);
}
.ap-stock{{ sid }}.show{display:inline-flex}
.ap-stock{{ sid }}::before{
  content:'';width:6px;height:6px;border-radius:50%;background:var(--acc);
  animation:_pulse{{ sid }} 1.6s ease-in-out infinite;
}
@keyframes _pulse{{ sid }}{0%,100%{opacity:.55;transform:scale(1)}50%{opacity:1;transform:scale(1.25)}}

.ap-opt-lbl{{ sid }}{display:block;font-family:var(--fb);font-size:13px;font-weight:400;color:var(--ink);margin-bottom:10px}
.ap-stack{{ sid }}{display:flex;flex-direction:column;gap:10px;margin-bottom:14px}
.ap-stack-btn{{ sid }}{
  display:flex;align-items:center;justify-content:center;width:100%;
  padding:15px 18px;background:transparent;
  border:1px solid var(--line);border-radius:10px;
  font-family:var(--fb);font-size:13.5px;font-weight:400;letter-spacing:.01em;
  color:var(--ink);cursor:pointer;line-height:1;
  transition:border-color .2s,background .2s,transform .12s cubic-bezier(.16,1,.3,1),color .2s;
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
}
.ap-stack-btn{{ sid }}:hover{border-color:var(--ink)}
.ap-stack-btn{{ sid }}.on{border-color:var(--ink);border-width:1.5px;padding:14.5px 17.5px}
.ap-stack-btn{{ sid }}:active{transform:scale(.992)}
.ap-stack-btn{{ sid }}.unavail{opacity:.32;cursor:not-allowed;pointer-events:none;text-decoration:line-through;color:var(--dim)}
.ap-stack-btn{{ sid }}:focus-visible{outline:2px solid var(--ink);outline-offset:2px}

.ap-swatches{{ sid }}{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px}
.ap-swatch{{ sid }}{
  width:34px;height:34px;border-radius:50%;border:1px solid var(--line);
  cursor:pointer;padding:0;position:relative;flex-shrink:0;
  transition:transform .2s cubic-bezier(.16,1,.3,1);
  touch-action:manipulation;
}
.ap-swatch{{ sid }}:hover{transform:scale(1.08)}
.ap-swatch{{ sid }}::after{content:'';position:absolute;inset:-4px;border-radius:50%;border:1.5px solid transparent;transition:border-color .18s}
.ap-swatch{{ sid }}.on::after{border-color:var(--ink)}
.ap-swatch{{ sid }}.unavail{opacity:.32;cursor:not-allowed;pointer-events:none}
.ap-swatch{{ sid }}.unavail::before{
  content:'';position:absolute;inset:0;border-radius:50%;
  background:linear-gradient(to top right,transparent calc(50% - 1px),var(--dim) 50%,transparent calc(50% + 1px));
}
.ap-swatch{{ sid }}:focus-visible::after{border-color:var(--ink)}

/* ─── Inline accordion links ─── */
.ap-links{{ sid }}{margin-top:18px;display:flex;flex-direction:column;gap:16px}
.ap-link-row{{ sid }}{display:flex;flex-direction:column}
.ap-link-trig{{ sid }}{
  display:inline-flex;align-items:center;gap:10px;
  padding:0;background:none;border:none;cursor:pointer;
  font-family:var(--fb);font-size:14px;font-weight:400;
  color:var(--ink);text-align:left;text-decoration:none;
  width:fit-content;-webkit-tap-highlight-color:transparent;transition:opacity .18s;
  touch-action:manipulation;
}
.ap-link-trig{{ sid }}:hover{opacity:.6}
.ap-link-trig{{ sid }}:focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:2px}
.ap-link-trig{{ sid }} svg{width:16px;height:8px;stroke:currentColor;fill:none;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;transition:transform .25s cubic-bezier(.16,1,.3,1)}
.ap-link-trig{{ sid }}:hover svg{transform:translateX(3px)}
.ap-link-trig{{ sid }}.open svg{transform:rotate(90deg)}
.ap-link-body{{ sid }}{display:grid;grid-template-rows:0fr;transition:grid-template-rows .42s cubic-bezier(.16,1,.3,1)}
.ap-link-body{{ sid }}.open{grid-template-rows:1fr;margin-top:12px}
.ap-link-inner{{ sid }}{overflow:hidden}
.ap-link-content{{ sid }}{font-family:var(--fb);font-size:12.5px;line-height:1.65;color:var(--sub);max-width:36ch;padding-bottom:4px}
.ap-link-content{{ sid }} p{margin:0 0 7px}
.ap-link-content{{ sid }} p:last-child{margin:0}
.ap-link-content{{ sid }} strong{color:var(--ink);font-weight:500}
.ap-link-content{{ sid }} ul,.ap-link-content{{ sid }} ol{padding-left:18px;margin:0 0 8px}
.ap-link-content{{ sid }} li{margin-bottom:3px}
.ap-link-content{{ sid }} img{max-width:100%;width:200px;height:auto;border-radius:6px;margin:4px 0 10px;display:block}


/* ─── Column composition (sticky bar untouched) ─── */
.ap-col{{ sid }}{display:flex;flex-direction:column;gap:0;max-width:440px}
.ap-note{{ sid }}{margin:0 0 36px;font-size:13px;line-height:1.5;color:#3a3a3a;letter-spacing:.01em}
.ap-note{{ sid }} a,.ap-note{{ sid }} u{color:#111;text-underline-offset:3px}
.ap-size-lbl{{ sid }}{display:block;margin:0 0 14px;font-size:15px;font-weight:650;letter-spacing:-0.01em;color:#111}
.ap-sizes{{ sid }}{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 28px}
.ap-sizes{{ sid }} .ap-stack-btn{{ sid }}{
  width:64px;height:52px;padding:0;border-radius:2px;border:1px solid #dedede;background:#fff;color:#111;
  font-size:13px;font-weight:600;letter-spacing:.04em;
  transition:background .18s ease,border-color .18s ease,transform .16s cubic-bezier(.16,1,.3,1);
}
.ap-sizes{{ sid }} .ap-stack-btn{{ sid }}:hover{border-color:#111}
.ap-sizes{{ sid }} .ap-stack-btn{{ sid }}.on{background:#ffe500;border-color:#e3cc00;color:#111;border-width:1px;padding:0}
.ap-sizes{{ sid }} .ap-stack-btn{{ sid }}:active{transform:scale(.97)}
.ap-col-atc{{ sid }}{
  display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;
  margin:0 0 36px;padding:18px 20px;border:0;background:#ffe500;color:#111;cursor:pointer;
  font:inherit;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  transition:filter .18s ease,transform .16s cubic-bezier(.16,1,.3,1);
}
.ap-col-atc{{ sid }}:hover{filter:brightness(.97)}
.ap-col-atc{{ sid }}:active{transform:scale(.985)}
.ap-col-atc{{ sid }}:disabled{background:#f3f3f3;color:#8a8a8a;cursor:not-allowed}
.ap-col-atc{{ sid }} span:last-child{font-size:15px;font-weight:650;letter-spacing:0;text-transform:none}
.ap-acc{{ sid }}{border-top:1px solid #ececec}
.ap-acc{{ sid }}:last-child{border-bottom:1px solid #ececec}
.ap-acc{{ sid }} .ap-link-trig{{ sid }}{
  width:100%;justify-content:space-between;padding:22px 2px;font-size:12px;font-weight:650;letter-spacing:.14em;text-transform:uppercase;
}
.ap-acc{{ sid }} .ap-link-trig{{ sid }} svg{width:14px;height:14px;transition:transform .28s cubic-bezier(.16,1,.3,1)}
.ap-acc{{ sid }} .ap-link-trig{{ sid }}.open svg{transform:rotate(180deg)}
.ap-acc{{ sid }} .ap-link-body{{ sid }}.open{margin-top:0}
.ap-acc{{ sid }} .ap-link-content{{ sid }}{padding:0 2px 22px;max-width:42ch;font-size:13.5px;line-height:1.7;color:#3c3c3c}

/* ══════════════════════════════════════
   STICKY BAR — never moves, conversion-tuned
══════════════════════════════════════ */
.ap-bar{{ sid }}{
  position:fixed !important;
  bottom:0 !important;
  left:0 !important;
  right:0 !important;
  z-index:99999 !important;
  display:flex !important;
  flex-direction:column;
  gap:10px;
  background:var(--card);
  border-top:1px solid var(--line);
  padding:12px 16px calc(14px + env(safe-area-inset-bottom,0px));
  isolation:isolate;
  transform:translate3d(0,0,0);
  -webkit-transform:translate3d(0,0,0);
  transition:transform .32s cubic-bezier(.4,0,.2,1);
  font-family:var(--fb);color:var(--ink);
  -webkit-font-smoothing:antialiased;
  contain:layout style;
}
@supports ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  .ap-bar{{ sid }}{
    background:{{ card_bg | color_modify: 'alpha', 0.92 }};
    backdrop-filter:blur(16px) saturate(180%);
    -webkit-backdrop-filter:blur(16px) saturate(180%);
  }
}
.ap-bar{{ sid }}.hide{transform:translate3d(0,calc(100% + 20px),0)}
.ap-bar-inner{{ sid }}{display:flex;flex-direction:column;gap:10px;max-width:1280px;margin:0 auto;width:100%}

/* Trust strip (optional, top of bar) */
.ap-trust{{ sid }}{
  display:none;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;
  font-family:var(--fb);font-size:10px;font-weight:400;
  letter-spacing:.14em;text-transform:uppercase;color:var(--dim);
  padding:2px 0 4px;
}
.ap-trust{{ sid }}.on{display:flex}
.ap-trust-item{{ sid }}{display:inline-flex;align-items:center;gap:6px}
.ap-trust-item{{ sid }} svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:1.6;flex-shrink:0}

/* Pill row */
.ap-pills{{ sid }}{
  display:flex;gap:8px;
  overflow-x:auto;overflow-y:hidden;
  scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;
  margin:0 -16px;padding:12px 16px 2px;
  scroll-snap-type:x proximity;
}
.ap-pills{{ sid }}::-webkit-scrollbar{display:none}
.ap-pill{{ sid }}{
  position:relative;display:flex;align-items:center;gap:10px;
  padding:8px 12px 8px 8px;flex-shrink:0;min-width:224px;width:224px;box-sizing:border-box;min-height:58px;
  background:var(--pill-bg);color:var(--pill-text);
  border:1.5px solid transparent;border-radius:10px;cursor:pointer;
  scroll-snap-align:start;font-family:var(--fb);
  transition:border-color .18s,background .18s,transform .12s cubic-bezier(.16,1,.3,1);
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
}
.ap-pill{{ sid }}:hover{border-color:var(--pill-accent)}
.ap-pill{{ sid }}.on{border-color:var(--pill-accent);background:var(--pill-bg-on)}
.ap-pill{{ sid }}:active{transform:scale(.99)}
.ap-pill{{ sid }}:focus-visible{outline:2px solid var(--pill-accent);outline-offset:2px}
.ap-pill-img{{ sid }}{position:relative;width:42px;height:42px;border-radius:7px;flex-shrink:0;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}
.ap-pill-img{{ sid }} img{width:100%;height:100%;object-fit:contain;display:block}
.ap-pill-qty{{ sid }}{
  position:absolute;bottom:-3px;right:-3px;
  background:var(--pill-accent);color:#fff;
  font-family:var(--fb);font-size:8.5px;font-weight:700;letter-spacing:.02em;
  padding:2px 5px;border-radius:100px;line-height:1;
  border:1.5px solid var(--pill-bg);
}
.ap-pill-info{{ sid }}{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px;line-height:1.2}
.ap-pill-label{{ sid }}{font-family:var(--fh);font-size:14px;font-weight:800;letter-spacing:.02em;color:inherit;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ap-pill-sub{{ sid }}{font-size:9.5px;font-weight:400;letter-spacing:.04em;opacity:.7;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ap-pill-price{{ sid }}{flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:1px}
.ap-pill-now{{ sid }}{font-family:var(--fh);font-size:14px;font-weight:800;line-height:1;color:inherit}
.ap-pill-was{{ sid }}{font-size:9.5px;font-weight:300;text-decoration:line-through;opacity:.55;line-height:1}
.ap-pill-ribbon{{ sid }}{
  position:absolute;top:-9px;right:10px;
  background:var(--pill-accent);color:#fff;
  font-family:var(--fb);font-size:8px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;
  padding:3px 8px;border-radius:100px;white-space:nowrap;line-height:1;z-index:1;
}

/* ── LEXE bundle pills (Duo / Trio) ── */
.ap-pill{{ sid }}.on{border-color:#9966CC;box-shadow:0 0 0 1px #9966CC inset}
.ap-pill{{ sid }}:hover{border-color:#9966CC}
.ap-pill{{ sid }}:focus-visible{outline:2px solid #9966CC;outline-offset:2px}
.ap-pill{{ sid }}[hidden]{display:none}
.ap-pill{{ sid }}.ap-busy{opacity:.7;cursor:progress}
.ap-pill-imgs{{ sid }}{width:auto;background:transparent;overflow:visible;border-radius:0;height:42px;display:flex;align-items:center}
.ap-th{{ sid }}{position:relative;width:34px;height:34px;border-radius:8px;background:#fff;border:2px solid var(--pill-bg);box-sizing:content-box;overflow:hidden;flex-shrink:0;margin-left:-16px;display:block}
.ap-th{{ sid }}:first-child{margin-left:0}
.ap-th{{ sid }} img{width:100%;height:100%;object-fit:cover;display:block}
.ap-sk{{ sid }}{background:linear-gradient(90deg,#ece6f3 25%,#f7f3fb 50%,#ece6f3 75%);background-size:200% 100%;animation:_bpsk{{ sid }} 1.3s linear infinite}
@keyframes _bpsk{{ sid }}{to{background-position:-200% 0}}
.ap-dots{{ sid }}{font-style:normal;letter-spacing:.1em;opacity:.5}
.ap-pill-now{{ sid }}{min-width:34px;text-align:right}
.ap-pill-ribbon{{ sid }}{background:#9966CC;color:#fff;font-weight:600}

.ap-bundle{{ sid }}{
  position:absolute;left:0;right:0;bottom:100%;
  background:var(--card);border-top:1px solid var(--line);
  box-shadow:0 -14px 34px rgba(30,10,50,.10);
  max-height:min(56vh,440px);overflow:auto;overscroll-behavior:contain;
  padding:12px 16px 12px;
}
.ap-bundle{{ sid }}[hidden]{display:none}
.ap-bundle-inner{{ sid }}{max-width:1280px;margin:0 auto;display:flex;flex-direction:column;gap:10px}
.ap-bundle-head{{ sid }}{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.ap-bundle-ttl{{ sid }}{display:flex;flex-direction:column;gap:2px;min-width:0}
.ap-bundle-ttl{{ sid }} strong{font-family:var(--fh);font-size:17px;letter-spacing:.03em;text-transform:uppercase;color:var(--ink);line-height:1.1}
.ap-bundle-ttl{{ sid }} span{font-size:12px;color:var(--sub);line-height:1.35}
.ap-bundle-x{{ sid }}{flex-shrink:0;width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:transparent;color:var(--ink);display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;touch-action:manipulation}
.ap-bundle-x{{ sid }} svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;fill:none}
.ap-bundle-x{{ sid }}:hover{border-color:#9966CC}
.ap-bundle-x{{ sid }}:focus-visible,.ap-brow{{ sid }} button:focus-visible,.ap-brow{{ sid }} select:focus-visible{outline:2px solid #9966CC;outline-offset:2px}
.ap-bundle-rows{{ sid }}{display:flex;flex-wrap:wrap;gap:10px}
.ap-brow{{ sid }}{flex:1 1 300px;max-width:440px;min-width:0;display:flex;align-items:center;gap:10px;padding:8px;border:1px solid var(--line);border-radius:12px;background:var(--bg)}
.ap-brow{{ sid }}.fixed{background:transparent;border-style:dashed}
.ap-brow-img{{ sid }}{width:54px;height:54px;border-radius:8px;overflow:hidden;background:#fff;flex-shrink:0}
.ap-brow-img{{ sid }} img{width:100%;height:100%;object-fit:cover;display:block}
.ap-brow-body{{ sid }}{flex:1;min-width:0;display:flex;flex-direction:column;gap:5px}
.ap-brow-tag{{ sid }}{font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--sub)}
.ap-brow-name{{ sid }}{font-size:13px;font-weight:600;line-height:1.25;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ap-brow-var{{ sid }}{font-size:12px;color:var(--sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ap-brow{{ sid }} select{width:100%;max-width:100%;height:32px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);font:inherit;font-size:12px;padding:0 8px}
.ap-brow-side{{ sid }}{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0}
.ap-brow-price{{ sid }}{font-family:var(--fh);font-size:15px;font-weight:800;color:var(--ink);line-height:1}
.ap-swap{{ sid }}{height:30px;padding:0 14px;border-radius:100px;border:1.5px solid #9966CC;background:transparent;color:#6a3fa0;font-family:var(--fb);font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;touch-action:manipulation;transition:background .15s,color .15s}
.ap-swap{{ sid }}:hover{background:#9966CC;color:#fff}
.ap-bundle-foot{{ sid }}{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:6px 14px}
.ap-bundle-total{{ sid }}{font-size:13px;font-weight:600;color:var(--ink)}
.ap-bundle-msg{{ sid }}{font-size:12px;color:#9a3b3b;min-height:0}
.ap-bundle-msg{{ sid }}:empty{display:none}
.ap-bundle-hint{{ sid }}{font-size:12px;font-weight:600;color:#6a3fa0}
.ap-bundle-hint{{ sid }}:empty{display:none}
.ap-brow{{ sid }} select.need{border-color:#9966CC;box-shadow:0 0 0 2px rgba(153,102,204,.25)}
.ap-atc{{ sid }}.ap-need .ap-atc-sep{{ sid }},.ap-atc{{ sid }}.ap-need .ap-atc-price{{ sid }}{display:none}
.ap-claim{{ sid }}{display:flex;flex-direction:column;gap:8px;width:100%;margin:14px 0 4px;padding:12px 14px;border:1px solid #9966CC40;border-radius:10px;background:#9966CC0d;box-sizing:border-box}
.ap-claim{{ sid }} .ap-claim-ttl{{ sid }}{font-size:13px;font-weight:600;margin:0;color:#6b3fa0}
.ap-claim{{ sid }} .ap-claim-btn{{ sid }}{min-height:44px;border:1px solid #9966CC;border-radius:999px;background:transparent;color:#6b3fa0;font:inherit;font-weight:600;cursor:pointer}
.ap-claim{{ sid }} .ap-claim-btn{{ sid }}[disabled]{opacity:.55;cursor:not-allowed}
.ap-claim{{ sid }} .ap-claim-btn{{ sid }}.ld{opacity:.7;pointer-events:none}
.ap-claim{{ sid }} input[type=email]{width:100%;min-height:44px;padding:0 14px;border:1px solid #c9c9c9;border-radius:999px;font:inherit;box-sizing:border-box}
.ap-claim{{ sid }} .ap-claim-hint{{ sid }}{font-size:12px;line-height:1.4;opacity:.8;margin:0}
.ap-claim{{ sid }} .ap-claim-err{{ sid }}{color:#9b1c1c;font-size:12px;margin:0;display:none}

@media (max-width:640px){
  .ap-bundle{{ sid }}{padding:10px 14px;max-height:50vh}
  .ap-brow{{ sid }}{flex-basis:100%;max-width:none}
}
@media (prefers-reduced-motion:reduce){.ap-sk{{ sid }}{animation:none}}

/* Variant selector row */
.ap-vrow{{ sid }}{
  display:flex;gap:8px;align-items:center;
  overflow-x:auto;overflow-y:hidden;
  scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;
  margin:0 -16px;padding:2px 16px;
}
.ap-vrow{{ sid }}::-webkit-scrollbar{display:none}
.ap-vgroup{{ sid }}{display:flex;align-items:center;gap:6px;flex-shrink:0}
.ap-vgroup{{ sid }}+.ap-vgroup{{ sid }}{padding-left:10px;border-left:1px solid var(--line)}
.ap-vlabel{{ sid }}{
  font-family:var(--fb);font-size:9.5px;font-weight:400;
  letter-spacing:.18em;text-transform:uppercase;color:var(--dim);
  margin-right:4px;flex-shrink:0;
}
.ap-vsize{{ sid }}{
  padding:7px 13px;border-radius:7px;background:transparent;border:1px solid var(--line);
  font-family:var(--fb);font-size:12px;font-weight:400;color:var(--ink);
  cursor:pointer;line-height:1;white-space:nowrap;flex-shrink:0;
  transition:background .14s,border-color .14s,color .14s,transform .12s;
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
  min-width:38px;text-align:center;
}
.ap-vsize{{ sid }}:hover{border-color:var(--ink)}
.ap-vsize{{ sid }}:active{transform:scale(.96)}
.ap-vsize{{ sid }}.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.ap-vsize{{ sid }}.unavail{opacity:.32;pointer-events:none;text-decoration:line-through;color:var(--dim)}
.ap-vsize{{ sid }}:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.ap-vsw{{ sid }}{
  width:22px;height:22px;border-radius:50%;border:1px solid var(--line);
  padding:0;cursor:pointer;flex-shrink:0;position:relative;
  transition:transform .14s;-webkit-tap-highlight-color:transparent;
  touch-action:manipulation;
}
.ap-vsw{{ sid }}:active{transform:scale(.92)}
.ap-vsw{{ sid }}::after{content:'';position:absolute;inset:-3px;border-radius:50%;border:1.5px solid transparent;transition:border-color .14s}
.ap-vsw{{ sid }}.on::after{border-color:var(--ink)}
.ap-vsw{{ sid }}.unavail{opacity:.32;pointer-events:none}
.ap-vsw{{ sid }}.unavail::before{
  content:'';position:absolute;inset:0;border-radius:50%;
  background:linear-gradient(to top right,transparent calc(50% - 1px),var(--dim) 50%,transparent calc(50% + 1px));
}

/* Qty + ATC row */
.ap-arow{{ sid }}{display:flex;align-items:stretch;gap:10px}
.ap-qty{{ sid }}{
  display:flex;align-items:center;background:transparent;
  border:1px solid var(--line);border-radius:{{ section.settings.atc_radius }}px;
  flex-shrink:0;overflow:hidden;
}
.ap-qty{{ sid }} button{
  background:none;border:none;width:38px;height:100%;
  font-size:17px;font-weight:300;color:var(--ink);cursor:pointer;padding:0;
  display:flex;align-items:center;justify-content:center;
  -webkit-tap-highlight-color:transparent;transition:background .15s;font-family:var(--fb);
  touch-action:manipulation;
}
.ap-qty{{ sid }} button:active{background:var(--ghost)}
.ap-qty{{ sid }} button:disabled{opacity:.3;cursor:not-allowed}
.ap-qty{{ sid }} button:focus-visible{outline:1px solid var(--ink);outline-offset:-2px}
.ap-qty{{ sid }} span{min-width:26px;text-align:center;font-family:var(--fb);font-size:12px;font-weight:400;color:var(--ink);line-height:1}
.ap-atc{{ sid }}{
  flex:1;min-width:0;background:var(--ink);color:var(--bg);
  border:1.5px solid transparent;border-radius:{{ section.settings.atc_radius }}px;
  padding:15px 18px;font-family:var(--fb);cursor:pointer;white-space:nowrap;
  transition:background .22s,color .22s,border-color .22s,transform .12s,box-shadow .22s,opacity .22s;
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
  display:flex;align-items:center;justify-content:center;gap:10px;overflow:hidden;
  position:relative;font-size:13.5px;font-weight:500;letter-spacing:.02em;
  box-shadow:0 4px 14px {{ section.settings.text_color | color_modify: 'alpha', 0.12 }};
}
.ap-atc{{ sid }}:hover{box-shadow:0 6px 20px {{ section.settings.text_color | color_modify: 'alpha', 0.22 }}}
.ap-atc{{ sid }}:active{transform:scale(.98)}
.ap-atc{{ sid }}:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.ap-atc{{ sid }}:disabled{background:var(--line);color:var(--dim);cursor:not-allowed;box-shadow:none}
.ap-atc{{ sid }}.added{background:transparent;border-color:var(--ink);color:var(--ink);box-shadow:none}
.ap-atc{{ sid }}.error{animation:_shake{{ sid }} .42s}
@keyframes _shake{{ sid }}{0%,100%{transform:translateX(0)}25%{transform:translateX(-3px)}75%{transform:translateX(3px)}}
.ap-atc-bag{{ sid }}{width:15px;height:15px;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.ap-atc-sep{{ sid }}{font-weight:400;opacity:.55;line-height:1}
.ap-atc-price{{ sid }}{font-weight:600;letter-spacing:.02em;line-height:1;opacity:.92;transition:opacity .18s}
.ap-atc-price{{ sid }}.flash{opacity:.3}
.ap-atc{{ sid }} ._sp{display:none;width:11px;height:11px;flex-shrink:0;animation:_sp{{ sid }} .85s linear infinite}
.ap-atc{{ sid }}.ld ._sp{display:block}
.ap-atc{{ sid }}.added .ap-atc-sep{{ sid }},
.ap-atc{{ sid }}.added .ap-atc-price{{ sid }},
.ap-atc{{ sid }}.added .ap-atc-bag{{ sid }},
.ap-atc{{ sid }}:disabled .ap-atc-sep{{ sid }},
.ap-atc{{ sid }}:disabled .ap-atc-price{{ sid }}{display:none}
@keyframes _sp{{ sid }}{to{transform:rotate(360deg)}}

/* Reduced motion */
@media (prefers-reduced-motion:reduce){
  .ap-scroll{{ sid }}{scroll-behavior:auto}
  .ap-name{{ sid }}{animation:none;clip-path:none}
  .ap-bar{{ sid }}{transition:none}
  .ap-stock{{ sid }}::before{animation:none}
  .ap-slide{{ sid }} img,.ap-slide{{ sid }} video{transition:none;opacity:1}
}

/* Desktop bar: pills + variants on row 1, qty+atc on row 2 */
@media (min-width:961px){
  .ap-bar-inner{{ sid }}{flex-direction:row;flex-wrap:wrap;align-items:center;gap:12px}
  .ap-trust{{ sid }}{flex-basis:100%;justify-content:flex-start;padding:0 0 4px}
  .ap-pills{{ sid }}{flex:0 1 auto;margin:0;padding:10px 0 0;max-width:56%}
  .ap-vrow{{ sid }}{flex:1;margin:0;padding:0;justify-content:flex-start;min-width:0}
  .ap-arow{{ sid }}{flex-shrink:0;min-width:300px}
}

/* Mobile */
@media (max-width:640px){
  .ap-grid{{ sid }}{display:flex;flex-direction:column;height:auto;overflow:visible;background:var(--bg)}
  .ap-center{{ sid }}{order:0;height:100vw;max-height:520px;flex-shrink:0;overflow:hidden}
  .ap-slide{{ sid }} img,.ap-slide{{ sid }} video{width:90%;height:90%}
  .ap-dots{{ sid }}{bottom:12px}
  .ap-left{{ sid }}{order:1;overflow:visible}
  .ap-left-body{{ sid }}{padding:24px 22px 6px;justify-content:flex-start}
  .ap-right{{ sid }}{order:2;padding:0 22px;overflow:visible;display:block}
  .ap-right-body{{ sid }}{overflow:visible;min-height:unset;padding:14px 0 calc(var(--bar-h) + 24px);justify-content:flex-start}
  .ap-name{{ sid }}{font-size:{{ section.settings.name_size | times: 0.7 | round }}px;margin-bottom:16px;line-height:.98;max-width:9ch}
  .ap-back{{ sid }}{margin-bottom:14px}
  .ap-bullets{{ sid }}{max-width:100%}
  .ap-narrative{{ sid }}{max-width:100%}
  .ap-desc{{ sid }}{max-width:100%}
  .ap-price{{ sid }}{font-size:{{ section.settings.price_size | default: 26 | times: 1.05 | round }}px}
  .ap-price-row{{ sid }}{margin-bottom:18px}
  .ap-stack-btn{{ sid }}{padding:14px 16px;font-size:13.5px}
  .ap-stack-btn{{ sid }}.on{padding:13.5px 15.5px}
  .ap-pill{{ sid }}{min-width:204px;width:204px}
  .ap-trust{{ sid }}{font-size:9px;gap:10px;padding:2px 0 2px}
}
@media (min-width:641px) and (max-width:960px){
  .ap-grid{{ sid }}{grid-template-columns:1fr 48% 1fr}
  .ap-name{{ sid }}{font-size:{{ section.settings.name_size | times: 0.82 | round }}px}
}

/* Theme editor: when section is inactive (deselected), don't take over screen */
.shopify-section--apex-product{contain:layout style}
</style>

<div id="ap{{ sid }}" style="padding-top:var(--top)" data-product-id="{{ product.id }}">
  <div class="ap-grid{{ sid }}">

    <!-- LEFT -->
    <div class="ap-left{{ sid }}">
      <div class="ap-left-body{{ sid }}">

        {%- if back_url != blank -%}
          <a class="ap-back{{ sid }}" href="{{ back_url }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            <span>{{ back_label }}</span>
          </a>
        {%- endif -%}

        <h1 class="ap-name{{ sid }}">{{ product.title | escape }}</h1>

        {%- assign bullet_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'bullet' or block.type == 'highlight' -%}{%- assign bullet_count = bullet_count | plus: 1 -%}{%- endif -%}
        {%- endfor -%}

        {%- if bullet_count > 0 -%}
          <ul class="ap-bullets{{ sid }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'bullet' or block.type == 'highlight' -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'narrative' and block.settings.text != blank -%}
            <div class="ap-narrative{{ sid }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- elsif block.type == 'tagline' and block.settings.text != blank -%}
            <div class="ap-narrative{{ sid }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endif -%}
        {%- endfor -%}

        {%- if desc_mode == 'inline' and product.description != blank -%}
          <div class="ap-desc{{ sid }}">{{ product.description | replace: '<img ', '<img decoding="async" fetchpriority="low" ' }}</div>
        {%- endif -%}

      </div>
    </div>

    <!-- CENTER -->
    <div class="ap-center{{ sid }}">
      {%- if media_count > 0 -%}
        <div class="ap-scroll{{ sid }}" id="ap-scroll{{ sid }}" aria-roledescription="carousel" aria-label="Product images">
          {%- for media in product.media -%}
            <div class="ap-slide{{ sid }}" data-index="{{ forloop.index0 }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ media_count }}">
              {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1400 }}"
                  width="1400"
                  height="{{ 1400 | divided_by: media.aspect_ratio | ceil }}"
                  srcset="{{ media | image_url: width: 600 }} 600w,{{ media | image_url: width: 1000 }} 1000w,{{ media | image_url: width: 1400 }} 1400w"
                  sizes="(max-width:640px) 100vw, 44vw"
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high" decoding="sync"{% else %}decoding="async"{% endif %}
                  draggable="false">
              {%- when 'video' -%}
                {%- assign vsrc = media.sources | where: "format","mp4" | first -%}
                <video src="{{ vsrc.url | default: media.sources.first.url }}"
                  poster="{{ media.preview_image | image_url: width: 1200 }}"
                  muted loop playsinline autoplay preload="none"
                  style="width:88%;height:88%;object-fit:contain;display:block;"></video>
              {%- else -%}
                <img src="{{ media.preview_image | image_url: width: 1000 }}"
                  width="1000" height="{{ 1000 | divided_by: media.preview_image.aspect_ratio | ceil }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="lazy" draggable="false" decoding="async">
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if media_count > 1 -%}
          <button class="ap-arr{{ sid }} p" id="ap-prev{{ sid }}" aria-label="Previous image" type="button"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></button>
          <button class="ap-arr{{ sid }} n" id="ap-next{{ sid }}" aria-label="Next image" type="button"><svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg></button>
          <div class="ap-dots{{ sid }}" id="ap-dots{{ sid }}" role="tablist" aria-label="Image navigation">
            {%- for media in product.media -%}
              <button class="ap-dot{{ sid }}{% if forloop.first %} on{% endif %}"
                data-index="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_brand_overlay and brand_display != blank or section.settings.show_brand_overlay and section.settings.brand_logo != blank -%}
          <div class="ap-brand{{ sid }}" aria-hidden="true">
            {%- if brand_display != blank -%}
              <span class="ap-brand-name{{ sid }}">{{ brand_display }}</span>
            {%- endif -%}
            {%- if section.settings.brand_logo != blank -%}
              {%- if brand_display != blank -%}
                <span class="ap-brand-sep{{ sid }}"></span>
              {%- endif -%}
              <img class="ap-brand-logo{{ sid }}"
                src="{{ section.settings.brand_logo | image_url: width: 300 }}"
                alt="{{ shop.name | escape }}"
                loading="lazy"
                decoding="async"
                width="150"
                height="{{ section.settings.brand_logo_height | default: 22 }}">
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- else -%}
        <div class="ap-empty{{ sid }}">No images</div>
      {%- endif -%}
    </div>

    <!-- RIGHT -->
    <div class="ap-right{{ sid }}">
      <div class="ap-right-body{{ sid }}">

        {%- comment -%}
          PDP dedupe 2026-10-05: the sticky bar (fixed, visible on load) already shows price, compare price and the
          size/colour pickers, so the main price row is off by default. JS null-checks ap-price/ap-was/ap-badge.
          Turn "Show price in main section" on to bring it back.
        {%- endcomment -%}
        {%- if section.settings.main_show_price -%}
        <div class="ap-price-row{{ sid }}">
          <span class="ap-price{{ sid }}" id="ap-price{{ sid }}">{{ current_variant.price | money_without_trailing_zeros }}</span>
          <span class="ap-was{{ sid }}" id="ap-was{{ sid }}"{% unless has_discount %} style="display:none"{% endunless %}>{% if has_discount %}{{ current_variant.compare_at_price | money_without_trailing_zeros }}{% endif %}</span>
          <span class="ap-badge{{ sid }}" id="ap-badge{{ sid }}"{% unless has_discount %} style="display:none"{% endunless %}>{% if has_discount %}−{{ discount_pct }}%{% endif %}</span>
        </div>
        {%- endif -%}

        <div class="ap-stock{{ sid }}{% if is_low_stock %} show{% endif %}" id="ap-stock{{ sid }}" data-low="{{ low_stock_at }}">
          {% if is_low_stock %}Only {{ inv }} left{% endif %}
        </div>

        {%- if section.settings.main_hide_options -%}<style>.ap-right-body{{ sid }} .ap-opt-lbl{{ sid }},.ap-right-body{{ sid }} .ap-swatches{{ sid }}{display:none !important}</style>{%- endif -%}
        {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" id="ap-vid{{ sid }}" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="ap-qty{{ sid }}" value="1">
          <div class="ap-col{{ sid }}">
            {%- assign has_note = false -%}
            {%- assign has_picker = false -%}
            {%- assign has_atc = false -%}
            {%- assign has_details = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'checkout_note' -%}{%- assign has_note = true -%}{%- endif -%}
              {%- if block.type == 'variant_picker' -%}{%- assign has_picker = true -%}{%- endif -%}
              {%- if block.type == 'column_atc' -%}{%- assign has_atc = true -%}{%- endif -%}
              {%- if block.type == 'accordion' and block.settings.source == 'description' -%}{%- assign has_details = true -%}{%- endif -%}
            {%- endfor -%}

            {%- unless has_note -%}
              <p class="ap-note{{ sid }}"><u>Shipping</u> calculated at checkout.</p>
            {%- endunless -%}

            {%- unless has_picker -%}
              {%- unless product.has_only_default_variant -%}
                {%- for option in product.options_with_values -%}
                  {%- assign odn = option.name | downcase -%}
                  <span class="ap-size-lbl{{ sid }}">{{ option.name }}</span>
                  {%- if odn == 'color' or odn == 'colour' -%}
                    <div class="ap-swatches{{ sid }}" data-opt="{{ forloop.index }}">
                      {%- for val in option.values -%}
                        <button type="button" data-vbtn class="ap-swatch{{ sid }}{% if option.selected_value == val %} on{% endif %}" data-val="{{ val }}" title="{{ val }}" aria-label="{{ val }}" style="background:{{ val | handle }};"></button>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="ap-stack{{ sid }} ap-sizes{{ sid }}" data-opt="{{ forloop.index }}" role="radiogroup" aria-label="{{ option.name }}">
                      {%- for val in option.values -%}
                        <button type="button" data-vbtn class="ap-stack-btn{{ sid }}{% if option.selected_value == val %} on{% endif %}" data-val="{{ val }}" role="radio" aria-checked="{% if option.selected_value == val %}true{% else %}false{% endif %}">{{ val }}</button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endunless -%}
            {%- endunless -%}

            {%- unless has_atc -%}
              <button type="button" class="ap-col-atc{{ sid }}" data-col-atc {% unless current_variant.available %}disabled{% endunless %}>
                <span data-col-atc-label>{{ section.settings.atc_text | default: 'Add to cart' }}</span>
                <span id="ap-col-price{{ sid }}">{{ current_variant.price | money }}</span>
              </button>
            {%- endunless -%}

            {%- unless has_details -%}
              {%- if product.description != blank -%}
                <div class="ap-acc{{ sid }} ap-link-row{{ sid }}">
                  <button type="button" class="ap-link-trig{{ sid }}" data-link-toggle="desc{{ sid }}" aria-expanded="false">
                    <span>Details</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                  <div class="ap-link-body{{ sid }}" id="desc{{ sid }}">
                    <div class="ap-link-inner{{ sid }}"><div class="ap-link-content{{ sid }}">{{ product.description }}</div></div>
                  </div>
                </div>
              {%- endif -%}
            {%- endunless -%}

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'checkout_note' -%}
                  <p class="ap-note{{ sid }}" {{ block.shopify_attributes }}>
                    {%- assign note = block.settings.text | default: 'Shipping calculated at checkout.' -%}
                    {%- assign word = block.settings.link_word -%}
                    {%- if word != blank and note contains word -%}
                      {%- if block.settings.link != blank -%}
                        {{ note | replace: word, '<a href="' | append: block.settings.link | append: '">' | append: word | append: '</a>' }}
                      {%- else -%}
                        {{ note | replace: word, '<u>' | append: word | append: '</u>' }}
                      {%- endif -%}
                    {%- else -%}
                      {{ note }}
                    {%- endif -%}
                  </p>
                {%- when 'variant_picker' -%}
                  <div {{ block.shopify_attributes }}>
                    {%- unless product.has_only_default_variant -%}
                      {%- for option in product.options_with_values -%}
                        {%- assign odn = option.name | downcase -%}
                        <span class="ap-size-lbl{{ sid }}">{{ option.name }}</span>
                        {%- if odn == 'color' or odn == 'colour' -%}
                          <div class="ap-swatches{{ sid }}" data-opt="{{ forloop.index }}">
                            {%- for val in option.values -%}
                              <button type="button" data-vbtn class="ap-swatch{{ sid }}{% if option.selected_value == val %} on{% endif %}" data-val="{{ val }}" title="{{ val }}" aria-label="{{ val }}" style="background:{{ val | handle }};"></button>
                            {%- endfor -%}
                          </div>
                        {%- else -%}
                          <div class="ap-stack{{ sid }} ap-sizes{{ sid }}" data-opt="{{ forloop.index }}" role="radiogroup" aria-label="{{ option.name }}">
                            {%- for val in option.values -%}
                              <button type="button" data-vbtn class="ap-stack-btn{{ sid }}{% if option.selected_value == val %} on{% endif %}" data-val="{{ val }}" role="radio" aria-checked="{% if option.selected_value == val %}true{% else %}false{% endif %}">{{ val }}</button>
                            {%- endfor -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endunless -%}
                  </div>
                {%- when 'column_atc' -%}
                  <button type="button" class="ap-col-atc{{ sid }}" data-col-atc {{ block.shopify_attributes }} {% unless current_variant.available %}disabled{% endunless %}>
                    <span data-col-atc-label>{{ block.settings.label | default: 'Add to cart' }}</span>
                    <span id="ap-col-price{{ sid }}">{{ current_variant.price | money }}</span>
                  </button>
                {%- when 'accordion' -%}
                  <div class="ap-acc{{ sid }} ap-link-row{{ sid }}" {{ block.shopify_attributes }}>
                    <button type="button" class="ap-link-trig{{ sid }}" data-link-toggle="acc-{{ block.id }}" aria-expanded="false">
                      <span>{{ block.settings.title | escape }}</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="ap-link-body{{ sid }}" id="acc-{{ block.id }}">
                      <div class="ap-link-inner{{ sid }}"><div class="ap-link-content{{ sid }}">
                        {%- if block.settings.source == 'description' -%}
                          {{ product.description }}
                        {%- else -%}
                          {{ block.settings.content }}
                        {%- endif -%}
                      </div></div>
                    </div>
                  </div>
                {%- when 'size_guide_drawer' -%}
                  {%- if show_sg -%}
                    <div class="ap-acc{{ sid }} ap-link-row{{ sid }}" {{ block.shopify_attributes }}>
                      {%- if sg_redirect != blank -%}
                        <a class="ap-link-trig{{ sid }}" href="{{ sg_redirect }}"><span>{{ sg_label }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></a>
                      {%- else -%}
                        <button type="button" class="ap-link-trig{{ sid }}" data-link-toggle="sg{{ sid }}" aria-expanded="false"><span>{{ sg_label }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></button>
                        <div class="ap-link-body{{ sid }}" id="sg{{ sid }}"><div class="ap-link-inner{{ sid }}"><div class="ap-link-content{{ sid }}">{{ sg_content }}</div></div></div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- when 'shipping' -%}
                  {%- if show_sh -%}
                    <div class="ap-acc{{ sid }} ap-link-row{{ sid }}" {{ block.shopify_attributes }}>
                      {%- if sh_redirect != blank -%}
                        <a class="ap-link-trig{{ sid }}" href="{{ sh_redirect }}"><span>{{ sh_label }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></a>
                      {%- else -%}
                        <button type="button" class="ap-link-trig{{ sid }}" data-link-toggle="sh{{ sid }}" aria-expanded="false"><span>{{ sh_label }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></button>
                        <div class="ap-link-body{{ sid }}" id="sh{{ sid }}"><div class="ap-link-inner{{ sid }}"><div class="ap-link-content{{ sid }}">{%- if sh_image != blank -%}<img src="{{ sh_image | image_url: width: 600 }}" alt="{{ sh_label | escape }}" loading="lazy">{%- endif -%}{{ sh_content }}</div></div></div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
          <input type="submit" id="ap-fsub{{ sid }}" style="display:none" tabindex="-1" aria-hidden="true">
        {%- endform -%}

        {%- if lx_pdp_gift -%}
          {%- assign lx_pdp_min_dollars = lx_pdp_min | divided_by: 100 -%}
          <div class="ap-claim{{ sid }}" id="ap-claim{{ sid }}" data-lx-min="{{ lx_pdp_min }}">
            <p class="ap-claim-ttl{{ sid }}">Or get this pair FREE</p>
            <p class="ap-claim-hint{{ sid }}" id="ap-claim-hint{{ sid }}">Free with ${{ lx_pdp_min_dollars }}+ of eligible items in your bag (one free pair per order). Buying it on its own? Use Add to cart.</p>
            <label class="visually-hidden" for="ap-claim-email{{ sid }}">Email</label>
            <input type="email" id="ap-claim-email{{ sid }}" name="lx_claim_email" placeholder="Email to claim" autocomplete="email">
            <button type="button" class="ap-claim-btn{{ sid }}" id="ap-claim-btn{{ sid }}" disabled>Claim free</button>
            <p class="ap-claim-err{{ sid }}" id="ap-claim-err{{ sid }}" role="alert"></p>
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>
</div>

<!-- STICKY BAR — portal'd to <body> on init -->
<div class="ap-bar{{ sid }}" id="ap-bar{{ sid }}" data-section="{{ sid }}" role="region" aria-label="Add to cart">
  {%- if show_pill -%}
  <div class="ap-bundle{{ sid }}" id="ap-bundle{{ sid }}" role="region" aria-label="Your bundle" hidden>
    <div class="ap-bundle-inner{{ sid }}">
      <div class="ap-bundle-head{{ sid }}">
        <div class="ap-bundle-ttl{{ sid }}">
          <strong id="ap-bundle-title{{ sid }}">Your bundle</strong>
          <span id="ap-bundle-sub{{ sid }}"></span>
        </div>
        <button type="button" class="ap-bundle-x{{ sid }}" id="ap-bundle-x{{ sid }}" aria-label="Close bundle details">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
        </button>
      </div>
      <div class="ap-bundle-rows{{ sid }}" id="ap-bundle-rows{{ sid }}"></div>
      <div class="ap-bundle-foot{{ sid }}">
        <span class="ap-bundle-total{{ sid }}" id="ap-bundle-total{{ sid }}"></span>
        <span class="ap-bundle-hint{{ sid }}" id="ap-bundle-hint{{ sid }}" aria-live="polite"></span>
        <span class="ap-bundle-msg{{ sid }}" id="ap-bundle-msg{{ sid }}" role="status" aria-live="polite"></span>
      </div>
    </div>
  </div>
  {%- endif -%}
  <div class="ap-bar-inner{{ sid }}">

    {%- if section.settings.show_trust_strip -%}
      <div class="ap-trust{{ sid }} on">
        {%- if section.settings.trust_1 != blank -%}
          <span class="ap-trust-item{{ sid }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h13l-1 12H4L3 7z"/><path d="M14 7l5 4h2v8h-3"/></svg>
            {{ section.settings.trust_1 }}
          </span>
        {%- endif -%}
        {%- if section.settings.trust_2 != blank -%}
          <span class="ap-trust-item{{ sid }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9"/><polyline points="3 4 3 12 11 12"/></svg>
            {{ section.settings.trust_2 }}
          </span>
        {%- endif -%}
        {%- if section.settings.trust_3 != blank -%}
          <span class="ap-trust-item{{ sid }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z"/></svg>
            {{ section.settings.trust_3 }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_pill -%}
      <div class="ap-pills{{ sid }}" id="ap-pills{{ sid }}" role="radiogroup" aria-label="Bundle options">
        <button type="button" class="ap-pill{{ sid }} on" data-bundle="1" role="radio" aria-checked="true" tabindex="0">
          <div class="ap-pill-img{{ sid }}">
            {%- if pill_thumb != blank -%}<img src="{{ pill_thumb }}" alt="" loading="lazy" decoding="async" width="42" height="42">{%- endif -%}
          </div>
          <div class="ap-pill-info{{ sid }}">
            <span class="ap-pill-label{{ sid }}">{{ section.settings.single_label | default: 'Single' }}</span>
            <span class="ap-pill-sub{{ sid }}">
              {%- if single_save > 0 -%}You save {{ single_save | money_without_trailing_zeros }}{%- else -%}{{ section.settings.single_sublabel }}{%- endif -%}
            </span>
          </div>
          <div class="ap-pill-price{{ sid }}">
            <span class="ap-pill-now{{ sid }}" data-bp-price>{{ single_price | money_without_trailing_zeros }}</span>
            <span class="ap-pill-was{{ sid }}" data-bp-was{% unless single_compare > single_price %} style="display:none"{% endunless %}>{{ single_compare | money_without_trailing_zeros }}</span>
          </div>
        </button>

        {%- if duo_visible -%}
          <button type="button" class="ap-pill{{ sid }} ap-bpill{{ sid }}" data-bundle="2" role="radio" aria-checked="false" aria-controls="ap-bundle{{ sid }}" tabindex="-1">
            {%- if section.settings.duo_ribbon != blank -%}<span class="ap-pill-ribbon{{ sid }}">{{ section.settings.duo_ribbon }}</span>{%- endif -%}
            <div class="ap-pill-img{{ sid }} ap-pill-imgs{{ sid }}" data-thumbs="2">
              <span class="ap-th{{ sid }}">{%- if pill_thumb != blank -%}<img src="{{ pill_thumb }}" alt="" loading="lazy" decoding="async" width="34" height="34">{%- endif -%}</span>
              <span class="ap-th{{ sid }} ap-sk{{ sid }}"></span>
            </div>
            <div class="ap-pill-info{{ sid }}">
              <span class="ap-pill-label{{ sid }}">{{ section.settings.duo_label | default: 'Duo' }}</span>
              <span class="ap-pill-sub{{ sid }}" data-bp-sub>Finding a match</span>
            </div>
            <div class="ap-pill-price{{ sid }}">
              <span class="ap-pill-now{{ sid }}" data-bp-price><i class="ap-dots{{ sid }}">···</i></span>
            </div>
          </button>
        {%- endif -%}

        {%- if triple_visible -%}
          <button type="button" class="ap-pill{{ sid }} ap-bpill{{ sid }}" data-bundle="3" role="radio" aria-checked="false" aria-controls="ap-bundle{{ sid }}" tabindex="-1">
            {%- if section.settings.triple_ribbon != blank -%}<span class="ap-pill-ribbon{{ sid }}">{{ section.settings.triple_ribbon }}</span>{%- endif -%}
            <div class="ap-pill-img{{ sid }} ap-pill-imgs{{ sid }}" data-thumbs="3">
              <span class="ap-th{{ sid }}">{%- if pill_thumb != blank -%}<img src="{{ pill_thumb }}" alt="" loading="lazy" decoding="async" width="34" height="34">{%- endif -%}</span>
              <span class="ap-th{{ sid }} ap-sk{{ sid }}"></span>
              <span class="ap-th{{ sid }} ap-sk{{ sid }}"></span>
            </div>
            <div class="ap-pill-info{{ sid }}">
              <span class="ap-pill-label{{ sid }}">{{ section.settings.triple_label | default: 'Trio' }}</span>
              <span class="ap-pill-sub{{ sid }}" data-bp-sub>Finding matches</span>
            </div>
            <div class="ap-pill-price{{ sid }}">
              <span class="ap-pill-now{{ sid }}" data-bp-price><i class="ap-dots{{ sid }}">···</i></span>
            </div>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- unless product.has_only_default_variant -%}
      <div class="ap-vrow{{ sid }}" id="ap-vrow{{ sid }}">
        {%- for option in product.options_with_values -%}
          {%- assign odn = option.name | downcase -%}
          {%- unless odn == 'title' -%}
            <div class="ap-vgroup{{ sid }}" data-opt="{{ forloop.index }}" aria-label="{{ option.name }}">
              <span class="ap-vlabel{{ sid }}">{{ option.name }}</span>
              {%- if odn == 'color' or odn == 'colour' -%}
                {%- for val in option.values -%}
                  <button type="button" data-vbtn
                    class="ap-vsw{{ sid }}{% if option.selected_value == val %} on{% endif %}"
                    data-val="{{ val }}" title="{{ val }}" aria-label="{{ val }}"
                    style="background:{{ val | handle }};"></button>
                {%- endfor -%}
              {%- else -%}
                {%- for val in option.values -%}
                  <button type="button" data-vbtn
                    class="ap-vsize{{ sid }}{% if option.selected_value == val %} on{% endif %}"
                    data-val="{{ val }}"
                    aria-pressed="{% if option.selected_value == val %}true{% else %}false{% endif %}">{{ val }}</button>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <div class="ap-arow{{ sid }}">
      <div class="ap-qty{{ sid }}" role="group" aria-label="Quantity">
        <button type="button" id="ap-qty-dec{{ sid }}" aria-label="Decrease quantity">−</button>
        <span id="ap-qty-val{{ sid }}" aria-live="polite">1</span>
        <button type="button" id="ap-qty-inc{{ sid }}" aria-label="Increase quantity">+</button>
      </div>
      <button class="ap-atc{{ sid }}" id="ap-atc{{ sid }}"
        data-bag-url="{{ section.settings.view_bag_url | default: '/cart' }}"
        data-bag-text="{{ section.settings.view_bag_text | default: 'View Bag' }}"
        data-atc-link="{{ section.settings.atc_link | default: '' }}"
        data-loading-text="{{ section.settings.loading_text | default: 'Adding…' }}"
        {% unless current_variant.available %}disabled{% endunless %}
        aria-label="Add {{ product.title | escape }} to cart"
        type="button">
        <svg class="ap-atc-bag{{ sid }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
                <span id="ap-atc-lbl{{ sid }}">{%- if current_variant.available -%}{{ section.settings.atc_text }}{%- else -%}{{ section.settings.soldout_text }}{%- endif -%}</span>
        <span class="ap-atc-sep{{ sid }}" aria-hidden="true">·</span>
        <span class="ap-atc-price{{ sid }}" id="ap-atc-price{{ sid }}">{{ current_variant.price | money_without_trailing_zeros }}</span>
        <svg class="_sp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
        </svg>
      </button>
    </div>

  </div>
</div>

<script type="application/ld+json">
{%- liquid
  assign ld_desc = page_description | default: product.description | strip_html | strip_newlines | truncate: 500
  assign ld_cur = cart.currency.iso_code
  assign ld_material = blank
  assign ld_desc_l = ld_desc | downcase
  if product.tags contains 'Faux Leather'
    assign ld_material = 'Faux leather (PU)'
  elsif ld_desc_l contains 'faux leather' or ld_desc_l contains 'faux-leather'
    assign ld_material = 'Faux leather'
  elsif ld_desc_l contains 'pu leather' or ld_desc_l contains 'fabric: pu' or ld_desc_l contains 'material: pu' or ld_desc_l contains ' artificial pu' or ld_desc_l contains 'fabric:pu'
    assign ld_material = 'Faux leather (PU)'
  elsif product.type == 'Sunglasses' or product.tags contains 'Specs'
    assign ld_material = blank
  endif
-%}
{"@context":"https://schema.org/","@type":"Product","@id":{{ request.origin | append: product.url | append: '#product' | json }},"name":{{ product.title | json }},"description":{{ ld_desc | json }},"url":{{ request.origin | append: product.url | json }},"sku":{{ product.selected_or_first_available_variant.sku | default: product.id | json }},"brand":{"@type":"Brand","name":"LEXE"},{% if product.type != blank %}"category":{{ product.type | json }},{% endif %}{% if ld_material != blank %}"material":{{ ld_material | json }},{% endif %}"image":[{% for img in product.images limit: 10 %}"https:{{ img | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}{% endfor %}],"offers":[{% for v in product.variants limit: 100 %}{"@type":"Offer","url":{{ request.origin | append: product.url | append: '?variant=' | append: v.id | json }},"priceCurrency":{{ ld_cur | json }},"price":"{{ v.price | divided_by: 100.0 }}","availability":"{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}","itemCondition":"https://schema.org/NewCondition"{% if v.sku != blank %},"sku":{{ v.sku | json }}{% endif %},"seller":{"@type":"Organization","@id":{{ request.origin | append: '/#organization' | json }},"name":"Devici Studios"}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
</script>

<script>
(function(){
  'use strict';
  var S='{{ sid }}';
  var VARS={{ product.variants | json }};
  var OPTS={{ product.options | json }};
  var SYM={{ cart.currency.symbol | json }};
  var COUNT={{ media_count }};
  var LOW={{ low_stock_at | default: 5 }};
  var SHOW_STOCK={{ section.settings.show_stock | json }};
  var sel={};
  var root=document.getElementById('ap'+S);
  if(!root)return;

  /* ── PORTAL bar to <body> (escape transform / overflow ancestors) ── */
  var bar=document.getElementById('ap-bar'+S);
  if(bar&&bar.parentNode!==document.body){
    document.body.appendChild(bar);
  }

  var priceEl=document.getElementById('ap-price'+S);
  var wasEl=document.getElementById('ap-was'+S);
  var badgeEl=document.getElementById('ap-badge'+S);
  var stockEl=document.getElementById('ap-stock'+S);
  var atc=document.getElementById('ap-atc'+S);
  var atcLbl=document.getElementById('ap-atc-lbl'+S);
  var atcPrice=document.getElementById('ap-atc-price'+S);
  var vid=document.getElementById('ap-vid'+S);
  var qtyIn=document.getElementById('ap-qty'+S);
  var qDec=document.getElementById('ap-qty-dec'+S);
  var qInc=document.getElementById('ap-qty-inc'+S);
  var qVal=document.getElementById('ap-qty-val'+S);
  var fsub=document.getElementById('ap-fsub'+S);
  var pillsWrap=document.getElementById('ap-pills'+S);
  var pillEls=pillsWrap?Array.prototype.slice.call(pillsWrap.querySelectorAll('.ap-pill'+S)):[];
  var scroller=document.getElementById('ap-scroll'+S);
  var prevBtn=document.getElementById('ap-prev'+S);
  var nextBtn=document.getElementById('ap-next'+S);

  function $$(q){return Array.prototype.slice.call(document.querySelectorAll(q));}

  /* Init selection state */
  OPTS.forEach(function(_,i){
    var oi=i+1;
    var anyBtn=document.querySelector('[data-opt="'+oi+'"] [data-vbtn].on');
    sel[oi]=anyBtn?anyBtn.dataset.val:'';
  });

  function findVariant(s){
    s=s||sel;
    return VARS.find(function(v){return OPTS.every(function(_,i){return v['option'+(i+1)]===s[i+1];});});
  }
  function money(c){return SYM+(c/100).toFixed(2).replace(/\.00$/,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');}
  function curQty(){return qtyIn?Math.max(1,parseInt(qtyIn.value,10)||1):1;}

  /* ══ LEXE bundle pills ══
     Single / Duo / Trio choose WHAT is bought. Quantity is separate and multiplies the whole selection.
     Duo = this product + 1 add-on, Trio = this product + 2 add-ons. Add-ons come from other collections
     (see section setting "Bundle add-on source collections"). No bundle discount is applied or shown. */
  var BPCFG={sources:{{ bp_sources | split: ',' | json }},cur:{{ bp_cur_cols | split: ',' | json }},pid:{{ product.id }},price:{{ current_variant.price | default: 0 }},needCost:{{ section.settings.bundle_require_cost | json }},swap:{{ section.settings.bundle_swap | json }},thumb:{{ pill_thumb | json }},labels:{2:{{ section.settings.duo_label | default: 'Duo' | json }},3:{{ section.settings.triple_label | default: 'Trio' | json }} }};
  var BP={mode:1,ready:false,failed:false,loading:false,byId:{},colItems:{},picks:[],swaps:[0,0],vsel:{},open:false};
  var memSeed=null;
  function sget(k){try{return sessionStorage.getItem(k);}catch(e){return null;}}
  function sset(k,v){try{sessionStorage.setItem(k,v);}catch(e){}}
  function bpSeed(){
    var s=sget('lexe_bp_seed');
    if(!s){s=memSeed||String(Math.random()).slice(2,10);memSeed=s;sset('lexe_bp_seed',s);}
    return s;
  }
  function bpHash(str){var h=2166136261;for(var i=0;i<str.length;i++){h^=str.charCodeAt(i);h=Math.imul(h,16777619);}return h>>>0;}
  function bpRng(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
  function bpShuffle(arr,r){var a=arr.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(r()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}
  try{var sw=JSON.parse(sget('lexe_bp_sw:'+BPCFG.pid)||'null');if(sw&&sw.length===2)BP.swaps=[sw[0]|0,sw[1]|0];}catch(e){}

  function bpEls(){
    return{
      panel:document.getElementById('ap-bundle'+S),rows:document.getElementById('ap-bundle-rows'+S),
      title:document.getElementById('ap-bundle-title'+S),sub:document.getElementById('ap-bundle-sub'+S),
      total:document.getElementById('ap-bundle-total'+S),msg:document.getElementById('ap-bundle-msg'+S),
      close:document.getElementById('ap-bundle-x'+S)
    };
  }
  var BE=bpEls();

  function loadPool(force){
    var key='lexe_bp_pool:'+BPCFG.sources.join(',');
    if(!force){
      try{var c=JSON.parse(sget(key)||'null');if(c&&c.d&&Date.now()-c.t<1800000)return Promise.resolve(c.d);}catch(e){}
    }
    return fetch('/search?view=lexe-bundle&q='+encodeURIComponent(BPCFG.sources.join(',')),{credentials:'same-origin'})
      .then(function(r){if(!r.ok)throw 0;return r.json();})
      .then(function(d){
        if(!d||!d.p||!d.p.length)throw 0;
        sset(key,JSON.stringify({t:Date.now(),d:d}));
        return d;
      });
  }
  function indexPool(d){
    BP.byId={};BP.colItems={};
    d.p.forEach(function(p){p.cols=[];BP.byId[p.id]=p;});
    Object.keys(d.m).forEach(function(c){
      BP.colItems[c]=[];
      d.m[c].forEach(function(id){var p=BP.byId[id];if(p){p.cols.push(c);BP.colItems[c].push(p);}});
    });
  }
  function eligible(p){
    if(p.id===BPCFG.pid||!p.vs||!p.vs.length||!p.cols.length)return false;
    if(BPCFG.needCost&&!p.co)return false;
    return true;
  }
  function overlapsCur(p){
    for(var i=0;i<p.cols.length;i++){if(BPCFG.cur.indexOf(p.cols[i])>-1)return true;}
    return false;
  }
  /* Seeded round-robin across the source collections (so each gets a turn). Inside a collection, items priced
     about 0.5x to 2x of this product come first when at least 3 fit; otherwise the whole collection is used. */
  function roundRobin(items,r){
    var cols=bpShuffle(Object.keys(BP.colItems),r);
    var lists=cols.map(function(c){
      var all=items.filter(function(p){return p.cols.indexOf(c)>-1;});
      if(BPCFG.price>0){
        var band=all.filter(function(p){var m=minPrice(p);return m>=BPCFG.price*0.5&&m<=BPCFG.price*2;});
        if(band.length>=3)all=band;
      }
      return bpShuffle(all,r);
    }).filter(function(l){return l.length;});
    var out=[],seen={},i=0,more=true;
    while(more){
      more=false;
      for(var j=0;j<lists.length;j++){
        if(i<lists[j].length){more=true;var p=lists[j][i];if(!seen[p.id]){seen[p.id]=1;out.push(p);}}
      }
      i++;
    }
    return out;
  }
  /* Tier A = items outside the current product's own collection(s); tier B = same collection, never the product itself. */
  function orderFor(k){
    var r=bpRng(bpHash(bpSeed()+':'+BPCFG.pid+':'+k));
    var pool=Object.keys(BP.byId).map(function(id){return BP.byId[id];}).filter(eligible);
    var A=pool.filter(function(p){return !overlapsCur(p);}),B=pool.filter(overlapsCur);
    return{a:roundRobin(A,r),b:roundRobin(B,r)};
  }
  function computePicks(){
    var o0=orderFor(0),l0=o0.a.concat(o0.b);
    if(!l0.length){BP.picks=[];BP.len0=0;BP.len1=0;return;}
    var p0=l0[BP.swaps[0]%l0.length];
    var o1=orderFor(1);
    var disj=function(p){return !p.cols.some(function(c){return p0.cols.indexOf(c)>-1;});};
    var notDisj=function(p){return !disj(p);};
    var a1=o1.a.filter(function(p){return p.id!==p0.id;}),b1=o1.b.filter(function(p){return p.id!==p0.id;});
    /* Second add-on: other collection than the current product first, and a different collection than the first add-on when possible. */
    var l1=a1.filter(disj).concat(a1.filter(notDisj),b1.filter(disj),b1.filter(notDisj));
    var p1=l1.length?l1[BP.swaps[1]%l1.length]:null;
    BP.len0=l0.length;BP.len1=l1.length;
    BP.picks=p1?[p0,p1]:[p0];
  }
  /* Add-ons with several in-stock variants (phone model, size, colour) are never preselected. */
  function isMulti(p){return p.vs.length>1;}
  function pickVar(p){
    if(isMulti(p)){var i=BP.vsel[p.id];return(i==null)?null:p.vs[i];}
    return p.vs[0];
  }
  function minPrice(p){var m=Infinity;p.vs.forEach(function(x){if(x[2]<m)m=x[2];});return m;}
  function maxPrice(p){var m=0;p.vs.forEach(function(x){if(x[2]>m)m=x[2];});return m;}
  function unitPrice(p){var v=pickVar(p);return v?v[2]:minPrice(p);}
  function isApprox(p){return !pickVar(p)&&minPrice(p)!==maxPrice(p);}
  function pendingCount(){
    if(BP.mode<2||!BP.ready)return 0;
    var n=0;
    for(var i=0;i<BP.mode-1&&i<BP.picks.length;i++){if(!pickVar(BP.picks[i]))n++;}
    return n;
  }
  function chooseLabel(p){
    var names=(p.o||[]).join(' ').toLowerCase();
    var parts=[];
    if(p.ty==='Phone Case'&&(/model|型号/.test(names)))parts.push('phone model');
    else{
      if(/size/.test(names))parts.push('size');
      if(/colou?r/.test(names))parts.push('color');
      if(/material|style/.test(names))parts.push('style');
      if(!parts.length)parts.push('option');
    }
    return 'Choose your '+parts.join(' / ');
  }
  function extraCents(){
    var n=BP.mode-1,t=0;
    if(BP.mode<2||BP.picks.length<n)return 0;
    for(var i=0;i<n;i++)t+=unitPrice(BP.picks[i]);
    return t;
  }
  function anyApprox(){
    for(var i=0;i<BP.mode-1&&i<BP.picks.length;i++){if(isApprox(BP.picks[i]))return true;}
    return false;
  }
  function shortName(t){return String(t||'');}

  /* Render pills (prices, thumbs, sub-labels). Qty never enters the pill prices. */
  function renderPills(v){
    pillEls.forEach(function(p){
      var b=+p.getAttribute('data-bundle')||1;
      var priceEl2=p.querySelector('[data-bp-price]');
      if(b===1){
        if(v&&priceEl2)priceEl2.textContent=money(v.price);
        var w=p.querySelector('[data-bp-was]');
        if(w&&v){if(v.compare_at_price&&v.compare_at_price>v.price){w.textContent=money(v.compare_at_price);w.style.display='';}else w.style.display='none';}
        return;
      }
      var need=b-1;
      if(BP.failed||(BP.ready&&BP.picks.length<need)){p.hidden=true;return;}
      p.hidden=false;
      if(!BP.ready||!v)return;
      var sum=v.price,apx=false;
      for(var i=0;i<need;i++){sum+=unitPrice(BP.picks[i]);if(isApprox(BP.picks[i]))apx=true;}
      if(priceEl2)priceEl2.textContent=(apx?'from ':'')+money(sum);
      var names=[];
      for(var k=0;k<need;k++)names.push(shortName(BP.picks[k].t));
      var sub=p.querySelector('[data-bp-sub]');
      if(sub)sub.textContent='+ '+names.join(' & ');
      var ths=p.querySelectorAll('.ap-th'+S);
      for(var m=1;m<ths.length;m++){
        var pk=BP.picks[m-1];if(!pk)continue;
        var th=ths[m];th.classList.remove('ap-sk'+S);
        var im=th.querySelector('img');
        if(!im){im=document.createElement('img');im.alt='';im.width=34;im.height=34;im.loading='lazy';im.decoding='async';th.appendChild(im);}
        if(im.getAttribute('src')!==pk.i)im.setAttribute('src',pk.i);
      }
    });
  }

  /* Panel */
  function mk(tag,cls,txt){var e=document.createElement(tag);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e;}
  function varLabel(t){return(t&&t!=='Default Title')?t:'';}
  function renderPanel(){
    if(!BE.panel)return;
    BE.rows.textContent='';
    if(BP.mode<2||!BP.ready){return;}
    var v=findVariant();
    BE.title.textContent='Your '+(BPCFG.labels[BP.mode]||'bundle');
    BE.sub.textContent=BP.mode===2?'This piece plus one suggested add-on from another part of LEXE.':'This piece plus two suggested add-ons from other parts of LEXE.';
    /* this piece (fixed) */
    var r0=mk('div','ap-brow'+S+' fixed');
    var i0=mk('div','ap-brow-img'+S);
    if(BPCFG.thumb){var im0=document.createElement('img');im0.src=BPCFG.thumb;im0.alt='';im0.width=54;im0.height=54;im0.loading='lazy';i0.appendChild(im0);}
    r0.appendChild(i0);
    var b0=mk('div','ap-brow-body'+S);
    b0.appendChild(mk('span','ap-brow-tag'+S,'This piece'));
    b0.appendChild(mk('span','ap-brow-name'+S,PD.title));
    if(v&&varLabel(v.title))b0.appendChild(mk('span','ap-brow-var'+S,varLabel(v.title)));
    r0.appendChild(b0);
    var s0=mk('div','ap-brow-side'+S);
    s0.appendChild(mk('span','ap-brow-price'+S,v?money(v.price):''));
    r0.appendChild(s0);
    BE.rows.appendChild(r0);
    /* add-ons */
    for(var i=0;i<BP.mode-1;i++){
      (function(slot){
        var p=BP.picks[slot];
        var row=mk('div','ap-brow'+S);row.setAttribute('data-slot',slot);
        var im=mk('div','ap-brow-img'+S);
        var ie=document.createElement('img');ie.src=p.i;ie.alt='';ie.width=54;ie.height=54;ie.loading='lazy';im.appendChild(ie);
        row.appendChild(im);
        var body=mk('div','ap-brow-body'+S);
        body.appendChild(mk('span','ap-brow-tag'+S,'Suggested add-on'));
        body.appendChild(mk('span','ap-brow-name'+S,p.t));
        if(isMulti(p)){
          var sel2=document.createElement('select');
          sel2.setAttribute('aria-label',chooseLabel(p)+' for '+p.t);
          sel2.setAttribute('data-needs','1');
          var ph=document.createElement('option');ph.value='';ph.disabled=true;ph.textContent=chooseLabel(p);sel2.appendChild(ph);
          var mn=minPrice(p);
          p.vs.forEach(function(x,xi){
            var o=document.createElement('option');o.value=xi;
            o.textContent=(varLabel(x[1])||'Default')+(x[2]!==mn?' · '+money(x[2]):'');
            sel2.appendChild(o);
          });
          sel2.value=(BP.vsel[p.id]==null)?'':String(BP.vsel[p.id]);
          if(BP.vsel[p.id]==null)sel2.classList.add('need');
          sel2.addEventListener('change',function(){
            BP.vsel[p.id]=+this.value;
            this.classList.remove('need');
            priceTxt.textContent=priceStr(p);
            resetAdded();BE.msg.textContent='';
            refreshPrices();
          });
          body.appendChild(sel2);
        }else if(varLabel(p.vs[0][1])){
          body.appendChild(mk('span','ap-brow-var'+S,varLabel(p.vs[0][1])));
        }
        row.appendChild(body);
        var side=mk('div','ap-brow-side'+S);
        var priceTxt=mk('span','ap-brow-price'+S,priceStr(p));
        side.appendChild(priceTxt);
        var canSwap=BPCFG.swap&&((slot===0?BP.len0:BP.len1)>1);
        if(canSwap){
          var sb=mk('button','ap-swap'+S,'Swap');sb.type='button';
          sb.setAttribute('aria-label','Swap '+p.t+' for a different pick');
          sb.addEventListener('click',function(){swapSlot(slot);});
          side.appendChild(sb);
        }
        row.appendChild(side);
        BE.rows.appendChild(row);
      })(i);
    }
    updateTotals();
  }
  function priceStr(p){return(isApprox(p)?'from ':'')+money(unitPrice(p));}
  function hintText(){
    var n=pendingCount();
    if(!n)return '';
    if(n===1){for(var i=0;i<BP.mode-1;i++){var p=BP.picks[i];if(p&&!pickVar(p))return chooseLabel(p)+' to add this bundle.';}}
    return 'Choose an option for each add-on to add this bundle.';
  }
  /* Single place that decides the Add to cart button state: product variant availability AND add-on choices. */
  function syncAtc(){
    if(!atc||atc.classList.contains('ld')||atc.classList.contains('added'))return;
    var v=findVariant(),n=pendingCount();
    var hint=document.getElementById('ap-bundle-hint'+S);
    if(hint)hint.textContent=hintText();
    if(!atc.hasAttribute('data-aria0'))atc.setAttribute('data-aria0',atc.getAttribute('aria-label')||'');
    if(n>0){
      atc.disabled=true;atc.classList.add('ap-need');
      if(atcLbl)atcLbl.textContent='Choose add-on option';
      atc.setAttribute('aria-label',hintText());
      return;
    }
    atc.classList.remove('ap-need');
    atc.setAttribute('aria-label',atc.getAttribute('data-aria0'));
    if(v){
      atc.disabled=!v.available;
      if(atcLbl)atcLbl.textContent=v.available?{{ section.settings.atc_text | json }}:{{ section.settings.soldout_text | json }};
    }
  }
  function updateTotals(){
    if(!BE.total)return;
    var v=findVariant();
    if(BP.mode<2||!BP.ready||!v){BE.total.textContent='';return;}
    var one=v.price+extraCents(),q=curQty(),pre=anyApprox()?'Together from ':'Together ';
    BE.total.textContent=q>1?(pre+money(one)+'  ×  '+q+'  =  '+money(one*q)):(pre+money(one));
  }
  function openPanel(){
    if(!BE.panel||BP.mode<2||!BP.ready)return;
    BP.open=true;BE.panel.hidden=false;
  }
  function closePanel(focusPill){
    if(!BE.panel)return;
    BP.open=false;BE.panel.hidden=true;
    if(focusPill){var a=pillsWrap&&pillsWrap.querySelector('.ap-pill'+S+'.on');if(a)a.focus();}
  }
  function swapSlot(slot){
    BP.swaps[slot]=(BP.swaps[slot]||0)+1;
    sset('lexe_bp_sw:'+BPCFG.pid,JSON.stringify(BP.swaps));
    computePicks();
    resetAdded();BE.msg.textContent='';
    renderPanel();refreshPrices();
    var nb=BE.rows.querySelector('.ap-brow'+S+'[data-slot="'+slot+'"] .ap-swap'+S);
    if(nb)nb.focus();
  }
  function refreshPrices(){
    var v=findVariant();
    renderPills(v);
    updateTotals();
    if(v)renderPrice(v,curQty());
    syncAtc();
  }

  function setMode(m,fromUser){
    if(m>1&&(BP.failed||!BP.ready))return;
    if(m>1&&BP.picks.length<m-1)m=1;
    BP.mode=m;
    pillEls.forEach(function(p){
      var on=(+p.getAttribute('data-bundle')||1)===m;
      p.classList.toggle('on',on);
      p.setAttribute('aria-checked',on?'true':'false');
      p.tabIndex=on?0:-1;
    });
    resetAdded();
    if(BE.msg)BE.msg.textContent='';
    renderPanel();
    if(m>1&&fromUser)openPanel();else closePanel(false);
    refreshPrices();
  }
  function ensurePool(){
    if(BP.ready||BP.failed||BP.loading)return;
    BP.loading=true;
    loadPool(false).then(function(d){
      indexPool(d);computePicks();
      BP.ready=true;BP.loading=false;
      if(!BP.picks.length)BP.failed=true;
      refreshPrices();
      if(BP.want){var w=BP.want;BP.want=0;pillEls.forEach(function(p){p.classList.remove('ap-busy');});setMode(w,true);}
    }).catch(function(){
      BP.loading=false;BP.failed=true;BP.mode=1;
      refreshPrices();
      pillEls.forEach(function(p){p.classList.remove('ap-busy');});
      if(BP.want){BP.want=0;}
      var on=pillsWrap&&pillsWrap.querySelector('[data-bundle="1"]');if(on){on.classList.add('on');on.setAttribute('aria-checked','true');on.tabIndex=0;}
    });
  }
  /* Load once the page is idle (session-cached), or right away if a bundle pill is touched. */
  if(pillEls.some(function(p){return(+p.getAttribute('data-bundle')||1)>1;})){
    if('requestIdleCallback' in window)requestIdleCallback(ensurePool,{timeout:2500});else setTimeout(ensurePool,1200);
  }

  function renderPrice(v,q){
    if(!v)return;
    q=Math.max(1,q|0);
    var ex=extraCents();
    var inBundle=BP.mode>1&&ex>0;
    var total=(v.price+ex)*q;
    var totalCompare=(v.compare_at_price||0)*q;
    if(priceEl){
      priceEl.classList.add('flash');
      setTimeout(function(){priceEl.textContent=money(total);priceEl.classList.remove('flash');},120);
    }
    var hasDis=!inBundle&&v.compare_at_price&&v.compare_at_price>v.price;
    if(wasEl){if(hasDis){wasEl.textContent=money(totalCompare);wasEl.style.display='';}else{wasEl.style.display='none';}}
    if(badgeEl){if(hasDis){var pct=Math.round((v.compare_at_price-v.price)*100/v.compare_at_price);badgeEl.textContent='−'+pct+'%';badgeEl.style.display='';}else{badgeEl.style.display='none';}}
    if(atcPrice){
      atcPrice.classList.add('flash');
      setTimeout(function(){atcPrice.textContent=money(total);atcPrice.classList.remove('flash');},120);
    }
    var colPrice=document.getElementById('ap-col-price'+S);
    if(colPrice)colPrice.textContent=money(v.price);
    if(!renderPrice.busy){renderPrice.busy=true;renderPills(v);updateTotals();if(BP.open)syncThisPieceRow(v);renderPrice.busy=false;}
    syncAtc();
  }
  function syncThisPieceRow(v){
    var r=BE.rows&&BE.rows.querySelector('.ap-brow'+S+'.fixed');
    if(!r||!v)return;
    var pr=r.querySelector('.ap-brow-price'+S);if(pr)pr.textContent=money(v.price);
    var vl=r.querySelector('.ap-brow-var'+S);
    var lab=varLabel(v.title);
    if(vl){if(lab)vl.textContent=lab;else vl.remove();}
    else if(lab){var b=r.querySelector('.ap-brow-body'+S);if(b)b.appendChild(mk('span','ap-brow-var'+S,lab));}
  }
  function resetAdded(){
    if(!atc||!atc.classList.contains('added'))return;
    atc.classList.remove('added');atc.onclick=null;
    var v=findVariant();
    if(atcLbl&&v)atcLbl.textContent=v.available?{{ section.settings.atc_text | json }}:{{ section.settings.soldout_text | json }};
    syncAtc();
  }

  function renderStock(v){
    if(!stockEl||!SHOW_STOCK)return;
    if(v&&v.inventory_management==='shopify'&&v.inventory_quantity>0&&v.inventory_quantity<=LOW){
      stockEl.textContent='Only '+v.inventory_quantity+' left';
      stockEl.classList.add('show');
    }else{
      stockEl.classList.remove('show');
    }
  }

  /* Carousel jump to variant's featured image */
  var MEDIA_SRCS={};
  {%- for media in product.media -%}
    {%- if media.media_type == 'image' or media.media_type == nil -%}
      MEDIA_SRCS[{{ media.id | json }}]={{ forloop.index0 }};
    {%- endif -%}
  {%- endfor -%}
  function jumpToVariantImage(v){
    if(!scroller||!v||!v.featured_media)return;
    var idx=MEDIA_SRCS[v.featured_media.id];
    if(idx===undefined||idx===null)return;
    goTo(idx,true);
  }

  function updateUI(v){
    if(!v){
      if(atc)atc.disabled=true;
      if(atcLbl)atcLbl.textContent='Unavailable';
      return;
    }
    if(atc)atc.disabled=!v.available;
    var colAtc=document.querySelector('[data-col-atc]');
    if(colAtc)colAtc.disabled=!v.available;
    if(atcLbl)atcLbl.textContent=v.available?{{ section.settings.atc_text | json }}:{{ section.settings.soldout_text | json }};
    if(vid)vid.value=v.id;
    resetAdded();
    renderPrice(v,curQty());
    renderStock(v);
    jumpToVariantImage(v);
    if(history.replaceState)history.replaceState({},'','?variant='+v.id);
  }

  /* Mark unavailable variant values based on current other selections */
  function markUnavailable(){
    OPTS.forEach(function(_,optIdx){
      var oi=optIdx+1;
      $$('[data-opt="'+oi+'"] [data-vbtn]').forEach(function(b){
        var test={};
        Object.keys(sel).forEach(function(k){test[k]=sel[k];});
        test[oi]=b.dataset.val;
        var match=VARS.find(function(v){return OPTS.every(function(_,i){
          var k=i+1;
          if(k===oi)return v['option'+k]===test[k];
          return !test[k]||v['option'+k]===test[k];
        });});
        var unavail=!match||!match.available;
        b.classList.toggle('unavail',unavail);
      });
    });
  }

  function syncOptionUI(oi,val){
    $$('[data-opt="'+oi+'"] [data-vbtn]').forEach(function(b){
      var m=b.dataset.val===val;
      b.classList.toggle('on',m);
      if(b.hasAttribute('aria-checked'))b.setAttribute('aria-checked',m?'true':'false');
      if(b.hasAttribute('aria-pressed'))b.setAttribute('aria-pressed',m?'true':'false');
    });
    /* Scroll active variant into view within its own scroller (bar row) */
    var activeInBar=document.querySelector('.ap-vrow'+S+' [data-opt="'+oi+'"] [data-vbtn].on');
    if(activeInBar){
      var p=activeInBar.parentElement;
      while(p&&!p.classList.contains('ap-vrow'+S))p=p.parentElement;
      if(p){
        var pr=p.getBoundingClientRect();
        var br=activeInBar.getBoundingClientRect();
        if(br.right>pr.right||br.left<pr.left){
          p.scrollTo({left:activeInBar.offsetLeft-p.offsetWidth/2+br.width/2,behavior:'smooth'});
        }
      }
    }
  }

  function onChange(oi,val){
    sel[oi]=val;
    syncOptionUI(oi,val);
    markUnavailable();
    updateUI(findVariant());
  }

  /* Unified variant click handler (single delegated listener) */
  document.addEventListener('click',function(e){
    var b=e.target.closest('[data-vbtn]');
    if(!b||b.classList.contains('unavail'))return;
    var w=b.closest('[data-opt]');
    if(w)onChange(+w.dataset.opt,b.dataset.val);
  });

  /* ── Horizontal carousel ── */
  var slides=scroller?Array.prototype.slice.call(scroller.querySelectorAll('.ap-slide'+S)):[];
  var dots=$$('.ap-dot'+S);
  var cur=0;
  function setActiveDot(i){
    dots.forEach(function(d,k){
      d.classList.toggle('on',k===i);
      d.setAttribute('aria-selected',k===i?'true':'false');
    });
    if(prevBtn)prevBtn.disabled=(i<=0);
    if(nextBtn)nextBtn.disabled=(i>=slides.length-1);
  }
  function goTo(i,instant){
    if(!slides.length)return;
    cur=Math.max(0,Math.min(slides.length-1,i));
    var t=slides[cur];
    if(t){
      if(instant){
        scroller.scrollTo({left:t.offsetLeft,behavior:'auto'});
      }else{
        t.scrollIntoView({behavior:'smooth',block:'nearest',inline:'start'});
      }
    }
    setActiveDot(cur);
  }
  if(scroller&&COUNT>1){
    if('IntersectionObserver' in window){
      var ioCar=new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting&&en.intersectionRatio>0.55){
            cur=+en.target.dataset.index||0;
            setActiveDot(cur);
          }
        });
      },{root:scroller,threshold:[0.55,0.75]});
      slides.forEach(function(s){ioCar.observe(s);});
    }
    dots.forEach(function(d){d.addEventListener('click',function(){goTo(+this.dataset.index);});});
    if(prevBtn)prevBtn.addEventListener('click',function(){goTo(cur-1);});
    if(nextBtn)nextBtn.addEventListener('click',function(){goTo(cur+1);});
    setActiveDot(0);
  }

  /* Image fade-in on load */
  $$('.ap-slide'+S+' img').forEach(function(img){
    if(img.complete){img.classList.add('ap-loaded');}
    else{img.addEventListener('load',function(){img.classList.add('ap-loaded');},{once:true});}
  });

  /* Keyboard nav for carousel */
  if(scroller){
    scroller.addEventListener('keydown',function(e){
      if(e.key==='ArrowLeft'){e.preventDefault();goTo(cur-1);}
      else if(e.key==='ArrowRight'){e.preventDefault();goTo(cur+1);}
    });
  }

  /* ── Vault (recent viewed) ── */
  var PD={id:{{ product.id }},title:{{ product.title | json }},handle:{{ product.handle | json }},vendor:{{ product.vendor | json }},variants:VARS,images:[{% for img in product.images %}"{{ img | image_url: width: 400 }}"{% unless forloop.last %},{% endunless %}{% endfor %}]};
  function getV(){try{return JSON.parse(localStorage.getItem('apex_vault_data')||'[]');}catch(e){return[];}}
  function setV(a){try{localStorage.setItem('apex_vault_data',JSON.stringify(a));window.dispatchEvent(new Event('vault:updated'));}catch(e){}}
  function buildVI(v,li){
    var p=[];VARS.forEach(function(x){if(x.id===v.id){if(x.option1&&x.option1!=='Default Title')p.push(x.option1);if(x.option2)p.push(x.option2);if(x.option3)p.push(x.option3);}});
    return{id:v.id,title:PD.title,handle:PD.handle,vendor:PD.vendor,variant:p.length?p.join(' / '):'Default',image:(v.featured_image&&v.featured_image.src)?v.featured_image.src:(PD.images[0]||''),priceRaw:li?li.price:(v.price||0),priceStr:money(li?li.price:(v.price||0)),addedAt:Date.now()};
  }

  function toViewBag(){
    if(!atc)return;
    atc.classList.remove('ld');atc.classList.add('added');atc.disabled=false;
    var txt=atc.getAttribute('data-bag-text')||'View Bag';
    if(atcLbl)atcLbl.textContent=txt;
    var dest=atc.getAttribute('data-atc-link')||atc.getAttribute('data-bag-url')||'/cart';
    atc.onclick=function(e){e.preventDefault();window.location.href=dest;};
    if({{ section.settings.redirect_on_add | json }})window.location.href=dest;
  }

  function bundleActive(){return BP.mode>1&&BP.ready&&BP.picks.length>=BP.mode-1;}
  function fail(msg){
    if(BE.msg)BE.msg.textContent=msg;
    if(BE.panel&&BP.mode>1){BE.panel.hidden=false;BP.open=true;}
  }
  function doAdd(){
    var cv=findVariant();
    if(!cv){
      if(atc){atc.classList.add('error');setTimeout(function(){atc.classList.remove('error');},420);}
      return;
    }
    var bundle=bundleActive();
    if(bundle&&pendingCount()>0){fail(hintText());return;}
    var loadingText=atc.getAttribute('data-loading-text')||'Adding…';
    var origText=atcLbl?atcLbl.textContent:'';
    if(!bundle&&!{{ section.settings.ajax_cart | json }}){if(fsub)fsub.click();return;}
    if(atc)atc.classList.add('ld');
    if(atcLbl)atcLbl.textContent=loadingText;
    var fe=document.getElementById('{{ form_id }}');
    if(!bundle&&!fe){if(atc)atc.classList.remove('ld');return;}
    var q=curQty();
    var req;
    if(bundle){
      /* One call adds the whole bundle, q copies of every piece. All-or-nothing. */
      /* Hidden properties (underscore keys are not shown at checkout) tie the pieces of one bundle together. */
      var props={_bundle:BP.mode===2?'duo':'trio',_bundle_id:Math.random().toString(36).slice(2,8)};
      var items=[{id:cv.id,quantity:q,properties:props}];
      for(var i=0;i<BP.mode-1;i++)items.push({id:pickVar(BP.picks[i])[0],quantity:q,properties:props});
      req=fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})});
    }else{
      req=fetch('/cart/add.js',{method:'POST',body:new FormData(fe)});
    }
    req
      .then(function(r){
        if(r.ok)return r.json();
        return r.json().catch(function(){return{};}).then(function(e){var er=new Error(e.description||e.message||'add failed');er.status=r.status;throw er;});
      })
      .then(function(){return fetch('/cart.js').then(function(r){return r.json();});})
      .then(function(cart){
        document.querySelectorAll('[data-cart-count],[data-cart-bubble]').forEach(function(el){el.textContent=cart.item_count;if(el.dataset.cartCount!==undefined)el.dataset.cartCount=cart.item_count;});
        var cvid=cv.id;
        var mv=null;VARS.forEach(function(v){if(v.id===cvid)mv=v;});
        if(mv){
          var ml=null;if(cart.items)cart.items.forEach(function(i){if(i.variant_id===cvid)ml=i;});
          var vi=buildVI(mv,ml);
          var vd=getV();var idx=-1;
          vd.forEach(function(x,i){if(x.id===cvid)idx=i;});
          if(idx>-1)vd[idx]=vi;else vd.push(vi);
          setV(vd);
        }
        document.dispatchEvent(new CustomEvent('cart:item-added',{bubbles:true,detail:{cart:cart}}));
        document.dispatchEvent(new CustomEvent('cart:updated',{bubbles:true,detail:{cart:cart}}));
        /* The header cart drawer already refreshes on the events above; open it so the bundle is visible */
        var nb=document.querySelector('[data-notch-cart]');
        if(nb){try{nb.click();}catch(e){}}
        closePanel(false);
        toViewBag();
      })
      .catch(function(err){
        if(atc)atc.classList.remove('ld');
        if(atcLbl)atcLbl.textContent=origText;
        if(bundle){
          /* Nothing was added (add.js is all-or-nothing). Refresh stock data in the background. */
          fail(err&&err.status===422?'One of these pieces is not available in that quantity right now. Try Swap, another option, or a smaller quantity.':'We could not add the bundle. Please try again.');
          try{sessionStorage.removeItem('lexe_bp_pool:'+BPCFG.sources.join(','));}catch(e){}
          loadPool(true).then(function(d){indexPool(d);computePicks();if(BP.picks.length<BP.mode-1)setMode(1,false);else{renderPanel();refreshPrices();}}).catch(function(){});
        }else if(fsub)fsub.click();
      });
  }

  /* Pills choose the bundle. Quantity is independent: neither one ever changes the other. */
  function setQtyVal(n){
    n=Math.max(1,n|0);
    if(qtyIn)qtyIn.value=n;
    if(qVal)qVal.textContent=n;
    if(qDec)qDec.disabled=(n<=1);
    var v=findVariant();
    if(v)renderPrice(v,n);
    resetAdded();
  }
  function bumpQty(d){setQtyVal(curQty()+d);}
  if(qDec)qDec.addEventListener('click',function(){bumpQty(-1);});
  if(qInc)qInc.addEventListener('click',function(){bumpQty(1);});
  setQtyVal(1);

  function pickPill(p,fromKeyboard){
    var m=+p.getAttribute('data-bundle')||1;
    if(m===BP.mode){
      if(m>1&&!fromKeyboard){if(BP.open)closePanel(false);else openPanel();}
      return;
    }
    if(m>1&&!BP.ready){
      if(BP.failed)return;
      BP.want=m;p.classList.add('ap-busy');ensurePool();return;
    }
    setMode(m,true);
  }
  pillEls.forEach(function(p){
    p.addEventListener('click',function(){pickPill(this,false);});
    p.addEventListener('keydown',function(e){
      var k=e.key;
      if(k!=='ArrowRight'&&k!=='ArrowLeft'&&k!=='ArrowDown'&&k!=='ArrowUp'&&k!=='Home'&&k!=='End')return;
      var vis=pillEls.filter(function(x){return !x.hidden;});
      var i=vis.indexOf(this);if(i<0)return;
      var ni=(k==='Home')?0:(k==='End')?vis.length-1:(k==='ArrowRight'||k==='ArrowDown')?(i+1)%vis.length:(i-1+vis.length)%vis.length;
      e.preventDefault();
      vis[ni].focus();pickPill(vis[ni],true);
    });
  });
  if(BE.close)BE.close.addEventListener('click',function(){closePanel(true);});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&BP.open){closePanel(true);}});
  document.addEventListener('pointerdown',function(e){
    if(BP.open&&bar&&!bar.contains(e.target)){var cd=e.target.closest&&e.target.closest('dialog,cart-drawer-component');if(!cd)closePanel(false);}
  });

  if(atc)atc.addEventListener('click',function(){if(!this.classList.contains('added'))doAdd();});

  /* Inline accordion toggles */
  $$('[data-link-toggle]').forEach(function(t){
    t.addEventListener('click',function(){
      var id=this.getAttribute('data-link-toggle');
      var body=document.getElementById(id);
      if(!body)return;
      var isOpen=this.classList.contains('open');
      $$('[data-link-toggle]').forEach(function(o){o.classList.remove('open');o.setAttribute('aria-expanded','false');});
      $$('.ap-link-body'+S).forEach(function(b){b.classList.remove('open');});
      if(!isOpen){this.classList.add('open');this.setAttribute('aria-expanded','true');body.classList.add('open');}
    });
  });

  /* ── Footer detection (with retry) — hide bar when footer enters view ── */
  function findFooter(){
    return document.querySelector('footer.site-footer')||
           document.querySelector('footer[role="contentinfo"]')||
           document.querySelector('footer')||
           document.querySelector('[role="contentinfo"]')||
           document.querySelector('.site-footer,#site-footer,.footer,#footer,#shopify-section-footer');
  }
  var fooObs=null;
  function attachFooterObserver(){
    if(fooObs||!('IntersectionObserver' in window))return;
    var footer=findFooter();
    if(!footer)return false;
    fooObs=new IntersectionObserver(function(entries){
      entries.forEach(function(en){bar&&bar.classList.toggle('hide',en.isIntersecting);});
    },{threshold:0.01});
    fooObs.observe(footer);
    return true;
  }
  /* Retry several times in case footer is rendered after section script runs */
  if(!attachFooterObserver()){
    var tries=0,maxTries=10;
    var iv=setInterval(function(){
      tries++;
      if(attachFooterObserver()||tries>=maxTries)clearInterval(iv);
    },300);
  }

  /* ── Dynamic bar height: keep --bar-h in sync with actual rendered bar ──
     rAF-batched so resize/orientation events don't force multiple synchronous
     layout reads per frame. */
  var syncRAF=null;
  function syncBarHeight(){
    if(syncRAF)return;
    syncRAF=requestAnimationFrame(function(){
      syncRAF=null;
      if(!bar)return;
      var h=bar.offsetHeight;
      if(h>20){
        root.style.setProperty('--bar-h',h+'px');
        bar.style.setProperty('--bar-h',h+'px');
      }
    });
  }
  syncBarHeight();
  if('ResizeObserver' in window){
    var ro=new ResizeObserver(syncBarHeight);
    ro.observe(bar);
  }else{
    window.addEventListener('resize',syncBarHeight,{passive:true});
  }

  /* Initial state for unavailable marking */
  markUnavailable();

  /* Initial vault entry on view (low priority, fire after a tick) */
  setTimeout(function(){
    var v=findVariant();if(!v)return;
    var vi=buildVI(v,null);
    var vd=getV();var idx=-1;
    vd.forEach(function(x,i){if(x.id===v.id)idx=i;});
    if(idx<0){vd.push(vi);setV(vd);}
  },800);

  /* ── Optional free-pair claim (separate from Add to cart; specs-atc-restore 2026-10-07) ──
     Enabled only when the bag already holds enough eligible items (sections/lexe-gift-check data-cents >= this gift's min).
     Adds qty 1 with _lexe_gift=1 + LEXESPECS. Cart guard (lexe-gift-normalize) still removes it if the bag drops under. */
  (function(){
    var box=document.getElementById('ap-claim'+S);
    if(!box)return;
    var btn=document.getElementById('ap-claim-btn'+S),hint=document.getElementById('ap-claim-hint'+S);
    var em=document.getElementById('ap-claim-email'+S),err=document.getElementById('ap-claim-err'+S);
    var need=parseInt(box.getAttribute('data-lx-min'),10)||0,base=hint?hint.textContent:'',ok=false,busy=false;
    function showErr(t){if(err){err.style.display=t?'block':'none';err.textContent=t||'';}}
    function check(){
      return fetch('/?sections=lexe-gift-check&t='+Date.now(),{credentials:'same-origin',cache:'no-store'})
        .then(function(r){return r.json();})
        .then(function(d){
          var m=/data-cents="(-?\d+)"/.exec((d&&d['lexe-gift-check'])||'');
          var have=m?parseInt(m[1],10):0;
          ok=need>0&&have>=need;
          if(btn&&!busy)btn.disabled=!ok;
          if(hint)hint.textContent=ok?'Your bag qualifies. Claim this pair free (one per order).':base+(have>0?' Add '+money(need-have)+' more of eligible items to unlock.':'');
          return ok;
        }).catch(function(){ok=false;if(btn)btn.disabled=true;return false;});
    }
    check().then(function(q){if(!q)setTimeout(check,1500);});
    if(em)em.addEventListener('focus',function(){if(!ok)check();});
    window.addEventListener('pageshow',function(e){if(e.persisted)check();});
    document.addEventListener('cart:updated',function(){setTimeout(check,300);});
    document.addEventListener('cart:item-added',function(){setTimeout(check,300);});
    if(btn)btn.addEventListener('click',function(){
      var cv=findVariant();
      var email=(em&&em.value||'').trim();
      if(!cv)return;
      if(!email||email.indexOf('@')<1){showErr('Enter a valid email to claim.');if(em)em.focus();return;}
      showErr('');busy=true;btn.classList.add('ld');var t0=btn.textContent;btn.textContent='Claiming…';
      check().then(function(q){
        if(!q)throw new Error('Add more eligible items to your bag first.');
        return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
          body:JSON.stringify({items:[{id:cv.id,quantity:1,properties:{_lexe_gift:'1',_lexe_claim_email:email}}]})})
          .then(function(r){return r.json().then(function(j){return{ok:r.ok,j:j};});});
      }).then(function(res){
        if(!res.ok)throw new Error((res.j&&res.j.description)||'Could not claim');
        return fetch('/cart/update.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({discount:'LEXESPECS'})}).catch(function(){return null;});
      }).then(function(){return fetch('/cart.js').then(function(r){return r.json();});})
      .then(function(cart){
        busy=false;btn.classList.remove('ld');btn.textContent=t0;
        document.dispatchEvent(new CustomEvent('cart:updated',{bubbles:true,detail:{cart:cart}}));
        var nb=document.querySelector('[data-notch-cart]');
        if(nb){try{nb.click();}catch(e){}}else window.location='/cart';
      }).catch(function(e){
        busy=false;btn.classList.remove('ld');btn.textContent=t0;showErr(e.message||'Could not claim');check();
      });
    });
  })();
})();
</script>

