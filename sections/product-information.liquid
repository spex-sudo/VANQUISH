{%- comment -%}
  PDP blocks (2026-10-08): every element in the left and right info columns is a section block.
  Each block has a "Column" setting (left / right). On mobile the left column stacks above the right one.
  The sticky bar below is unchanged; the column variant boxes use the same [data-opt] [data-vbtn] markup, so the
  existing variant / price / bundle script drives both. The inline buy button only forwards to the sticky Add to cart.
{%- endcomment -%}
{%- liquid
  assign blk_left = ''
  assign blk_right = ''
  assign has_size_target = false
  for block in section.blocks
    if block.type == 'size_guide_drawer'
      assign has_size_target = true
    elsif block.settings.is_size_guide == true
      assign has_size_target = true
    endif
  endfor
-%}
{%- for block in section.blocks -%}
  {%- liquid
    assign bcol = block.settings.column
    if bcol == blank
      case block.type
        when 'back', 'title', 'bullet', 'highlight', 'narrative', 'tagline', 'description'
          assign bcol = 'left'
        else
          assign bcol = 'right'
      endcase
    endif
    assign acc_render = false
    assign acc_heading = ''
    assign acc_html = ''
    assign acc_img = nil
    assign acc_link = ''
    assign acc_open = false
    assign acc_size = false
  -%}
  {%- capture bh -%}
    {%- case block.type -%}

      {%- when 'back' -%}
        {%- assign b_url = block.settings.url | default: back_url -%}
        {%- assign b_lbl = block.settings.label | default: back_label -%}
        {%- if b_url != blank -%}
          <a class="ap-back{{ sid }} ap-blk{{ sid }}" href="{{ b_url }}" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            <span>{{ b_lbl }}</span>
          </a>
        {%- endif -%}

      {%- when 'title' -%}
        {%- if block.settings.eyebrow != blank -%}<p class="ap-eyebrow{{ sid }}" {{ block.shopify_attributes }}>{{ block.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="ap-name{{ sid }}" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

      {%- when 'bullet', 'highlight' -%}
        {%- if block.settings.label != blank -%}<p class="ap-bul{{ sid }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</p>{%- endif -%}

      {%- when 'narrative', 'tagline' -%}
        {%- if block.settings.text != blank -%}<div class="ap-narrative{{ sid }} ap-blk{{ sid }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{%- endif -%}

      {%- when 'description' -%}
        {%- if product.description != blank -%}
          <div class="ap-desc{{ sid }} ap-blk{{ sid }}" {{ block.shopify_attributes }}>{{ product.description | replace: '<img ', '<img decoding="async" fetchpriority="low" ' }}</div>
        {%- endif -%}

      {%- when 'price' -%}
        <div class="ap-price-row{{ sid }} ap-blk{{ sid }}" {{ block.shopify_attributes }}>
          <span class="ap-price{{ sid }}" id="ap-price{{ sid }}">{{ current_variant.price | money_without_trailing_zeros }}</span>
          <span class="ap-was{{ sid }}" id="ap-was{{ sid }}"{% unless has_discount %} style="display:none"{% endunless %}>{% if has_discount %}{{ current_variant.compare_at_price | money_without_trailing_zeros }}{% endif %}</span>
          <span class="ap-badge{{ sid }}" id="ap-badge{{ sid }}"{% unless has_discount %} style="display:none"{% endunless %}>{% if has_discount %}−{{ discount_pct }}%{% endif %}</span>
        </div>

      {%- when 'stock' -%}
        <div class="ap-stock{{ sid }}{% if is_low_stock %} show{% endif %}" id="ap-stock{{ sid }}" data-low="{{ low_stock_at }}" {{ block.shopify_attributes }}>
          {% if is_low_stock %}Only {{ inv }} left{% endif %}
        </div>

      {%- when 'note' -%}
        {%- if block.settings.text != blank -%}<div class="ap-note{{ sid }} ap-blk{{ sid }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{%- endif -%}

      {%- when 'text' -%}
        {%- if block.settings.text != blank -%}<div class="ap-text{{ sid }} ap-text-{{ block.settings.style }}{{ sid }} ap-blk{{ sid }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{%- endif -%}

      {%- when 'variant_picker' -%}
        {%- unless product.has_only_default_variant -%}
          <div class="ap-vp{{ sid }} ap-blk{{ sid }}" {{ block.shopify_attributes }}>
            {%- for option in product.options_with_values -%}
              {%- assign odn = option.name | downcase -%}
              {%- if odn == 'title' -%}{%- continue -%}{%- endif -%}
              {%- assign oi = forloop.index -%}
              {%- assign is_color = false -%}
              {%- if odn == 'color' or odn == 'colour' or odn contains 'color' or odn contains 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
              {%- assign cstyle = block.settings.color_style | default: 'image' -%}
              {%- assign one_val = false -%}{%- if option.values.size == 1 and block.settings.hide_single -%}{%- assign one_val = true -%}{%- endif -%}
              {%- assign is_long = false -%}
              {%- for val in option.values -%}{%- assign vstr = val | append: '' -%}{%- if vstr.size > 6 -%}{%- assign is_long = true -%}{%- endif -%}{%- endfor -%}
              <div class="ap-vp-grp{{ sid }}{% if is_long %} ap-vp-long{{ sid }}{% endif %}"{% if one_val %} hidden{% endif %}>
                <div class="ap-vp-head{{ sid }}">
                  <span class="ap-vp-lbl{{ sid }}" id="ap-vpl-{{ block.id }}-{{ oi }}">{{ option.name }}{%- if block.settings.show_selected -%}<span class="ap-vp-val{{ sid }}" data-vp-val="{{ oi }}">{{ option.selected_value }}</span>{%- endif -%}</span>
                  {%- if has_size_target and block.settings.size_link_label != blank and odn contains 'size' -%}
                    <button type="button" class="ap-vp-sg{{ sid }}" data-ap-open-size>{{ block.settings.size_link_label }}</button>
                  {%- endif -%}
                </div>
                <div class="ap-vp-opts{{ sid }}" data-opt="{{ oi }}" role="radiogroup" aria-labelledby="ap-vpl-{{ block.id }}-{{ oi }}">
                  {%- for val in option.values -%}
                    {%- liquid
                      assign is_on = false
                      if option.selected_value == val
                        assign is_on = true
                      endif
                      assign sw_img = nil
                      assign sw_col = nil
                      if is_color and cstyle != 'text'
                        if val.swatch.image
                          assign sw_img = val.swatch.image
                        elsif val.swatch.color
                          assign sw_col = val.swatch.color
                        elsif cstyle == 'image' and val.variant.featured_image
                          assign sw_img = val.variant.featured_image
                        elsif cstyle == 'color'
                          assign sw_col = val | handle
                        endif
                      endif
                    -%}
                    <button type="button" data-vbtn role="radio"
                      class="ap-vb{{ sid }}{% if sw_img or sw_col %} ap-vb-sw{{ sid }}{% endif %}{% if is_on %} on{% endif %}{% unless val.available %} unavail{% endunless %}"
                      data-val="{{ val | escape }}" aria-checked="{{ is_on }}" tabindex="{% if is_on %}0{% else %}-1{% endif %}"
                      {% unless val.available %}aria-disabled="true"{% endunless %}
                      {% if sw_img or sw_col %}aria-label="{{ val | escape }}" title="{{ val | escape }}"{% endif %}>
                      {%- if sw_img -%}
                        <img src="{{ sw_img | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy" decoding="async">
                      {%- elsif sw_col -%}
                        <span class="ap-vb-dot{{ sid }}" style="background:{{ sw_col }}"></span>
                      {%- else -%}
                        {{ val | escape }}
                      {%- endif -%}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

      {%- when 'buy' -%}
        <div class="ap-buy{{ sid }} ap-blk{{ sid }}{% if block.settings.show_qty %} has-q{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.show_qty -%}
            <div class="ap-bq{{ sid }}" role="group" aria-label="Quantity">
              <button type="button" data-ap-q="-1" aria-label="Decrease quantity" disabled>−</button>
              <span data-ap-qv aria-live="polite">1</span>
              <button type="button" data-ap-q="1" aria-label="Increase quantity">+</button>
            </div>
          {%- endif -%}
          <button type="button" class="ap-buy-btn{{ sid }}{% if block.settings.style == 'accent' %} acc{% endif %}" data-ap-buy {% unless current_variant.available %}disabled{% endunless %}>
            <span class="ap-buy-lbl{{ sid }}" data-ap-buy-lbl>{%- if current_variant.available -%}{{ section.settings.atc_text }}{%- else -%}{{ section.settings.soldout_text }}{%- endif -%}</span>
            {%- if block.settings.show_price -%}<span class="ap-buy-price{{ sid }}" data-ap-buy-price>{{ current_variant.price | money_without_trailing_zeros }}</span>{%- endif -%}
          </button>
        </div>

      {%- when 'claim' -%}
        {%- if lx_pdp_gift -%}
          {%- assign lx_pdp_min_dollars = lx_pdp_min | divided_by: 100 -%}
          <div class="ap-claim{{ sid }} ap-blk{{ sid }}" id="ap-claim{{ sid }}" data-lx-min="{{ lx_pdp_min }}" {{ block.shopify_attributes }}>
            <p class="ap-claim-ttl{{ sid }}">Or get this pair FREE</p>
            <p class="ap-claim-hint{{ sid }}" id="ap-claim-hint{{ sid }}">Free with ${{ lx_pdp_min_dollars }}+ of eligible items in your bag (one free pair per order). Buying it on its own? Use Add to cart.</p>
            <label class="visually-hidden" for="ap-claim-email{{ sid }}">Email</label>
            <input type="email" id="ap-claim-email{{ sid }}" name="lx_claim_email" placeholder="Email to claim" autocomplete="email">
            <button type="button" class="ap-claim-btn{{ sid }}" id="ap-claim-btn{{ sid }}" disabled>Claim free</button>
            <p class="ap-claim-err{{ sid }}" id="ap-claim-err{{ sid }}" role="alert"></p>
          </div>
        {%- endif -%}

      {%- when 'trust' -%}
        {%- if block.settings.item_1 != blank or block.settings.item_2 != blank or block.settings.item_3 != blank -%}
          <ul class="ap-tr{{ sid }} ap-blk{{ sid }}" {{ block.shopify_attributes }}>
            {%- for n in (1..3) -%}
              {%- assign t_k = 'item_' | append: n -%}{%- assign i_k = 'icon_' | append: n -%}
              {%- assign t_txt = block.settings[t_k] -%}{%- assign t_ic = block.settings[i_k] -%}
              {%- if t_txt != blank -%}
                <li>
                  {%- case t_ic -%}
                    {%- when 'truck' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>
                    {%- when 'return' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9"/><polyline points="3 4 3 12 11 12"/></svg>
                    {%- when 'shield' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z"/></svg>
                    {%- when 'box' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg>
                    {%- else -%}
                  {%- endcase -%}
                  <span>{{ t_txt }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

      {%- when 'custom_liquid' -%}
        {%- if block.settings.custom_liquid != blank -%}<div class="ap-cl{{ sid }} ap-blk{{ sid }}" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>{%- endif -%}

      {%- when 'spec_row' -%}
        {%- if block.settings.label != blank and block.settings.value != blank -%}
          <div class="ap-spec{{ sid }}" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><span>{{ block.settings.value }}</span></div>
        {%- endif -%}

      {%- when 'collapsible' -%}
        {%- liquid
          assign acc_render = true
          assign acc_heading = block.settings.heading
          assign acc_img = block.settings.image
          assign acc_link = block.settings.link_url
          assign acc_open = block.settings.open
          assign acc_size = block.settings.is_size_guide
          case block.settings.source
            when 'description'
              assign acc_html = product.description | replace: '<img ', '<img decoding="async" fetchpriority="low" '
            when 'page'
              assign acc_html = block.settings.page.content
            when 'metafield'
              assign mf_parts = block.settings.metafield_key | strip | split: '.'
              if mf_parts.size == 2
                assign mf = product.metafields[mf_parts[0]][mf_parts[1]]
                if mf != blank
                  assign acc_html = mf | metafield_tag
                endif
              endif
            else
              assign acc_html = block.settings.content
          endcase
        -%}
      {%- when 'size_guide_drawer', 'shipping' -%}
        {%- liquid
          assign acc_render = true
          if block.type == 'shipping'
            assign acc_heading = block.settings.title | default: 'Shipping & Returns'
          else
            assign acc_heading = block.settings.title | default: 'Size Guide'
            assign acc_size = true
          endif
          assign acc_html = block.settings.content
          assign acc_img = block.settings.image
          assign acc_link = block.settings.redirect_url
        -%}
      {%- when 'details', 'material', 'care' -%}
        {%- liquid
          assign acc_render = true
          case block.type
            when 'details'
              assign acc_heading = 'Details'
            when 'material'
              assign acc_heading = 'Composition'
            else
              assign acc_heading = 'Care'
          endcase
          assign acc_html = block.settings.content
        -%}
      {%- when 'accordion' -%}
        {%- assign acc_render = true -%}{%- assign acc_heading = block.settings.title -%}{%- assign acc_html = block.settings.content -%}
      {%- when 'size_fit' -%}
        {%- liquid
          assign acc_render = true
          assign acc_heading = 'Size & Fit'
          assign acc_html = block.settings.content
          if block.settings.model_note != blank
            assign acc_html = acc_html | append: '<p>' | append: block.settings.model_note | append: '</p>'
          endif
        -%}
      {%- else -%}
    {%- endcase -%}

    {%- if acc_render and acc_heading != blank -%}
      {%- assign acc_has = false -%}
      {%- if acc_html != blank or acc_img != blank -%}{%- assign acc_has = true -%}{%- endif -%}
      {%- if acc_link != blank -%}
        <div class="ap-acc{{ sid }}"{% if acc_size %} data-kind="size"{% endif %} {{ block.shopify_attributes }}>
          <a class="ap-acc-btn{{ sid }}" href="{{ acc_link }}"><span>{{ acc_heading }}</span><svg class="ap-acc-arr{{ sid }}" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4"/></svg></a>
        </div>
      {%- elsif acc_has -%}
        <div class="ap-acc{{ sid }}"{% if acc_size %} data-kind="size"{% endif %} data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
          <h2 class="ap-acc-h{{ sid }}">
            <button type="button" class="ap-acc-btn{{ sid }}" id="ap-acb-{{ block.id }}" data-ap-acc aria-expanded="{{ acc_open }}" aria-controls="ap-acp-{{ block.id }}">
              <span>{{ acc_heading }}</span>
              <svg class="ap-acc-car{{ sid }}" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5h10L6 7z"/></svg>
            </button>
          </h2>
          <div class="ap-acc-p{{ sid }}{% if acc_open %} open{% endif %}" id="ap-acp-{{ block.id }}" role="region" aria-labelledby="ap-acb-{{ block.id }}"{% unless acc_open %} inert{% endunless %}>
            <div class="ap-acc-in{{ sid }}"><div class="ap-acc-body{{ sid }}">
              {%- if acc_img != blank -%}<img src="{{ acc_img | image_url: width: 800 }}" width="400" height="{{ 400 | divided_by: acc_img.aspect_ratio | ceil }}" alt="{{ acc_heading | escape }}" loading="lazy" decoding="async">{%- endif -%}
              {{ acc_html }}
            </div></div>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endcapture -%}
  {%- liquid
    if bcol == 'left'
      assign blk_left = blk_left | append: bh
    else
      assign blk_right = blk_right | append: bh
    endif
  -%}
{%- endfor -%}

<div id="ap{{ sid }}" class="ap-v2{{ sid }}" style="padding-top:var(--top)" data-product-id="{{ product.id }}">
  <div class="ap-grid{{ sid }}">

    <!-- LEFT (blocks with Column = Left) -->
    <div class="ap-left{{ sid }}">
      <div class="ap-left-body{{ sid }}">
        <div class="ap-col{{ sid }} ap-col-l{{ sid }}">{{ blk_left }}</div>
      </div>
    </div>

    <!-- CENTER -->
    <div class="ap-center{{ sid }}">
      {%- if media_count > 0 -%}
        <div class="ap-scroll{{ sid }}" id="ap-scroll{{ sid }}" aria-roledescription="carousel" aria-label="Product images">
          {%- for media in product.media -%}
            <div class="ap-slide{{ sid }}" data-index="{{ forloop.index0 }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ media_count }}">
              {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1400 }}"
                  width="1400"
                  height="{{ 1400 | divided_by: media.aspect_ratio | ceil }}"
                  srcset="{{ media | image_url: width: 600 }} 600w,{{ media | image_url: width: 1000 }} 1000w,{{ media | image_url: width: 1400 }} 1400w"
                  sizes="(max-width:640px) 100vw, 44vw"
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high" decoding="sync"{% else %}decoding="async"{% endif %}
                  draggable="false">
              {%- when 'video' -%}
                {%- assign vsrc = media.sources | where: "format","mp4" | first -%}
                <video src="{{ vsrc.url | default: media.sources.first.url }}"
                  poster="{{ media.preview_image | image_url: width: 1200 }}"
                  muted loop playsinline autoplay preload="none"
                  style="width:88%;height:88%;object-fit:contain;display:block;"></video>
              {%- else -%}
                <img src="{{ media.preview_image | image_url: width: 1000 }}"
                  width="1000" height="{{ 1000 | divided_by: media.preview_image.aspect_ratio | ceil }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="lazy" draggable="false" decoding="async">
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if media_count > 1 -%}
          <button class="ap-arr{{ sid }} p" id="ap-prev{{ sid }}" aria-label="Previous image" type="button"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></button>
          <button class="ap-arr{{ sid }} n" id="ap-next{{ sid }}" aria-label="Next image" type="button"><svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg></button>
          <div class="ap-dots{{ sid }}" id="ap-dots{{ sid }}" role="tablist" aria-label="Image navigation">
            {%- for media in product.media -%}
              <button class="ap-dot{{ sid }}{% if forloop.first %} on{% endif %}"
                data-index="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_brand_overlay and brand_display != blank or section.settings.show_brand_overlay and section.settings.brand_logo != blank -%}
          <div class="ap-brand{{ sid }}" aria-hidden="true">
            {%- if brand_display != blank -%}
              <span class="ap-brand-name{{ sid }}">{{ brand_display }}</span>
            {%- endif -%}
            {%- if section.settings.brand_logo != blank -%}
              {%- if brand_display != blank -%}
                <span class="ap-brand-sep{{ sid }}"></span>
              {%- endif -%}
              <img class="ap-brand-logo{{ sid }}"
                src="{{ section.settings.brand_logo | image_url: width: 300 }}"
                alt="{{ shop.name | escape }}"
                loading="lazy"
                decoding="async"
                width="150"
                height="{{ section.settings.brand_logo_height | default: 22 }}">
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- else -%}
        <div class="ap-empty{{ sid }}">No images</div>
      {%- endif -%}
    </div>

    <!-- RIGHT (blocks with Column = Right) -->
    <div class="ap-right{{ sid }}">
      <div class="ap-right-body{{ sid }}">
        <div class="ap-col{{ sid }} ap-col-r{{ sid }}">{{ blk_right }}</div>
        {%- comment -%} Product form: always rendered (no visible fields). The sticky bar's single add posts this form. {%- endcomment -%}
        {%- form 'product', product, id: form_id, novalidate: 'novalidate', class: 'ap-pf' -%}
          <input type="hidden" name="id" id="ap-vid{{ sid }}" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="ap-qty{{ sid }}" value="1">
          <input type="submit" id="ap-fsub{{ sid }}" style="display:none" tabindex="-1" aria-hidden="true">
        {%- endform -%}
      </div>
    </div>

  </div>
</div>

<!-- STICKY BAR — portal'd to <body> on init -->
<div class="ap-bar{{ sid }}" id="ap-bar{{ sid }}" data-section="{{ sid }}" role="region" aria-label="Add to cart">
  {%- if show_pill -%}
  <div class="ap-bundle{{ sid }}" id="ap-bundle{{ sid }}" role="region" aria-label="Your bundle" hidden>
    <div class="ap-bundle-inner{{ sid }}">
      <div class="ap-bundle-head{{ sid }}">
        <div class="ap-bundle-ttl{{ sid }}">
          <strong id="ap-bundle-title{{ sid }}">Your bundle</strong>
          <span id="ap-bundle-sub{{ sid }}"></span>
        </div>
        <button type="button" class="ap-bundle-x{{ sid }}" id="ap-bundle-x{{ sid }}" aria-label="Close bundle details">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
        </button>
      </div>
      <div class="ap-bundle-rows{{ sid }}" id="ap-bundle-rows{{ sid }}"></div>
      <div class="ap-bundle-foot{{ sid }}">
        <span class="ap-bundle-total{{ sid }}" id="ap-bundle-total{{ sid }}"></span>
        <span class="ap-bundle-hint{{ sid }}" id="ap-bundle-hint{{ sid }}" aria-live="polite"></span>
        <span class="ap-bundle-msg{{ sid }}" id="ap-bundle-msg{{ sid }}" role="status" aria-live="polite"></span>
      </div>
    </div>
  </div>
  {%- endif -%}
  <div class="ap-bar-inner{{ sid }}">

    {%- if section.settings.show_trust_strip -%}
      <div class="ap-trust{{ sid }} on">
        {%- if section.settings.trust_1 != blank -%}
          <span class="ap-trust-item{{ sid }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h13l-1 12H4L3 7z"/><path d="M14 7l5 4h2v8h-3"/></svg>
            {{ section.settings.trust_1 }}
          </span>
        {%- endif -%}
        {%- if section.settings.trust_2 != blank -%}
          <span class="ap-trust-item{{ sid }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9"/><polyline points="3 4 3 12 11 12"/></svg>
            {{ section.settings.trust_2 }}
          </span>
        {%- endif -%}
        {%- if section.settings.trust_3 != blank -%}
          <span class="ap-trust-item{{ sid }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z"/></svg>
            {{ section.settings.trust_3 }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_pill -%}
      <div class="ap-pills{{ sid }}" id="ap-pills{{ sid }}" role="radiogroup" aria-label="Bundle options">
        <button type="button" class="ap-pill{{ sid }} on" data-bundle="1" role="radio" aria-checked="true" tabindex="0">
          <div class="ap-pill-img{{ sid }}">
            {%- if pill_thumb != blank -%}<img src="{{ pill_thumb }}" alt="" loading="lazy" decoding="async" width="42" height="42">{%- endif -%}
          </div>
          <div class="ap-pill-info{{ sid }}">
            <span class="ap-pill-label{{ sid }}">{{ section.settings.single_label | default: 'Single' }}</span>
            <span class="ap-pill-sub{{ sid }}">
              {%- if single_save > 0 -%}You save {{ single_save | money_without_trailing_zeros }}{%- else -%}{{ section.settings.single_sublabel }}{%- endif -%}
            </span>
          </div>
          <div class="ap-pill-price{{ sid }}">
            <span class="ap-pill-now{{ sid }}" data-bp-price>{{ single_price | money_without_trailing_zeros }}</span>
            <span class="ap-pill-was{{ sid }}" data-bp-was{% unless single_compare > single_price %} style="display:none"{% endunless %}>{{ single_compare | money_without_trailing_zeros }}</span>
          </div>
        </button>

        {%- if duo_visible -%}
          <button type="button" class="ap-pill{{ sid }} ap-bpill{{ sid }}" data-bundle="2" role="radio" aria-checked="false" aria-controls="ap-bundle{{ sid }}" tabindex="-1">
            {%- if section.settings.duo_ribbon != blank -%}<span class="ap-pill-ribbon{{ sid }}">{{ section.settings.duo_ribbon }}</span>{%- endif -%}
            <div class="ap-pill-img{{ sid }} ap-pill-imgs{{ sid }}" data-thumbs="2">
              <span class="ap-th{{ sid }}">{%- if pill_thumb != blank -%}<img src="{{ pill_thumb }}" alt="" loading="lazy" decoding="async" width="34" height="34">{%- endif -%}</span>
              <span class="ap-th{{ sid }} ap-sk{{ sid }}"></span>
            </div>
            <div class="ap-pill-info{{ sid }}">
              <span class="ap-pill-label{{ sid }}">{{ section.settings.duo_label | default: 'Duo' }}</span>
              <span class="ap-pill-sub{{ sid }}" data-bp-sub>Finding a match</span>
            </div>
            <div class="ap-pill-price{{ sid }}">
              <span class="ap-pill-now{{ sid }}" data-bp-price><i class="ap-dots{{ sid }}">···</i></span>
            </div>
          </button>
        {%- endif -%}

        {%- if triple_visible -%}
          <button type="button" class="ap-pill{{ sid }} ap-bpill{{ sid }}" data-bundle="3" role="radio" aria-checked="false" aria-controls="ap-bundle{{ sid }}" tabindex="-1">
            {%- if section.settings.triple_ribbon != blank -%}<span class="ap-pill-ribbon{{ sid }}">{{ section.settings.triple_ribbon }}</span>{%- endif -%}
            <div class="ap-pill-img{{ sid }} ap-pill-imgs{{ sid }}" data-thumbs="3">
              <span class="ap-th{{ sid }}">{%- if pill_thumb != blank -%}<img src="{{ pill_thumb }}" alt="" loading="lazy" decoding="async" width="34" height="34">{%- endif -%}</span>
              <span class="ap-th{{ sid }} ap-sk{{ sid }}"></span>
              <span class="ap-th{{ sid }} ap-sk{{ sid }}"></span>
            </div>
            <div class="ap-pill-info{{ sid }}">
              <span class="ap-pill-label{{ sid }}">{{ section.settings.triple_label | default: 'Trio' }}</span>
              <span class="ap-pill-sub{{ sid }}" data-bp-sub>Finding matches</span>
            </div>
            <div class="ap-pill-price{{ sid }}">
              <span class="ap-pill-now{{ sid }}" data-bp-price><i class="ap-dots{{ sid }}">···</i></span>
            </div>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- unless product.has_only_default_variant -%}
      <div class="ap-vrow{{ sid }}" id="ap-vrow{{ sid }}">
        {%- for option in product.options_with_values -%}
          {%- assign odn = option.name | downcase -%}
          {%- unless odn == 'title' -%}
            <div class="ap-vgroup{{ sid }}" data-opt="{{ forloop.index }}" aria-label="{{ option.name }}">
              <span class="ap-vlabel{{ sid }}">{{ option.name }}</span>
              {%- if odn == 'color' or odn == 'colour' -%}
                {%- for val in option.values -%}
                  <button type="button" data-vbtn
                    class="ap-vsw{{ sid }}{% if option.selected_value == val %} on{% endif %}"
                    data-val="{{ val }}" title="{{ val }}" aria-label="{{ val }}"
                    style="background:{{ val | handle }};"></button>
                {%- endfor -%}
              {%- else -%}
                {%- for val in option.values -%}
                  <button type="button" data-vbtn
                    class="ap-vsize{{ sid }}{% if option.selected_value == val %} on{% endif %}"
                    data-val="{{ val }}"
                    aria-pressed="{% if option.selected_value == val %}true{% else %}false{% endif %}">{{ val }}</button>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <div class="ap-arow{{ sid }}">
      <div class="ap-qty{{ sid }}" role="group" aria-label="Quantity">
        <button type="button" id="ap-qty-dec{{ sid }}" aria-label="Decrease quantity">−</button>
        <span id="ap-qty-val{{ sid }}" aria-live="polite">1</span>
        <button type="button" id="ap-qty-inc{{ sid }}" aria-label="Increase quantity">+</button>
      </div>
      <button class="ap-atc{{ sid }}" id="ap-atc{{ sid }}"
        data-bag-url="{{ section.settings.view_bag_url | default: '/cart' }}"
        data-bag-text="{{ section.settings.view_bag_text | default: 'View Bag' }}"
        data-atc-link="{{ section.settings.atc_link | default: '' }}"
        data-loading-text="{{ section.settings.loading_text | default: 'Adding…' }}"
        {% unless current_variant.available %}disabled{% endunless %}
        aria-label="Add {{ product.title | escape }} to cart"
        type="button">
        <svg class="ap-atc-bag{{ sid }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
                <span id="ap-atc-lbl{{ sid }}">{%- if current_variant.available -%}{{ section.settings.atc_text }}{%- else -%}{{ section.settings.soldout_text }}{%- endif -%}</span>
        <span class="ap-atc-sep{{ sid }}" aria-hidden="true">·</span>
        <span class="ap-atc-price{{ sid }}" id="ap-atc-price{{ sid }}">{{ current_variant.price | money_without_trailing_zeros }}</span>
        <svg class="_sp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
        </svg>
      </button>
    </div>

  </div>
</div>

<script type="application/ld+json">
{%- liquid
  assign ld_desc = page_description | default: product.description | strip_html | strip_newlines | truncate: 500
  assign ld_cur = cart.currency.iso_code
  assign ld_material = blank
  assign ld_desc_l = ld_desc | downcase
  if product.tags contains 'Faux Leather'
    assign ld_material = 'Faux leather (PU)'
  elsif ld_desc_l contains 'faux leather' or ld_desc_l contains 'faux-leather'
    assign ld_material = 'Faux leather'
  elsif ld_desc_l contains 'pu leather' or ld_desc_l contains 'fabric: pu' or ld_desc_l contains 'material: pu' or ld_desc_l contains ' artificial pu' or ld_desc_l contains 'fabric:pu'
    assign ld_material = 'Faux leather (PU)'
  elsif product.type == 'Sunglasses' or product.tags contains 'Specs'
    assign ld_material = blank
  endif
-%}
{"@context":"https://schema.org/","@type":"Product","@id":{{ request.origin | append: product.url | append: '#product' | json }},"name":{{ product.title | json }},"description":{{ ld_desc | json }},"url":{{ request.origin | append: product.url | json }},"sku":{{ product.selected_or_first_available_variant.sku | default: product.id | json }},"brand":{"@type":"Brand","name":"LEXE"},{% if product.type != blank %}"category":{{ product.type | json }},{% endif %}{% if ld_material != blank %}"material":{{ ld_material | json }},{% endif %}"image":[{% for img in product.images limit: 10 %}"https:{{ img | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}{% endfor %}],"offers":[{% for v in product.variants limit: 100 %}{"@type":"Offer","url":{{ request.origin | append: product.url | append: '?variant=' | append: v.id | json }},"priceCurrency":{{ ld_cur | json }},"price":"{{ v.price | divided_by: 100.0 }}","availability":"{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}","itemCondition":"https://schema.org/NewCondition"{% if v.sku != blank %},"sku":{{ v.sku | json }}{% endif %},"seller":{"@type":"Organization","@id":{{ request.origin | append: '/#organization' | json }},"name":"Devici Studios"}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
</script>

<script>
(function(){
  'use strict';
  var S='{{ sid }}';
  var VARS={{ product.variants | json }};
  var OPTS={{ product.options | json }};
  var SYM={{ cart.currency.symbol | json }};
  var COUNT={{ media_count }};
  var LOW={{ low_stock_at | default: 5 }};
  var SHOW_STOCK={{ section.settings.show_stock | json }};
  var sel={};
  var root=document.getElementById('ap'+S);
  if(!root)return;

  /* ── PORTAL bar to <body> (escape transform / overflow ancestors) ── */
  var bar=document.getElementById('ap-bar'+S);
  if(bar&&bar.parentNode!==document.body){
    document.body.appendChild(bar);
  }

  var priceEl=document.getElementById('ap-price'+S);
  var wasEl=document.getElementById('ap-was'+S);
  var badgeEl=document.getElementById('ap-badge'+S);
  var stockEl=document.getElementById('ap-stock'+S);
  var atc=document.getElementById('ap-atc'+S);
  var atcLbl=document.getElementById('ap-atc-lbl'+S);
  var atcPrice=document.getElementById('ap-atc-price'+S);
  var vid=document.getElementById('ap-vid'+S);
  var qtyIn=document.getElementById('ap-qty'+S);
  var qDec=document.getElementById('ap-qty-dec'+S);
  var qInc=document.getElementById('ap-qty-inc'+S);
  var qVal=document.getElementById('ap-qty-val'+S);
  var fsub=document.getElementById('ap-fsub'+S);
  var pillsWrap=document.getElementById('ap-pills'+S);
  var pillEls=pillsWrap?Array.prototype.slice.call(pillsWrap.querySelectorAll('.ap-pill'+S)):[];
  var scroller=document.getElementById('ap-scroll'+S);
  var prevBtn=document.getElementById('ap-prev'+S);
  var nextBtn=document.getElementById('ap-next'+S);

  function $$(q){return Array.prototype.slice.call(document.querySelectorAll(q));}

  /* Init selection state */
  OPTS.forEach(function(_,i){
    var oi=i+1;
    var anyBtn=document.querySelector('[data-opt="'+oi+'"] [data-vbtn].on');
    sel[oi]=anyBtn?anyBtn.dataset.val:'';
  });

  function findVariant(s){
    s=s||sel;
    return VARS.find(function(v){return OPTS.every(function(_,i){return v['option'+(i+1)]===s[i+1];});});
  }
  function money(c){return SYM+(c/100).toFixed(2).replace(/\.00$/,'').replace(/\B(?=(\d{3})+(?!\d))/g,',');}
  function curQty(){return qtyIn?Math.max(1,parseInt(qtyIn.value,10)||1):1;}

  /* ══ LEXE bundle pills ══
     Single / Duo / Trio choose WHAT is bought. Quantity is separate and multiplies the whole selection.
     Duo = this product + 1 add-on, Trio = this product + 2 add-ons. Add-ons come from other collections
     (see section setting "Bundle add-on source collections"). No bundle discount is applied or shown. */
  var BPCFG={sources:{{ bp_sources | split: ',' | json }},cur:{{ bp_cur_cols | split: ',' | json }},pid:{{ product.id }},price:{{ current_variant.price | default: 0 }},needCost:{{ section.settings.bundle_require_cost | json }},swap:{{ section.settings.bundle_swap | json }},thumb:{{ pill_thumb | json }},labels:{2:{{ section.settings.duo_label | default: 'Duo' | json }},3:{{ section.settings.triple_label | default: 'Trio' | json }} }};
  var BP={mode:1,ready:false,failed:false,loading:false,byId:{},colItems:{},picks:[],swaps:[0,0],vsel:{},open:false};
  var memSeed=null;
  function sget(k){try{return sessionStorage.getItem(k);}catch(e){return null;}}
  function sset(k,v){try{sessionStorage.setItem(k,v);}catch(e){}}
  function bpSeed(){
    var s=sget('lexe_bp_seed');
    if(!s){s=memSeed||String(Math.random()).slice(2,10);memSeed=s;sset('lexe_bp_seed',s);}
    return s;
  }
  function bpHash(str){var h=2166136261;for(var i=0;i<str.length;i++){h^=str.charCodeAt(i);h=Math.imul(h,16777619);}return h>>>0;}
  function bpRng(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
  function bpShuffle(arr,r){var a=arr.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(r()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}
  try{var sw=JSON.parse(sget('lexe_bp_sw:'+BPCFG.pid)||'null');if(sw&&sw.length===2)BP.swaps=[sw[0]|0,sw[1]|0];}catch(e){}

  function bpEls(){
    return{
      panel:document.getElementById('ap-bundle'+S),rows:document.getElementById('ap-bundle-rows'+S),
      title:document.getElementById('ap-bundle-title'+S),sub:document.getElementById('ap-bundle-sub'+S),
      total:document.getElementById('ap-bundle-total'+S),msg:document.getElementById('ap-bundle-msg'+S),
      close:document.getElementById('ap-bundle-x'+S)
    };
  }
  var BE=bpEls();

  function loadPool(force){
    var key='lexe_bp_pool:'+BPCFG.sources.join(',');
    if(!force){
      try{var c=JSON.parse(sget(key)||'null');if(c&&c.d&&Date.now()-c.t<1800000)return Promise.resolve(c.d);}catch(e){}
    }
    return fetch('/search?view=lexe-bundle&q='+encodeURIComponent(BPCFG.sources.join(',')),{credentials:'same-origin'})
      .then(function(r){if(!r.ok)throw 0;return r.json();})
      .then(function(d){
        if(!d||!d.p||!d.p.length)throw 0;
        sset(key,JSON.stringify({t:Date.now(),d:d}));
        return d;
      });
  }
  function indexPool(d){
    BP.byId={};BP.colItems={};
    d.p.forEach(function(p){p.cols=[];BP.byId[p.id]=p;});
    Object.keys(d.m).forEach(function(c){
      BP.colItems[c]=[];
      d.m[c].forEach(function(id){var p=BP.byId[id];if(p){p.cols.push(c);BP.colItems[c].push(p);}});
    });
  }
  function eligible(p){
    if(p.id===BPCFG.pid||!p.vs||!p.vs.length||!p.cols.length)return false;
    if(BPCFG.needCost&&!p.co)return false;
    return true;
  }
  function overlapsCur(p){
    for(var i=0;i<p.cols.length;i++){if(BPCFG.cur.indexOf(p.cols[i])>-1)return true;}
    return false;
  }
  /* Seeded round-robin across the source collections (so each gets a turn). Inside a collection, items priced
     about 0.5x to 2x of this product come first when at least 3 fit; otherwise the whole collection is used. */
  function roundRobin(items,r){
    var cols=bpShuffle(Object.keys(BP.colItems),r);
    var lists=cols.map(function(c){
      var all=items.filter(function(p){return p.cols.indexOf(c)>-1;});
      if(BPCFG.price>0){
        var band=all.filter(function(p){var m=minPrice(p);return m>=BPCFG.price*0.5&&m<=BPCFG.price*2;});
        if(band.length>=3)all=band;
      }
      return bpShuffle(all,r);
    }).filter(function(l){return l.length;});
    var out=[],seen={},i=0,more=true;
    while(more){
      more=false;
      for(var j=0;j<lists.length;j++){
        if(i<lists[j].length){more=true;var p=lists[j][i];if(!seen[p.id]){seen[p.id]=1;out.push(p);}}
      }
      i++;
    }
    return out;
  }
  /* Tier A = items outside the current product's own collection(s); tier B = same collection, never the product itself. */
  function orderFor(k){
    var r=bpRng(bpHash(bpSeed()+':'+BPCFG.pid+':'+k));
    var pool=Object.keys(BP.byId).map(function(id){return BP.byId[id];}).filter(eligible);
    var A=pool.filter(function(p){return !overlapsCur(p);}),B=pool.filter(overlapsCur);
    return{a:roundRobin(A,r),b:roundRobin(B,r)};
  }
  function computePicks(){
    var o0=orderFor(0),l0=o0.a.concat(o0.b);
    if(!l0.length){BP.picks=[];BP.len0=0;BP.len1=0;return;}
    var p0=l0[BP.swaps[0]%l0.length];
    var o1=orderFor(1);
    var disj=function(p){return !p.cols.some(function(c){return p0.cols.indexOf(c)>-1;});};
    var notDisj=function(p){return !disj(p);};
    var a1=o1.a.filter(function(p){return p.id!==p0.id;}),b1=o1.b.filter(function(p){return p.id!==p0.id;});
    /* Second add-on: other collection than the current product first, and a different collection than the first add-on when possible. */
    var l1=a1.filter(disj).concat(a1.filter(notDisj),b1.filter(disj),b1.filter(notDisj));
    var p1=l1.length?l1[BP.swaps[1]%l1.length]:null;
    BP.len0=l0.length;BP.len1=l1.length;
    BP.picks=p1?[p0,p1]:[p0];
  }
  /* Add-ons with several in-stock variants (phone model, size, colour) are never preselected. */
  function isMulti(p){return p.vs.length>1;}
  function pickVar(p){
    if(isMulti(p)){var i=BP.vsel[p.id];return(i==null)?null:p.vs[i];}
    return p.vs[0];
  }
  function minPrice(p){var m=Infinity;p.vs.forEach(function(x){if(x[2]<m)m=x[2];});return m;}
  function maxPrice(p){var m=0;p.vs.forEach(function(x){if(x[2]>m)m=x[2];});return m;}
  function unitPrice(p){var v=pickVar(p);return v?v[2]:minPrice(p);}
  function isApprox(p){return !pickVar(p)&&minPrice(p)!==maxPrice(p);}
  function pendingCount(){
    if(BP.mode<2||!BP.ready)return 0;
    var n=0;
    for(var i=0;i<BP.mode-1&&i<BP.picks.length;i++){if(!pickVar(BP.picks[i]))n++;}
    return n;
  }
  function chooseLabel(p){
    var names=(p.o||[]).join(' ').toLowerCase();
    var parts=[];
    if(p.ty==='Phone Case'&&(/model|型号/.test(names)))parts.push('phone model');
    else{
      if(/size/.test(names))parts.push('size');
      if(/colou?r/.test(names))parts.push('color');
      if(/material|style/.test(names))parts.push('style');
      if(!parts.length)parts.push('option');
    }
    return 'Choose your '+parts.join(' / ');
  }
  function extraCents(){
    var n=BP.mode-1,t=0;
    if(BP.mode<2||BP.picks.length<n)return 0;
    for(var i=0;i<n;i++)t+=unitPrice(BP.picks[i]);
    return t;
  }
  function anyApprox(){
    for(var i=0;i<BP.mode-1&&i<BP.picks.length;i++){if(isApprox(BP.picks[i]))return true;}
    return false;
  }
  function shortName(t){return String(t||'');}

  /* Render pills (prices, thumbs, sub-labels). Qty never enters the pill prices. */
  function renderPills(v){
    pillEls.forEach(function(p){
      var b=+p.getAttribute('data-bundle')||1;
      var priceEl2=p.querySelector('[data-bp-price]');
      if(b===1){
        if(v&&priceEl2)priceEl2.textContent=money(v.price);
        var w=p.querySelector('[data-bp-was]');
        if(w&&v){if(v.compare_at_price&&v.compare_at_price>v.price){w.textContent=money(v.compare_at_price);w.style.display='';}else w.style.display='none';}
        return;
      }
      var need=b-1;
      if(BP.failed||(BP.ready&&BP.picks.length<need)){p.hidden=true;return;}
      p.hidden=false;
      if(!BP.ready||!v)return;
      var sum=v.price,apx=false;
      for(var i=0;i<need;i++){sum+=unitPrice(BP.picks[i]);if(isApprox(BP.picks[i]))apx=true;}
      if(priceEl2)priceEl2.textContent=(apx?'from ':'')+money(sum);
      var names=[];
      for(var k=0;k<need;k++)names.push(shortName(BP.picks[k].t));
      var sub=p.querySelector('[data-bp-sub]');
      if(sub)sub.textContent='+ '+names.join(' & ');
      var ths=p.querySelectorAll('.ap-th'+S);
      for(var m=1;m<ths.length;m++){
        var pk=BP.picks[m-1];if(!pk)continue;
        var th=ths[m];th.classList.remove('ap-sk'+S);
        var im=th.querySelector('img');
        if(!im){im=document.createElement('img');im.alt='';im.width=34;im.height=34;im.loading='lazy';im.decoding='async';th.appendChild(im);}
        if(im.getAttribute('src')!==pk.i)im.setAttribute('src',pk.i);
      }
    });
  }

  /* Panel */
  function mk(tag,cls,txt){var e=document.createElement(tag);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e;}
  function varLabel(t){return(t&&t!=='Default Title')?t:'';}
  function renderPanel(){
    if(!BE.panel)return;
    BE.rows.textContent='';
    if(BP.mode<2||!BP.ready){return;}
    var v=findVariant();
    BE.title.textContent=BPCFG.labels[BP.mode]?BPCFG.labels[BP.mode]+' bundle':'Bundle';
    BE.sub.textContent=BP.mode===2?'This piece plus one suggested add-on from another part of LEXE.':'This piece plus two suggested add-ons from other parts of LEXE.';
    /* this piece (fixed) */
    var r0=mk('div','ap-brow'+S+' fixed');
    var i0=mk('div','ap-brow-img'+S);
    if(BPCFG.thumb){var im0=document.createElement('img');im0.src=BPCFG.thumb;im0.alt='';im0.width=54;im0.height=54;im0.loading='lazy';i0.appendChild(im0);}
    r0.appendChild(i0);
    var b0=mk('div','ap-brow-body'+S);
    b0.appendChild(mk('span','ap-brow-tag'+S,'This piece'));
    b0.appendChild(mk('span','ap-brow-name'+S,PD.title));
    if(v&&varLabel(v.title))b0.appendChild(mk('span','ap-brow-var'+S,varLabel(v.title)));
    r0.appendChild(b0);
    var s0=mk('div','ap-brow-side'+S);
    s0.appendChild(mk('span','ap-brow-price'+S,v?money(v.price):''));
    r0.appendChild(s0);
    BE.rows.appendChild(r0);
    /* add-ons */
    for(var i=0;i<BP.mode-1;i++){
      (function(slot){
        var p=BP.picks[slot];
        var row=mk('div','ap-brow'+S);row.setAttribute('data-slot',slot);
        var im=mk('div','ap-brow-img'+S);
        var ie=document.createElement('img');ie.src=p.i;ie.alt='';ie.width=54;ie.height=54;ie.loading='lazy';im.appendChild(ie);
        row.appendChild(im);
        var body=mk('div','ap-brow-body'+S);
        body.appendChild(mk('span','ap-brow-tag'+S,'Suggested add-on'));
        body.appendChild(mk('span','ap-brow-name'+S,p.t));
        if(isMulti(p)){
          var sel2=document.createElement('select');
          sel2.setAttribute('aria-label',chooseLabel(p)+' for '+p.t);
          sel2.setAttribute('data-needs','1');
          var ph=document.createElement('option');ph.value='';ph.disabled=true;ph.textContent=chooseLabel(p);sel2.appendChild(ph);
          var mn=minPrice(p);
          p.vs.forEach(function(x,xi){
            var o=document.createElement('option');o.value=xi;
            o.textContent=(varLabel(x[1])||'Default')+(x[2]!==mn?' · '+money(x[2]):'');
            sel2.appendChild(o);
          });
          sel2.value=(BP.vsel[p.id]==null)?'':String(BP.vsel[p.id]);
          if(BP.vsel[p.id]==null)sel2.classList.add('need');
          sel2.addEventListener('change',function(){
            BP.vsel[p.id]=+this.value;
            this.classList.remove('need');
            priceTxt.textContent=priceStr(p);
            resetAdded();BE.msg.textContent='';
            refreshPrices();
          });
          body.appendChild(sel2);
        }else if(varLabel(p.vs[0][1])){
          body.appendChild(mk('span','ap-brow-var'+S,varLabel(p.vs[0][1])));
        }
        row.appendChild(body);
        var side=mk('div','ap-brow-side'+S);
        var priceTxt=mk('span','ap-brow-price'+S,priceStr(p));
        side.appendChild(priceTxt);
        var canSwap=BPCFG.swap&&((slot===0?BP.len0:BP.len1)>1);
        if(canSwap){
          var sb=mk('button','ap-swap'+S,'Swap');sb.type='button';
          sb.setAttribute('aria-label','Swap '+p.t+' for a different pick');
          sb.addEventListener('click',function(){swapSlot(slot);});
          side.appendChild(sb);
        }
        row.appendChild(side);
        BE.rows.appendChild(row);
      })(i);
    }
    updateTotals();
  }
  function priceStr(p){return(isApprox(p)?'from ':'')+money(unitPrice(p));}
  function hintText(){
    var n=pendingCount();
    if(!n)return '';
    if(n===1){for(var i=0;i<BP.mode-1;i++){var p=BP.picks[i];if(p&&!pickVar(p))return chooseLabel(p)+' to add this bundle.';}}
    return 'Choose an option for each add-on to add this bundle.';
  }
  /* Single place that decides the Add to cart button state: product variant availability AND add-on choices. */
  function syncAtc(){
    if(!atc||atc.classList.contains('ld')||atc.classList.contains('added'))return;
    var v=findVariant(),n=pendingCount();
    var hint=document.getElementById('ap-bundle-hint'+S);
    if(hint)hint.textContent=hintText();
    if(!atc.hasAttribute('data-aria0'))atc.setAttribute('data-aria0',atc.getAttribute('aria-label')||'');
    if(n>0){
      atc.disabled=true;atc.classList.add('ap-need');
      if(atcLbl)atcLbl.textContent='Choose add-on option';
      atc.setAttribute('aria-label',hintText());
      return;
    }
    atc.classList.remove('ap-need');
    atc.setAttribute('aria-label',atc.getAttribute('data-aria0'));
    if(v){
      atc.disabled=!v.available;
      if(atcLbl)atcLbl.textContent=v.available?{{ section.settings.atc_text | json }}:{{ section.settings.soldout_text | json }};
    }
  }
  function updateTotals(){
    if(!BE.total)return;
    var v=findVariant();
    if(BP.mode<2||!BP.ready||!v){BE.total.textContent='';return;}
    var one=v.price+extraCents(),q=curQty(),pre=anyApprox()?'Together from ':'Together ';
    BE.total.textContent=q>1?(pre+money(one)+'  ×  '+q+'  =  '+money(one*q)):(pre+money(one));
  }
  function openPanel(){
    if(!BE.panel||BP.mode<2||!BP.ready)return;
    BP.open=true;BE.panel.hidden=false;
  }
  function closePanel(focusPill){
    if(!BE.panel)return;
    BP.open=false;BE.panel.hidden=true;
    if(focusPill){var a=pillsWrap&&pillsWrap.querySelector('.ap-pill'+S+'.on');if(a)a.focus();}
  }
  function swapSlot(slot){
    BP.swaps[slot]=(BP.swaps[slot]||0)+1;
    sset('lexe_bp_sw:'+BPCFG.pid,JSON.stringify(BP.swaps));
    computePicks();
    resetAdded();BE.msg.textContent='';
    renderPanel();refreshPrices();
    var nb=BE.rows.querySelector('.ap-brow'+S+'[data-slot="'+slot+'"] .ap-swap'+S);
    if(nb)nb.focus();
  }
  function refreshPrices(){
    var v=findVariant();
    renderPills(v);
    updateTotals();
    if(v)renderPrice(v,curQty());
    syncAtc();
  }

  function setMode(m,fromUser){
    if(m>1&&(BP.failed||!BP.ready))return;
    if(m>1&&BP.picks.length<m-1)m=1;
    BP.mode=m;
    pillEls.forEach(function(p){
      var on=(+p.getAttribute('data-bundle')||1)===m;
      p.classList.toggle('on',on);
      p.setAttribute('aria-checked',on?'true':'false');
      p.tabIndex=on?0:-1;
    });
    resetAdded();
    if(BE.msg)BE.msg.textContent='';
    renderPanel();
    if(m>1&&fromUser)openPanel();else closePanel(false);
    refreshPrices();
  }
  function ensurePool(){
    if(BP.ready||BP.failed||BP.loading)return;
    BP.loading=true;
    loadPool(false).then(function(d){
      indexPool(d);computePicks();
      BP.ready=true;BP.loading=false;
      if(!BP.picks.length)BP.failed=true;
      refreshPrices();
      if(BP.want){var w=BP.want;BP.want=0;pillEls.forEach(function(p){p.classList.remove('ap-busy');});setMode(w,true);}
    }).catch(function(){
      BP.loading=false;BP.failed=true;BP.mode=1;
      refreshPrices();
      pillEls.forEach(function(p){p.classList.remove('ap-busy');});
      if(BP.want){BP.want=0;}
      var on=pillsWrap&&pillsWrap.querySelector('[data-bundle="1"]');if(on){on.classList.add('on');on.setAttribute('aria-checked','true');on.tabIndex=0;}
    });
  }
  /* Load once the page is idle (session-cached), or right away if a bundle pill is touched. */
  if(pillEls.some(function(p){return(+p.getAttribute('data-bundle')||1)>1;})){
    if('requestIdleCallback' in window)requestIdleCallback(ensurePool,{timeout:2500});else setTimeout(ensurePool,1200);
  }

  function renderPrice(v,q){
    if(!v)return;
    q=Math.max(1,q|0);
    var ex=extraCents();
    var inBundle=BP.mode>1&&ex>0;
    var total=(v.price+ex)*q;
    var totalCompare=(v.compare_at_price||0)*q;
    if(priceEl){
      priceEl.classList.add('flash');
      setTimeout(function(){priceEl.textContent=money(total);priceEl.classList.remove('flash');},120);
    }
    var hasDis=!inBundle&&v.compare_at_price&&v.compare_at_price>v.price;
    if(wasEl){if(hasDis){wasEl.textContent=money(totalCompare);wasEl.style.display='';}else{wasEl.style.display='none';}}
    if(badgeEl){if(hasDis){var pct=Math.round((v.compare_at_price-v.price)*100/v.compare_at_price);badgeEl.textContent='−'+pct+'%';badgeEl.style.display='';}else{badgeEl.style.display='none';}}
    if(atcPrice){
      atcPrice.classList.add('flash');
      setTimeout(function(){atcPrice.textContent=money(total);atcPrice.classList.remove('flash');},120);
    }
    if(!renderPrice.busy){renderPrice.busy=true;renderPills(v);updateTotals();if(BP.open)syncThisPieceRow(v);renderPrice.busy=false;}
    syncAtc();
  }
  function syncThisPieceRow(v){
    var r=BE.rows&&BE.rows.querySelector('.ap-brow'+S+'.fixed');
    if(!r||!v)return;
    var pr=r.querySelector('.ap-brow-price'+S);if(pr)pr.textContent=money(v.price);
    var vl=r.querySelector('.ap-brow-var'+S);
    var lab=varLabel(v.title);
    if(vl){if(lab)vl.textContent=lab;else vl.remove();}
    else if(lab){var b=r.querySelector('.ap-brow-body'+S);if(b)b.appendChild(mk('span','ap-brow-var'+S,lab));}
  }
  function resetAdded(){
    if(!atc||!atc.classList.contains('added'))return;
    atc.classList.remove('added');atc.onclick=null;
    var v=findVariant();
    if(atcLbl&&v)atcLbl.textContent=v.available?{{ section.settings.atc_text | json }}:{{ section.settings.soldout_text | json }};
    syncAtc();
  }

  function renderStock(v){
    if(!stockEl||!SHOW_STOCK)return;
    if(v&&v.inventory_management==='shopify'&&v.inventory_quantity>0&&v.inventory_quantity<=LOW){
      stockEl.textContent='Only '+v.inventory_quantity+' left';
      stockEl.classList.add('show');
    }else{
      stockEl.classList.remove('show');
    }
  }

  /* Carousel jump to variant's featured image */
  var MEDIA_SRCS={};
  {%- for media in product.media -%}
    {%- if media.media_type == 'image' or media.media_type == nil -%}
      MEDIA_SRCS[{{ media.id | json }}]={{ forloop.index0 }};
    {%- endif -%}
  {%- endfor -%}
  function jumpToVariantImage(v){
    if(!scroller||!v||!v.featured_media)return;
    var idx=MEDIA_SRCS[v.featured_media.id];
    if(idx===undefined||idx===null)return;
    goTo(idx,true);
  }

  function updateUI(v){
    if(!v){
      if(atc)atc.disabled=true;
      if(atcLbl)atcLbl.textContent='Unavailable';
      return;
    }
    if(atc)atc.disabled=!v.available;
    if(atcLbl)atcLbl.textContent=v.available?{{ section.settings.atc_text | json }}:{{ section.settings.soldout_text | json }};
    if(vid)vid.value=v.id;
    resetAdded();
    renderPrice(v,curQty());
    renderStock(v);
    jumpToVariantImage(v);
    if(history.replaceState)history.replaceState({},'','?variant='+v.id);
  }

  /* Mark unavailable variant values based on current other selections */
  function markUnavailable(){
    OPTS.forEach(function(_,optIdx){
      var oi=optIdx+1;
      $$('[data-opt="'+oi+'"] [data-vbtn]').forEach(function(b){
        var test={};
        Object.keys(sel).forEach(function(k){test[k]=sel[k];});
        test[oi]=b.dataset.val;
        var match=VARS.find(function(v){return OPTS.every(function(_,i){
          var k=i+1;
          if(k===oi)return v['option'+k]===test[k];
          return !test[k]||v['option'+k]===test[k];
        });});
        var unavail=!match||!match.available;
        b.classList.toggle('unavail',unavail);
      });
    });
  }

  function syncOptionUI(oi,val){
    $$('[data-opt="'+oi+'"] [data-vbtn]').forEach(function(b){
      var m=b.dataset.val===val;
      b.classList.toggle('on',m);
      if(b.hasAttribute('aria-checked'))b.setAttribute('aria-checked',m?'true':'false');
      if(b.hasAttribute('aria-pressed'))b.setAttribute('aria-pressed',m?'true':'false');
    });
    /* Scroll active variant into view within its own scroller (bar row) */
    var activeInBar=document.querySelector('.ap-vrow'+S+' [data-opt="'+oi+'"] [data-vbtn].on');
    if(activeInBar){
      var p=activeInBar.parentElement;
      while(p&&!p.classList.contains('ap-vrow'+S))p=p.parentElement;
      if(p){
        var pr=p.getBoundingClientRect();
        var br=activeInBar.getBoundingClientRect();
        if(br.right>pr.right||br.left<pr.left){
          p.scrollTo({left:activeInBar.offsetLeft-p.offsetWidth/2+br.width/2,behavior:'smooth'});
        }
      }
    }
  }

  function onChange(oi,val){
    sel[oi]=val;
    syncOptionUI(oi,val);
    markUnavailable();
    updateUI(findVariant());
  }

  /* Unified variant click handler (single delegated listener) */
  document.addEventListener('click',function(e){
    var b=e.target.closest('[data-vbtn]');
    if(!b||b.classList.contains('unavail'))return;
    var w=b.closest('[data-opt]');
    if(w)onChange(+w.dataset.opt,b.dataset.val);
  });

  /* ── Horizontal carousel ── */
  var slides=scroller?Array.prototype.slice.call(scroller.querySelectorAll('.ap-slide'+S)):[];
  var dots=$$('.ap-dot'+S);
  var cur=0;
  function setActiveDot(i){
    dots.forEach(function(d,k){
      d.classList.toggle('on',k===i);
      d.setAttribute('aria-selected',k===i?'true':'false');
    });
    if(prevBtn)prevBtn.disabled=(i<=0);
    if(nextBtn)nextBtn.disabled=(i>=slides.length-1);
  }
  function goTo(i,instant){
    if(!slides.length)return;
    cur=Math.max(0,Math.min(slides.length-1,i));
    var t=slides[cur];
    if(t){
      if(instant){
        scroller.scrollTo({left:t.offsetLeft,behavior:'auto'});
      }else{
        t.scrollIntoView({behavior:'smooth',block:'nearest',inline:'start'});
      }
    }
    setActiveDot(cur);
  }
  if(scroller&&COUNT>1){
    if('IntersectionObserver' in window){
      var ioCar=new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting&&en.intersectionRatio>0.55){
            cur=+en.target.dataset.index||0;
            setActiveDot(cur);
          }
        });
      },{root:scroller,threshold:[0.55,0.75]});
      slides.forEach(function(s){ioCar.observe(s);});
    }
    dots.forEach(function(d){d.addEventListener('click',function(){goTo(+this.dataset.index);});});
    if(prevBtn)prevBtn.addEventListener('click',function(){goTo(cur-1);});
    if(nextBtn)nextBtn.addEventListener('click',function(){goTo(cur+1);});
    setActiveDot(0);
  }

  /* Image fade-in on load */
  $$('.ap-slide'+S+' img').forEach(function(img){
    if(img.complete){img.classList.add('ap-loaded');}
    else{img.addEventListener('load',function(){img.classList.add('ap-loaded');},{once:true});}
  });

  /* Keyboard nav for carousel */
  if(scroller){
    scroller.addEventListener('keydown',function(e){
      if(e.key==='ArrowLeft'){e.preventDefault();goTo(cur-1);}
      else if(e.key==='ArrowRight'){e.preventDefault();goTo(cur+1);}
    });
  }

  /* ── Vault (recent viewed) ── */
  var PD={id:{{ product.id }},title:{{ product.title | json }},handle:{{ product.handle | json }},vendor:{{ product.vendor | json }},variants:VARS,images:[{% for img in product.images %}"{{ img | image_url: width: 400 }}"{% unless forloop.last %},{% endunless %}{% endfor %}]};
  function getV(){try{return JSON.parse(localStorage.getItem('apex_vault_data')||'[]');}catch(e){return[];}}
  function setV(a){try{localStorage.setItem('apex_vault_data',JSON.stringify(a));window.dispatchEvent(new Event('vault:updated'));}catch(e){}}
  function buildVI(v,li){
    var p=[];VARS.forEach(function(x){if(x.id===v.id){if(x.option1&&x.option1!=='Default Title')p.push(x.option1);if(x.option2)p.push(x.option2);if(x.option3)p.push(x.option3);}});
    return{id:v.id,title:PD.title,handle:PD.handle,vendor:PD.vendor,variant:p.length?p.join(' / '):'Default',image:(v.featured_image&&v.featured_image.src)?v.featured_image.src:(PD.images[0]||''),priceRaw:li?li.price:(v.price||0),priceStr:money(li?li.price:(v.price||0)),addedAt:Date.now()};
  }

  function toViewBag(){
    if(!atc)return;
    atc.classList.remove('ld');atc.classList.add('added');atc.disabled=false;
    var txt=atc.getAttribute('data-bag-text')||'View Bag';
    if(atcLbl)atcLbl.textContent=txt;
    var dest=atc.getAttribute('data-atc-link')||atc.getAttribute('data-bag-url')||'/cart';
    atc.onclick=function(e){e.preventDefault();window.location.href=dest;};
    if({{ section.settings.redirect_on_add | json }})window.location.href=dest;
  }

  function bundleActive(){return BP.mode>1&&BP.ready&&BP.picks.length>=BP.mode-1;}
  function fail(msg){
    if(BE.msg)BE.msg.textContent=msg;
    if(BE.panel&&BP.mode>1){BE.panel.hidden=false;BP.open=true;}
  }
  function doAdd(){
    var cv=findVariant();
    if(!cv){
      if(atc){atc.classList.add('error');setTimeout(function(){atc.classList.remove('error');},420);}
      return;
    }
    var bundle=bundleActive();
    if(bundle&&pendingCount()>0){fail(hintText());return;}
    var loadingText=atc.getAttribute('data-loading-text')||'Adding…';
    var origText=atcLbl?atcLbl.textContent:'';
    if(!bundle&&!{{ section.settings.ajax_cart | json }}){if(fsub)fsub.click();return;}
    if(atc)atc.classList.add('ld');
    if(atcLbl)atcLbl.textContent=loadingText;
    var fe=document.getElementById('{{ form_id }}');
    if(!bundle&&!fe){if(atc)atc.classList.remove('ld');return;}
    var q=curQty();
    var req;
    if(bundle){
      /* One call adds the whole bundle, q copies of every piece. All-or-nothing. */
      /* Hidden properties (underscore keys are not shown at checkout) tie the pieces of one bundle together. */
      var props={_bundle:BP.mode===2?'duo':'trio',_bundle_id:Math.random().toString(36).slice(2,8)};
      var items=[{id:cv.id,quantity:q,properties:props}];
      for(var i=0;i<BP.mode-1;i++)items.push({id:pickVar(BP.picks[i])[0],quantity:q,properties:props});
      req=fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})});
    }else{
      req=fetch('/cart/add.js',{method:'POST',body:new FormData(fe)});
    }
    req
      .then(function(r){
        if(r.ok)return r.json();
        return r.json().catch(function(){return{};}).then(function(e){var er=new Error(e.description||e.message||'add failed');er.status=r.status;throw er;});
      })
      .then(function(){return fetch('/cart.js').then(function(r){return r.json();});})
      .then(function(cart){
        document.querySelectorAll('[data-cart-count],[data-cart-bubble]').forEach(function(el){el.textContent=cart.item_count;if(el.dataset.cartCount!==undefined)el.dataset.cartCount=cart.item_count;});
        var cvid=cv.id;
        var mv=null;VARS.forEach(function(v){if(v.id===cvid)mv=v;});
        if(mv){
          var ml=null;if(cart.items)cart.items.forEach(function(i){if(i.variant_id===cvid)ml=i;});
          var vi=buildVI(mv,ml);
          var vd=getV();var idx=-1;
          vd.forEach(function(x,i){if(x.id===cvid)idx=i;});
          if(idx>-1)vd[idx]=vi;else vd.push(vi);
          setV(vd);
        }
        document.dispatchEvent(new CustomEvent('cart:item-added',{bubbles:true,detail:{cart:cart}}));
        document.dispatchEvent(new CustomEvent('cart:updated',{bubbles:true,detail:{cart:cart}}));
        /* The header cart drawer already refreshes on the events above; open it so the bundle is visible */
        var nb=document.querySelector('[data-notch-cart]');
        if(nb){try{nb.click();}catch(e){}}
        closePanel(false);
        toViewBag();
      })
      .catch(function(err){
        if(atc)atc.classList.remove('ld');
        if(atcLbl)atcLbl.textContent=origText;
        if(bundle){
          /* Nothing was added (add.js is all-or-nothing). Refresh stock data in the background. */
          fail(err&&err.status===422?'One of these pieces is not available in that quantity right now. Try Swap, another option, or a smaller quantity.':'We could not add the bundle. Please try again.');
          try{sessionStorage.removeItem('lexe_bp_pool:'+BPCFG.sources.join(','));}catch(e){}
          loadPool(true).then(function(d){indexPool(d);computePicks();if(BP.picks.length<BP.mode-1)setMode(1,false);else{renderPanel();refreshPrices();}}).catch(function(){});
        }else if(fsub)fsub.click();
      });
  }

  /* Pills choose the bundle. Quantity is independent: neither one ever changes the other. */
  function setQtyVal(n){
    n=Math.max(1,n|0);
    if(qtyIn)qtyIn.value=n;
    if(qVal)qVal.textContent=n;
    if(qDec)qDec.disabled=(n<=1);
    var v=findVariant();
    if(v)renderPrice(v,n);
    resetAdded();
  }
  function bumpQty(d){setQtyVal(curQty()+d);}
  if(qDec)qDec.addEventListener('click',function(){bumpQty(-1);});
  if(qInc)qInc.addEventListener('click',function(){bumpQty(1);});
  setQtyVal(1);

  function pickPill(p,fromKeyboard){
    var m=+p.getAttribute('data-bundle')||1;
    if(m===BP.mode){
      if(m>1&&!fromKeyboard){if(BP.open)closePanel(false);else openPanel();}
      return;
    }
    if(m>1&&!BP.ready){
      if(BP.failed)return;
      BP.want=m;p.classList.add('ap-busy');ensurePool();return;
    }
    setMode(m,true);
  }
  pillEls.forEach(function(p){
    p.addEventListener('click',function(){pickPill(this,false);});
    p.addEventListener('keydown',function(e){
      var k=e.key;
      if(k!=='ArrowRight'&&k!=='ArrowLeft'&&k!=='ArrowDown'&&k!=='ArrowUp'&&k!=='Home'&&k!=='End')return;
      var vis=pillEls.filter(function(x){return !x.hidden;});
      var i=vis.indexOf(this);if(i<0)return;
      var ni=(k==='Home')?0:(k==='End')?vis.length-1:(k==='ArrowRight'||k==='ArrowDown')?(i+1)%vis.length:(i-1+vis.length)%vis.length;
      e.preventDefault();
      vis[ni].focus();pickPill(vis[ni],true);
    });
  });
  if(BE.close)BE.close.addEventListener('click',function(){closePanel(true);});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&BP.open){closePanel(true);}});
  document.addEventListener('pointerdown',function(e){
    if(BP.open&&bar&&!bar.contains(e.target)){var cd=e.target.closest&&e.target.closest('dialog,cart-drawer-component');if(!cd)closePanel(false);}
  });

  if(atc)atc.addEventListener('click',function(){if(!this.classList.contains('added'))doAdd();});

  /* Inline accordion toggles */
  $$('[data-link-toggle]').forEach(function(t){
    t.addEventListener('click',function(){
      var id=this.getAttribute('data-link-toggle');
      var body=document.getElementById(id);
      if(!body)return;
      var isOpen=this.classList.contains('open');
      $$('[data-link-toggle]').forEach(function(o){o.classList.remove('open');o.setAttribute('aria-expanded','false');});
      $$('.ap-link-body'+S).forEach(function(b){b.classList.remove('open');});
      if(!isOpen){this.classList.add('open');this.setAttribute('aria-expanded','true');body.classList.add('open');}
    });
  });

  /* ── Footer detection (with retry) — hide bar when footer enters view ── */
  function findFooter(){
    return document.querySelector('footer.site-footer')||
           document.querySelector('footer[role="contentinfo"]')||
           document.querySelector('footer')||
           document.querySelector('[role="contentinfo"]')||
           document.querySelector('.site-footer,#site-footer,.footer,#footer,#shopify-section-footer');
  }
  var fooObs=null;
  function attachFooterObserver(){
    if(fooObs||!('IntersectionObserver' in window))return;
    var footer=findFooter();
    if(!footer)return false;
    fooObs=new IntersectionObserver(function(entries){
      entries.forEach(function(en){bar&&bar.classList.toggle('hide',en.isIntersecting);});
    },{threshold:0.01});
    fooObs.observe(footer);
    return true;
  }
  /* Retry several times in case footer is rendered after section script runs */
  if(!attachFooterObserver()){
    var tries=0,maxTries=10;
    var iv=setInterval(function(){
      tries++;
      if(attachFooterObserver()||tries>=maxTries)clearInterval(iv);
    },300);
  }

  /* ── Dynamic bar height: keep --bar-h in sync with actual rendered bar ──
     rAF-batched so resize/orientation events don't force multiple synchronous
     layout reads per frame. */
  var syncRAF=null;
  function syncBarHeight(){
    if(syncRAF)return;
    syncRAF=requestAnimationFrame(function(){
      syncRAF=null;
      if(!bar)return;
      var h=bar.offsetHeight;
      if(h>20){
        root.style.setProperty('--bar-h',h+'px');
        bar.style.setProperty('--bar-h',h+'px');
      }
    });
  }
  syncBarHeight();
  if('ResizeObserver' in window){
    var ro=new ResizeObserver(syncBarHeight);
    ro.observe(bar);
  }else{
    window.addEventListener('resize',syncBarHeight,{passive:true});
  }

  /* Initial state for unavailable marking */
  markUnavailable();

  /* Initial vault entry on view (low priority, fire after a tick) */
  setTimeout(function(){
    var v=findVariant();if(!v)return;
    var vi=buildVI(v,null);
    var vd=getV();var idx=-1;
    vd.forEach(function(x,i){if(x.id===v.id)idx=i;});
    if(idx<0){vd.push(vi);setV(vd);}
  },800);

  /* ── Optional free-pair claim (separate from Add to cart; specs-atc-restore 2026-10-07) ──
     Enabled only when the bag already holds enough eligible items (sections/lexe-gift-check data-cents >= this gift's min).
     Adds qty 1 with _lexe_gift=1 + LEXESPECS. Cart guard (lexe-gift-normalize) still removes it if the bag drops under. */
  (function(){
    var box=document.getElementById('ap-claim'+S);
    if(!box)return;
    var btn=document.getElementById('ap-claim-btn'+S),hint=document.getElementById('ap-claim-hint'+S);
    var em=document.getElementById('ap-claim-email'+S),err=document.getElementById('ap-claim-err'+S);
    var need=parseInt(box.getAttribute('data-lx-min'),10)||0,base=hint?hint.textContent:'',ok=false,busy=false;
    function showErr(t){if(err){err.style.display=t?'block':'none';err.textContent=t||'';}}
    function check(){
      return fetch('/?sections=lexe-gift-check&t='+Date.now(),{credentials:'same-origin',cache:'no-store'})
        .then(function(r){return r.json();})
        .then(function(d){
          var m=/data-cents="(-?\d+)"/.exec((d&&d['lexe-gift-check'])||'');
          var have=m?parseInt(m[1],10):0;
          ok=need>0&&have>=need;
          if(btn&&!busy)btn.disabled=!ok;
          if(hint)hint.textContent=ok?'Your bag qualifies. Claim this pair free (one per order).':base+(have>0?' Add '+money(need-have)+' more of eligible items to unlock.':'');
          return ok;
        }).catch(function(){ok=false;if(btn)btn.disabled=true;return false;});
    }
    check().then(function(q){if(!q)setTimeout(check,1500);});
    if(em)em.addEventListener('focus',function(){if(!ok)check();});
    window.addEventListener('pageshow',function(e){if(e.persisted)check();});
    document.addEventListener('cart:updated',function(){setTimeout(check,300);});
    document.addEventListener('cart:item-added',function(){setTimeout(check,300);});
    if(btn)btn.addEventListener('click',function(){
      var cv=findVariant();
      var email=(em&&em.value||'').trim();
      if(!cv)return;
      if(!email||email.indexOf('@')<1){showErr('Enter a valid email to claim.');if(em)em.focus();return;}
      showErr('');busy=true;btn.classList.add('ld');var t0=btn.textContent;btn.textContent='Claiming…';
      check().then(function(q){
        if(!q)throw new Error('Add more eligible items to your bag first.');
        return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
          body:JSON.stringify({items:[{id:cv.id,quantity:1,properties:{_lexe_gift:'1',_lexe_claim_email:email}}]})})
          .then(function(r){return r.json().then(function(j){return{ok:r.ok,j:j};});});
      }).then(function(res){
        if(!res.ok)throw new Error((res.j&&res.j.description)||'Could not claim');
        return fetch('/cart/update.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({discount:'LEXESPECS'})}).catch(function(){return null;});
      }).then(function(){return fetch('/cart.js').then(function(r){return r.json();});})
      .then(function(cart){
        busy=false;btn.classList.remove('ld');btn.textContent=t0;
        document.dispatchEvent(new CustomEvent('cart:updated',{bubbles:true,detail:{cart:cart}}));
        var nb=document.querySelector('[data-notch-cart]');
        if(nb){try{nb.click();}catch(e){}}else window.location='/cart';
      }).catch(function(e){
        busy=false;btn.classList.remove('ld');btn.textContent=t0;showErr(e.message||'Could not claim');check();
      });
    });
  })();
})();
</script>

<script>
/* Info columns v2 (blocks): accordions, variant-box a11y, inline buy button mirror.
   Does not touch the sticky bar script above: the variant boxes use the same [data-opt] [data-vbtn] markup (so the
   existing delegated click handler, findVariant and renderPrice drive both), and the inline button only clicks the
   sticky Add to cart and mirrors its label / price / state. */
(function(){
  'use strict';
  var S='{{ sid }}';
  var root=document.getElementById('ap'+S);
  if(!root)return;
  function $$(q,el){return Array.prototype.slice.call((el||document).querySelectorAll(q));}

  /* ── Accordions ── */
  function setAcc(btn,open){
    var p=document.getElementById(btn.getAttribute('aria-controls'));
    btn.setAttribute('aria-expanded',open?'true':'false');
    if(!p)return;
    p.classList.toggle('open',open);
    if(open)p.removeAttribute('inert');else p.setAttribute('inert','');
  }
  root.addEventListener('click',function(e){
    var b=e.target.closest('[data-ap-acc]');
    if(b&&root.contains(b)){setAcc(b,b.getAttribute('aria-expanded')!=='true');return;}
    var sg=e.target.closest('[data-ap-open-size]');
    if(sg){
      var acc=root.querySelector('.ap-acc'+S+'[data-kind="size"]');if(!acc)return;
      var ab=acc.querySelector('[data-ap-acc]');
      if(ab){setAcc(ab,true);}
      var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
      try{acc.scrollIntoView({behavior:reduce?'auto':'smooth',block:'nearest'});}catch(x){}
      var f=ab||acc.querySelector('a');if(f)setTimeout(function(){f.focus({preventScroll:true});},reduce?0:260);
    }
  });
  /* Theme editor: selecting an accordion block opens it */
  document.addEventListener('shopify:block:select',function(e){
    var el=e.target&&e.target.closest?e.target:null;if(!el||!root.contains(el))return;
    var ab=el.querySelector&&el.querySelector('[data-ap-acc]');if(ab)setAcc(ab,true);
  });

  /* ── Variant boxes: roving tabindex, arrow keys, aria-disabled, selected value label ── */
  var groups=$$('.ap-vp-opts'+S,root);
  function syncBoxes(){
    groups.forEach(function(g){
      var btns=$$('[data-vbtn]',g),on=null;
      btns.forEach(function(b){
        var u=b.classList.contains('unavail');
        if(u)b.setAttribute('aria-disabled','true');else b.removeAttribute('aria-disabled');
        if(b.classList.contains('on'))on=b;
      });
      btns.forEach(function(b){b.tabIndex=(b===on||(!on&&b===btns[0]))?0:-1;});
      var oi=g.getAttribute('data-opt');
      var lab=root.querySelector('[data-vp-val="'+oi+'"]');
      if(lab&&on&&lab.textContent!==on.getAttribute('data-val'))lab.textContent=on.getAttribute('data-val');
    });
  }
  if(groups.length){
    /* runs after the sticky script's own document click handler (registered earlier) */
    document.addEventListener('click',function(e){if(e.target.closest&&e.target.closest('[data-vbtn]'))syncBoxes();});
    groups.forEach(function(g){
      g.addEventListener('keydown',function(e){
        var k=e.key;
        if(['ArrowRight','ArrowDown','ArrowLeft','ArrowUp','Home','End',' ','Enter'].indexOf(k)<0)return;
        var btns=$$('[data-vbtn]',g),cur=btns.indexOf(document.activeElement);if(cur<0)return;
        if(k===' '||k==='Enter'){return;}
        e.preventDefault();
        var n=btns.length,order=[],j;
        if(k==='Home'){for(j=0;j<n;j++)order.push(j);}
        else if(k==='End'){for(j=n-1;j>=0;j--)order.push(j);}
        else{var dir=(k==='ArrowRight'||k==='ArrowDown')?1:-1;for(j=1;j<=n;j++)order.push(((cur+dir*j)%n+n)%n);}
        var t=null;for(j=0;j<order.length;j++){if(!btns[order[j]].classList.contains('unavail')){t=order[j];break;}}
        if(t===null)return;
        btns[t].focus();btns[t].click();
      });
    });
    syncBoxes();
    /* markUnavailable in the sticky script may run after first paint; keep aria in step */
    if('MutationObserver' in window){
      var mo=new MutationObserver(function(){syncBoxes();});
      groups.forEach(function(g){mo.observe(g,{subtree:true,attributes:true,attributeFilter:['class']});});
    }
  }

  /* ── Inline buy button: forwards to the sticky Add to cart and mirrors it ── */
  var atc=document.getElementById('ap-atc'+S);
  var lbl=document.getElementById('ap-atc-lbl'+S);
  var pr=document.getElementById('ap-atc-price'+S);
  var buys=$$('[data-ap-buy]',root);
  if(atc&&buys.length){
    var mirror=function(){
      buys.forEach(function(b){
        b.disabled=atc.disabled;
        var l=b.querySelector('[data-ap-buy-lbl]'),p=b.querySelector('[data-ap-buy-price]');
        if(l&&lbl&&l.textContent!==lbl.textContent)l.textContent=lbl.textContent;
        if(p&&pr&&p.textContent!==pr.textContent)p.textContent=pr.textContent;
        ['ld','added','ap-need'].forEach(function(c){b.classList.toggle(c,atc.classList.contains(c));});
      });
    };
    new MutationObserver(mirror).observe(atc,{attributes:true,attributeFilter:['class','disabled','aria-label'],childList:true,subtree:true,characterData:true});
    mirror();
    buys.forEach(function(b){b.addEventListener('click',function(){if(!atc.disabled)atc.click();});});
  }
  /* Optional inline quantity: forwards to the sticky quantity buttons */
  var qVal=document.getElementById('ap-qty-val'+S),qDec=document.getElementById('ap-qty-dec'+S),qInc=document.getElementById('ap-qty-inc'+S);
  var qWraps=$$('.ap-bq'+S,root);
  if(qVal&&qWraps.length){
    var qm=function(){
      qWraps.forEach(function(w){
        var v=w.querySelector('[data-ap-qv]');if(v&&v.textContent!==qVal.textContent)v.textContent=qVal.textContent;
        var d=w.querySelector('[data-ap-q="-1"]');if(d&&qDec)d.disabled=qDec.disabled;
      });
    };
    new MutationObserver(qm).observe(qVal,{childList:true,characterData:true,subtree:true});
    if(qDec)new MutationObserver(qm).observe(qDec,{attributes:true,attributeFilter:['disabled']});
    qWraps.forEach(function(w){
      w.addEventListener('click',function(e){
        var b=e.target.closest('[data-ap-q]');if(!b)return;
        var t=b.getAttribute('data-ap-q')==='-1'?qDec:qInc;if(t&&!t.disabled)t.click();
      });
    });
    qm();
  }
})();
</script>

