{% comment %}
  ╔════════════════════════════════════════════════════════════╗
  ║   VANQUISH FOOTER v3.0 — Minimal Pill + Upward Bottom Sheet ║
  ╚════════════════════════════════════════════════════════════╝

  Layout: socials (left) · monogram (center) · NEED HELP? (right)
  All accordion content moves into a bottom-sheet drawer that
  slides UP from the bar. Two-tier menu:
    Tier 1 — primary navigation
    Tier 2 — "More options" reveals legal, newsletter, contact

  STRIPE COMPLIANCE:
  Policy links remain in the DOM at all times. The bottom-sheet
  is hidden via translateY transform (not display:none), so
  every <a> is parseable. A second policy strip lives in the
  permanent bottom row for double-coverage.
{% endcomment %}

{%- liquid
  assign footer_bg     = section.settings.footer_bg_color
  assign footer_text   = section.settings.footer_text_color
  assign accent_color  = section.settings.accent_color
  assign border_color  = section.settings.border_color
  assign pill_bg       = section.settings.pill_bg_color
  assign pill_text     = section.settings.pill_text_color
  assign brand_label   = section.settings.brand_name | default: shop.name
  assign monogram_text = section.settings.monogram_text | default: 'M'
  assign center_logo   = section.settings.center_logo
  assign logo_max_h    = section.settings.center_logo_height | default: 32
  assign nav_menu      = linklists[section.settings.nav_menu]
  assign more_menu     = linklists[section.settings.more_menu]
  assign scale         = section.settings.footer_scale | default: 100
  assign scale_dec     = scale | times: 1.0 | divided_by: 100.0

  comment
    Shopify-native font_picker. Same UX as the header settings.
    font_face emits @font-face declarations served by Shopify's CDN — no Google Fonts request needed.
  endcomment
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign hf_bold = hf | font_modify: 'weight', 'bolder'
  assign bf_bold = bf | font_modify: 'weight', 'bolder'

  comment
    ── Policy URL resolution, in priority order ──
    1. Per-link custom override (set below in "Policy Link Overrides")
    2. Policies hub page + #tab-<slug> — auto-opens the matching tab in
       the faq-dynamic.liquid section dropped on that page
    3. Shopify's native automatic policy page
    4. Hardcoded /policies/* fallback
  endcomment
  assign hub_url = section.settings.policies_page_url

  assign privacy_url = section.settings.custom_privacy_url
  if privacy_url == blank and hub_url != blank
    assign privacy_url = hub_url | append: '#tab-privacy'
  endif
  assign privacy_url = privacy_url | default: shop.privacy_policy.url | default: '/policies/privacy-policy'

  assign refund_url = section.settings.custom_refund_url
  if refund_url == blank and hub_url != blank
    assign refund_url = hub_url | append: '#tab-refund'
  endif
  assign refund_url = refund_url | default: shop.refund_policy.url | default: '/policies/refund-policy'

  assign terms_url = section.settings.custom_terms_url
  if terms_url == blank and hub_url != blank
    assign terms_url = hub_url | append: '#tab-terms'
  endif
  assign terms_url = terms_url | default: shop.terms_of_service.url | default: '/policies/terms-of-service'

  assign shipping_url = section.settings.custom_shipping_url
  if shipping_url == blank and hub_url != blank
    assign shipping_url = hub_url | append: '#tab-shipping'
  endif
  assign shipping_url = shipping_url | default: shop.shipping_policy.url | default: '/policies/shipping-policy'

  assign subscription_url = section.settings.custom_subscription_url
  if subscription_url == blank and hub_url != blank
    assign subscription_url = hub_url | append: '#tab-subscription'
  endif
  assign subscription_url = subscription_url | default: shop.subscription_policy.url

  assign contact_info_url = section.settings.custom_contact_info_url
  if contact_info_url == blank and hub_url != blank
    assign contact_info_url = hub_url | append: '#tab-contact'
  endif
  assign contact_info_url = contact_info_url | default: '/policies/contact-information'
-%}

<style>
{{ hf | font_face: font_display: 'swap' }}
{{ hf_bold | font_face: font_display: 'swap' }}
{{ bf | font_face: font_display: 'swap' }}
{{ bf_bold | font_face: font_display: 'swap' }}
</style>

<style>
  #vq-foot {
    --vq-bg:        {{ footer_bg }};
    --vq-text:      {{ footer_text }};
    --vq-accent:    {{ accent_color }};
    --vq-border:    {{ border_color }};
    --vq-pill-bg:   {{ pill_bg }};
    --vq-pill-text: {{ pill_text }};
    --vq-pill-dim:  {{ pill_text | color_modify: 'alpha', 0.5 }};
    --vq-pill-line: {{ pill_text | color_modify: 'alpha', 0.12 }};
    --vq-pill-elev: {{ pill_text | color_modify: 'alpha', 0.06 }};
    --vq-text-dim:   {{ footer_text | color_modify: 'alpha', 0.35 }};
    --vq-text-faint: {{ footer_text | color_modify: 'alpha', 0.12 }};
    --vq-fh: {{ hf.family }}, {{ hf.fallback_families }};
    --vq-fb: {{ bf.family }}, {{ bf.fallback_families }};
    --vq-scale: {{ scale_dec }};

    position: relative;
    background: var(--vq-bg);
    color: var(--vq-text);
    font-family: var(--vq-fb);
    border-top: 1px solid var(--vq-border);
    z-index: 1;
  }
  #vq-foot *,
  #vq-foot *::before,
  #vq-foot *::after { box-sizing: border-box; }

  /* iOS Safari treats a document-level click listener (used below for
     "tap outside to close the drawer") as reason to make the FIRST tap on
     any link simulate :hover instead of navigating — links then need a
     second tap to actually follow. Explicit cursor:pointer signals to
     WebKit that these are directly clickable and skips that behavior.
     No visual change: links already show a pointer cursor on devices
     that have a cursor. */
  #vq-foot a[href] { cursor: pointer; }

  /* ── ACCENT SWEEP (preserved from v2) ── */
  .vq-sweep {
    position: relative;
    height: 2px;
    background: var(--vq-bg);
    overflow: hidden;
    z-index: 2;
  }
  .vq-sweep::before {
    content: '';
    position: absolute;
    top: 0; left: -60%;
    width: 60%; height: 100%;
    background: linear-gradient(90deg, transparent, var(--vq-accent), transparent);
    animation: vq-sweep 3.5s ease-in-out infinite;
  }
  @keyframes vq-sweep {
    0%   { left: -60%; opacity: 0; }
    20%  { opacity: 1; }
    80%  { opacity: 1; }
    100% { left: 110%; opacity: 0; }
  }

  /* ══════════════════════════════════════
     PILL BAR — scales via --vq-scale
  ══════════════════════════════════════ */
  .vq-bar {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: calc(14px * var(--vq-scale)) {{ section.settings.horizontal_padding }}px;
  }
  .vq-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(18px * var(--vq-scale));
    background: var(--vq-pill-bg);
    color: var(--vq-pill-text);
    border-radius: 100px;
    padding: calc(8px * var(--vq-scale)) calc(8px * var(--vq-scale)) calc(8px * var(--vq-scale)) calc(16px * var(--vq-scale));
    width: 100%;
    position: relative; /* anchor for absolutely-centered logo */
  }

  /* Left socials cluster */
  .vq-socials {
    display: flex;
    align-items: center;
    gap: calc(4px * var(--vq-scale));
    flex-shrink: 0;
  }
  .vq-soc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(36px * var(--vq-scale));
    height: calc(36px * var(--vq-scale));
    border-radius: 50%;
    color: var(--vq-pill-text);
    background: transparent;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    -webkit-tap-highlight-color: transparent;
    flex-shrink: 0;
  }
  .vq-soc:hover  { background: var(--vq-pill-elev); }
  .vq-soc:active { transform: scale(0.92); }
  .vq-soc svg {
    width: calc(18px * var(--vq-scale));
    height: calc(18px * var(--vq-scale));
    display: block;
    color: inherit;
  }
  /* Reset any inherited fills — icons handle their own fill/stroke per element */
  .vq-soc svg * { vector-effect: non-scaling-stroke; }
  .vq-soc.vq-soc-primary {
    background: var(--vq-pill-text);
    color: var(--vq-pill-bg);
  }
  .vq-soc.vq-soc-primary:hover {
    background: var(--vq-pill-text);
    opacity: 0.85;
  }

  /* Center monogram / logo — absolutely centered to bar midpoint,
     immune to asymmetric left/right widths */
  .vq-mono {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none; /* let socials / help still receive clicks if overlapped */
    max-width: 50%;       /* never overlap into either side */
  }
  .vq-mono > * { pointer-events: auto; }
  .vq-mono-mark {
    font-family: var(--vq-fh);
    font-size: calc(22px * var(--vq-scale));
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--vq-pill-text);
    text-decoration: none;
    line-height: 1;
    user-select: none;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .vq-mono-mark svg {
    width: calc(28px * var(--vq-scale)); height: calc(22px * var(--vq-scale));
    fill: currentColor;
  }
  .vq-mono-img {
    display: block;
    max-height: calc({{ logo_max_h }}px * var(--vq-scale));
    width: auto;
    object-fit: contain;
  }

  /* Right "Need Help?" trigger */
  .vq-help {
    display: inline-flex;
    align-items: center;
    gap: calc(8px * var(--vq-scale));
    background: transparent;
    border: none;
    cursor: pointer;
    padding: calc(9px * var(--vq-scale)) calc(14px * var(--vq-scale)) calc(9px * var(--vq-scale)) calc(16px * var(--vq-scale));
    border-radius: 100px;
    color: var(--vq-pill-text);
    font-family: var(--vq-fh);
    font-size: calc(12px * var(--vq-scale));
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    transition: background 0.18s, transform 0.15s;
    -webkit-tap-highlight-color: transparent;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .vq-help:hover  { background: var(--vq-pill-elev); }
  .vq-help:active { transform: scale(0.97); }
  .vq-help-arrow {
    width: calc(12px * var(--vq-scale)); height: calc(12px * var(--vq-scale));
    transition: transform 0.32s cubic-bezier(0.32,0.72,0,1);
    flex-shrink: 0;
  }
  .vq-help-arrow svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 2; }
  .vq-help[aria-expanded="true"] .vq-help-arrow { transform: rotate(180deg); }

  /* ══════════════════════════════════════
     POPOVER MENU — anchored above the Need Help trigger.
     Two size states:
       compact (default)  — small list, ~280px wide
       expanded (More)    — taller, fits secondary content, never fullscreen
  ══════════════════════════════════════ */
  .vq-sheet-bd {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0);
    pointer-events: none;
    transition: background 0.2s ease;
    z-index: 9998;
  }
  .vq-sheet-bd.open {
    pointer-events: auto;
    background: rgba(0,0,0,0.18);
  }

  .vq-sheet {
    position: absolute;
    z-index: 9999;
    background: var(--vq-pill-bg);
    color: var(--vq-pill-text);
    border-radius: 18px;
    box-shadow: 0 18px 48px rgba(0,0,0,0.18), 0 4px 14px rgba(0,0,0,0.10);
    /* Anchored from the bottom-right of #vq-foot — sits ABOVE the bar */
    bottom: calc(100% - 4px);
    right: {{ section.settings.horizontal_padding }}px;
    width: 280px;
    max-width: calc(100vw - 24px);
    max-height: 60vh;
    transform: translateY(8px) scale(0.96);
    transform-origin: bottom right;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.3s cubic-bezier(0.32,0.72,0,1),
      opacity 0.22s ease,
      width 0.36s cubic-bezier(0.32,0.72,0,1),
      max-height 0.36s cubic-bezier(0.32,0.72,0,1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    will-change: transform, opacity, width, max-height;
  }
  .vq-sheet.open {
    transform: translateY(0) scale(1);
    opacity: 1;
    pointer-events: auto;
  }
  .vq-sheet.expanded {
    width: 380px;
    max-width: calc(100vw - 24px);
    max-height: 75vh;
  }

  /* Drag handle hidden — popover doesn't need it */
  .vq-sheet-handle { display: none; }

  .vq-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px 10px;
    flex-shrink: 0;
    border-bottom: 1px solid var(--vq-pill-line);
  }
  .vq-sheet-title {
    font-family: var(--vq-fh);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--vq-pill-text);
    line-height: 1;
  }
  .vq-sheet-close {
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--vq-pill-elev);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.15s;
  }
  .vq-sheet-close:hover { background: var(--vq-pill-line); }
  .vq-sheet-close svg   { width: 11px; height: 11px; stroke: var(--vq-pill-text); fill: none; stroke-width: 1.7; }

  .vq-sheet-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 4px 0 14px;
    scrollbar-width: thin;
    scrollbar-color: var(--vq-pill-line) transparent;
  }
  .vq-sheet-body::-webkit-scrollbar { width: 5px; }
  .vq-sheet-body::-webkit-scrollbar-thumb { background: var(--vq-pill-line); border-radius: 100px; }

  /* ── Tier 1 nav list ── */
  .vq-nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vq-nav li { display: block; }
  .vq-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    font-family: var(--vq-fb);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--vq-pill-text);
    text-decoration: none;
    border-bottom: 1px solid var(--vq-pill-line);
    transition: background 0.15s, padding-left 0.18s;
    -webkit-tap-highlight-color: transparent;
  }
  .vq-nav a:hover { background: var(--vq-pill-elev); padding-left: 22px; }
  .vq-nav a svg {
    width: 13px; height: 13px;
    stroke: var(--vq-pill-dim);
    fill: none; stroke-width: 1.8;
    transition: stroke 0.15s, transform 0.18s;
    flex-shrink: 0;
  }
  .vq-nav a:hover svg { stroke: var(--vq-pill-text); transform: translateX(3px); }

  /* ── More options trigger ── */
  .vq-more-trig {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px 18px;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--vq-pill-line);
    cursor: pointer;
    color: var(--vq-pill-text);
    font-family: var(--vq-fh);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.15s;
  }
  .vq-more-trig:hover { background: var(--vq-pill-elev); }
  .vq-more-trig-arrow {
    width: 11px; height: 11px;
    transition: transform 0.32s cubic-bezier(0.32,0.72,0,1);
    flex-shrink: 0;
  }
  .vq-more-trig-arrow svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 2; }
  .vq-more-trig[aria-expanded="true"] .vq-more-trig-arrow { transform: rotate(180deg); }

  /* ── Tier 2 expandable region ── */
  .vq-more {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .vq-more.open { grid-template-rows: 1fr; }
  .vq-more-inner { overflow: hidden; }
  .vq-more-pad   { padding: 6px 18px 14px; }

  .vq-section-label {
    font-family: var(--vq-fh);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.30em;
    text-transform: uppercase;
    color: var(--vq-pill-dim);
    margin: 14px 0 8px;
  }

  /* Newsletter compact */
  .vq-nl-form { margin-bottom: 10px; }
  .vq-nl-wrap {
    position: relative;
    background: var(--vq-pill-elev);
    border-radius: 100px;
    overflow: hidden;
    padding: 4px 4px 4px 14px;
    display: flex;
    align-items: center;
  }
  .vq-nl-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--vq-fb);
    font-size: 13px;
    color: var(--vq-pill-text);
    padding: 9px 8px 9px 0;
    min-width: 0;
    -webkit-appearance: none;
  }
  .vq-nl-input::placeholder {
    color: var(--vq-pill-dim);
    font-size: 12px;
  }
  .vq-nl-btn {
    flex-shrink: 0;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--vq-pill-text);
    color: var(--vq-pill-bg);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.18s, transform 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .vq-nl-btn:hover  { opacity: 0.85; }
  .vq-nl-btn:active { transform: scale(0.94); }
  .vq-nl-btn svg    { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2; }
  .vq-nl-disclaimer {
    font-size: 9.5px;
    color: var(--vq-pill-dim);
    line-height: 1.5;
    margin-top: 7px;
    padding: 0 4px;
  }
  .vq-nl-disclaimer a {
    color: var(--vq-pill-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .vq-nl-success {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    background: var(--vq-pill-elev);
    border-radius: 100px;
    font-family: var(--vq-fh);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #22c55e;
    margin-top: 8px;
  }
  .vq-nl-success.active { display: inline-flex; }

  /* Policy/legal grid */
  .vq-legal {
    list-style: none;
    margin: 0; padding: 0;
  }
  .vq-legal li { display: block; }
  .vq-legal a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 4px;
    font-family: var(--vq-fb);
    font-size: 12.5px;
    font-weight: 400;
    color: var(--vq-pill-text);
    text-decoration: none;
    visibility: visible;
    opacity: 1;
    border-bottom: 1px solid var(--vq-pill-line);
    transition: padding-left 0.18s;
  }
  .vq-legal a:hover { padding-left: 8px; }
  .vq-legal a svg   { width: 11px; height: 11px; stroke: var(--vq-pill-dim); fill: none; stroke-width: 1.8; flex-shrink: 0; }
  .vq-legal a:hover svg { stroke: var(--vq-pill-text); }
  .vq-legal li:last-child a { border-bottom: none; }

  /* Contact button */
  .vq-contact-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
    padding: 12px 18px;
    background: var(--vq-pill-text);
    color: var(--vq-pill-bg);
    border-radius: 100px;
    text-decoration: none;
    font-family: var(--vq-fh);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: opacity 0.18s, transform 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .vq-contact-cta:hover  { opacity: 0.88; }
  .vq-contact-cta:active { transform: scale(0.98); }
  .vq-contact-cta svg    { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2; }

  /* ══════════════════════════════════════
     PERMANENT BOTTOM POLICY ROW — Stripe compliance
     Always visible, always parseable.
  ══════════════════════════════════════ */
  .vq-foot-base {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 6px {{ section.settings.horizontal_padding }}px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .vq-copyright {
    font-family: var(--vq-fh);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--vq-text-dim);
  }
  .vq-base-policy {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .vq-base-policy a {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vq-text-dim);
    text-decoration: none;
    display: inline-block;
    visibility: visible;
    opacity: 1;
    transition: color 0.2s;
  }
  .vq-base-policy a:hover { color: var(--vq-text); }

  /* ══════════════════════════════════════
     PAYMENT ICONS — trust signal, lives in the
     permanent compliant zone beneath the policy
     row. Quiet by default, never competes with
     the pill bar above it.
  ══════════════════════════════════════ */
  .vq-payment-row {
    border-top: 1px solid var(--vq-border);
  }
  .vq-payment-inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 12px {{ section.settings.horizontal_padding }}px 4px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .vq-payment-label {
    font-family: var(--vq-fh);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--vq-text-dim);
    flex-shrink: 0;
  }
  .vq-payment-icons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .vq-payment-icons li {
    display: flex;
    line-height: 0;
  }
  .vq-pay-icon {
    display: block;
    height: 20px;
    width: auto;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--vq-text-faint);
    opacity: 0.88;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }
  .vq-payment-icons li:hover .vq-pay-icon {
    opacity: 1;
    transform: translateY(-1px);
  }

  /* ══════════════════════════════════════
     RESPONSIVE
  ══════════════════════════════════════ */
  @media (max-width: 540px) {
    .vq-mono { max-width: 40%; }
    .vq-mono-mark { font-size: calc(18px * var(--vq-scale)); }
    .vq-mono-mark svg { width: calc(22px * var(--vq-scale)); height: calc(18px * var(--vq-scale)); }
    .vq-help { padding: calc(8px * var(--vq-scale)) calc(12px * var(--vq-scale)); font-size: calc(10.5px * var(--vq-scale)); }
    .vq-help-arrow { width: calc(10px * var(--vq-scale)); height: calc(10px * var(--vq-scale)); }
    .vq-soc { width: calc(32px * var(--vq-scale)); height: calc(32px * var(--vq-scale)); }
    .vq-soc svg { width: calc(16px * var(--vq-scale)); height: calc(16px * var(--vq-scale)); }
    .vq-pill { padding: calc(6px * var(--vq-scale)) calc(6px * var(--vq-scale)) calc(6px * var(--vq-scale)) calc(12px * var(--vq-scale)); gap: calc(10px * var(--vq-scale)); }
    .vq-foot-base { flex-direction: column; align-items: flex-start; gap: 8px; }
    .vq-payment-inner { padding-top: 10px; gap: 8px; }
    .vq-pay-icon { height: 17px; }

    /* Popover: anchor right edge to padding, allow narrower */
    .vq-sheet { width: 260px; }
    .vq-sheet.expanded { width: calc(100vw - 24px); right: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vq-sweep::before { animation: none; opacity: 0; }
    .vq-soc,
    .vq-help,
    .vq-help-arrow,
    .vq-sheet,
    .vq-more,
    .vq-more-trig-arrow,
    .vq-nav a,
    .vq-nav a svg,
    .vq-legal a,
    .vq-nl-btn,
    .vq-contact-cta,
    .vq-pay-icon,
    .vq-base-policy a { transition: none; }
  }
</style>

