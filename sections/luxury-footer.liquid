      <span class="vq-sheet-title" id="vq-sheet-title">{{ section.settings.help_label | default: 'ABOUT US' }}</span>
      <button type="button" class="vq-sheet-close" id="vq-sheet-close" aria-label="Close"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="vq-sheet-body">
      <ul class="vq-nav">
        {%- for link in nav_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a></li>
        {%- endfor -%}
      </ul>

      <button type="button" class="vq-more-trig" id="vq-more-trig" aria-expanded="false">
