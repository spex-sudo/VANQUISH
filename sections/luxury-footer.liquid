            {%- endif -%}

            <div class="vq-section-label">{{ section.settings.legal_label | default: 'Policies' }}</div>
            <ul class="vq-legal" role="list">
              <li><a href="{{ privacy_url }}" style="visibility:visible;opacity:1;">Privacy Policy<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a></li>
              <li><a href="{{ refund_url }}" style="visibility:visible;opacity:1;">Refund Policy<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a></li>
              <li><a href="{{ terms_url }}" style="visibility:visible;opacity:1;">Terms of Service<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a></li>
              <li><a href="{{ shipping_url }}" style="visibility:visible;opacity:1;">Shipping Policy<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a></li>
              {%- if subscription_url != blank -%}
              <li><a href="{{ subscription_url }}" style="visibility:visible;opacity:1;">Subscription Policy<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a></li>
              {%- endif -%}
              <li><a href="{{ contact_info_url }}" style="visibility:visible;opacity:1;">Contact Information<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a></li>
            </ul>

            {%- if section.settings.contact_url != blank -%}
              <a href="{{ section.settings.contact_url }}" class="vq-contact-cta">
                {{ section.settings.contact_label | default: 'Talk to us' }}
                <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            {%- endif -%}

          </div>
        </div>
      </div>

    </div>
  </div>

</footer>

<script>
(function(){
  'use strict';

  /* Shared references to the current section's interactive elements.
     Declared outside init() so the document-level listeners below always
     read the *latest* nodes even after Shopify swaps this section's DOM. */
  var helpBtn, sheet, bd, closeBtn, moreTrig, moreBox, nlForm, nlSuccess, lastFocus;

  function openSheet(){
    lastFocus = document.activeElement;
    sheet.classList.add('open');
    bd.classList.add('open');
    sheet.setAttribute('aria-hidden','false');
    bd.setAttribute('aria-hidden','false');
    if(helpBtn) helpBtn.setAttribute('aria-expanded','true');
    setTimeout(function(){ if(closeBtn) closeBtn.focus({preventScroll:true}); }, 320);
  }
  function closeSheet(){
    if(!sheet || !bd) return;
    sheet.classList.remove('open','expanded');
    bd.classList.remove('open');
    sheet.setAttribute('aria-hidden','true');
    bd.setAttribute('aria-hidden','true');
    if(helpBtn) helpBtn.setAttribute('aria-expanded','false');
    if(moreBox)  moreBox.classList.remove('open');
    if(moreTrig) moreTrig.setAttribute('aria-expanded','false');
    if(lastFocus && lastFocus.focus) lastFocus.focus({preventScroll:true});
  }

  /* Wires up one instance of the footer, scoped to `root` (defaults to the
     whole document on first load; scoped to the reloaded section element
     when Shopify's theme editor swaps the markup back in — see below). */
  function initVqFooter(root){
    root = root || document;

    helpBtn   = root.querySelector('#vq-help-btn');
    sheet     = root.querySelector('#vq-sheet');
    bd        = root.querySelector('#vq-sheet-bd');
    closeBtn  = root.querySelector('#vq-sheet-close');
    moreTrig  = root.querySelector('#vq-more-trig');
    moreBox   = root.querySelector('#vq-more');
    nlForm    = root.querySelector('#vq-nl-form');
    nlSuccess = root.querySelector('#vq-nl-success');

    if(!sheet || !bd) return;

    if(helpBtn) helpBtn.addEventListener('click', function(e){
      e.stopPropagation();
      if(sheet.classList.contains('open')) closeSheet(); else openSheet();
    });
    if(closeBtn) closeBtn.addEventListener('click', closeSheet);
    if(bd)       bd.addEventListener('click', closeSheet);

    if(moreTrig && moreBox){
      moreTrig.addEventListener('click', function(){
        var open = moreBox.classList.toggle('open');
        moreTrig.setAttribute('aria-expanded', String(open));
        sheet.classList.toggle('expanded', open);
      });
    }

    /* Newsletter success state — auto-open sheet + tier 2 to confirm */
    if(nlForm && nlSuccess && window.location.search.indexOf('customer_posted=true') > -1){
      nlSuccess.classList.add('active');
      setTimeout(function(){
        openSheet();
        if(moreBox && moreTrig){
          moreBox.classList.add('open');
          moreTrig.setAttribute('aria-expanded','true');
          sheet.classList.add('expanded');
        }
      }, 250);
    }
  }

  /* Registered once on `document`, which never gets replaced — these always
     act on whichever sheet/bd/helpBtn initVqFooter() most recently found. */
  document.addEventListener('keydown', function(e){
    if(sheet && e.key === 'Escape' && sheet.classList.contains('open')) closeSheet();
  });
  document.addEventListener('click', function(e){
    if(!sheet || !sheet.classList.contains('open')) return;
    if(sheet.contains(e.target)) return;
    if(helpBtn && helpBtn.contains(e.target)) return;
    closeSheet();
  });

  /* Initial page load */
  initVqFooter(document);

  /* FIX: inline script tags do not re-execute when Shopify's theme editor
     re-renders a section after a settings change — the old button/sheet
     nodes (and their listeners) are simply swapped out for new, unwired
     ones, which is why clicks stop doing anything after any edit. Re-run
     init() against the fresh markup whenever this section reloads. */
  document.addEventListener('shopify:section:load', function(e){
    if(e.target && e.target.querySelector('#vq-help-btn')){
      initVqFooter(e.target);
    }
  });
})();
</script>

