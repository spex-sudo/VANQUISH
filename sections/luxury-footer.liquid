              {%- form 'customer', id: 'vq-nl-form', class: 'vq-nl-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter,footer">
                <div class="vq-nl-wrap">
                  <label for="vq-nl-email" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);">Email address</label>
                  <input id="vq-nl-email" type="email" name="contact[email]" class="vq-nl-input" placeholder="{{ section.settings.newsletter_placeholder | default: 'Email for first access' }}" required autocomplete="email">
                  <button type="submit" class="vq-nl-btn" aria-label="Subscribe">
                    <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
