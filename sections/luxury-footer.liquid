              {%- for link in more_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></a></li>
              {%- endfor -%}
            </ul>

            <div class="vq-section-label">{{ section.settings.legal_label | default: 'Policies' }}</div>
