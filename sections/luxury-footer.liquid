      </button>

      <div class="vq-more" id="vq-more">
        <div class="vq-more-inner">
          <div class="vq-more-pad">
            {%- if section.settings.show_newsletter -%}
              <div class="vq-section-label">{{ section.settings.newsletter_heading | default: 'Stay In Touch' }}</div>
              {% form 'customer', class: 'vq-nl-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="vq-nl-wrap">
                  <input type="email" name="contact[email]" class="vq-nl-input" placeholder="{{ section.settings.newsletter_placeholder | default: 'Email for first access' }}" required>
                  <button type="submit" class="vq-nl-btn">Join</button>
                </div>
              {% endform %}
            {%- endif -%}

            <div class="vq-section-label">{{ section.settings.more_section_label | default: 'Explore' }}</div>
