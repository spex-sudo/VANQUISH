      <a href="{{ refund_url }}" style="display:inline-block;visibility:visible;opacity:1;">Refunds</a>
      <a href="{{ shipping_url }}" style="display:inline-block;visibility:visible;opacity:1;">Shipping</a>
      <a href="{{ contact_info_url }}" style="display:inline-block;visibility:visible;opacity:1;">Contact</a>
