          <li>{{ type | payment_type_svg_tag: class: 'vq-pay-icon' }}</li>
        {%- else -%}
          <li>{{ 'visa' | payment_type_svg_tag: class: 'vq-pay-icon' }}</li>
          <li>{{ 'master' | payment_type_svg_tag: class: 'vq-pay-icon' }}</li>
          <li>{{ 'american_express' | payment_type_svg_tag: class: 'vq-pay-icon' }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
  {%- endif -%}
</footer>

<script>
(function(){
  var sheet, bd, helpBtn, moreTrig, more;
  function initVqFooter(root){
    sheet = (root || document).querySelector('#vq-sheet');
    bd = (root || document).querySelector('#vq-sheet-bd');
    helpBtn = (root || document).querySelector('#vq-help-btn');
    moreTrig = (root || document).querySelector('#vq-more-trig');
    more = (root || document).querySelector('#vq-more');
    if(!sheet || !helpBtn) return;

    function openSheet(){
      sheet.classList.add('open');
      if(bd) bd.classList.add('open');
      helpBtn.setAttribute('aria-expanded','true');
    }
    function closeSheet(){
      sheet.classList.remove('open');
      sheet.classList.remove('expanded');
      if(bd) bd.classList.remove('open');
      helpBtn.setAttribute('aria-expanded','false');
      if(more) more.classList.remove('open');
      if(moreTrig) moreTrig.setAttribute('aria-expanded','false');
    }

    helpBtn.onclick = function(e){
      e.stopPropagation();
      if(sheet.classList.contains('open')) closeSheet();
      else openSheet();
    };
    var closeBtn = sheet.querySelector('#vq-sheet-close');
    if(closeBtn) closeBtn.onclick = closeSheet;
    if(bd) bd.onclick = closeSheet;

    if(moreTrig && more){
      moreTrig.onclick = function(e){
        e.stopPropagation();
        var open = more.classList.toggle('open');
        moreTrig.setAttribute('aria-expanded', open ? 'true' : 'false');
        if(open) sheet.classList.add('expanded');
        else sheet.classList.remove('expanded');
      };
    }
  }

  document.addEventListener('keydown', function(e){
    if(sheet && e.key === 'Escape' && sheet.classList.contains('open')) closeSheet();
  });
  document.addEventListener('click', function(e){
    if(!sheet || !sheet.classList.contains('open')) return;
    if(sheet.contains(e.target)) return;
    if(helpBtn && helpBtn.contains(e.target)) return;
    closeSheet();
  });

  initVqFooter(document);

  document.addEventListener('shopify:section:load', function(e){
    if(e.target && e.target.querySelector('#vq-help-btn')){
      initVqFooter(e.target);
    }
  });
})();
</script>

