{% comment %}
  ╔════════════════════════════════════════════════════════════╗
  ║   VANQUISH FOOTER v3.0 — Minimal Pill + Upward Bottom Sheet ║
  ╚════════════════════════════════════════════════════════════╝

  Layout: socials (left) · monogram (center) · NEED HELP? (right)
  All accordion content moves into a bottom-sheet drawer that
  slides UP from the bar. Two-tier menu:
    Tier 1 — primary navigation
    Tier 2 — "More options" reveals legal, newsletter, contact

  STRIPE COMPLIANCE:
  Policy links remain in the DOM at all times. The bottom-sheet
  is hidden via translateY transform (not display:none), so
  every <a> is parseable. A second policy strip lives in the
  permanent bottom row for double-coverage.
{% endcomment %}

{%- liquid
  assign footer_bg     = section.settings.footer_bg_color
  assign footer_text   = section.settings.footer_text_color
  assign accent_color  = section.settings.accent_color
  assign border_color  = section.settings.border_color
  assign pill_bg       = section.settings.pill_bg_color
  assign pill_text     = section.settings.pill_text_color
  assign brand_label   = section.settings.brand_name | default: shop.name
  assign monogram_text = section.settings.monogram_text | default: 'M'
  assign center_logo   = section.settings.center_logo
  assign logo_max_h    = section.settings.center_logo_height | default: 32
  assign nav_menu      = linklists[section.settings.nav_menu]
  assign more_menu     = linklists[section.settings.more_menu]
  assign scale         = section.settings.footer_scale | default: 100
  assign scale_dec     = scale | times: 1.0 | divided_by: 100.0

  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign hf_bold = hf | font_modify: 'weight', 'bolder'
  assign bf_bold = bf | font_modify: 'weight', 'bolder'

  assign hub_url = section.settings.policies_page_url

  assign privacy_url = section.settings.custom_privacy_url
  if privacy_url == blank and hub_url != blank
    assign privacy_url = hub_url | append: '#tab-privacy'
  endif
  assign privacy_url = privacy_url | default: shop.privacy_policy.url | default: '/policies/privacy-policy'

  assign refund_url = section.settings.custom_refund_url
  if refund_url == blank and hub_url != blank
    assign refund_url = hub_url | append: '#tab-refund'
  endif
  assign refund_url = refund_url | default: shop.refund_policy.url | default: '/policies/refund-policy'

  assign terms_url = section.settings.custom_terms_url
  if terms_url == blank and hub_url != blank
    assign terms_url = hub_url | append: '#tab-terms'
  endif
  assign terms_url = terms_url | default: shop.terms_of_service.url | default: '/policies/terms-of-service'

  assign shipping_url = section.settings.custom_shipping_url
  if shipping_url == blank and hub_url != blank
    assign shipping_url = hub_url | append: '#tab-shipping'
  endif
  assign shipping_url = shipping_url | default: shop.shipping_policy.url | default: '/policies/shipping-policy'

  assign subscription_url = section.settings.custom_subscription_url
  if subscription_url == blank and hub_url != blank
    assign subscription_url = hub_url | append: '#tab-subscription'
  endif
  assign subscription_url = subscription_url | default: shop.subscription_policy.url

  assign contact_info_url = section.settings.custom_contact_info_url
  if contact_info_url == blank and hub_url != blank
    assign contact_info_url = hub_url | append: '#tab-contact'
  endif
  assign contact_info_url = contact_info_url | default: '/policies/contact-information'
-%}

<style>
{{ hf | font_face: font_display: 'swap' }}
{{ hf_bold | font_face: font_display: 'swap' }}
{{ bf | font_face: font_display: 'swap' }}
{{ bf_bold | font_face: font_display: 'swap' }}
</style>

<style>
  #vq-foot {
    --vq-bg: {{ footer_bg }};
    --vq-text: {{ footer_text }};
    --vq-accent: {{ accent_color }};
    --vq-border: {{ border_color }};
    --vq-pill-bg: {{ pill_bg }};
    --vq-pill-text: {{ pill_text }};
    --vq-pill-dim: {{ pill_text | color_modify: 'alpha', 0.5 }};
    --vq-pill-line: {{ pill_text | color_modify: 'alpha', 0.12 }};
    --vq-pill-elev: {{ pill_text | color_modify: 'alpha', 0.06 }};
    --vq-text-dim: {{ footer_text | color_modify: 'alpha', 0.35 }};
    --vq-text-faint: {{ footer_text | color_modify: 'alpha', 0.12 }};
    --vq-fh: {{ hf.family }}, {{ hf.fallback_families }};
    --vq-fb: {{ bf.family }}, {{ bf.fallback_families }};
    --vq-scale: {{ scale_dec }};
    position: relative;
    background: var(--vq-bg);
    color: var(--vq-text);
    font-family: var(--vq-fb);
    border-top: 1px solid var(--vq-border);
    z-index: 1;
  }
  #vq-foot *, #vq-foot *::before, #vq-foot *::after { box-sizing: border-box; }
  #vq-foot a[href] { cursor: pointer; }
  .vq-sweep { position: relative; height: 2px; background: var(--vq-bg); overflow: hidden; z-index: 2; }
  .vq-sweep::before { content: ''; position: absolute; top: 0; left: -60%; width: 60%; height: 100%; background: linear-gradient(90deg, transparent, var(--vq-accent), transparent); animation: vq-sweep 3.5s ease-in-out infinite; }
  @keyframes vq-sweep { 0% { left: -60%; opacity: 0; } 20% { opacity: 1; } 80% { opacity: 1; } 100% { left: 110%; opacity: 0; } }
  .vq-bar { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: calc(14px * var(--vq-scale)) {{ section.settings.horizontal_padding }}px; }
  .vq-pill { display: flex; align-items: center; justify-content: space-between; gap: calc(18px * var(--vq-scale)); background: var(--vq-pill-bg); color: var(--vq-pill-text); border-radius: 100px; padding: calc(8px * var(--vq-scale)) calc(8px * var(--vq-scale)) calc(8px * var(--vq-scale)) calc(16px * var(--vq-scale)); width: 100%; position: relative; }
  .vq-socials { display: flex; align-items: center; gap: calc(4px * var(--vq-scale)); flex-shrink: 0; }
  .vq-soc { display: flex; align-items: center; justify-content: center; width: calc(36px * var(--vq-scale)); height: calc(36px * var(--vq-scale)); border-radius: 50%; color: var(--vq-pill-text); background: transparent; text-decoration: none; transition: background 0.2s, transform 0.15s; -webkit-tap-highlight-color: transparent; flex-shrink: 0; }
  .vq-soc:hover { background: var(--vq-pill-elev); }
  .vq-soc:active { transform: scale(0.92); }
  .vq-soc svg { width: calc(18px * var(--vq-scale)); height: calc(18px * var(--vq-scale)); display: block; color: inherit; }
  .vq-soc.vq-soc-primary { background: var(--vq-pill-text); color: var(--vq-pill-bg); }
  .vq-mono { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; pointer-events: none; max-width: 50%; }
  .vq-mono > * { pointer-events: auto; }
  .vq-mono-img { display: block; max-height: calc({{ logo_max_h }}px * var(--vq-scale)); width: auto; object-fit: contain; }
  .vq-help { display: inline-flex; align-items: center; gap: calc(8px * var(--vq-scale)); background: transparent; border: none; cursor: pointer; padding: calc(9px * var(--vq-scale)) calc(14px * var(--vq-scale)) calc(9px * var(--vq-scale)) calc(16px * var(--vq-scale)); border-radius: 100px; color: var(--vq-pill-text); font-family: var(--vq-fh); font-size: calc(12px * var(--vq-scale)); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1; transition: background 0.18s, transform 0.15s; -webkit-tap-highlight-color: transparent; flex-shrink: 0; white-space: nowrap; }
  .vq-help:hover { background: var(--vq-pill-elev); }
  .vq-help-arrow { width: calc(12px * var(--vq-scale)); height: calc(12px * var(--vq-scale)); transition: transform 0.32s cubic-bezier(0.32,0.72,0,1); flex-shrink: 0; }
  .vq-help[aria-expanded="true"] .vq-help-arrow { transform: rotate(180deg); }
  .vq-sheet-bd { position: fixed; inset: 0; background: rgba(0,0,0,0); pointer-events: none; transition: background 0.2s ease; z-index: 9998; }
  .vq-sheet-bd.open { pointer-events: auto; background: rgba(0,0,0,0.18); }
  .vq-sheet { position: absolute; z-index: 9999; background: var(--vq-pill-bg); color: var(--vq-pill-text); border-radius: 18px; box-shadow: 0 18px 48px rgba(0,0,0,0.18), 0 4px 14px rgba(0,0,0,0.10); bottom: calc(100% - 4px); right: {{ section.settings.horizontal_padding }}px; width: 280px; max-width: calc(100vw - 24px); max-height: 60vh; transform: translateY(8px) scale(0.96); transform-origin: bottom right; opacity: 0; pointer-events: none; transition: transform 0.3s cubic-bezier(0.32,0.72,0,1), opacity 0.22s ease, width 0.36s cubic-bezier(0.32,0.72,0,1), max-height 0.36s cubic-bezier(0.32,0.72,0,1); overflow: hidden; display: flex; flex-direction: column; }
  .vq-sheet.open { transform: translateY(0) scale(1); opacity: 1; pointer-events: auto; }
  .vq-sheet.expanded { width: 380px; max-width: calc(100vw - 24px); max-height: 75vh; }
  .vq-sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px 10px; flex-shrink: 0; border-bottom: 1px solid var(--vq-pill-line); }
  .vq-sheet-title { font-family: var(--vq-fh); font-size: 12px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--vq-pill-text); line-height: 1; }
  .vq-sheet-close { width: 26px; height: 26px; border-radius: 50%; background: var(--vq-pill-elev); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .vq-sheet-body { flex: 1; min-height: 0; overflow-y: auto; padding: 4px 0 14px; }
  .vq-nav { list-style: none; margin: 0; padding: 0; }
  .vq-nav a { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; font-family: var(--vq-fb); font-size: 13.5px; font-weight: 500; color: var(--vq-pill-text); text-decoration: none; border-bottom: 1px solid var(--vq-pill-line); }
  .vq-more-trig { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 14px 18px; background: transparent; border: none; border-bottom: 1px solid var(--vq-pill-line); cursor: pointer; color: var(--vq-pill-text); font-family: var(--vq-fh); font-size: 10.5px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; }
  .vq-more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.42s cubic-bezier(0.25,0.46,0.45,0.94); }
  .vq-more.open { grid-template-rows: 1fr; }
  .vq-more-inner { overflow: hidden; }
  .vq-more-pad { padding: 6px 18px 14px; }
  .vq-section-label { font-family: var(--vq-fh); font-size: 9px; font-weight: 700; letter-spacing: 0.30em; text-transform: uppercase; color: var(--vq-pill-dim); margin: 14px 0 8px; }
  .vq-foot-base { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 6px {{ section.settings.horizontal_padding }}px 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .vq-copyright { font-family: var(--vq-fh); font-size: 9px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--vq-text-dim); }
  .vq-base-policy { display: flex; gap: 14px; flex-wrap: wrap; }
  .vq-base-policy a { font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--vq-text-dim); text-decoration: none; }
  .vq-payment-row { border-top: 1px solid var(--vq-border); }
  .vq-payment-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 12px {{ section.settings.horizontal_padding }}px 4px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
  .vq-payment-icons { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
  .vq-pay-icon { display: block; height: 20px; width: auto; border-radius: 4px; opacity: 0.88; }
</style>

<footer id="vq-foot">
  <div class="vq-sweep" aria-hidden="true"></div>
  <div class="vq-bar">
    <div class="vq-pill">
      <div class="vq-socials">
        {%- if section.settings.whatsapp_url != blank -%}
          <a href="{{ section.settings.whatsapp_url }}" class="vq-soc vq-soc-primary" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></a>
        {%- endif -%}
        {%- if section.settings.discord_url != blank -%}
          <a href="{{ section.settings.discord_url }}" class="vq-soc" aria-label="Discord" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg></a>
        {%- endif -%}
      </div>
      <div class="vq-mono">
        {%- if center_logo != blank -%}
          <a href="{{ routes.root_url }}"><img src="{{ center_logo | image_url: height: 200 }}" alt="{{ brand_label }}" class="vq-mono-img" width="auto" height="{{ logo_max_h }}" loading="lazy"></a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="vq-mono-mark">{{ monogram_text }}</a>
        {%- endif -%}
      </div>
      <button type="button" class="vq-help" id="vq-help-btn" aria-expanded="false" aria-controls="vq-sheet">
        {{ section.settings.help_label | default: 'ABOUT US' }}
        <span class="vq-help-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></span>
      </button>
    </div>
  </div>
  <div class="vq-sheet-bd" id="vq-sheet-bd"></div>
  <div class="vq-sheet" id="vq-sheet" role="dialog" aria-modal="true">
    <div class="vq-sheet-head">
      <span class="vq-sheet-title">{{ section.settings.help_label | default: 'ABOUT US' }}</span>
      <button type="button" class="vq-sheet-close" id="vq-sheet-close" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="vq-sheet-body">
      <ul class="vq-nav">
        {%- for link in nav_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
      <button type="button" class="vq-more-trig" id="vq-more-trig" aria-expanded="false">{{ section.settings.more_label | default: 'More options' }}</button>
      <div class="vq-more" id="vq-more"><div class="vq-more-inner"><div class="vq-more-pad">
        {%- if section.settings.show_newsletter -%}
          <div class="vq-section-label">{{ section.settings.newsletter_heading | default: 'Stay In Touch' }}</div>
          {% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="vq-nl-wrap"><input type="email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder | default: 'Email for first access' }}" required><button type="submit">Join</button></div>{% endform %}
        {%- endif -%}
        <div class="vq-section-label">{{ section.settings.more_section_label | default: 'Explore' }}</div>
        <ul class="vq-nav">{%- for link in more_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
        <div class="vq-section-label">{{ section.settings.legal_label | default: 'Policies' }}</div>
        <ul class="vq-nav">
          <li><a href="{{ privacy_url }}">Privacy Policy</a></li>
          <li><a href="{{ refund_url }}">Refund Policy</a></li>
          <li><a href="{{ terms_url }}">Terms of Service</a></li>
          <li><a href="{{ shipping_url }}">Shipping Policy</a></li>
          <li><a href="{{ contact_info_url }}">Contact Information</a></li>
        </ul>
      </div></div></div>
    </div>
  </div>
  <div class="vq-foot-base">
    <span class="vq-copyright">© {{ "now" | date: "%Y" }} {{ section.settings.copyright_text | default: shop.name }}. All rights reserved.</span>
    <nav class="vq-base-policy" aria-label="Policies">
      <a href="{{ privacy_url }}">Privacy</a>
      <a href="{{ terms_url }}">Terms</a>
      <a href="{{ refund_url }}">Refunds</a>
      <a href="{{ shipping_url }}">Shipping</a>
      <a href="{{ contact_info_url }}">Contact</a>
    </nav>
  </div>
  <div class="vq-preferred-source" style="display:flex;justify-content:center;padding:10px 20px 6px;">
    <div google-add-preferred-source-btn data-theme="light"></div>
  </div>
  {%- if section.settings.show_payment_icons -%}
  <div class="vq-payment-row"><div class="vq-payment-inner">
    <ul class="vq-payment-icons">
      {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'vq-pay-icon' }}</li>{%- else -%}<li>{{ 'visa' | payment_type_svg_tag: class: 'vq-pay-icon' }}</li><li>{{ 'master' | payment_type_svg_tag: class: 'vq-pay-icon' }}</li>{%- endfor -%}
    </ul>
  </div></div>
  {%- endif -%}
</footer>

<script>
(function(){
  var sheet, bd, helpBtn, moreTrig, more;
  function initVqFooter(root){
    sheet = (root || document).querySelector('#vq-sheet');
    bd = (root || document).querySelector('#vq-sheet-bd');
    helpBtn = (root || document).querySelector('#vq-help-btn');
    moreTrig = (root || document).querySelector('#vq-more-trig');
    more = (root || document).querySelector('#vq-more');
    if(!sheet || !helpBtn) return;
    function openSheet(){ sheet.classList.add('open'); if(bd) bd.classList.add('open'); helpBtn.setAttribute('aria-expanded','true'); }
    function closeSheet(){ sheet.classList.remove('open','expanded'); if(bd) bd.classList.remove('open'); helpBtn.setAttribute('aria-expanded','false'); if(more) more.classList.remove('open'); if(moreTrig) moreTrig.setAttribute('aria-expanded','false'); }
    helpBtn.onclick = function(e){ e.stopPropagation(); if(sheet.classList.contains('open')) closeSheet(); else openSheet(); };
    var closeBtn = sheet.querySelector('#vq-sheet-close');
    if(closeBtn) closeBtn.onclick = closeSheet;
    if(bd) bd.onclick = closeSheet;
    if(moreTrig && more){ moreTrig.onclick = function(e){ e.stopPropagation(); var open = more.classList.toggle('open'); moreTrig.setAttribute('aria-expanded', open ? 'true' : 'false'); if(open) sheet.classList.add('expanded'); else sheet.classList.remove('expanded'); }; }
  }
  document.addEventListener('keydown', function(e){ if(sheet && e.key === 'Escape' && sheet.classList.contains('open')) closeSheet(); });
  document.addEventListener('click', function(e){ if(!sheet || !sheet.classList.contains('open')) return; if(sheet.contains(e.target)) return; if(helpBtn && helpBtn.contains(e.target)) return; closeSheet(); });
  initVqFooter(document);
  document.addEventListener('shopify:section:load', function(e){ if(e.target && e.target.querySelector('#vq-help-btn')) initVqFooter(e.target); });
})();
</script>

{% schema %}
{
  "name": "Footer — VANQUISH v3",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "footer_bg_color", "label": "Page background", "default": "#ffffff" },
    { "type": "color", "id": "footer_text_color", "label": "Page text", "default": "#0a0a0a" },
