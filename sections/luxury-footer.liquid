  <div class="vq-sheet" id="vq-sheet" role="dialog" aria-modal="true" aria-labelledby="vq-sheet-title" aria-hidden="true">
    <div class="vq-sheet-handle" id="vq-sheet-handle" aria-hidden="true"></div>
    <div class="vq-sheet-head">
      <span class="vq-sheet-title" id="vq-sheet-title">{{ section.settings.help_label | default: 'Need Help?' }}</span>
      <button type="button" class="vq-sheet-close" id="vq-sheet-close" aria-label="Close">
        <svg viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
