  });

  ROOT.addEventListener('click', function (e) {
    var b = e.target.closest('[data-lxb-vbtn]');
    if (!b || !ROOT.contains(b)) return;
    e.preventDefault(); e.stopPropagation();
    var host = b.closest('.lxb__p'); var v = host && host.querySelector('video[data-lxb-video]');
    if (!v) return;
    if (v.paused) { v.dataset.userPaused = '0'; tryPlay(v); } else { v.dataset.userPaused = '1'; v.pause(); }
    setBtn(v);
    track('home_hero_video_toggle', { state: v.dataset.userPaused === '1' ? 'pause' : 'play' });
  });
})();
</script>

{% schema %}
{
  "name": "LEXE Bento Hero",
  "tag": "div",
  "class": "lexe-bento-hero-section",
  "settings": [
    { "type": "header", "content": "Headline (on the main photo)" },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "LEXE by Devici Studios" },
    { "type": "text", "id": "title", "label": "Headline", "default": "Made to be noticed." },
    { "type": "text", "id": "subline", "label": "Line under headline", "default": "Outerwear, dresses and Specs, cut sharp." },
    { "type": "checkbox", "id": "show_sub_mobile", "label": "Show line under headline on phones", "default": false },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Explore LEXE" },
    { "type": "url", "id": "btn1_link", "label": "Primary button link", "default": "/collections/all" },
    { "type": "text", "id": "btn2_label", "label": "Secondary link", "default": "Get first look" },
    { "type": "url", "id": "btn2_link", "label": "Secondary link URL", "default": "/collections/all" },
    { "type": "range", "id": "overlay_opacity", "label": "Shade behind headline", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 70 },
    { "type": "checkbox", "id": "show_thumb", "label": "Show thumbnail", "default": true },
    { "type": "checkbox", "id": "show_thumb_mobile", "label": "Show thumbnail on phones", "default": false },
    { "type": "product", "id": "thumb_product", "label": "Thumbnail product", "info": "Use your newest product with a clean photo. Products tagged needs-clean-image are skipped." },
    { "type": "video", "id": "thumb_video", "label": "Thumbnail video (optional)" },
    { "type": "url", "id": "thumb_video_url", "label": "Thumbnail video URL (MP4, optional)" },

    { "type": "header", "content": "Main photo (left, behind the headline)" },
    { "type": "image_picker", "id": "image_a", "label": "Image", "info": "Real LEXE photo, at least 1600px wide. Loads first. Also the video fallback." },
    { "type": "text", "id": "image_a_position", "label": "Crop position", "info": "Optional, e.g. 50% 15%. Leave blank to use the image's focal point. Also used for the video." },
    { "type": "text", "id": "image_a_alt", "label": "Alt text" },
    { "type": "text", "id": "image_a_label", "label": "Label chip" },
    { "type": "url", "id": "image_a_link", "label": "Link" },
    { "type": "video", "id": "image_a_video", "label": "Video (optional)", "info": "Autoplays muted and looping while on screen. The image shows until it plays, and stays if autoplay is blocked (in-app browsers, Low Power Mode) or with reduced motion." },
    { "type": "url", "id": "image_a_video_url", "label": "Video URL (MP4, optional)", "info": "Used when no video is picked above." },
    { "type": "image_picker", "id": "image_a_poster", "label": "Video poster", "info": "Optional. Falls back to the image." },
    { "type": "checkbox", "id": "image_a_video_controls", "label": "Show play/pause control", "default": false },

    { "type": "header", "content": "Second photo (top right)" },
    { "type": "image_picker", "id": "image_b", "label": "Image", "info": "Real LEXE photo, at least 1300px wide, graded like the main photo." },
    { "type": "text", "id": "image_b_position", "label": "Crop position", "info": "Optional, e.g. 50% 20%." },
    { "type": "text", "id": "image_b_alt", "label": "Alt text" },
    { "type": "text", "id": "image_b_label", "label": "Label chip" },
    { "type": "url", "id": "image_b_link", "label": "Link" },
    { "type": "video", "id": "image_b_video", "label": "Video (optional)" },
    { "type": "url", "id": "image_b_video_url", "label": "Video URL (MP4, optional)" },
    { "type": "image_picker", "id": "image_b_poster", "label": "Video poster", "info": "Optional. Falls back to the image." },
    { "type": "checkbox", "id": "image_b_video_controls", "label": "Show play/pause control", "default": false },

    { "type": "header", "content": "Product (bottom right, glass card on its photo)" },
    { "type": "product", "id": "product", "label": "Product", "info": "Shows its real name and live price. Products tagged needs-clean-image are skipped." },
    { "type": "range", "id": "product_image_position", "label": "Product photo (0 = featured)", "min": 0, "max": 12, "step": 1, "default": 0 },
    { "type": "text", "id": "product_image_crop", "label": "Product photo crop position", "info": "Optional, e.g. 50% 30%." },
    { "type": "text", "id": "product_kicker", "label": "Small label above name" },
    { "type": "text", "id": "product_cta", "label": "Link text", "default": "Explore" },
    { "type": "video", "id": "product_video", "label": "Video (optional)" },
    { "type": "url", "id": "product_video_url", "label": "Video URL (MP4, optional)" },
    { "type": "image_picker", "id": "product_poster", "label": "Video poster", "info": "Optional. Falls back to the product photo." },
    { "type": "checkbox", "id": "product_video_controls", "label": "Show play/pause control", "default": false },

    { "type": "header", "content": "Video" },
    { "type": "checkbox", "id": "video_mobile", "label": "Use video on phones", "info": "Off: phones show the images only.", "default": true },
    { "type": "checkbox", "id": "video_defer", "label": "Load videos after the page", "default": true, "info": "On (default): the photo shows first and the video starts downloading once the page has loaded, so photos appear faster. It still autoplays muted. Turn off to load videos immediately." },
    { "type": "checkbox", "id": "video_reduced_motion", "label": "Show images instead of video when Reduce Motion is on", "info": "Off (default): videos play even when the phone has Reduce Motion on, like the Ultimate Hero. In-app browsers always show the images.", "default": false },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "edge_pad", "label": "Edge padding", "info": "0 = edge to edge. Above 0 the hero gets rounded outer corners.", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "gutter", "label": "Gutter (seam width)", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 6 },
    { "type": "range", "id": "gutter_mobile", "label": "Gutter on phones", "min": 0, "max": 12, "step": 1, "unit": "px", "default": 4 },
    { "type": "checkbox", "id": "slanted", "label": "Angled seams", "default": true },
    { "type": "range", "id": "split_top", "label": "Main photo width at the top", "min": 34, "max": 74, "step": 1, "unit": "%", "default": 58 },
    { "type": "range", "id": "split_bottom", "label": "Main photo width at the bottom", "min": 34, "max": 74, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "split_rows", "label": "Right column split", "min": 30, "max": 70, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "row_tilt", "label": "Right column seam tilt", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 8 },
    { "type": "range", "id": "height_vh", "label": "Height (share of the screen)", "min": 60, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "max_ratio", "label": "Max height (% of width)", "info": "Keeps the landscape shape on tablets and phones. 64 = about 16:10.", "min": 40, "max": 100, "step": 2, "unit": "%", "default": 64 },
    { "type": "range", "id": "radius", "label": "Corner radius (glass card, and outer corners when edge padding is on)", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 28 },

    { "type": "header", "content": "Phones" },
    { "type": "select", "id": "mobile_layout", "label": "Phone layout", "default": "replica", "options": [
      { "value": "replica", "label": "Same as desktop (scaled)" }, { "value": "stacked", "label": "Stacked" } ] },
    { "type": "checkbox", "id": "show_b_mobile", "label": "Stacked layout: show second photo", "default": true },
    { "type": "select", "id": "mobile_photo_ratio", "label": "Stacked layout: photo shape", "default": "1 / 1", "options": [
      { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait 4:5" }, { "value": "5 / 4", "label": "Landscape 5:4" } ] },

    { "type": "header", "content": "Colour, page" },
    { "type": "color", "id": "base", "label": "Background", "default": "#0b0b0d" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#9966CC" },
    { "type": "range", "id": "pad_top_desktop", "label": "Space for the header (desktop)", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "pad_top_mobile", "label": "Space for the header (phones)", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 60 },
    { "type": "checkbox", "id": "hide_floaters", "label": "Homepage: hide floating extras", "info": "Hides the floating sparkle button and quick-nav strip on the homepage only. The heart/arrow notch and the PULL HERE tab always show.", "default": true }
  ],
  "presets": [ { "name": "LEXE Bento Hero" } ]
}
