{%- comment -%}
  LEXE Bento Hero (2026-10-11, v3: full-bleed editorial)
  Edge-to-edge hero under the floating header: one large photo on the left carrying the headline and CTAs,
  two photos on the right (the lower one carries the product as a frosted glass card). Panels meet on thin
  angled seams (Gutter setting). Height fills the first screen on desktop and never gets taller than
  "Max height" % of the width, so tablets and phones get the same landscape composition scaled down.
  Text sizes follow the width with legible minimums.
  Optional video per panel (snippet lexe-bento-media): the image is always the base layer; the video stays
  transparent until it really plays (engine ported from the Ultimate Hero section). Blocked autoplay keeps the
  image and starts on the first tap; in-app browsers (Instagram, Facebook, TikTok...) and errors show the image.
  Mobile layout "Stacked" gives a straight-edged column under 750px instead.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign st = section.settings
  assign stacked = false
  if st.mobile_layout == 'stacked'
    assign stacked = true
  endif

  comment
    Seam geometry, all in % of the hero. Vertical seam from (xt, 0) to (xb, 100); right column split from
    (seam, yl) to (100, yr).
  endcomment
  assign xt = st.split_top | default: 58 | times: 1.0
  assign xb = st.split_bottom | default: 50 | times: 1.0
  assign yl = st.split_rows | default: 50 | times: 1.0
  assign yr = yl | minus: st.row_tilt
  unless st.slanted
    assign xt = xt | plus: xb | divided_by: 2.0
    assign xb = xt
    assign yr = yl
  endunless
  if xt < xb
    assign xm = xt
    assign xM = xb
  else
    assign xm = xb
    assign xM = xt
  endif
  assign main_a = xt | times: 100 | divided_by: xM | round: 3
  assign main_b = xb | times: 100 | divided_by: xM | round: 3
  if main_a < main_b
    assign main_min = main_a
  else
    assign main_min = main_b
  endif
  assign rw = 100 | minus: xm
  assign xs_l = xb | minus: xt | times: yl | divided_by: 100 | plus: xt
  assign r_top = xt | minus: xm | times: 100 | divided_by: rw | round: 3
  assign r_mid = xs_l | minus: xm | times: 100 | divided_by: rw | round: 3
  assign r_bot = xb | minus: xm | times: 100 | divided_by: rw | round: 3
  if yl > yr
    assign yhi = yl
    assign ylo = yr
  else
    assign yhi = yr
    assign ylo = yl
  endif
  assign t_yl = yl | times: 100 | divided_by: yhi | round: 3
  assign t_yr = yr | times: 100 | divided_by: yhi | round: 3
  assign bh = 100 | minus: ylo
  assign b_yl = yl | minus: ylo | times: 100 | divided_by: bh | round: 3
  assign b_yr = yr | minus: ylo | times: 100 | divided_by: bh | round: 3

  assign img_a = st.image_a
  assign img_b = st.image_b
  assign thumb_p = st.thumb_product
  if thumb_p != blank and thumb_p.tags contains 'needs-clean-image'
    assign thumb_p = nil
  endif
  assign prod = st.product
  if prod != blank and prod.tags contains 'needs-clean-image'
    assign prod = nil
  endif
  assign prod_img = nil
  if prod != blank
    assign prod_img = prod.featured_media.preview_image
    assign pi = st.product_image_position | minus: 1
    if pi >= 0 and prod.media.size > pi
      assign prod_img = prod.media[pi].preview_image
    endif
  endif
  assign pos_a = st.image_a_position | strip
  if pos_a == blank and img_a != blank
    assign pos_a = img_a.presentation.focal_point
  endif
  assign pos_b = st.image_b_position | strip
  if pos_b == blank and img_b != blank
    assign pos_b = img_b.presentation.focal_point
  endif
  assign pos_p = st.product_image_crop | strip
  assign eager_a = false
  if section.index <= 3
    assign eager_a = true
  endif
  assign scrim = st.overlay_opacity | default: 70 | divided_by: 100.0
  assign scrim2 = scrim | times: 0.6 | round: 3
  assign r = st.radius | default: 28
  assign mainsz = xM | append: 'vw'
  assign rightsz = rw | append: 'vw'
-%}
<style>
  {%- if st.hide_floaters and template.name == 'index' %}
  /* Homepage only: hide floating extras over the hero. The apex notch and PULL HERE tab stay visible (Jay, 2026-10-11). */
  #ads-agent-host, .apex-qn { display: none !important; visibility: hidden !important; }
  {%- endif %}
  {%- if template.name == 'index' %}
  /* Phones: start the PULL HERE tab (vanquish-scratch) just below the hero so it doesn't sit on the headline links. */
  @media (max-width: 749px) {
    body .vqsc .vqsc-tag { top: max(var(--vqsc-tag-offset, 50vh), calc({{ st.pad_top_mobile }}px + {{ st.max_ratio | default: 64 }}vw + 62px)); }
  }
  {%- endif %}
  #lxb-{{ sid }} {
    --lxb-accent: {{ st.accent | default: '#9966CC' }};
    --lxb-g: {{ st.gutter }}px;
    --lxb-pad: {{ st.edge_pad }}px;
    --lxb-top: {{ st.pad_top_desktop }}px;
    position: relative; isolation: isolate; overflow: hidden;
    background: {{ st.base | default: '#0b0b0d' }}; color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'SF Pro', Inter, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    padding: var(--lxb-top) var(--lxb-pad) var(--lxb-pad);
  }
  #lxb-{{ sid }} *, #lxb-{{ sid }} *::before, #lxb-{{ sid }} *::after { box-sizing: border-box; }
  #lxb-{{ sid }} .lxb__grid {
    position: relative;
    /* Fill the first screen under the header, but never taller than Max height % of the width (keeps the landscape shape) */
    height: min(calc(100vh * {{ st.height_vh }} / 100 - var(--lxb-top) - var(--lxb-pad)), calc((100vw - var(--lxb-pad) * 2) * {{ st.max_ratio }} / 100));
    height: min(calc(100svh * {{ st.height_vh }} / 100 - var(--lxb-top) - var(--lxb-pad)), calc((100vw - var(--lxb-pad) * 2) * {{ st.max_ratio }} / 100));
    min-height: 200px;
    {%- if st.edge_pad > 0 %} border-radius: {{ r }}px; overflow: hidden;{% endif %}
  }
  #lxb-{{ sid }} .lxb__p { position: absolute; overflow: hidden; background: #141417; }
  #lxb-{{ sid }} .lxb__main { left: 0; top: 0; bottom: 0; width: {{ xM }}%;
    clip-path: polygon(0 0, calc({{ main_a }}% - var(--lxb-g) / 2) 0, calc({{ main_b }}% - var(--lxb-g) / 2) 100%, 0 100%); }
  #lxb-{{ sid }} .lxb__img--b { left: {{ xm }}%; right: 0; top: 0; height: {{ yhi }}%;
    clip-path: polygon(calc({{ r_top }}% + var(--lxb-g) / 2) 0, 100% 0, 100% calc({{ t_yr }}% - var(--lxb-g) / 2), calc({{ r_mid }}% + var(--lxb-g) / 2) calc({{ t_yl }}% - var(--lxb-g) / 2)); }
  #lxb-{{ sid }} .lxb__prod { left: {{ xm }}%; right: 0; bottom: 0; height: {{ bh }}%;
    clip-path: polygon(calc({{ r_mid }}% + var(--lxb-g) / 2) calc({{ b_yl }}% + var(--lxb-g) / 2), 100% calc({{ b_yr }}% + var(--lxb-g) / 2), 100% 100%, calc({{ r_bot }}% + var(--lxb-g) / 2) 100%); }

  /* Media layers: image (base, always there) < video (hidden until playing) < scrim < link < text */
  #lxb-{{ sid }} .lxb__p img, #lxb-{{ sid }} .lxb__vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  #lxb-{{ sid }} .lxb__vid { z-index: 1; opacity: 0; transition: opacity .6s ease; pointer-events: none; background: transparent; }
  #lxb-{{ sid }} .lxb__vid.is-playing { opacity: 1; }
  #lxb-{{ sid }} .lxb__vid[hidden] { display: none !important; }
  #lxb-{{ sid }} .lxb__vid::-webkit-media-controls, #lxb-{{ sid }} .lxb__vid::-webkit-media-controls-start-playback-button, #lxb-{{ sid }} .lxb__vid::-webkit-media-controls-overlay-play-button { display: none !important; -webkit-appearance: none; }
  #lxb-{{ sid }} .lxb__main::after { content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: linear-gradient(0deg, rgba(0,0,0,{{ scrim }}) 0%, rgba(0,0,0,{{ scrim2 }}) 38%, rgba(0,0,0,0) 68%), linear-gradient(90deg, rgba(0,0,0,{{ scrim2 }}) 0%, rgba(0,0,0,0) 62%); }
  #lxb-{{ sid }} .lxb__img--b::after { content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0) 60%, rgba(0,0,0,.28)); }
  #lxb-{{ sid }} .lxb__link { position: absolute; inset: 0; z-index: 3; }
  #lxb-{{ sid }} .lxb__ph { position: absolute; inset: 0; display: grid; place-items: center; color: rgba(255,255,255,.4); font-size: 13px; }

  /* Headline, on the main photo */
  #lxb-{{ sid }} .lxb__copy { position: absolute; z-index: 4; left: 0; bottom: 0; pointer-events: none;
    width: calc({{ main_min }}% - var(--lxb-g)); text-shadow: 0 1px 14px rgba(0,0,0,.35); padding: 0 clamp(14px, 3.4vw, 64px) clamp(14px, 3.2vw, 60px); }
  #lxb-{{ sid }} .lxb__copy a { pointer-events: auto; }
  #lxb-{{ sid }} .lxb__eyebrow { margin: 0 0 clamp(4px, .7vw, 14px); font-size: clamp(9px, .9vw, 13px); line-height: 1.3; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: rgba(255,255,255,.8); }
  #lxb-{{ sid }} .lxb__title { margin: 0; font-size: clamp(26px, 6.4vw, 116px); line-height: .94; letter-spacing: -.045em; font-weight: 700; color: #fff; text-wrap: balance; }
  #lxb-{{ sid }} .lxb__sub { margin: clamp(6px, 1.1vw, 20px) 0 0; max-width: 34em; font-size: clamp(11px, 1.2vw, 19px); line-height: 1.4; color: rgba(255,255,255,.82); }
  #lxb-{{ sid }} .lxb__row { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(6px, 1vw, 18px) clamp(10px, 1.4vw, 24px); margin-top: clamp(10px, 1.8vw, 32px); }
  #lxb-{{ sid }} .lxb__thumb { position: relative; flex: 0 0 auto; width: clamp(34px, 3.6vw, 60px); aspect-ratio: 1; border-radius: clamp(8px, .9vw, 14px); overflow: hidden; background: #fff; display: block; }
  #lxb-{{ sid }} .lxb__thumb img, #lxb-{{ sid }} .lxb__thumb .lxb__vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #lxb-{{ sid }} .lxb__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .45em;
    min-height: clamp(32px, 3.4vw, 54px); border-radius: 999px; text-decoration: none; white-space: nowrap;
    font-family: inherit; font-size: clamp(12px, 1.1vw, 17px); line-height: 1; font-weight: 600; letter-spacing: -.01em;
    transition: transform .18s cubic-bezier(.2,.8,.2,1), background-color .18s ease, opacity .18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  #lxb-{{ sid }} .lxb__btn:active { transform: scale(.97); }
  #lxb-{{ sid }} .lxb__btn--primary { padding: 0 clamp(14px, 1.7vw, 30px); background: var(--lxb-accent); color: #0b0b0d; }
  #lxb-{{ sid }} .lxb__btn--text { padding: 0 2px; color: #fff; }
  #lxb-{{ sid }} .lxb__btn--text svg { width: .9em; height: .9em; transition: transform .18s ease; }
  #lxb-{{ sid }} .lxb__btn:focus-visible, #lxb-{{ sid }} .lxb__link:focus-visible, #lxb-{{ sid }} .lxb__thumb:focus-visible, #lxb-{{ sid }} .lxb__vbtn:focus-visible { outline: 2px solid var(--lxb-accent); outline-offset: 2px; }
  #lxb-{{ sid }} .lxb__link:focus-visible { outline-offset: -4px; }

  /* Chips: solid semi-opaque fill, no blur over the big photos */
  #lxb-{{ sid }} .lxb__chip { position: absolute; z-index: 4; pointer-events: none; right: clamp(8px, 1.6vw, 28px); bottom: clamp(8px, 1.6vw, 28px);
    padding: .6em .95em; border-radius: 999px; background: rgba(12,12,14,.62); color: #fff; font-size: clamp(9px, .85vw, 13px); line-height: 1; font-weight: 600; }
  #lxb-{{ sid }} .lxb__img--b .lxb__chip { top: clamp(8px, 1.6vw, 28px); bottom: auto; }
  #lxb-{{ sid }} .lxb__main .lxb__chip { top: clamp(8px, 1.6vw, 28px); bottom: auto; left: clamp(14px, 3.4vw, 64px); right: auto; }

  /* Product: a frosted glass card on its own photo */
  #lxb-{{ sid }} .lxb__card { position: absolute; z-index: 4; pointer-events: none; right: clamp(8px, 1.6vw, 28px); bottom: clamp(8px, 1.6vw, 28px);
    max-width: calc(100% - clamp(8px, 1.6vw, 28px) * 2); padding: clamp(8px, 1.1vw, 18px) clamp(10px, 1.4vw, 22px);
    border-radius: clamp(10px, 1.3vw, {{ r }}px); background: rgba(18,18,22,.46);
    -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.14); }
  /* Keep the product card clear of the apex notch on the right screen edge (56px wide incl. offset). */
  @media (min-width: 600px) { #lxb-{{ sid }} .lxb__card { right: max(clamp(8px, 1.6vw, 28px), 66px); } }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { #lxb-{{ sid }} .lxb__card { background: rgba(18,18,22,.78); } }
  #lxb-{{ sid }} .lxb__prod-k { font-size: clamp(8px, .75vw, 11px); letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: rgba(255,255,255,.65); margin: 0 0 .5em; }
  #lxb-{{ sid }} .lxb__prod-t { font-size: clamp(11px, 1.2vw, 19px); line-height: 1.2; font-weight: 600; letter-spacing: -.015em; margin: 0; }
  #lxb-{{ sid }} .lxb__prod-pr { font-size: clamp(10px, 1vw, 15px); color: rgba(255,255,255,.8); margin: .3em 0 0; font-variant-numeric: tabular-nums; }
  #lxb-{{ sid }} .lxb__pill { display: inline-flex; align-items: center; gap: .3em; margin-top: .55em; font-size: clamp(10px, .95vw, 14px); font-weight: 600; color: #fff; }
  #lxb-{{ sid }} .lxb__pill svg { width: .95em; height: .95em; transition: transform .18s ease; }

  #lxb-{{ sid }} .lxb__vbtn {
    position: absolute; z-index: 5; top: clamp(8px, 1.2vw, 18px); right: clamp(8px, 1.2vw, 18px); width: 36px; height: 36px; border-radius: 50%; border: 0; padding: 0; cursor: pointer;
    display: grid; place-items: center; color: #fff; background: rgba(12,12,14,.6); -webkit-tap-highlight-color: transparent;
  }
  #lxb-{{ sid }} .lxb__vbtn[hidden] { display: none; }
  #lxb-{{ sid }} .lxb__vbtn .lxb__vbtn-play { display: none; }
  #lxb-{{ sid }} .lxb__vbtn.is-paused .lxb__vbtn-play { display: block; }
  #lxb-{{ sid }} .lxb__vbtn.is-paused .lxb__vbtn-pause { display: none; }

  @media (hover: hover) {
    #lxb-{{ sid }} .lxb__p > img { transition: transform 1.1s cubic-bezier(.2,.8,.2,1); }
    #lxb-{{ sid }} .lxb__p:hover > img { transform: scale(1.02); }
    #lxb-{{ sid }} .lxb__btn--primary:hover { opacity: .92; }
    #lxb-{{ sid }} .lxb__btn--text:hover svg, #lxb-{{ sid }} .lxb__prod:hover .lxb__pill svg { transform: translateX(3px); }
  }
  @media (max-width: 749px) {
    #lxb-{{ sid }} { --lxb-g: {{ st.gutter_mobile }}px; --lxb-top: {{ st.pad_top_mobile }}px; }
    {%- unless st.show_thumb_mobile %}
    #lxb-{{ sid }} .lxb__thumb { display: none; }
    {%- endunless %}
    {%- unless st.show_sub_mobile %}
    #lxb-{{ sid }} .lxb__sub { display: none; }
    {%- endunless %}
    {%- unless st.video_mobile %}
    #lxb-{{ sid }} .lxb__vid, #lxb-{{ sid }} .lxb__vbtn { display: none !important; }
    {%- endunless %}
    {%- if stacked %}
    #lxb-{{ sid }} .lxb__grid { height: auto; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--lxb-g); }
    #lxb-{{ sid }} .lxb__p { position: relative; inset: auto !important; width: auto !important; height: auto !important; clip-path: none !important; aspect-ratio: {{ st.mobile_photo_ratio | default: '1 / 1' }}; }
    #lxb-{{ sid }} .lxb__main { grid-column: 1 / -1; aspect-ratio: 4 / 5; }
    #lxb-{{ sid }} .lxb__copy { width: 100%; }
    #lxb-{{ sid }} .lxb__title { font-size: clamp(34px, 11vw, 52px); }
    {%- unless st.show_b_mobile %}
    #lxb-{{ sid }} .lxb__img--b { display: none; }
    #lxb-{{ sid }} .lxb__prod { grid-column: 1 / -1; }
    {%- endunless %}
    {%- endif %}
  }
  @media (prefers-reduced-motion: reduce) {
    #lxb-{{ sid }} * { transition: none !important; }
    {%- if st.video_reduced_motion %}
    #lxb-{{ sid }} .lxb__vid, #lxb-{{ sid }} .lxb__vbtn { display: none !important; }
    {%- endif %}
  }
</style>

<section id="lxb-{{ sid }}" class="lxb" aria-label="{{ st.title | strip_html | escape }}" data-video-mobile="{% if st.video_mobile %}1{% else %}0{% endif %}" data-video-rm="{% if st.video_reduced_motion %}1{% else %}0{% endif %}" data-video-defer="{% if st.video_defer %}1{% else %}0{% endif %}">
  <div class="lxb__grid">
    <div class="lxb__p lxb__main">
      {%- if img_a != blank or st.image_a_video != blank or st.image_a_video_url != blank -%}
        {%- render 'lexe-bento-media', defer: st.video_defer, img: img_a, video: st.image_a_video, video_url: st.image_a_video_url, poster: st.image_a_poster, pos: pos_a, eager: eager_a, widths: '480, 640, 800, 960, 1120, 1350, 1600, 1920', sizes: mainsz, alt: st.image_a_alt, img_width: 1920, controls: st.image_a_video_controls, label: st.image_a_label -%}
      {%- else -%}<div class="lxb__ph">Add an image</div>{%- endif -%}
      {%- if st.image_a_link != blank -%}<a class="lxb__link" href="{{ st.image_a_link }}" aria-label="{{ st.image_a_label | default: st.image_a_alt | escape }}" data-lxb-cta="image_a"></a>{%- endif -%}
      {%- if st.image_a_label != blank -%}<span class="lxb__chip">{{ st.image_a_label }}</span>{%- endif -%}
      <div class="lxb__copy">
        {%- if st.eyebrow != blank -%}<p class="lxb__eyebrow">{{ st.eyebrow }}</p>{%- endif -%}
        <h1 class="lxb__title">{{ st.title }}</h1>
        {%- if st.subline != blank -%}<p class="lxb__sub">{{ st.subline }}</p>{%- endif -%}
        <div class="lxb__row">
          {%- if st.show_thumb and thumb_p != blank and thumb_p.featured_media != blank -%}
            <a class="lxb__thumb" href="{{ thumb_p.url }}" aria-label="{{ thumb_p.title | escape }}" data-lxb-cta="thumb">
              {%- render 'lexe-bento-media', defer: st.video_defer, img: thumb_p.featured_media.preview_image, video: st.thumb_video, video_url: st.thumb_video_url, poster: nil, pos: '', eager: false, widths: '120, 180', sizes: '60px', alt: thumb_p.title, img_width: 240, controls: false, label: thumb_p.title -%}
            </a>
          {%- endif -%}
          {%- if st.btn1_label != blank -%}<a class="lxb__btn lxb__btn--primary" href="{{ st.btn1_link | default: '/collections/lexe' }}" data-lxb-cta="primary">{{ st.btn1_label }}</a>{%- endif -%}
          {%- if st.btn2_label != blank -%}<a class="lxb__btn lxb__btn--text" href="{{ st.btn2_link | default: '/collections' }}" data-lxb-cta="secondary">{{ st.btn2_label }}<svg viewBox="0 0 14 14" aria-hidden="true"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{%- endif -%}
        </div>
      </div>
    </div>

    <div class="lxb__p lxb__img--b">
      {%- if img_b != blank or st.image_b_video != blank or st.image_b_video_url != blank -%}
        {%- render 'lexe-bento-media', defer: st.video_defer, img: img_b, video: st.image_b_video, video_url: st.image_b_video_url, poster: st.image_b_poster, pos: pos_b, eager: false, widths: '360, 480, 640, 800, 960, 1120, 1350', sizes: rightsz, alt: st.image_b_alt, img_width: 1920, controls: st.image_b_video_controls, label: st.image_b_label -%}
      {%- else -%}<div class="lxb__ph">Add an image</div>{%- endif -%}
      {%- if st.image_b_link != blank -%}<a class="lxb__link" href="{{ st.image_b_link }}" aria-label="{{ st.image_b_label | default: st.image_b_alt | escape }}" data-lxb-cta="image_b"></a>{%- endif -%}
      {%- if st.image_b_label != blank -%}<span class="lxb__chip">{{ st.image_b_label }}</span>{%- endif -%}
    </div>

    <div class="lxb__p lxb__prod">
      {%- if prod != blank -%}
        {%- if prod_img != blank or st.product_video != blank or st.product_video_url != blank -%}
          {%- render 'lexe-bento-media', defer: st.video_defer, img: prod_img, video: st.product_video, video_url: st.product_video_url, poster: st.product_poster, pos: pos_p, eager: false, widths: '360, 480, 640, 800, 960, 1120, 1350', sizes: rightsz, alt: prod.title, img_width: 1920, controls: st.product_video_controls, label: prod.title -%}
        {%- endif -%}
        <a class="lxb__link" href="{{ prod.url }}" aria-label="{{ st.product_cta | default: 'Explore' | escape }} {{ prod.title | escape }}, {{ prod.price | money | strip_html | escape }}" data-lxb-cta="product" data-lxb-product="{{ prod.handle }}"></a>
        <div class="lxb__card" aria-hidden="true">
          {%- if st.product_kicker != blank -%}<p class="lxb__prod-k">{{ st.product_kicker }}</p>{%- endif -%}
          <p class="lxb__prod-t">{{ prod.title }}</p>
          <p class="lxb__prod-pr">{% if prod.price_varies %}From {% endif %}{{ prod.price | money }}</p>
          <span class="lxb__pill">{{ st.product_cta | default: 'Explore' }}<svg viewBox="0 0 14 14" aria-hidden="true"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
      {%- else -%}<div class="lxb__ph">Pick a product</div>{%- endif -%}
    </div>
  </div>
</section>

<script>
(function () {
  var ROOT = document.getElementById('lxb-{{ sid }}');
  if (!ROOT || ROOT.__lxb) return; ROOT.__lxb = 1;
  function track(name, detail) {
