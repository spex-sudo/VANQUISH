    { "type": "text", "id": "subline", "label": "Line under headline", "default": "Outerwear, dresses and Specs, cut sharp." },
    { "type": "checkbox", "id": "show_sub_mobile", "label": "Show line under headline on mobile", "default": false },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Explore LEXE" },
    { "type": "url", "id": "btn1_link", "label": "Primary button link", "default": "/collections/all" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "Get first look" },
    { "type": "url", "id": "btn2_link", "label": "Secondary button link", "default": "/collections/all" },
    { "type": "checkbox", "id": "show_thumb", "label": "Show thumbnail", "default": true },
    { "type": "checkbox", "id": "show_thumb_mobile", "label": "Show thumbnail on mobile", "default": false },
    { "type": "product", "id": "thumb_product", "label": "Thumbnail product", "info": "Use your newest product with a clean photo. Products tagged needs-clean-image are skipped." },

    { "type": "header", "content": "Main photo (top right)" },
    { "type": "image_picker", "id": "image_a", "label": "Image", "info": "Real LEXE photo, at least 1700px wide. Loads first." },
    { "type": "text", "id": "image_a_position", "label": "Crop position", "info": "Optional, e.g. 50% 15%. Leave blank to use the image's focal point." },
    { "type": "text", "id": "image_a_alt", "label": "Alt text" },
    { "type": "text", "id": "image_a_label", "label": "Label chip" },
    { "type": "url", "id": "image_a_link", "label": "Link" },

    { "type": "header", "content": "Second photo (bottom left)" },
    { "type": "image_picker", "id": "image_b", "label": "Image", "info": "Real LEXE photo, at least 1900px wide, graded like the main photo." },
    { "type": "text", "id": "image_b_position", "label": "Crop position", "info": "Optional, e.g. 50% 20%." },
    { "type": "text", "id": "image_b_alt", "label": "Alt text" },
    { "type": "text", "id": "image_b_label", "label": "Label chip" },
    { "type": "url", "id": "image_b_link", "label": "Link" },
    { "type": "checkbox", "id": "show_b_mobile", "label": "On mobile, swipe between both photos", "info": "Off: the second photo is hidden on mobile.", "default": true },
    { "type": "select", "id": "mobile_photo_ratio", "label": "Mobile photo shape", "default": "1 / 1", "options": [
      { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait 4:5" }, { "value": "5 / 4", "label": "Landscape 5:4" } ] },

    { "type": "header", "content": "Product card (bottom right)" },
    { "type": "product", "id": "product", "label": "Product", "info": "Shows its real name and live price. Products tagged needs-clean-image are skipped." },
    { "type": "range", "id": "product_image_position", "label": "Product photo (0 = featured)", "min": 0, "max": 12, "step": 1, "default": 0 },
    { "type": "text", "id": "product_kicker", "label": "Small label above name" },
    { "type": "text", "id": "product_cta", "label": "Pill text", "default": "Explore" },

    { "type": "header", "content": "Shape" },
    { "type": "checkbox", "id": "slanted", "label": "Angled gutters (desktop)", "info": "Mobile always uses straight edges.", "default": true },
    { "type": "select", "id": "slant_angle", "label": "Angle", "default": "30", "options": [
      { "value": "15", "label": "15°" }, { "value": "20", "label": "20°" }, { "value": "25", "label": "25°" },
      { "value": "30", "label": "30°" }, { "value": "35", "label": "35°" }, { "value": "40", "label": "40°" } ] },
    { "type": "range", "id": "slant_height", "label": "Angled cut height", "min": 60, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "gutter", "label": "Gutter", "min": 6, "max": 24, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 28 },
