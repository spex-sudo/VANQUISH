                        {%- if block.settings.eyebrow != blank -%}<span class="apex-ed-eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
                        {%- if block.settings.headline != blank -%}<span class="apex-ed-h">{{ block.settings.headline | escape }}</span>{%- endif -%}
                        {%- if block.settings.sub != blank -%}<span class="apex-ed-sub">{{ block.settings.sub | escape }}</span>{%- endif -%}
                        {%- if block.settings.cta_label != blank -%}<span class="apex-ed-cta">{{ block.settings.cta_label | escape }} <span aria-hidden="true">→</span></span>{%- endif -%}
                      </span>
                    </a>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if paginate.next -%}
