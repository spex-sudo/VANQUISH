                          width="{{ e_img.width }}" height="{{ e_img.height }}" alt="{{ e_img.alt | default: block.settings.headline | escape }}" loading="lazy" decoding="async"
                          style="object-position: {{ block.settings.focal | default: 'center' }}">
                      {%- endif -%}
