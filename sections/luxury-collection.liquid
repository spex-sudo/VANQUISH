                      assign e_img = block.settings.product.featured_image
                    endif
                    assign e_url = block.settings.cta_link
                    if e_url == blank and block.settings.product != blank
                      assign e_url = block.settings.product.url
                    endif
                    if e_url == blank
                      assign e_url = collection.url
                    endif
                    assign o_d = d_after | times: 2 | minus: 1
                    assign o_m = m_after | times: 2 | minus: 1
                    if forloop.parentloop.last and lx_gi1 < d_after
                      assign o_d = lx_gi1 | times: 2 | plus: 1
