{%- comment -%}
  APEX ZENITH MASTER DISCOVERY — V15
  Conversion-focused rebuild:
    • Quick-add (+) button with variant-aware logic (single variant = direct add; multi = drawer)
    • Hover image swap (second media as on-hover state, no carousel work)
    • Color swatch preview under title (limit 4 + "+N")
    • Smart badges: Sale (with %), New, Low Stock, Bestseller
    • Judge.me ratings rendered directly with product.id (fixes broken @app rendering)
    • Hover lift, focus rings, reduced-motion safety
    • Delegated event handlers (no inline onclick → CSP-safe)
    • Skeleton placeholders during infinite scroll
{%- endcomment -%}

{%- liquid
  assign sid    = section.id
  assign acc    = section.settings.ac
  assign sale_c = section.settings.sale_color
-%}

<style>
  #ApexZenith-{{ sid }} {
    --gap: {{ section.settings.gap }}px;
    --rd: {{ section.settings.rd }}px;
    --ac: {{ acc }};
    --sale: {{ sale_c }};
    --ink: #111;
    --dim: #6b6b6b;
    --line: #ececec;
    --soft: #f7f7f7;
    --new: #2d6a4f;
    --low: #c8102e;

    max-width: {{ section.settings.max_w }}px;
    margin: 0 auto;
    padding: {{ section.settings.p_v }}px 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--ink);
  }

  .apex-grid-{{ sid }} {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat({{ section.settings.pc_cols }}, minmax(0, 1fr));
  }

  /* ── Card ── */
  .apex-card {
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
    contain: layout paint style;
  }
  .apex-card:hover { transform: translateY(-3px); }

  .apex-media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.ratio }};
    border-radius: var(--rd);
    overflow: hidden;
    background: var(--soft);
    margin-bottom: 12px;
  }

  /* Stacked images — one per product media. Active one is opacity:1, rest opacity:0 */
  .apex-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s ease;
    will-change: opacity;
  }
  .apex-img.is-active {
    opacity: 1;
    /* Native View Transitions API support — Chromium 111+ degrades gracefully */
    view-transition-name: var(--vt-name, none);
  }
  .apex-media:hover .apex-img.is-active { transform: scale(1.04); }

  /* Image counter pill — "1/4" indicator, bottom-left (out of the way of badges + wishlist) */
  .apex-counter {
    position: absolute;
    bottom: 8px;
    left: 8px;
    z-index: 5;
    padding: 3px 8px;
    border-radius: 100px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: rgba(255,255,255,0.92);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.22s;
  }
  .apex-card:hover .apex-counter { opacity: 1; }

  @media (max-width: 768px) {
    .apex-counter { opacity: 1; }
  }

  /* Visible mini prev/next buttons — appear on hover (desktop) or always on mobile */
  .apex-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%) scale(0.9);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    -webkit-tap-highlight-color: transparent;
    z-index: 4;
    opacity: 0;
    transition: opacity 0.22s, transform 0.18s, background 0.16s;
  }
  .apex-card:hover .apex-arrow,
  .apex-arrow:focus-visible {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
  .apex-arrow:hover  { background: #fff; }
  .apex-arrow:active { transform: translateY(-50%) scale(0.9); }
  .apex-arrow svg {
    width: 12px;
    height: 12px;
    stroke: #111;
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .apex-arrow-prev { left: 8px; }
  .apex-arrow-next { right: 8px; }

  /* Mobile: arrows hidden — swipe gesture handles navigation */
  @media (max-width: 768px) {
    .apex-arrow { display: none; }
  }

  /* Dot indicators — bottom-center row */
  .apex-dots {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
    z-index: 5;
    padding: 4px 6px;
    border-radius: 100px;
    background: rgba(0,0,0,0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }
  .apex-card:hover .apex-dots { opacity: 1; }
  .apex-dots > * { pointer-events: auto; }
  .apex-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255,255,255,0.55);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, transform 0.18s, width 0.2s;
    -webkit-tap-highlight-color: transparent;
    flex-shrink: 0;
  }
  .apex-dot.is-active {
    background: #fff;
    width: 14px;
    border-radius: 100px;
  }
  .apex-dot:hover { background: rgba(255,255,255,0.85); }

  @media (max-width: 768px) {
    .apex-dots { opacity: 1; }
  }

  .apex-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    text-decoration: none;
  }

  /* ── Badges ── */
  .apex-badges {
    position: absolute;
    top: 10px; left: 10px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 4px;
    pointer-events: none;
    align-items: flex-start;
  }
  .apex-bdg {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border-radius: 3px;
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #fff;
    line-height: 1;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .apex-bdg-sale { background: var(--sale); }
  .apex-bdg-new  { background: var(--new); }
  .apex-bdg-low  { background: var(--low); animation: apex-pulse 1.6s ease-in-out infinite; }
  .apex-bdg-best { background: rgba(0,0,0,0.85); }
  .apex-bdg-cust { background: var(--ac); }
  @keyframes apex-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(200,16,46,0); }
    50%      { box-shadow: 0 0 0 6px rgba(200,16,46,0.18); }
  }

  /* ── Wishlist (top-right) ── */
  .apex-wish {
    position: absolute;
    top: 10px; right: 10px;
    z-index: 6;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s, background 0.18s;
    opacity: 0;
  }
  .apex-card:hover .apex-wish,
  .apex-wish.is-saved,
  .apex-wish:focus-visible { opacity: 1; }
  .apex-wish:active { transform: scale(0.9); }
  .apex-wish svg { width: 14px; height: 14px; fill: none; stroke: var(--ink); stroke-width: 1.8; transition: fill 0.2s, stroke 0.2s; }
  .apex-wish.is-saved svg { fill: var(--sale); stroke: var(--sale); }
  .apex-wish.is-saved {
    animation: apex-wish-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes apex-wish-pop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.28); }
    70%  { transform: scale(0.92); }
    100% { transform: scale(1); }
  }

  /* ── Add ── */
  .apex-qa {
    position: absolute;
    bottom: 10px; right: 10px;
    z-index: 6;
    height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    border: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    -webkit-tap-highlight-color: transparent;
    opacity: 1;
    transform: none;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
  }
  .apex-qa:hover { background: #000; }
  .apex-qa:active { opacity: 0.8; }
  .apex-qa.is-loading { pointer-events: none; }
  .apex-qa.is-added { background: #111; }
  .apex-qa-spinner {
    width: 12px; height: 12px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.35);
    border-top-color: #fff;
    animation: apex-spin 0.7s linear infinite;
    display: none;
    position: absolute;
  }
  .apex-qa.is-loading .apex-qa-label { visibility: hidden; }
  .apex-qa.is-loading .apex-qa-spinner { display: block; }
  @keyframes apex-spin { to { transform: rotate(360deg); } }

  /* Mobile: always show quick-add + wishlist */
  @media (max-width: 768px) {
    .apex-qa, .apex-wish {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* ── Info ── */
  .apex-info {
    padding: 4px 2px 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .apex-vendor {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0;
  }
  .apex-title {
    position: relative;
    z-index: 2;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.32;
    color: var(--ink);
    text-decoration: none;
    margin: 0;
    /* clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .apex-title:hover { text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }

  .apex-rating {
    position: relative;
    z-index: 2;
    min-height: 14px;
  }
  /* Style Judge.me badge inline for grid card */
  .apex-rating .jdgm-prev-badge {
    --jdgm-paper: transparent;
  }
  .apex-rating .jdgm-prev-badge__stars { font-size: 12px !important; letter-spacing: -1px; }
  .apex-rating .jdgm-prev-badge__text  { font-size: 10.5px !important; color: var(--dim) !important; margin-left: 4px; }

  .apex-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .apex-price {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .apex-price.is-sale { color: var(--sale); }
  .apex-price-was {
    font-size: 12px;
    color: var(--dim);
    text-decoration: line-through;
  }
  .apex-savings {
    font-size: 10px;
    font-weight: 600;
    color: var(--sale);
    letter-spacing: 0.04em;
    margin-left: auto;
  }

  /* ── Color swatches preview ── */
  .apex-swatches {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 2px;
  }
  .apex-sw {
    width: 13px; height: 13px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.12);
    flex-shrink: 0;
    cursor: pointer;
    transition: transform 0.14s;
    background-size: cover;
  }
  .apex-sw:hover { transform: scale(1.18); }
  .apex-sw-more {
    font-size: 9.5px;
    color: var(--dim);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* ── Toast ── */
  .apex-toast-{{ sid }} {
    position: fixed;
    bottom: 30px; left: 50%;
    transform: translateX(-50%) translateY(20px);
    z-index: 9999;
    background: var(--ink);
    color: #fff;
    padding: 12px 20px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    box-shadow: 0 8px 28px rgba(0,0,0,0.22);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s, transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 40px);
  }
  .apex-toast-{{ sid }}.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .apex-toast-{{ sid }} svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; flex-shrink: 0; }
  .apex-toast-{{ sid }} a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: 4px;
    font-weight: 600;
  }

  /* ── Variant drawer ── */
  .apex-drawer-bd-{{ sid }} {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 9998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s linear;
  }
  .apex-drawer-bd-{{ sid }}.open { opacity: 1; pointer-events: auto; }
  .apex-drawer-{{ sid }} {
    position: fixed;
    left: 50%;
    bottom: 0;
    width: min(420px, 100%);
    transform: translate(-50%, 100%);
    background: #fff;
    color: #111;
    border-radius: 0;
    z-index: 9999;
    transition: transform 0.22s ease;
    max-height: 78vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    border-top: 1px solid #111;
    box-shadow: none;
  }
  .apex-drawer-{{ sid }}.open { transform: translate(-50%, 0); }
  .apex-dr-handle { display: none; }
  .apex-dr-head {
    padding: 18px 18px 14px;
    display: flex; align-items: center; justify-content: space-between;
    flex-shrink: 0;
    border-bottom: 1px solid #e8e8e8;
  }
  .apex-dr-title {
    font-size: 14px; font-weight: 500; letter-spacing: -0.02em;
    margin: 0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    flex: 1;
    padding-right: 12px;
    color: #111;
  }
  .apex-dr-close {
    width: auto; height: auto;
    padding: 0;
    border-radius: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: #111;
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .apex-dr-close svg { display: none; }
  .apex-dr-close::after { content: 'Close'; }
  .apex-dr-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 18px 8px;
    -webkit-overflow-scrolling: touch;
  }
  .apex-dr-opt-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0 0 8px;
  }
  .apex-dr-opt-label + .apex-dr-opt-label { margin-top: 16px; }
  .apex-dr-opts {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-bottom: 4px;
  }
  .apex-dr-opt {
    padding: 8px 12px;
    border-radius: 0;
    background: #fff;
    color: #111;
    border: 1px solid #d8d8d8;
    font: inherit;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    cursor: pointer;
    line-height: 1.2;
  }
  .apex-dr-opt.on {
    background: #111;
    color: #fff;
    border-color: #111;
  }
  .apex-dr-opt:disabled {
    color: #b0b0b0;
    border-color: #eee;
    text-decoration: line-through;
    cursor: not-allowed;
    background: #fff;
  }
  .apex-dr-foot {
    padding: 14px 18px 16px;
    border-top: 1px solid #e8e8e8;
    flex-shrink: 0;
  }
  .apex-dr-cta {
    width: 100%;
    padding: 14px 16px;
    background: #111;
    color: #fff;
    border: 0;
    border-radius: 0;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .apex-dr-cta:disabled { background: #f3f3f3; color: #8a8a8a; cursor: not-allowed; }
  .apex-dr-cta.is-loading .apex-dr-cta-text { opacity: 0.45; }

  /* ── Infinite scroll status ── */
  .apex-status-{{ sid }} {
    margin-top: 60px;
    padding: 30px 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .apex-status-text {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    color: var(--dim);
    font-weight: 500;
  }
  .apex-pulse {
    width: 60px; height: 2px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }
  .apex-pulse::after {
    content: '';
    position: absolute;
    left: -100%;
    width: 100%; height: 100%;
    background: var(--ac);
    box-shadow: 0 0 10px var(--ac);
    animation: apex-slide 1.5s infinite;
    display: none;
  }
  .is-loading .apex-pulse::after { display: block; }
  @keyframes apex-slide {
    0%   { left: -100%; }
    100% { left: 100%; }
  }

  /* ── Ascend ── */
  #ApexAscend-{{ sid }} {
    position: fixed;
    bottom: 30px; right: 30px;
    z-index: 99;
    width: 44px; height: 44px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 14px rgba(0,0,0,0.10);
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 0, 0);
    transition: opacity 0.32s, visibility 0.32s;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  #ApexAscend-{{ sid }}.is-visible {
    opacity: 1;
    visibility: visible;
  }
  #ApexAscend-{{ sid }}:hover { filter: brightness(0.97); }
  #ApexAscend-{{ sid }} svg { width: 16px; fill: var(--ac); }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .apex-grid-{{ sid }} { grid-template-columns: repeat({{ section.settings.mb_cols }}, minmax(0, 1fr)); }
    .apex-title  { font-size: 12.5px; }
    .apex-price  { font-size: 13px; }
    .apex-qa { height: 28px; bottom: 8px; right: 8px; padding: 0 10px; font-size: 10px; }
    .apex-wish   { width: 28px; height: 28px; top: 8px; right: 8px; }
    .apex-wish svg { width: 12px; height: 12px; }
    .apex-bdg    { font-size: 8.5px; padding: 4px 7px; }
    #ApexAscend-{{ sid }} { bottom: 16px; right: 16px; width: 40px; height: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-card, .apex-img,
    .apex-qa, .apex-wish, .apex-toast-{{ sid }},
    .apex-drawer-{{ sid }}, .apex-drawer-bd-{{ sid }} { transition: none !important; }
    .apex-bdg-low, .apex-pulse::after { animation: none !important; }
  }

  /* ── Collection filter ── */
  .apex-ffab-{{ sid }} {
    position: fixed;
    left: 0;
    right: 0;
    bottom: max(18px, env(safe-area-inset-bottom));
    width: max-content;
    margin: 0 auto;
    transform: translate3d(0, 0, 0);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: none;
  }
  .apex-ffab-{{ sid }} svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .apex-ffab-count-{{ sid }} {
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-size: 10px;
    letter-spacing: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .apex-fbd-{{ sid }},
  .apex-filter-{{ sid }} { display: none; }
  .apex-fbd-{{ sid }}.is-open,
  .apex-filter-{{ sid }}.is-open { display: block; }
  .apex-fbd-{{ sid }} {
    position: fixed;
    inset: 0;
    z-index: 130;
    background: rgba(8,8,8,0.32);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .apex-filter-{{ sid }} {
    position: fixed;
    z-index: 131;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(460px, 100%);
    max-height: min(78vh, 720px);
    overflow: auto;
    background: #fff;
    color: #111;
    border-radius: 18px 18px 0 0;
    padding: 18px 18px calc(18px + env(safe-area-inset-bottom));
    box-shadow: 0 -16px 40px rgba(0,0,0,0.16);
  }
  @media (min-width: 760px) {
    .apex-filter-{{ sid }} { bottom: 24px; border-radius: 18px; padding: 22px; }
  }
  .apex-filter-head-{{ sid }} { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .apex-filter-head-{{ sid }} h2 { margin: 0; font-size: 18px; letter-spacing: -0.03em; font-weight: 560; }
  .apex-filter-x-{{ sid }},
  .apex-filter-search-{{ sid }},
  .apex-filter-apply-{{ sid }},
  .apex-filter-clear-{{ sid }} { font: inherit; cursor: pointer; }
  .apex-filter-x-{{ sid }} { border: 0; background: transparent; letter-spacing: 0.12em; text-transform: uppercase; font-size: 11px; }
  .apex-filter-search-{{ sid }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 8px 0 14px;
    padding: 14px 14px;
    border-radius: 12px;
    border: 1px solid rgba(17,17,17,0.12);
    background: #fafafa;
    color: #111;
    text-align: left;
  }
  .apex-filter-search-{{ sid }} small { display: block; margin-top: 3px; color: #6b6b6b; letter-spacing: 0; text-transform: none; font-size: 12px; }
  .apex-filter-search-{{ sid }} span { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; }
  .apex-filter-group-{{ sid }} { border-top: 1px solid rgba(17,17,17,0.08); padding: 12px 0; }
  .apex-filter-group-{{ sid }} p { margin: 0 0 8px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #6b6b6b; }
  .apex-filter-group-{{ sid }} label { display: flex; align-items: center; gap: 8px; padding: 6px 0; font-size: 14px; }
  .apex-filter-group-{{ sid }} select,
  .apex-filter-group-{{ sid }} input[type="number"] {
    font: inherit;
    width: 100%;
    border: 1px solid rgba(17,17,17,0.14);
    border-radius: 10px;
    padding: 10px 12px;
    background: #fff;
  }
  .apex-filter-price-{{ sid }} { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .apex-filter-foot-{{ sid }} { display: flex; gap: 8px; padding-top: 8px; }
  .apex-filter-clear-{{ sid }} {
    flex: 0 0 auto;
    border: 1px solid rgba(17,17,17,0.14);
    background: #fff;
    color: #111;
    border-radius: 999px;
    padding: 12px 16px;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .apex-filter-apply-{{ sid }} {
    flex: 1;
    border: 0;
    background: #111;
    color: #fff;
    border-radius: 999px;
    padding: 12px 16px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .apex-card.is-filtered-out { display: none !important; }

  /* ── LEXE upgrade 2026-10-09: rail, chips, editorial, first-card video ── */
  #ApexZenith-{{ sid }} { --lx-acc: {{ section.settings.lx_accent | default: '#9B6BD1' }}; --lx-acc2: {{ section.settings.lx_accent_2 | default: '#6E3FA3' }}; }
  .apex-rail-{{ sid }}, .apex-chips-{{ sid }} { position: relative; margin: 0 0 {{ section.settings.rail_gap }}px; }
  .apex-rail-{{ sid }} .apex-rail-track, .apex-chips-{{ sid }} .apex-chips-track {
    display: flex; gap: 10px; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none;
    -webkit-overflow-scrolling: touch; touch-action: pan-x pan-y; padding: 2px 2px 4px; scroll-snap-type: x proximity;
  }
  .apex-rail-{{ sid }} .apex-rail-track::-webkit-scrollbar, .apex-chips-{{ sid }} .apex-chips-track::-webkit-scrollbar { display: none; }
  .apex-rtile {
    flex: 0 0 auto; scroll-snap-align: start; display: inline-flex; align-items: center; gap: 10px;
    height: {{ section.settings.rail_tile_h }}px; padding: 0 16px 0 0; border-radius: {{ section.settings.rail_radius }}px;
    background: #0a0a0a; color: #fff; text-decoration: none; overflow: hidden; border: 1px solid #0a0a0a;
    transition: border-color .2s ease, background .2s ease; -webkit-tap-highlight-color: transparent;
  }
  .apex-rtile-img { flex: 0 0 auto; width: {{ section.settings.rail_tile_h }}px; height: 100%; background: #1a1a1a; overflow: hidden; }
  .apex-rtile-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .apex-rtile:hover .apex-rtile-img img { transform: scale(1.08); }
  .apex-rtile-name { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
  .apex-rtile:hover, .apex-rtile:focus-visible { border-color: var(--lx-acc); }
  .apex-rtile.is-current { background: #fff; color: #0a0a0a; border-color: #0a0a0a; box-shadow: inset 0 -3px 0 var(--lx-acc); }
  .apex-rtile:focus-visible, .apex-chip:focus-visible { outline: 2px solid var(--lx-acc); outline-offset: 2px; }
  .apex-chip {
    flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 16px;
    border: 1px solid #d6d6d6; border-radius: 999px; background: #fff; color: #111; text-decoration: none; cursor: pointer;
    font: inherit; font-size: 12px; font-weight: 600; letter-spacing: .06em; white-space: nowrap; transition: border-color .2s, background .2s, color .2s;
    -webkit-tap-highlight-color: transparent;
  }
  .apex-chip:hover { border-color: #111; }
  .apex-chip.is-on { background: #0a0a0a; border-color: #0a0a0a; color: #fff; box-shadow: inset 0 -2px 0 var(--lx-acc); }
  .apex-chip--all { background: #0a0a0a; color: #fff; border-color: #0a0a0a; }
  .apex-chip--all svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .apex-chip--clear { border-color: var(--lx-acc); color: var(--lx-acc2); }
  .apex-chip-sw { width: 12px; height: 12px; border-radius: 50%; border: 1px solid rgba(0,0,0,.2); }

  .apex-ed-{{ sid }} {
    order: var(--o-d); grid-column: span {% if section.settings.pc_cols >= 2 %}2{% else %}1{% endif %};
    position: relative; min-height: 320px; border-radius: var(--rd); overflow: hidden; background: #0a0a0a; contain: layout paint;
  }
  .apex-ed-link { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: block; color: #fff; text-decoration: none; }
  .apex-ed-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .apex-ed-{{ sid }}:hover .apex-ed-img { transform: scale(1.04); }
  .apex-ed-shade { position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 25%, rgba(0,0,0,.55) 55%, rgba(0,0,0,.88) 100%), linear-gradient(135deg, rgba(110,63,163,.3), rgba(0,0,0,0) 55%); }
  .apex-ed-body { position: absolute; left: 0; right: 0; bottom: 0; padding: clamp(18px, 2.4vw, 32px); display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .apex-ed-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 10px; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; color: #fff; }
  .apex-ed-eyebrow::before { content: ''; width: 18px; height: 2px; background: var(--lx-acc); }
  .apex-ed-h { font-family: 'Oswald', 'Arial Narrow', Impact, sans-serif; font-weight: 700; font-size: clamp(26px, 2.6vw, 44px); line-height: .95; text-transform: uppercase; max-width: 16ch; }
  .apex-ed-cta { font-size: 11px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; padding-bottom: 4px; border-bottom: 2px solid var(--lx-acc); }
  .apex-ed-{{ sid }}:hover .apex-ed-cta { border-color: #fff; }

  .apex-fc-video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; opacity: 0; pointer-events: none; transition: opacity .4s ease; }
  .apex-fc-video.is-playing { opacity: 1; }

  @media (max-width: 768px) {
    .apex-ed-{{ sid }} { order: var(--o-m); grid-column: 1 / -1; min-height: 0; aspect-ratio: {{ section.settings.ed_ratio_mobile }}; }
    .apex-rtile { height: {{ section.settings.rail_tile_h_mobile }}px; }
    .apex-rtile-img { width: {{ section.settings.rail_tile_h_mobile }}px; }
    .apex-rtile-name { font-size: 11px; }
    .apex-chip { height: 34px; padding: 0 14px; font-size: 11px; }
    .apex-rail-{{ sid }}, .apex-chips-{{ sid }} { margin-left: -20px; margin-right: -20px; }
    .apex-rail-{{ sid }} .apex-rail-track, .apex-chips-{{ sid }} .apex-chips-track { padding-left: 20px; padding-right: 20px; scroll-padding-left: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .apex-ed-img, .apex-rtile-img img { transition: none; } }


  /* ── CD fix 2026-10-09: collection-page floaters, mobile card chrome, sink tagged ── */
  {%- if template.name == 'collection' and section.settings.hide_floaters -%}
  aside[id^="apex-notch-"], .vqsc-tag, #ads-agent-host, #ApexAscend-{{ sid }}, .apex-qn { display: none !important; visibility: hidden !important; }
  {%- endif -%}
  @media (max-width: 768px) {
    #ApexZenith-{{ sid }} .apex-counter { display: none !important; }
    #ApexZenith-{{ sid }} .apex-dots { left: 8px; transform: none; bottom: 14px; }
  }
  .apex-ed-eyebrow::before { background: {{ section.settings.ed_mark_color | default: '#9966CC' }} !important; }
  .apex-ed-sub { font-size: 14px; line-height: 1.45; max-width: 38ch; color: rgba(255,255,255,.86); }
  @media (max-width: 768px) { .apex-ed-sub, .apex-ed-eyebrow { display: none !important; } }
  .apex-rtile-name { text-transform: none; letter-spacing: .06em; font-size: 13px; }
</style>

<div id="ApexZenith-{{ sid }}" data-apex-section="{{ sid }}">
  {%- comment -%}
    PRODUCT SOURCE
    On a collection template: paginate the literal `collection.products` so
    Shopify's engine correctly scopes products to that collection (sort, filter,
    and pagination all work as expected). `collection` is always defined on
    collection.* templates and is never blank there.
    On every other template (homepage, /collections index, search, etc.):
    paginate `collections.all.products` so the grid still populates with the
    full catalogue as a sensible default.
    Two separate paginate blocks are required because Shopify's `paginate` tag
    requires a literal object path — it does not correctly resolve through a
    Liquid-assigned variable, causing it to silently fall back to all-products
    behaviour regardless of which collection is being viewed.
  {%- endcomment -%}

  {%- if template.name == 'collection' -%}

    {%- comment %} ── COLLECTION PAGE — show only this collection's products ── {%- endcomment %}
    {%- comment -%} ── LEXE upgrade 2026-10-09: rail + quick-filter chips (collection pages) ── {%- endcomment -%}
    {%- liquid
      assign lx_cur_handle = collection.handle
      assign lx_ed_count = 0
      for b in section.blocks
        if b.type == 'editorial'
          assign lx_ed_count = lx_ed_count | plus: 1
        endif
      endfor
    -%}
    {%- if section.settings.show_rail -%}
      <nav class="apex-rail-{{ sid }}" aria-label="{{ section.settings.rail_label | escape }}">
        <div class="apex-rail-track" data-lx-scroller>
          {%- if section.settings.rail_auto_types -%}
            {%- for f in collection.filters -%}
              {%- if f.param_name == 'filter.p.product_type' -%}
                {%- for v in f.values limit: section.settings.rail_type_limit -%}
                  {%- if v.count > 0 or v.active -%}
                    {%- assign t_img = nil -%}
                    {%- for tp in collection.products limit: 50 -%}
                      {%- if tp.type == v.value and tp.featured_image != blank -%}{%- assign t_img = tp.featured_image -%}{%- break -%}{%- endif -%}
                    {%- endfor -%}
                    <a class="apex-rtile{% if v.active %} is-current{% endif %}" href="{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}" data-lx-sub="type:{{ v.value | escape }}"{% if v.active %} aria-current="true"{% endif %}>
                      <span class="apex-rtile-img">{%- if t_img -%}<img src="{{ t_img | image_url: width: 120 }}" srcset="{{ t_img | image_url: width: 120 }} 1x, {{ t_img | image_url: width: 200 }} 2x" width="60" height="60" alt="" loading="lazy" decoding="async">{%- endif -%}</span>
                      <span class="apex-rtile-name">{{ v.label }}</span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'rail_collection' and block.settings.collection != blank -%}
              {%- liquid
                assign rc = block.settings.collection
                assign r_img = block.settings.image
                if r_img == blank and block.settings.product != blank
                  assign r_img = block.settings.product.featured_image
                endif
                if r_img == blank and block.settings.use_collection_image
                  assign r_img = rc.featured_image
                endif
                assign r_name = block.settings.title | default: rc.title
                assign r_cur = false
                if rc.handle == lx_cur_handle
                  assign r_cur = true
                endif
              -%}
              <a class="apex-rtile{% if r_cur %} is-current{% endif %}" href="{{ rc.url }}" data-lx-sub="collection:{{ rc.handle }}" {{ block.shopify_attributes }}{% if r_cur %} aria-current="page"{% endif %}>
                <span class="apex-rtile-img">{%- if r_img != blank -%}<img src="{{ r_img | image_url: width: 120 }}" srcset="{{ r_img | image_url: width: 120 }} 1x, {{ r_img | image_url: width: 200 }} 2x" width="60" height="60" alt="" loading="lazy" decoding="async">{%- endif -%}</span>
                <span class="apex-rtile-name">{{ r_name | escape }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </nav>
    {%- endif -%}

    {%- if section.settings.show_chips -%}
      {%- liquid
        assign chip_keys = section.settings.chip_filters | downcase | split: ','
        assign lx_any_active = false
      -%}
      <div class="apex-chips-{{ sid }}" role="toolbar" aria-label="Quick filters">
        <div class="apex-chips-track" data-lx-scroller>
          {%- if section.settings.chip_show_all -%}
            <button type="button" class="apex-chip apex-chip--all" data-lx-chip="all-filters" data-lx-open-filters>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>{{ section.settings.chip_all_label | escape }}
            </button>
          {%- endif -%}
          {%- for f in collection.filters -%}
            {%- liquid
              assign fl = f.label | downcase | strip
              assign fp = f.param_name | downcase
              assign want = false
              for k in chip_keys
                assign kk = k | strip
                if kk != blank
                  if fl == kk or fp contains kk
                    assign want = true
                  endif
                endif
              endfor
            -%}
            {%- if want -%}
              {%- if f.type == 'price_range' -%}
                {%- if section.settings.chip_price_ranges != blank -%}
                  {%- liquid
                    assign pbase = f.url_to_remove
                    if pbase contains '?'
                      assign pjoin = '&'
                    else
                      assign pjoin = '?'
                    endif
                    assign cur_min = f.min_value.value | default: -1
                    assign cur_max = f.max_value.value | default: -1
                    assign ranges = section.settings.chip_price_ranges | split: ','
                  -%}
                  {%- for r in ranges -%}
                    {%- liquid
                      assign rp = r | strip | split: '-'
                      assign rmin = rp[0] | strip
                      assign rmax = rp[1] | strip
                      assign rurl = pbase | append: pjoin
                      if rmin != blank and rmin != '0'
                        assign rurl = rurl | append: f.min_value.param_name | append: '=' | append: rmin | append: '&'
                      endif
                      if rmax != blank
                        assign rurl = rurl | append: f.max_value.param_name | append: '=' | append: rmax
                      endif
                      assign rmin_c = rmin | times: 100
                      assign rmax_c = rmax | times: 100
                      assign r_on = false
                      if rmax != blank and cur_max == rmax_c
                        assign r_on = true
                      endif
                      if rmax == blank and rmin != blank and cur_min == rmin_c and cur_max == -1
                        assign r_on = true
                      endif
                      if r_on
                        assign lx_any_active = true
                        assign rurl = pbase
                      endif
                      if rmin == blank or rmin == '0'
                        capture rlabel
                          echo 'Under '
                          echo rmax | times: 100 | money_without_trailing_zeros
                        endcapture
                      elsif rmax == blank
                        capture rlabel
                          echo rmin | times: 100 | money_without_trailing_zeros
                          echo '+'
                        endcapture
                      else
                        capture rlabel
                          echo rmin | times: 100 | money_without_trailing_zeros
                          echo '–'
                          echo rmax | times: 100 | money_without_trailing_zeros
                        endcapture
                      endif
                    -%}
                    <a class="apex-chip{% if r_on %} is-on{% endif %}" href="{{ rurl }}" data-lx-chip="price:{{ r | strip }}"{% if r_on %} aria-pressed="true"{% endif %}>{{ rlabel | strip }}</a>
                  {%- endfor -%}
                {%- endif -%}
              {%- else -%}
                {%- for v in f.values limit: section.settings.chip_values_per_filter -%}
                  {%- if v.count > 0 or v.active -%}
                    {%- if v.active -%}{%- assign lx_any_active = true -%}{%- endif -%}
                    {%- assign vlabel = v.label -%}
                    {%- if fp contains 'availability' -%}{%- if v.value == '1' -%}{%- assign vlabel = section.settings.chip_instock_label -%}{%- else -%}{%- continue -%}{%- endif -%}{%- endif -%}
                    <a class="apex-chip{% if v.active %} is-on{% endif %}" href="{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}" data-lx-chip="{{ f.label | escape }}:{{ v.label | escape }}"{% if v.active %} aria-pressed="true"{% endif %}>
                      {%- if f.presentation == 'swatch' and v.swatch.color -%}<span class="apex-chip-sw" style="background: {{ v.swatch.color }}"></span>{%- endif -%}
                      {{ vlabel | escape }}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.chip_sorts != blank -%}
            {%- assign sorts = section.settings.chip_sorts | split: ',' -%}
            {%- for so in sorts -%}
              {%- assign sp = so | split: ':' -%}
              {%- assign sv = sp[0] | strip -%}
              {%- assign sl = sp[1] | default: sv | strip -%}
              <a class="apex-chip apex-chip--sort{% if collection.sort_by == sv %} is-on{% endif %}" href="{{ collection.url }}?sort_by={{ sv }}" data-lx-chip="sort:{{ sv }}" data-lx-sort="{{ sv }}"{% if collection.sort_by == sv %} aria-pressed="true"{% endif %}>{{ sl | escape }}</a>
            {%- endfor -%}
          {%- endif -%}
          {%- if lx_any_active -%}
            <a class="apex-chip apex-chip--clear" href="{{ collection.url }}{% if collection.sort_by != collection.default_sort_by %}?sort_by={{ collection.sort_by }}{% endif %}" data-lx-chip="clear">{{ section.settings.chip_clear_label | escape }} ✕</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- paginate collection.products by section.settings.page_limit -%}
      <div class="apex-grid-{{ sid }}" id="ApexGrid-{{ sid }}">
        {%- for product in collection.products -%}
        {%- liquid
          comment
            LCP: first row (= desktop column count) loads eagerly
          endcomment
          assign eager_max = section.settings.pc_cols
          assign is_eager = false
          if forloop.index0 < eager_max
            assign is_eager = true
          endif
        -%}
        {%- liquid
          assign on_sale       = false
          assign discount_pct  = 0
          assign savings       = 0
          if product.compare_at_price > product.price
            assign on_sale = true
            assign savings = product.compare_at_price | minus: product.price
            assign discount_pct = savings | times: 100 | divided_by: product.compare_at_price | round
          endif

          assign first_var      = product.selected_or_first_available_variant
          assign avail_inv      = first_var.inventory_quantity
          assign track_inv      = first_var.inventory_management
          assign is_low_stock   = false
          if track_inv != blank and avail_inv > 0 and avail_inv <= section.settings.low_stock_threshold
            assign is_low_stock = true
          endif

          assign is_new = false
          assign new_hours = section.settings.new_hours
          if new_hours > 0
            assign cutoff_seconds = new_hours | times: 3600
            assign now_ts = 'now' | date: '%s' | times: 1
            assign cutoff_ts = now_ts | minus: cutoff_seconds
            assign created_ts = product.created_at | date: '%s' | times: 1
            if created_ts > cutoff_ts
              assign is_new = true
            endif
          endif

          assign is_best = false
          if product.tags contains 'bestseller' or product.tags contains 'best-seller'
            assign is_best = true
          endif

          assign custom_badge = product.metafields.theme.badge_text.value | default: product.metafields.theme.badge_text
          if custom_badge.first
            assign custom_badge = custom_badge.first
          endif

          assign max_imgs = section.settings.max_card_images | default: 4
          assign img_count = product.images.size
          if img_count > max_imgs
            assign img_count = max_imgs
          endif

          assign color_opt_idx = 0
          for opt in product.options_with_values
            assign opt_lc = opt.name | downcase
            if opt_lc == 'color' or opt_lc == 'colour'
              assign color_opt_idx = forloop.index
              break
            endif
          endfor
        -%}

        {%- if forloop.first -%}{%- assign lx_vis = 0 -%}{%- endif -%}
        {%- assign lx_gi = paginate.current_offset | plus: forloop.index0 -%}
        {%- assign lx_sunk = false -%}
        {%- if section.settings.sink_tagged and product.tags contains 'needs-clean-image' -%}{%- assign lx_sunk = true -%}{%- endif -%}
        {%- if lx_sunk -%}
          {%- assign lx_ord = lx_gi | times: 2 | plus: 1000000 -%}
        {%- else -%}
          {%- assign lx_ord = paginate.current_offset | plus: lx_vis | times: 2 -%}
          {%- assign lx_vis = lx_vis | plus: 1 -%}
        {%- endif -%}
        <div class="apex-card" style="order: {{ lx_ord }}" data-lx-gi="{{ lx_gi }}" data-pid="{{ product.id }}" data-handle="{{ product.handle }}" data-available="{% if product.available %}true{% else %}false{% endif %}" data-type="{{ product.type | escape }}" data-vendor="{{ product.vendor | escape }}" data-price="{{ product.price }}" data-sale="{% if on_sale %}true{% else %}false{% endif %}">
          <div class="apex-media">
            <a href="{{ product.url }}" class="apex-link" aria-label="{{ product.title | escape }}"></a>
            {%- if lx_gi == 0 and section.settings.fc_video_enable -%}
              {%- liquid
                assign fc_src = ''
                assign fc_vid = section.settings.fc_video
                if fc_vid == blank and section.settings.fc_use_product_video
                  for m in product.media
                    if m.media_type == 'video'
                      assign fc_vid = m
                      break
                    endif
                  endfor
                endif
                if fc_vid != blank
                  assign best_w = 0
                  for srcx in fc_vid.sources
                    if srcx.mime_type == 'video/mp4' and srcx.width <= 1080 and srcx.width >= best_w
                      assign best_w = srcx.width
                      assign fc_src = srcx.url
                    endif
                  endfor
                  if fc_src == ''
                    for srcx in fc_vid.sources
                      if srcx.mime_type == 'video/mp4'
                        assign fc_src = srcx.url
                        break
                      endif
                    endfor
                  endif
                endif
                if fc_src == '' and section.settings.fc_video_url != blank
                  assign fc_src = section.settings.fc_video_url
                endif
              -%}
              {%- if fc_src != '' -%}
                <video class="apex-fc-video" muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true" tabindex="-1"
                  data-lx-src="{{ fc_src }}" data-handle="{{ product.handle }}"
                  {% if product.featured_image %}poster="{{ product.featured_image | image_url: width: 600 }}"{% endif %}></video>
              {%- endif -%}
