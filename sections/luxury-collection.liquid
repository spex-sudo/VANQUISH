                      class="apex-dot{% if forloop.first %} is-active{% endif %}"
                      data-apex-dot="{{ forloop.index0 }}"
                      role="tab"
                      aria-label="Image {{ forloop.index }}"
                      aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"></button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- endif -%}

            {%- if section.settings.show_quick_add and product.available -%}
