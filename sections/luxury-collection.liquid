  var toast    = document.getElementById('ApexToast-' + SID);
  var toastTxt = document.getElementById('ApexToastText-' + SID);
  var drawer   = document.getElementById('ApexDrawer-' + SID);
  var drawerBd = document.getElementById('ApexDrawerBd-' + SID);
  var drClose  = document.getElementById('ApexDrClose-' + SID);
  var drBody   = document.getElementById('ApexDrBody-' + SID);
  var drTitle  = document.getElementById('ApexDrTitle-' + SID);
  var drCta    = document.getElementById('ApexDrCta-' + SID);

  /* ───────────── Toast ───────────── */
  var toastTimer;
  function showToast(msg) {
    if (!toast) return;
    /* Strict: only accept clean strings. Reject "[object Object]" and other coerced junk. */
    var text;
    if (typeof msg === 'string' && msg.length && msg.indexOf('[object') === -1) {
      text = msg;
    } else {
      text = 'Added to cart';
    }
    toastTxt.textContent = text;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 3200);
  }

  /* Extract a clean string from any Shopify cart error shape */
  function getCartErrMsg(err) {
    if (!err) return 'Could not add to cart';
    if (typeof err === 'string' && err.indexOf('[object') === -1) return err;
    if (typeof err.description === 'string' && err.description.indexOf('[object') === -1) return err.description;
    if (typeof err.message === 'string' && err.message.indexOf('[object') === -1) return err.message;
    if (err.errors) {
      if (typeof err.errors === 'string') return err.errors;
      if (Array.isArray(err.errors) && typeof err.errors[0] === 'string') return err.errors[0];
      if (typeof err.errors === 'object') {
        var k = Object.keys(err.errors)[0];
        var v = err.errors[k];
        if (typeof v === 'string') return v;
        if (Array.isArray(v) && typeof v[0] === 'string') return v[0];
      }
    }
    return 'Could not add to cart';
  }

  /* ───────────── Cart helpers ───────────── */
  function addToCart(variantId, qty, btn) {
    var fd = new FormData();
    fd.append('id', variantId);
    fd.append('quantity', qty || 1);

    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: fd
    }).then(function (r) {
      if (!r.ok) return r.json().then(function (e) { throw e; });
      return r.json();
    }).then(function (data) {
      if (btn) {
        btn.classList.remove('is-loading');
        btn.classList.add('is-added');
        setTimeout(function () { btn.classList.remove('is-added'); }, 1800);
      }
      /* Notify other cart widgets */
      document.dispatchEvent(new CustomEvent('cart:refresh', { detail: data }));
      document.dispatchEvent(new CustomEvent('apex:added', { detail: data }));
      showToast('Added to cart');
      return data;
    }).catch(function (err) {
      if (btn) btn.classList.remove('is-loading');
      showToast(getCartErrMsg(err));
      throw err;
    });
  }

  /* ───────────── Quick add ───────────── */
  function fetchProductJson(handle) {
    return fetch('/products/' + handle + '.js', {
      headers: { 'Accept': 'application/json' }
    }).then(function (r) { return r.json(); });
  }

  /* Module-scoped drawer state — listeners registered ONCE below */
  var drState = { product: null, sel: {}, sourceBtn: null };

  function findDrVariant() {
    if (!drState.product) return null;
    return drState.product.variants.find(function (v) {
      return Object.keys(drState.sel).every(function (idxStr) {
        var idx = parseInt(idxStr, 10);
        return getVariantOptVal(v, idx) === drState.sel[idx];
      });
    });
  }

  function renderDrSelections() {
    if (!drState.product) return;
    drBody.querySelectorAll('.apex-dr-opts').forEach(function (wrap) {
      var idx = parseInt(wrap.getAttribute('data-opt'), 10);
      wrap.querySelectorAll('.apex-dr-opt').forEach(function (btn) {
        var val = btn.getAttribute('data-val');
        btn.classList.toggle('on', drState.sel[idx] === val);
        /* Grey out values that produce no available variant given current other selections */
        var match = drState.product.variants.find(function (v) {
          if (getVariantOptVal(v, idx) !== val) return false;
          return Object.keys(drState.sel).every(function (sIdxStr) {
            var sIdx = parseInt(sIdxStr, 10);
            if (sIdx === idx) return true;
            return drState.sel[sIdx] == null || getVariantOptVal(v, sIdx) === drState.sel[sIdx];
          });
        });
        btn.disabled = !match || !match.available;
      });
    });
    var v = findDrVariant();
    var ctaText = drCta.querySelector('.apex-dr-cta-text');
    if (v && v.available) {
      drCta.disabled = false;
      ctaText.textContent = 'Add to cart · ' + formatMoney(v.price);
      drCta.setAttribute('data-vid', String(v.id));
    } else {
      drCta.disabled = true;
      ctaText.textContent = v ? 'Sold out' : 'Select options';
      drCta.removeAttribute('data-vid');
    }
  }

  /* ONCE: drawer body delegated click */
  drBody.addEventListener('click', function (e) {
    var btn = e.target.closest('.apex-dr-opt');
    if (!btn || btn.disabled) return;
    var wrap = btn.closest('.apex-dr-opts');
    if (!wrap) return;
    var idx = parseInt(wrap.getAttribute('data-opt'), 10);
    drState.sel[idx] = btn.getAttribute('data-val');
    renderDrSelections();
  });

  /* ONCE: drawer CTA */
  drCta.addEventListener('click', function () {
    var vid = drCta.getAttribute('data-vid');
    if (!vid || drCta.disabled) return;
    drCta.classList.add('is-loading');
    drCta.disabled = true;
    var src = drState.sourceBtn;
    addToCart(vid, 1, null).then(function () {
      closeDrawer();
      if (src) {
        src.classList.add('is-added');
        setTimeout(function () { src.classList.remove('is-added'); }, 1800);
      }
    }).catch(function () {}).then(function () {
      drCta.classList.remove('is-loading');
      drCta.disabled = false;
    });
  });

  /* Shopify can return options as either ["Color","Size"] (strings)
     OR [{name:"Color",values:[...],position:1}, ...] (objects).
     This getter handles both. */
  function getOptName(opt) {
    if (typeof opt === 'string') return opt;
    if (opt && typeof opt.name === 'string') return opt.name;
    return '';
  }

  /* Variant option values: prefer v.options[i] but fall back to v['option' + (i+1)] */
  function getVariantOptVal(variant, idx) {
    if (variant.options && typeof variant.options[idx] === 'string') return variant.options[idx];
    var keyed = variant['option' + (idx + 1)];
    if (typeof keyed === 'string') return keyed;
    return '';
  }

  function openDrawer(product, sourceBtn) {
    drState.product = product;
    drState.sel = {};
    drState.sourceBtn = sourceBtn || null;

    drTitle.textContent = product.title || '';
    drBody.innerHTML = '';

    var optionsList = product.options || [];
    /* Filter out the implicit "Title" option Shopify adds when a product has no real options */
    var realOptions = optionsList.filter(function (o) {
      var n = getOptName(o);
      return n && n.toLowerCase() !== 'title';
    });
    var hasMulti = realOptions.length > 0 && product.variants && product.variants.length > 1;

    if (!hasMulti) {
      /* Single variant — add directly, no drawer */
      var firstVar = product.variants && product.variants[0];
      if (firstVar) addToCart(firstVar.id, 1, sourceBtn);
      return;
    }

    optionsList.forEach(function (opt, optIdx) {
      var optName = getOptName(opt);
      if (!optName || optName.toLowerCase() === 'title') return;

      var label = document.createElement('p');
      label.className = 'apex-dr-opt-label';
      label.textContent = optName;
      drBody.appendChild(label);

      var wrap = document.createElement('div');
      wrap.className = 'apex-dr-opts';
      wrap.setAttribute('data-opt', String(optIdx));

      /* Collect unique string values for this option position */
      var values = [];
      product.variants.forEach(function (v) {
        var val = getVariantOptVal(v, optIdx);
        if (val && values.indexOf(val) === -1) values.push(val);
      });

      values.forEach(function (val) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'apex-dr-opt';
        btn.textContent = val;
        btn.setAttribute('data-val', val);
        wrap.appendChild(btn);
      });
      drBody.appendChild(wrap);
    });

    /* Pre-select first available variant */
    var firstAvail = product.variants.find(function (v) { return v.available; }) || product.variants[0];
    if (firstAvail) {
      optionsList.forEach(function (_, idx) {
        var v = getVariantOptVal(firstAvail, idx);
        if (v) drState.sel[idx] = v;
      });
      renderDrSelections();
    }

    drawer.classList.add('open');
    drawerBd.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    drawerBd.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';

    /* Save outer focus to restore on close */
    drState.lastFocus = document.activeElement;
    /* Focus first option (or CTA if no options) — improves keyboard a11y */
    setTimeout(function () {
      var first = drBody.querySelector('.apex-dr-opt:not(:disabled)') || drCta;
      if (first && first.focus) first.focus({ preventScroll: true });
    }, 360);
  }

  /* Focus trap inside drawer */
  drawer.addEventListener('keydown', function (e) {
    if (e.key !== 'Tab' || !drawer.classList.contains('open')) return;
    var focusable = drawer.querySelectorAll('button:not(:disabled), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (!focusable.length) return;
    var first = focusable[0];
    var last  = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  function closeDrawer() {
    drawer.classList.remove('open');
    drawerBd.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    drawerBd.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    /* Clear state so re-opens with a different product start fresh */
    drState.product = null;
    drState.sel = {};
    drState.sourceBtn = null;
    drBody.innerHTML = '';
    drCta.disabled = true;
    drCta.removeAttribute('data-vid');
    var lbl = drCta.querySelector('.apex-dr-cta-text');
    if (lbl) lbl.textContent = 'Add to cart';
    /* Restore focus to the element that opened the drawer */
    if (drState.lastFocus && drState.lastFocus.focus) {
      try { drState.lastFocus.focus({ preventScroll: true }); } catch (e) {}
    }
  }
  if (drClose)  drClose.addEventListener('click', closeDrawer);
  if (drawerBd) drawerBd.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawer.classList.contains('open')) closeDrawer();
  });

  /* Money formatter — JSON-safe injection */
  var moneyFmt = {{ shop.money_format | json }};
  function formatMoney(cents) {
    var n = (cents / 100).toFixed(2);
    return moneyFmt.replace(/\{\{\s*amount\s*\}\}/g, n)
                   .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, Math.round(cents / 100))
                   .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, n.replace('.', ','))
                   .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, Math.round(cents / 100));
  }

  /* ───────────── Delegated card click handlers ───────────── */
  /* ─────────── Image switcher utility ─────────── */
  function switchImage(media, target) {
    var imgs = media.querySelectorAll('.apex-img');
    var dots = media.querySelectorAll('[data-apex-dot]');
    var counter = media.querySelector('[data-apex-counter]');
    if (imgs.length < 2) return;

    var current = 0;
    for (var i = 0; i < imgs.length; i++) {
      if (imgs[i].classList.contains('is-active')) { current = i; break; }
    }
    var idx;
    if (target === 'prev') idx = (current - 1 + imgs.length) % imgs.length;
    else if (target === 'next') idx = (current + 1) % imgs.length;
    else idx = target;
    if (idx == null || idx === current || idx < 0 || idx >= imgs.length) return;

    imgs[current].classList.remove('is-active');
    imgs[idx].classList.add('is-active');
    if (dots[current]) { dots[current].classList.remove('is-active'); dots[current].setAttribute('aria-selected', 'false'); }
    if (dots[idx])     { dots[idx].classList.add('is-active');         dots[idx].setAttribute('aria-selected', 'true');  }
    if (counter) counter.textContent = (idx + 1) + '/' + imgs.length;
  }

  /* ─────────── Card enhancements (idempotent — safe to re-run on appended items) ─────────── */
  var SWIPE_THRESHOLD = 30;
  var prefetched = {};
  var canHover = window.matchMedia && window.matchMedia('(hover: hover)').matches;
  var saveData = navigator.connection && navigator.connection.saveData === true;

  function prefetchUrl(url) {
    if (!url || prefetched[url]) return;
    prefetched[url] = 1;
    try {
      var link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = url;
      link.as = 'document';
      document.head.appendChild(link);
    } catch (e) {}
  }

  function enhanceCards(scope) {
    var root = scope || ROOT;

    /* Touch swipe on each media block */
    root.querySelectorAll('.apex-media').forEach(function (media) {
      if (media.dataset.apexEnhanced) return;
      var imgs = media.querySelectorAll('.apex-img');
      if (imgs.length < 2) { media.dataset.apexEnhanced = '1'; return; }

      var startX = 0, startY = 0, deltaX = 0, deltaY = 0, tracking = false;
      media.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1) return;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        deltaX = 0; deltaY = 0;
        tracking = true;
      }, { passive: true });
      media.addEventListener('touchmove', function (e) {
        if (!tracking || e.touches.length !== 1) return;
        deltaX = e.touches[0].clientX - startX;
        deltaY = e.touches[0].clientY - startY;
        if (Math.abs(deltaY) > Math.abs(deltaX) * 1.5) tracking = false;
      }, { passive: true });
      media.addEventListener('touchend', function () {
        if (!tracking) return;
        tracking = false;
        if (Math.abs(deltaX) >= SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
          switchImage(media, deltaX < 0 ? 'next' : 'prev');
        }
      }, { passive: true });

      media.dataset.apexEnhanced = '1';
    });

    /* Predictive prefetch on sustained hover (desktop, non-data-saver) */
    if (canHover && !saveData) {
      root.querySelectorAll('.apex-card').forEach(function (card) {
        if (card.dataset.apexPrefetch) return;
        var link = card.querySelector('.apex-link');
        if (!link) { card.dataset.apexPrefetch = '1'; return; }
        var hoverTimer;
        card.addEventListener('mouseenter', function () {
          clearTimeout(hoverTimer);
          hoverTimer = setTimeout(function () { prefetchUrl(link.href); }, 250);
        });
        card.addEventListener('mouseleave', function () { clearTimeout(hoverTimer); });
        card.dataset.apexPrefetch = '1';
      });
    }

    /* Color-swatch hover swaps card image */
    root.querySelectorAll('.apex-swatches').forEach(function (sw) {
      if (sw.dataset.apexSwatch) return;
      var card = sw.closest('.apex-card');
      if (!card) { sw.dataset.apexSwatch = '1'; return; }
      var media = card.querySelector('.apex-media');
      if (!media) { sw.dataset.apexSwatch = '1'; return; }

      sw.addEventListener('mouseover', function (e) {
        var btn = e.target.closest('.apex-sw');
        if (!btn) return;
        var imgUrl = btn.getAttribute('data-img');
        if (!imgUrl) return;
        var tmp = media.querySelector('[data-apex-swatch-preview]');
        if (!tmp) {
          tmp = document.createElement('img');
          tmp.className = 'apex-img';
          tmp.setAttribute('data-apex-swatch-preview', '');
          tmp.style.zIndex = '2';
          tmp.loading = 'lazy';
          tmp.decoding = 'async';
          media.insertBefore(tmp, media.firstChild);
        }
        tmp.src = imgUrl;
        requestAnimationFrame(function () { tmp.classList.add('is-active'); });
      });
      sw.addEventListener('mouseleave', function () {
        var tmp = media.querySelector('[data-apex-swatch-preview]');
        if (tmp) tmp.classList.remove('is-active');
      });

      sw.dataset.apexSwatch = '1';
    });
  }
  enhanceCards();

  /* ─────────── Keyboard nav (arrows when card focused) — delegated, works for new cards too ─────────── */
  ROOT.addEventListener('keydown', function (e) {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    var card = e.target.closest('.apex-card');
    if (!card) return;
    var tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
    var media = card.querySelector('.apex-media');
    if (!media) return;
    e.preventDefault();
    switchImage(media, e.key === 'ArrowLeft' ? 'prev' : 'next');
  });

  ROOT.addEventListener('click', function (e) {
    var qa = e.target.closest('[data-apex-qa]');
    if (qa) {
      e.preventDefault();
      e.stopPropagation();
      if (qa.classList.contains('is-loading')) return;

      var variantCount = parseInt(qa.getAttribute('data-variants'), 10);
      var firstVid     = qa.getAttribute('data-first-vid');
      var handle       = qa.getAttribute('data-handle');

      /* Single-variant: add directly */
      if (variantCount === 1 && firstVid) {
        qa.classList.add('is-loading');
        addToCart(firstVid, 1, qa);
        return;
      }
      /* Multi-variant: open drawer */
      qa.classList.add('is-loading');
      fetchProductJson(handle).then(function (product) {
        qa.classList.remove('is-loading');
        openDrawer(product, qa);
      }).catch(function () {
        qa.classList.remove('is-loading');
        showToast('Could not load options');
      });
      return;
    }

    /* Image switcher — dot, prev/next */
    var dot = e.target.closest('[data-apex-dot]');
    var prev = e.target.closest('[data-apex-img-prev]');
    var next = e.target.closest('[data-apex-img-next]');
    if (dot || prev || next) {
      e.preventDefault();
      e.stopPropagation();
      var media = (dot || prev || next).closest('.apex-media');
      if (!media) return;
      if (dot)  switchImage(media, parseInt(dot.getAttribute('data-apex-dot'), 10));
      if (prev) switchImage(media, 'prev');
      if (next) switchImage(media, 'next');
      return;
    }

    var wish = e.target.closest('[data-apex-wish]');
    if (wish) {
      e.preventDefault();
      e.stopPropagation();
      var handle = wish.getAttribute('data-apex-wish');
      if (!handle) return;

      /* Use the notch's global API if available — otherwise fall back to direct storage */
      if (window.ApexFavorites) {
        window.ApexFavorites.toggle(handle);
        var nowSaved = window.ApexFavorites.has(handle);
        wish.classList.toggle('is-saved', nowSaved);
        wish.setAttribute('aria-pressed', nowSaved ? 'true' : 'false');
      } else {
        /* Standalone fallback — same key/event as the notch so it picks up later */
        var saved = wish.classList.toggle('is-saved');
        wish.setAttribute('aria-pressed', saved ? 'true' : 'false');
        try {
          var FAV_KEY = 'apex_favs_v1';
          var list = JSON.parse(localStorage.getItem(FAV_KEY) || '[]');
          if (!Array.isArray(list)) list = [];
          if (saved && list.indexOf(handle) === -1) list.push(handle);
          else if (!saved) list = list.filter(function (x) { return x !== handle; });
          localStorage.setItem(FAV_KEY, JSON.stringify(list));
          document.dispatchEvent(new CustomEvent('apex:favorites-changed', {
            detail: { handle: handle, action: saved ? 'add' : 'remove' }
          }));
        } catch (err) {}
      }
      return;
    }
  });

  /* Restore favorites state from notch's storage */
  function applyFavState() {
    try {
      var savedList = JSON.parse(localStorage.getItem('apex_favs_v1') || '[]');
      if (!Array.isArray(savedList)) savedList = [];
      ROOT.querySelectorAll('[data-apex-wish]').forEach(function (btn) {
        var handle = btn.getAttribute('data-apex-wish');
        var on = savedList.indexOf(handle) !== -1;
        btn.classList.toggle('is-saved', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    } catch (e) {}
  }
  applyFavState();
  /* Re-sync when notch (or another tab) changes favorites */
  document.addEventListener('apex:favorites-changed', applyFavState);
  window.addEventListener('storage', function (e) {
    if (e.key === 'apex_favs_v1') applyFavState();
  });

  /* ───────────── Infinite scroll ───────────── */
  if (sentinel && grid) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (ent) {
        if (ent.isIntersecting && !sentinel.classList.contains('is-loading')) loadNext();
      });
    }, { rootMargin: '600px' });

    function loadNext() {
      sentinel.classList.add('is-loading');
      var nextUrl = sentinel.getAttribute('data-next-url');

      /* 12s timeout via AbortController */
      var ctrl, timer;
      var fetchOpts = { headers: { 'X-Requested-With': 'XMLHttpRequest' }};
      if (typeof AbortController !== 'undefined') {
        ctrl = new AbortController();
        fetchOpts.signal = ctrl.signal;
        timer = setTimeout(function () { try { ctrl.abort(); } catch (e) {} }, 12000);
      }

      fetch(nextUrl, fetchOpts)
        .then(function (r) {
          if (timer) clearTimeout(timer);
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.text();
        })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var items = doc.querySelectorAll('#' + grid.id + ' > *');
          var nextSent = doc.getElementById(sentinel.id);

          /* Re-trigger Judge.me + other apps after injection */
          items.forEach(function (item) { grid.appendChild(item); });

          /* Re-attach touch swipe / prefetch / swatch hover to new cards */
          enhanceCards(grid);

          if (nextSent) {
            sentinel.setAttribute('data-next-url', nextSent.getAttribute('data-next-url'));
            sentinel.classList.remove('is-loading');
          } else {
            sentinel.innerHTML = '<span class="apex-status-text">All products loaded</span>';
            io.disconnect();
          }

          /* Restore favorites state on new items */
          applyFavState();

          /* Re-init Judge.me on new items if available */
          if (window.jdgm && typeof window.jdgm.SHOP_DOMAIN !== 'undefined') {
            try { window.jdgm.customizeBadges && window.jdgm.customizeBadges(); } catch (e) {}
            try { window.jdgm.docReady && window.jdgm.docReady(); } catch (e) {}
          }
          /* Re-render Yotpo / Stamped / Reviews.io if present */
          if (window.yotpo && window.yotpo.refreshWidgets) try { window.yotpo.refreshWidgets(); } catch (e) {}
          document.dispatchEvent(new CustomEvent('apex:appended', { detail: { count: items.length }}));
        })
        .catch(function () { sentinel.classList.remove('is-loading'); });
    }
    io.observe(sentinel);
  }

  /* ───────────── Ascend button ───────────── */
  var ascendVisible = false;
  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      var v = window.scrollY > 800;
      if (v !== ascendVisible) {
        ascend.classList.toggle('is-visible', v);
        ascendVisible = v;
      }
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  if (ascend) ascend.addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>

