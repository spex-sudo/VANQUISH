                {%- assign badge_count = badge_count | plus: 1 -%}
              {%- endif -%}
            </div>

            {%- if section.settings.show_wishlist -%}
              <button type="button" class="apex-wish" data-apex-wish="{{ product.handle }}" data-pid="{{ product.id }}" aria-label="Save {{ product.title | escape }}" aria-pressed="false">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </button>
            {%- endif -%}

            {%- if img_count > 0 -%}
              {%- for img in product.images limit: img_count -%}
                {%- assign is_first_img = forloop.first -%}
                <img
                  class="apex-img{% if is_first_img %} is-active{% endif %}"
                  data-img-idx="{{ forloop.index0 }}"
                  src="{{ img | image_url: width: 600 }}"
                  srcset="{{ img | image_url: width: 320 }} 320w,
                          {{ img | image_url: width: 480 }} 480w,
                          {{ img | image_url: width: 600 }} 600w,
                          {{ img | image_url: width: 800 }} 800w,
                          {{ img | image_url: width: 1000 }} 1000w"
                  sizes="(max-width: 768px) {{ 100 | divided_by: section.settings.mb_cols }}vw, {{ 100 | divided_by: section.settings.pc_cols }}vw"
                  width="{{ img.width }}"
                  height="{{ img.height }}"
                  alt="{% if is_first_img %}{{ img.alt | default: product.title | escape }}{% endif %}"
                  loading="{% if is_first_img and is_eager %}eager{% else %}lazy{% endif %}"
                  {% if is_first_img and is_eager %}fetchpriority="high"{% endif %}
                  decoding="async"
                  {% unless is_first_img %}aria-hidden="true"{% endunless %}>
              {%- endfor -%}

              {%- if img_count > 1 -%}
                <span class="apex-counter" data-apex-counter aria-hidden="true">1/{{ img_count }}</span>
                <button type="button" class="apex-arrow apex-arrow-prev" data-apex-img-prev aria-label="Previous image">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button type="button" class="apex-arrow apex-arrow-next" data-apex-img-next aria-label="Next image">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
