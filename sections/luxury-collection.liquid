{%- comment -%}
  APEX ZENITH MASTER DISCOVERY — V15
  Conversion-focused rebuild:
    • Quick-add (+) button with variant-aware logic (single variant = direct add; multi = drawer)
    • Hover image swap (second media as on-hover state, no carousel work)
    • Color swatch preview under title (limit 4 + "+N")
    • Smart badges: Sale (with %), New, Low Stock, Bestseller
    • Judge.me ratings rendered directly with product.id (fixes broken @app rendering)
    • Hover lift, focus rings, reduced-motion safety
    • Delegated event handlers (no inline onclick → CSP-safe)
    • Skeleton placeholders during infinite scroll
{%- endcomment -%}

{%- liquid
  assign sid    = section.id
  assign acc    = section.settings.ac
  assign sale_c = section.settings.sale_color
-%}

<style>
  #ApexZenith-{{ sid }} {
    --gap: {{ section.settings.gap }}px;
    --rd: {{ section.settings.rd }}px;
    --ac: {{ acc }};
    --sale: {{ sale_c }};
    --ink: #111;
    --dim: #6b6b6b;
    --line: #ececec;
    --soft: #f7f7f7;
    --new: #2d6a4f;
    --low: #c8102e;

    max-width: {{ section.settings.max_w }}px;
    margin: 0 auto;
    padding: {{ section.settings.p_v }}px 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--ink);
  }

  .apex-grid-{{ sid }} {
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat({{ section.settings.pc_cols }}, minmax(0, 1fr));
  }

  /* ── Card ── */
  .apex-card {
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
    contain: layout paint style;
  }
  .apex-card:hover { transform: translateY(-3px); }

  .apex-media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.ratio }};
    border-radius: var(--rd);
    overflow: hidden;
    background: var(--soft);
    margin-bottom: 12px;
  }

  /* Stacked images — one per product media. Active one is opacity:1, rest opacity:0 */
  .apex-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s ease;
    will-change: opacity;
  }
  .apex-img.is-active {
    opacity: 1;
    /* Native View Transitions API support — Chromium 111+ degrades gracefully */
    view-transition-name: var(--vt-name, none);
  }
  .apex-media:hover .apex-img.is-active { transform: scale(1.04); }

  /* Image counter pill — "1/4" indicator, bottom-left (out of the way of badges + wishlist) */
  .apex-counter {
    position: absolute;
    bottom: 8px;
    left: 8px;
    z-index: 5;
    padding: 3px 8px;
    border-radius: 100px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: rgba(255,255,255,0.92);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.22s;
  }
  .apex-card:hover .apex-counter { opacity: 1; }

  @media (max-width: 768px) {
    .apex-counter { opacity: 1; }
  }

  /* Visible mini prev/next buttons — appear on hover (desktop) or always on mobile */
  .apex-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%) scale(0.9);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    -webkit-tap-highlight-color: transparent;
    z-index: 4;
    opacity: 0;
    transition: opacity 0.22s, transform 0.18s, background 0.16s;
  }
  .apex-card:hover .apex-arrow,
  .apex-arrow:focus-visible {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
  .apex-arrow:hover  { background: #fff; }
  .apex-arrow:active { transform: translateY(-50%) scale(0.9); }
  .apex-arrow svg {
    width: 12px;
    height: 12px;
    stroke: #111;
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .apex-arrow-prev { left: 8px; }
  .apex-arrow-next { right: 8px; }

  /* Mobile: arrows hidden — swipe gesture handles navigation */
  @media (max-width: 768px) {
    .apex-arrow { display: none; }
  }

  /* Dot indicators — bottom-center row */
  .apex-dots {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
    z-index: 5;
    padding: 4px 6px;
    border-radius: 100px;
    background: rgba(0,0,0,0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }
  .apex-card:hover .apex-dots { opacity: 1; }
  .apex-dots > * { pointer-events: auto; }
  .apex-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255,255,255,0.55);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, transform 0.18s, width 0.2s;
    -webkit-tap-highlight-color: transparent;
    flex-shrink: 0;
  }
  .apex-dot.is-active {
    background: #fff;
    width: 14px;
    border-radius: 100px;
  }
  .apex-dot:hover { background: rgba(255,255,255,0.85); }

  @media (max-width: 768px) {
    .apex-dots { opacity: 1; }
  }

  .apex-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    text-decoration: none;
  }

  /* ── Badges ── */
  .apex-badges {
    position: absolute;
    top: 10px; left: 10px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 4px;
    pointer-events: none;
    align-items: flex-start;
  }
  .apex-bdg {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border-radius: 3px;
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #fff;
    line-height: 1;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .apex-bdg-sale { background: var(--sale); }
  .apex-bdg-new  { background: var(--new); }
  .apex-bdg-low  { background: var(--low); animation: apex-pulse 1.6s ease-in-out infinite; }
  .apex-bdg-best { background: rgba(0,0,0,0.85); }
  .apex-bdg-cust { background: var(--ac); }
  @keyframes apex-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(200,16,46,0); }
    50%      { box-shadow: 0 0 0 6px rgba(200,16,46,0.18); }
  }

  /* ── Wishlist (top-right) ── */
  .apex-wish {
    position: absolute;
    top: 10px; right: 10px;
    z-index: 6;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s, background 0.18s;
    opacity: 0;
  }
  .apex-card:hover .apex-wish,
  .apex-wish.is-saved,
  .apex-wish:focus-visible { opacity: 1; }
  .apex-wish:active { transform: scale(0.9); }
  .apex-wish svg { width: 14px; height: 14px; fill: none; stroke: var(--ink); stroke-width: 1.8; transition: fill 0.2s, stroke 0.2s; }
  .apex-wish.is-saved svg { fill: var(--sale); stroke: var(--sale); }
  .apex-wish.is-saved {
    animation: apex-wish-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes apex-wish-pop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.28); }
    70%  { transform: scale(0.92); }
    100% { transform: scale(1); }
  }

  /* ── Quick add (+) ── */
  .apex-qa {
    position: absolute;
    bottom: 10px; right: 10px;
    z-index: 6;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    border: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
    -webkit-tap-highlight-color: transparent;
    transform: translateY(8px) scale(0.85);
    opacity: 0;
    transition: opacity 0.22s, transform 0.22s cubic-bezier(0.32, 0.72, 0, 1), background 0.18s;
  }
  .apex-card:hover .apex-qa,
  .apex-qa:focus-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .apex-qa:hover { background: var(--ac); }
  .apex-qa:active { transform: scale(0.92); }
  .apex-qa.is-loading { background: var(--dim); pointer-events: none; }
  .apex-qa.is-added { background: var(--new); }
  .apex-qa svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2.2; }
  .apex-qa-spinner {
    width: 14px; height: 14px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #fff;
    animation: apex-spin 0.7s linear infinite;
    display: none;
  }
  .apex-qa.is-loading .apex-qa-icon { display: none; }
  .apex-qa.is-loading .apex-qa-spinner { display: block; }
  @keyframes apex-spin { to { transform: rotate(360deg); } }

  /* Mobile: always show quick-add + wishlist */
  @media (max-width: 768px) {
    .apex-qa, .apex-wish {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* ── Info ── */
  .apex-info {
    padding: 4px 2px 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .apex-vendor {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0;
  }
  .apex-title {
    position: relative;
    z-index: 2;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.32;
    color: var(--ink);
    text-decoration: none;
    margin: 0;
    /* clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .apex-title:hover { text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }

  .apex-rating {
    position: relative;
    z-index: 2;
    min-height: 14px;
  }
  /* Style Judge.me badge inline for grid card */
  .apex-rating .jdgm-prev-badge {
    --jdgm-paper: transparent;
  }
  .apex-rating .jdgm-prev-badge__stars { font-size: 12px !important; letter-spacing: -1px; }
  .apex-rating .jdgm-prev-badge__text  { font-size: 10.5px !important; color: var(--dim) !important; margin-left: 4px; }

  .apex-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .apex-price {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .apex-price.is-sale { color: var(--sale); }
  .apex-price-was {
    font-size: 12px;
    color: var(--dim);
    text-decoration: line-through;
  }
  .apex-savings {
    font-size: 10px;
    font-weight: 600;
    color: var(--sale);
    letter-spacing: 0.04em;
    margin-left: auto;
  }

  /* ── Color swatches preview ── */
  .apex-swatches {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 2px;
  }
  .apex-sw {
    width: 13px; height: 13px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.12);
    flex-shrink: 0;
    cursor: pointer;
    transition: transform 0.14s;
    background-size: cover;
  }
  .apex-sw:hover { transform: scale(1.18); }
  .apex-sw-more {
    font-size: 9.5px;
    color: var(--dim);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* ── Toast ── */
  .apex-toast-{{ sid }} {
    position: fixed;
    bottom: 30px; left: 50%;
    transform: translateX(-50%) translateY(20px);
    z-index: 9999;
    background: var(--ink);
    color: #fff;
    padding: 12px 20px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    box-shadow: 0 8px 28px rgba(0,0,0,0.22);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s, transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 40px);
  }
  .apex-toast-{{ sid }}.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .apex-toast-{{ sid }} svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; flex-shrink: 0; }
  .apex-toast-{{ sid }} a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: 4px;
    font-weight: 600;
  }

  /* ── Variant drawer ── */
  .apex-drawer-bd-{{ sid }} {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.42);
    z-index: 9998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .apex-drawer-bd-{{ sid }}.open { opacity: 1; pointer-events: auto; }
  .apex-drawer-{{ sid }} {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: #fff;
    border-radius: 20px 20px 0 0;
    z-index: 9999;
    transform: translateY(100%);
    transition: transform 0.36s cubic-bezier(0.32, 0.72, 0, 1);
    max-height: 80vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-shadow: 0 -10px 40px rgba(0,0,0,0.18);
  }
  .apex-drawer-{{ sid }}.open { transform: translateY(0); }
  .apex-dr-handle {
    flex-shrink: 0;
    display: flex; justify-content: center;
    padding: 10px 0 6px;
  }
  .apex-dr-handle::before {
    content: '';
    width: 38px; height: 4px;
    background: var(--line);
    border-radius: 100px;
  }
  .apex-dr-head {
    padding: 6px 22px 14px;
    display: flex; align-items: center; justify-content: space-between;
    flex-shrink: 0;
    border-bottom: 1px solid var(--line);
  }
  .apex-dr-title {
    font-size: 13px; font-weight: 600; letter-spacing: 0.04em;
    margin: 0;
    /* clamp to 1 line */
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    flex: 1;
    padding-right: 12px;
  }
  .apex-dr-close {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: var(--soft);
    border: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .apex-dr-close svg { width: 12px; height: 12px; stroke: var(--ink); fill: none; stroke-width: 1.8; }
  .apex-dr-body {
    flex: 1;
    overflow-y: auto;
    padding: 18px 22px;
    -webkit-overflow-scrolling: touch;
  }
  .apex-dr-opt-label {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 9px;
  }
  .apex-dr-opt-label + .apex-dr-opt-label { margin-top: 18px; }
  .apex-dr-opts {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-bottom: 4px;
  }
  .apex-dr-opt {
    padding: 9px 14px;
    border-radius: 100px;
    background: var(--soft);
    border: 1px solid transparent;
    font-size: 11.5px; font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.16s, border-color 0.16s, color 0.16s;
    -webkit-tap-highlight-color: transparent;
    line-height: 1;
  }
  .apex-dr-opt.on {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }
  .apex-dr-opt:disabled {
    opacity: 0.32;
    text-decoration: line-through;
    cursor: not-allowed;
  }
  .apex-dr-foot {
    padding: 14px 22px 18px;
    border-top: 1px solid var(--line);
    flex-shrink: 0;
  }
  .apex-dr-cta {
    width: 100%;
    padding: 14px 18px;
    background: var(--ink);
    color: #fff;
    border: none;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 0.18s, background 0.18s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .apex-dr-cta:hover { opacity: 0.92; }
  .apex-dr-cta:disabled { background: var(--line); color: var(--dim); cursor: not-allowed; }
  .apex-dr-cta.is-loading .apex-dr-cta-text { opacity: 0.5; }

  /* ── Infinite scroll status ── */
  .apex-status-{{ sid }} {
    margin-top: 60px;
    padding: 30px 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .apex-status-text {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    color: var(--dim);
    font-weight: 500;
  }
  .apex-pulse {
    width: 60px; height: 2px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }
  .apex-pulse::after {
    content: '';
    position: absolute;
    left: -100%;
    width: 100%; height: 100%;
    background: var(--ac);
    box-shadow: 0 0 10px var(--ac);
    animation: apex-slide 1.5s infinite;
    display: none;
  }
  .is-loading .apex-pulse::after { display: block; }
  @keyframes apex-slide {
    0%   { left: -100%; }
    100% { left: 100%; }
  }

  /* ── Ascend ── */
  #ApexAscend-{{ sid }} {
    position: fixed;
    bottom: 30px; right: 30px;
    z-index: 99;
    width: 44px; height: 44px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 14px rgba(0,0,0,0.10);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.32s, visibility 0.32s, transform 0.18s;
  }
  #ApexAscend-{{ sid }}.is-visible {
    opacity: 1;
    visibility: visible;
  }
  #ApexAscend-{{ sid }}:hover { transform: translateY(-2px); }
  #ApexAscend-{{ sid }} svg { width: 16px; fill: var(--ac); }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .apex-grid-{{ sid }} { grid-template-columns: repeat({{ section.settings.mb_cols }}, minmax(0, 1fr)); }
    .apex-title  { font-size: 12.5px; }
    .apex-price  { font-size: 13px; }
    .apex-qa     { width: 32px; height: 32px; bottom: 8px; right: 8px; }
    .apex-qa svg { width: 14px; height: 14px; }
    .apex-wish   { width: 28px; height: 28px; top: 8px; right: 8px; }
    .apex-wish svg { width: 12px; height: 12px; }
    .apex-bdg    { font-size: 8.5px; padding: 4px 7px; }
    #ApexAscend-{{ sid }} { bottom: 16px; right: 16px; width: 40px; height: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-card, .apex-img,
    .apex-qa, .apex-wish, .apex-toast-{{ sid }},
    .apex-drawer-{{ sid }}, .apex-drawer-bd-{{ sid }} { transition: none !important; }
    .apex-bdg-low, .apex-pulse::after { animation: none !important; }
  }
</style>

<div id="ApexZenith-{{ sid }}" data-apex-section="{{ sid }}">
  {%- comment -%}
    PRODUCT SOURCE
    On a collection template: paginate the literal `collection.products` so
    Shopify's engine correctly scopes products to that collection (sort, filter,
    and pagination all work as expected). `collection` is always defined on
    collection.* templates and is never blank there.
    On every other template (homepage, /collections index, search, etc.):
    paginate `collections.all.products` so the grid still populates with the
    full catalogue as a sensible default.
    Two separate paginate blocks are required because Shopify's `paginate` tag
    requires a literal object path — it does not correctly resolve through a
    Liquid-assigned variable, causing it to silently fall back to all-products
    behaviour regardless of which collection is being viewed.
  {%- endcomment -%}

  {%- if template.name == 'collection' -%}

    {%- comment %} ── COLLECTION PAGE — show only this collection's products ── {%- endcomment %}
    {%- paginate collection.products by section.settings.page_limit -%}
      <div class="apex-grid-{{ sid }}" id="ApexGrid-{{ sid }}">
        {%- for product in collection.products -%}
        {%- liquid
          comment
            LCP: first row (= desktop column count) loads eagerly
          endcomment
