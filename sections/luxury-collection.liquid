                        {%- assign sw_vid = nil -%}
                        {%- assign sw_img = nil -%}
                        {%- for v in product.variants -%}
                          {%- assign v_color = v.options[color_idx] -%}
                          {%- if v_color == val -%}
                            {%- if v.available and sw_vid == nil -%}
                              {%- assign sw_vid = v.id -%}
                              {%- if v.featured_image -%}
                                {%- assign sw_img = v.featured_image | image_url: width: 600 -%}
                              {%- endif -%}
                            {%- elsif sw_vid == nil -%}
                              {%- assign sw_vid = v.id -%}
                              {%- if v.featured_image -%}
                                {%- assign sw_img = v.featured_image | image_url: width: 600 -%}
                              {%- endif -%}
                            {%- endif -%}
                          {%- endif -%}
                        {%- endfor -%}
                        <a href="{{ product.url }}?variant={{ sw_vid }}"
                           class="apex-sw"
                           title="{{ val }}"
                           aria-label="{{ val }}"
                           {% if sw_img %}data-img="{{ sw_img }}"{% endif %}
                           style="background-color: {{ val | handle }};"></a>
                      {%- endfor -%}
                      {%- if color_opt.values.size > max_sw -%}
                        <span class="apex-sw-more">+{{ color_opt.values.size | minus: max_sw }}</span>
                      {%- endif -%}
