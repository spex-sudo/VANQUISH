{%- comment -%}
  LEXE funnels. Stacked pills above the footer.
  One block = one funnel (products, services, waitlist, contact, or a custom link).
  Change a block's purpose in the editor; the object, form, and link follow.
  No icons, no SVG, no script. One lazy photo at most per pill.
  Waitlist still uses the customer form (tags newsletter, specs-offer).
  The free-pair code shows only when settings.lexe_lock_notify is explicitly false.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign fuse = false
  if s.presentation == 'fuse'
    assign fuse = true
  endif
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
    assign total = section.blocks.size
  else
    assign total = 4
  endif
  assign open_n = 1
  assign has_wait = false
  if fuse
    if has_blocks
      for b in section.blocks
        if b.settings.purpose == 'waitlist'
          assign open_n = forloop.index
          assign has_wait = true
          break
        endif
      endfor
    else
      assign open_n = 3
      assign has_wait = true
    endif
  endif
  assign contact_page = blank
  assign contact_ready = false
  assign showed_form = false
  assign contact_used = false
-%}
<section id="lexe-specs-offer-{{ sid }}" class="lso-{{ sid }}{% if fuse %} is-fuse{% else %} is-stack{% endif %}" aria-labelledby="lso-title-{{ sid }}">
  <style>
    #lexe-specs-offer-{{ sid }}{
      --paper: {{ s.paper_color }};
      --ink: {{ s.ink_color }};
      --accent: {{ s.accent_color }};
      --on-accent: {{ s.accent_text }};
      background: {{ s.bg_color }};
      color: {{ s.text_color }};
      padding: {{ s.padding_top }}px 16px {{ s.padding_bottom }}px;
      font: inherit;
      color-scheme: light;
      -webkit-font-smoothing: antialiased;
    }
    #lexe-specs-offer-{{ sid }} *{box-sizing:border-box}
    #lexe-specs-offer-{{ sid }} .lso-root{
      width:min(432px,100%);
      margin:0 auto;
      display:flex;
      flex-direction:column;
      gap:10px;
      position:relative;
    }
    #lexe-specs-offer-{{ sid }} .lso-sr{
      position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
      clip:rect(0,0,0,0);white-space:nowrap;border:0;
    }
    #lexe-specs-offer-{{ sid }} .lso-unit{width:100%;min-width:0}
    #lexe-specs-offer-{{ sid }} .lso-panel{display:flex;width:100%;min-width:0}
    #lexe-specs-offer-{{ sid }} .lso-pill{
      width:100%;
      min-height:96px;
      display:flex;
      align-items:center;
      gap:14px;
      padding:8px 18px 8px 8px;
      border-radius:999px;
      text-decoration:none;
      color:inherit;
      min-width:0;
    }
    #lexe-specs-offer-{{ sid }} .lso-pill.is-rev{flex-direction:row-reverse;padding:8px 8px 8px 18px}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-paper{background:var(--paper);color:#141414;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-ink{background:var(--ink);color:#fff}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-accent{background:var(--accent);color:var(--on-accent)}
    #lexe-specs-offer-{{ sid }} .lso-orb{
      width:80px;height:80px;border-radius:50%;flex:none;
      display:grid;place-items:center;overflow:hidden;
      background:#111;color:#fff;
    }
    #lexe-specs-offer-{{ sid }} .lso-pill.is-loud .lso-orb{width:104px;height:104px}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-paper .lso-orb.is-mark,
    #lexe-specs-offer-{{ sid }} .lso-pill.is-paper .lso-orb.is-disc{background:#111;color:#fff}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-ink .lso-orb.is-mark,
    #lexe-specs-offer-{{ sid }} .lso-pill.is-ink .lso-orb.is-disc{background:#f4f4f1;color:#111}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-accent .lso-orb.is-mark,
    #lexe-specs-offer-{{ sid }} .lso-pill.is-accent .lso-orb.is-disc{background:#111;color:#fff}
    #lexe-specs-offer-{{ sid }} .lso-orb img{width:100%;height:100%;object-fit:cover;display:block}
    #lexe-specs-offer-{{ sid }} .lso-mark{
      font-size:22px;font-weight:800;letter-spacing:-.04em;line-height:1;text-transform:uppercase;
    }
    #lexe-specs-offer-{{ sid }} .lso-mark.is-long{font-size:12px;letter-spacing:.08em;text-align:center;padding:0 8px}
    #lexe-specs-offer-{{ sid }} .lso-mark.is-heart{
      font-size:34px;font-weight:400;letter-spacing:0;text-transform:none;color:#ff1f3d;
    }
    #lexe-specs-offer-{{ sid }} .lso-copy{flex:1;min-width:0;text-align:left}
    #lexe-specs-offer-{{ sid }} .lso-kicker{
      margin:0 0 3px;font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;opacity:.62;
    }
    #lexe-specs-offer-{{ sid }} .lso-h{
      margin:0;font-size:clamp(16px,4.4vw,22px);font-weight:700;line-height:.9;
      letter-spacing:-.035em;text-transform:uppercase;white-space:pre-line;
    }
    #lexe-specs-offer-{{ sid }} .lso-pill.is-loud{min-height:124px}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-loud .lso-h{font-size:clamp(28px,7vw,34px);letter-spacing:-.05em;line-height:.84}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-quiet .lso-h{font-size:13px;letter-spacing:.14em;font-weight:700;line-height:1.15}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-form .lso-h{font-size:14px;letter-spacing:.05em;line-height:1.05;font-weight:700}
    #lexe-specs-offer-{{ sid }} .lso-sub{margin:5px 0 0;font-size:12px;line-height:1.35;opacity:.72}
    #lexe-specs-offer-{{ sid }} .lso-sub a{color:inherit}
    #lexe-specs-offer-{{ sid }} .lso-go{
      margin:7px 0 0;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;
    }
    #lexe-specs-offer-{{ sid }} .lso-form{margin-top:8px;min-width:0}
    #lexe-specs-offer-{{ sid }} .lso-row{display:flex;gap:6px;min-width:0}
    #lexe-specs-offer-{{ sid }} .lso-row input{
      flex:1 1 auto;width:0;min-width:0;height:42px;margin:0;padding:0 14px;
      border:0;border-radius:999px;background:#fff;color:#111;
      font:inherit;font-size:16px;line-height:1;
      -webkit-appearance:none;appearance:none;box-shadow:none;
    }
    #lexe-specs-offer-{{ sid }} .lso-row input::placeholder{color:#8d8d8d}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-ink .lso-row input,
    #lexe-specs-offer-{{ sid }} .lso-pill.is-accent .lso-row input{
      background:rgba(255,255,255,.16);color:#fff;
    }
    #lexe-specs-offer-{{ sid }} .lso-pill.is-ink .lso-row input::placeholder,
    #lexe-specs-offer-{{ sid }} .lso-pill.is-accent .lso-row input::placeholder{color:rgba(255,255,255,.7)}
    #lexe-specs-offer-{{ sid }} .lso-row button{
      flex:none;width:auto;min-width:4.4rem;height:42px;margin:0;padding:0 14px;
      border:0;border-radius:999px;background:#111;color:#fff;
      font:inherit;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
      cursor:pointer;touch-action:manipulation;
    }
    #lexe-specs-offer-{{ sid }} .lso-pill.is-ink .lso-row button,
    #lexe-specs-offer-{{ sid }} .lso-pill.is-accent .lso-row button{background:#fff;color:#111}
    #lexe-specs-offer-{{ sid }} .lso-error{margin:6px 0 0;font-size:12px;line-height:1.3;color:#9f1239}
    #lexe-specs-offer-{{ sid }} .lso-pill.is-ink .lso-error,
    #lexe-specs-offer-{{ sid }} .lso-pill.is-accent .lso-error{color:#ffd0d6}
    #lexe-specs-offer-{{ sid }} .lso-code{
      display:inline-block;margin:8px 0 0;padding:5px 12px;
      border:1.5px dashed currentColor;border-radius:999px;
      font-size:14px;font-weight:800;letter-spacing:.14em;
    }
    #lexe-specs-offer-{{ sid }} .lso-note{
      width:min(400px,100%);margin:4px auto 0;text-align:center;
      font-size:11px;line-height:1.45;opacity:.62;
    }
    #lexe-specs-offer-{{ sid }} .lso-note a{color:inherit}
    #lexe-specs-offer-{{ sid }} a.lso-pill:focus-visible,
    #lexe-specs-offer-{{ sid }} .lso-row button:focus-visible,
    #lexe-specs-offer-{{ sid }} .lso-row input:focus-visible{
      outline:2px solid currentColor;outline-offset:3px;
    }
    @media (hover:hover){
      #lexe-specs-offer-{{ sid }} a.lso-pill.is-paper:hover{background:#e4e4e1}
      #lexe-specs-offer-{{ sid }} a.lso-pill.is-ink:hover{background:#242424}
    }
    #lexe-specs-offer-{{ sid }} .lso-radio{
      position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
      clip:rect(0,0,0,0);white-space:nowrap;border:0;
    }
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-root{
      width:min(640px,100%);
      flex-direction:row;
      flex-wrap:wrap;
      align-items:center;
      justify-content:center;
      gap:0;
    }
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-unit{display:contents}
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-panel{display:none;flex-basis:100%;order:2;margin-top:16px;justify-content:center}
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-unit:has(.lso-radio:checked) .lso-panel{display:flex}
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-pill{width:min(432px,100%)}
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-fuse-orb,
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-tab{
      order:0;background:var(--ink);color:#fff;cursor:pointer;touch-action:manipulation;
      position:relative;
    }
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-fuse-orb{
      order:-1;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;flex:none;
    }
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-fuse-orb:after,
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-tab:before{
      content:"";position:absolute;top:50%;width:14px;height:12px;margin-top:-6px;background:var(--ink);
    }
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-fuse-orb:after{right:-10px}
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-tab:before{left:-13px}
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-tab{
      min-height:54px;margin-left:8px;padding:0 12px;border-radius:999px;
      display:flex;align-items:center;font-size:13px;font-weight:600;letter-spacing:-.01em;
      white-space:nowrap;user-select:none;
    }
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-fuse-orb .lso-mark.is-heart{font-size:22px}
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-tab-last{padding:0 16px;font-weight:700}
    #lexe-specs-offer-{{ sid }}.is-fuse .lso-note{order:3;flex-basis:100%;margin-top:12px}
    {%- for i in (1..8) -%}
    #lexe-specs-offer-{{ sid }}.is-fuse:has(#lso-r-{{ sid }}-{{ i }}:checked) .lso-tab-{{ i }}{background:#fff;color:var(--ink)}
    #lexe-specs-offer-{{ sid }}.is-fuse:has(#lso-r-{{ sid }}-{{ i }}:checked) .lso-fuse-orb.is-for-{{ i }}{background:#fff;color:var(--ink)}
    #lexe-specs-offer-{{ sid }}.is-fuse:has(#lso-r-{{ sid }}-{{ i }}:focus-visible) .lso-tab-{{ i }}{outline:2px solid #fff;outline-offset:3px}
    {%- endfor -%}
    @media (max-width:380px){
      #lexe-specs-offer-{{ sid }} .lso-orb{width:68px;height:68px}
      #lexe-specs-offer-{{ sid }} .lso-pill.is-loud .lso-orb{width:88px;height:88px}
      #lexe-specs-offer-{{ sid }} .lso-mark.is-heart{font-size:28px}
      #lexe-specs-offer-{{ sid }}.is-fuse .lso-tab{font-size:12px;padding:0 9px;margin-left:4px}
      #lexe-specs-offer-{{ sid }}.is-fuse .lso-tab:before,
      #lexe-specs-offer-{{ sid }}.is-fuse .lso-fuse-orb:after{display:none}
    }
  </style>

  <div class="lso-root">
    <h2 id="lso-title-{{ sid }}" class="lso-sr">{{ s.heading | escape }}</h2>

    {%- if has_blocks -%}
      {%- assign keys = section.blocks -%}
    {%- else -%}
      {%- assign keys = 'product|service|waitlist|contact' | split: '|' -%}
    {%- endif -%}

    {%- for item in keys -%}
      {%- liquid
        assign n = forloop.index
        assign product = blank
        assign collection = blank
        assign image = blank
        assign link = blank
        assign text = blank
        assign mark = blank
        assign tags = blank
        assign block_ref = blank

        if has_blocks
          assign block_ref = item
          assign purpose = item.settings.purpose | default: 'link'
          assign kicker = item.settings.kicker
          assign heading = item.settings.heading
          assign nav = item.settings.nav_label
          assign text = item.settings.text
          assign mark = item.settings.mark
          assign button_label = item.settings.button_label
          assign tone = item.settings.tone | default: 'paper'
          assign object_mode = item.settings.object | default: 'auto'
          assign side = item.settings.side | default: 'auto'
          assign inline_form = item.settings.inline_form
          assign product = item.settings.product
          assign collection = item.settings.collection
          assign link = item.settings.link
          assign tags = item.settings.tags
          if item.settings.image != blank
            assign image = item.settings.image
          endif
        else
          assign inline_form = false
          assign tags = blank
          case item
            when 'product'
              assign purpose = 'product'
              assign kicker = 'LEXE'
              assign heading = 'Shop the drop'
              assign nav = 'Products'
              assign button_label = 'Shop'
              assign tone = 'paper'
              assign object_mode = 'photo'
              assign side = 'start'
              assign collection = s.product_collection
              if collection == blank
                assign collection = collections['lexe']
              endif
            when 'service'
              assign purpose = 'service'
              assign kicker = blank
              assign heading = 'Studio|support'
              assign nav = 'Services'
              assign text = 'Text the studio'
              assign button_label = 'Ask'
              assign tone = 'ink'
              assign object_mode = 'disc'
              assign side = 'end'
              assign link = s.service_link
            when 'waitlist'
              assign purpose = 'waitlist'
              assign kicker = 'Waitlist'
              assign heading = s.heading
              assign nav = 'Waitlist'
              assign button_label = s.button_label
              assign tone = 'paper'
              assign object_mode = 'mark'
              assign side = 'start'
              assign mark = '♥'
              assign inline_form = true
            else
              assign purpose = 'contact'
              assign kicker = blank
              assign heading = 'Talk|to us'
              assign nav = 'Contact'
              assign text = 'Orders, fits, anything.'
              assign button_label = 'Write'
              assign tone = 'ink'
              assign object_mode = 'mark'
              assign side = 'start'
              assign mark = 'HI'
              assign link = s.contact_link
          endcase
        endif

        if nav == blank
          case purpose
            when 'product'
              assign nav = 'Products'
            when 'service'
              assign nav = 'Services'
            when 'waitlist'
              assign nav = 'Waitlist'
            when 'contact'
              assign nav = 'Contact'
            else
              assign nav = heading | default: 'Open'
          endcase
        endif
        if heading == blank
          assign heading = nav
        endif
        if button_label == blank
          case purpose
            when 'product'
              assign button_label = 'Shop'
            when 'service'
              assign button_label = 'Ask'
            when 'contact'
              assign button_label = 'Write'
            else
              assign button_label = 'Join'
          endcase
        endif

        if image == blank and product != blank and product.featured_image != blank
          assign image = product.featured_image
        endif
        if image == blank and collection != blank and collection.image != blank
          assign image = collection.image
        endif

        assign href = link
        if href == blank and purpose == 'product'
          if product != blank
            assign href = product.url
          elsif collection != blank
            assign href = collection.url
          elsif s.product_collection != blank
            assign href = s.product_collection.url
          else
            assign href = routes.all_products_collection_url
          endif
        endif
        if href == blank and purpose != 'product' and purpose != 'waitlist'
          unless contact_ready
            assign contact_page = pages['contact-us']
            if contact_page == blank
              assign contact_page = pages['contact']
            endif
            assign contact_ready = true
          endunless
          if purpose == 'service' and s.service_link != blank
            assign href = s.service_link
          elsif purpose == 'contact' and s.contact_link != blank
            assign href = s.contact_link
          elsif contact_page != blank
            assign href = contact_page.url
          endif
        endif

        assign form_kind = 'none'
        if inline_form
          if purpose == 'waitlist'
            unless showed_form
              assign form_kind = 'customer'
              assign showed_form = true
            endunless
          elsif purpose == 'contact'
            unless contact_used
              assign form_kind = 'contact'
              assign contact_used = true
            endunless
          endif
        endif

        assign sub = blank
        if form_kind == 'none'
          if purpose == 'product'
            if product != blank
              assign sub = product.price | money
            elsif collection != blank and collection.products_count > 0
              assign sub = collection.products_count | append: ' pieces'
            elsif text != blank
              assign sub = text
            endif
          elsif text != blank
            assign sub = text
          endif
        endif

        if object_mode == blank or object_mode == 'auto'
          if purpose == 'product' and image != blank
            assign object_mode = 'photo'
          elsif purpose == 'waitlist'
            assign object_mode = 'mark'
          elsif purpose == 'service'
            assign object_mode = 'disc'
          elsif image != blank
            assign object_mode = 'photo'
          elsif mark != blank
            assign object_mode = 'mark'
          else
            assign object_mode = 'disc'
          endif
        endif
        if object_mode == 'photo' and image == blank
          assign object_mode = 'mark'
        endif
        assign mark = mark | strip
        if object_mode == 'mark' and mark == blank
          if purpose == 'waitlist'
            assign mark = '♥'
          else
            assign mark = heading | strip | slice: 0, 2 | upcase
          endif
        endif

        assign is_heart = false
        if mark == '♥' or mark == '❤'
          assign is_heart = true
        endif
        assign mark_long = false
        if mark.size > 2
          assign mark_long = true
        endif

        assign reversed = false
        assign parity = n | modulo: 2
        if side == 'end'
          assign reversed = true
        elsif side == 'auto' and parity == 0
          assign reversed = true
        endif

        assign loud = false
        assign quiet = false
        if purpose == 'service'
          assign loud = true
        elsif purpose == 'product'
          assign quiet = true
        endif

        assign external = false
        if href contains '://'
          unless href contains request.host
            assign external = true
          endunless
        endif

        assign tag_value = tags
        if tag_value == blank
          assign tag_value = s.customer_tags
        endif
        if tag_value == blank
          assign tag_value = 'newsletter,specs-offer'
        endif

        assign fid = 'LexeFunnel-' | append: sid | append: '-' | append: n
        assign checked = false
        if fuse and n == open_n
          assign checked = true
        endif
        assign is_link = false
        if form_kind == 'none' and href != blank
          assign is_link = true
        endif
      -%}

      <div class="lso-unit">
        {%- if fuse -%}
          <input class="lso-radio" type="radio" name="lso-{{ sid }}" id="lso-r-{{ sid }}-{{ n }}" {% if checked %}checked{% endif %}>
          <label class="lso-tab lso-tab-{{ n }}{% if n == total %} lso-tab-last{% endif %}" for="lso-r-{{ sid }}-{{ n }}">{{ nav | escape }}</label>
        {%- endif -%}

        <div class="lso-panel">
          {%- if is_link -%}
            <a class="lso-pill is-{{ tone }}{% if reversed %} is-rev{% endif %}{% if loud %} is-loud{% endif %}{% if quiet %} is-quiet{% endif %}" href="{{ href }}" {% if block_ref %}{{ block_ref.shopify_attributes }}{% endif %} {% if external %}target="_blank" rel="noopener noreferrer"{% endif %}>
          {%- else -%}
            <div class="lso-pill is-{{ tone }}{% if reversed %} is-rev{% endif %}{% if loud %} is-loud{% endif %}{% if quiet %} is-quiet{% endif %}{% if form_kind != 'none' %} is-form{% endif %}" {% if block_ref %}{{ block_ref.shopify_attributes }}{% endif %}>
          {%- endif -%}

            {%- if object_mode == 'photo' -%}
              <span class="lso-orb is-photo" aria-hidden="true">
                <img src="{{ image | image_url: width: 220 }}" alt="" width="104" height="104" loading="lazy" decoding="async" fetchpriority="low">
              </span>
            {%- elsif object_mode == 'mark' -%}
              <span class="lso-orb is-mark" aria-hidden="true"><span class="lso-mark{% if is_heart %} is-heart{% endif %}{% if mark_long %} is-long{% endif %}">{{ mark | escape }}</span></span>
            {%- else -%}
              <span class="lso-orb is-disc" aria-hidden="true"></span>
            {%- endif -%}

            <div class="lso-copy">
              {%- if form_kind == 'customer' -%}
                {%- form 'customer', id: fid, class: 'lso-form' -%}
                  {%- if form.posted_successfully? -%}
                    <div role="status">
                      <h3 class="lso-h">{{ s.success_heading | escape }}</h3>
                      {%- if settings.lexe_lock_notify == false -%}
                        <p class="lso-code">{{ s.code | escape }}</p>
                        <p class="lso-sub">
                          Add {% if s.gift_product != blank %}<a href="{{ s.gift_product.url }}">{{ s.gift_product.title | escape }}</a>{% else %}the gift{% endif %}{% if s.gift_product_2 != blank %} or <a href="{{ s.gift_product_2.url }}">{{ s.gift_product_2.title | escape }}</a>{% endif %}
                          with {{ s.threshold | escape }}+ product spend{% if s.eligible_url != blank %} on <a href="{{ s.eligible_url }}">eligible items</a>{% endif %}, then enter {{ s.code | escape }} at checkout.
                        </p>
                        {%- if s.terms != blank -%}<p class="lso-sub">{{ s.terms | escape }}</p>{%- endif -%}
                      {%- else -%}
                        <p class="lso-sub">We'll email you when new pieces drop.</p>
                      {%- endif -%}
                    </div>
                  {%- else -%}
                    {%- if kicker != blank -%}<p class="lso-kicker">{{ kicker | escape }}</p>{%- endif -%}
                    <h3 class="lso-h">{%- assign lso_bits = heading | split: '|' -%}{%- for bit in lso_bits -%}{{- bit | strip | escape -}}{%- unless forloop.last -%}<br>{%- endunless -%}{%- endfor -%}</h3>
                    <input type="hidden" name="contact[tags]" value="{{ tag_value | escape }}">
                    <input type="hidden" name="return_to" value="{{ request.path }}#lexe-specs-offer-{{ sid }}">
                    <div class="lso-row">
                      <label class="lso-sr" for="{{ fid }}-email">Email address</label>
                      <input id="{{ fid }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="Email" required {% if form.errors %}aria-invalid="true" aria-describedby="{{ fid }}-error"{% endif %}>
                      <button type="submit">{{ button_label | escape }}</button>
                    </div>
                    {%- if form.errors -%}
                      <p id="{{ fid }}-error" class="lso-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                    {%- endif -%}
                  {%- endif -%}
                {%- endform -%}
              {%- elsif form_kind == 'contact' -%}
                {%- form 'contact', id: fid, class: 'lso-form' -%}
                  {%- if form.posted_successfully? -%}
                    <div role="status">
                      <h3 class="lso-h">Sent</h3>
                      <p class="lso-sub">We'll get back to you.</p>
                    </div>
                  {%- else -%}
                    {%- if kicker != blank -%}<p class="lso-kicker">{{ kicker | escape }}</p>{%- endif -%}
                    <h3 class="lso-h">{%- assign lso_bits = heading | split: '|' -%}{%- for bit in lso_bits -%}{{- bit | strip | escape -}}{%- unless forloop.last -%}<br>{%- endunless -%}{%- endfor -%}</h3>
                    <input type="hidden" name="contact[body]" value="Sent from the footer funnel.">
                    <input type="hidden" name="return_to" value="{{ request.path }}#lexe-specs-offer-{{ sid }}">
                    <div class="lso-row">
                      <label class="lso-sr" for="{{ fid }}-email">Email address</label>
                      <input id="{{ fid }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="Email" required {% if form.errors %}aria-invalid="true" aria-describedby="{{ fid }}-error"{% endif %}>
                      <button type="submit">{{ button_label | escape }}</button>
                    </div>
                    {%- if form.errors -%}
                      <p id="{{ fid }}-error" class="lso-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                    {%- endif -%}
                  {%- endif -%}
                {%- endform -%}
              {%- else -%}
                {%- if kicker != blank -%}<p class="lso-kicker">{{ kicker | escape }}</p>{%- endif -%}
                <h3 class="lso-h">{%- assign lso_bits = heading | split: '|' -%}{%- for bit in lso_bits -%}{{- bit | strip | escape -}}{%- unless forloop.last -%}<br>{%- endunless -%}{%- endfor -%}</h3>
                {%- if sub != blank -%}<p class="lso-sub">{{ sub | escape }}</p>{%- endif -%}
                {%- if button_label != blank -%}<p class="lso-go">{{ button_label | escape }}</p>{%- endif -%}
              {%- endif -%}
            </div>

          {%- if is_link -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if fuse -%}
      <label class="lso-fuse-orb is-for-{{ open_n }}" for="lso-r-{{ sid }}-{{ open_n }}">
        <span class="lso-sr">{% if has_wait %}Waitlist{% else %}Open{% endif %}</span>
        {%- if has_wait -%}
          <span class="lso-mark is-heart" aria-hidden="true">♥</span>
        {%- endif -%}
      </label>
    {%- endif -%}

    {%- if showed_form -%}
      <p class="lso-note">
        {%- if s.text != blank -%}{{ s.text | escape }}{% endif %}
        {%- if s.eligible_url != blank %} <a href="{{ s.eligible_url }}">See what counts</a>.{% endif -%}
        {%- if s.consent != blank %} {{ s.consent | escape }}{% endif -%}
        {%- if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">Privacy</a>.{% endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LEXE Specs offer signup",
  "settings": [
    {
      "type": "paragraph",
      "content": "Stacked pills above the footer. Each block is a funnel. Switch its purpose any time between products, services, waitlist, contact, or a plain link. Objects are a photo, a word, or a solid circle — not icons. With no blocks, four funnels are built in."
    },
    {
      "type": "select",
      "id": "presentation",
      "label": "Layout",
      "default": "stack",
      "options": [
        { "value": "stack", "label": "Stacked pills" },
        { "value": "fuse", "label": "Connected switcher" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Section label", "default": "Be the first to know" },
    { "type": "textarea", "id": "text", "label": "Note under the stack", "default": "Join the list for first access to new pieces." },
    { "type": "text", "id": "button_label", "label": "Waitlist button (built-in stack)", "default": "Join" },
    { "type": "textarea", "id": "consent", "label": "Consent line", "default": "You're joining emails about new pieces and drops. Unsubscribe anytime." },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "You're on the list" },
    { "type": "text", "id": "customer_tags", "label": "Waitlist tags", "default": "newsletter,specs-offer" },
    { "type": "product", "id": "gift_product", "label": "Gift product" },
    { "type": "product", "id": "gift_product_2", "label": "Second gift product" },
    { "type": "url", "id": "eligible_url", "label": "Eligible items link" },
    { "type": "text", "id": "code", "label": "Discount code", "default": "LEXESPECS" },
    { "type": "text", "id": "threshold", "label": "Spend threshold", "default": "$45" },
    { "type": "textarea", "id": "terms", "label": "Terms line", "default": "One use per customer." },
    { "type": "collection", "id": "product_collection", "label": "Built-in product collection" },
    { "type": "url", "id": "service_link", "label": "Built-in service link" },
    { "type": "url", "id": "contact_link", "label": "Built-in contact link" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Note text", "default": "#2e2e2e" },
    { "type": "color", "id": "paper_color", "label": "Paper pill", "default": "#f1f1ef" },
    { "type": "color", "id": "ink_color", "label": "Ink pill", "default": "#111111" },
    { "type": "color", "id": "accent_color", "label": "Accent pill", "default": "#111111" },
    { "type": "color", "id": "accent_text", "label": "Accent text", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "default": 32, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "funnel",
      "name": "Funnel",
      "settings": [
        {
          "type": "select",
          "id": "purpose",
          "label": "Purpose",
          "default": "link",
          "options": [
            { "value": "product", "label": "Products" },
            { "value": "service", "label": "Services" },
            { "value": "waitlist", "label": "Waitlist" },
            { "value": "contact", "label": "Contact" },
            { "value": "link", "label": "Custom link" }
          ]
        },
        { "type": "text", "id": "nav_label", "label": "Short name", "info": "Used on the connected switcher." },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "New funnel", "info": "Press return to stack lines, like a poster." },
        { "type": "text", "id": "text", "label": "Line under the heading" },
        { "type": "text", "id": "mark", "label": "Object text", "info": "A word or one character. Waitlist: ♥. Contact: HI. Leave blank to use a photo or a solid circle." },
        { "type": "image_picker", "id": "image", "label": "Object photo" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "button_label", "label": "Button" },
        { "type": "text", "id": "tags", "label": "Waitlist tags", "info": "Blank uses the section tags." },
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "default": "paper",
          "options": [
            { "value": "paper", "label": "Paper" },
            { "value": "ink", "label": "Ink" },
            { "value": "accent", "label": "Accent" }
          ]
        },
        {
          "type": "select",
          "id": "object",
          "label": "Object",
          "default": "auto",
          "options": [
            { "value": "auto", "label": "Automatic" },
            { "value": "photo", "label": "Photo" },
            { "value": "mark", "label": "Text" },
            { "value": "disc", "label": "Solid circle" }
          ]
        },
        {
          "type": "select",
          "id": "side",
          "label": "Object side",
          "default": "auto",
          "options": [
            { "value": "auto", "label": "Alternate" },
            { "value": "start", "label": "Left" },
            { "value": "end", "label": "Right" }
          ]
        },
        { "type": "checkbox", "id": "inline_form", "label": "Email field inside the pill", "info": "Waitlist and contact only. Leave off to make the whole pill a link.", "default": true }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "LEXE funnels",
      "blocks": [
        {
          "type": "funnel",
          "settings": {
            "purpose": "product",
            "kicker": "LEXE",
            "heading": "Shop the drop",
            "nav_label": "Products",
            "button_label": "Shop",
            "tone": "paper",
            "object": "photo",
            "side": "start",
            "inline_form": false
          }
        },
        {
          "type": "funnel",
          "settings": {
            "purpose": "service",
            "heading": "Studio\nsupport",
            "nav_label": "Services",
            "text": "Text the studio",
            "button_label": "Ask",
            "tone": "ink",
            "object": "disc",
            "side": "end",
            "inline_form": false
          }
        },
        {
          "type": "funnel",
          "settings": {
            "purpose": "waitlist",
            "kicker": "Waitlist",
            "heading": "Be the first to know",
            "nav_label": "Waitlist",
            "mark": "♥",
            "button_label": "Join",
            "tone": "paper",
            "object": "mark",
            "side": "start",
            "inline_form": true
          }
        },
        {
          "type": "funnel",
          "settings": {
            "purpose": "contact",
            "heading": "Talk\nto us",
            "nav_label": "Contact",
            "text": "Orders, fits, anything.",
            "mark": "HI",
            "button_label": "Write",
            "tone": "ink",
            "object": "mark",
            "side": "start",
            "inline_form": false
          }
        }
      ]
    }
  ]
}
