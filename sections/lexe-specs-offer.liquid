{%- comment -%}
  LEXE Specs offer signup (2026-09-27). Standard Shopify customer newsletter form.
  Creates/updates a customer subscribed to email marketing, tagged newsletter + specs-offer.
  The code is shown only after a successful submit. Disable this section to hide the offer.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign gift = s.gift_product
  assign gift2 = s.gift_product_2
  assign sid = section.id
-%}
<section id="lexe-specs-offer-{{ sid }}" class="lso-{{ sid }}" aria-labelledby="lso-title-{{ sid }}">
  <style>
    .lso-{{ sid }}{background:{{ s.bg_color }};color:{{ s.text_color }};padding:{{ s.padding_top }}px 20px {{ s.padding_bottom }}px}
    .lso-{{ sid }} .lso-inner{max-width:560px;margin:0 auto;text-align:center}
    .lso-{{ sid }} h2{font-size:clamp(22px,3vw,28px);margin:0 0 8px;letter-spacing:.01em}
    .lso-{{ sid }} p{margin:0 0 14px;line-height:1.5}
    .lso-{{ sid }} .lso-row{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
    .lso-{{ sid }} input[type=email]{flex:1 1 240px;min-height:46px;padding:0 16px;border:1px solid #bdbdbd;border-radius:100px;font:inherit;color:#111;background:#fff}
    .lso-{{ sid }} button{min-height:46px;padding:0 22px;border:0;border-radius:100px;background:{{ s.accent_color }};color:#fff;font:inherit;font-weight:600;cursor:pointer}
    .lso-{{ sid }} .lso-note{font-size:13px;opacity:.8;margin-top:10px}
    .lso-{{ sid }} .lso-note a,.lso-{{ sid }} .lso-success a{color:inherit;text-decoration:underline}
    .lso-{{ sid }} .lso-code{display:inline-block;font-size:22px;font-weight:700;letter-spacing:.12em;padding:8px 18px;border:2px dashed {{ s.accent_color }};border-radius:10px;margin:6px 0 12px;user-select:all}
    .lso-{{ sid }} .lso-error{color:#b00020;font-size:14px}
  </style>
  <div class="lso-inner">
    {%- form 'customer', id: 'LexeSpecsOffer', class: 'lso-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="lso-success" role="status">
          <h2 id="lso-title-{{ sid }}">{{ s.success_heading | escape }}</h2>
          <p>Your code:</p>
          <div class="lso-code">{{ s.code | escape }}</div>
          <p>
            Add {% if gift != blank %}the <a href="{{ gift.url }}">{{ gift.title | escape }}</a>{% else %}the gift glasses{% endif %}{% if gift2 != blank %} or the <a href="{{ gift2.url }}">{{ gift2.title | escape }}</a>{% endif %}
            to your cart with {{ s.threshold | escape }} or more of {% if s.eligible_url != blank %}<a href="{{ s.eligible_url }}">eligible items</a>{% else %}eligible items{% endif %}, then enter {{ s.code | escape }} at checkout.
          </p>
          <p class="lso-note">{{ s.terms | escape }}</p>
        </div>
      {%- else -%}
        <h2 id="lso-title-{{ sid }}">{{ s.heading | escape }}</h2>
        <p>{{ s.text | escape }}{% if s.eligible_url != blank %} <a href="{{ s.eligible_url }}" style="color:inherit;text-decoration:underline">See what counts</a>.{% endif %}</p>
        <input type="hidden" name="contact[tags]" value="newsletter,specs-offer">
        <div class="lso-row">
          <label for="lso-email-{{ sid }}" class="visually-hidden">Email address</label>
          <input id="lso-email-{{ sid }}" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" autocorrect="off" placeholder="Email address" required
            {% if form.errors %}aria-invalid="true" aria-describedby="lso-error-{{ sid }}"{% endif %}>
          <button type="submit">{{ s.button_label | escape }}</button>
        </div>
        {%- if form.errors -%}
          <p id="lso-error-{{ sid }}" class="lso-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <p class="lso-note">
          {{ s.consent | escape }}
          {%- if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>.{% endif %}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "LEXE Specs offer signup",
  "settings": [
    { "type": "product", "id": "gift_product", "label": "Gift product" },
    { "type": "product", "id": "gift_product_2", "label": "Second gift product (optional)" },
    { "type": "url", "id": "eligible_url", "label": "Link to eligible items (optional)" },
    { "type": "text", "id": "code", "label": "Discount code (must match the live code)", "default": "LEXESPECS" },
    { "type": "text", "id": "threshold", "label": "Threshold shown to customers", "default": "$75" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Free LEXE Specs" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join the LEXE email list and we'll show your code for a free pair of LEXE Candy Sunglasses on orders of $75 or more." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Show my code" },
    { "type": "textarea", "id": "consent", "label": "Consent line", "default": "You're joining LEXE emails about new pieces and offers. You can unsubscribe anytime." },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "You're on the list" },
    { "type": "textarea", "id": "terms", "label": "Terms line", "default": "One per customer. Sunglasses and a few other items don't count toward the $75." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2e2e2e" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#3c2366" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "default": 32, "unit": "px" }
  ],
  "presets": [{ "name": "LEXE Specs offer signup" }]
}
{% endschema %}

