{%- comment -%}
  VANQUISH — Related products grid on the product page.
{%- endcomment -%}

{%- liquid
  assign sid    = section.id
  assign acc    = section.settings.ac
  assign sale_c = section.settings.sale_color
  assign rel_handle = ''
  if section.settings.related_collection != blank
    assign rel_handle = section.settings.related_collection.handle
  endif
  if rel_handle == blank
    for c in product.collections
      if c.handle != 'all' and c.products_count > 1
        assign rel_handle = c.handle
        break
      endif
    endfor
  endif
  if rel_handle == blank
    assign rel_handle = 'all'
  endif
  assign rel_coll = collections[rel_handle]
  assign current_id = product.id
-%}

<style>
  #ApexZenith-{{ sid }} {
    --gap: {{ section.settings.gap }}px;
    --rd: {{ section.settings.rd }}px;
    --ac: {{ acc }};
    --sale: {{ sale_c }};
    --ink: #111; --dim: #6b6b6b; --line: #ececec; --soft: #f7f7f7;
    max-width: {{ section.settings.max_w }}px;
    margin: 0 auto;
    padding: {{ section.settings.p_v }}px 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--ink);
  }
  .apex-rel-head-{{ sid }} { display:flex; align-items:baseline; justify-content:space-between; gap:16px; margin:0 0 28px; }
  .apex-rel-title-{{ sid }} { margin:0; font-size:13px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; }
  .apex-rel-rule-{{ sid }} { flex:1; height:1px; background:var(--line); }
  .apex-rel-count-{{ sid }} { font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--dim); }
  .apex-grid-{{ sid }} { display:grid; gap:var(--gap); grid-template-columns:repeat({{ section.settings.pc_cols }}, minmax(0,1fr)); }
  .apex-status-{{ sid }} { margin-top:48px; text-align:center; }
  @media (max-width:768px) { .apex-grid-{{ sid }} { grid-template-columns:repeat({{ section.settings.mb_cols }}, minmax(0,1fr)); } }
</style>

<div id="ApexZenith-{{ sid }}">
  {%- if section.settings.show_heading and section.settings.heading != blank -%}
    <div class="apex-rel-head-{{ sid }}">
      <h2 class="apex-rel-title-{{ sid }}">{{ section.settings.heading | escape }}</h2>
      <div class="apex-rel-rule-{{ sid }}"></div>
    </div>
  {%- endif -%}

  {%- if rel_coll != blank and rel_coll.products_count > 1 -%}
    {%- paginate collections[rel_handle].products by section.settings.page_limit -%}
      <div class="apex-grid-{{ sid }}" id="ApexGrid-{{ sid }}">
        {%- for product in collections[rel_handle].products -%}
          {%- unless product.id == current_id -%}
            {% render 'apex-zenith-card', product: product, is_eager: forloop.first %}
          {%- endunless -%}
        {%- endfor -%}
      </div>
      {%- if paginate.next -%}
        <div id="ApexSentinel-{{ sid }}" data-next-url="{{ request.path }}?section_id={{ section.id }}&page={{ paginate.current_page | plus: 1 }}" class="apex-status-{{ sid }}">Discovering more</div>
      {%- else -%}
        <div class="apex-status-{{ sid }}" id="ApexSentinel-{{ sid }}"></div>
        <script>if(window.vaGridEnd) window.vaGridEnd(document.getElementById('ApexSentinel-{{ sid }}'));</script>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

<script>
(function () {
  var SID = '{{ sid }}';
  var grid = document.getElementById('ApexGrid-' + SID);
  var sentinel = document.getElementById('ApexSentinel-' + SID);
  if (!sentinel || !grid) return;
  if (!sentinel.getAttribute('data-next-url')) {
    if (window.vaGridEnd) window.vaGridEnd(sentinel);
    return;
  }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (ent) {
      if (ent.isIntersecting && !sentinel.classList.contains('is-loading')) loadNext();
    });
  }, { rootMargin: '600px' });
  function loadNext() {
    sentinel.classList.add('is-loading');
    fetch(sentinel.getAttribute('data-next-url'), { headers: { 'X-Requested-With': 'XMLHttpRequest' }})
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        doc.querySelectorAll('#' + grid.id + ' > *').forEach(function (item) { grid.appendChild(item); });
        var nextSent = doc.getElementById(sentinel.id);
        if (nextSent && nextSent.getAttribute('data-next-url')) {
          sentinel.setAttribute('data-next-url', nextSent.getAttribute('data-next-url'));
          sentinel.classList.remove('is-loading');
        } else {
          if (window.vaGridEnd) window.vaGridEnd(sentinel);
          io.disconnect();
        }
      })
      .catch(function () { sentinel.classList.remove('is-loading'); });
  }
  io.observe(sentinel);
})();
</script>

{% schema %}
{
  "name": "Atelier Related Grid",
  "class": "va-related-grid-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Continue Shopping" },
    { "type": "collection", "id": "related_collection", "label": "Related collection" },
    { "type": "range", "id": "page_limit", "label": "Products loaded first", "min": 4, "max": 48, "step": 4, "default": 12 },
    { "type": "range", "id": "pc_cols", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "mb_cols", "label": "Mobile columns", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "max_w", "label": "Max width", "min": 800, "max": 1600, "step": 50, "default": 1300 },
    { "type": "range", "id": "gap", "label": "Card gap", "min": 6, "max": 50, "step": 2, "default": 16 },
    { "type": "range", "id": "p_v", "label": "Vertical padding", "min": 0, "max": 100, "step": 5, "default": 40 },
    { "type": "range", "id": "rd", "label": "Image rounding", "min": 0, "max": 40, "step": 2, "default": 4 },
    { "type": "select", "id": "ratio", "label": "Image ratio", "options": [
      { "value": "1/1", "label": "Square" },
      { "value": "3/4", "label": "Portrait (3:4)" },
      { "value": "4/5", "label": "Portrait (4:5)" }
    ], "default": "1/1" },
    { "type": "color", "id": "ac", "label": "Accent", "default": "#111111" },
    { "type": "color", "id": "sale_color", "label": "Sale color", "default": "#c8102e" }
  ],
  "presets": [{ "name": "Atelier Related Grid" }]
}
{% endschema %}
