{%- liquid
  assign mode = section.settings.position_mode | default: 'bottom'
  assign bg_color = section.settings.background_color | default: '#ffffff'
  assign tab_bg = section.settings.tab_background | default: '#e60023'
  assign text_color = section.settings.text_color | default: '#111111'
  assign active_text = section.settings.active_text_color | default: '#ffffff'
  assign max_tabs = 7
-%}

<style>
  {%- if section.settings.custom_font != blank -%}
    {{ section.settings.custom_font | font_face }}
    :root {
      --apex-font: {{ section.settings.custom_font.family }}, {{ section.settings.custom_font.fallback_families }};
      --apex-weight: {{ section.settings.custom_font.weight }};
    }
  {%- else -%}
    :root {
      --apex-font: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --apex-weight: 500;
    }
  {%- endif -%}

  .apex-notch-nav {
    --apex-bg: {{ bg_color }};
    --apex-tab: {{ tab_bg }};
    --apex-text: {{ text_color }};
    --apex-active: {{ active_text }};
    font-family: var(--apex-font);
    font-weight: var(--apex-weight);
    z-index: 999;
    pointer-events: none;
  }

  .apex-notch-nav * {
    pointer-events: auto;
  }

  /* Floating pill bar */
  .apex-notch-nav[data-mode="bottom"] {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: auto;
    max-width: calc(100vw - 32px);
    height: 72px;
    background: var(--apex-bg);
    border-radius: 40px;
    display: flex;
    align-items: center;
    padding: 8px 12px 8px 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06);
    overflow: visible;
  }

  .apex-notch-nav[data-mode="left"] {
    position: fixed;
    left: 24px;
    top: 50%;
    transform: translateY(-50%);
    width: 80px;
    height: auto;
    background: var(--apex-bg);
    border-radius: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    overflow: visible;
  }

  .apex-notch-nav[data-mode="right"] {
    position: fixed;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    width: 80px;
    height: auto;
    background: var(--apex-bg);
    border-radius: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    overflow: visible;
  }

  .apex-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .apex-notch-nav[data-mode="left"] .apex-tabs,
  .apex-notch-nav[data-mode="right"] .apex-tabs {
    flex-direction: column;
    gap: 6px;
  }

  /* Inactive tabs */
  .apex-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-decoration: none;
    color: var(--apex-text);
    padding: 10px 16px;
    border-radius: 28px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    min-width: 64px;
    font-size: 12px;
    letter-spacing: 0.2px;
    background: transparent;
    flex-shrink: 0;
  }

  .apex-notch-nav[data-mode="left"] .apex-tab,
  .apex-notch-nav[data-mode="right"] .apex-tab {
    width: 64px;
    min-height: 64px;
    padding: 10px 6px;
  }

  /* ACTIVE — large protruding circle bubble that overlaps the pill */
  .apex-tab.active {
    background: var(--apex-tab);
    color: var(--apex-active);
    width: 72px;
    height: 72px;
    min-width: 72px;
    border-radius: 50%;
    padding: 0;
    margin: -8px -4px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.18);
    z-index: 5;
    transform: scale(1.05);
  }

  .apex-notch-nav[data-mode="bottom"] .apex-tab.active {
    margin-left: -12px;
    margin-right: 4px;
  }

  .apex-notch-nav[data-mode="left"] .apex-tab.active,
  .apex-notch-nav[data-mode="right"] .apex-tab.active {
    width: 72px;
    height: 72px;
    margin: -6px 0;
  }

  .apex-tab-icon {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .apex-tab.active .apex-tab-icon {
    width: 32px;
    height: 32px;
  }

  .apex-tab-icon svg,
  .apex-tab-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    fill: currentColor;
    stroke: currentColor;
  }

  .apex-tab-label {
    font-size: 11px;
    line-height: 1.1;
    text-align: center;
    white-space: nowrap;
    font-weight: 500;
  }

  .apex-tab.active .apex-tab-label {
    display: none;
  }

  .apex-cart-count {
    position: absolute;
    top: -6px;
    right: -6px;
    background: #e60023;
    color: #fff;
    border-radius: 50%;
    min-width: 18px;
    height: 18px;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
    border: 2px solid var(--apex-bg);
  }

  .apex-search-bar {
    position: fixed;
    background: #ffffff;
    border-radius: 28px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    z-index: 998;
  }

  .apex-notch-nav[data-mode="bottom"] ~ .apex-search-bar {
    bottom: 112px;
    left: 50%;
    transform: translateX(-50%);
    width: min(420px, calc(100vw - 48px));
  }

  .apex-search-input {
    border: none;
    background: transparent;
    outline: none;
    flex: 1;
    font-size: 16px;
    color: #333;
    font-family: inherit;
  }

  @media (max-width: 749px) {
    .apex-notch-nav[data-mode="bottom"] {
      bottom: 16px;
      height: 64px;
      padding: 6px 10px 6px 6px;
    }
    .apex-tab {
      min-width: 52px;
      padding: 8px 10px;
    }
    .apex-tab.active {
      width: 64px;
      height: 64px;
      min-width: 64px;
    }
    .apex-tab-label {
      font-size: 10px;
    }
  }
</style>

<nav class="apex-notch-nav" data-mode="{{ mode }}" role="navigation" aria-label="Primary">
  <div class="apex-tabs">
    {%- for block in section.blocks limit: max_tabs -%}
      {%- liquid
        assign is_active = false
        if block.settings.url != blank and request.path == block.settings.url
          assign is_active = true
        endif
        assign tab_label = block.settings.label | default: 'Tab'
      -%}

      <a href="{{ block.settings.url | default: '#' }}"
         class="apex-tab{% if is_active %} active{% endif %}"
         {{ block.shopify_attributes }}
         {% if block.settings.is_logo %}data-logo="true"{% endif %}>

        <span class="apex-tab-icon">
          {%- if block.settings.icon_custom != blank -%}
            <img src="{{ block.settings.icon_custom | image_url: width: 64 }}" alt="">
          {%- else -%}
            {%- case block.settings.icon_default -%}
              {%- when 'cart' -%}
                <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
              {%- when 'profile' -%}
                <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              {%- when 'orders' -%}
                <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
              {%- when 'search' -%}
                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
              {%- when 'menu' -%}
                <svg viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
              {%- when 'home' -%}
                <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>
            {%- endcase -%}
          {%- endif -%}

          {%- if block.settings.icon_default == 'cart' and cart.item_count > 0 -%}
            <span class="apex-cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </span>

        {%- unless block.settings.hide_label -%}
          <span class="apex-tab-label">{{ tab_label }}</span>
        {%- endunless -%}
      </a>
    {%- endfor -%}
  </div>
</nav>

{%- if section.settings.show_search -%}
  <div class="apex-search-bar">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="#666"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
    <input type="search" class="apex-search-input" placeholder="Search" aria-label="Search">
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Apex Notch Tab Nav",
  "tag": "div",
  "class": "apex-notch-section",
  "max_blocks": 7,
  "settings": [
    {
      "type": "select",
      "id": "position_mode",
      "label": "Position Mode",
      "options": [
        { "value": "left", "label": "Left Side" },
        { "value": "right", "label": "Right Side" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Bar Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_background",
      "label": "Active Tab Background",
      "default": "#e60023"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Inactive Text / Icon",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Active Tab Text",
      "default": "#ffffff"
    },
    {
      "type": "font_picker",
      "id": "custom_font",
      "label": "Tab Font",
      "default": "assistant_n4"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Bar",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Home"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon_default",
          "label": "Default Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "cart", "label": "Cart" },
            { "value": "profile", "label": "Profile" },
            { "value": "orders", "label": "Orders" },
            { "value": "search", "label": "Search" },
            { "value": "menu", "label": "Menu" },
            { "value": "home", "label": "Home" }
          ],
          "default": "home"
        },
        {
          "type": "image_picker",
          "id": "icon_custom",
          "label": "Custom Icon (overrides default)"
        },
        {
          "type": "checkbox",
          "id": "is_logo",
          "label": "Logo Style Tab",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "hide_label",
          "label": "Icon Only",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Apex Notch Tab Nav",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "Home",
            "url": "/",
            "icon_default": "home",
            "is_logo": true
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Search",
            "url": "/search",
            "icon_default": "search"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Cart",
            "url": "/cart",
            "icon_default": "cart"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Profile",
            "url": "/account",
            "icon_default": "profile"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Orders",
            "url": "/account/orders",
            "icon_default": "orders"
          }
        }
      ]
    }
  ]
}
{% endschema %}