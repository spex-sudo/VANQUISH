{%- liquid
  assign mode = section.settings.position_mode | default: 'bottom'
  assign side_mode = section.settings.side_mode | default: 'left'
  assign side_pages = section.settings.side_pages | default: '' | downcase
  assign hide_pages = section.settings.hide_pages | default: '' | downcase

  assign current_handle = page.handle | default: product.handle | default: collection.handle | default: '' | downcase
  assign current_template = template.name | default: '' | downcase
  assign page_type = request.page_type | default: '' | downcase

  assign should_hide = false
  if hide_pages != blank
    assign hide_list = hide_pages | split: ','
    for p in hide_list
      assign clean = p | strip
      if clean == current_handle or clean == current_template or clean == page_type
        assign should_hide = true
        break
      endif
    endfor
  endif

  if side_pages != blank and should_hide == false
    assign pages_list = side_pages | split: ','
    for p in pages_list
      assign clean = p | strip
      if clean == current_handle or clean == current_template or clean == page_type
        assign mode = side_mode
        break
      endif
    endfor
  endif

  assign bg_color = section.settings.background_color | default: '#f5f5f7'
  assign tab_bg = section.settings.tab_background | default: '#e60023'
  assign text_color = section.settings.text_color | default: '#1d1d1f'
  assign icon_color = section.settings.icon_color | default: text_color
  assign active_text = section.settings.active_text_color | default: '#ffffff'
  assign size = section.settings.section_size | default: 'medium'
  assign bottom_offset = section.settings.bottom_offset | default: 24
  assign hide_on_footer = section.settings.hide_on_footer
  assign max_tabs = 7

  case size
    when 'small'
      assign bar_h = 60
      assign bubble = 60
      assign icon_s = 22
      assign pad = 6
    when 'large'
      assign bar_h = 88
      assign bubble = 88
      assign icon_s = 32
      assign pad = 10
    else
      assign bar_h = 72
      assign bubble = 72
      assign icon_s = 26
      assign pad = 8
  endcase
-%}

{%- unless should_hide -%}

<style>
  /* Hard lock: never allow horizontal scroll or section movement */
  html, body {
    overflow-x: hidden !important;
    max-width: 100vw !important;
    overscroll-behavior-x: none;
  }
  .apex-notch-section {
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    height: 0 !important;
    min-height: 0 !important;
    overflow: visible !important;
    position: static !important;
  }
  .apex-notch-nav {
    position: fixed !important;
    display: flex !important;
    visibility: visible !important;
    opacity: 1;
  }
  .apex-notch-nav {
    position: fixed !important;
    isolation: isolate;
    contain: layout style paint;
  }
  .apex-notch-nav[data-mode="bottom"] {
    left: 50% !important;
    transform: translate3d(-50%, 0, 0) !important;
    width: max-content !important;
    max-width: calc(100vw - 24px) !important;
  }
  .apex-notch-nav[data-mode="left"],
  .apex-notch-nav[data-mode="right"] {
    transform: translate3d(0, -50%, 0) !important;
  }

  {%- if section.settings.custom_font != blank -%}
    {{ section.settings.custom_font | font_face }}
    :root {
      --apex-font: {{ section.settings.custom_font.family }}, {{ section.settings.custom_font.fallback_families }};
      --apex-weight: {{ section.settings.custom_font.weight }};
    }
  {%- else -%}
    :root {
      --apex-font: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --apex-weight: 500;
    }
  {%- endif -%}

  .apex-notch-nav {
    --apex-bg: {{ bg_color }};
    --apex-tab: {{ tab_bg }};
    --apex-text: {{ text_color }};
    --apex-icon: {{ icon_color }};
    --apex-active: {{ active_text }};
    --bar-h: {{ bar_h }}px;
    --bubble: {{ bubble }}px;
    --icon: {{ icon_s }}px;
    --pad: {{ pad }}px;
    --offset: {{ bottom_offset }}px;
    font-family: var(--apex-font);
    font-weight: var(--apex-weight);
    z-index: 999;
    pointer-events: none;
    contain: layout style;
    will-change: opacity, transform;
    transition: opacity 0.28s ease, transform 0.28s ease;
  }

  .apex-notch-nav.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(16px);
  }

  .apex-notch-nav[data-mode="left"].is-hidden,
  .apex-notch-nav[data-mode="right"].is-hidden {
    transform: translateY(-50%) translateX(-16px);
  }

  .apex-notch-nav * {
    pointer-events: auto;
  }

  .apex-notch-nav[data-mode="bottom"] {
    position: fixed;
    bottom: var(--offset);
    left: 50%;
    transform: translateX(-50%);
    width: auto;
    max-width: calc(100vw - 32px);
    height: var(--bar-h);
    background: var(--apex-bg);
    border-radius: 48px;
    display: flex;
    align-items: center;
    padding: var(--pad) calc(var(--pad) + 4px) var(--pad) var(--pad);
    box-shadow:
      6px 6px 16px rgba(0,0,0,0.08),
      inset -3px -3px 6px rgba(0,0,0,0.06),
      inset 3px 3px 6px rgba(255,255,255,0.35);
    overflow: visible;
  }

  .apex-notch-nav[data-mode="left"] {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 72px;
    height: auto;
    min-height: 280px;
    background: #000;
    border-radius: 0 80px 80px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px 10px 28px 6px;
    box-shadow: 4px 0 20px rgba(0,0,0,0.25);
    overflow: visible;
  }

  .apex-notch-nav[data-mode="right"] {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 72px;
    height: auto;
    min-height: 280px;
    background: #000;
    border-radius: 80px 0 0 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px 6px 28px 10px;
    box-shadow: -4px 0 20px rgba(0,0,0,0.25);
    overflow: visible;
  }

  
  .apex-notch-shape { display: none; }
  .apex-tabs { list-style: none; margin: 0; padding: 0; }
  .apex-tab-item { list-style: none; margin: 0; padding: 0; }
  .apex-tabs {
    display: flex;
    align-items: center;
    gap: 2px;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .apex-notch-nav[data-mode="left"] .apex-tabs,
  .apex-notch-nav[data-mode="right"] .apex-tabs {
    flex-direction: column;
    gap: 4px;
    justify-content: center;
  }

  .apex-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-decoration: none;
    color: var(--apex-text);
    padding: 8px 14px;
    border-radius: 32px;
    transition: background-color 0.22s ease, color 0.22s ease, transform 0.22s ease;
    position: relative;
    min-width: 56px;
    font-size: 12px;
    letter-spacing: 0.1px;
    background: transparent;
    flex-shrink: 0;
  }

  .apex-notch-nav[data-mode="left"] .apex-tab,
  .apex-notch-nav[data-mode="right"] .apex-tab {
    width: 48px;
    min-height: 48px;
    padding: 8px;
    color: #fff;
    background: transparent;
    border-radius: 14px;
  }
  .apex-notch-nav[data-mode="left"] .apex-tab-label,
  .apex-notch-nav[data-mode="right"] .apex-tab-label {
    display: none;
  }
  .apex-notch-nav[data-mode="left"] .apex-tab-icon,
  .apex-notch-nav[data-mode="right"] .apex-tab-icon {
    color: #fff;
  }

  .apex-tab.active {
    background: var(--apex-tab);
    color: var(--apex-active);
    width: var(--bubble);
    height: var(--bubble);
    min-width: var(--bubble);
    border-radius: 50%;
    padding: 0;
    margin: calc(var(--pad) * -1) -4px;
    box-shadow:
      5px 5px 14px rgba(0,0,0,0.1),
      inset -2px -2px 5px rgba(0,0,0,0.12),
      inset 2px 2px 5px rgba(255,255,255,0.25);
    z-index: 5;
    transform: scale(1.03);
  }

  .apex-notch-nav[data-mode="bottom"] .apex-tab.active {
    margin-left: -8px;
    margin-right: 0;
  }

  .apex-notch-nav[data-mode="left"] .apex-tab.active,
  .apex-notch-nav[data-mode="right"] .apex-tab.active {
    width: 48px;
    height: 48px;
    margin: 0;
    background: rgba(255,255,255,0.12);
    border-radius: 16px;
    transform: none;
    box-shadow: none;
  }

  .apex-tab-icon {
    width: var(--icon);
    height: var(--icon);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: var(--apex-icon);
  }

  .apex-tab.active .apex-tab-icon {
    width: calc(var(--icon) + 6px);
    height: calc(var(--icon) + 6px);
    color: var(--apex-active);
  }

  .apex-tab-icon svg,
  .apex-tab-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    fill: currentColor;
    stroke: currentColor;
  }

  .apex-tab-label {
    font-size: 11px;
    line-height: 1.1;
    text-align: center;
    white-space: nowrap;
    font-weight: 500;
    color: var(--apex-text);
  }

  .apex-tab.active .apex-tab-label {
    display: none;
  }

  .apex-cart-count,
  .apex-fav-count {
    position: absolute;
    top: -6px;
    right: -6px;
    background: #e60023;
    color: #fff;
    border-radius: 50%;
    min-width: 18px;
    height: 18px;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
    border: 2px solid var(--apex-bg);
  }

  /* Clay favorites pop-out */
  .apex-favs-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .apex-favs-overlay.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  .apex-favs-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.28);
    backdrop-filter: blur(2px);
  }
  .apex-favs-panel {
    position: relative;
    width: min(420px, calc(100vw - 32px));
    max-height: 72vh;
    background: var(--apex-bg, #f5f5f7);
    border-radius: 32px;
    margin-bottom: calc(var(--offset, 24px) + var(--bar-h, 72px) + 12px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow:
      8px 8px 24px rgba(0,0,0,0.12),
      inset -3px -3px 6px rgba(0,0,0,0.05),
      inset 3px 3px 6px rgba(255,255,255,0.4);
    transform: translateY(20px) scale(0.96);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .apex-favs-overlay.is-open .apex-favs-panel {
    transform: translateY(0) scale(1);
  }
  .apex-favs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px 12px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .apex-favs-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    color: var(--apex-text);
  }
  .apex-favs-close {
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 50%;
    background: rgba(0,0,0,0.06);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--apex-text);
  }
  .apex-favs-body {
    flex: 1;
    overflow-y: auto;
    padding: 8px 12px 16px;
  }
  .apex-fav-item {
    display: flex;
    gap: 12px;
    padding: 10px;
    border-radius: 20px;
    margin-bottom: 6px;
    background: rgba(255,255,255,0.5);
    box-shadow:
      inset 2px 2px 4px rgba(255,255,255,0.6),
      inset -1px -1px 3px rgba(0,0,0,0.04);
  }
  .apex-fav-thumb {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    object-fit: cover;
    flex-shrink: 0;
    background: #eee;
  }
  .apex-fav-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
  }
  .apex-fav-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--apex-text);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .apex-fav-price {
    font-size: 12px;
    color: var(--apex-text);
    opacity: 0.7;
  }
  .apex-fav-actions {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
  }
  .apex-fav-btn {
    border: none;
    border-radius: 12px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    background: var(--apex-tab, #e60023);
    color: #fff;
  }
  .apex-fav-btn.remove {
    background: transparent;
    color: var(--apex-text);
    opacity: 0.6;
  }
  .apex-favs-empty {
    text-align: center;
    padding: 32px 16px;
    color: var(--apex-text);
    opacity: 0.6;
    font-size: 13px;
  }

  @media (max-width: 749px) {
    .apex-notch-nav[data-mode="bottom"] {
      bottom: calc(var(--offset) - 8px);
    }
    .apex-notch-nav[data-mode="left"],
    .apex-notch-nav[data-mode="right"] {
      width: calc(var(--bar-h) + 4px);
    }
    .apex-tab {
      min-width: 48px;
      padding: 6px 10px;
    }
    .apex-tab-label {
      font-size: 10px;
    }
    .apex-favs-panel {
      margin-bottom: calc(var(--offset, 24px) + var(--bar-h, 72px) - 4px);
    }
  }
</style>

<nav class="apex-notch-nav" data-mode="{{ mode }}" data-hide-footer="{{ hide_on_footer }}" role="navigation" aria-label="Primary">
  <div class="apex-notch-shape" aria-hidden="true"></div>
  <ul class="apex-tabs" role="list">
    {%- for block in section.blocks limit: max_tabs -%}
      {%- liquid
        assign is_active = false
        if block.settings.url != blank
          if request.path == block.settings.url or request.path contains block.settings.url
            assign is_active = true
          endif
        endif
        assign tab_label = block.settings.label | default: 'Tab'
        assign is_fav = false
        if block.settings.icon_default == 'favorites'
          assign is_fav = true
        endif
      -%}

      <li class="apex-tab-item" {{ block.shopify_attributes }}>
      <a href="{{ block.settings.url | default: '#' }}"
         class="apex-tab{% if is_active %} active{% endif %}"
         aria-label="{{ tab_label | escape }}"
         {% if is_active %}aria-current="page"{% endif %}
         {% if is_fav %}data-apex-favorites aria-haspopup="dialog"{% endif %}
         {% if block.settings.is_logo %}data-logo="true"{% endif %}>

        <span class="apex-tab-icon" aria-hidden="true">
          {%- if block.settings.icon_custom != blank -%}
            <img src="{{ block.settings.icon_custom | image_url: width: 64 }}" alt="" loading="lazy" width="32" height="32">
          {%- else -%}
            {%- case block.settings.icon_default -%}
              {%- when 'cart' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
              {%- when 'profile' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              {%- when 'orders' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
              {%- when 'search' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
              {%- when 'menu' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
              {%- when 'home' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
              {%- when 'favorites' -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg>
            {%- endcase -%}
          {%- endif -%}

          {%- if block.settings.icon_default == 'cart' -%}
            <span class="apex-cart-count" data-apex-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
          {%- endif -%}
          {%- if is_fav -%}
            <span class="apex-fav-count" data-apex-fav-count hidden>0</span>
          {%- endif -%}
        </span>

        {%- unless block.settings.hide_label -%}
          <span class="apex-tab-label">{{ tab_label }}</span>
        {%- endunless -%}
      </a>
      </li>
    {%- endfor -%}
  </ul>
</nav>

<div class="apex-favs-overlay" id="apex-favs-overlay" aria-hidden="true">
  <div class="apex-favs-backdrop" data-favs-backdrop></div>
  <div class="apex-favs-panel" role="dialog" aria-modal="true" aria-label="Favorites">
    <div class="apex-favs-head">
      <h2 class="apex-favs-title">Saved</h2>
      <button type="button" class="apex-favs-close" data-favs-close aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="apex-favs-body" data-favs-body>
      <div class="apex-favs-empty">No favorites yet.</div>
    </div>
  </div>
</div>

{%- if section.settings.show_search -%}
  <div class="apex-search-bar">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
    <input type="search" class="apex-search-input" placeholder="Search" aria-label="Search">
  </div>
{%- endif -%}

<script>
  (function() {
    'use strict';
    const nav = document.querySelector('.apex-notch-nav');
    if (!nav) return;

    const FAV_KEY = 'apex_favs_v1';
    const overlay = document.getElementById('apex-favs-overlay');
    const body = overlay && overlay.querySelector('[data-favs-body]');
    const favCountEls = document.querySelectorAll('[data-apex-fav-count]');

    function readFavs() {
      try {
        const raw = localStorage.getItem(FAV_KEY);
        if (!raw) return [];
        const arr = JSON.parse(raw);
        return Array.isArray(arr) ? arr : [];
      } catch (e) { return []; }
    }
    function writeFavs(arr) {
      try { localStorage.setItem(FAV_KEY, JSON.stringify(arr)); } catch (e) {}
    }

    window.ApexFavorites = window.ApexFavorites || {
      list: readFavs,
      has: function(h) { return readFavs().indexOf(h) !== -1; },
      add: function(h) {
        if (!h) return;
        const f = readFavs();
        if (f.indexOf(h) === -1) f.push(h);
        writeFavs(f);
        document.dispatchEvent(new CustomEvent('apex:favorites-changed', { detail: { handle: h, action: 'add' } }));
      },
      remove: function(h) {
        writeFavs(readFavs().filter(x => x !== h));
        document.dispatchEvent(new CustomEvent('apex:favorites-changed', { detail: { handle: h, action: 'remove' } }));
      },
      toggle: function(h) { this.has(h) ? this.remove(h) : this.add(h); },
      count: function() { return readFavs().length; }
    };

    function updateFavCount() {
      const n = readFavs().length;
      favCountEls.forEach(el => {
        el.textContent = n;
        el.hidden = n < 1;
      });
    }
    updateFavCount();

    const productCache = {};
    function fetchProduct(handle) {
      if (productCache[handle]) return Promise.resolve(productCache[handle]);
      return fetch('/products/' + encodeURIComponent(handle) + '.js', { headers: { 'Accept': 'application/json' } })
        .then(r => r.ok ? r.json() : null)
        .then(p => { if (p) productCache[handle] = p; return p; })
        .catch(() => null);
    }

    function formatMoney(cents) {
      return (cents / 100).toFixed(2);
    }

    function renderFavs() {
      if (!body) return;
      const handles = readFavs();
      if (!handles.length) {
        body.innerHTML = '<div class="apex-favs-empty">No favorites yet.</div>';
        return;
      }
      body.innerHTML = '<div class="apex-favs-empty">Loading…</div>';
      Promise.all(handles.map(fetchProduct)).then(products => {
        const html = products.map((p, i) => {
          if (!p) return '';
          const handle = handles[i];
          const img = p.featured_image || (p.images && p.images[0]) || '';
          const price = p.price || (p.variants && p.variants[0] && p.variants[0].price) || 0;
          const vid = p.variants && p.variants[0] && p.variants[0].id;
          return `
            <div class="apex-fav-item">
              <img class="apex-fav-thumb" src="${img}" alt="" loading="lazy">
              <div class="apex-fav-info">
                <a class="apex-fav-title" href="/products/${handle}">${p.title || handle}</a>
                <div class="apex-fav-price">${formatMoney(price)}</div>
              </div>
              <div class="apex-fav-actions">
                ${vid ? `<button type="button" class="apex-fav-btn" data-fav-add="${vid}">Add</button>` : ''}
                <button type="button" class="apex-fav-btn remove" data-fav-remove="${handle}">Remove</button>
              </div>
            </div>
          `;
        }).join('');
        body.innerHTML = html || '<div class="apex-favs-empty">No favorites yet.</div>';
      });
    }

    function openFavs(e) {
      if (e) e.preventDefault();
      if (!overlay) return;
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      renderFavs();
    }
    function closeFavs() {
      if (!overlay) return;
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
    }

    document.querySelectorAll('[data-apex-favorites]').forEach(el => {
      el.addEventListener('click', openFavs);
    });
    if (overlay) {
      overlay.querySelector('[data-favs-backdrop]').addEventListener('click', closeFavs);
      overlay.querySelector('[data-favs-close]').addEventListener('click', closeFavs);
      body && body.addEventListener('click', e => {
        const rm = e.target.closest('[data-fav-remove]');
        if (rm) {
          e.preventDefault();
          window.ApexFavorites.remove(rm.getAttribute('data-fav-remove'));
          return;
        }
        const add = e.target.closest('[data-fav-add]');
        if (add) {
          e.preventDefault();
          const vid = add.getAttribute('data-fav-add');
          const fd = new FormData();
          fd.append('id', vid);
          fd.append('quantity', 1);
          fetch('/cart/add.js', { method: 'POST', body: fd, headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.ok ? r.json() : Promise.reject())
            .then(() => {
              document.dispatchEvent(new CustomEvent('cart:refresh'));
              add.textContent = 'Added';
              setTimeout(() => { add.textContent = 'Add'; }, 1400);
            })
            .catch(() => {});
        }
      });
    }

    document.addEventListener('apex:favorites-changed', () => {
      updateFavCount();
      if (overlay && overlay.classList.contains('is-open')) renderFavs();
    });
    window.addEventListener('storage', e => {
      if (e.key === FAV_KEY) {
        updateFavCount();
        if (overlay && overlay.classList.contains('is-open')) renderFavs();
      }
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && overlay && overlay.classList.contains('is-open')) closeFavs();
    });

    /* Footer hide */
    if (nav.dataset.hideFooter === 'true') {
      const footer = document.querySelector('footer, .footer, #footer, [role="contentinfo"]');
      let ticking = false;
      const update = (hidden) => nav.classList.toggle('is-hidden', hidden);

      if (footer && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(entries => update(entries[0].isIntersecting), { rootMargin: '0px 0px -40px 0px', threshold: 0 });
        io.observe(footer);
      } else {
        const check = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const scrolled = window.scrollY + window.innerHeight;
            const total = document.documentElement.scrollHeight;
            update(total - scrolled < 120);
            ticking = false;
          });
        };
        window.addEventListener('scroll', check, { passive: true });
        window.addEventListener('resize', check, { passive: true });
        check();
      }
    }

    /* Cart count */
    const countEls = document.querySelectorAll('[data-apex-cart-count]');
    if (countEls.length) {
      const setCount = (n) => {
        const num = Number(n) || 0;
        countEls.forEach(el => {
          el.textContent = num;
          el.hidden = num < 1;
        });
      };
      document.addEventListener('cart:updated', e => {
        if (e.detail && typeof e.detail.item_count !== 'undefined') setCount(e.detail.item_count);
      });
      document.addEventListener('cart:refresh', () => {
        fetch('/cart.js', { credentials: 'same-origin' }).then(r => r.json()).then(d => setCount(d.item_count)).catch(() => {});
      });
    }
  })();
</script>

{%- endunless -%}

