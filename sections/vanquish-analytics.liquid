    return 'fb:' + h.toString(16);
  }

  /* ══ GATE ══ */
  const pwInput  = ge('cd-pw-input');
  const pwErr    = ge('cd-pw-err');
  const pwWrap   = ge('cd-pw-wrap');
  const pwBtn    = ge('cd-pw-btn');
  const pwBtnTxt = ge('cd-pw-btn-txt');
  const eyeShow  = ge('cd-eye-show');
  const eyeHide  = ge('cd-eye-hide');

  function showGateErr(msg) {
    pwErr.textContent = msg || 'Incorrect code — please try again';
    pwErr.classList.add('show');
    pwWrap.classList.remove('shake');
    void pwWrap.offsetWidth;
    pwWrap.classList.add('shake');
    pwInput.select();
  }
  function clearGateErr() { pwErr.classList.remove('show'); }

  ge('cd-pw-eye').addEventListener('click', () => {
    const isPass = pwInput.type === 'password';
    pwInput.type = isPass ? 'text' : 'password';
    eyeShow.style.display = isPass ? 'none' : '';
    eyeHide.style.display = isPass ? '' : 'none';
  });

  async function tryLogin() {
    const val = pwInput.value.trim();
    if (!val) return;
    /* Loading state */
    pwBtn.disabled = true;
    pwBtnTxt.textContent = 'Verifying…';
    clearGateErr();
    try {
      const h = await sha256hex(val);
      /* Check master */
      if (h === MASTER) {
        bootApp({ name:'Admin', role:'Master', isMaster:true,
          access:{overview:true,collections:true,performance:true,suggestions:true,team:true}
        });
        return;
      }
      /* Check team users */
      const user = USERS.find(u => u.hash === h);
      if (user) {
        bootApp({ name:user.name, role:user.role, isMaster:false, access:user.access });
        return;
      }
      showGateErr('Incorrect code — please try again');
    } catch(err) {
      showGateErr('Authentication error. Please try again.');
      console.error('Auth error:', err);
    } finally {
      pwBtn.disabled = false;
      pwBtnTxt.textContent = 'Sign in';
    }
  }

  pwInput.addEventListener('keydown', e => { if (e.key==='Enter') tryLogin(); });
  pwBtn.addEventListener('click', tryLogin);

  /* Session restore */
  let _user = null;
  const _saved = (() => { try { return JSON.parse(sessionStorage.getItem('cd_sess')); } catch(_) { return null; } })();
  if (_saved && _saved.access) {
    /* Defer to next tick so DOM is fully settled */
    setTimeout(() => bootApp(_saved), 0);
  }

  /* ══ BOOT ══ */
  let _live = null;
  let _perfDone = false;

  function bootApp(user) {
    _user = user;
    try { sessionStorage.setItem('cd_sess', JSON.stringify(user)); } catch(_){}

    /* Show app */
    if (GATE) GATE.style.display = 'none';
    if (APP)  APP.style.display  = '';

    /* Title */
    qsa('[data-title]').forEach(el => el.textContent = C.title || 'Command Centre');

    /* Sidebar user */
    const initials = (user.name || '?').split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2);
    setText('cd-user-av',   initials);
    setText('cd-user-name', user.name);
    setText('cd-user-role', user.role);

    /* Hero */
    const h = new Date().getHours();
    const greet = h<12?'Good morning,':h<17?'Good afternoon,':'Good evening,';
    setText('cd-hero-hi',   greet);
    setText('cd-hero-name', user.name);
    setText('cd-role-pill', user.role);

    /* Suggestion pre-fill */
    setVal('sug-name', user.name);
    setVal('sug-role', user.role);
    setText('cd-sug-email', EMAIL || '(no email set in settings)');

    /* Nav: hide inaccessible tabs */
    NAV_BTNS.forEach(btn => {
      const key = btn.dataset.nav;
      const allowed = user.access[key] !== false;
      btn.style.display = key === 'team'
        ? (user.access.team ? '' : 'none')
        : (allowed ? '' : 'none');
    });

    /* First accessible view */
    const firstView = NAV_BTNS.find(b => b.style.display !== 'none');
    if (firstView) switchView(firstView.dataset.nav);

    /* Store rows */
    renderStore();

    /* Start clock */
    startClock();

    /* Collect & track */
    setTimeout(() => { collectPerf(); collectHistory(); }, 120);
    if (!_live) _live = new LiveTracker();
    if (C.autoRef) setInterval(() => { collectPerf(); collectHistory(); }, (C.refInt||30)*1000);
    setInterval(collectHistory, 15000);
    window.addEventListener('storage', e => { if(e.key===ADB_KEY) collectHistory(); });

    /* Team */
    if (user.access.team) renderTeam();
  }

  /* ══ HELPERS ══ */
  function setText(id, v) { const el=ge(id); if(el) el.textContent=v||''; }
  function setVal(id, v)  { const el=ge(id); if(el) el.value=v||''; }
  function setHTML(id, v) { const el=ge(id); if(el) el.innerHTML=v||''; }
  function show(id) { const el=ge(id); if(el) el.style.display=''; }
  function hide(id) { const el=ge(id); if(el) el.style.display='none'; }

  /* ══ CLOCK ══ */
  function startClock() {
    const tick = () => {
      setText('cd-clock', new Date().toLocaleTimeString());
      const now = new Date();
      setText('cd-date',
        now.toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'})
      );
    };
    tick(); setInterval(tick, 1000);
  }

  /* ══ LOCK ══ */
  ge('cd-lock-btn').addEventListener('click', () => {
    try { sessionStorage.removeItem('cd_sess'); } catch(_){}
    if (GATE) GATE.style.display = '';
    if (APP)  APP.style.display  = 'none';
    pwInput.value = '';
    clearGateErr();
    _user = null;
  });
  ge('cd-refresh-btn').addEventListener('click', () => { collectPerf(); collectHistory(); });

  /* ══ SIDEBAR (mobile) ══ */
  ge('cd-hamburger').addEventListener('click', () => {
    SIDE.classList.toggle('open');
    OVERLAY.classList.toggle('open');
  });
  if (OVERLAY) OVERLAY.addEventListener('click', () => {
    SIDE.classList.remove('open');
    OVERLAY.classList.remove('open');
  });

  /* ══ NAVIGATION ══ */
  const PAGE_LABELS = {overview:'Overview',collections:'Collections',performance:'Performance',suggestions:'Suggestions',team:'Team'};

  function switchView(name) {
    /* Update nav buttons */
    NAV_BTNS.forEach(b => b.classList.toggle('cd-nav-btn--active', b.dataset.nav===name));
    /* Show correct view */
    VIEWS.forEach(v => v.style.display = v.id==='view-'+name ? '' : 'none');
    /* Bottom bar label */
    setText('cd-bar-page', PAGE_LABELS[name]||name);
    /* Close mobile sidebar */
    SIDE.classList.remove('open');
    OVERLAY.classList.remove('open');
    /* Lazy-render performance tab */
    if (name==='performance' && !_perfDone) { renderPerfTab(); _perfDone=true; }
    if (name==='collections') initCollections();
    if (name==='overview')    collectHistory();
  }

  NAV_BTNS.forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.nav;
      if (!_user) return;
      if (!_user.access[key] && key!=='team') return;
      switchView(key);
    });
  });

  /* ══ STORE ROWS ══ */
  function renderStore() {
    const s = C.store || {};
    const rows = [
      ['Store',    s.name],
      ['Domain',   s.domain],
      ['Currency', s.currency],
      ['Cart',     `${s.cartItems} items · ${s.cartTotal}`],
      ['Template', s.template],
      ['Customer', s.customer],
      ['Theme',    s.theme],
    ];
    setHTML('cd-store-rows', rows.map(([k,v]) =>
      `<div class="cd-data-row"><span class="cd-dk">${k}</span><span class="cd-dv">${v||'—'}</span></div>`
    ).join(''));
  }

  /* ══ CHARTING ══ */
  function makeDonut(pct, color, size=58) {
    const r=22, C2=2*Math.PI*r;
    const fill = pct>0 ? Math.min(pct/100,1)*C2 : 0;
    const col  = pct<=0 ? '#e4e4e7' : color;
    const lbl  = pct>0 ? (pct>9?Math.round(pct)+'%':pct.toFixed(1)+'%') : '—';
    const fs   = lbl.length>3 ? 8 : 9;
    return `<svg viewBox="0 0 ${size} ${size}" fill="none">
      <circle cx="${size/2}" cy="${size/2}" r="${r}" stroke="#e4e4e7" stroke-width="5"/>
      <circle cx="${size/2}" cy="${size/2}" r="${r}" stroke="${col}" stroke-width="5"
        stroke-dasharray="${fill} ${C2}" stroke-dashoffset="${C2*.25}"
        stroke-linecap="round" transform="rotate(-90 ${size/2} ${size/2})"/>
      <text x="${size/2}" y="${size/2+3}" text-anchor="middle"
        font-family="monospace" font-size="${fs}" font-weight="700"
        fill="${pct<=0?'#ccc':'#111'}">${lbl}</text>
    </svg>`;
  }

  function makeSpark(vals, w=210, h=46, dark=true) {
    if (!vals||vals.length<2) return '';
    const max=Math.max(...vals), min=Math.min(...vals), rng=max-min||1;
    const pts=vals.map((v,i)=>{
      const x=(i/(vals.length-1))*w;
      const y=h-4-((v-min)/rng)*(h-8);
      return [x.toFixed(1),y.toFixed(1)];
    });
    const lineD='M '+pts.map(p=>p.join(',')).join(' L ');
    const areaD=`M 0,${h} L ${pts.map(p=>p.join(',')).join(' L ')} L ${w},${h} Z`;
    const lc = dark?'rgba(255,255,255,.65)':'#111';
    const fc = dark?'rgba(255,255,255,.07)':'rgba(0,0,0,.04)';
    return `<svg viewBox="0 0 ${w} ${h}" fill="none" preserveAspectRatio="none">
      <path d="${areaD}" fill="${fc}"/>
      <path d="${lineD}" stroke="${lc}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`;
  }

  /* ══ VITAL RATING ══ */
  function rateV(key,v) {
    const T={lcp:[2500,4000],cls:[.1,.25],inp:[200,500],fcp:[1800,3000],ttfb:[800,1800],loadtime:[2000,4000]};
    const t=T[key]; if(!t||v<=0) return null;
    return v<=t[0]?'good':v<=t[1]?'warn':'bad';
  }
  function vPct(key,v) {
    const cap={lcp:4000,cls:.25,inp:500,fcp:3000,ttfb:1800,loadtime:4000};
    return Math.max(0,Math.min(100,100-(v/(cap[key]||1))*100));
  }
  function vColor(r) { return r==='good'?'#22c55e':r==='warn'?'#f59e0b':r==='bad'?'#ef4444':'#e4e4e7'; }
  function tblCls(v,key) {
    const r=rateV(key,v);
    return r==='good'?'cd-good':r==='warn'?'cd-warn':r==='bad'?'cd-bad':'cd-na';
  }

  /* ══ RENDER VITALS ══ */
  function renderVitals() {
    const nav = performance.getEntriesByType('navigation')[0];
    const fcp = performance.getEntriesByType('paint').find(e=>e.name==='first-contentful-paint');
    const vitals = [
      ['lcp', _lcp,                'lcp'],
      ['fcp', fcp?fcp.startTime:0, 'fcp'],
      ['cls', _cls,                'cls'],
      ['inp', _inp,                'inp'],
    ];
    vitals.forEach(([key,val,rkey]) => {
      const el = ge('donut-'+key); if(!el) return;
      const r   = rateV(rkey,val);
      const pct = vPct(rkey,val);
      el.innerHTML = makeDonut(pct, vColor(r));
    });
    /* KPIs */
    const nav2 = performance.getEntriesByType('navigation')[0];
    if (nav2) {
      setText('kpi-lcp',  _lcp>0?Math.round(_lcp):'—');
      setText('kpi-load', Math.round(nav2.loadEventEnd-nav2.startTime));
    }
    /* Hero spark */
    if (nav2) {
      const phases=[
        nav2.domainLookupEnd-nav2.domainLookupStart,
        nav2.connectEnd-nav2.connectStart,
        nav2.responseStart-nav2.requestStart,
        nav2.responseEnd-nav2.responseStart,
        nav2.domInteractive-nav2.responseEnd,
        nav2.domContentLoadedEventEnd-nav2.startTime,
        nav2.loadEventEnd-nav2.startTime,
      ].filter(v=>v>0);
      const sc=ge('cd-hero-chart'); if(sc) sc.innerHTML=makeSpark(phases,240,46,true);
    }
  }

  /* ══ COLLECT PERF (safe to call repeatedly) ══ */
  function collectPerf() { renderVitals(); }

  /* ══ LIVE TRACKER ══ */
  class LiveTracker {
    constructor() {
      this._f=0;this._fps=0;this._lt=performance.now();
      this._st=Date.now();this._ms=0;
      this._rq=performance.getEntriesByType('resource').length;
      this._ix=0;
      this._init();
    }
    _set(id,v){ const el=ge(id); if(el) el.textContent=v; }
    _init() {
      /* FPS */
      const loop=now=>{
        this._f++;
        if(now-this._lt>=1000){
          this._fps=Math.round(this._f*1000/(now-this._lt));
          this._f=0;this._lt=now;
          this._set('kpi-fps',this._fps);
          this._set('tl-fps',this._fps+' fps'); // if existed
        }
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
      /* 1-sec tick */
      setInterval(()=>this._tick(),1000);
      /* Scroll */
      window.addEventListener('scroll',()=>{
        const dH=document.documentElement.scrollHeight-window.innerHeight;
        const d=dH>0?Math.round(window.scrollY/dH*100):0;
        this._ms=Math.max(this._ms,Math.min(d,100));
        this._set('tl-scroll',this._ms+'%');
      },{passive:true});
      /* Resource observer */
      try{
        new PerformanceObserver(l=>{
          this._rq+=l.getEntries().length;
          this._set('tl-req',this._rq);
        }).observe({type:'resource',buffered:false});
      }catch(_){}
      this._set('tl-req',this._rq);
      /* Interactions */
      ['click','keydown','touchstart'].forEach(ev=>{
        window.addEventListener(ev,()=>{this._ix++;this._set('tl-ix',this._ix);},{passive:true});
      });
      /* Visibility */
      document.addEventListener('visibilitychange',()=>this._vis());
      this._vis();
      /* Online */
      const updOnline=()=>{
        const pip=ge('cd-status-pip'),txt=ge('cd-status-txt');
        const on=navigator.onLine;
        if(pip){pip.style.background=on?'#22c55e':'#ef4444';}
        if(txt) txt.textContent=on?'Online':'Offline';
      };
      window.addEventListener('online',updOnline);
      window.addEventListener('offline',updOnline);
      updOnline();
    }
    _tick() {
      /* Time on page */
      const e=Math.floor((Date.now()-this._st)/1000);
      const h=Math.floor(e/3600),m=Math.floor((e%3600)/60),s=e%60;
      const ts=h>0?`${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`:
                   `${m}:${String(s).padStart(2,'0')}`;
      this._set('tl-time',ts);
      /* Heap */
      if(performance.memory){
        const mb=(performance.memory.usedJSHeapSize/1048576).toFixed(1);
        this._set('tl-heap',mb+' MB');
        this._set('kpi-heap',mb);
      }
      /* Errors */
      this._set('tl-err',_gErr+_gRej);
      /* Network */
      const cn=navigator.connection||{};
      this._set('tl-conn',(cn.effectiveType||'—').toUpperCase());
      this._set('tl-dl',cn.downlink?cn.downlink+' Mbps':'—');
    }
    _vis(){this._set('tl-vis',document.visibilityState==='visible'?'Active':'Hidden');}
  }

  /* ══ HISTORY ══ */
  function collectHistory() {
    let store;
    try { store=JSON.parse(localStorage.getItem(ADB_KEY)||'{"records":[]}'); }
    catch(_){ store={records:[]}; }
    const recs=store.records||[];
    renderHistSummary(recs);
    renderHistTable(recs);
  }

  function renderHistSummary(recs) {
    const wrap=ge('cd-hist-summary'); if(!wrap) return;
    if(!recs.length){
      wrap.innerHTML='<div class="cd-hs-empty">No data yet. Install the <code>adb-tracker</code> snippet to collect real visit data across your store.</div>';
      return;
    }
    const wL=recs.filter(r=>r.lcp>0);
    const avgLCP=wL.length?Math.round(wL.reduce((a,r)=>a+r.lcp,0)/wL.length):0;
    const gPct=wL.length?Math.round(wL.filter(r=>r.lcp<=2500).length/wL.length*100):0;
    const uniq=new Set(recs.map(r=>r.url)).size;
    const pts=[...wL].slice(-20).map(r=>r.lcp);
    wrap.innerHTML=`
      <div class="cd-hs-big">${avgLCP?avgLCP+' ms':'—'}</div>
      <div class="cd-hs-lbl">Avg LCP · last ${Math.min(recs.length,20)} visits</div>
      <div class="cd-hs-chart">${makeSpark(pts,220,50,false)}</div>
      <div class="cd-hs-stats">
        <div><span class="cd-hs-v">${recs.length}</span><span class="cd-hs-l">Views</span></div>
        <div><span class="cd-hs-v">${gPct}%</span><span class="cd-hs-l">Good LCP</span></div>
        <div><span class="cd-hs-v">${uniq}</span><span class="cd-hs-l">Unique pages</span></div>
      </div>`;
  }

  function renderHistTable(recs) {
    const empty=ge('cd-hist-empty'), inner=ge('cd-hist-table-inner'), tbody=ge('cd-hist-tbody');
    const cnt=ge('cd-hist-count');
    if(!tbody) return;
    if(!recs.length){
      if(empty) empty.style.display=''; if(inner) inner.style.display='none'; return;
    }
    if(empty) empty.style.display='none'; if(inner) inner.style.display='';
    const shown=Math.min(recs.length,40);
    if(cnt) cnt.textContent=`${recs.length} visits · showing last ${shown}`;
    const recent=[...recs].reverse().slice(0,40);
    const clsC=v=>{
      if(!v&&v!==0) return 'cd-na';
      return v<=.1?'cd-good':v<=.25?'cd-warn':'cd-bad';
    };
    tbody.innerHTML=recent.map(r=>{
      const ts=new Date(r.ts);
      const tsStr=ts.toLocaleDateString()+' '+ts.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
      return `<tr>
        <td><div class="cd-turl" title="${r.url}">${r.title||r.url}</div><div class="cd-tsub">${r.url}</div></td>
        <td class="${tblCls(r.lcp,'lcp')} cd-mn">${r.lcp>0?r.lcp+'ms':'—'}</td>
        <td class="${tblCls(r.loadTime,'loadtime')} cd-mn">${r.loadTime>0?r.loadTime+'ms':'—'}</td>
        <td class="${tblCls(r.fcp,'fcp')} cd-mn">${r.fcp>0?r.fcp+'ms':'—'}</td>
        <td class="${tblCls(r.ttfb,'ttfb')} cd-mn">${r.ttfb>0?r.ttfb+'ms':'—'}</td>
        <td class="${clsC(r.cls)} cd-mn">${r.cls!==undefined?r.cls.toFixed(3):'—'}</td>
        <td class="cd-mn" style="font-size:.65rem;color:#aaa">${(r.conn||'—').toUpperCase()}</td>
        <td class="cd-ts">${tsStr}</td>
      </tr>`;
    }).join('');
  }

  const histClear=ge('cd-hist-clear');
  if(histClear) histClear.addEventListener('click',()=>{
    if(confirm('Clear all page visit history?')){
      try{localStorage.removeItem(ADB_KEY);}catch(_){}
      collectHistory();
    }
  });

  /* ══ PERFORMANCE TAB ══ */
  function renderPerfTab() {
    renderTimingBars(); renderResChart(); renderAudit(); renderPerfStats(); renderCaps();
  }

  function renderTimingBars() {
    const c=ge('cd-timing-bars'); if(!c) return;
    const nav=performance.getEntriesByType('navigation')[0];
    if(!nav){c.innerHTML='<p style="color:rgba(255,255,255,.3);font-size:.75rem;padding:.5rem 0">Navigation timing data unavailable.</p>';return;}
    const s=nav.startTime;
    const phases=[
      ['Redirect',           nav.redirectEnd-nav.redirectStart],
      ['DNS Lookup',         nav.domainLookupEnd-nav.domainLookupStart],
      ['TCP Connect',        nav.connectEnd-nav.connectStart],
      ['SSL / TLS',          nav.secureConnectionStart>0?nav.connectEnd-nav.secureConnectionStart:0],
      ['Time to First Byte', nav.responseStart-nav.requestStart],
      ['Server Response',    nav.responseEnd-nav.responseStart],
      ['DOM Processing',     nav.domInteractive-nav.responseEnd],
      ['DOM Content Loaded', nav.domContentLoadedEventEnd-s],
      ['Resource Phase',     Math.max(0,nav.loadEventStart-nav.domContentLoadedEventEnd)],
      ['Total Load',         nav.loadEventEnd-s],
    ];
    const maxV=Math.max(...phases.map(p=>p[1]),1);
    c.innerHTML=phases.map(([lbl,val])=>`
      <div class="cd-trow">
        <div class="cd-trow-labels">
          <span class="cd-trow-name">${lbl}</span>
          <span class="cd-trow-val">${Math.round(val)} ms</span>
        </div>
        <div class="cd-trow-track">
          <div class="cd-trow-fill" style="width:${((val/maxV)*100).toFixed(1)}%"></div>
        </div>
      </div>`).join('');
  }

  function renderResChart() {
    const bar=ge('cd-res-bar'), leg=ge('cd-res-legend'); if(!bar||!leg) return;
    const res=performance.getEntriesByType('resource');
    const host=location.hostname;
    const G={JS:[0,'#111'],CSS:[0,'#555'],Images:[0,'#888'],Fonts:[0,'#aaa'],XHR:[0,'#bbb'],Other:[0,'#ddd']};
    res.forEach(e=>{
      const t=e.initiatorType;
      if(t==='script') G.JS[0]++;
      else if(t==='link'||t==='css') G.CSS[0]++;
      else if(t==='img'||/\.(png|jpg|jpeg|gif|webp|svg|avif)/i.test(e.name)) G.Images[0]++;
      else if(t==='font'||/\.(woff2?|ttf|otf|eot)/i.test(e.name)) G.Fonts[0]++;
      else if(t==='xmlhttprequest'||t==='fetch') G.XHR[0]++;
      else G.Other[0]++;
    });
    const total=res.length||1;
    bar.innerHTML=Object.entries(G).map(([n,[cnt,c]])=>
      `<div class="cd-res-seg" style="width:${(cnt/total*100).toFixed(1)}%;background:${c}" title="${n}:${cnt}"></div>`).join('');
    leg.innerHTML=Object.entries(G).map(([n,[cnt,c]])=>
      `<div class="cd-res-li"><span class="cd-res-dot" style="background:${c}"></span>${n} (${cnt})</div>`).join('');
  }

  function renderAudit() {
    const c=ge('cd-audit'); if(!c) return;
    const https=location.protocol==='https:';
    const res=performance.getEntriesByType('resource');
    const imgs=[...document.querySelectorAll('img')];
    const noAlt=imgs.filter(i=>!i.hasAttribute('alt')).length;
    const mixed=https?res.filter(r=>r.name.startsWith('http://')).length:0;
    const h1=document.querySelectorAll('h1').length;
    const lang=document.documentElement.getAttribute('lang');
    const og=document.querySelectorAll('meta[property^="og:"]').length;
    const jsonld=document.querySelectorAll('script[type="application/ld+json"]').length;
    const csp=!!document.querySelector('meta[http-equiv="Content-Security-Policy"]');
    const sri=document.querySelectorAll('script[integrity],link[integrity]').length;
    const noLabel=[...document.querySelectorAll('input:not([type=hidden]),textarea,select')]
      .filter(i=>!i.id||!document.querySelector(`label[for="${i.id}"]`)).length;
    const checks=[
      ['HTTPS',             https?'Secure ✓':'Not secure',       https?'good':'bad'],
      ['Mixed Content',     `${mixed} issue${mixed!==1?'s':''}`, mixed===0?'good':'bad'],
      ['CSP (meta)',        csp?'Present':'Missing',              csp?'good':'warn'],
      ['SRI Protected',     `${sri} assets`,                     sri>0?'good':'warn'],
      ['Image Alt Text',    `${noAlt} missing`,                  noAlt===0?'good':'bad'],
      ['Form Labels',       `${noLabel} unlabelled`,             noLabel===0?'good':'bad'],
      ['H1 Tag',            `${h1} found`,                       h1===1?'good':h1===0?'bad':'warn'],
      ['HTML lang',         lang||'Missing',                      lang?'good':'bad'],
      ['Open Graph',        `${og} tags`,                        og>=4?'good':og>0?'warn':'bad'],
      ['JSON-LD Schema',    `${jsonld} found`,                   jsonld>0?'good':'warn'],
    ];
    c.innerHTML=checks.map(([lbl,val,r])=>
      `<div class="cd-arow"><span class="cd-apip cd-apip--${r}"></span><span class="cd-albl">${lbl}</span><span class="cd-aval">${val}</span></div>`
    ).join('');
  }

  function renderPerfStats() {
    const c=ge('cd-perf-stats'); if(!c) return;
    const nav=performance.getEntriesByType('navigation')[0];
    const res=performance.getEntriesByType('resource');
    const fcp=performance.getEntriesByType('paint').find(e=>e.name==='first-contentful-paint');
    const fp =performance.getEntriesByType('paint').find(e=>e.name==='first-paint');
    const cH=res.filter(e=>e.transferSize===0&&e.decodedBodySize>0).length;
    const transfer=res.reduce((a,e)=>a+(e.transferSize||0),0);
    const pct=res.length?Math.round(cH/res.length*100):0;
    const chip=r=>r?`<div class="cd-ps-chip cd-ps-chip--${r}">${r==='good'?'● Good':r==='warn'?'● Needs work':'● Poor'}</div>`:'';
    const stats=[
      ['LCP',          _lcp>0?Math.round(_lcp):'—','ms',rateV('lcp',_lcp)],
      ['FCP',          fcp?Math.round(fcp.startTime):'—','ms',rateV('fcp',fcp?fcp.startTime:0)],
      ['First Paint',  fp?Math.round(fp.startTime):'—','ms',null],
      ['TTFB',         nav?Math.round(nav.responseStart-nav.requestStart):'—','ms',rateV('ttfb',nav?nav.responseStart-nav.requestStart:0)],
      ['Load Time',    nav?Math.round(nav.loadEventEnd-nav.startTime):'—','ms',rateV('loadtime',nav?nav.loadEventEnd-nav.startTime:0)],
      ['DOM Loaded',   nav?Math.round(nav.domContentLoadedEventEnd-nav.startTime):'—','ms',null],
      ['Resources',    res.length,'files',null],
      ['Transfer',     Math.round(transfer/1024),'KB',null],
      ['Cache Hits',   pct,'%',null],
      ['Long Tasks',   _lt,'',_lt===0?'good':_lt<5?'warn':'bad'],
      ['LT Duration',  Math.round(_ltd),'ms',null],
      ['DOM Nodes',    document.querySelectorAll('*').length,'',null],
    ];
    c.innerHTML=stats.map(([lbl,val,unit,r])=>`
      <div class="cd-ps">
        <div class="cd-ps-lbl">${lbl}</div>
        <div class="cd-ps-val">${val}<span class="cd-ps-unit">${unit}</span></div>
        ${r?chip(r):''}
      </div>`).join('');
  }

  function renderCaps() {
    const c=ge('cd-caps'); if(!c) return;
    const caps=[
      ['Service Worker','serviceWorker' in navigator],['WebAssembly',typeof WebAssembly!=='undefined'],
      ['IndexedDB','indexedDB' in window],['Cache API','caches' in window],
      ['Web Crypto','crypto' in window&&'subtle' in(window.crypto||{})],['Push API','PushManager' in window],
      ['Notifications','Notification' in window],['Payment Request','PaymentRequest' in window],
      ['Battery API','getBattery' in navigator],['Geolocation','geolocation' in navigator],
      ['WebGL',(()=>{try{return!!document.createElement('canvas').getContext('webgl')}catch(_){return false}})()],
      ['WebGL 2',(()=>{try{return!!document.createElement('canvas').getContext('webgl2')}catch(_){return false}})()],
      ['WebGPU','gpu' in navigator],['Web Share','share' in navigator],
      ['Clipboard','clipboard' in navigator],['Web Workers',typeof Worker!=='undefined'],
      ['WebXR','xr' in navigator],['Screen Wake Lock','wakeLock' in navigator],
      ['File System','showOpenFilePicker' in window],['Speech Synth','speechSynthesis' in window],
      ['Web Bluetooth','bluetooth' in navigator],['USB API','usb' in navigator],
      ['Gamepads','getGamepads' in navigator],['Web Serial','serial' in navigator],
      ['Intersection Obs','IntersectionObserver' in window],['Resize Observer','ResizeObserver' in window],
      ['Broadcast Channel',typeof BroadcastChannel!=='undefined'],['Shared Workers',typeof SharedWorker!=='undefined'],
      ['Pointer Lock','pointerLockElement' in document],['Badging API','setAppBadge' in navigator],
      ['Web MIDI','requestMIDIAccess' in navigator],['Perf Observer','PerformanceObserver' in window],
    ];
    c.innerHTML=caps.map(([n,ok])=>
      `<div class="cd-cap"><span class="cd-cap-name">${n}</span><span class="cd-cap-dot cd-cap-dot--${ok?'y':'n'}"></span></div>`
    ).join('');
  }

  /* ══ COLLECTIONS ══ */
  let _allProds=[], _curHandle=null;
  function initCollections() {
    const inp=ge('cd-col-search');
    if(inp&&!inp._bound){
      inp._bound=true;
      inp.addEventListener('input',()=>{
        const q=inp.value.toLowerCase();
        qsa('[data-col-card]').forEach(c=>{
          c.style.display=(!q||(c.dataset.title||'').toLowerCase().includes(q))?'':'none';
        });
      });
    }
  }

  /* Card clicks */
  document.addEventListener('click',e=>{
    const unlock=e.target.closest('[data-unlock]');
    if(unlock){e.stopPropagation();openColModal(unlock.closest('[data-col-card]'));return;}
    const card=e.target.closest('[data-col-card]');
    if(card&&!e.target.closest('[data-lock-overlay]')){
      card.dataset.locked==='0'||card.dataset.unlocked==='1'?openCollection(card):openColModal(card);
    }
    if(e.target.closest('[data-lock-overlay]')){
      const c=e.target.closest('[data-col-card]');if(c)openColModal(c);
    }
  });

  /* Modal */
  const colModal=ge('cd-col-modal'), colPwIn=ge('cd-col-pw'), colPwErr=ge('cd-modal-err');
  let _pendCard=null;

  function openColModal(card){
    if(!card)return;
    _pendCard=card;
    setText('cd-modal-col-name',`"${card.dataset.title||'Collection'}"`);
    if(colPwIn){colPwIn.value='';}
    if(colPwErr){colPwErr.textContent='';colPwErr.classList.remove('show');}
    if(colModal)colModal.style.display='';
    setTimeout(()=>colPwIn&&colPwIn.focus(),40);
  }
  function closeColModal(){if(colModal)colModal.style.display='none';_pendCard=null;}
  ge('cd-modal-close')  && ge('cd-modal-close').addEventListener('click',closeColModal);
  ge('cd-modal-cancel') && ge('cd-modal-cancel').addEventListener('click',closeColModal);
  if(colModal) colModal.addEventListener('click',e=>{if(e.target===colModal)closeColModal();});
  if(colPwIn)  colPwIn.addEventListener('keydown',e=>{if(e.key==='Enter')submitColPw();});
  ge('cd-col-pw-ok') && ge('cd-col-pw-ok').addEventListener('click',submitColPw);

  async function submitColPw(){
    if(!_pendCard)return;
    const val=(colPwIn&&colPwIn.value.trim())||'';
    const expected=_pendCard.dataset.phash||'';
    const h=await sha256hex(val);
    if(h===expected){
      _pendCard.dataset.unlocked='1';
      const ov=_pendCard.querySelector('[data-lock-overlay]');if(ov)ov.remove();
      closeColModal();openCollection(_pendCard);
    } else {
      if(colPwErr){colPwErr.textContent='Incorrect password';colPwErr.classList.add('show');}
      if(colPwIn) colPwIn.select();
    }
  }

  function openCollection(card){
    if(!card)return;
    _curHandle=card.dataset.handle;
    hide('cd-col-grid-view'); show('cd-col-detail');
    setText('cd-detail-title',card.dataset.title);
    loadProducts(_curHandle);
  }
  ge('cd-col-back')&&ge('cd-col-back').addEventListener('click',()=>{
    show('cd-col-grid-view');hide('cd-col-detail');
  });

  const pSearch=ge('cd-prod-search'), pSort=ge('cd-prod-sort');
  if(pSearch) pSearch.addEventListener('input',()=>renderProds(_allProds));
  if(pSort)   pSort.addEventListener('change',()=>renderProds(_allProds));

  async function loadProducts(handle){
    const grid=ge('cd-prod-grid'); if(!grid) return;
    setHTML('cd-prod-grid','<div id="cd-prod-loading" class="cd-loading"><div class="cd-spinner"></div><span>Loading products…</span></div>');
    setHTML('cd-col-ana','');
    try{
      const r=await fetch(`/collections/${handle}/products.json?limit=250`);
      if(!r.ok)throw new Error('HTTP '+r.status);
      const d=await r.json();
      _allProds=d.products||[];
      setText('cd-detail-count',`${_allProds.length} products`);
      renderProds(_allProds);
      renderColAna(_allProds);
    }catch(err){
      setHTML('cd-prod-grid','<div style="grid-column:1/-1;text-align:center;padding:3rem;color:#aaa;font-size:.8rem">Failed to load products — check collection handle or network.</div>');
    }
  }

  function renderProds(prods){
    const grid=ge('cd-prod-grid'); if(!grid) return;
    let list=[...prods];
    const q=(pSearch&&pSearch.value||'').toLowerCase();
    if(q) list=list.filter(p=>p.title.toLowerCase().includes(q)||(p.tags||[]).some(t=>t.toLowerCase().includes(q)));
    const sort=pSort?pSort.value:'';
    if(sort==='az')          list.sort((a,b)=>a.title.localeCompare(b.title));
    if(sort==='price-asc')   list.sort((a,b)=>+(a.variants[0]?.price||0)-(+b.variants[0]?.price||0));
    if(sort==='price-desc')  list.sort((a,b)=>+(b.variants[0]?.price||0)-(+a.variants[0]?.price||0));
    if(!list.length){grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:2.5rem;color:#aaa">No products match.</div>';return;}
    grid.innerHTML=list.map(p=>{
      const v=p.variants[0]||{};
      const price=v.price?(+v.price).toLocaleString('en-US',{style:'currency',currency:'USD'}):'—';
      const hasSale=v.compare_at_price&&+(v.compare_at_price)>+(v.price||0);
      const was=hasSale?(+v.compare_at_price).toLocaleString('en-US',{style:'currency',currency:'USD'}):'';
      const img=p.images&&p.images[0]?p.images[0].src:null;
      const avail=p.variants.some(vv=>vv.available);
      const tags=(p.tags||[]).slice(0,3);
      return `<div class="cd-prod-card">
        ${img?`<div class="cd-prod-img" style="background-image:url('${img}')"></div>`
              :`<div class="cd-prod-img cd-prod-img--ph"><svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="3" y="3" width="22" height="22" rx="3" stroke="#ddd" stroke-width="1.3"/><circle cx="10" cy="11" r="2.5" stroke="#ddd" stroke-width="1.3"/><path d="M3 21l6-5 4 3.5 3.5-3.5 8 5" stroke="#ddd" stroke-width="1.3" stroke-linejoin="round"/></svg></div>`}
        <div class="cd-prod-body">
          <h4 class="cd-prod-name">${p.title}</h4>
          <div><span class="cd-prod-price">${price}</span>${hasSale?`<span class="cd-prod-was">${was}</span><span class="cd-prod-sale">SALE</span>`:''}</div>
          ${tags.length?`<div class="cd-prod-tags">${tags.map(t=>`<span class="cd-prod-tag">${t}</span>`).join('')}</div>`:''}
        </div>
        <div class="cd-prod-foot">
          <span class="${avail?'cd-instock':'cd-oos'}">${avail?'● In stock':'● Out of stock'}</span>
          <span>${p.variants.length} var.</span>
        </div>
      </div>`;
    }).join('');
  }

  function renderColAna(prods){
    const c=ge('cd-col-ana');if(!c)return;
    const prices=prods.flatMap(p=>p.variants.map(v=>+(v.price||0))).filter(Boolean);
    const avg=prices.length?(prices.reduce((a,b)=>a+b,0)/prices.length).toFixed(2):'—';
    const inStock=prods.filter(p=>p.variants.some(v=>v.available)).length;
    const onSale=prods.filter(p=>p.variants.some(v=>v.compare_at_price&&+(v.compare_at_price)>+(v.price||0))).length;
    [['Products',prods.length,''],
     ['In Stock',inStock,`${prods.length?Math.round(inStock/prods.length*100):0}%`],
     ['On Sale',onSale,''],
     ['Avg Price','$'+avg,''],
    ].forEach(([lbl,val,sub])=>{
      const el=document.createElement('div');el.className='cd-ana-card';
      el.innerHTML=`<div class="cd-ana-lbl">${lbl}</div><div class="cd-ana-val">${val}</div>${sub?`<div class="cd-ana-sub">${sub}</div>`:''}`;
      c.appendChild(el);
    });
  }

  /* ══ SUGGESTIONS ══ */
  let _sugImg=null;
  const upZone=ge('cd-upload-zone'), upInput=ge('sug-img');
  const upUI=ge('cd-upload-ui'), upPrev=ge('cd-upload-prev'), prevImg=ge('cd-prev-img');

  if(upZone){
    upZone.addEventListener('dragover',e=>{e.preventDefault();upZone.classList.add('drag');});
    upZone.addEventListener('dragleave',()=>upZone.classList.remove('drag'));
    upZone.addEventListener('drop',e=>{e.preventDefault();upZone.classList.remove('drag');handleImg(e.dataTransfer.files[0]);});
  }
  if(upInput) upInput.addEventListener('change',()=>handleImg(upInput.files[0]));
  ge('cd-upload-rm')&&ge('cd-upload-rm').addEventListener('click',clearImg);

  function handleImg(file){
    if(!file)return;
    if(file.size>4*1024*1024){alert('Max 4MB');return;}
    const r=new FileReader();
    r.onload=e=>{
      _sugImg=e.target.result;
      if(prevImg)prevImg.src=_sugImg;
      if(upUI)upUI.style.display='none';
      if(upPrev)upPrev.style.display='';
    };
    r.readAsDataURL(file);
  }
  function clearImg(){
    _sugImg=null;
    if(upInput)upInput.value='';
    if(prevImg)prevImg.src='';
    if(upUI)upUI.style.display='';
    if(upPrev)upPrev.style.display='none';
  }

  const sugSubmit=ge('cd-sug-submit'), sugLbl=ge('cd-sug-lbl'), sugStatus=ge('cd-sug-status');
  if(sugSubmit) sugSubmit.addEventListener('click',sendSuggestion);

  async function sendSuggestion(){
    const gv=id=>(ge(id)||{}).value||'';
    const name=gv('sug-name'),role=gv('sug-role'),cat=gv('sug-cat');
    const priority=gv('sug-priority'),subject=gv('sug-subject'),body=gv('sug-body'),video=gv('sug-video');
    if(!subject.trim()||!body.trim()){setSugStatus('Please fill in subject and details.','err');return;}
    sugSubmit.disabled=true;if(sugLbl)sugLbl.textContent='Sending…';setSugStatus('','');
    const params={
      to_email:EMAIL,from_name:name,from_role:role,category:cat,
      priority:priority.toUpperCase(),
      subject:`[${priority.toUpperCase()}] ${cat}: ${subject}`,
      message:body,video_url:video||'None',
      page_url:location.href,timestamp:new Date().toLocaleString(),
      has_image:_sugImg?'Yes':'No'
    };
    let sent=false;
    if(C.ejsSvc&&C.ejsTpl&&C.ejsKey){
      try{await emailjs.send(C.ejsSvc,C.ejsTpl,params);sent=true;}catch(_){}
    }
    if(!sent){
      const mb=`From: ${name} (${role})\nCategory: ${cat} · Priority: ${priority}\n\n${body}\n\nVideo: ${video||'None'}\nPage: ${location.href}\nTime: ${new Date().toLocaleString()}`;
      window.open(`mailto:${EMAIL}?subject=${encodeURIComponent(params.subject)}&body=${encodeURIComponent(mb)}`);
      sent=true;
    }
    if(sent){
      setSugStatus('✓ Sent successfully!','ok');
      logSent({name,role,cat,subject,body,ts:Date.now()});
      ['sug-subject','sug-body','sug-video'].forEach(id=>{const el=ge(id);if(el)el.value='';});
      clearImg();
    }
    sugSubmit.disabled=false;if(sugLbl)sugLbl.textContent='Send suggestion';
  }
  function setSugStatus(msg,type){
    if(!sugStatus)return;
    sugStatus.textContent=msg;
    sugStatus.className='cd-sug-status'+(type?' '+type:'');
  }
  function logSent(s){
    const log=ge('cd-sug-log');if(!log)return;
    const empty=log.querySelector('.cd-log-empty');if(empty)empty.style.display='none';
    const el=document.createElement('div');el.className='cd-log-entry';
    el.innerHTML=`<div class="cd-log-hd"><span class="cd-log-title">${s.subject}</span><span class="cd-log-cat">${s.cat}</span><span class="cd-log-ts">${new Date(s.ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</span></div><div class="cd-log-body">${s.body.slice(0,80)}${s.body.length>80?'…':''}</div>`;
    log.prepend(el);
  }
  ge('cd-log-clear')&&ge('cd-log-clear').addEventListener('click',()=>{
    const log=ge('cd-sug-log');if(log)log.innerHTML='<div class="cd-log-empty">No suggestions sent yet.</div>';
  });

  /* ══ TEAM ══ */
  function renderTeam(){
    const grid=ge('cd-team-grid');if(!grid)return;
    if(!USERS.length){
      grid.innerHTML='<p style="color:#aaa;font-size:.82rem">No team members configured. Add users in section settings.</p>';
      return;
    }
    const ACCESS_KEYS=['overview','collections','performance','suggestions','team'];
    const cards=USERS.map(u=>{
      const init=(u.name||'?').split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2);
      const tags=ACCESS_KEYS.map(k=>`<span class="cd-team-tag cd-team-tag--${u.access[k]?'on':'off'}">${k.charAt(0).toUpperCase()+k.slice(1)}</span>`).join('');
      return `<div class="cd-team-card">
        <div class="cd-team-top">
          <div class="cd-team-av">${init}</div>
          <div><div class="cd-team-name">${u.name}</div><div class="cd-team-role">${u.role}</div></div>
        </div>
        <div class="cd-team-tags">${tags}</div>
      </div>`;
    });
    /* Master card */
    const masterCard=`<div class="cd-team-card cd-team-master">
      <div class="cd-team-top">
        <div class="cd-team-av">★</div>
        <div><div class="cd-team-name">Master Admin</div><div class="cd-team-role">Full access · all sections</div></div>
      </div>
      <div class="cd-team-tags">${ACCESS_KEYS.map(k=>`<span class="cd-team-tag cd-team-tag--on">${k.charAt(0).toUpperCase()+k.slice(1)}</span>`).join('')}</div>
    </div>`;
    grid.innerHTML=masterCard+cards.join('');
  }

}); /* end DOMContentLoaded */
</script>

