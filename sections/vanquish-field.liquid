        endif
        assign line = line | replace: '%%', '' | strip
        assign word = word | replace: '%%', ''
        assign titles = titles | append: title | append: '%%'
        assign lines = lines | append: line | append: '%%'
        assign words = words | append: word | append: '%%'
        assign eyebrows = eyebrows | append: eyebrow | append: '%%'
        assign facts = facts | append: '' | append: '%%'
        assign notes = notes | append: '' | append: '%%'
        assign metas = metas | append: meta | append: '%%'
        assign oks = oks | append: ok | append: '%%'
        assign vids = vids | append: vid | append: '%%'
        assign urls = urls | append: url | append: '%%'
        assign kinds = kinds | append: kind | append: '%%'
        assign ctas = ctas | append: cta | append: '%%'
        assign fronts = fronts | append: front_url | append: '%%'
        assign front_ws = front_ws | append: fw | append: '%%'
        assign front_hs = front_hs | append: fh | append: '%%'
        assign front_alts = front_alts | append: falt | append: '%%'
        assign backs = backs | append: back_url | append: '%%'
        assign back_ws = back_ws | append: bw | append: '%%'
        assign back_hs = back_hs | append: bh | append: '%%'
        assign grounds = grounds | append: g | append: '%%'
        assign inks = inks | append: k | append: '%%'
        assign accents = accents | append: a | append: '%%'
        assign card_matter = section.settings.matter | default: 'pieces'
        if card_matter == 'auto'
          assign card_matter = 'pieces'
          assign ptype = solo.type | downcase
          if ptype contains 'shirt' or ptype contains 'tee' or ptype contains 'hoodie' or ptype contains 'jacket' or ptype contains 'coat' or ptype contains 'dress' or ptype contains 'pant' or ptype contains 'trouser' or ptype contains 'apparel' or ptype contains 'clothing' or ptype contains 'knit' or ptype contains 'denim' or ptype contains 'top' or ptype contains 'skirt'
