        -%}
      {%- endfor -%}
    {%- else -%}
      {%- liquid
        assign front_obj = solo.featured_image
        assign back_obj = nil
        if solo.images.size > 1
          assign back_obj = solo.images[1]
        endif
        assign title = solo.title
        assign line = solo.description | strip_html | truncate: 140
        assign word = section.settings.word
