    { "type": "range", "id": "limit", "label": "Products to show", "min": 1, "max": 8, "step": 1, "default": 4 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1b6b45" },
    { "type": "color", "id": "note_color", "label": "Note", "default": "#b0b0b0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#173024" },
    { "type": "color", "id": "feature_color", "label": "Feature card", "default": "#1b6b45" },
    { "type": "color", "id": "card_color", "label": "Side cards", "default": "#f3f1ec" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#155838" },
    { "type": "color", "id": "halo_color", "label": "Halo", "default": "#e7f4ec" },
    { "type": "checkbox", "id": "show_halo", "label": "Show halo", "default": true },
    { "type": "select", "id": "float_mode", "label": "Floating elements", "default": "paper", "options": [
      { "value": "off", "label": "Off" },
      { "value": "paper", "label": "Paper" },
      { "value": "pins", "label": "Pins" },
      { "value": "fabric", "label": "Fabric" },
      { "value": "logo", "label": "Logo" },
      { "value": "custom", "label": "Custom images" }
    ], "info": "One set at a time. For Custom images, add Custom float blocks." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "side_padding", "label": "Side padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },

    { "type": "header", "content": "Scroll" },
    { "type": "checkbox", "id": "scroll_transition", "label": "Close into the next section on scroll", "default": true },
    { "type": "range", "id": "scroll_distance", "label": "Close distance", "min": 30, "max": 120, "step": 5, "unit": "vh", "default": 70 }
  ],
  "max_blocks": 16,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "fact", "label": "Extra fact" }
      ]
    },
    {
      "type": "float",
      "name": "Custom float",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    { "name": "Vanquish Field" }
  ]
}
