{%- comment -%}
  VANQUISH — Product Field
  One-screen product display for any product and any ground.
  Scroll pins the stage and walks each product in turn: the giant word
  slides, the ground takes that product's colours, and the matter travels
  with the page. No WebGL, no animation frame. Motion pauses off screen
  and when the visitor asks for reduced motion.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign source = section.settings.source | default: 'blocks'
  assign cap = section.settings.limit | at_most: 8 | at_least: 1
  assign density = section.settings.density | default: 'quiet'
  assign env = section.settings.environment | default: 'paper'
  assign base_g = '#f2e8d5'
  assign base_k = '#1b130c'
  assign base_a = '#e2462a'
  case env
    when 'night'
      assign base_g = '#101010'
      assign base_k = '#f4f1ea'
      assign base_a = '#f4f1ea'
    when 'chalk'
      assign base_g = '#eceae4'
      assign base_k = '#171717'
      assign base_a = '#171717'
    when 'ink'
      assign base_g = '#121a22'
      assign base_k = '#e6eef4'
      assign base_a = '#8fafc6'
    when 'sand'
      assign base_g = '#e7d5be'
      assign base_k = '#2a2118'
      assign base_a = '#8c3820'
    when 'custom'
      assign base_g = section.settings.ground
      assign base_k = section.settings.ink
      assign base_a = section.settings.accent
  endcase

  assign piece_cap = 0
  if density == 'quiet'
    assign piece_cap = 3
  elsif density == 'full'
    assign piece_cap = 6
  endif

  assign px = '10,82,14,78,86,22,8,70' | split: ','
  assign py = '18,16,74,70,40,84,30,62' | split: ','
  assign prot = '-16,8,18,-10,-6,14,12,-8' | split: ','
  assign pdur = '10,12,9,13,11,8,12,10' | split: ','
  assign pfrom = '28px,64px,18px,72px,40px,22px' | split: ','
  assign pto = '-72px,-140px,-46px,-150px,-96px,-40px' | split: ','
  assign pspin = '7deg,-11deg,5deg,-8deg,12deg,-4deg' | split: ','
  assign psizes = '150,128,112,158,104,92' | split: ','
  assign code_bits = 'cut(sheet)~~await open(file)~~fit-content~~export const page~~decode(buf)~~--bleed: 3mm' | split: '~~'
  assign cloth_0 = 'vf-matter-cloth-ivory.webp' | asset_url
  assign cloth_1 = 'vf-matter-cloth-denim.webp' | asset_url
  assign cloth_2 = 'vf-matter-cloth-rust.webp' | asset_url
  assign paper_0 = 'vf-matter-paper-sheet.webp' | asset_url
  assign paper_1 = 'vf-matter-paper-corner.webp' | asset_url
  assign pin_0 = 'vf-matter-pin-safety.webp' | asset_url
  assign pin_1 = 'vf-matter-pin-round.webp' | asset_url
  assign pin_2 = 'vf-matter-pin-bar.webp' | asset_url
  assign mark_src = 'vf-matter-mark.png' | asset_url
  if section.settings.mark != blank
    assign mark_src = section.settings.mark | image_url: width: 480
  endif

  assign titles = ''
  assign lines = ''
  assign words = ''
  assign eyebrows = ''
  assign facts = ''
  assign notes = ''
  assign metas = ''
  assign oks = ''
  assign vids = ''
  assign urls = ''
  assign kinds = ''
  assign ctas = ''
  assign fronts = ''
  assign front_ws = ''
  assign front_hs = ''
  assign front_alts = ''
  assign backs = ''
  assign back_ws = ''
  assign back_hs = ''
  assign grounds = ''
  assign inks = ''
  assign accents = ''
  assign matters = ''
  assign card_count = 0
  assign solo = nil

  if source == 'product'
    if section.settings.product != blank
      assign solo = section.settings.product
    elsif product != blank
      assign solo = product
    endif
  endif
-%}

{%- if source == 'blocks' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' and card_count < 8 -%}
        {%- liquid
          assign card_product = block.settings.product
          assign front_obj = block.settings.image
          if front_obj == blank and card_product != blank
            assign front_obj = card_product.featured_image
          endif
          assign back_obj = block.settings.image_back
          if back_obj == blank and block.settings.image == blank and card_product != blank
            if card_product.images.size > 1
              assign back_obj = card_product.images[1]
            endif
          endif
          assign title = block.settings.title
          if title == blank and card_product != blank
            assign title = card_product.title
          endif
          if title == blank
            assign title = 'Product'
          endif
          assign line = block.settings.line
          if line == blank and card_product != blank
            assign line = card_product.description | strip_html | truncate: 140
          endif
          assign word = block.settings.word | default: section.settings.word
          assign eyebrow = block.settings.eyebrow | default: section.settings.kicker
          assign fact_src = block.settings.facts
          assign note = block.settings.note
          assign meta = ''
          assign ok = '1'
          assign vid = ''
          assign url = block.settings.link | default: card_product.url
          assign kind = 'none'
          assign cta = block.settings.cta
          assign g = base_g
          assign k = base_k
          assign a = base_a
          if block.settings.own_colors
            assign g = block.settings.ground
            assign k = block.settings.ink
            assign a = block.settings.accent
          elsif section.settings.vary and env != 'custom'
            assign mix = card_count | modulo: 5
            case mix
              when 1
                assign g = '#101010'
                assign k = '#f4f1ea'
                assign a = '#f4f1ea'
              when 2
                assign g = '#eceae4'
                assign k = '#171717'
                assign a = '#171717'
              when 3
                assign g = '#121a22'
                assign k = '#e6eef4'
                assign a = '#8fafc6'
              when 4
                assign g = '#e7d5be'
                assign k = '#2a2118'
                assign a = '#8c3820'
            endcase
          endif
          if card_product != blank
            if section.settings.show_price
              assign meta = card_product.price | money
            endif
            if card_product.available == false
              assign ok = '0'
            endif
            assign vid = card_product.selected_or_first_available_variant.id
            if section.settings.show_cart
              assign kind = 'cart'
              if cta == blank
                assign cta = section.settings.button_label
              endif
            elsif url != blank
              assign kind = 'link'
              if cta == blank
                assign cta = section.settings.link_label
              endif
            endif
          elsif url != blank
            assign kind = 'link'
            if cta == blank
              assign cta = section.settings.link_label
            endif
          endif
          if cta == blank
            assign cta = section.settings.button_label
          endif
          assign front_url = ''
          assign fw = '900'
          assign fh = '900'
          assign falt = title
          if front_obj != blank
            assign front_url = front_obj | image_url: width: 900
            assign fw = '900'
            assign fh = 900 | divided_by: front_obj.aspect_ratio | round
            if front_obj.alt != blank
              assign falt = front_obj.alt
            endif
          endif
          assign back_url = ''
          assign bw = ''
          assign bh = ''
          if back_obj != blank
            assign back_url = back_obj | image_url: width: 900
            assign bw = '900'
            assign bh = 900 | divided_by: back_obj.aspect_ratio | round
          endif
          assign title = title | replace: '%%', '' | replace: ';;', ''
          assign line = line | replace: '%%', '' | replace: ';;', '' | strip
          assign word = word | replace: '%%', ''
          assign eyebrow = eyebrow | replace: '%%', ''
          assign note = note | replace: '%%', '' | strip
          assign fact_flat = fact_src | newline_to_br | replace: '<br />', ';;' | replace: '<br/>', ';;' | replace: '<br>', ';;' | replace: '%%', ''
          assign falt = falt | replace: '%%', ''
          assign titles = titles | append: title | append: '%%'
          assign lines = lines | append: line | append: '%%'
          assign words = words | append: word | append: '%%'
          assign eyebrows = eyebrows | append: eyebrow | append: '%%'
          assign facts = facts | append: fact_flat | append: '%%'
          assign notes = notes | append: note | append: '%%'
          assign metas = metas | append: meta | append: '%%'
          assign oks = oks | append: ok | append: '%%'
          assign vids = vids | append: vid | append: '%%'
          assign urls = urls | append: url | append: '%%'
          assign kinds = kinds | append: kind | append: '%%'
          assign ctas = ctas | append: cta | append: '%%'
          assign fronts = fronts | append: front_url | append: '%%'
          assign front_ws = front_ws | append: fw | append: '%%'
          assign front_hs = front_hs | append: fh | append: '%%'
          assign front_alts = front_alts | append: falt | append: '%%'
          assign backs = backs | append: back_url | append: '%%'
          assign back_ws = back_ws | append: bw | append: '%%'
          assign back_hs = back_hs | append: bh | append: '%%'
          assign grounds = grounds | append: g | append: '%%'
          assign inks = inks | append: k | append: '%%'
          assign accents = accents | append: a | append: '%%'
          assign card_matter = section.settings.matter | default: 'pieces'
          assign picked = block.settings.matter | default: 'inherit'
          if picked != 'inherit'
            assign card_matter = picked
          endif
          if card_matter == 'auto'
            assign card_matter = 'pieces'
            assign ptype = ''
            if card_product != blank
              assign ptype = card_product.type | downcase
            endif
            if ptype contains 'shirt' or ptype contains 'tee' or ptype contains 'hoodie' or ptype contains 'jacket' or ptype contains 'coat' or ptype contains 'dress' or ptype contains 'pant' or ptype contains 'trouser' or ptype contains 'apparel' or ptype contains 'clothing' or ptype contains 'knit' or ptype contains 'denim' or ptype contains 'top' or ptype contains 'skirt'
            assign card_matter = 'apparel'
            elsif ptype contains 'file' or ptype contains 'digital' or ptype contains 'download' or ptype contains 'template' or ptype contains 'pdf' or ptype contains 'ebook' or ptype contains 'document' or ptype contains 'guide'
            assign card_matter = 'files'
            elsif ptype contains 'accessor' or ptype contains 'jewel' or ptype contains 'pin' or ptype contains 'glass' or ptype contains 'eyewear' or ptype contains 'sunglass' or ptype contains 'watch' or ptype contains 'hat' or ptype contains 'bag' or ptype contains 'belt' or ptype contains 'scarf'
            assign card_matter = 'accessories'
            elsif ptype contains 'logo' or ptype contains 'mark' or ptype contains 'brand'
            assign card_matter = 'mark'
            endif
          endif
          assign matters = matters | append: card_matter | append: '%%'
          assign card_count = card_count | plus: 1
        -%}
      {%- endif -%}
    {%- endfor -%}
  {%- elsif source == 'collection' and section.settings.collection != blank -%}
    {%- for card_product in section.settings.collection.products limit: cap -%}
      {%- liquid
        assign front_obj = card_product.featured_image
        assign back_obj = nil
        if card_product.images.size > 1
          assign back_obj = card_product.images[1]
        endif
        assign title = card_product.title
        assign line = card_product.description | strip_html | truncate: 140
        assign word = section.settings.word
        assign eyebrow = section.settings.kicker
        assign fact_flat = ''
        assign note = ''
        assign meta = ''
        if section.settings.show_price
          assign meta = card_product.price | money
        endif
        assign ok = '1'
        if card_product.available == false
          assign ok = '0'
        endif
        assign vid = card_product.selected_or_first_available_variant.id
        assign url = card_product.url
        assign kind = 'none'
        assign cta = section.settings.button_label
        if section.settings.show_cart
          assign kind = 'cart'
        else
          assign kind = 'link'
          assign cta = section.settings.link_label
        endif
        assign g = base_g
        assign k = base_k
        assign a = base_a
        if section.settings.vary and env != 'custom'
          assign mix = card_count | modulo: 5
          case mix
            when 1
              assign g = '#101010'
              assign k = '#f4f1ea'
              assign a = '#f4f1ea'
            when 2
              assign g = '#eceae4'
              assign k = '#171717'
              assign a = '#171717'
            when 3
              assign g = '#121a22'
              assign k = '#e6eef4'
              assign a = '#8fafc6'
            when 4
              assign g = '#e7d5be'
              assign k = '#2a2118'
              assign a = '#8c3820'
          endcase
        endif
        assign front_url = ''
        assign fw = '900'
        assign fh = '900'
        assign falt = title
        if front_obj != blank
          assign front_url = front_obj | image_url: width: 900
          assign fh = 900 | divided_by: front_obj.aspect_ratio | round
          if front_obj.alt != blank
            assign falt = front_obj.alt
          endif
        endif
        assign back_url = ''
        assign bw = ''
        assign bh = ''
        if back_obj != blank
          assign back_url = back_obj | image_url: width: 900
          assign bw = '900'
          assign bh = 900 | divided_by: back_obj.aspect_ratio | round
        endif
        assign title = title | replace: '%%', ''
        assign line = line | replace: '%%', '' | strip
        assign word = word | replace: '%%', ''
        assign falt = falt | replace: '%%', ''
        assign titles = titles | append: title | append: '%%'
        assign lines = lines | append: line | append: '%%'
        assign words = words | append: word | append: '%%'
        assign eyebrows = eyebrows | append: eyebrow | append: '%%'
        assign facts = facts | append: fact_flat | append: '%%'
        assign notes = notes | append: note | append: '%%'
        assign metas = metas | append: meta | append: '%%'
        assign oks = oks | append: ok | append: '%%'
        assign vids = vids | append: vid | append: '%%'
        assign urls = urls | append: url | append: '%%'
        assign kinds = kinds | append: kind | append: '%%'
        assign ctas = ctas | append: cta | append: '%%'
        assign fronts = fronts | append: front_url | append: '%%'
        assign front_ws = front_ws | append: fw | append: '%%'
        assign front_hs = front_hs | append: fh | append: '%%'
        assign front_alts = front_alts | append: falt | append: '%%'
        assign backs = backs | append: back_url | append: '%%'
        assign back_ws = back_ws | append: bw | append: '%%'
        assign back_hs = back_hs | append: bh | append: '%%'
        assign grounds = grounds | append: g | append: '%%'
        assign inks = inks | append: k | append: '%%'
        assign accents = accents | append: a | append: '%%'
        assign card_matter = section.settings.matter | default: 'pieces'
        if card_matter == 'auto'
          assign card_matter = 'pieces'
          assign ptype = ''
          if card_product != blank
            assign ptype = card_product.type | downcase
          endif
          if ptype contains 'shirt' or ptype contains 'tee' or ptype contains 'hoodie' or ptype contains 'jacket' or ptype contains 'coat' or ptype contains 'dress' or ptype contains 'pant' or ptype contains 'trouser' or ptype contains 'apparel' or ptype contains 'clothing' or ptype contains 'knit' or ptype contains 'denim' or ptype contains 'top' or ptype contains 'skirt'
          assign card_matter = 'apparel'
          elsif ptype contains 'file' or ptype contains 'digital' or ptype contains 'download' or ptype contains 'template' or ptype contains 'pdf' or ptype contains 'ebook' or ptype contains 'document' or ptype contains 'guide'
          assign card_matter = 'files'
          elsif ptype contains 'accessor' or ptype contains 'jewel' or ptype contains 'pin' or ptype contains 'glass' or ptype contains 'eyewear' or ptype contains 'sunglass' or ptype contains 'watch' or ptype contains 'hat' or ptype contains 'bag' or ptype contains 'belt' or ptype contains 'scarf'
          assign card_matter = 'accessories'
          elsif ptype contains 'logo' or ptype contains 'mark' or ptype contains 'brand'
          assign card_matter = 'mark'
          endif
        endif
        assign matters = matters | append: card_matter | append: '%%'
        assign card_count = card_count | plus: 1
      -%}
    {%- endfor -%}
  {%- elsif source == 'product' and solo != blank -%}
    {%- if section.settings.split_variants and solo.has_only_default_variant == false -%}
      {%- for variant in solo.variants limit: cap -%}
        {%- liquid
          assign front_obj = variant.image | default: solo.featured_image
          assign title = solo.title
          if variant.title != 'Default Title'
            assign title = variant.title
          endif
          assign line = solo.description | strip_html | truncate: 140
          assign word = variant.option1 | default: section.settings.word
          if word.size > 18
            assign word = section.settings.word
          endif
          assign eyebrow = section.settings.kicker
          assign fact_flat = ''
          assign note = ''
          assign meta = ''
          if section.settings.show_price
            assign meta = variant.price | money
          endif
          assign ok = '1'
          if variant.available == false
            assign ok = '0'
          endif
          assign vid = variant.id
          assign url = solo.url
          assign kind = 'cart'
          assign cta = section.settings.button_label
          if section.settings.show_cart == false
            assign kind = 'link'
            assign cta = section.settings.link_label
          endif
          assign g = base_g
          assign k = base_k
          assign a = base_a
          if section.settings.vary and env != 'custom'
            assign mix = card_count | modulo: 5
            case mix
              when 1
                assign g = '#101010'
                assign k = '#f4f1ea'
                assign a = '#f4f1ea'
              when 2
                assign g = '#eceae4'
                assign k = '#171717'
                assign a = '#171717'
              when 3
                assign g = '#121a22'
                assign k = '#e6eef4'
                assign a = '#8fafc6'
              when 4
                assign g = '#e7d5be'
                assign k = '#2a2118'
                assign a = '#8c3820'
            endcase
          endif
          assign front_url = ''
          assign fw = '900'
          assign fh = '900'
          assign falt = title
          if front_obj != blank
            assign front_url = front_obj | image_url: width: 900
            assign fh = 900 | divided_by: front_obj.aspect_ratio | round
            if front_obj.alt != blank
              assign falt = front_obj.alt
            endif
          endif
          assign title = title | replace: '%%', ''
          assign line = line | replace: '%%', '' | strip
          assign word = word | replace: '%%', ''
          assign falt = falt | replace: '%%', ''
          assign titles = titles | append: title | append: '%%'
          assign lines = lines | append: line | append: '%%'
          assign words = words | append: word | append: '%%'
          assign eyebrows = eyebrows | append: eyebrow | append: '%%'
          assign facts = facts | append: fact_flat | append: '%%'
          assign notes = notes | append: note | append: '%%'
          assign metas = metas | append: meta | append: '%%'
          assign oks = oks | append: ok | append: '%%'
          assign vids = vids | append: vid | append: '%%'
          assign urls = urls | append: url | append: '%%'
          assign kinds = kinds | append: kind | append: '%%'
          assign ctas = ctas | append: cta | append: '%%'
          assign fronts = fronts | append: front_url | append: '%%'
          assign front_ws = front_ws | append: fw | append: '%%'
          assign front_hs = front_hs | append: fh | append: '%%'
          assign front_alts = front_alts | append: falt | append: '%%'
          assign backs = backs | append: '' | append: '%%'
          assign back_ws = back_ws | append: '' | append: '%%'
          assign back_hs = back_hs | append: '' | append: '%%'
          assign grounds = grounds | append: g | append: '%%'
          assign inks = inks | append: k | append: '%%'
          assign accents = accents | append: a | append: '%%'
          assign card_matter = section.settings.matter | default: 'pieces'
          if card_matter == 'auto'
            assign card_matter = 'pieces'
            assign ptype = solo.type | downcase
            if ptype contains 'shirt' or ptype contains 'tee' or ptype contains 'hoodie' or ptype contains 'jacket' or ptype contains 'coat' or ptype contains 'dress' or ptype contains 'pant' or ptype contains 'trouser' or ptype contains 'apparel' or ptype contains 'clothing' or ptype contains 'knit' or ptype contains 'denim' or ptype contains 'top' or ptype contains 'skirt'
            assign card_matter = 'apparel'
            elsif ptype contains 'file' or ptype contains 'digital' or ptype contains 'download' or ptype contains 'template' or ptype contains 'pdf' or ptype contains 'ebook' or ptype contains 'document' or ptype contains 'guide'
            assign card_matter = 'files'
            elsif ptype contains 'accessor' or ptype contains 'jewel' or ptype contains 'pin' or ptype contains 'glass' or ptype contains 'eyewear' or ptype contains 'sunglass' or ptype contains 'watch' or ptype contains 'hat' or ptype contains 'bag' or ptype contains 'belt' or ptype contains 'scarf'
            assign card_matter = 'accessories'
            elsif ptype contains 'logo' or ptype contains 'mark' or ptype contains 'brand'
