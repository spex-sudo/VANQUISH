{%- liquid
  assign sid = section.id
  assign cap = section.settings.limit | default: 4 | at_most: 8 | at_least: 1
  assign heading = section.settings.heading | default: 'The happiest hour of the year'
  assign note = section.settings.note | default: 'Sign up to get exclusive access to deals on drinks this holiday season.'
  assign cta = section.settings.quick_label | default: 'Quick add'
  assign price_label = section.settings.price_label | default: 'Price'
  assign travel = section.settings.scroll_distance | default: 70
-%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&display=swap">

<section
  class="vf-room"
  id="vf-{{ sid }}"
  data-scroll="{% if section.settings.scroll_transition %}on{% else %}off{% endif %}"
  data-travel="{{ travel }}"
  data-sold="{{ section.settings.sold_out | default: 'Sold out' | escape }}"
>
  <div class="vf-run" data-run>
    <div class="vf-stage" data-stage>
      <div class="vf-scale">
        <div class="vf-board">
          {%- if section.settings.show_halo -%}
            <div class="vf-halo" aria-hidden="true"></div>
            <span class="vf-bit vf-bit-a" aria-hidden="true"></span>
            <span class="vf-bit vf-bit-b" aria-hidden="true"></span>
          {%- endif -%}

          <div class="vf-mid">
            <div class="vf-copy">
              <h2>{{ heading }}</h2>
              {%- if note != blank -%}<p>{{ note }}</p>{%- endif -%}
            </div>
            {%- if section.settings.show_arrows -%}
              <div class="vf-arrows">
                <button type="button" data-prev aria-label="{{ section.settings.prev_label | default: 'Previous' }}">‹</button>
                <button type="button" data-next aria-label="{{ section.settings.next_label | default: 'Next' }}">›</button>
              </div>
            {%- endif -%}
          </div>

          <div class="vf-row" data-row>
            {%- assign shown = 0 -%}
            {%- if section.settings.collection != blank -%}
              {%- for product in section.settings.collection.products limit: cap -%}
                {%- assign shown = shown | plus: 1 -%}
                <article class="vf-card{% if forloop.first %} is-feature{% endif %}" data-i="{{ forloop.index0 }}">
                  <img class="vf-drink" src="{{ product.featured_image | image_url: width: 800 }}" alt="" width="800" height="800" draggable="false">
                  <h3>{{ product.title }}</h3>
                  <ul class="vf-facts">
                    {%- if section.settings.show_price -%}
                      <li><span>{{ price_label }}</span><b data-price>{{ product.price | money }}</b></li>
                    {%- endif -%}
                    {%- if section.settings.show_type and product.type != blank -%}
                      <li><span>{{ product.type }}</span></li>
                    {%- endif -%}
                  </ul>
                  <div class="vf-opts">
                    {%- unless product.has_only_default_variant -%}
                      {%- for option in product.options_with_values -%}
                        <label class="vf-opt"><span>{{ option.name }}</span>
                          <select data-option="{{ forloop.index0 }}" aria-label="{{ option.name }}">
                            {%- for value in option.values -%}<option value="{{ value | escape }}">{{ value }}</option>{%- endfor -%}
                          </select>
                        </label>
                      {%- endfor -%}
                    {%- endunless -%}
                  </div>
                  <script type="application/json" data-variants>[{%- for variant in product.variants -%}{"id":{{ variant.id }},"ok":{{ variant.available | json }},"opt":{{ variant.options | json }},"img":{{ variant.image | default: product.featured_image | image_url: width: 720 | json }},"price":{{ variant.price | money | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
                  {%- form 'product', product, class: 'vf-cart' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button class="vf-add" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>
                      {%- if product.available -%}{{ cta }}{%- else -%}{{ section.settings.sold_out | default: 'Sold out' }}{%- endif -%}
                    </button>
                  {%- endform -%}
                </article>
              {%- endfor -%}
            {%- endif -%}

            {%- if shown == 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.product != blank -%}
                  {%- assign product = block.settings.product -%}
                  {%- assign shown = shown | plus: 1 -%}
                  {%- assign card_title = product.title -%}
                  {%- if block.settings.title != blank -%}{%- assign card_title = block.settings.title -%}{%- endif -%}
                  {%- assign card_image = product.featured_image -%}
                  {%- if block.settings.image != blank -%}{%- assign card_image = block.settings.image -%}{%- endif -%}
                  <article class="vf-card{% if shown == 1 %} is-feature{% endif %}" data-i="{{ shown | minus: 1 }}" {{ block.shopify_attributes }}>
                    <img class="vf-drink" src="{{ card_image | image_url: width: 800 }}" alt="" width="800" height="800" draggable="false">
                    <h3>{{ card_title }}</h3>
                    <ul class="vf-facts">
                      {%- if section.settings.show_price -%}
                        <li><span>{{ price_label }}</span><b data-price>{{ product.price | money }}</b></li>
                      {%- endif -%}
                      {%- if block.settings.fact != blank -%}
                        <li><span>{{ block.settings.fact }}</span></li>
                      {%- endif -%}
                    </ul>
                    <script type="application/json" data-variants>[{%- for variant in product.variants -%}{"id":{{ variant.id }},"ok":{{ variant.available | json }},"opt":{{ variant.options | json }},"img":{{ variant.image | default: product.featured_image | image_url: width: 720 | json }},"price":{{ variant.price | money | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
                    {%- form 'product', product, class: 'vf-cart' -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button class="vf-add" type="submit" name="add">{{ cta }}</button>
                    {%- endform -%}
                  </article>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
          <p class="vf-toast" data-toast hidden></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
#shopify-section-{{ sid }} {
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  padding: 0;
  background: transparent;
  position: relative;
  z-index: 1;
  overflow-anchor: none;
}
#vf-{{ sid }} {
  --green: {{ section.settings.feature_color }};
  --ink: {{ section.settings.text_color }};
  --card: {{ section.settings.card_color }};
  --heading: {{ section.settings.heading_color }};
  --note: {{ section.settings.note_color }};
  --bg: {{ section.settings.background }};
  --btn: {{ section.settings.button_color }};
  --btn-text: {{ section.settings.button_text_color }};
  --halo: {{ section.settings.halo_color }};
  --radius: {{ section.settings.card_radius }}px;
  --pad: {{ section.settings.side_padding }}px;
  --title: {{ section.settings.heading_size }}px;
  width: 100%;
  background: transparent;
  padding: 0;
  font-family: Outfit, "Avenir Next", "Segoe UI", sans-serif;
  color: var(--ink);
}
#vf-{{ sid }} .vf-run { position: relative; }
#vf-{{ sid }} .vf-stage { position: relative; width: 100%; top: 0; left: 0; }
#vf-{{ sid }} .vf-scale { width: 100%; margin: 0; position: relative; }
#vf-{{ sid }} .vf-board {
  position: relative;
  width: 100%;
  background: var(--bg);
  transform-origin: center top;
}
#vf-{{ sid }} .vf-halo { position: absolute; width: min(46vw, 560px); height: min(46vw, 560px); border-radius: 50%; background: var(--halo); right: 4vw; top: 12px; pointer-events: none; }
#vf-{{ sid }} .vf-bit { position: absolute; width: 14px; height: 14px; background: var(--green); clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); animation: vf-drift-{{ sid }} 7s ease-in-out infinite alternate; pointer-events: none; }
#vf-{{ sid }} .vf-bit-a { left: 18vw; top: 180px; }
#vf-{{ sid }} .vf-bit-b { right: 6vw; top: 140px; animation-delay: -2s; }
@keyframes vf-drift-{{ sid }} { from { translate: 0 0; } to { translate: 8px -14px; } }
#vf-{{ sid }} .vf-mid { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding: 28px var(--pad) 0; }
#vf-{{ sid }} .vf-arrows { display: flex; gap: 8px; }
#vf-{{ sid }} .vf-arrows button {
  width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--green); color: var(--btn-text);
  font-size: 26px; line-height: 1; cursor: pointer; touch-action: manipulation;
}
#vf-{{ sid }} .vf-copy { width: min(520px, 62%); }
#vf-{{ sid }} .vf-copy h2 { margin: 0; color: var(--heading); font: 800 clamp(28px, 4vw, var(--title))/0.95 Outfit, sans-serif; letter-spacing: -0.03em; }
#vf-{{ sid }} .vf-copy p { margin: 14px 0 0; max-width: 420px; color: var(--note); font-size: 13px; line-height: 1.45; }
#vf-{{ sid }} .vf-row {
  position: relative; z-index: 3;
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-items: end;
  padding: 130px var(--pad) 16px; touch-action: pan-y; cursor: grab;
}
#vf-{{ sid }} .vf-row.is-dragging { cursor: grabbing; }
#vf-{{ sid }} .vf-card {
  position: relative; height: 300px; border-radius: var(--radius); background: var(--card); color: var(--ink); padding: 118px 18px 16px;
  box-shadow: 0 10px 24px rgb(30 40 34 / 6%); order: 9;
}
#vf-{{ sid }} .vf-card[hidden] { display: none; }
#vf-{{ sid }} .vf-card.is-feature {
  height: 400px; background: var(--green); color: #fff; padding: 150px 18px 16px;
  box-shadow: 0 24px 50px rgb(20 60 40 / 28%); z-index: 4;
}
#vf-{{ sid }} .vf-drink {
  position: absolute; left: 50%; bottom: calc(100% - 108px); width: min(46%, 160px); height: auto;
  transform: translate3d(-50%, 0, 0); pointer-events: auto; touch-action: pan-y;
  filter: drop-shadow(0 16px 16px rgb(20 30 24 / 18%)); object-fit: contain;
}
#vf-{{ sid }} .vf-card.is-feature .vf-drink { width: min(58%, 210px); bottom: calc(100% - 140px); }
@keyframes vf-bob-{{ sid }} { from { translate: 0 0; } to { translate: 0 -10px; } }
#vf-{{ sid }} .vf-card h3 { margin: 0; font: 700 20px/1.05 Outfit, sans-serif; }
#vf-{{ sid }} .vf-card.is-feature h3 { font-size: 28px; }
#vf-{{ sid }} .vf-facts { margin: 16px 0 0; padding: 0; list-style: none; }
#vf-{{ sid }} .vf-facts li { display: flex; justify-content: space-between; gap: 12px; color: #8d8d8d; font-size: 11px; padding: 3px 0; }
#vf-{{ sid }} .vf-card.is-feature .vf-facts { display: none; }
#vf-{{ sid }} .vf-opts { display: none; margin-top: 16px; }
#vf-{{ sid }} .vf-card.is-feature .vf-opts { display: grid; gap: 10px; }
#vf-{{ sid }} .vf-opt { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
#vf-{{ sid }} .vf-opt span { font: 600 18px/1 Outfit, sans-serif; }
#vf-{{ sid }} .vf-opt select { appearance: none; background: transparent; border: 0; border-bottom: 1px solid rgb(255 255 255 / 55%); color: #fff; font: 500 12px/1 Outfit, sans-serif; padding: 6px 0; min-width: 0; max-width: 58%; }
#vf-{{ sid }} .vf-cart { margin: 0; }
#vf-{{ sid }} .vf-add, #vf-{{ sid }} .vf-opt, #vf-{{ sid }} select { position: relative; z-index: 5; touch-action: manipulation; pointer-events: auto; }
#vf-{{ sid }} .vf-card:not(.is-feature) { height: auto; min-height: 280px; }
#vf-{{ sid }} .vf-add { display: flex; align-items: center; justify-content: center; margin-top: 14px; width: 100%; height: 40px; border: 0; border-radius: 999px; background: var(--green); color: #fff; font: 800 11px/1 Outfit, sans-serif; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; }
#vf-{{ sid }} .vf-add[disabled] { opacity: 0.45; cursor: default; }
#vf-{{ sid }} .vf-card.is-feature .vf-add { height: 44px; background: var(--btn); color: var(--btn-text); }
#vf-{{ sid }} .vf-toast { position: absolute; left: var(--pad); bottom: 8px; z-index: 6; margin: 0; color: var(--heading); font-size: 12px; }
@media (max-width: 749px) {
  #vf-{{ sid }} .vf-mid { flex-wrap: wrap; align-items: flex-start; padding: 16px 16px 0; }
  #vf-{{ sid }} .vf-copy { width: 100%; }
  #vf-{{ sid }} .vf-copy h2 { font-size: 34px; }
  #vf-{{ sid }} .vf-copy p { max-width: none; }
  #vf-{{ sid }} .vf-halo { width: 220px; height: 220px; right: -40px; }
  #vf-{{ sid }} .vf-row { grid-template-columns: 1fr; padding: 96px 16px 24px; }
  #vf-{{ sid }} .vf-card { display: none; }
  #vf-{{ sid }} .vf-card.is-feature {
    display: block;
    width: 100%;
    height: auto;
    min-height: 220px;
    padding: 108px 16px 18px;
  }
  #vf-{{ sid }} .vf-card.is-feature .vf-drink { width: 160px; bottom: calc(100% - 96px); }
  #vf-{{ sid }} .vf-card.is-feature h3 { font-size: 26px; }
}
@media (prefers-reduced-motion: reduce) {
  #vf-{{ sid }} .vf-drink, #vf-{{ sid }} .vf-bit { animation: none; }
}
</style>

<script>
(function () {
  var root = document.getElementById('vf-{{ sid }}');
  if (!root || root.dataset.bound) return;
  root.dataset.bound = '1';
  var row = root.querySelector('[data-row]');
  if (!row) return;
  var cards = Array.prototype.slice.call(row.querySelectorAll('.vf-card'));
  var index = 0;
  var toast = root.querySelector('[data-toast]');
  var run = root.querySelector('[data-run]');
  var stage = root.querySelector('[data-stage]');
  var board = root.querySelector('.vf-board');
  var shell = document.getElementById('shopify-section-{{ sid }}') || root;
  var drinks = root.querySelectorAll('.vf-drink');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var enabled = root.dataset.scroll === 'on' && !reduce;

  function place() {
    var n = cards.length;
    if (!n) return;
    cards.forEach(function (card) {
      var i = Number(card.dataset.i);
      var pos = (i - index + 1 + n * 8) % n;
      var on = pos < Math.min(4, n);
      card.hidden = !on;
      card.style.order = on ? String(pos) : '9';
      card.classList.toggle('is-feature', n === 1 ? pos === 0 : pos === 1);
    });
  }
  place();

  function step(dir) {
    if (cards.length < 2) return;
    index = (index + dir + cards.length) % cards.length;
    place();
  }

  var prev = root.querySelector('[data-prev]');
  var next = root.querySelector('[data-next]');
  if (prev) prev.addEventListener('click', function (event) { event.preventDefault(); step(-1); });
  if (next) next.addEventListener('click', function (event) { event.preventDefault(); step(1); });

  function say(text) {
    if (!toast) return;
    toast.hidden = false;
    toast.textContent = text;
  }

  cards.forEach(function (card) {
    var box = card.querySelector('[data-variants]');
    if (!box) return;
    var variants = [];
    try { variants = JSON.parse(box.textContent); } catch (e) { return; }
    card.querySelectorAll('[data-option]').forEach(function (sel) {
      sel.addEventListener('change', function () {
        var picks = Array.prototype.map.call(card.querySelectorAll('[data-option]'), function (node) { return node.value; });
        var match = variants.filter(function (variant) {
          return picks.every(function (value, i) { return !variant.opt[i] || variant.opt[i] === value; });
        })[0] || variants[0];
        if (!match) return;
        var input = card.querySelector('input[name="id"]');
        if (input) input.value = String(match.id);
        var photo = card.querySelector('.vf-drink');
        if (photo && match.img) photo.src = match.img;
        var price = card.querySelector('[data-price]');
        if (price && match.price) price.textContent = match.price;
        var button = card.querySelector('.vf-add');
        if (button) {
          button.disabled = !match.ok;
          button.textContent = match.ok ? (button.dataset.label || button.textContent) : (root.dataset.sold || 'Sold out');
        }
      });
    });
  });

  root.addEventListener('submit', function (event) {
    var form = event.target;
    if (!form || !form.classList || !form.classList.contains('vf-cart')) return;
    event.preventDefault();
    var button = form.querySelector('.vf-add');
    var input = form.querySelector('input[name="id"]');
    if (!button || !input || button.disabled || button.dataset.busy) return;
    var id = input.value;
    if (!id) return;
    if (!button.dataset.label) button.dataset.label = button.textContent;
    button.dataset.busy = '1';
    button.disabled = true;
    button.textContent = 'Adding';
    fetch('/cart/add.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: Number(id), quantity: 1 })
    }).then(function (res) {
      if (!res.ok) throw new Error('cart');
      button.textContent = 'Added';
      say('Added to cart');
      return fetch('/cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
    }).then(function (cart) {
      document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart: cart } }));
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: cart }));
      document.dispatchEvent(new CustomEvent('cart:item-added', { bubbles: true }));
      if (window.apexOpenDrawer) window.apexOpenDrawer();
    }).catch(function () {
      button.textContent = 'Try again';
    }).then(function () {
      setTimeout(function () {
        button.dataset.busy = '';
        button.disabled = false;
        button.textContent = button.dataset.label;
      }, 700);
    });
  });

  var x = 0, y = 0, pid = -1, armed = false, dragging = false, swiped = false;
  function interactive(target) {
    return target.closest('button, a, select, input, textarea, label, form');
  }
  row.addEventListener('pointerdown', function (event) {
    if (interactive(event.target)) return;
    armed = true; dragging = false; swiped = false;
    x = event.clientX; y = event.clientY; pid = event.pointerId;
  });
  row.addEventListener('pointermove', function (event) {
    if (!armed || event.pointerId !== pid) return;
    var dx = event.clientX - x, dy = event.clientY - y;
    if (!dragging) {
      if (Math.abs(dx) < 12 && Math.abs(dy) < 12) return;
      if (Math.abs(dy) > Math.abs(dx)) { armed = false; return; }
      dragging = true;
      row.classList.add('is-dragging');
    }
    row.style.transform = 'translate3d(' + Math.max(-180, Math.min(180, dx)) + 'px,0,0)';
  });
  function end(event) {
    if (event.pointerId !== pid) return;
    var dx = event.clientX - x;
    var moved = dragging;
    armed = false; dragging = false; pid = -1;
    row.classList.remove('is-dragging');
    row.style.transform = '';
    if (!moved || Math.abs(dx) < 36) return;
    swiped = true;
    step(dx < 0 ? 1 : -1);
    setTimeout(function () { swiped = false; }, 350);
  }
  row.addEventListener('pointerup', end);
  row.addEventListener('pointercancel', end);
  row.addEventListener('click', function (event) {
    if (!swiped || interactive(event.target)) return;
    event.preventDefault();
    event.stopPropagation();
    swiped = false;
  }, true);
  row.addEventListener('click', function (event) {
    if (swiped || interactive(event.target)) return;
    var side = event.target.closest('.vf-card');
    if (!side || side.classList.contains('is-feature')) return;
    var i = Number(side.dataset.i);
    var n = cards.length;
    var pos = (i - index + 1 + n * 8) % n;
    step(pos === 0 ? -1 : 1);
  });
  root.addEventListener('click', function (event) {
    var button = event.target.closest('[data-local]');
    if (!button) return;
    event.preventDefault();
    say('Added');
  });

  function scrub() {
    if (!board) return;
    if (!enabled) {
      board.style.opacity = '1';
      board.style.transform = 'none';
      return;
    }
    var rect = board.getBoundingClientRect();
    var vh = window.innerHeight || 1;
    var p = (vh - rect.top) / (vh + Math.max(rect.height, 1));
    if (p < 0) p = 0;
    if (p > 1) p = 1;
    var inn = p / 0.2;
    if (inn > 1) inn = 1;
    var out = (p - 0.58) / 0.42;
    if (out < 0) out = 0;
    if (out > 1) out = 1;
    var show = inn * (1 - out);
    board.style.opacity = String(show);
    board.style.transform = 'translate3d(0,' + ((1 - inn) * 56 - out * 72) + 'px,0) scale(' + (0.9 + show * 0.1) + ')';
    Array.prototype.forEach.call(drinks, function (img, i) {
      var dir = i % 2 ? 1 : -1;
      img.style.transform = 'translate3d(calc(-50% + ' + (dir * 18 * out) + 'px), ' + ((1 - inn) * 36 - out * 90) + 'px, 0)';
    });
  }

  if (shell) shell.style.marginBottom = '0px';
  if (run) run.style.height = 'auto';
  if (stage) {
    stage.style.position = 'relative';
    stage.style.top = 'auto';
    stage.style.left = 'auto';
    stage.style.width = '100%';
    stage.style.zIndex = 'auto';
  }
  scrub();
  window.addEventListener('scroll', scrub, { passive: true });
  window.addEventListener('resize', scrub);
  window.addEventListener('load', scrub);
})();
</script>

{% schema %}
{
  "name": "Vanquish Field",
  "tag": "section",
  "class": "vf-hour",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The happiest hour of the year" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 54 },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Sign up to get exclusive access to deals on drinks this holiday season." },
    { "type": "text", "id": "quick_label", "label": "Quick add label", "default": "Quick add" },
    { "type": "text", "id": "sold_out", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "Price" },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "checkbox", "id": "show_type", "label": "Show product type", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show previous and next", "default": true },
    { "type": "text", "id": "prev_label", "label": "Previous label", "default": "Previous" },
    { "type": "text", "id": "next_label", "label": "Next label", "default": "Next" },

    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "When a collection is chosen, it fills the row. Leave it empty to use the product blocks instead." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 1, "max": 8, "step": 1, "default": 4 },

    { "type": "header", "content": "Colors" },
