{%- liquid
  assign sid = section.id
  assign cap = section.settings.limit | default: 4 | at_most: 8 | at_least: 1
  assign heading = section.settings.heading | default: 'The happiest hour of the year'
  assign note = section.settings.note | default: 'Sign up to get exclusive access to deals on drinks this holiday season.'
  assign brand = section.settings.brand | default: shop.name
  assign cta = section.settings.button_label | default: 'Add to cart'
-%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&display=swap">

<section class="vf-room" id="vf-{{ sid }}" data-section="{{ sid }}">
  <div class="vf-scale">
    <div class="vf-board">
      <div class="vf-halo" aria-hidden="true"></div>
      <span class="vf-bit vf-bit-a" aria-hidden="true"></span>
      <span class="vf-bit vf-bit-b" aria-hidden="true"></span>

      <div class="vf-mid">
        <div class="vf-copy">
          <h2>{{ heading }}</h2>
          <p>{{ note }}</p>
        </div>
        <div class="vf-arrows">
          <button type="button" data-prev aria-label="Previous">‹</button>
          <button type="button" data-next aria-label="Next">›</button>
        </div>
      </div>

      <div class="vf-row" data-row>
        {%- assign shown = 0 -%}
        {%- if section.settings.collection != blank -%}
          {%- for product in section.settings.collection.products limit: cap -%}
            {%- assign shown = shown | plus: 1 -%}
            <article class="vf-card{% if forloop.first %} is-feature{% endif %}" data-i="{{ forloop.index0 }}">
              <img class="vf-drink" src="{{ product.featured_image | image_url: width: 800 }}" alt="" width="800" height="800" draggable="false">
              <h3>{{ product.title }}</h3>
              <ul class="vf-facts">
                <li><span>Price</span><b>{{ product.price | money }}</b></li>
                {%- if product.type != blank -%}<li><span>{{ product.type }}</span></li>{%- endif -%}
              </ul>
              <div class="vf-opts">
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <label class="vf-opt"><span>{{ option.name }}</span>
                      <select data-option="{{ forloop.index0 }}" aria-label="{{ option.name }}">
                        {%- for value in option.values -%}<option value="{{ value | escape }}">{{ value }}</option>{%- endfor -%}
                      </select>
                    </label>
                  {%- endfor -%}
                {%- endunless -%}
              </div>
              <script type="application/json" data-variants>[{%- for variant in product.variants -%}{"id":{{ variant.id }},"ok":{{ variant.available | json }},"opt":{{ variant.options | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
              {%- form 'product', product, class: 'vf-cart' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button class="vf-add" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{{ cta }}</button>
              {%- endform -%}
            </article>
          {%- endfor -%}
        {%- endif -%}
        {%- if shown == 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              {%- assign product = block.settings.product -%}
              {%- assign shown = shown | plus: 1 -%}
              <article class="vf-card{% if shown == 1 %} is-feature{% endif %}" data-i="{{ shown | minus: 1 }}" {{ block.shopify_attributes }}>
                <img class="vf-drink" src="{{ product.featured_image | image_url: width: 800 }}" alt="" width="800" height="800" draggable="false">
                <h3>{{ product.title }}</h3>
                <ul class="vf-facts"><li><span>Price</span><b>{{ product.price | money }}</b></li></ul>
                <script type="application/json" data-variants>[{%- for variant in product.variants -%}{"id":{{ variant.id }},"ok":{{ variant.available | json }},"opt":{{ variant.options | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
                {%- form 'product', product, class: 'vf-cart' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button class="vf-add" type="submit" name="add">{{ cta }}</button>
                {%- endform -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if shown == 0 -%}
          <article class="vf-card" data-i="0" data-fallback="1">
            <img class="vf-drink" src="{{ 'vf-hour-mint.webp' | asset_url }}" alt="" width="392" height="580" draggable="false">
            <h3>Midnight Mint Cocoa</h3>
            <ul class="vf-facts"><li><span>Calories</span><b>320 kcal</b></li></ul>
            <button class="vf-add" type="button" data-local>{{ cta }}</button>
          </article>
          <article class="vf-card" data-i="1" data-fallback="1">
            <img class="vf-drink" src="{{ 'vf-hour-cloud.webp' | asset_url }}" alt="" width="392" height="580" draggable="false">
            <h3>Cloud Cream</h3>
            <ul class="vf-facts"><li><span>Calories</span><b>290 kcal</b></li></ul>
            <button class="vf-add" type="button" data-local>{{ cta }}</button>
          </article>
          <article class="vf-card" data-i="2" data-fallback="1">
            <img class="vf-drink" src="{{ 'vf-hour-cocoa.webp' | asset_url }}" alt="" width="392" height="580" draggable="false">
            <h3>Cocoa Whip</h3>
            <ul class="vf-facts"><li><span>Calories</span><b>260 kcal</b></li></ul>
            <button class="vf-add" type="button" data-local>{{ cta }}</button>
          </article>
          <article class="vf-card" data-i="3" data-fallback="1">
            <img class="vf-drink" src="{{ 'vf-hour-berry.webp' | asset_url }}" alt="" width="392" height="580" draggable="false">
            <h3>Berry Drift</h3>
            <ul class="vf-facts"><li><span>Calories</span><b>340 kcal</b></li></ul>
            <button class="vf-add" type="button" data-local>{{ cta }}</button>
          </article>
        {%- endif -%}
      </div>
      <p class="vf-toast" data-toast hidden></p>
    </div>
  </div>
</section>

<style>
#shopify-section-{{ sid }} {
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  padding: 0;
  background: #fff;
  overflow-anchor: none;
}
#vf-{{ sid }} {
  --green: #1b6b45;
  --ink: #173024;
  width: 100%;
  background: #fff;
  padding: 0;
  font-family: Outfit, "Avenir Next", "Segoe UI", sans-serif;
  color: var(--ink);
}
#vf-{{ sid }} .vf-scale {
  width: 100%;
  margin: 0;
  position: relative;
  overflow: hidden;
}
#vf-{{ sid }} .vf-board {
  position: relative; left: auto; top: auto; width: 100%; height: auto; margin: 0;
  transform: none; background: #fff; border-radius: 0; box-shadow: none; overflow: visible;
}
#vf-{{ sid }} .vf-halo { position: absolute; width: 560px; height: 560px; border-radius: 50%; background: #e7f4ec; right: 90px; top: 36px; }
#vf-{{ sid }} .vf-bit { position: absolute; width: 14px; height: 14px; background: #1b6b45; clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); animation: vf-drift-{{ sid }} 7s ease-in-out infinite alternate; }
#vf-{{ sid }} .vf-bit-a { left: 250px; top: 250px; }
#vf-{{ sid }} .vf-bit-b { right: 90px; top: 210px; animation-delay: -2s; }
@keyframes vf-drift-{{ sid }} { from { translate: 0 0; } to { translate: 8px -14px; } }
#vf-{{ sid }} .vf-top { position: relative; z-index: 2; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 22px; padding: 20px 20px 0; }
#vf-{{ sid }} .vf-mark svg { width: 64px; height: 64px; display: block; }
#vf-{{ sid }} .vf-nav { display: flex; gap: 22px; }
#vf-{{ sid }} .vf-nav a { color: var(--green); font: 600 12px/1 Outfit, sans-serif; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; }
#vf-{{ sid }} .vf-search { position: absolute; left: 50%; top: 34px; width: 260px; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #ddd; }
#vf-{{ sid }} .vf-search input { width: 100%; border: 0; background: transparent; font: 500 11px/1 Outfit, sans-serif; letter-spacing: 0.18em; text-transform: uppercase; outline: none; }
#vf-{{ sid }} .vf-search button { border: 0; background: none; color: #b0b0b0; padding: 6px; }
#vf-{{ sid }} .vf-basket { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); text-decoration: none; font: 700 12px/1 Outfit, sans-serif; letter-spacing: 0.14em; text-transform: uppercase; }
#vf-{{ sid }} .vf-basket i { width: 8px; height: 8px; border-radius: 50%; background: #e23b3b; }
#vf-{{ sid }} .vf-mid { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding: 28px 20px 0; }
#vf-{{ sid }} .vf-arrows { display: flex; gap: 8px; }
#vf-{{ sid }} .vf-arrows button {
  width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--green); color: #fff;
  font-size: 26px; line-height: 1; cursor: pointer; touch-action: manipulation;
}
#vf-{{ sid }} .vf-rewards { margin: 0; font: 800 13px/1.2 Outfit, sans-serif; letter-spacing: 0.08em; text-transform: uppercase; }
#vf-{{ sid }} .vf-rewards span { font-weight: 500; letter-spacing: 0.18em; }
#vf-{{ sid }} .vf-rewards small { display: block; margin-top: 8px; font-size: 10px; letter-spacing: 0.16em; color: #9a9a9a; }
#vf-{{ sid }} .vf-copy { width: min(460px, 48%); }
#vf-{{ sid }} .vf-copy h2 { margin: 0; color: var(--green); font: 800 clamp(32px, 4vw, 54px)/0.95 Outfit, sans-serif; letter-spacing: -0.03em; }
#vf-{{ sid }} .vf-copy p { margin: 14px 0 0; max-width: 340px; color: #b0b0b0; font-size: 12px; line-height: 1.45; }
#vf-{{ sid }} .vf-row {
  position: relative; left: auto; right: auto; bottom: auto; height: auto; z-index: 3;
  display: grid; grid-template-columns: 1fr 1.08fr 1fr 1fr; gap: 12px; align-items: end;
  padding: 130px 12px 16px; touch-action: pan-y; cursor: grab;
}
#vf-{{ sid }} .vf-row.is-dragging { cursor: grabbing; }
#vf-{{ sid }} .vf-card {
  position: relative; height: 300px; border-radius: 28px; background: #f3f1ec; padding: 118px 22px 18px;
  box-shadow: 0 10px 24px rgb(30 40 34 / 6%); order: 9;
}
#vf-{{ sid }} .vf-card[hidden] { display: none; }
#vf-{{ sid }} .vf-card.is-feature {
  height: 400px; margin-bottom: 0; background: var(--green); color: #fff; padding: 150px 18px 16px;
  box-shadow: 0 24px 50px rgb(20 60 40 / 28%); z-index: 4;
}
#vf-{{ sid }} .vf-drink {
  position: absolute; left: 50%; bottom: calc(100% - 108px); width: 148px; height: auto;
  transform: translate3d(-50%, 0, 0); pointer-events: auto; touch-action: pan-y;
  filter: drop-shadow(0 16px 16px rgb(20 30 24 / 18%)); object-fit: contain;
  animation: vf-bob-{{ sid }} 4.8s ease-in-out infinite alternate;
}
#vf-{{ sid }} .vf-card.is-feature .vf-drink { width: 196px; bottom: calc(100% - 150px); }
@keyframes vf-bob-{{ sid }} { from { translate: 0 0; } to { translate: 0 -10px; } }
#vf-{{ sid }} .vf-card h3 { margin: 0; font: 700 20px/1.05 Outfit, sans-serif; }
#vf-{{ sid }} .vf-card.is-feature h3 { font-size: 28px; }
#vf-{{ sid }} .vf-facts { margin: 16px 0 0; padding: 0; list-style: none; }
#vf-{{ sid }} .vf-facts li { display: flex; justify-content: space-between; gap: 12px; color: #9a9a9a; font-size: 11px; padding: 3px 0; }
#vf-{{ sid }} .vf-card.is-feature .vf-facts { display: none; }
#vf-{{ sid }} .vf-opts { display: none; margin-top: 16px; }
#vf-{{ sid }} .vf-card.is-feature .vf-opts { display: grid; gap: 10px; }
#vf-{{ sid }} .vf-opt { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
#vf-{{ sid }} .vf-opt span { font: 600 18px/1 Outfit, sans-serif; }
#vf-{{ sid }} .vf-opt select { appearance: none; background: transparent; border: 0; border-bottom: 1px solid rgb(255 255 255 / 55%); color: #fff; font: 500 12px/1 Outfit, sans-serif; padding: 6px 0; min-width: 120px; }
#vf-{{ sid }} .vf-cart { margin: 0; }
#vf-{{ sid }} .vf-add, #vf-{{ sid }} .vf-opt, #vf-{{ sid }} select { position: relative; z-index: 5; touch-action: manipulation; pointer-events: auto; }
#vf-{{ sid }} .vf-add { display: none; margin-top: 18px; width: 100%; height: 44px; border: 0; border-radius: 999px; background: #fff; color: #155838; font: 800 12px/1 Outfit, sans-serif; letter-spacing: 0.14em; cursor: pointer; }
#vf-{{ sid }} .vf-card.is-feature .vf-add { display: block; }
#vf-{{ sid }} .vf-toast { position: absolute; left: 36px; bottom: 12px; z-index: 6; margin: 0; color: var(--green); font-size: 12px; letter-spacing: 0.08em; }
@media (prefers-reduced-motion: reduce) {
  #vf-{{ sid }} .vf-drink, #vf-{{ sid }} .vf-bit, #vf-{{ sid }} .vf-scale { animation: none; transition: none; }
}
</style>

<script>
(function () {
  var root = document.getElementById('vf-{{ sid }}');
  if (!root || root.dataset.bound) return;
  root.dataset.bound = '1';
  var row = root.querySelector('[data-row]');
  if (!row) return;
  var cards = Array.prototype.slice.call(row.querySelectorAll('.vf-card'));
  var index = 0;
  var toast = root.querySelector('[data-toast]');
  var open = true;
  var busy = false;

  function place() {
    var n = cards.length;
    if (!n) return;
    cards.forEach(function (card) {
      var i = Number(card.dataset.i);
      var pos = (i - index + 1 + n * 8) % n;
      var on = pos < Math.min(4, n);
      card.hidden = !on;
      card.style.order = on ? String(pos) : '9';
      card.classList.toggle('is-feature', n === 1 ? pos === 0 : pos === 1);
    });
  }
  place();

  function step(dir) {
    if (cards.length < 2) return;
    index = (index + dir + cards.length) % cards.length;
    place();
  }

  var prev = root.querySelector('[data-prev]');
  var next = root.querySelector('[data-next]');
  if (prev) prev.addEventListener('click', function (event) { event.preventDefault(); step(-1); });
  if (next) next.addEventListener('click', function (event) { event.preventDefault(); step(1); });

  function say(text) {
    if (!toast) return;
    toast.hidden = false;
    toast.textContent = text;
  }

  cards.forEach(function (card) {
    var box = card.querySelector('[data-variants]');
    if (!box) return;
    var variants = [];
    try { variants = JSON.parse(box.textContent); } catch (e) { return; }
    card.querySelectorAll('[data-option]').forEach(function (sel) {
      sel.addEventListener('change', function () {
        var picks = Array.prototype.map.call(card.querySelectorAll('[data-option]'), function (node) { return node.value; });
        var match = variants.filter(function (variant) {
          return picks.every(function (value, i) { return !variant.opt[i] || variant.opt[i] === value; });
        })[0] || variants[0];
        var input = card.querySelector('input[name="id"]');
        if (match && input) input.value = String(match.id);
      });
    });
  });

  var x = 0, y = 0, pid = -1, armed = false, dragging = false, swiped = false;
  function interactive(target) {
    return target.closest('button, a, select, input, textarea, label, form');
  }
  row.addEventListener('pointerdown', function (event) {
    if (interactive(event.target)) return;
    armed = true;
    dragging = false;
    swiped = false;
    x = event.clientX;
    y = event.clientY;
    pid = event.pointerId;
  });
  row.addEventListener('pointermove', function (event) {
    if (!armed || event.pointerId !== pid) return;
    var dx = event.clientX - x;
    var dy = event.clientY - y;
    if (!dragging) {
      if (Math.abs(dx) < 12 && Math.abs(dy) < 12) return;
      if (Math.abs(dy) > Math.abs(dx)) { armed = false; return; }
      dragging = true;
      row.classList.add('is-dragging');
    }
    row.style.transform = 'translate3d(' + Math.max(-180, Math.min(180, dx)) + 'px,0,0)';
  });
  function end(event) {
    if (event.pointerId !== pid) return;
    var dx = event.clientX - x;
    var moved = dragging;
    armed = false;
    dragging = false;
    pid = -1;
    row.classList.remove('is-dragging');
    row.style.transform = '';
    if (!moved || Math.abs(dx) < 36) return;
    swiped = true;
    step(dx < 0 ? 1 : -1);
    setTimeout(function () { swiped = false; }, 350);
  }
  row.addEventListener('pointerup', end);
  row.addEventListener('pointercancel', end);
  row.addEventListener('click', function (event) {
    if (!swiped) return;
    if (interactive(event.target)) return;
    event.preventDefault();
    event.stopPropagation();
    swiped = false;
  }, true);

  row.addEventListener('click', function (event) {
    if (swiped || interactive(event.target)) return;
    var side = event.target.closest('.vf-card');
    if (!side || side.classList.contains('is-feature')) return;
    var i = Number(side.dataset.i);
    var n = cards.length;
    var pos = (i - index + 1 + n * 8) % n;
    step(pos === 0 ? -1 : 1);
  });

  root.addEventListener('click', function (event) {
    var button = event.target.closest('[data-local]');
    if (!button) return;
    event.preventDefault();
    say('Added');
  });

  function setOpen(next) {
    open = Math.max(0, Math.min(1, next));
    if (!full || !clip) return;
    var h = Math.round(full * open);
    clip.style.height = h + 'px';
    shell.style.marginBottom = (h - full) + 'px';
  }

  var full = 0;
  var origin = 0;
  var shell = document.getElementById('shopify-section-{{ sid }}') || root;
  var clip = root.querySelector('.vf-scale');

  function measure() {
    if (!clip) return;
    var keep = typeof open === 'number' ? open : 1;
    clip.style.height = 'auto';
    shell.style.marginBottom = '0px';
    full = clip.offsetHeight;
    open = 1;
    setOpen(keep);
    if (keep > 0.995) origin = shell.getBoundingClientRect().top + window.scrollY;
  }
  measure();
  window.addEventListener('resize', measure);

  var lastY = window.scrollY;
  window.addEventListener('scroll', function () {
    var y = window.scrollY;
    var dy = y - lastY;
    lastY = y;
    if (!full || !dy) return;
    if (open > 0.995) origin = shell.getBoundingClientRect().top + window.scrollY;
    var top = origin - y;
    if (top > window.innerHeight * 0.45 || top < -40) return;
    setOpen(open + dy / full);
  }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Vanquish Field",
  "tag": "section",
  "class": "vf-hour",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The happiest hour of the year" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Sign up to get exclusive access to deals on drinks this holiday season." },
    { "type": "text", "id": "brand", "label": "Rewards name" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Add to cart" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 1, "max": 8, "step": 1, "default": 4 },
    { "type": "link_list", "id": "menu", "label": "Menu" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    { "name": "Vanquish Field" }
  ]
}
{% endschema %}
