{%- comment -%}
  Rendered on demand via the Section Rendering API (?sections=lexe-gift-check).
  data-cents = eligible subtotal in cents (lines in the discount's buy collections at or above the margin floor, gift lines excluded; see snippets/lexe-gift-counts.liquid).
  data-need  = minimum in cents for the dearest gift line in the cart (snippets/lexe-gift-rules.liquid); -1 if a gift has no cost on file; 0 if no gift.
{%- endcomment -%}
{%- liquid
  assign lgc_cents = 0
  assign lgc_need = 0
  for item in cart.items
    if item.properties['_lexe_gift'] == '1'
      capture lgc_raw
        render 'lexe-gift-rules', product: item.product
      endcapture
      assign lgc_n = lgc_raw | strip | plus: 0
      if lgc_n < 0
        assign lgc_need = -1
      elsif lgc_need >= 0 and lgc_n > lgc_need
        assign lgc_need = lgc_n
      endif
      continue
    endif
    capture lgc_line
      render 'lexe-gift-counts', item: item
    endcapture
    assign lgc_cents = lgc_cents | plus: lgc_line
  endfor
-%}
<div data-cents="{{ lgc_cents }}" data-need="{{ lgc_need }}"></div>
{% schema %}
{ "name": "LEXE gift check", "settings": [] }
{% endschema %}
