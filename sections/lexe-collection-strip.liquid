{%- comment -%}
  LEXE — Shop by collection strip (2026-10-09)
  Tall dark collection cards: icon, bold name, underlined SHOP NOW.
  Desktop: one row. Mobile: 2-column grid or native horizontal swipe
  (overflow-x scroll + scroll-snap; vertical page scroll is never captured).
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign n = section.blocks.size
  assign cols = section.settings.columns_desktop
  if n > 0 and n < cols
    assign cols = n
  endif
-%}
<style>
  {{ section.settings.title_font | font_face: font_display: 'swap' }}
  #lxs-{{ sid }} {
    --lxs-accent: {{ section.settings.accent_color }};
    --lxs-bg: {{ section.settings.bg }};
    --lxs-fg: {{ section.settings.fg }};
    --lxs-card: {{ section.settings.card_bg }};
    --lxs-rad: {{ section.settings.radius }}px;
    --lxs-gap: {{ section.settings.gap }}px;
    --lxs-ratio: {{ section.settings.ratio }}%;
    --lxs-cols: {{ cols }};
    --lxs-hfont: {{ section.settings.title_font.family }}, 'Oswald', 'Arial Narrow', Impact, sans-serif;
    background: var(--lxs-bg); color: var(--lxs-fg);
    padding: {{ section.settings.pad_top }}px 0 {{ section.settings.pad_bottom }}px;
  }
  #lxs-{{ sid }} *, #lxs-{{ sid }} *::before, #lxs-{{ sid }} *::after { box-sizing: border-box; }
  #lxs-{{ sid }} .lxs-in { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 40px); }
  #lxs-{{ sid }} .lxs-head { display: flex; align-items: flex-end; justify-content: {% if section.settings.heading_align == 'center' %}center{% else %}space-between{% endif %}; gap: 16px; margin-bottom: 22px; text-align: {{ section.settings.heading_align }}; }
  #lxs-{{ sid }} .lxs-eyebrow { display: block; margin: 0 0 6px; font-size: 10px; letter-spacing: .32em; text-transform: uppercase; color: var(--lxs-accent); font-weight: 700; }
  #lxs-{{ sid }} .lxs-title { margin: 0; font-family: var(--lxs-hfont); font-weight: {{ section.settings.title_font.weight | default: 700 }}; font-size: clamp(22px, 2.6vw, 34px); line-height: 1; letter-spacing: .02em; text-transform: uppercase; }
  #lxs-{{ sid }} .lxs-row {
    display: grid; grid-template-columns: repeat(var(--lxs-cols), minmax(0, 1fr)); gap: var(--lxs-gap);
    list-style: none; margin: 0; padding: 0;
  }
  #lxs-{{ sid }} .lxs-card {
    position: relative; display: block; overflow: hidden; border-radius: var(--lxs-rad);
    background: var(--lxs-card); color: #fff; text-decoration: none; isolation: isolate;
    -webkit-tap-highlight-color: transparent;
  }
  #lxs-{{ sid }} .lxs-card::before { content: ''; display: block; padding-bottom: var(--lxs-ratio); }
  #lxs-{{ sid }} .lxs-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; display: block; z-index: -2;
    filter: {% if section.settings.mono %}grayscale(1) contrast(1.05) {% endif %}brightness(.82);
    transition: transform .7s cubic-bezier(.2,.7,.2,1), filter .4s ease; }
  #lxs-{{ sid }} .lxs-card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(0,0,0,.15) 0%, rgba(0,0,0,.35) 45%, rgba(0,0,0,{{ section.settings.overlay | divided_by: 100.0 }}) 100%); }
  #lxs-{{ sid }} .lxs-card:hover .lxs-img, #lxs-{{ sid }} .lxs-card:focus-visible .lxs-img { transform: scale(1.07); {% if section.settings.mono %}filter: grayscale(.2) brightness(.9);{% endif %} }
  #lxs-{{ sid }} .lxs-card:focus-visible { outline: 2px solid var(--lxs-accent); outline-offset: 3px; }
  #lxs-{{ sid }} .lxs-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 16px 12px 18px; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  #lxs-{{ sid }} .lxs-ico { width: 30px; height: 30px; display: block; color: #fff; }
  #lxs-{{ sid }} .lxs-ico svg, #lxs-{{ sid }} .lxs-ico img { width: 100%; height: 100%; display: block; object-fit: contain; }
  #lxs-{{ sid }} .lxs-name { margin: 0; font-family: var(--lxs-hfont); font-weight: {{ section.settings.title_font.weight | default: 700 }}; font-size: clamp(15px, 1.5vw, 21px); line-height: 1.05; letter-spacing: .04em; text-transform: uppercase; overflow-wrap: anywhere; }
  #lxs-{{ sid }} .lxs-cta { position: relative; font-size: 10px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; padding-bottom: 5px; }
  #lxs-{{ sid }} .lxs-cta::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--lxs-accent); transform-origin: left; transition: transform .35s ease; }
  #lxs-{{ sid }} .lxs-card:hover .lxs-cta::after { transform: scaleX(1.25); }
  #lxs-{{ sid }} .lxs-ph { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -2; background: linear-gradient(160deg, #1a1a1a, #050505); }
  @media (max-width: 989px) {
    #lxs-{{ sid }} .lxs-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    #lxs-{{ sid }} .lxs-head { margin-bottom: 16px; }
    {%- if section.settings.mobile_layout == 'swipe' -%}
    #lxs-{{ sid }} .lxs-in { padding-right: 0; }
    #lxs-{{ sid }} .lxs-row {
      display: grid; grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 62%;
      overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-right: 16px; scroll-padding-left: 0;
      touch-action: pan-x pan-y;
    }
    #lxs-{{ sid }} .lxs-row::-webkit-scrollbar { display: none; }
    #lxs-{{ sid }} .lxs-row > li { scroll-snap-align: start; }
    {%- else -%}
    #lxs-{{ sid }} .lxs-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    {%- endif -%}
    #lxs-{{ sid }} .lxs-ico { width: 26px; height: 26px; }
  }
  @media (prefers-reduced-motion: reduce) { #lxs-{{ sid }} .lxs-img, #lxs-{{ sid }} .lxs-cta::after { transition: none; } }
</style>

<div id="lxs-{{ sid }}" data-lxs>
  <div class="lxs-in">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="lxs-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<span class="lxs-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="lxs-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
    <ul class="lxs-row" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image
          if img == blank and c != blank
            assign img = c.featured_image
          endif
          assign name = block.settings.title
          if name == blank and c != blank
            assign name = c.title
          endif
          assign url = block.settings.link
          if url == blank and c != blank
            assign url = c.url
          endif
          assign ic = block.settings.icon
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="lxs-card" href="{{ url | default: routes.collections_url }}">
            {%- if img != blank -%}
              <img class="lxs-img"
                src="{{ img | image_url: width: 600 }}"
                srcset="{{ img | image_url: width: 360 }} 360w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w"
                sizes="(max-width: 749px) 62vw, (max-width: 989px) 33vw, {{ 100 | divided_by: cols }}vw"
                width="600" height="{{ 600 | divided_by: img.aspect_ratio | ceil }}"
                alt="{{ img.alt | default: name | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              <span class="lxs-ph" aria-hidden="true"></span>
            {%- endif -%}
            <span class="lxs-cap">
              {%- if block.settings.icon_image != blank -%}
                <span class="lxs-ico"><img src="{{ block.settings.icon_image | image_url: width: 80 }}" width="40" height="40" alt="" loading="lazy"></span>
              {%- elsif ic != 'none' -%}
                <span class="lxs-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  {%- case ic -%}
                    {%- when 'jacket' -%}<path d="M9 3l3 3 3-3 4 2 2 6-3 1v9H6v-9l-3-1 2-6z"/><path d="M12 6v15"/>
                    {%- when 'glasses' -%}<circle cx="6.5" cy="14" r="3.5"/><circle cx="17.5" cy="14" r="3.5"/><path d="M10 14c1.2-1 2.8-1 4 0M3 14l1-6h2M21 14l-1-6h-2"/>
                    {%- when 'shoe' -%}<path d="M3 17v-6l4 1 3-4 3 4c2 1 5 1 8 3v2z"/><path d="M3 17h18v2H3z"/>
                    {%- when 'tee' -%}<path d="M8 3l4 2 4-2 5 3-2 4-3-1v12H8V9L5 10 3 6z"/>
                    {%- when 'bag' -%}<path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
                    {%- when 'star' -%}<path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/>
                    {%- when 'bolt' -%}<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>
                    {%- when 'diamond' -%}<path d="M12 2l9 10-9 10-9-10z"/><path d="M3 12h18"/>
                    {%- when 'woman' -%}<circle cx="12" cy="6" r="3"/><path d="M8 21l1.5-7L7 13l2-4h6l2 4-2.5 1L16 21"/>
                    {%- when 'man' -%}<circle cx="12" cy="5.5" r="2.5"/><path d="M9 21v-7H7V9.5A1.5 1.5 0 0 1 8.5 8h7A1.5 1.5 0 0 1 17 9.5V14h-2v7"/>
                    {%- else -%}<path d="M12 2l9 10-9 10-9-10z"/>
                  {%- endcase -%}
                  </svg>
                </span>
              {%- endif -%}
              <span class="lxs-name">{{ name | default: 'Collection' | escape }}</span>
              <span class="lxs-cta">{{ section.settings.cta_label | escape }}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Shop by collection",
  "tag": "section",
  "class": "lexe-collection-strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LEXE by Devici Studios" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "center", "options": [ { "value": "center", "label": "Center" }, { "value": "left", "label": "Left" } ] },
    { "type": "font_picker", "id": "title_font", "label": "Heading / name font", "default": "oswald_n7" },
    { "type": "text", "id": "cta_label", "label": "Card link label", "default": "Shop now" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "label": "Cards per row (desktop)", "min": 3, "max": 6, "step": 1, "default": 6 },
    { "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "swipe", "options": [ { "value": "swipe", "label": "Swipe row" }, { "value": "grid", "label": "2-column grid" } ] },
    { "type": "range", "id": "ratio", "label": "Card height", "min": 100, "max": 180, "step": 5, "unit": "%", "default": 130, "info": "Height as % of width." },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 4, "info": "0 = sharp corners." },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 960, "max": 1920, "step": 40, "unit": "px", "default": 1440 },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "fg", "label": "Heading colour", "default": "#0a0a0a" },
    { "type": "color", "id": "card_bg", "label": "Card base", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Accent (underline)", "default": "#9B6BD1" },
    { "type": "range", "id": "overlay", "label": "Card dark overlay", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 85 },
    { "type": "checkbox", "id": "mono", "label": "Black & white images (colour on hover)", "default": true }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Blank = collection image." },
        { "type": "text", "id": "title", "label": "Custom title", "info": "Blank = collection title." },
        { "type": "url", "id": "link", "label": "Custom link" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "diamond", "options": [
          { "value": "none", "label": "None" }, { "value": "diamond", "label": "Diamond" }, { "value": "jacket", "label": "Jacket" },
          { "value": "glasses", "label": "Glasses" }, { "value": "shoe", "label": "Shoe" }, { "value": "tee", "label": "T-shirt" },
          { "value": "bag", "label": "Bag" }, { "value": "woman", "label": "Women" }, { "value": "man", "label": "Men" },
          { "value": "star", "label": "Star" }, { "value": "bolt", "label": "Bolt" } ] },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image", "info": "Optional. White PNG/SVG works best." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by collection",
      "blocks": [
        { "type": "collection", "settings": { "collection": "lexe", "icon": "jacket" } },
        { "type": "collection", "settings": { "collection": "lexespecs", "icon": "glasses" } },
        { "type": "collection", "settings": { "collection": "exodus", "icon": "bolt" } },
        { "type": "collection", "settings": { "collection": "women", "icon": "woman" } },
        { "type": "collection", "settings": { "collection": "men", "icon": "man" } },
        { "type": "collection", "settings": { "collection": "shoes", "icon": "shoe" } }
      ]
    }
  ]
}
{% endschema %}
