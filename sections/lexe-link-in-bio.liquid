    { "type": "text", "id": "success_text", "label": "Success: text", "default": "Watch your inbox for the next drop." },
    { "type": "header", "content": "New in card" },
    { "type": "collection", "id": "new_in_collection", "label": "Collection", "info": "Opens sorted newest first." },
    { "type": "text", "id": "newin_heading", "label": "Heading", "default": "New in" },
    { "type": "select", "id": "newin_mode", "label": "Featured item", "default": "auto", "options": [
      { "value": "auto", "label": "Auto: newest product in the collection" }, { "value": "product", "label": "Picked product" } ] },
    { "type": "product", "id": "newin_product", "label": "Picked product" },
    { "type": "text", "id": "newin_skip_tag", "label": "Skip products tagged", "default": "needs-clean-image", "info": "Auto mode skips products with this tag." },
    { "type": "checkbox", "id": "newin_show_image", "label": "Show product image", "default": true, "info": "Hidden automatically if the product has no image." },
    { "type": "select", "id": "newin_link_to", "label": "Explore link goes to", "default": "product", "options": [
      { "value": "product", "label": "The product" }, { "value": "collection", "label": "The collection (newest first)" } ] },
    { "type": "text", "id": "newin_sub", "label": "Subheading override", "info": "Blank = the product's exact title (or the collection title)." },
    { "type": "text", "id": "newin_cta", "label": "Link text", "default": "Explore" },
    { "type": "header", "content": "Footer" },
    { "type": "text", "id": "password_link_text", "label": "Password link (password page only)", "default": "Have the store password? Enter it here." },
    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "© Devici Studios" },
    { "type": "checkbox", "id": "hide_default_footer", "label": "Hide default password footer", "default": true },
    { "type": "checkbox", "id": "hide_widgets", "label": "Hide floating chat / assistant bubbles on this page", "default": true, "info": "They cover the cards on phones." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#9966CC" },
    { "type": "color", "id": "text_color", "label": "Text on glass", "default": "#FFFFFF" },
    { "type": "color", "id": "glass_tint", "label": "Glass tint", "default": "#FFFFFF" },
    { "type": "range", "id": "glass_opacity", "label": "Glass opacity", "min": 0, "max": 60, "step": 2, "unit": "%", "default": 12 },
    { "type": "range", "id": "glass_blur", "label": "Glass blur", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "color", "id": "ticket_bg", "label": "Ticket background", "default": "#FFFFFF" },
    { "type": "color", "id": "ticket_text", "label": "Ticket text", "default": "#000000" },
    { "type": "color", "id": "newin_bg", "label": "New in card", "default": "#000000" },
    { "type": "header", "content": "Shape & type" },
    { "type": "range", "id": "card_radius", "label": "Card rounding", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "control_radius", "label": "Input / pill rounding", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "font_picker", "id": "heading_font", "label": "Headline font", "default": "geist_n7" },
    { "type": "range", "id": "page_top_pad", "label": "Top space on normal pages", "info": "Clears the floating header. Not used on the password page.", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "max_width", "label": "Max width (desktop)", "min": 480, "max": 1200, "step": 20, "unit": "px", "default": 920 }
  ],
  "presets": [ { "name": "Link-in-Bio Page" } ]
}
