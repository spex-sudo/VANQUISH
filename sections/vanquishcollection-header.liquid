  }
  #lxg-{{ sid }} .lxg-pill {
    margin-top: 14px; display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 16px; border: 0; border-radius: 999px; cursor: pointer;
    font: inherit; font-size: 13px; font-weight: 600; letter-spacing: .005em; color: #0a0a0a;
    background: radial-gradient(120% 140% at 30% 20%, #FFFFFF 0%, #F6F3FA 50%, #ECE7F2 100%);
    box-shadow: 0 7px 14px -8px rgba(52,30,84,.24), 0 1px 3px rgba(52,30,84,.06), inset 1.5px 2px 3px rgba(255,255,255,.95), inset -2px -3px 5px rgba(84,52,128,.11);
    transition: transform .5s cubic-bezier(.34,1.56,.64,1), box-shadow .3s ease; -webkit-tap-highlight-color: transparent;
  }
  #lxg-{{ sid }} .lxg-pill svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  #lxg-{{ sid }} .lxg-pill:active { transform: scale(.94); transition-duration: .12s; }
  #lxg-{{ sid }} .lxg-pill:focus-visible { outline: 2px solid var(--g-acc); outline-offset: 3px; }
  @media (hover: hover) { #lxg-{{ sid }} .lxg-pill:hover { transform: translateY(-1px); } }
  @media (max-width: 768px) {
    #lxg-{{ sid }} { padding-top: {{ section.settings.glass_pad_top_mobile | default: 100 }}px; padding-bottom: 2px; }
    #lxg-{{ sid }} .lxg-inner { padding: 0 12px; }
    #lxg-{{ sid }} .lxg-card { width: 100%; min-width: 0; max-width: none; padding: 14px 18px 15px; border-radius: calc(var(--g-rad) - 6px); }
    #lxg-{{ sid }} .lxg-h { font-size: {{ section.settings.glass_title_size_mobile | default: 30 }}px; letter-spacing: -.03em; }
    #lxg-{{ sid }} .lxg-count { font-size: 12px; }
    #lxg-{{ sid }} .lxg-sub { margin-top: 5px; font-size: 13px; line-height: 1.38; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    #lxg-{{ sid }} .lxg-blob { width: 70%; }
    #lxg-{{ sid }} .lxg-blob--1 { left: -20%; }
    #lxg-{{ sid }} .lxg-blob--2 { left: 20%; }
    #lxg-{{ sid }} .lxg-blob--3 { left: 55%; }
  }
  @media (prefers-reduced-motion: reduce) { #lxg-{{ sid }} .lxg-pill { transition: none; } }
  {%- endif -%}
</style>
<div id="chc-{{ sid }}">

  {%- if hero_style == 'editorial' -%}
  {%- if hero_look == 'photo' -%}
  <!-- ══ PHOTO HERO (LEXE 2026-10-11 v3): real collection photo, black gradient, dark frosted card ══ -->
  {%- liquid
    assign p_title = ed_title | strip
    assign p_low = p_title | downcase
    if p_low == p_title
      assign p_title = p_title | capitalize
    endif
    assign p_img = nil
    assign p_focal = ''
    assign p_handle = ''
    if active_col != nil
      assign p_handle = active_col.handle
    endif
    assign p_mesh_list = section.settings.photo_mesh_handles | remove: ' ' | split: ','
    assign p_clean_list = section.settings.photo_clean_handles | remove: ' ' | split: ','
    assign p_force_mesh = false
    if p_handle != '' and p_mesh_list contains p_handle
      assign p_force_mesh = true
    endif
    unless p_force_mesh
      if active_col != nil and active_col.metafields.custom.hero_image != blank
        assign p_img = active_col.metafields.custom.hero_image.value
      endif
      if p_img == nil and section.settings.hero_image != blank
        assign p_img = section.settings.hero_image
      endif
      if p_img == nil and active_col != nil and active_col.featured_image != blank and p_clean_list contains p_handle
        assign p_img = active_col.featured_image
      endif
      if p_img == nil and active_col != nil and section.settings.photo_product_fallback
        for pp in active_col.products limit: 24
          if pp.featured_image != blank
            unless pp.tags contains 'needs-clean-image'
              assign p_img = pp.featured_image
              break
            endunless
          endif
        endfor
      endif
    endunless
    if active_col != nil and active_col.metafields.custom.hero_focal != blank
      assign p_focal = active_col.metafields.custom.hero_focal.value | default: active_col.metafields.custom.hero_focal
    endif
    if p_focal == blank and p_img != nil and p_img.presentation.focal_point != blank
      assign p_focal = p_img.presentation.focal_point
    endif
    if p_focal == blank
      assign p_focal = section.settings.photo_focal | default: '50% 35%'
    endif
    assign p_ar = 1
    if p_img != nil
      assign p_ar = p_img.aspect_ratio | default: 1
    endif
  -%}
  <div id="lxp-{{ sid }}" class="lxp{% if p_img == nil %} is-mesh{% endif %} lxp--{{ section.settings.photo_layout_desktop | default: 'right' }}" data-lxh data-lxp>
    <div class="lxp-panel">
      {%- if p_img != nil -%}<img class="lxp-img-bg" src="{{ p_img | image_url: width: 480 }}" width="480" height="{{ 480 | divided_by: p_ar | round }}" alt="" aria-hidden="true" loading="eager" decoding="async">{%- endif -%}
      <div class="lxp-media" aria-hidden="true">
        {%- if p_img != nil -%}
          <img class="lxp-img" src="{{ p_img | image_url: width: 1400 }}"
            srcset="{{ p_img | image_url: width: 600 }} 600w, {{ p_img | image_url: width: 900 }} 900w, {{ p_img | image_url: width: 1400 }} 1400w, {{ p_img | image_url: width: 2000 }} 2000w"
            sizes="(max-width: 768px) calc(100vw - 24px), 60vw"
            width="1400" height="{{ 1400 | divided_by: p_ar | round }}" alt="" loading="eager" fetchpriority="high" decoding="async"
            style="object-position: {{ p_focal | escape }};">
        {%- endif -%}
      </div>
      <div class="lxp-shade" aria-hidden="true"></div>
      {%- if section.settings.photo_resume -%}
        <a class="lxp-chip lxp-resume" href="#" hidden data-lxp-resume>
          <span class="lxp-resume-img"></span><span class="lxp-resume-txt"><small>{{ section.settings.photo_resume_label | default: 'Continue' | escape }}</small><span data-lxp-resume-title></span></span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
      <div class="lxp-card">
        <div class="lxp-row">
          {%- if template.name == 'collection' -%}<h1 class="lxp-h">{%- else -%}<h2 class="lxp-h">{%- endif -%}{{ p_title | escape }}{%- if template.name == 'collection' -%}</h1>{%- else -%}</h2>{%- endif -%}
          {%- if section.settings.glass_show_count and ed_count > 0 -%}
            <span class="lxp-count">{{ ed_count }} {% if ed_count == 1 %}{{ section.settings.count_label_one | default: 'piece' | escape }}{% else %}{{ section.settings.count_label | default: 'pieces' | escape }}{% endif %}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.glass_show_subline and ed_sub != blank -%}
          <p class="lxp-sub">{{ ed_sub | escape }}</p>
        {%- endif -%}
        {%- if section.settings.photo_members_chip -%}
          <a class="lxp-chip lxp-members" href="{{ section.settings.photo_members_url | default: '/pages/links?src=site' }}" data-lxp-members>{{ section.settings.photo_members_label | default: 'Members get first look' | escape }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
        {%- endif -%}
        {%- if section.settings.glass_cta == 'filter' -%}
          <button type="button" class="lxg-pill lxp-pill" data-lxg-filter>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M7 12h10M10 17h4"/></svg>{{ section.settings.glass_cta_label | default: 'Filter' | escape }}
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- elsif hero_look == 'glass' -%}
  <!-- ══ GLASS HERO (LEXE 2026-10-11): frosted card over a blurred real-photo backdrop ══ -->
  {%- liquid
    assign g_title = ed_title | strip
    assign g_low = g_title | downcase
    if g_low == g_title
      assign g_title = g_title | capitalize
    endif
    assign g_imgs = ''
    assign g_n = 0
    assign g_src = section.settings.glass_backdrop | default: 'products'
    if g_src == 'products' and active_col != nil
      for gp in active_col.products limit: 24
        if g_n >= 3
          break
        endif
        if gp.featured_image != blank
          unless gp.tags contains 'needs-clean-image'
            assign g_n = g_n | plus: 1
            assign g_url = gp.featured_image | image_url: width: 240
            if g_imgs == ''
              assign g_imgs = g_url
            else
              assign g_imgs = g_imgs | append: '|' | append: g_url
            endif
          endunless
        endif
      endfor
    elsif g_src == 'collection'
      if section.settings.hero_image != blank
        assign g_imgs = section.settings.hero_image | image_url: width: 480
      elsif active_col != nil and active_col.featured_image != blank
        assign g_imgs = active_col.featured_image | image_url: width: 480
      endif
    endif
    assign g_list = g_imgs | split: '|'
  -%}
  <div id="lxg-{{ sid }}" class="lxg{% if g_list.size == 0 %} is-mesh{% endif %}" data-lxh>
    <div class="lxg-bd" aria-hidden="true">
      {%- for u in g_list -%}
        <img class="lxg-blob lxg-blob--{{ forloop.index }}{% if g_list.size == 1 %} is-solo{% endif %}" src="{{ u }}" width="240" height="240" alt="" decoding="async" fetchpriority="low">
      {%- endfor -%}
      <span class="lxg-mesh"></span>
      <span class="lxg-veil"></span>
    </div>
    <div class="lxg-inner">
      <div class="lxg-card">
        <div class="lxg-row">
          {%- if template.name == 'collection' -%}<h1 class="lxg-h">{%- else -%}<h2 class="lxg-h">{%- endif -%}{{ g_title | escape }}{%- if template.name == 'collection' -%}</h1>{%- else -%}</h2>{%- endif -%}
          {%- if section.settings.glass_show_count and ed_count > 0 -%}
            <span class="lxg-count">{{ ed_count }} {% if ed_count == 1 %}{{ section.settings.count_label_one | default: 'piece' | escape }}{% else %}{{ section.settings.count_label | default: 'pieces' | escape }}{% endif %}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.glass_show_subline and ed_sub != blank -%}
          <p class="lxg-sub">{{ ed_sub | escape }}</p>
        {%- endif -%}
        {%- if section.settings.glass_cta == 'filter' -%}
          <button type="button" class="lxg-pill" data-lxg-filter>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M7 12h10M10 17h4"/></svg>{{ section.settings.glass_cta_label | default: 'Filter' | escape }}
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- else -%}
  <!-- ══ EDITORIAL HERO (LEXE 2026-10-09) ═════════════════════ -->
  <link rel="preload" as="font" href="{{ section.settings.headline_font | font_url }}" type="font/woff2" crossorigin>
  <div id="lxh-{{ sid }}" data-lxh class="lxh{% if section.settings.compact_mode %} is-compact{% endif %}{% if section.settings.stack_words %} is-stacked{% endif %}{% if section.settings.diamond_style == 'fill' %} is-fill{% endif %}">

    {%- if ed_bd != blank -%}
      <div class="lxh-bd" aria-hidden="true">
        <img
          src="{{ ed_bd | image_url: width: 1600 }}"
          srcset="{{ ed_bd | image_url: width: 750 }} 750w, {{ ed_bd | image_url: width: 1200 }} 1200w, {{ ed_bd | image_url: width: 1600 }} 1600w, {{ ed_bd | image_url: width: 2200 }} 2200w"
          sizes="100vw"
          width="1600"
          height="{{ 1600 | divided_by: ed_bd.aspect_ratio | ceil }}"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async">
      </div>
    {%- endif -%}
    <div class="lxh-tone" aria-hidden="true"></div>
    <div class="lxh-shade" aria-hidden="true"></div>
    {%- if section.settings.show_wordmark and section.settings.wordmark_text != blank -%}
      <div class="lxh-wm" aria-hidden="true">{{ section.settings.wordmark_text | escape }}</div>
    {%- endif -%}

    {%- if section.settings.show_meta -%}
      <div class="lxh-meta">
        <span>[ {{ section.settings.meta_left | default: 'Collection' | escape }} ]</span>
        <span>{{ section.settings.meta_center | escape }}</span>
        <span>{% if ed_num != blank %}[ {{ ed_num | escape }} ]{% endif %}</span>
      </div>
    {%- endif -%}

    <div class="lxh-body">
      <div class="lxh-content">
        {%- if section.settings.show_eyebrow and section.settings.promo_eyebrow != blank -%}
          <p class="lxh-eyebrow">{{ section.settings.promo_eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_headline -%}
          {%- if template.name == 'collection' -%}<h1 class="lxh-h">{%- else -%}<h2 class="lxh-h">{%- endif -%}
            {%- for w in ed_words -%}
              {%- liquid
                assign is_acc = false
                if ed_accent_mode == 'last' and forloop.last and ed_wcount > 1
                  assign is_acc = true
                elsif ed_accent_mode == 'last' and ed_wcount == 1
                  assign is_acc = false
                elsif ed_accent_mode == 'first' and forloop.first
                  assign is_acc = true
                elsif ed_accent_mode == 'line2' and forloop.index > ed_tcount
                  assign is_acc = true
                elsif ed_accent_mode == 'title' and forloop.index <= ed_tcount
                  assign is_acc = true
                elsif ed_accent_mode == 'custom' and ed_accent_custom != blank
                  assign wu = w | upcase | remove: ',' | remove: '.'
                  if ed_accent_custom contains wu
                    assign is_acc = true
                  endif
                endif
              -%}
              <span class="w{% if is_acc %} is-accent{% endif %}">{{ w | escape }}{% if forloop.last and section.settings.show_number and ed_num != blank %}<sup>{{ ed_num | escape }}&trade;</sup>{% endif %}</span>{% unless forloop.last %} {% endunless %}
            {%- endfor -%}
          {%- if template.name == 'collection' -%}</h1>{%- else -%}</h2>{%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_subline and ed_sub != blank -%}
          <p class="lxh-sub">{{ ed_sub | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_btn1 or section.settings.show_btn2 -%}
          <div class="lxh-ctas">
            {%- if section.settings.show_btn1 and section.settings.hero_cta_label != blank -%}
              {%- if ed_btn1_url != blank -%}
                <a class="lxh-btn lxh-btn--solid" href="{{ ed_btn1_url }}">{{ section.settings.hero_cta_label | escape }}</a>
              {%- else -%}
                <button type="button" class="lxh-btn lxh-btn--solid" data-chc-scroll>{{ section.settings.hero_cta_label | escape }}</button>
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.show_btn2 and section.settings.btn2_label != blank -%}
              <a class="lxh-btn lxh-btn--ghost" href="{{ ed_btn2_url }}">{{ section.settings.btn2_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_grid -%}
      <div class="lxh-media" aria-hidden="true">
        {%- if section.settings.hero_layout == 'image' and hero_img != blank -%}
          <div class="chc-simg-{{ sid }}">
            <img src="{{ hero_img | image_url: width: 1200 }}" srcset="{{ hero_img | image_url: width: 640 }} 640w, {{ hero_img | image_url: width: 1200 }} 1200w" sizes="(max-width: 768px) 100vw, {{ section.settings.split_pct }}vw" width="1200" height="{{ 1200 | divided_by: hero_img.aspect_ratio | ceil }}" alt="" loading="eager" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block">
          </div>
        {%- else -%}
          <div class="lxh-dg">
            {%- assign dfilled = 0 -%}
            {%- if active_col != nil and active_col.products.size > 0 -%}
              {%- assign psize = active_col.products.size -%}
              {%- for i in (0..dlast) -%}
                {%- if i >= psize and section.settings.diamond_repeat == false -%}{%- break -%}{%- endif -%}
                {%- assign pi = i | modulo: psize -%}
                {%- assign dp = active_col.products[pi] -%}
                {%- assign dfilled = dfilled | plus: 1 -%}
                <div class="lxh-dc{% if i == 0 and section.settings.diamond_feature %} is-feature{% endif %}">
                  {%- if dp.featured_image != blank -%}
                    <img src="{{ dp.featured_image | image_url: width: 480 }}" srcset="{{ dp.featured_image | image_url: width: 320 }} 320w, {{ dp.featured_image | image_url: width: 480 }} 480w" sizes="{{ section.settings.diamond_size | times: 1.5 | round }}px" width="480" height="{{ 480 | divided_by: dp.featured_image.aspect_ratio | ceil }}" alt="" loading="{% if dfilled <= 4 %}eager{% else %}lazy{% endif %}" decoding="async">
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- comment -%} No active collection: use block images / block collections round-robin {%- endcomment -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'carousel_card' and block.settings.image != blank and dfilled < dcount -%}
                  {%- assign dfilled = dfilled | plus: 1 -%}
                  <div class="lxh-dc"><img src="{{ block.settings.image | image_url: width: 480 }}" width="480" height="{{ 480 | divided_by: block.settings.image.aspect_ratio | ceil }}" alt="" loading="{% if dfilled <= 4 %}eager{% else %}lazy{% endif %}" decoding="async"></div>
                {%- endif -%}
              {%- endfor -%}
              {%- for block in section.blocks -%}
                {%- if dfilled >= dcount -%}{%- break -%}{%- endif -%}
                {%- if block.type == 'carousel_card' and block.settings.image == blank and block.settings.collection != blank -%}
                  {%- for dp in collections[block.settings.collection].products limit: 3 -%}
                    {%- if dfilled >= dcount -%}{%- break -%}{%- endif -%}
                    {%- if dp.featured_image != blank -%}
                      {%- assign dfilled = dfilled | plus: 1 -%}
                      <div class="lxh-dc"><img src="{{ dp.featured_image | image_url: width: 480 }}" width="480" height="{{ 480 | divided_by: dp.featured_image.aspect_ratio | ceil }}" alt="" loading="{% if dfilled <= 4 %}eager{% else %}lazy{% endif %}" decoding="async"></div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if dfilled < dcount -%}
              {%- assign dempty = dcount | minus: dfilled -%}
              {%- for e in (1..dempty) -%}<div class="lxh-dc"></div>{%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_side_copy or section.settings.show_count or section.settings.show_arrow -%}
      <div class="lxh-foot">
        {%- if section.settings.show_side_copy and section.settings.side_copy != blank -%}
          <p class="lxh-side">{{ section.settings.side_copy | escape | newline_to_br }}</p>
        {%- endif -%}
        <div class="lxh-count">
          {%- if section.settings.show_count -%}
            <div>
              {%- if ed_count > 0 -%}<small>{{ ed_count }} {% if ed_count == 1 %}{{ section.settings.count_label_one | default: 'piece' | escape }}{% else %}{{ section.settings.count_label | default: 'pieces' | escape }}{% endif %}</small>{%- endif -%}
              <a class="lxh-view" href="{{ ed_view_url }}" data-lxh-view>{{ section.settings.view_all_label | default: 'View all' | escape }} &rarr;</a>
            </div>
          {%- endif -%}
          {%- if section.settings.show_arrow -%}
            <button type="button" class="lxh-arrow" data-chc-scroll aria-label="Scroll to products">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
            </button>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
  {%- endif -%}
  {%- else -%}
  <!-- ══ HERO BANNER ══════════════════════════════════════════ -->
  <div class="chc-hero-{{ sid }}">

    <!-- Left: imagery zone -->
    <div class="chc-media-{{ sid }}">

      {%- if section.settings.hero_layout == 'grid' and active_col != nil and active_col.products.size > 0 -%}
        {%- comment -%}
          ON A COLLECTION PAGE — pull up to 9 product images from that collection.
          Simple for loop avoids variable-index access which breaks beyond page 1.
          Fewer than 9 products → remaining cells show hero_bg (dark frame, intentional).
        {%- endcomment -%}
        <div class="chc-dgrid-{{ sid }}" aria-hidden="true">
          {%- assign grid_filled = 0 -%}
          {%- for prod in active_col.products limit: 9 -%}
            {%- assign grid_filled = grid_filled | plus: 1 -%}
            <div class="chc-dcell-{{ sid }}">
              {%- if prod.featured_image != blank -%}
                <img
                  src="{{ prod.featured_image | image_url: width: 420 }}"
                  width="420"
                  height="{{ 420 | divided_by: prod.featured_image.aspect_ratio | ceil }}"
                  alt="{{ prod.featured_image.alt | default: prod.title | escape }}"
                  loading="{% if forloop.index <= 3 %}eager{% else %}lazy{% endif %}"
                  decoding="async">
              {%- endif -%}
            </div>
          {%- endfor -%}
          {%- if grid_filled < 9 -%}
            {%- assign empty_cells = 9 | minus: grid_filled -%}
            {%- for e in (1..empty_cells) -%}
              <div class="chc-dcell-{{ sid }}"></div>
            {%- endfor -%}
          {%- endif -%}
        </div>

      {%- elsif section.settings.hero_layout == 'grid' and render_blocks -%}
        {%- comment -%}
          FALLBACK GRID — no active collection (e.g. /collections page, homepage).
          Blocks with a custom image get one fixed cell each.
          Blocks with a collection share the remaining cells via ROUND-ROBIN:
          round 0 takes product #1 from every selected collection, round 1 takes
          product #2 from every selected collection, and so on, until 9 cells are
          filled. This keeps representation equal regardless of how many
          collections are selected (1 collection fills all 9 from itself; 5
          collections contribute roughly 2 each) instead of hard-capping each
          collection at a fixed count and leaving cells empty.
        {%- endcomment -%}
        <div class="chc-dgrid-{{ sid }}" aria-hidden="true">
          {%- assign grid_filled = 0 -%}

          {%- comment %} Fixed-image blocks claim their cell first. {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'carousel_card' and block.settings.image != blank and grid_filled < 9 -%}
              {%- assign grid_filled = grid_filled | plus: 1 -%}
              <div class="chc-dcell-{{ sid }}">
                <img
                  src="{{ block.settings.image | image_url: width: 420 }}"
                  width="420"
                  height="{{ 420 | divided_by: block.settings.image.aspect_ratio | ceil }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="{% if grid_filled <= 3 %}eager{% else %}lazy{% endif %}"
                  decoding="async">
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- comment %} Build the list of collection-sourced blocks (skip ones that already used a custom image). {%- endcomment -%}
          {%- assign grid_col_handles = '' -%}
          {%- assign grid_col_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'carousel_card' and block.settings.image == blank and block.settings.collection != blank -%}
              {%- assign grid_col_count = grid_col_count | plus: 1 -%}
              {%- if grid_col_handles == '' -%}
                {%- assign grid_col_handles = block.settings.collection -%}
              {%- else -%}
                {%- assign grid_col_handles = grid_col_handles | append: ',' | append: block.settings.collection -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign grid_col_list = grid_col_handles | split: ',' -%}

          {%- if grid_col_count > 0 and grid_filled < 9 -%}
            {%- assign grid_col_count_m1 = grid_col_count | minus: 1 -%}
            {%- for grid_round in (0..8) -%}
              {%- if grid_filled >= 9 -%}{%- break -%}{%- endif -%}
              {%- for grid_ci in (0..grid_col_count_m1) -%}
                {%- if grid_filled >= 9 -%}{%- break -%}{%- endif -%}
                {%- assign grid_prod = collections[grid_col_list[grid_ci]].products[grid_round] -%}
                {%- if grid_prod != blank and grid_prod.featured_image != blank -%}
                  {%- assign grid_filled = grid_filled | plus: 1 -%}
                  <div class="chc-dcell-{{ sid }}">
                    <img
                      src="{{ grid_prod.featured_image | image_url: width: 420 }}"
                      width="420"
                      height="{{ 420 | divided_by: grid_prod.featured_image.aspect_ratio | ceil }}"
                      alt="{{ grid_prod.featured_image.alt | default: grid_prod.title | escape }}"
                      loading="{% if grid_filled <= 3 %}eager{% else %}lazy{% endif %}"
                      decoding="async">
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if grid_filled < 9 -%}
            {%- assign empty_cells = 9 | minus: grid_filled -%}
            {%- for e in (1..empty_cells) -%}
              <div class="chc-dcell-{{ sid }}"></div>
            {%- endfor -%}
          {%- endif -%}
        </div>

      {%- elsif hero_img != blank -%}
        <div class="chc-simg-{{ sid }}">
          <img
            src="{{ hero_img | image_url: width: 1200 }}"
            width="1200"
            height="{{ 1200 | divided_by: hero_img.aspect_ratio | ceil }}"
            srcset="{{ hero_img | image_url: width: 640 }} 640w,
                    {{ hero_img | image_url: width: 1200 }} 1200w"
            sizes="{{ section.settings.split_pct }}vw"
            alt="{{ hero_img.alt | escape }}"
            loading="eager"
            fetchpriority="high"
            decoding="async">
        </div>

      {%- else -%}
        <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:#111;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;opacity:.35;">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

    </div>

    <!-- Right: promo overlay -->
    <div class="chc-promo-{{ sid }}">

      {%- if section.settings.promo_bg_image != blank -%}
        <div class="chc-promo-bg-{{ sid }}" aria-hidden="true">
          <img
            src="{{ section.settings.promo_bg_image | image_url: width: 900 }}"
            width="900"
            height="{{ 900 | divided_by: section.settings.promo_bg_image.aspect_ratio | ceil }}"
            alt=""
            loading="eager"
            decoding="async">
        </div>
      {%- endif -%}

      {%- if section.settings.promo_eyebrow != blank -%}
        <p class="chc-eyebrow-{{ sid }}">{{ section.settings.promo_eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.promo_headline != blank -%}
        <p class="chc-headline-{{ sid }}">{{ section.settings.promo_headline }}</p>
      {%- endif -%}

      {%- if section.settings.promo_sub != blank -%}
        <div class="chc-rule-{{ sid }}"></div>
        <p class="chc-sub-{{ sid }}">{{ section.settings.promo_sub }}</p>
      {%- endif -%}

      {%- if section.settings.hero_cta_label != blank -%}
        <button type="button" class="chc-btn-{{ sid }}" data-chc-scroll>
          {{- section.settings.hero_cta_label -}}
        </button>
      {%- endif -%}

    </div>

  </div><!-- /hero -->
  {%- endif -%}


  <!-- ══ CARD CAROUSEL ════════════════════════════════════════ -->
  {%- if card_count > 0 -%}
  <div class="chc-cwrap-{{ sid }}" data-chc-wrap>
    <div class="chc-track-{{ sid }}" data-chc-track>

      {%- assign cv_int = section.settings.cards_visible -%}

      {%- if render_blocks -%}
        {%- assign block_idx = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'carousel_card' -%}
            {%- liquid
              assign ci = block.settings.image
              if ci == blank and block.settings.product != blank and block.settings.product.featured_image != blank
                assign ci = block.settings.product.featured_image
              endif
              assign cu = block.settings.link
              assign cl = block.settings.label
              if block.settings.collection != blank
                assign bc = collections[block.settings.collection]
                if ci == blank and bc.featured_image != blank
                  assign ci = bc.featured_image
                endif
                if cu == blank
                  assign cu = bc.url
                endif
                if cl == blank
                  assign cl = bc.title
                endif
              endif
              assign block_idx = block_idx | plus: 1
            -%}
            <a href="{{ cu | default: '#' }}" class="chc-card-{{ sid }}" {{ block.shopify_attributes }}>
              <div class="chc-card-inner-{{ sid }}">
                {%- if ci != blank -%}
                  <img
                    src="{{ ci | image_url: width: 600 }}"
                    width="600"
                    height="{{ 600 | divided_by: ci.aspect_ratio | ceil }}"
                    alt="{{ ci.alt | default: cl | escape }}"
                    loading="{% if block_idx <= cv_int %}eager{% else %}lazy{% endif %}"
                    decoding="async">
                {%- else -%}
                  <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:#222;"></div>
                {%- endif -%}
                {%- if cl != blank -%}
                  <div class="chc-clabel-{{ sid }}">{{ cl }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if source_mode != 'blocks' and active_col != nil -%}
        {%- assign auto_idx = 0 -%}
        {%- for prod in active_col.products limit: auto_limit -%}
          {%- if prod.featured_image != blank -%}
            {%- assign auto_idx = auto_idx | plus: 1 -%}
            <a href="{{ prod.url }}" class="chc-card-{{ sid }}">
              <div class="chc-card-inner-{{ sid }}">
                <img
                  src="{{ prod.featured_image | image_url: width: 600 }}"
                  width="600"
                  height="{{ 600 | divided_by: prod.featured_image.aspect_ratio | ceil }}"
                  alt="{{ prod.featured_image.alt | default: prod.title | escape }}"
                  loading="{% if auto_idx <= cv_int %}eager{% else %}lazy{% endif %}"
                  decoding="async">
                {%- if section.settings.show_card_label -%}
                  <div class="chc-clabel-{{ sid }}">{{ prod.title }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

    </div>

    {%- if section.settings.show_dots -%}
      <div class="chc-dots-{{ sid }}" data-chc-dots aria-hidden="true"></div>
    {%- endif -%}
  </div>
  {%- endif -%}

</div>


<script>
(function () {
  'use strict';

  var ROOT   = document.getElementById('chc-{{ sid }}');
  if (!ROOT)  return;

  /* ── CTA — scroll to the card carousel below ──────────────
     Placed before the carousel-existence guard so the button
     still works (falls back to scrolling one viewport) even
     on pages where no cards rendered. */
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var EDITORIAL = {{ hero_style | json }} === 'editorial';
  function chcTarget() {
    if (EDITORIAL) {
      var sec = ROOT.closest('.shopify-section');
      var nx = sec ? sec.nextElementSibling : null;
      while (nx && (nx.offsetHeight === 0 || nx.tagName === 'SCRIPT' || nx.tagName === 'STYLE' || nx.querySelector('[data-lxs]'))) nx = nx.nextElementSibling;
      if (nx) return nx;
    }
    return ROOT.querySelector('[data-chc-wrap]');
  }
  function chcGo(e) {
    if (e) e.preventDefault();
    var t = chcTarget();
    if (t && t.scrollIntoView) t.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    else window.scrollBy({ top: window.innerHeight, behavior: reduceMotion ? 'auto' : 'smooth' });
  }
  ROOT.querySelectorAll('[data-chc-scroll]').forEach(function (b) { b.addEventListener('click', chcGo); });
  ROOT.querySelectorAll('[data-lxg-filter]').forEach(function (b) { b.addEventListener('click', function () { var f = document.querySelector('[id^="ApexFilterFab-"]'); if (f) f.click(); }); });
  var viewLink = ROOT.querySelector('[data-lxh-view]');
  if (viewLink) viewLink.addEventListener('click', function (e) {
    try { if (new URL(viewLink.href, location.href).pathname === location.pathname) chcGo(e); } catch (err) {}
  });

  var wrap   = ROOT.querySelector('[data-chc-wrap]');
  var track  = ROOT.querySelector('[data-chc-track]');
  var dotsEl = ROOT.querySelector('[data-chc-dots]');
  if (!wrap || !track) return;

  var N     = track.children.length;
  if (!N)   return;

  var DELAY = {{ section.settings.autoplay_delay }} * 1000;
  var GAP   = 6; /* px — matches --card-gap: 6px */
  var cur   = 0;
  var timer = null;
  var live  = false;
  var tsx   = 0;

  /* ── Helpers ───────────────────────────────────────────── */

  function getCV() {
    /* Read --cv from CSS so media-query breakpoints apply automatically */
    var v = getComputedStyle(ROOT).getPropertyValue('--cv');
    return parseFloat(v) || {{ section.settings.cards_visible }};
  }

  function maxI() {
    return Math.max(0, N - Math.floor(getCV()));
  }

  function setCardWidth() {
    /*
      Calculate card width in pixels and write it back as --card-w.
      This avoids the CSS calc(100% / var(--cv)) circular-reference
      problem in unsized flex containers (breaks in Safari).
    */
    var cv   = getCV();
    var w    = (wrap.offsetWidth - GAP * (Math.floor(cv) - 1)) / cv;
    ROOT.style.setProperty('--card-w', w.toFixed(2) + 'px');
    return w;
  }

  function goTo(i) {
    var cv = getCV();
    cur = Math.max(0, Math.min(i, maxI()));
    var w  = (wrap.offsetWidth - GAP * (Math.floor(cv) - 1)) / cv;
    track.style.transform = 'translateX(-' + (cur * (w + GAP)).toFixed(1) + 'px)';
    syncDots();
  }

  function next() { goTo(cur < maxI() ? cur + 1 : 0); }

  /* ── Timer ─────────────────────────────────────────────── */
  function startTimer() {
    clearInterval(timer);
    if (DELAY > 0 && live) timer = setInterval(next, DELAY);
  }
  function stopTimer() { clearInterval(timer); timer = null; }

  /* ── Dots ──────────────────────────────────────────────── */
  function buildDots() {
    if (!dotsEl) return;
    var pages = maxI() + 1;
    if (pages <= 1) { dotsEl.hidden = true; return; }
    dotsEl.hidden = false;
    var html = '';
    for (var i = 0; i < pages; i++) {
      html += '<button class="chc-dot-{{ sid }}" data-i="' + i +
              '" aria-label="Page ' + (i + 1) + '"></button>';
    }
    dotsEl.innerHTML = html;
    dotsEl.querySelectorAll('[data-i]').forEach(function (b) {
      b.addEventListener('click', function () {
        goTo(+this.dataset.i);
        stopTimer(); startTimer();
      });
    });
  }

  function syncDots() {
    if (!dotsEl) return;
    dotsEl.querySelectorAll('[data-i]').forEach(function (b, i) {
      b.classList.toggle('is-on', i === cur);
    });
  }

  /* ── Init ──────────────────────────────────────────────── */
  setCardWidth();
  buildDots();

  /* Position without animation on first paint */
  track.style.removeProperty('transition');
  goTo(0);
  requestAnimationFrame(function () {
    track.style.removeProperty('transition'); /* ensure CSS rule restored */
  });

  /* ── IntersectionObserver ──────────────────────────────── */
  new IntersectionObserver(function (entries) {
    live = entries[0].isIntersecting;
    live ? startTimer() : stopTimer();
  }, { threshold: 0.1 }).observe(wrap);

  /* ── Hover pause ───────────────────────────────────────── */
  wrap.addEventListener('mouseenter', stopTimer, { passive: true });
  wrap.addEventListener('mouseleave', function () {
    if (live) startTimer();
  }, { passive: true });

  /* ── Touch / swipe ─────────────────────────────────────── */
  wrap.addEventListener('touchstart', function (e) {
    tsx = e.touches[0].clientX;
    stopTimer();
  }, { passive: true });

  wrap.addEventListener('touchend', function (e) {
    var dx = e.changedTouches[0].clientX - tsx;
    if (Math.abs(dx) > 44) goTo(dx < 0 ? cur + 1 : cur - 1);
    if (live) startTimer();
  }, { passive: true });

  /* ── ResizeObserver ────────────────────────────────────────
     rAF defers read until after CSS recalculates --cv for the
     new breakpoint, preventing a stale mobile/desktop value.  */
  new ResizeObserver(function () {
    requestAnimationFrame(function () {
      track.style.removeProperty('transition'); /* snap without animation */
      setCardWidth();
      buildDots();
      goTo(Math.min(cur, maxI()));
      requestAnimationFrame(function () {
        track.style.removeProperty('transition');
      });
    });
  }).observe(wrap);

  /* ── Tab visibility ────────────────────────────────────── */
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopTimer();
    else if (live) startTimer();
  }, { passive: true });

  /* ── Shopify theme editor — reinit on section reload ────── */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === '{{ sid }}') {
      setCardWidth();
      buildDots();
      goTo(0);
    }
  });

})();
</script>



<script>
/* LEXE photo hero v3: continue-where-you-left-off chip (theme's own viewedProducts list) + session sort memory. Real data only. */
(function () {
  'use strict';
  var HERO = document.querySelector('#lxp-{{ sid }}');
  {%- if section.settings.photo_resume %}
  (function resume() {
    if (!HERO) return;
    var chip = HERO.querySelector('[data-lxp-resume]'); if (!chip) return;
    var ids = []; try { ids = JSON.parse(localStorage.getItem('viewedProducts') || '[]'); } catch (e) {}
    if (!ids || !ids.length) return;
    var id = String(ids[0]); if (!/^\d+$/.test(id)) return;
    var url = (window.Shopify && Shopify.routes && Shopify.routes.root || '/') + 'search/suggest.json?q=' + encodeURIComponent('id:' + id) + '&resources[type]=product&resources[limit]=1';
    fetch(url, { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (j) {
      var p = j && j.resources && j.resources.results && j.resources.results.products && j.resources.results.products[0];
      if (!p || String(p.id) !== id || !p.url || !p.title) return;
      var u = p.url.split('?')[0];
      if (location.pathname.indexOf(u) !== -1) return;
      chip.href = u;
      chip.querySelector('[data-lxp-resume-title]').textContent = p.title;
      chip.setAttribute('aria-label', '{{ section.settings.photo_resume_label | default: 'Continue' | escape }}: ' + p.title);
      if (p.image) chip.querySelector('.lxp-resume-img').style.backgroundImage = 'url("' + p.image.replace(/"/g, '') + (p.image.indexOf('?') > -1 ? '&' : '?') + 'width=64")';
      chip.hidden = false;
      chip.addEventListener('click', function () { if (window.lexeTrack) window.lexeTrack('hero_resume_click', { product_id: id }); });
    }).catch(function () {});
  })();
  {%- endif %}
  {%- if section.settings.photo_members_chip %}
  if (HERO) { var mc = HERO.querySelector('[data-lxp-members]'); if (mc) mc.addEventListener('click', function () { if (window.lexeTrack) window.lexeTrack('hero_members_click', {}); }); }
  {%- endif %}
  {%- if section.settings.photo_remember_sort and template.name == 'collection' %}
  (function sortMemory() {
    var KEY = 'lexe_sort_v1', q = new URLSearchParams(location.search), s = q.get('sort_by');
    try { if (s) sessionStorage.setItem(KEY, s); else s = sessionStorage.getItem(KEY); } catch (e) { return; }
    if (!s || !/^[a-z-]+$/.test(s)) return;
    function apply() {
      document.querySelectorAll('a[data-lx-sub^="collection:"]').forEach(function (a) {
        try { var u = new URL(a.getAttribute('href'), location.href); if (!u.searchParams.has('sort_by')) { u.searchParams.set('sort_by', s); a.setAttribute('href', u.pathname + u.search); } } catch (e) {}
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply); else apply();
  })();
  {%- endif %}
})();
</script>

{% schema %}
{
  "name": "Collection Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "━━ Typography"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "sans-serif"
    },
    {
      "type": "header",
      "content": "━━ Hero Style",
      "info": "Editorial = LEXE poster layout (Oct 2026). Classic = the previous split banner."
    },
    {
      "type": "select",
      "id": "hero_style",
      "label": "Hero style",
      "default": "editorial",
      "options": [
        {
          "value": "editorial",
          "label": "Editorial (LEXE poster)"
        },
        {
          "value": "classic",
          "label": "Classic split banner"
        }
      ]
    },
    {"type": "select", "id": "hero_look", "label": "Editorial look", "info": "Photo = collection photo with dark frosted card (Oct 2026 v3). Glass light = blurred light hero (v2). Poster = the previous LEXE poster / compact band (all its settings still apply).", "options": [{"value": "photo", "label": "Photo + dark glass (v3)"}, {"value": "glass", "label": "Glass light (v2)"}, {"value": "poster", "label": "Poster (previous)"}], "default": "photo"},
    {"type": "header", "content": "━━ Photo look (v3)", "info": "Image order: collection metafield custom.hero_image, then Hero image setting, then the collection image only if its handle is listed as clean, then the first product without needs-clean-image, then an amethyst gradient. Focal point: metafield custom.hero_focal (e.g. 50% 30%), then the image focal point, then the default below."},
    {"type": "text", "id": "photo_clean_handles", "label": "Collections whose own image is clean", "info": "Comma-separated handles. Leave out any collection whose image has lettering, supplier marks or watermarks.", "default": "faux-leather-jackets"},
    {"type": "text", "id": "photo_mesh_handles", "label": "Collections that use the gradient only", "info": "For collections with no clean photo at all.", "default": "exodus"},
    {"type": "checkbox", "id": "photo_product_fallback", "label": "Fall back to first clean product photo", "default": true},
    {"type": "text", "id": "photo_focal", "label": "Default focal point", "default": "50% 35%"},
    {"type": "select", "id": "photo_layout_desktop", "label": "Desktop photo layout", "options": [{"value": "right", "label": "Photo on the right, fading into black"}, {"value": "full", "label": "Full width"}], "default": "right"},
    {"type": "range", "id": "photo_width_desktop", "label": "Desktop photo width", "min": 40, "max": 100, "step": 2, "unit": "%", "default": 62},
    {"type": "range", "id": "photo_height", "label": "Panel height — desktop", "min": 320, "max": 640, "step": 10, "unit": "px", "default": 440},
    {"type": "range", "id": "photo_height_mobile", "label": "Panel height — mobile", "min": 240, "max": 420, "step": 4, "unit": "px", "default": 316},
    {"type": "range", "id": "photo_pad_top", "label": "Space above panel — desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 8},
    {"type": "range", "id": "photo_pad_top_mobile", "label": "Space above panel — mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 8},
    {"type": "range", "id": "photo_shade_top", "label": "Black overlay — top", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 15},
    {"type": "range", "id": "photo_shade_bottom", "label": "Black overlay — bottom", "min": 30, "max": 95, "step": 5, "unit": "%", "default": 75},
    {"type": "range", "id": "photo_glass_opacity", "label": "Dark glass opacity", "min": 20, "max": 70, "step": 5, "unit": "%", "default": 35},
    {"type": "header", "content": "━━ Retention touches"},
    {"type": "checkbox", "id": "photo_resume", "label": "'Continue' chip (last product viewed)", "info": "Uses the theme's own recently-viewed list on this device. Hidden when there is none.", "default": true},
    {"type": "text", "id": "photo_resume_label", "label": "Continue chip label", "default": "Continue"},
    {"type": "checkbox", "id": "photo_remember_sort", "label": "Remember sort while browsing collections", "info": "If a shopper sorts, the rail links keep that sort for the rest of the session.", "default": true},
    {"type": "checkbox", "id": "photo_members_chip", "label": "'Members get first look' chip", "default": false},
    {"type": "text", "id": "photo_members_label", "label": "Members chip label", "default": "Members get first look"},
    {"type": "text", "id": "photo_members_url", "label": "Members chip link", "default": "/pages/links?src=site"},
    {"type": "header", "content": "━━ Glass look", "info": "Backdrop uses real product photos from the collection, blurred to colour only. Products tagged needs-clean-image are skipped. With no image it falls back to a soft amethyst mesh."},
    {"type": "select", "id": "glass_backdrop", "label": "Backdrop", "options": [{"value": "products", "label": "Blurred collection products"}, {"value": "collection", "label": "Blurred collection image"}, {"value": "mesh", "label": "Amethyst mesh only"}], "default": "products"},
    {"type": "range", "id": "glass_bd_blur", "label": "Backdrop blur", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 48},
    {"type": "range", "id": "glass_opacity", "label": "Glass opacity", "min": 30, "max": 95, "step": 5, "unit": "%", "default": 55},
    {"type": "range", "id": "glass_blur", "label": "Glass blur", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20},
    {"type": "range", "id": "glass_radius", "label": "Card corner radius", "min": 12, "max": 60, "step": 2, "unit": "px", "default": 28},
    {"type": "range", "id": "glass_title_size", "label": "Title size — desktop", "min": 32, "max": 96, "step": 2, "unit": "px", "default": 52},
    {"type": "range", "id": "glass_title_size_mobile", "label": "Title size — mobile", "min": 22, "max": 48, "step": 2, "unit": "px", "default": 30},
    {"type": "checkbox", "id": "glass_show_subline", "label": "Show subline", "info": "Subline setting, else the hero_subline metafield, else the first sentence of the collection description.", "default": true},
    {"type": "checkbox", "id": "glass_show_count", "label": "Show product count", "info": "Real count from Shopify; hidden when 0.", "default": true},
