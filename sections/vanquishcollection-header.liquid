{%- comment -%}
  COLLECTION HERO + CARD CAROUSEL
  ─────────────────────────────────────────────────────────────────────────────
  Bugs fixed vs previous version
    • CSS calc() circular reference on card flex-basis removed — card width
      now set as --card-w pixel var by JS, read by CSS. Reliable everywhere.
    • Diamond grid: variable-index product access replaced with plain for loop
      + empty-cell fill. No pagination edge cases, no modulo-on-zero risk.
    • `inset` shorthand replaced with explicit top/right/bottom/left for
      Safari <14.1 (iOS 14.0 and Catalina).
    • `gap` on flex track now has `column-gap` fallback for Safari <14.1.
    • ResizeObserver wraps card-width recalc in rAF so --cv CSS var has
      time to update before JS reads it (mobile breakpoint race condition).
    • Math.round(cv) → Math.floor(cv) in gap calc (consistent with maxI).
    • `track.style.transition = ''` → removeProperty() so inline override
      is fully cleared and the CSS rule takes over correctly.
    • flex-wrap: nowrap explicit on track (some resets override default).
    • Carousel card images: first <cv> cards load eager, rest lazy.
    • overflow-wrap: break-word on headline prevents text overflow on narrow
      promo panels (mobile stacked layout).
    • Diamond grid expansion increased from -80px to -120px; covers corners
      on viewports up to ~2 000px wide without distorting images.
    • Dots button box-sizing: border-box prevents pixel-size drift.
    • min-width: 0 on card prevents flex blowout in Safari.
    • Empty carousel guard: wrapper hidden when no cards rendered.
{%- endcomment -%}

{%- liquid
  assign sid = section.id

  assign source_mode = section.settings.panel_source | default: 'auto'
  assign active_col  = nil

  if source_mode == 'auto' or source_mode == 'mixed'
    if template.name == 'collection' and collection != blank
      assign active_col = collection
    endif
  endif
  if source_mode == 'manual' and section.settings.panel_collection != blank
    assign active_col = collections[section.settings.panel_collection]
  endif
  if source_mode == 'mixed' and active_col == nil and section.settings.panel_collection != blank
    assign active_col = collections[section.settings.panel_collection]
  endif

  assign hero_img = nil
  if section.settings.hero_image != blank
    assign hero_img = section.settings.hero_image
  elsif active_col != nil and active_col.featured_image != blank
    assign hero_img = active_col.featured_image
  endif

  assign auto_limit = section.settings.auto_limit | default: 12

  assign render_blocks = false
  if source_mode == 'blocks' or source_mode == 'mixed'
    assign render_blocks = true
  endif
  if source_mode == 'auto' and active_col == nil
    assign render_blocks = true
  endif

  assign card_count = 0
  if render_blocks
    for block in section.blocks
      if block.type == 'carousel_card'
        assign card_count = card_count | plus: 1
      endif
    endfor
  endif
  if source_mode != 'blocks' and active_col != nil
    assign card_count = card_count | plus: active_col.products.size
  endif
  if section.settings.compact_mode and section.settings.compact_hide_carousel
    assign card_count = 0
  endif
-%}

{%- liquid
  # ── Editorial hero variables (LEXE redesign 2026-10-09) ──
  assign hero_style = section.settings.hero_style | default: 'editorial'
  assign hero_look = section.settings.hero_look | default: 'photo'
  assign ed_title = ''
  if active_col != nil
    assign ed_title = active_col.title
  endif
  if template.name == 'collection' and collection != blank
    assign ed_title = collection.title
  endif
  if section.settings.headline_source == 'custom' and section.settings.promo_headline != blank
    assign ed_title = section.settings.promo_headline | replace: '[title]', ed_title
  endif
  assign ed_mf_col = nil
  if template.name == 'collection' and collection != blank
    assign ed_mf_col = collection
  endif
  if ed_mf_col != nil and ed_mf_col.metafields.custom.hero_headline != blank
    assign ed_title = ed_mf_col.metafields.custom.hero_headline.value | default: ed_mf_col.metafields.custom.hero_headline
  endif
  if ed_title == blank
    assign ed_title = shop.name
  endif
  assign ed_words = ed_title | strip | split: ' '
  assign ed_tcount = ed_words.size
  assign ed_line2 = section.settings.headline_line2 | strip
  if ed_line2 != blank
    assign ed_words2 = ed_line2 | split: ' '
    assign ed_words = ed_words | concat: ed_words2
  endif
  assign ed_wcount = ed_words.size
  assign ed_accent_mode = section.settings.accent_mode | default: 'last'
  assign ed_accent_custom = section.settings.accent_text | strip | upcase

  assign ed_num = section.settings.col_number | strip
  if ed_mf_col != nil and ed_mf_col.metafields.custom.collection_number != blank
    assign ed_num = ed_mf_col.metafields.custom.collection_number.value | default: ed_mf_col.metafields.custom.collection_number
  endif

  assign ed_sub = section.settings.subline | strip
  if ed_mf_col != nil and ed_mf_col.metafields.custom.hero_subline != blank
    assign ed_sub = ed_mf_col.metafields.custom.hero_subline.value | default: ed_mf_col.metafields.custom.hero_subline
  endif
  if ed_sub == blank and active_col != nil and active_col.description != blank
    assign ed_desc = active_col.description | strip_html | strip_newlines | strip
    assign ed_sub = ed_desc | split: '. ' | first | split: '.' | first | append: '.' | truncate: 150
  endif

  assign ed_bd = nil
  assign ed_bd_src = section.settings.backdrop_source
  assign ed_bd_list = section.settings.backdrop_product_handles | remove: ' ' | split: ','
  if active_col != nil and ed_bd_list contains active_col.handle
    assign ed_bd_src = 'product'
  endif
  if ed_bd_src == 'product'
    if section.settings.backdrop_product != blank and section.settings.backdrop_product.featured_image != blank
      assign ed_bd = section.settings.backdrop_product.featured_image
    elsif active_col != nil
      for bp in active_col.products limit: 12
        if bp.featured_image != blank
          assign ed_bd = bp.featured_image
          break
        endif
      endfor
    endif
  elsif section.settings.backdrop_source == 'promo' and section.settings.promo_bg_image != blank
    assign ed_bd = section.settings.promo_bg_image
  elsif section.settings.backdrop_source != 'none'
    if section.settings.hero_image != blank
      assign ed_bd = section.settings.hero_image
    elsif active_col != nil and active_col.featured_image != blank
      assign ed_bd = active_col.featured_image
    endif
  endif

  assign dcount = section.settings.diamond_count | default: 9
  assign dcols = 2
  for c in (2..4)
    assign csq = c | times: c
    if csq >= dcount
      assign dcols = c
      break
    endif
    assign dcols = c
  endfor
  assign drows = dcount | plus: dcols | minus: 1 | divided_by: dcols
  assign dlast = dcount | minus: 1

  assign ed_count = 0
  assign ed_view_url = routes.all_products_collection_url
  if active_col != nil
    assign ed_count = active_col.products_count
    assign ed_view_url = active_col.url
  endif
  assign ed_btn1_url = section.settings.btn1_link
  assign ed_btn2_url = section.settings.btn2_link | default: routes.collections_url
-%}

<style>
  {{ section.settings.font | font_face: font_display: 'swap' }}

  #chc-{{ sid }} {
    --font:      {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    --promo-bg:  {{ section.settings.promo_bg }};
    --promo-fg:  {{ section.settings.promo_fg }};
    --btn-bg:    {{ section.settings.btn_bg }};
    --btn-fg:    {{ section.settings.btn_fg }};
    --hero-bg:   {{ section.settings.hero_bg }};
    --cv:        {{ section.settings.cards_visible }};
    --card-gap:  6px;
    --card-rad:  {{ section.settings.card_radius }}px;
    --card-w:    calc((100% - var(--card-gap) * (var(--cv) - 1)) / var(--cv)); /* CSS first paint = JS value, no layout shift */
    font-family: var(--font);
    width: 100%;
    display: block;
  }

  /* ── HERO ──────────────────────────────────────────────── */
  .chc-hero-{{ sid }} {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    width: 100%;
    height: {{ section.settings.hero_height }}px;
    overflow: hidden;
    background: var(--hero-bg);
  }

  .chc-media-{{ sid }} {
    -webkit-box-flex: 0;
    -ms-flex: 0 0 {{ section.settings.split_pct }}%;
    flex: 0 0 {{ section.settings.split_pct }}%;
    position: relative;
    overflow: hidden;
    background: var(--hero-bg);
  }

  /*
    Diamond grid: 3×3 CSS grid expanded 120px beyond container on all sides
    then rotated 45°. Each cell counter-rotates images back to straight.
    Parent overflow:hidden clips to container; dark background shows in gaps.
    -120px expansion covers container corners for viewports up to ~2000px wide.
  */
  .chc-dgrid-{{ sid }} {
    position: absolute;
    top: -120px;
    left: -120px;
    right: -120px;
    bottom: -120px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 10px;
    -webkit-transform: rotate(45deg);
    transform: rotate(45deg);
    -webkit-transform-origin: 50% 50%;
    transform-origin: 50% 50%;
  }

  .chc-dcell-{{ sid }} {
    overflow: hidden;
    background: var(--hero-bg);
  }

  .chc-dcell-{{ sid }} img {
    width: 100%;
    height: 100%;
    -o-object-fit: cover;
    object-fit: cover;
    display: block;
    -webkit-transform: rotate(-45deg) scale(1.55);
    transform: rotate(-45deg) scale(1.55);
    -webkit-transform-origin: 50% 50%;
    transform-origin: 50% 50%;
  }

  /* Single hero image fallback */
  .chc-simg-{{ sid }} {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
  }
  .chc-simg-{{ sid }} img {
    width: 100%;
    height: 100%;
    -o-object-fit: cover;
    object-fit: cover;
    display: block;
  }

  /* Right: promo panel */
  .chc-promo-{{ sid }} {
    -webkit-box-flex: 1;
    -ms-flex: 1 1 0;
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    -ms-flex-direction: column;
    flex-direction: column;
    -webkit-box-align: start;
    -ms-flex-align: start;
    align-items: flex-start;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
    padding: 36px 48px;
    gap: 10px;
    background: var(--promo-bg);
    overflow: hidden;
  }

  /* Promo background image */
  .chc-promo-bg-{{ sid }} {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 0;
  }
  .chc-promo-bg-{{ sid }} img {
    width: 100%;
    height: 100%;
    -o-object-fit: cover;
    object-fit: cover;
    display: block;
  }

  /* All text above bg image */
  .chc-eyebrow-{{ sid }},
  .chc-headline-{{ sid }},
  .chc-sub-{{ sid }},
  .chc-rule-{{ sid }},
  .chc-btn-{{ sid }} {
    position: relative;
    z-index: 1;
  }

  .chc-eyebrow-{{ sid }} {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--promo-fg);
    opacity: 0.6;
    margin: 0;
    line-height: 1;
  }

  .chc-headline-{{ sid }} {
    font-size: clamp(22px, 4.6vw, {{ section.settings.headline_size }}px);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--promo-fg);
    margin: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .chc-sub-{{ sid }} {
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--promo-fg);
    opacity: 0.42;
    margin: 0;
    line-height: 1;
  }

  .chc-rule-{{ sid }} {
    width: 28px;
    height: 1px;
    background: var(--promo-fg);
    opacity: 0.2;
    -ms-flex-negative: 0;
    flex-shrink: 0;
  }

  .chc-btn-{{ sid }} {
    display: inline-block;
    margin-top: 6px;
    padding: 11px 26px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    -webkit-transition: opacity 0.18s ease;
    transition: opacity 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .chc-btn-{{ sid }}:hover { opacity: 0.76; }

  /* ── CARD CAROUSEL ──────────────────────────────────────── */
  .chc-cwrap-{{ sid }} {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.card_bg }};
    -ms-touch-action: pan-y;
    touch-action: pan-y;
  }

  .chc-track-{{ sid }} {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    -ms-flex-direction: row;
    flex-direction: row;
    -ms-flex-wrap: nowrap;
    flex-wrap: nowrap;
    /* column-gap for Safari <14.1; gap for modern browsers */
    -webkit-column-gap: var(--card-gap);
    -moz-column-gap: var(--card-gap);
    column-gap: var(--card-gap);
    gap: var(--card-gap);
    will-change: transform;
    -webkit-transition: -webkit-transform 0.48s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition: transform 0.48s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .chc-card-{{ sid }} {
    /*
      Width driven by --card-w set by JS.
      Avoids calc(100% - ...) which is circular in an unsized flex container
      and can break in Safari. JS reads offsetWidth after layout so it's
      always pixel-accurate regardless of viewport or breakpoint.
    */
    -webkit-box-flex: 0;
    -ms-flex: 0 0 var(--card-w);
    flex: 0 0 var(--card-w);
    min-width: 0;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
    background: var(--hero-bg);
    border-radius: var(--card-rad);
    -webkit-tap-highlight-color: transparent;
  }

  /* Aspect ratio — padding-bottom trick works in all browsers */
  .chc-card-{{ sid }}::after {
    content: '';
    display: block;
    padding-bottom: {{ section.settings.card_ratio }}%;
  }

  .chc-card-inner-{{ sid }} {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
  }

  .chc-card-{{ sid }} img {
    width: 100%;
    height: 100%;
    -o-object-fit: cover;
    object-fit: cover;
    display: block;
    -webkit-transition: -webkit-transform 0.42s ease;
    transition: transform 0.42s ease;
  }

  .chc-card-{{ sid }}:hover img {
    -webkit-transform: scale(1.05);
    transform: scale(1.05);
  }

  .chc-clabel-{{ sid }} {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 10px 14px;
    background: rgba(0,0,0,0.56);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.3;
  }

  /* Dot navigation */
  .chc-dots-{{ sid }} {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
    gap: 5px;
    padding: 10px 0 7px;
    background: {{ section.settings.card_bg }};
  }

  .chc-dot-{{ sid }} {
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    opacity: 0.2;
    border: none;
    padding: 0;
    cursor: pointer;
    -webkit-transition: opacity 0.2s;
    transition: opacity 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .chc-dot-{{ sid }}.is-on { opacity: 1; }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 768px) {
    #chc-{{ sid }} { --cv: {{ section.settings.cards_visible_mobile }}; }

    .chc-hero-{{ sid }} {
      -webkit-box-orient: vertical;
      -webkit-box-direction: normal;
      -ms-flex-direction: column;
      flex-direction: column;
      height: auto;
    }
    .chc-media-{{ sid }} {
      -webkit-box-flex: 0;
      -ms-flex: none;
      flex: none;
      width: 100%;
      height: {{ section.settings.hero_height | times: 0.52 | round }}px;
    }
    .chc-promo-{{ sid }} {
      -webkit-box-flex: 0;
      -ms-flex: none;
      flex: none;
      width: 100%;
      padding: 22px 20px 28px;
    }
  }
</style>
<style>
  {%- if hero_style == 'editorial' -%}
  {{ section.settings.headline_font | font_face: font_display: 'swap' }}
  #lxh-{{ sid }} .lxh-h .w { white-space: nowrap; }
  #lxh-{{ sid }} {
    --lx-accent: {{ section.settings.accent_color | default: '#9B6BD1' }};
    --lx-accent-2: {{ section.settings.accent_color_2 | default: '#6E3FA3' }};
    --lx-fg: {{ section.settings.promo_fg | default: '#ffffff' }};
    --lx-bg: {{ section.settings.hero_bg | default: '#0a0a0a' }};
    --lx-duo: {{ section.settings.duotone_strength | divided_by: 100.0 }};
    --lx-shade: {{ section.settings.shade_strength | divided_by: 100.0 }};
    --lx-hfont: {{ section.settings.headline_font.family }}, 'Oswald', 'Arial Narrow', Impact, sans-serif;
    --lx-hw: {{ section.settings.headline_font.weight | default: 700 }};
    --lx-hsize: {{ section.settings.ed_headline_size }}px;
    --lx-ds: {{ section.settings.diamond_size }}px;
    --lx-dgap: {{ section.settings.diamond_gap }}px;
    --lx-drad: {{ section.settings.diamond_radius }}px;
    --lx-dcols: {{ dcols }};
    --lx-drows: {{ drows }};
    --lx-split: {{ section.settings.split_pct }}%;
    --lx-pt: {{ section.settings.pad_top }}px;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: {{ section.settings.ed_height }}px;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    background: var(--lx-bg);
    color: var(--lx-fg);
    font-family: var(--font);
    contain: paint;
  }
  #lxh-{{ sid }} *, #lxh-{{ sid }} *::before, #lxh-{{ sid }} *::after { box-sizing: border-box; }
  /* ── Compact mode (collection pages with the Apex grid) ── */
  #lxh-{{ sid }}.is-compact { min-height: 0; flex-direction: row; align-items: flex-end; gap: 24px;
    padding: {{ section.settings.compact_pad_top }}px clamp(20px, 4vw, 64px) 16px {{ section.settings.compact_pad_left }}px; }
  #lxh-{{ sid }}.is-compact .lxh-meta, #lxh-{{ sid }}.is-compact .lxh-media, #lxh-{{ sid }}.is-compact .lxh-sub,
  #lxh-{{ sid }}.is-compact .lxh-ctas, #lxh-{{ sid }}.is-compact .lxh-side, #lxh-{{ sid }}.is-compact .lxh-eyebrow,
  #lxh-{{ sid }}.is-compact .lxh-arrow { display: none !important; }
  #lxh-{{ sid }}.is-compact .lxh-body { flex: 1 1 auto; min-width: 0; }
  #lxh-{{ sid }}.is-compact .lxh-content { width: auto; max-width: none; padding: 0; gap: 0; }
  #lxh-{{ sid }}.is-compact .lxh-h { font-size: {{ section.settings.compact_headline_size }}px; line-height: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  #lxh-{{ sid }}.is-compact .lxh-h .w { display: inline !important; }
  #lxh-{{ sid }}.is-compact .lxh-foot { padding: 0; flex: 0 0 auto; }
  #lxh-{{ sid }}.is-compact .lxh-wm { font-size: clamp(120px, 16vw, 260px); }
  @media (max-width: 768px) {
    #lxh-{{ sid }}.is-compact { padding: {{ section.settings.compact_pad_top_mobile }}px 16px 12px; gap: 12px; }
    #lxh-{{ sid }}.is-compact .lxh-h { font-size: {{ section.settings.compact_headline_size_mobile }}px; white-space: normal; overflow: visible; text-overflow: clip; line-height: .95; }
    #lxh-{{ sid }}.is-compact .lxh-count small { font-size: 9px; }
    #lxh-{{ sid }}.is-compact .lxh-view { font-size: 10px; }
  }

  /* Backdrop: photo -> greyscale -> accent duotone -> shade for contrast */
  #lxh-{{ sid }} .lxh-bd { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: -3; }
  #lxh-{{ sid }} .lxh-bd img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: grayscale(1) contrast(1.15) brightness(.8);
    transform: scale(1.04);
  }
  #lxh-{{ sid }} .lxh-tone {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: -2; pointer-events: none;
    background: linear-gradient(135deg, var(--lx-accent) 0%, var(--lx-accent-2) 55%, #000 100%);
    mix-blend-mode: color; opacity: var(--lx-duo);
  }
  #lxh-{{ sid }} .lxh-shade {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: -2; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.7) 38%, rgba(0,0,0,.25) 70%, rgba(0,0,0,.45) 100%),
      linear-gradient(0deg, rgba(0,0,0,.85) 0%, rgba(0,0,0,0) 30%);
    opacity: var(--lx-shade);
  }
  /* Wordmark texture */
  #lxh-{{ sid }} .lxh-wm {
    position: absolute; z-index: -1; pointer-events: none; user-select: none;
    left: -2%; top: 50%;
    transform: translateY(-50%) rotate(-7deg) skewX(-12deg);
    font-family: var(--lx-hfont); font-weight: 900; font-style: italic;
    font-size: clamp(160px, 34vw, 560px); line-height: .8; letter-spacing: -.04em;
    text-transform: uppercase; white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,.10);
    text-shadow: 0 0 22px rgba(255,255,255,.06), 6px 6px 0 rgba(255,255,255,.03);
    opacity: {{ section.settings.wordmark_opacity | divided_by: 100.0 }};
    filter: blur(.4px);
  }

  /* Meta row */
  #lxh-{{ sid }} .lxh-meta {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: var(--lx-pt) clamp(20px, 4vw, 64px) 0;
    font-size: 10px; letter-spacing: .32em; text-transform: uppercase; line-height: 1.4;
    color: var(--lx-fg); opacity: .72;
  }
  #lxh-{{ sid }} .lxh-meta span:nth-child(2) { flex: 1; text-align: center; }

  /* Body: content + diamond zone */
