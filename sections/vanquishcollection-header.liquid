{%- comment -%}
  COLLECTION HERO + CARD CAROUSEL
  ─────────────────────────────────────────────────────────────────────────────
  Bugs fixed vs previous version
    • CSS calc() circular reference on card flex-basis removed — card width
      now set as --card-w pixel var by JS, read by CSS. Reliable everywhere.
    • Diamond grid: variable-index product access replaced with plain for loop
      + empty-cell fill. No pagination edge cases, no modulo-on-zero risk.
    • `inset` shorthand replaced with explicit top/right/bottom/left for
      Safari <14.1 (iOS 14.0 and Catalina).
    • `gap` on flex track now has `column-gap` fallback for Safari <14.1.
    • ResizeObserver wraps card-width recalc in rAF so --cv CSS var has
      time to update before JS reads it (mobile breakpoint race condition).
    • Math.round(cv) → Math.floor(cv) in gap calc (consistent with maxI).
    • `track.style.transition = ''` → removeProperty() so inline override
      is fully cleared and the CSS rule takes over correctly.
    • flex-wrap: nowrap explicit on track (some resets override default).
    • Carousel card images: first <cv> cards load eager, rest lazy.
    • overflow-wrap: break-word on headline prevents text overflow on narrow
      promo panels (mobile stacked layout).
    • Diamond grid expansion increased from -80px to -120px; covers corners
      on viewports up to ~2 000px wide without distorting images.
    • Dots button box-sizing: border-box prevents pixel-size drift.
    • min-width: 0 on card prevents flex blowout in Safari.
    • Empty carousel guard: wrapper hidden when no cards rendered.
{%- endcomment -%}

{%- liquid
  assign sid = section.id

  assign source_mode = section.settings.panel_source | default: 'auto'
  assign active_col  = nil

  if source_mode == 'auto' or source_mode == 'mixed'
    if template.name == 'collection' and collection != blank
      assign active_col = collection
    endif
  endif
  if source_mode == 'manual' and section.settings.panel_collection != blank
    assign active_col = collections[section.settings.panel_collection]
  endif
  if source_mode == 'mixed' and active_col == nil and section.settings.panel_collection != blank
    assign active_col = collections[section.settings.panel_collection]
  endif

  assign hero_img = nil
  if section.settings.hero_image != blank
    assign hero_img = section.settings.hero_image
  elsif active_col != nil and active_col.featured_image != blank
    assign hero_img = active_col.featured_image
  endif

  assign auto_limit = section.settings.auto_limit | default: 12

  assign render_blocks = false
  if source_mode == 'blocks' or source_mode == 'mixed'
    assign render_blocks = true
  endif
  if source_mode == 'auto' and active_col == nil
    assign render_blocks = true
  endif

  assign card_count = 0
  if render_blocks
    for block in section.blocks
      if block.type == 'carousel_card'
        assign card_count = card_count | plus: 1
      endif
    endfor
  endif
  if source_mode != 'blocks' and active_col != nil
    assign card_count = card_count | plus: active_col.products.size
  endif
-%}

{%- liquid
  # ── Editorial hero variables (LEXE redesign 2026-10-09) ──
  assign hero_style = section.settings.hero_style | default: 'editorial'
  assign ed_title = ''
  if active_col != nil
    assign ed_title = active_col.title
  endif
  if template.name == 'collection' and collection != blank
    assign ed_title = collection.title
  endif
  if section.settings.headline_source == 'custom' and section.settings.promo_headline != blank
    assign ed_title = section.settings.promo_headline | replace: '[title]', ed_title
  endif
  assign ed_mf_col = nil
  if template.name == 'collection' and collection != blank
    assign ed_mf_col = collection
  endif
  if ed_mf_col != nil and ed_mf_col.metafields.custom.hero_headline != blank
    assign ed_title = ed_mf_col.metafields.custom.hero_headline.value | default: ed_mf_col.metafields.custom.hero_headline
  endif
  if ed_title == blank
    assign ed_title = shop.name
  endif
  assign ed_words = ed_title | strip | split: ' '
  assign ed_tcount = ed_words.size
  assign ed_line2 = section.settings.headline_line2 | strip
  if ed_line2 != blank
    assign ed_words2 = ed_line2 | split: ' '
    assign ed_words = ed_words | concat: ed_words2
  endif
  assign ed_wcount = ed_words.size
  assign ed_accent_mode = section.settings.accent_mode | default: 'last'
  assign ed_accent_custom = section.settings.accent_text | strip | upcase

  assign ed_num = section.settings.col_number | strip
  if ed_mf_col != nil and ed_mf_col.metafields.custom.collection_number != blank
    assign ed_num = ed_mf_col.metafields.custom.collection_number.value | default: ed_mf_col.metafields.custom.collection_number
  endif

  assign ed_sub = section.settings.subline | strip
  if ed_mf_col != nil and ed_mf_col.metafields.custom.hero_subline != blank
    assign ed_sub = ed_mf_col.metafields.custom.hero_subline.value | default: ed_mf_col.metafields.custom.hero_subline
  endif
  if ed_sub == blank and active_col != nil and active_col.description != blank
    assign ed_desc = active_col.description | strip_html | strip_newlines | strip
    assign ed_sub = ed_desc | split: '. ' | first | split: '.' | first | append: '.' | truncate: 150
  endif

  assign ed_bd = nil
  if section.settings.backdrop_source == 'promo' and section.settings.promo_bg_image != blank
    assign ed_bd = section.settings.promo_bg_image
  elsif section.settings.backdrop_source != 'none'
    if section.settings.hero_image != blank
      assign ed_bd = section.settings.hero_image
    elsif active_col != nil and active_col.featured_image != blank
      assign ed_bd = active_col.featured_image
    endif
  endif

  assign dcount = section.settings.diamond_count | default: 9
  assign dcols = 2
  for c in (2..4)
    assign csq = c | times: c
    if csq >= dcount
      assign dcols = c
      break
    endif
    assign dcols = c
  endfor
  assign drows = dcount | plus: dcols | minus: 1 | divided_by: dcols
  assign dlast = dcount | minus: 1

  assign ed_count = 0
  assign ed_view_url = routes.all_products_collection_url
  if active_col != nil
    assign ed_count = active_col.products_count
    assign ed_view_url = active_col.url
  endif
  assign ed_btn1_url = section.settings.btn1_link
  assign ed_btn2_url = section.settings.btn2_link | default: routes.collections_url
-%}

<style>
  {{ section.settings.font | font_face: font_display: 'swap' }}

  #chc-{{ sid }} {
    --font:      {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    --promo-bg:  {{ section.settings.promo_bg }};
    --promo-fg:  {{ section.settings.promo_fg }};
    --btn-bg:    {{ section.settings.btn_bg }};
    --btn-fg:    {{ section.settings.btn_fg }};
    --hero-bg:   {{ section.settings.hero_bg }};
    --cv:        {{ section.settings.cards_visible }};
    --card-gap:  6px;
    --card-rad:  {{ section.settings.card_radius }}px;
    --card-w:    calc((100% - var(--card-gap) * (var(--cv) - 1)) / var(--cv)); /* CSS first paint = JS value, no layout shift */
    font-family: var(--font);
    width: 100%;
    display: block;
  }

  /* ── HERO ──────────────────────────────────────────────── */
  .chc-hero-{{ sid }} {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    width: 100%;
    height: {{ section.settings.hero_height }}px;
    overflow: hidden;
    background: var(--hero-bg);
  }

  .chc-media-{{ sid }} {
    -webkit-box-flex: 0;
    -ms-flex: 0 0 {{ section.settings.split_pct }}%;
    flex: 0 0 {{ section.settings.split_pct }}%;
    position: relative;
    overflow: hidden;
    background: var(--hero-bg);
  }

  /*
    Diamond grid: 3×3 CSS grid expanded 120px beyond container on all sides
    then rotated 45°. Each cell counter-rotates images back to straight.
    Parent overflow:hidden clips to container; dark background shows in gaps.
    -120px expansion covers container corners for viewports up to ~2000px wide.
  */
  .chc-dgrid-{{ sid }} {
    position: absolute;
    top: -120px;
    left: -120px;
    right: -120px;
    bottom: -120px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 10px;
    -webkit-transform: rotate(45deg);
    transform: rotate(45deg);
    -webkit-transform-origin: 50% 50%;
    transform-origin: 50% 50%;
  }

  .chc-dcell-{{ sid }} {
    overflow: hidden;
    background: var(--hero-bg);
  }

  .chc-dcell-{{ sid }} img {
    width: 100%;
    height: 100%;
    -o-object-fit: cover;
    object-fit: cover;
    display: block;
    -webkit-transform: rotate(-45deg) scale(1.55);
    transform: rotate(-45deg) scale(1.55);
    -webkit-transform-origin: 50% 50%;
    transform-origin: 50% 50%;
  }

  /* Single hero image fallback */
  .chc-simg-{{ sid }} {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
  }
  .chc-simg-{{ sid }} img {
    width: 100%;
    height: 100%;
    -o-object-fit: cover;
    object-fit: cover;
    display: block;
  }

  /* Right: promo panel */
  .chc-promo-{{ sid }} {
    -webkit-box-flex: 1;
    -ms-flex: 1 1 0;
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    -ms-flex-direction: column;
    flex-direction: column;
    -webkit-box-align: start;
    -ms-flex-align: start;
    align-items: flex-start;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
    padding: 36px 48px;
    gap: 10px;
    background: var(--promo-bg);
    overflow: hidden;
  }

  /* Promo background image */
  .chc-promo-bg-{{ sid }} {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 0;
  }
  .chc-promo-bg-{{ sid }} img {
    width: 100%;
    height: 100%;
    -o-object-fit: cover;
    object-fit: cover;
    display: block;
  }

  /* All text above bg image */
  .chc-eyebrow-{{ sid }},
  .chc-headline-{{ sid }},
  .chc-sub-{{ sid }},
  .chc-rule-{{ sid }},
  .chc-btn-{{ sid }} {
    position: relative;
    z-index: 1;
  }

  .chc-eyebrow-{{ sid }} {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--promo-fg);
    opacity: 0.6;
    margin: 0;
    line-height: 1;
  }

  .chc-headline-{{ sid }} {
    font-size: clamp(22px, 4.6vw, {{ section.settings.headline_size }}px);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--promo-fg);
    margin: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .chc-sub-{{ sid }} {
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--promo-fg);
    opacity: 0.42;
    margin: 0;
    line-height: 1;
  }

  .chc-rule-{{ sid }} {
    width: 28px;
    height: 1px;
    background: var(--promo-fg);
    opacity: 0.2;
    -ms-flex-negative: 0;
    flex-shrink: 0;
  }

  .chc-btn-{{ sid }} {
    display: inline-block;
    margin-top: 6px;
    padding: 11px 26px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    -webkit-transition: opacity 0.18s ease;
    transition: opacity 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .chc-btn-{{ sid }}:hover { opacity: 0.76; }

  /* ── CARD CAROUSEL ──────────────────────────────────────── */
  .chc-cwrap-{{ sid }} {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.card_bg }};
    -ms-touch-action: pan-y;
    touch-action: pan-y;
  }

  .chc-track-{{ sid }} {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    -ms-flex-direction: row;
    flex-direction: row;
    -ms-flex-wrap: nowrap;
    flex-wrap: nowrap;
    /* column-gap for Safari <14.1; gap for modern browsers */
    -webkit-column-gap: var(--card-gap);
    -moz-column-gap: var(--card-gap);
    column-gap: var(--card-gap);
    gap: var(--card-gap);
    will-change: transform;
    -webkit-transition: -webkit-transform 0.48s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition: transform 0.48s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .chc-card-{{ sid }} {
    /*
      Width driven by --card-w set by JS.
      Avoids calc(100% - ...) which is circular in an unsized flex container
      and can break in Safari. JS reads offsetWidth after layout so it's
      always pixel-accurate regardless of viewport or breakpoint.
    */
    -webkit-box-flex: 0;
    -ms-flex: 0 0 var(--card-w);
    flex: 0 0 var(--card-w);
    min-width: 0;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
    background: var(--hero-bg);
    border-radius: var(--card-rad);
    -webkit-tap-highlight-color: transparent;
  }

  /* Aspect ratio — padding-bottom trick works in all browsers */
  .chc-card-{{ sid }}::after {
    content: '';
    display: block;
    padding-bottom: {{ section.settings.card_ratio }}%;
  }

  .chc-card-inner-{{ sid }} {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
  }

  .chc-card-{{ sid }} img {
    width: 100%;
    height: 100%;
    -o-object-fit: cover;
    object-fit: cover;
    display: block;
    -webkit-transition: -webkit-transform 0.42s ease;
    transition: transform 0.42s ease;
  }

  .chc-card-{{ sid }}:hover img {
    -webkit-transform: scale(1.05);
    transform: scale(1.05);
  }

  .chc-clabel-{{ sid }} {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 10px 14px;
    background: rgba(0,0,0,0.56);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.3;
  }

  /* Dot navigation */
  .chc-dots-{{ sid }} {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
    gap: 5px;
    padding: 10px 0 7px;
    background: {{ section.settings.card_bg }};
  }

  .chc-dot-{{ sid }} {
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    opacity: 0.2;
    border: none;
    padding: 0;
    cursor: pointer;
    -webkit-transition: opacity 0.2s;
    transition: opacity 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .chc-dot-{{ sid }}.is-on { opacity: 1; }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 768px) {
    #chc-{{ sid }} { --cv: {{ section.settings.cards_visible_mobile }}; }

    .chc-hero-{{ sid }} {
      -webkit-box-orient: vertical;
      -webkit-box-direction: normal;
      -ms-flex-direction: column;
      flex-direction: column;
      height: auto;
    }
    .chc-media-{{ sid }} {
      -webkit-box-flex: 0;
      -ms-flex: none;
      flex: none;
      width: 100%;
      height: {{ section.settings.hero_height | times: 0.52 | round }}px;
    }
    .chc-promo-{{ sid }} {
      -webkit-box-flex: 0;
      -ms-flex: none;
      flex: none;
      width: 100%;
      padding: 22px 20px 28px;
    }
  }
</style>
<style>
  {%- if hero_style == 'editorial' -%}
  {{ section.settings.headline_font | font_face: font_display: 'swap' }}
  #lxh-{{ sid }} .lxh-h .w { white-space: nowrap; }
  #lxh-{{ sid }} {
    --lx-accent: {{ section.settings.accent_color | default: '#9B6BD1' }};
    --lx-accent-2: {{ section.settings.accent_color_2 | default: '#6E3FA3' }};
    --lx-fg: {{ section.settings.promo_fg | default: '#ffffff' }};
    --lx-bg: {{ section.settings.hero_bg | default: '#0a0a0a' }};
    --lx-duo: {{ section.settings.duotone_strength | divided_by: 100.0 }};
    --lx-shade: {{ section.settings.shade_strength | divided_by: 100.0 }};
    --lx-hfont: {{ section.settings.headline_font.family }}, 'Oswald', 'Arial Narrow', Impact, sans-serif;
    --lx-hw: {{ section.settings.headline_font.weight | default: 700 }};
    --lx-hsize: {{ section.settings.ed_headline_size }}px;
    --lx-ds: {{ section.settings.diamond_size }}px;
    --lx-dgap: {{ section.settings.diamond_gap }}px;
    --lx-drad: {{ section.settings.diamond_radius }}px;
    --lx-dcols: {{ dcols }};
    --lx-drows: {{ drows }};
    --lx-split: {{ section.settings.split_pct }}%;
    --lx-pt: {{ section.settings.pad_top }}px;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: {{ section.settings.ed_height }}px;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    background: var(--lx-bg);
    color: var(--lx-fg);
    font-family: var(--font);
    contain: paint;
  }
  #lxh-{{ sid }} *, #lxh-{{ sid }} *::before, #lxh-{{ sid }} *::after { box-sizing: border-box; }

  /* Backdrop: photo -> greyscale -> accent duotone -> shade for contrast */
  #lxh-{{ sid }} .lxh-bd { position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: -3; }
  #lxh-{{ sid }} .lxh-bd img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: grayscale(1) contrast(1.15) brightness(.8);
    transform: scale(1.04);
  }
  #lxh-{{ sid }} .lxh-tone {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: -2; pointer-events: none;
    background: linear-gradient(135deg, var(--lx-accent) 0%, var(--lx-accent-2) 55%, #000 100%);
    mix-blend-mode: color; opacity: var(--lx-duo);
  }
  #lxh-{{ sid }} .lxh-shade {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: -2; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.7) 38%, rgba(0,0,0,.25) 70%, rgba(0,0,0,.45) 100%),
      linear-gradient(0deg, rgba(0,0,0,.85) 0%, rgba(0,0,0,0) 30%);
    opacity: var(--lx-shade);
  }
  /* Wordmark texture */
  #lxh-{{ sid }} .lxh-wm {
    position: absolute; z-index: -1; pointer-events: none; user-select: none;
    left: -2%; top: 50%;
    transform: translateY(-50%) rotate(-7deg) skewX(-12deg);
    font-family: var(--lx-hfont); font-weight: 900; font-style: italic;
    font-size: clamp(160px, 34vw, 560px); line-height: .8; letter-spacing: -.04em;
    text-transform: uppercase; white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,.10);
    text-shadow: 0 0 22px rgba(255,255,255,.06), 6px 6px 0 rgba(255,255,255,.03);
    opacity: {{ section.settings.wordmark_opacity | divided_by: 100.0 }};
    filter: blur(.4px);
  }

  /* Meta row */
  #lxh-{{ sid }} .lxh-meta {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: var(--lx-pt) clamp(20px, 4vw, 64px) 0;
    font-size: 10px; letter-spacing: .32em; text-transform: uppercase; line-height: 1.4;
    color: var(--lx-fg); opacity: .72;
  }
  #lxh-{{ sid }} .lxh-meta span:nth-child(2) { flex: 1; text-align: center; }

  /* Body: content + diamond zone */
  #lxh-{{ sid }} .lxh-body { position: relative; flex: 1 1 auto; display: flex; align-items: center; min-height: 0; }
  #lxh-{{ sid }} .lxh-content {
    position: relative; z-index: 2;
    width: calc(100% - var(--lx-split)); max-width: 760px;
    padding: 28px clamp(20px, 4vw, 64px) 32px;
    display: flex; flex-direction: column; align-items: flex-start; gap: 18px;
  }
  #lxh-{{ sid }} .lxh-eyebrow {
    margin: 0; display: inline-flex; align-items: center; gap: 10px;
    font-size: 11px; font-weight: 700; letter-spacing: .34em; text-transform: uppercase; color: var(--lx-accent);
  }
  #lxh-{{ sid }} .lxh-eyebrow::before { content: ''; width: 22px; height: 2px; background: currentColor; }
  #lxh-{{ sid }} .lxh-h {
    margin: 0; font-family: var(--lx-hfont); font-weight: var(--lx-hw);
    font-size: clamp(48px, 8.4vw, var(--lx-hsize)); line-height: .9; letter-spacing: -.005em;
    text-transform: uppercase; color: var(--lx-fg);
    overflow-wrap: anywhere; font-stretch: condensed;
  }
  #lxh-{{ sid }} .lxh-h .w { display: inline; }
  #lxh-{{ sid }}.is-stacked .lxh-h .w { display: block; }
  #lxh-{{ sid }} .lxh-h .is-accent { color: var(--lx-accent); }
  #lxh-{{ sid }} .lxh-h sup {
    font-family: var(--font); font-size: max(11px, .14em); font-weight: 600; letter-spacing: .12em;
    vertical-align: top; position: relative; top: .5em; margin-left: .35em; color: var(--lx-fg); opacity: .85;
  }
  #lxh-{{ sid }} .lxh-sub { margin: 0; max-width: 46ch; font-size: 15px; line-height: 1.55; color: var(--lx-fg); opacity: .82; }
  #lxh-{{ sid }} .lxh-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  #lxh-{{ sid }} .lxh-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 26px;
    font-family: var(--font); font-size: 11px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase;
    text-decoration: none; cursor: pointer; border-radius: {{ section.settings.button_radius }}px;
    transition: background .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  #lxh-{{ sid }} .lxh-btn--solid { background: var(--lx-accent); color: {{ section.settings.accent_text_color }}; border: 1px solid var(--lx-accent); }
  #lxh-{{ sid }} .lxh-btn--solid:hover { background: var(--lx-accent-2); border-color: var(--lx-accent-2); }
  #lxh-{{ sid }} .lxh-btn--ghost { background: transparent; color: var(--lx-fg); border: 1px solid rgba(255,255,255,.7); }
  #lxh-{{ sid }} .lxh-btn--ghost:hover { background: var(--lx-fg); color: var(--lx-bg); border-color: var(--lx-fg); }
  #lxh-{{ sid }} .lxh-btn:focus-visible, #lxh-{{ sid }} .lxh-arrow:focus-visible, #lxh-{{ sid }} .lxh-view:focus-visible { outline: 2px solid var(--lx-accent); outline-offset: 3px; }

  /* Diamond zone */
  #lxh-{{ sid }} .lxh-media { position: absolute; top: 0; right: 0; bottom: 0; width: var(--lx-split); overflow: hidden; z-index: 1; }
  #lxh-{{ sid }} .lxh-dg {
    position: absolute; top: 50%; left: 50%;
    display: grid;
    grid-template-columns: repeat(var(--lx-dcols), var(--lx-ds));
    grid-auto-rows: var(--lx-ds);
    gap: var(--lx-dgap);
    transform: translate(-50%, -50%) rotate(45deg);
  }
  #lxh-{{ sid }} .lxh-dc {
    position: relative; overflow: hidden; border-radius: var(--lx-drad);
    background: rgba(255,255,255,.04); outline: 1px solid rgba(255,255,255,.12); outline-offset: -1px;
  }
  #lxh-{{ sid }} .lxh-dc img {
    position: absolute; top: 50%; left: 50%; width: 142%; height: 142%; max-width: none; object-fit: cover; display: block;
    transform: translate(-50%, -50%) rotate(-45deg);
    transition: transform .6s cubic-bezier(.2,.7,.2,1), filter .4s ease;
  }
  #lxh-{{ sid }} .lxh-dc:hover img { transform: translate(-50%, -50%) rotate(-45deg) scale(1.08); }
  #lxh-{{ sid }} .lxh-dc.is-feature { outline: 2px solid var(--lx-accent); }
  /* Fill style: classic edge-to-edge grid */
  #lxh-{{ sid }}.is-fill .lxh-dg {
    top: -120px; left: -120px; right: -120px; bottom: -120px; transform: rotate(45deg);
    grid-template-columns: repeat(var(--lx-dcols), 1fr); grid-template-rows: repeat(var(--lx-drows), 1fr); grid-auto-rows: auto;
  }
  #lxh-{{ sid }}.is-fill .lxh-dc { outline: 0; }

  /* Bottom bar */
  #lxh-{{ sid }} .lxh-foot {
    position: relative; z-index: 2;
    display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
    padding: 0 clamp(20px, 4vw, 64px) 28px;
  }
  #lxh-{{ sid }} .lxh-side { margin: 0; max-width: 300px; font-size: 10px; line-height: 1.7; letter-spacing: .22em; text-transform: uppercase; opacity: .7; }
  #lxh-{{ sid }} .lxh-count { display: flex; align-items: center; gap: 16px; margin-left: auto; }
  #lxh-{{ sid }} .lxh-count small { display: block; font-size: 10px; letter-spacing: .3em; text-transform: uppercase; opacity: .65; }
  #lxh-{{ sid }} .lxh-view {
    color: var(--lx-fg); text-decoration: none; font-size: 12px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase;
    border-bottom: 2px solid var(--lx-accent); padding-bottom: 3px;
  }
  #lxh-{{ sid }} .lxh-arrow {
    flex: 0 0 auto; width: 56px; height: 56px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid rgba(255,255,255,.55); background: rgba(0,0,0,.35); color: var(--lx-fg);
    cursor: pointer; transition: background .2s ease, border-color .2s ease, transform .2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  #lxh-{{ sid }} .lxh-arrow:hover { background: var(--lx-accent); border-color: var(--lx-accent); color: {{ section.settings.accent_text_color }}; transform: translateY(2px); }
  #lxh-{{ sid }} .lxh-arrow svg { width: 18px; height: 18px; }

  @media (max-width: 989px) and (min-width: 769px) {
    #lxh-{{ sid }} { --lx-ds: {{ section.settings.diamond_size | times: 0.8 | round }}px; }
  }
  @media (max-width: 768px) {
    #lxh-{{ sid }} {
      min-height: 0;
      --lx-ds: {{ section.settings.diamond_size_mobile }}px;
      --lx-dgap: {{ section.settings.diamond_gap | times: 0.7 | round }}px;
      --lx-pt: {{ section.settings.pad_top_mobile }}px;
    }
    #lxh-{{ sid }} .lxh-meta { font-size: 9px; letter-spacing: .24em; padding-left: 20px; padding-right: 20px; }
    #lxh-{{ sid }} .lxh-meta span:nth-child(2) { display: none; }
    #lxh-{{ sid }} .lxh-body { flex-direction: column; align-items: stretch; }
    #lxh-{{ sid }} .lxh-content { width: 100%; max-width: none; padding: 20px 20px 8px; gap: 14px; }
    #lxh-{{ sid }} .lxh-h { font-size: clamp(44px, 15vw, 76px); }
    #lxh-{{ sid }} .lxh-sub { font-size: 14px; }
    #lxh-{{ sid }} .lxh-ctas { width: 100%; }
    #lxh-{{ sid }} .lxh-btn { flex: 1 1 140px; padding: 0 14px; }
    #lxh-{{ sid }} .lxh-media { position: relative; width: 100%; height: {{ section.settings.grid_height_mobile }}px; }
    #lxh-{{ sid }} .lxh-shade {
      background: linear-gradient(180deg, rgba(0,0,0,.88) 0%, rgba(0,0,0,.72) 50%, rgba(0,0,0,.35) 75%, rgba(0,0,0,.85) 100%);
    }
    #lxh-{{ sid }} .lxh-wm { top: 34%; font-size: 52vw; }
    #lxh-{{ sid }} .lxh-foot { flex-wrap: wrap; padding: 16px 20px 22px; gap: 14px; }
    #lxh-{{ sid }} .lxh-side { max-width: none; flex: 1 1 100%; }
    #lxh-{{ sid }} .lxh-count { margin-left: 0; width: 100%; justify-content: space-between; }
    #lxh-{{ sid }} .lxh-arrow { width: 48px; height: 48px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #lxh-{{ sid }} .lxh-dc img, #lxh-{{ sid }} .lxh-btn, #lxh-{{ sid }} .lxh-arrow { transition: none; }
  }
  {%- endif -%}
</style>


<div id="chc-{{ sid }}">

  {%- if hero_style == 'editorial' -%}
  <!-- ══ EDITORIAL HERO (LEXE 2026-10-09) ═════════════════════ -->
  <link rel="preload" as="font" href="{{ section.settings.headline_font | font_url }}" type="font/woff2" crossorigin>
  <div id="lxh-{{ sid }}" data-lxh class="lxh{% if section.settings.stack_words %} is-stacked{% endif %}{% if section.settings.diamond_style == 'fill' %} is-fill{% endif %}">

    {%- if ed_bd != blank -%}
      <div class="lxh-bd" aria-hidden="true">
        <img
          src="{{ ed_bd | image_url: width: 1600 }}"
          srcset="{{ ed_bd | image_url: width: 750 }} 750w, {{ ed_bd | image_url: width: 1200 }} 1200w, {{ ed_bd | image_url: width: 1600 }} 1600w, {{ ed_bd | image_url: width: 2200 }} 2200w"
          sizes="100vw"
          width="1600"
          height="{{ 1600 | divided_by: ed_bd.aspect_ratio | ceil }}"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async">
      </div>
    {%- endif -%}
    <div class="lxh-tone" aria-hidden="true"></div>
    <div class="lxh-shade" aria-hidden="true"></div>
    {%- if section.settings.show_wordmark and section.settings.wordmark_text != blank -%}
      <div class="lxh-wm" aria-hidden="true">{{ section.settings.wordmark_text | escape }}</div>
    {%- endif -%}

    {%- if section.settings.show_meta -%}
      <div class="lxh-meta">
        <span>[ {{ section.settings.meta_left | default: 'Collection' | escape }} ]</span>
        <span>{{ section.settings.meta_center | escape }}</span>
        <span>{% if ed_num != blank %}[ {{ ed_num | escape }} ]{% endif %}</span>
      </div>
    {%- endif -%}

    <div class="lxh-body">
      <div class="lxh-content">
        {%- if section.settings.show_eyebrow and section.settings.promo_eyebrow != blank -%}
          <p class="lxh-eyebrow">{{ section.settings.promo_eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_headline -%}
          {%- if template.name == 'collection' -%}<h1 class="lxh-h">{%- else -%}<h2 class="lxh-h">{%- endif -%}
            {%- for w in ed_words -%}
              {%- liquid
                assign is_acc = false
                if ed_accent_mode == 'last' and forloop.last and ed_wcount > 1
                  assign is_acc = true
                elsif ed_accent_mode == 'last' and ed_wcount == 1
                  assign is_acc = false
                elsif ed_accent_mode == 'first' and forloop.first
                  assign is_acc = true
                elsif ed_accent_mode == 'line2' and forloop.index > ed_tcount
                  assign is_acc = true
                elsif ed_accent_mode == 'title' and forloop.index <= ed_tcount
                  assign is_acc = true
                elsif ed_accent_mode == 'custom' and ed_accent_custom != blank
                  assign wu = w | upcase | remove: ',' | remove: '.'
                  if ed_accent_custom contains wu
                    assign is_acc = true
                  endif
                endif
              -%}
              <span class="w{% if is_acc %} is-accent{% endif %}">{{ w | escape }}{% if forloop.last and section.settings.show_number and ed_num != blank %}<sup>{{ ed_num | escape }}&trade;</sup>{% endif %}</span>{% unless forloop.last %} {% endunless %}
            {%- endfor -%}
          {%- if template.name == 'collection' -%}</h1>{%- else -%}</h2>{%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_subline and ed_sub != blank -%}
          <p class="lxh-sub">{{ ed_sub | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_btn1 or section.settings.show_btn2 -%}
          <div class="lxh-ctas">
            {%- if section.settings.show_btn1 and section.settings.hero_cta_label != blank -%}
              {%- if ed_btn1_url != blank -%}
                <a class="lxh-btn lxh-btn--solid" href="{{ ed_btn1_url }}">{{ section.settings.hero_cta_label | escape }}</a>
              {%- else -%}
                <button type="button" class="lxh-btn lxh-btn--solid" data-chc-scroll>{{ section.settings.hero_cta_label | escape }}</button>
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.show_btn2 and section.settings.btn2_label != blank -%}
              <a class="lxh-btn lxh-btn--ghost" href="{{ ed_btn2_url }}">{{ section.settings.btn2_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_grid -%}
      <div class="lxh-media" aria-hidden="true">
        {%- if section.settings.hero_layout == 'image' and hero_img != blank -%}
          <div class="chc-simg-{{ sid }}">
            <img src="{{ hero_img | image_url: width: 1200 }}" srcset="{{ hero_img | image_url: width: 640 }} 640w, {{ hero_img | image_url: width: 1200 }} 1200w" sizes="(max-width: 768px) 100vw, {{ section.settings.split_pct }}vw" width="1200" height="{{ 1200 | divided_by: hero_img.aspect_ratio | ceil }}" alt="" loading="eager" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block">
          </div>
        {%- else -%}
          <div class="lxh-dg">
            {%- assign dfilled = 0 -%}
            {%- if active_col != nil and active_col.products.size > 0 -%}
              {%- assign psize = active_col.products.size -%}
              {%- for i in (0..dlast) -%}
                {%- if i >= psize and section.settings.diamond_repeat == false -%}{%- break -%}{%- endif -%}
                {%- assign pi = i | modulo: psize -%}
                {%- assign dp = active_col.products[pi] -%}
                {%- assign dfilled = dfilled | plus: 1 -%}
                <div class="lxh-dc{% if i == 0 and section.settings.diamond_feature %} is-feature{% endif %}">
                  {%- if dp.featured_image != blank -%}
                    <img src="{{ dp.featured_image | image_url: width: 480 }}" srcset="{{ dp.featured_image | image_url: width: 320 }} 320w, {{ dp.featured_image | image_url: width: 480 }} 480w" sizes="{{ section.settings.diamond_size | times: 1.5 | round }}px" width="480" height="{{ 480 | divided_by: dp.featured_image.aspect_ratio | ceil }}" alt="" loading="{% if dfilled <= 4 %}eager{% else %}lazy{% endif %}" decoding="async">
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- comment -%} No active collection: use block images / block collections round-robin {%- endcomment -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'carousel_card' and block.settings.image != blank and dfilled < dcount -%}
                  {%- assign dfilled = dfilled | plus: 1 -%}
                  <div class="lxh-dc"><img src="{{ block.settings.image | image_url: width: 480 }}" width="480" height="{{ 480 | divided_by: block.settings.image.aspect_ratio | ceil }}" alt="" loading="{% if dfilled <= 4 %}eager{% else %}lazy{% endif %}" decoding="async"></div>
                {%- endif -%}
              {%- endfor -%}
              {%- for block in section.blocks -%}
                {%- if dfilled >= dcount -%}{%- break -%}{%- endif -%}
                {%- if block.type == 'carousel_card' and block.settings.image == blank and block.settings.collection != blank -%}
                  {%- for dp in collections[block.settings.collection].products limit: 3 -%}
                    {%- if dfilled >= dcount -%}{%- break -%}{%- endif -%}
                    {%- if dp.featured_image != blank -%}
                      {%- assign dfilled = dfilled | plus: 1 -%}
                      <div class="lxh-dc"><img src="{{ dp.featured_image | image_url: width: 480 }}" width="480" height="{{ 480 | divided_by: dp.featured_image.aspect_ratio | ceil }}" alt="" loading="{% if dfilled <= 4 %}eager{% else %}lazy{% endif %}" decoding="async"></div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if dfilled < dcount -%}
              {%- assign dempty = dcount | minus: dfilled -%}
              {%- for e in (1..dempty) -%}<div class="lxh-dc"></div>{%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_side_copy or section.settings.show_count or section.settings.show_arrow -%}
      <div class="lxh-foot">
        {%- if section.settings.show_side_copy and section.settings.side_copy != blank -%}
          <p class="lxh-side">{{ section.settings.side_copy | escape | newline_to_br }}</p>
        {%- endif -%}
        <div class="lxh-count">
          {%- if section.settings.show_count -%}
            <div>
              {%- if ed_count > 0 -%}<small>{{ ed_count }} {{ section.settings.count_label | default: 'pieces' | escape }}</small>{%- endif -%}
              <a class="lxh-view" href="{{ ed_view_url }}" data-lxh-view>{{ section.settings.view_all_label | default: 'View all' | escape }} &rarr;</a>
            </div>
          {%- endif -%}
          {%- if section.settings.show_arrow -%}
            <button type="button" class="lxh-arrow" data-chc-scroll aria-label="Scroll to products">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
            </button>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
  {%- else -%}
  <!-- ══ HERO BANNER ══════════════════════════════════════════ -->
  <div class="chc-hero-{{ sid }}">

    <!-- Left: imagery zone -->
    <div class="chc-media-{{ sid }}">

      {%- if section.settings.hero_layout == 'grid' and active_col != nil and active_col.products.size > 0 -%}
        {%- comment -%}
          ON A COLLECTION PAGE — pull up to 9 product images from that collection.
          Simple for loop avoids variable-index access which breaks beyond page 1.
          Fewer than 9 products → remaining cells show hero_bg (dark frame, intentional).
        {%- endcomment -%}
        <div class="chc-dgrid-{{ sid }}" aria-hidden="true">
          {%- assign grid_filled = 0 -%}
          {%- for prod in active_col.products limit: 9 -%}
            {%- assign grid_filled = grid_filled | plus: 1 -%}
            <div class="chc-dcell-{{ sid }}">
              {%- if prod.featured_image != blank -%}
                <img
                  src="{{ prod.featured_image | image_url: width: 420 }}"
                  width="420"
                  height="{{ 420 | divided_by: prod.featured_image.aspect_ratio | ceil }}"
                  alt="{{ prod.featured_image.alt | default: prod.title | escape }}"
                  loading="{% if forloop.index <= 3 %}eager{% else %}lazy{% endif %}"
                  decoding="async">
              {%- endif -%}
            </div>
          {%- endfor -%}
          {%- if grid_filled < 9 -%}
            {%- assign empty_cells = 9 | minus: grid_filled -%}
            {%- for e in (1..empty_cells) -%}
              <div class="chc-dcell-{{ sid }}"></div>
            {%- endfor -%}
          {%- endif -%}
        </div>

      {%- elsif section.settings.hero_layout == 'grid' and render_blocks -%}
        {%- comment -%}
          FALLBACK GRID — no active collection (e.g. /collections page, homepage).
          Blocks with a custom image get one fixed cell each.
          Blocks with a collection share the remaining cells via ROUND-ROBIN:
          round 0 takes product #1 from every selected collection, round 1 takes
          product #2 from every selected collection, and so on, until 9 cells are
          filled. This keeps representation equal regardless of how many
          collections are selected (1 collection fills all 9 from itself; 5
          collections contribute roughly 2 each) instead of hard-capping each
          collection at a fixed count and leaving cells empty.
        {%- endcomment -%}
        <div class="chc-dgrid-{{ sid }}" aria-hidden="true">
          {%- assign grid_filled = 0 -%}

          {%- comment %} Fixed-image blocks claim their cell first. {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'carousel_card' and block.settings.image != blank and grid_filled < 9 -%}
              {%- assign grid_filled = grid_filled | plus: 1 -%}
              <div class="chc-dcell-{{ sid }}">
                <img
                  src="{{ block.settings.image | image_url: width: 420 }}"
                  width="420"
                  height="{{ 420 | divided_by: block.settings.image.aspect_ratio | ceil }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="{% if grid_filled <= 3 %}eager{% else %}lazy{% endif %}"
                  decoding="async">
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- comment %} Build the list of collection-sourced blocks (skip ones that already used a custom image). {%- endcomment -%}
          {%- assign grid_col_handles = '' -%}
          {%- assign grid_col_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'carousel_card' and block.settings.image == blank and block.settings.collection != blank -%}
              {%- assign grid_col_count = grid_col_count | plus: 1 -%}
              {%- if grid_col_handles == '' -%}
                {%- assign grid_col_handles = block.settings.collection -%}
              {%- else -%}
                {%- assign grid_col_handles = grid_col_handles | append: ',' | append: block.settings.collection -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign grid_col_list = grid_col_handles | split: ',' -%}

          {%- if grid_col_count > 0 and grid_filled < 9 -%}
            {%- assign grid_col_count_m1 = grid_col_count | minus: 1 -%}
            {%- for grid_round in (0..8) -%}
              {%- if grid_filled >= 9 -%}{%- break -%}{%- endif -%}
              {%- for grid_ci in (0..grid_col_count_m1) -%}
                {%- if grid_filled >= 9 -%}{%- break -%}{%- endif -%}
                {%- assign grid_prod = collections[grid_col_list[grid_ci]].products[grid_round] -%}
                {%- if grid_prod != blank and grid_prod.featured_image != blank -%}
                  {%- assign grid_filled = grid_filled | plus: 1 -%}
                  <div class="chc-dcell-{{ sid }}">
                    <img
                      src="{{ grid_prod.featured_image | image_url: width: 420 }}"
                      width="420"
                      height="{{ 420 | divided_by: grid_prod.featured_image.aspect_ratio | ceil }}"
                      alt="{{ grid_prod.featured_image.alt | default: grid_prod.title | escape }}"
                      loading="{% if grid_filled <= 3 %}eager{% else %}lazy{% endif %}"
                      decoding="async">
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if grid_filled < 9 -%}
            {%- assign empty_cells = 9 | minus: grid_filled -%}
            {%- for e in (1..empty_cells) -%}
              <div class="chc-dcell-{{ sid }}"></div>
            {%- endfor -%}
          {%- endif -%}
        </div>

      {%- elsif hero_img != blank -%}
        <div class="chc-simg-{{ sid }}">
          <img
            src="{{ hero_img | image_url: width: 1200 }}"
            width="1200"
            height="{{ 1200 | divided_by: hero_img.aspect_ratio | ceil }}"
            srcset="{{ hero_img | image_url: width: 640 }} 640w,
                    {{ hero_img | image_url: width: 1200 }} 1200w"
            sizes="{{ section.settings.split_pct }}vw"
            alt="{{ hero_img.alt | escape }}"
            loading="eager"
            fetchpriority="high"
            decoding="async">
        </div>

      {%- else -%}
        <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:#111;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;opacity:.35;">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

    </div>

    <!-- Right: promo overlay -->
    <div class="chc-promo-{{ sid }}">

      {%- if section.settings.promo_bg_image != blank -%}
        <div class="chc-promo-bg-{{ sid }}" aria-hidden="true">
          <img
            src="{{ section.settings.promo_bg_image | image_url: width: 900 }}"
            width="900"
            height="{{ 900 | divided_by: section.settings.promo_bg_image.aspect_ratio | ceil }}"
            alt=""
            loading="eager"
            decoding="async">
        </div>
      {%- endif -%}

      {%- if section.settings.promo_eyebrow != blank -%}
        <p class="chc-eyebrow-{{ sid }}">{{ section.settings.promo_eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.promo_headline != blank -%}
        <p class="chc-headline-{{ sid }}">{{ section.settings.promo_headline }}</p>
      {%- endif -%}

      {%- if section.settings.promo_sub != blank -%}
        <div class="chc-rule-{{ sid }}"></div>
        <p class="chc-sub-{{ sid }}">{{ section.settings.promo_sub }}</p>
      {%- endif -%}

      {%- if section.settings.hero_cta_label != blank -%}
        <button type="button" class="chc-btn-{{ sid }}" data-chc-scroll>
          {{- section.settings.hero_cta_label -}}
        </button>
      {%- endif -%}

    </div>

  </div><!-- /hero -->
  {%- endif -%}


  <!-- ══ CARD CAROUSEL ════════════════════════════════════════ -->
  {%- if card_count > 0 -%}
  <div class="chc-cwrap-{{ sid }}" data-chc-wrap>
    <div class="chc-track-{{ sid }}" data-chc-track>

      {%- assign cv_int = section.settings.cards_visible -%}

      {%- if render_blocks -%}
        {%- assign block_idx = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'carousel_card' -%}
            {%- liquid
              assign ci = block.settings.image
              assign cu = block.settings.link
              assign cl = block.settings.label
              if block.settings.collection != blank
                assign bc = collections[block.settings.collection]
                if ci == blank and bc.featured_image != blank
                  assign ci = bc.featured_image
                endif
                if cu == blank
                  assign cu = bc.url
                endif
                if cl == blank
                  assign cl = bc.title
                endif
              endif
              assign block_idx = block_idx | plus: 1
            -%}
            <a href="{{ cu | default: '#' }}" class="chc-card-{{ sid }}" {{ block.shopify_attributes }}>
              <div class="chc-card-inner-{{ sid }}">
                {%- if ci != blank -%}
                  <img
                    src="{{ ci | image_url: width: 600 }}"
                    width="600"
                    height="{{ 600 | divided_by: ci.aspect_ratio | ceil }}"
                    alt="{{ ci.alt | default: cl | escape }}"
                    loading="{% if block_idx <= cv_int %}eager{% else %}lazy{% endif %}"
                    decoding="async">
                {%- else -%}
                  <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:#222;"></div>
                {%- endif -%}
                {%- if cl != blank -%}
                  <div class="chc-clabel-{{ sid }}">{{ cl }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if source_mode != 'blocks' and active_col != nil -%}
        {%- assign auto_idx = 0 -%}
        {%- for prod in active_col.products limit: auto_limit -%}
          {%- if prod.featured_image != blank -%}
            {%- assign auto_idx = auto_idx | plus: 1 -%}
            <a href="{{ prod.url }}" class="chc-card-{{ sid }}">
              <div class="chc-card-inner-{{ sid }}">
                <img
                  src="{{ prod.featured_image | image_url: width: 600 }}"
                  width="600"
                  height="{{ 600 | divided_by: prod.featured_image.aspect_ratio | ceil }}"
                  alt="{{ prod.featured_image.alt | default: prod.title | escape }}"
                  loading="{% if auto_idx <= cv_int %}eager{% else %}lazy{% endif %}"
                  decoding="async">
                {%- if section.settings.show_card_label -%}
                  <div class="chc-clabel-{{ sid }}">{{ prod.title }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

    </div>

    {%- if section.settings.show_dots -%}
      <div class="chc-dots-{{ sid }}" data-chc-dots aria-hidden="true"></div>
    {%- endif -%}
  </div>
  {%- endif -%}

</div>


<script>
(function () {
  'use strict';

  var ROOT   = document.getElementById('chc-{{ sid }}');
  if (!ROOT)  return;

  /* ── CTA — scroll to the card carousel below ──────────────
     Placed before the carousel-existence guard so the button
     still works (falls back to scrolling one viewport) even
     on pages where no cards rendered. */
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var EDITORIAL = {{ hero_style | json }} === 'editorial';
  function chcTarget() {
    if (EDITORIAL) {
      var sec = ROOT.closest('.shopify-section');
      var nx = sec ? sec.nextElementSibling : null;
      while (nx && (nx.offsetHeight === 0 || nx.tagName === 'SCRIPT' || nx.tagName === 'STYLE')) nx = nx.nextElementSibling;
      if (nx) return nx;
    }
    return ROOT.querySelector('[data-chc-wrap]');
  }
  function chcGo(e) {
    if (e) e.preventDefault();
    var t = chcTarget();
    if (t && t.scrollIntoView) t.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    else window.scrollBy({ top: window.innerHeight, behavior: reduceMotion ? 'auto' : 'smooth' });
  }
  ROOT.querySelectorAll('[data-chc-scroll]').forEach(function (b) { b.addEventListener('click', chcGo); });
  var viewLink = ROOT.querySelector('[data-lxh-view]');
  if (viewLink) viewLink.addEventListener('click', function (e) {
    try { if (new URL(viewLink.href, location.href).pathname === location.pathname) chcGo(e); } catch (err) {}
  });

  var wrap   = ROOT.querySelector('[data-chc-wrap]');
  var track  = ROOT.querySelector('[data-chc-track]');
  var dotsEl = ROOT.querySelector('[data-chc-dots]');
  if (!wrap || !track) return;

  var N     = track.children.length;
  if (!N)   return;

  var DELAY = {{ section.settings.autoplay_delay }} * 1000;
  var GAP   = 6; /* px — matches --card-gap: 6px */
  var cur   = 0;
  var timer = null;
  var live  = false;
  var tsx   = 0;

  /* ── Helpers ───────────────────────────────────────────── */

  function getCV() {
    /* Read --cv from CSS so media-query breakpoints apply automatically */
    var v = getComputedStyle(ROOT).getPropertyValue('--cv');
    return parseFloat(v) || {{ section.settings.cards_visible }};
  }

  function maxI() {
    return Math.max(0, N - Math.floor(getCV()));
  }

  function setCardWidth() {
    /*
      Calculate card width in pixels and write it back as --card-w.
      This avoids the CSS calc(100% / var(--cv)) circular-reference
      problem in unsized flex containers (breaks in Safari).
    */
    var cv   = getCV();
    var w    = (wrap.offsetWidth - GAP * (Math.floor(cv) - 1)) / cv;
    ROOT.style.setProperty('--card-w', w.toFixed(2) + 'px');
    return w;
  }

  function goTo(i) {
    var cv = getCV();
    cur = Math.max(0, Math.min(i, maxI()));
    var w  = (wrap.offsetWidth - GAP * (Math.floor(cv) - 1)) / cv;
    track.style.transform = 'translateX(-' + (cur * (w + GAP)).toFixed(1) + 'px)';
    syncDots();
  }

  function next() { goTo(cur < maxI() ? cur + 1 : 0); }

  /* ── Timer ─────────────────────────────────────────────── */
  function startTimer() {
    clearInterval(timer);
    if (DELAY > 0 && live) timer = setInterval(next, DELAY);
  }
  function stopTimer() { clearInterval(timer); timer = null; }

  /* ── Dots ──────────────────────────────────────────────── */
  function buildDots() {
    if (!dotsEl) return;
    var pages = maxI() + 1;
    if (pages <= 1) { dotsEl.hidden = true; return; }
    dotsEl.hidden = false;
    var html = '';
    for (var i = 0; i < pages; i++) {
      html += '<button class="chc-dot-{{ sid }}" data-i="' + i +
              '" aria-label="Page ' + (i + 1) + '"></button>';
    }
    dotsEl.innerHTML = html;
    dotsEl.querySelectorAll('[data-i]').forEach(function (b) {
      b.addEventListener('click', function () {
        goTo(+this.dataset.i);
        stopTimer(); startTimer();
      });
    });
  }

  function syncDots() {
    if (!dotsEl) return;
    dotsEl.querySelectorAll('[data-i]').forEach(function (b, i) {
      b.classList.toggle('is-on', i === cur);
    });
  }

  /* ── Init ──────────────────────────────────────────────── */
  setCardWidth();
  buildDots();

  /* Position without animation on first paint */
  track.style.removeProperty('transition');
  goTo(0);
  requestAnimationFrame(function () {
    track.style.removeProperty('transition'); /* ensure CSS rule restored */
  });

  /* ── IntersectionObserver ──────────────────────────────── */
  new IntersectionObserver(function (entries) {
    live = entries[0].isIntersecting;
    live ? startTimer() : stopTimer();
  }, { threshold: 0.1 }).observe(wrap);

  /* ── Hover pause ───────────────────────────────────────── */
  wrap.addEventListener('mouseenter', stopTimer, { passive: true });
  wrap.addEventListener('mouseleave', function () {
    if (live) startTimer();
  }, { passive: true });

  /* ── Touch / swipe ─────────────────────────────────────── */
  wrap.addEventListener('touchstart', function (e) {
    tsx = e.touches[0].clientX;
    stopTimer();
  }, { passive: true });

  wrap.addEventListener('touchend', function (e) {
    var dx = e.changedTouches[0].clientX - tsx;
    if (Math.abs(dx) > 44) goTo(dx < 0 ? cur + 1 : cur - 1);
    if (live) startTimer();
  }, { passive: true });

  /* ── ResizeObserver ────────────────────────────────────────
     rAF defers read until after CSS recalculates --cv for the
     new breakpoint, preventing a stale mobile/desktop value.  */
  new ResizeObserver(function () {
    requestAnimationFrame(function () {
      track.style.removeProperty('transition'); /* snap without animation */
      setCardWidth();
      buildDots();
      goTo(Math.min(cur, maxI()));
      requestAnimationFrame(function () {
        track.style.removeProperty('transition');
      });
    });
  }).observe(wrap);

  /* ── Tab visibility ────────────────────────────────────── */
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopTimer();
    else if (live) startTimer();
  }, { passive: true });

  /* ── Shopify theme editor — reinit on section reload ────── */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === '{{ sid }}') {
      setCardWidth();
      buildDots();
      goTo(0);
    }
  });

})();
</script>


