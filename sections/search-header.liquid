{%- liquid
  assign sid = section.id
  assign q = search.terms | default: ''
-%}
<style>
#vsh{{ sid }}{
  position:sticky; top:0; z-index:40; background:#fff;
  padding:10px 12px 8px; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
}
.vsh-row{{ sid }}{display:flex; align-items:center; gap:8px; max-width:720px; margin:0 auto;}
.vsh-back{{ sid }}{
  width:36px; height:36px; border:0; background:transparent; color:#111;
  display:grid; place-items:center; text-decoration:none; flex-shrink:0;
}
.vsh-form{{ sid }}{flex:1; display:flex; align-items:center; min-width:0; height:40px;
  border:1px solid #111; border-radius:10px; overflow:hidden; background:#fff;}
.vsh-input{{ sid }}{flex:1; min-width:0; border:0; outline:0; height:40px; padding:0 12px; font-size:16px; background:transparent; -webkit-appearance:none;}
.vsh-go{{ sid }}{width:44px; height:40px; border:0; background:#111; color:#fff; display:grid; place-items:center; cursor:pointer; flex-shrink:0;}
.vsh-go{{ sid }} svg{width:16px; height:16px;}
</style>
<section id="vsh{{ sid }}">
  <div class="vsh-row{{ sid }}">
    <a class="vsh-back{{ sid }}" href="{{ routes.root_url }}" aria-label="Back">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </a>
    <form class="vsh-form{{ sid }}" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <input class="vsh-input{{ sid }}" type="search" name="q" value="{{ q | escape }}" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off" enterkeyhint="search" aria-label="Search">
      <button class="vsh-go{{ sid }}" type="submit" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.2-3.2"/></svg>
      </button>
    </form>
  </div>
</section>
<script>
(function(){
  var form=document.querySelector('#vsh{{ sid }} form');
  if(!form) return;
  form.addEventListener('submit',function(){
    var q=(form.querySelector('[name="q"]').value||'').trim();
    if(!q) return;
    try{
      var key='va-recent-search';
      var list=JSON.parse(localStorage.getItem(key)||'[]').filter(function(x){return x!==q;});
      list.unshift(q); localStorage.setItem(key, JSON.stringify(list.slice(0,16)));
    }catch(e){}
  });
})();
</script>
{% schema %}
{
  "name": "Vanquish search header",
  "tag": "section",
  "class": "va-search-header",
  "settings": [
    {"type":"text","id":"placeholder","label":"Placeholder","default":"Search"}
  ]
}
{% endschema %}
