{%- comment -%}
  PAGE TRANSITION (lightweight rewrite)
  ──────────────────────────────────────
  Install: add {% section 'page-transition' %} as the
  first line inside <body> in layout/theme.liquid

  Why the old version could hang the whole homepage:
  - "Solid colour" mode never actually set a background —
    only glass mode did — so the blocking overlay could be
    fully invisible while still eating every click/scroll.
  - Dismissal waited on window 'load', which only fires once
    EVERY resource on the page is done (third-party scripts,
    embeds, pixels...) with no maximum wait. One slow embed
    could hold the overlay up indefinitely.
  This version fixes both: the overlay always has a real
  background, and dismissal is bounded by a hard "Maximum
  display time" no matter what else is loading. A pure-CSS
  animation removes the overlay even if the script never
  runs, and a try/catch removes it if the script errors.
  The blinds/grid exit animation has been removed entirely.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign is_glass = false
  assign min_ms = section.settings.min_ms
  assign max_ms = section.settings.max_ms
  if min_ms > max_ms
    assign min_ms = max_ms
  endif
  assign failsafe_ms = max_ms | plus: 2000

  if section.settings.overlay_style == 'glass'
    assign is_glass = true
    assign bg_alpha = section.settings.bg_opacity | divided_by: 100.0
    assign glass_bg = section.settings.bg | color_modify: 'alpha', bg_alpha
    assign glass_edge = section.settings.bg | color_modify: 'alpha', 0.3
  endif

  assign font_stack = "'ui-sans-serif','system-ui',sans-serif"
  case section.settings.loading_font
    when 'mono'
      assign font_stack = "'ui-monospace','SFMono-Regular','Menlo','Consolas','Liberation Mono',monospace"
    when 'serif'
      assign font_stack = "'ui-serif','Georgia','Cambria','Times New Roman',serif"
    when 'rounded'
      assign font_stack = "'ui-rounded','system-ui',sans-serif"
    when 'theme'
      assign font_stack = "var(--font-heading-family,var(--font-body-family,sans-serif))"
  endcase
-%}

<style>
/* ─── Base overlay — always has a real background now ──── */
#pt-{{ sid }} {
  position: fixed;
  inset: 0;
  z-index: 9999;
  overflow: hidden;
  pointer-events: all;
  background: {{ section.settings.bg }};
  animation-name: pt-failsafe-{{ sid }};
  animation-duration: 1ms;
  animation-delay: {{ failsafe_ms }}ms;
  animation-fill-mode: forwards;
}

/* Pure-CSS safety net: if the script never runs at all
   (blocked, errors before it attaches, etc.) the overlay
   still disappears on its own — the page can never be
   permanently stuck behind it. */
@keyframes pt-failsafe-{{ sid }} {
  to { opacity: 0; visibility: hidden; }
}

{%- if is_glass -%}
@supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
  #pt-{{ sid }} {
    background: {{ glass_bg }};
    -webkit-backdrop-filter: blur({{ section.settings.blur_amount }}px) saturate(180%);
            backdrop-filter: blur({{ section.settings.blur_amount }}px) saturate(180%);
    box-shadow: inset 0 0 0 1px {{ glass_edge }};
  }
}
{%- endif -%}

/* ─── Slides ───────────────────────────────────────────── */
.pt-slide-{{ sid }} {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 260ms ease;
}
.pt-slide-{{ sid }}.on { opacity: 1; }
.pt-slide-{{ sid }} img { display: block; }

/* ─── Loading bar — CSS-driven, no per-frame JS math ────── */
#pt-bar-{{ sid }} {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 1px;
  z-index: 2;
  overflow: hidden;
  opacity: 1;
  transition: opacity 0.4s ease;
}
#pt-bar-f