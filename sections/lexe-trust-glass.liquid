      "default": "#9966CC"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "side_pad",
      "label": "Side spacing",
      "min": 0,
