{%- comment -%}
  LEXE Trust Banner (2026-10-17). Styles: Formal (default) and Glass.
  Formal: plain store assurance line. It names the store only and implies no endorsement by any
  government, regulator, bank or third party (no seals with text, no crests, no agency names).
  Desktop: one row. Phone: seamless CSS marquee or swipe. prefers-reduced-motion: swipe.
  Fixed height (no layout shift). No JS. Every message is a block: icon + text + optional link.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign formal = true
  if s.style == 'glass'
    assign formal = false
  endif
  assign n = 0
  for b in section.blocks
    if b.settings.text != blank
      assign n = n | plus: 1
    endif
  endfor
  assign label = s.label_text | strip
  assign show_label = false
  if formal and s.show_label and label != blank
    assign show_label = true
  endif
  assign reps = 1
  if n < 3
    assign reps = 3
  endif
  assign units = n
  if show_label
    assign units = n | plus: 1
  endif
  assign dur = s.speed | times: units | times: reps
  if dur < 12
    assign dur = 12
  endif
  assign tf = s.type_font
  assign tfw = tf
  assign tw = tf.weight
  if s.type_weight != 'font'
    assign tfm = tf | font_modify: 'weight', s.type_weight
    if tfm != nil
      assign tfw = tfm
    endif
    assign tw = s.type_weight
  endif
  if tf.system?
    assign fam = tf.family | downcase
    if fam contains 'mono'
      assign tstack = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace'
    elsif fam contains 'sans' or fam contains 'system'
      assign tstack = '"Helvetica Neue",Helvetica,Arial,system-ui,sans-serif'
    else
      assign tstack = '"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,"Times New Roman",serif'
    endif
  else
    assign tstack = tf.family | append: ', ' | append: tf.fallback_families
  endif
  if formal
    assign bar_h = s.formal_height
  else
    assign bar_h = s.height
  endif
-%}
{%- if n > 0 -%}
<style>
#ltg-{{ sid }}{--ltg-h:{{ bar_h }}px;}
#ltg-{{ sid }} .ltg-bar{position:relative;box-sizing:border-box;height:var(--ltg-h);overflow:hidden;contain:layout paint;display:flex;align-items:stretch;}
#ltg-{{ sid }} .ltg-list{list-style:none;margin:0;padding:0;display:flex;align-items:center;height:100%;}
#ltg-{{ sid }} .ltg-item{display:flex;align-items:center;flex:0 0 auto;white-space:nowrap;height:100%;}
#ltg-{{ sid }} .ltg-item a{color:inherit;text-decoration:none;display:flex;align-items:center;gap:inherit;height:100%;}
#ltg-{{ sid }} .ltg-ic{flex:0 0 auto;display:block;}
#ltg-{{ sid }} .ltg-ic img{width:100%;height:100%;object-fit:contain;display:block;}
#ltg-{{ sid }} .ltg-row{flex:1 1 auto;min-width:0;}
#ltg-{{ sid }} .ltg-mq{display:none;flex:1 1 auto;min-width:0;}
#ltg-{{ sid }} .ltg-track{display:flex;width:max-content;height:100%;}
{{ tfw | font_face: font_display: 'swap' }}
#ltg-{{ sid }} .ltg-bar{font-family:{{ tstack }};font-size:{{ s.type_size }}px;font-weight:{{ tw }};line-height:1;letter-spacing:{{ s.type_spacing | divided_by: 100.0 }}em;{% case s.type_transform %}{% when 'uppercase' %}text-transform:uppercase;font-variant-caps:normal;{% when 'small_caps' %}text-transform:none;font-variant-caps:all-small-caps;{% else %}text-transform:none;font-variant-caps:normal;{% endcase %}}
@keyframes ltg-{{ sid }}-x{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
{%- if formal %}
/* ── Formal ── */
#ltg-{{ sid }}{background:{{ s.page_bg }};padding:{{ s.formal_pad_y }}px 0;}
#ltg-{{ sid }} .ltg-bar{color:{{ s.formal_text }};background-color:{{ s.formal_bg }};
  --ltg-div:rgba(255,255,255,.18);--ltg-div:color-mix(in srgb,currentColor 20%,transparent);}
{%- if s.show_texture %}
#ltg-{{ sid }} .ltg-bar::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:{{ s.texture_opacity | divided_by: 100.0 }};
  background-image:repeating-linear-gradient(45deg,currentColor 0 1px,transparent 1px 7px),repeating-linear-gradient(-45deg,currentColor 0 1px,transparent 1px 7px),repeating-radial-gradient(circle at 50% 50%,transparent 0 9px,currentColor 9px 10px);}
{%- endif %}
#ltg-{{ sid }} .ltg-label,#ltg-{{ sid }} .ltg-row,#ltg-{{ sid }} .ltg-mq{position:relative;z-index:1;}
#ltg-{{ sid }} .ltg-label{display:flex;align-items:center;gap:10px;padding:0 clamp(14px,1.6vw,22px) 0 {{ s.label_left_pad }}px;flex:0 0 auto;white-space:nowrap;border-right:1px solid var(--ltg-div);}
#ltg-{{ sid }} .ltg-label .ltg-seal{width:{{ s.seal_size }}px;height:{{ s.seal_size }}px;color:{{ s.rule_color }};flex:0 0 auto;display:block;}
#ltg-{{ sid }} .ltg-label-t,#ltg-{{ sid }} .ltg-item--label .ltg-t{opacity:.72;}
#ltg-{{ sid }} .ltg-item{gap:8px;padding:0 clamp(12px,1.5vw,24px);}
#ltg-{{ sid }} .ltg-row .ltg-item + .ltg-item{border-left:1px solid var(--ltg-div);}
#ltg-{{ sid }} .ltg-item .ltg-item-sep{display:none;}
#ltg-{{ sid }} .ltg-row .ltg-item{height:56%;}
#ltg-{{ sid }} .ltg-ic{width:{{ s.type_size | plus: 2 }}px;height:{{ s.type_size | plus: 2 }}px;color:{{ s.rule_color }};}
#ltg-{{ sid }} .ltg-row{justify-content:space-evenly;}
#ltg-{{ sid }} .ltg-item a:hover .ltg-t,#ltg-{{ sid }} .ltg-item a:focus-visible .ltg-t{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px;text-decoration-color:currentColor;}
#ltg-{{ sid }} .ltg-item a:focus-visible{outline:1px solid currentColor;outline-offset:-3px;}
#ltg-{{ sid }} .ltg-item--label{display:none;}
@media (max-width:1299px){
  #ltg-{{ sid }} .ltg-bar{font-size:{{ s.type_size | minus: 1 }}px;letter-spacing:{{ s.type_spacing | times: 0.6 | divided_by: 100.0 }}em;}
  #ltg-{{ sid }} .ltg-row .ltg-item{padding:0 12px;}
  #ltg-{{ sid }} .ltg-label{gap:8px;padding:0 14px 0 {{ s.label_left_pad }}px;}
}
@media (max-width:{{ s.breakpoint }}px){
  #ltg-{{ sid }} .ltg-row{display:none;}
  #ltg-{{ sid }} .ltg-mq{display:block;height:100%;-webkit-mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);}
  #ltg-{{ sid }} .ltg-label{padding:0 12px 0 {{ s.label_left_pad }}px;}
  #ltg-{{ sid }} .ltg-label-t{display:none;}
  #ltg-{{ sid }} .ltg-item--label{display:flex;}
  #ltg-{{ sid }} .ltg-mq .ltg-item{padding:0 16px;position:relative;}
  #ltg-{{ sid }} .ltg-mq .ltg-item .ltg-item-sep{display:block;position:absolute;right:0;top:28%;bottom:28%;width:1px;background:var(--ltg-div);}
{%- else %}
/* ── Glass ── */
#ltg-{{ sid }}{--ltg-bg:{{ s.bg_color }};--ltg-fg:{{ s.text_color }};--ltg-ac:{{ s.accent_color }};--ltg-r:{{ s.radius }}px;padding:{{ s.pad_top }}px {{ s.side_pad }}px {{ s.pad_bottom }}px;background:{{ s.page_bg }};}
#ltg-{{ sid }} .ltg-bar{border-radius:var(--ltg-r);color:var(--ltg-fg);
  background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.015)),var(--ltg-bg);
  -webkit-backdrop-filter:blur(18px) saturate(150%);backdrop-filter:blur(18px) saturate(150%);
  }
#ltg-{{ sid }} .ltg-item{gap:9px;}
#ltg-{{ sid }} .ltg-item a:hover .ltg-t,#ltg-{{ sid }} .ltg-item a:focus-visible .ltg-t{text-decoration:underline;text-underline-offset:3px;text-decoration-color:currentColor;}
#ltg-{{ sid }} .ltg-item a:focus-visible{outline:2px solid currentColor;outline-offset:-2px;border-radius:8px;}
#ltg-{{ sid }} .ltg-ic{width:{{ s.icon_size }}px;height:{{ s.icon_size }}px;color:var(--ltg-ac);}
#ltg-{{ sid }} .ltg-t{opacity:.92;}
#ltg-{{ sid }} .ltg-item-sep{display:none;}
#ltg-{{ sid }} .ltg-dot{width:4px;height:4px;border-radius:50%;background:currentColor;opacity:.35;flex:0 0 auto;}
#ltg-{{ sid }} .ltg-row{justify-content:center;gap:clamp(18px,3vw,44px);padding:0 24px;}
#ltg-{{ sid }} .ltg-item--label{display:none;}
@media (max-width:{{ s.breakpoint }}px){
  #ltg-{{ sid }} .ltg-row{display:none;}
  #ltg-{{ sid }} .ltg-mq{display:block;height:100%;-webkit-mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);}
  #ltg-{{ sid }} .ltg-mq .ltg-item{padding-right:28px;gap:8px;}
  #ltg-{{ sid }} .ltg-mq .ltg-dot{margin-left:20px;}
{%- endif %}
  {%- if s.mobile_mode == 'marquee' %}
  #ltg-{{ sid }} .ltg-track{animation:ltg-{{ sid }}-x {{ dur }}s linear infinite;will-change:transform;}
  #ltg-{{ sid }} .ltg-mq:hover .ltg-track,#ltg-{{ sid }} .ltg-mq:active .ltg-track,#ltg-{{ sid }} .ltg-mq:focus-within .ltg-track{animation-play-state:paused;}
  {%- else %}
  #ltg-{{ sid }} .ltg-mq{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;}
  #ltg-{{ sid }} .ltg-mq::-webkit-scrollbar{display:none;}
  #ltg-{{ sid }} .ltg-mq .ltg-item{scroll-snap-align:start;}
  #ltg-{{ sid }} .ltg-clone{display:none;}
  {%- endif %}
}
@media (prefers-reduced-motion:reduce){
  #ltg-{{ sid }} .ltg-track{animation:none !important;}
  #ltg-{{ sid }} .ltg-mq{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;}
  #ltg-{{ sid }} .ltg-mq::-webkit-scrollbar{display:none;}
  #ltg-{{ sid }} .ltg-mq .ltg-item{scroll-snap-align:start;}
  #ltg-{{ sid }} .ltg-clone,#ltg-{{ sid }} .ltg-rep{display:none;}
}
</style>
<section id="ltg-{{ sid }}" class="ltg ltg--{% if formal %}formal{% else %}glass{% endif %}" aria-label="{{ s.aria_label | escape }}">
  <div class="ltg-bar ltg-glass">
    {%- if formal -%}
      <div class="ltg-label">
        {%- if s.show_seal -%}
          {%- render 'lexe-trust-icon', icon: s.seal_shape, class: 'ltg-seal', stroke: 1.3 -%}
        {%- endif -%}
        {%- if show_label -%}<span class="ltg-label-t">{{ label | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    {%- for pass in (1..3) -%}
      {%- if pass == 1 -%}<ul class="ltg-list ltg-row" role="list">{%- elsif pass == 2 -%}<div class="ltg-mq"><div class="ltg-track"><ul class="ltg-list" role="list">{%- else -%}<ul class="ltg-list ltg-clone" role="list" aria-hidden="true">{%- endif -%}
      {%- liquid
        assign r = 1
        if pass > 1 and s.mobile_mode == 'marquee'
          assign r = reps
        endif
      -%}
      {%- for k in (1..r) -%}
        {%- if pass > 1 and show_label -%}
          <li class="ltg-item ltg-item--label{% if k > 1 %} ltg-rep{% endif %}"><span class="ltg-t">{{ label | escape }}</span><span class="ltg-item-sep" aria-hidden="true"></span></li>
        {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
        <li class="ltg-item{% if k > 1 %} ltg-rep{% endif %}"{% if pass == 1 and k == 1 %} {{ block.shopify_attributes }}{% endif %}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"{% if pass == 3 %} tabindex="-1"{% endif %}>{%- endif -%}
          {%- assign show_ic = true -%}
          {%- if formal and s.formal_item_icons == false -%}{%- assign show_ic = false -%}{%- endif -%}
          {%- if show_ic and block.settings.custom_icon != blank -%}
            <span class="ltg-ic" aria-hidden="true">{{ block.settings.custom_icon | image_url: width: 64 | image_tag: width: 18, height: 18, alt: '', loading: 'lazy' }}</span>
          {%- elsif show_ic and block.settings.icon != 'none' -%}
            {%- if formal -%}{%- render 'lexe-trust-icon', icon: block.settings.icon, class: 'ltg-ic', stroke: 1.3 -%}{%- else -%}{%- render 'lexe-trust-icon', icon: block.settings.icon, class: 'ltg-ic', stroke: 1.6 -%}{%- endif -%}
          {%- endif -%}
          <span class="ltg-t">{{ block.settings.text | escape }}</span>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
          {%- if pass > 1 -%}
            {%- if formal -%}<span class="ltg-item-sep" aria-hidden="true"></span>{%- elsif s.show_dots -%}<span class="ltg-dot" aria-hidden="true"></span>{%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- endfor -%}
      {%- if pass == 1 -%}</ul>{%- elsif pass == 2 -%}</ul>{%- else -%}</ul></div></div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Trust banner",
  "tag": "div",
  "class": "section-lexe-trust-glass",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "formal",
      "options": [
        {
          "value": "formal",
          "label": "Formal"
        },
        {
          "value": "glass",
          "label": "Glass"
        }
      ]
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Label for screen readers",
      "default": "Store promises"
    },
    {
      "type": "color",
      "id": "page_bg",
      "label": "Background around the banner",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Type (label and messages)"
    },
    {
      "type": "font_picker",
      "id": "type_font",
      "label": "Font",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "type_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "type_weight",
      "label": "Weight",
      "default": "font",
      "options": [
        {
          "value": "font",
          "label": "As picked in Font"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "info": "If the font has no file for that weight, the picked weight is used."
    },
    {
      "type": "range",
      "id": "type_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 11,
      "info": "In hundredths of an em"
    },
    {
      "type": "select",
      "id": "type_transform",
      "label": "Letter case",
      "default": "small_caps",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "small_caps",
          "label": "Small caps"
        }
      ]
    },
    {
      "type": "header",
      "content": "Formal style"
    },
    {
      "type": "paragraph",
      "content": "Keep it the store's own promise: no crests, flags, seals with words, or 'official', 'certified', 'verified', 'approved' or agency/bank names. Only the icons take a colour."
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show left label",
      "default": true
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Left label (name the store)",
      "default": "LEXE by Devici Studios — Customer Assurance"
    },
    {
      "type": "checkbox",
      "id": "show_seal",
      "label": "Show plain outline icon",
      "default": true
    },
    {
      "type": "select",
      "id": "seal_shape",
