{%- comment -%}
  LEXE Trust Banner (2026-10-17). Styles: Formal (default) and Glass.
  Formal: plain store assurance line. It names the store only and implies no endorsement by any
  government, regulator, bank or third party (no seals with text, no crests, no agency names).
  Desktop: one row. Phone: seamless CSS marquee or swipe. prefers-reduced-motion: swipe.
  Fixed height (no layout shift). No JS. Every message is a block: icon + text + optional link.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign formal = true
  if s.style == 'glass'
    assign formal = false
  endif
  assign n = 0
  for b in section.blocks
    if b.settings.text != blank
      assign n = n | plus: 1
    endif
  endfor
  assign label = s.label_text | strip
  assign show_label = false
  if formal and s.show_label and label != blank
    assign show_label = true
  endif
  assign reps = 1
  if n < 3
    assign reps = 3
  endif
  assign units = n
  if show_label
    assign units = n | plus: 1
  endif
  assign dur = s.speed | times: units | times: reps
  if dur < 12
    assign dur = 12
  endif
  if formal
    assign bar_h = s.formal_height
  else
    assign bar_h = s.height
  endif
-%}
{%- if n > 0 -%}
<style>
#ltg-{{ sid }}{--ltg-h:{{ bar_h }}px;}
#ltg-{{ sid }} .ltg-bar{position:relative;box-sizing:border-box;height:var(--ltg-h);overflow:hidden;contain:layout paint;display:flex;align-items:stretch;}
#ltg-{{ sid }} .ltg-list{list-style:none;margin:0;padding:0;display:flex;align-items:center;height:100%;}
#ltg-{{ sid }} .ltg-item{display:flex;align-items:center;flex:0 0 auto;white-space:nowrap;height:100%;}
#ltg-{{ sid }} .ltg-item a{color:inherit;text-decoration:none;display:flex;align-items:center;gap:inherit;height:100%;}
#ltg-{{ sid }} .ltg-ic{flex:0 0 auto;display:block;}
#ltg-{{ sid }} .ltg-ic img{width:100%;height:100%;object-fit:contain;display:block;}
#ltg-{{ sid }} .ltg-row{flex:1 1 auto;min-width:0;}
#ltg-{{ sid }} .ltg-mq{display:none;flex:1 1 auto;min-width:0;}
#ltg-{{ sid }} .ltg-track{display:flex;width:max-content;height:100%;}
@keyframes ltg-{{ sid }}-x{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
{%- if formal %}
/* ── Formal ── */
#ltg-{{ sid }}{background:{{ s.page_bg }};padding:{{ s.formal_pad_y }}px 0;}
#ltg-{{ sid }} .ltg-bar{color:{{ s.formal_text }};background-color:{{ s.formal_bg }};
  border-top:1px solid {{ s.rule_color }};border-bottom:1px solid {{ s.rule_color }};
  font-family:{% if s.formal_font == 'serif' %}"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,"Times New Roman",serif{% else %}"Helvetica Neue",Helvetica,Arial,system-ui,sans-serif{% endif %};
  font-size:{{ s.formal_font_size }}px;font-weight:400;line-height:1;font-variant-caps:all-small-caps;letter-spacing:.11em;}
#ltg-{{ sid }} .ltg-bar::before{content:"";position:absolute;inset:3px 0;pointer-events:none;border-top:1px solid {{ s.rule_color }};border-bottom:1px solid {{ s.rule_color }};opacity:.28;}
{%- if s.show_texture %}
#ltg-{{ sid }} .ltg-bar::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:{{ s.texture_opacity | divided_by: 100.0 }};
  background-image:repeating-linear-gradient(45deg,{{ s.rule_color }} 0 1px,transparent 1px 7px),repeating-linear-gradient(-45deg,{{ s.rule_color }} 0 1px,transparent 1px 7px),repeating-radial-gradient(circle at 50% 50%,transparent 0 9px,{{ s.rule_color }} 9px 10px);}
{%- endif %}
#ltg-{{ sid }} .ltg-label,#ltg-{{ sid }} .ltg-row,#ltg-{{ sid }} .ltg-mq{position:relative;z-index:1;}
#ltg-{{ sid }} .ltg-label{display:flex;align-items:center;gap:10px;padding:0 clamp(14px,1.6vw,22px) 0 {{ s.label_left_pad }}px;flex:0 0 auto;white-space:nowrap;border-right:1px solid {{ s.divider_color }};}
#ltg-{{ sid }} .ltg-label .ltg-seal{width:{{ s.seal_size }}px;height:{{ s.seal_size }}px;color:{{ s.rule_color }};flex:0 0 auto;display:block;}
#ltg-{{ sid }} .ltg-label-t,#ltg-{{ sid }} .ltg-item--label .ltg-t{color:{{ s.rule_color }};letter-spacing:.13em;}
#ltg-{{ sid }} .ltg-item{gap:8px;padding:0 clamp(12px,1.5vw,24px);}
#ltg-{{ sid }} .ltg-row .ltg-item + .ltg-item{border-left:1px solid {{ s.divider_color }};}
#ltg-{{ sid }} .ltg-item .ltg-item-sep{display:none;}
#ltg-{{ sid }} .ltg-row .ltg-item{height:56%;}
#ltg-{{ sid }} .ltg-ic{width:{{ s.formal_font_size | plus: 2 }}px;height:{{ s.formal_font_size | plus: 2 }}px;color:{{ s.rule_color }};}
#ltg-{{ sid }} .ltg-row{justify-content:space-evenly;}
#ltg-{{ sid }} .ltg-item a:hover .ltg-t,#ltg-{{ sid }} .ltg-item a:focus-visible .ltg-t{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px;text-decoration-color:{{ s.rule_color }};}
#ltg-{{ sid }} .ltg-item a:focus-visible{outline:1px solid {{ s.rule_color }};outline-offset:-3px;}
#ltg-{{ sid }} .ltg-item--label{display:none;}
@media (max-width:1299px){
  #ltg-{{ sid }} .ltg-bar{font-size:{{ s.formal_font_size | minus: 1 }}px;letter-spacing:.07em;}
  #ltg-{{ sid }} .ltg-label-t{letter-spacing:.09em;}
  #ltg-{{ sid }} .ltg-row .ltg-item{padding:0 12px;}
  #ltg-{{ sid }} .ltg-label{gap:8px;padding:0 14px 0 {{ s.label_left_pad }}px;}
}
@media (max-width:{{ s.breakpoint }}px){
  #ltg-{{ sid }} .ltg-row{display:none;}
  #ltg-{{ sid }} .ltg-mq{display:block;height:100%;-webkit-mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);}
  #ltg-{{ sid }} .ltg-label{padding:0 12px 0 {{ s.label_left_pad }}px;}
  #ltg-{{ sid }} .ltg-label-t{display:none;}
  #ltg-{{ sid }} .ltg-item--label{display:flex;}
  #ltg-{{ sid }} .ltg-mq .ltg-item{padding:0 16px;position:relative;}
  #ltg-{{ sid }} .ltg-mq .ltg-item .ltg-item-sep{display:block;position:absolute;right:0;top:28%;bottom:28%;width:1px;background:{{ s.divider_color }};}
{%- else %}
/* ── Glass ── */
#ltg-{{ sid }}{--ltg-bg:{{ s.bg_color }};--ltg-fg:{{ s.text_color }};--ltg-ac:{{ s.accent_color }};--ltg-r:{{ s.radius }}px;padding:{{ s.pad_top }}px {{ s.side_pad }}px {{ s.pad_bottom }}px;background:{{ s.page_bg }};}
#ltg-{{ sid }} .ltg-bar{border-radius:var(--ltg-r);color:var(--ltg-fg);
  background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.015)),var(--ltg-bg);
  -webkit-backdrop-filter:blur(18px) saturate(150%);backdrop-filter:blur(18px) saturate(150%);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.10),inset 0 0 0 1px rgba(255,255,255,.07){% if s.glow %},0 10px 30px -18px var(--ltg-ac){% endif %};}
#ltg-{{ sid }} .ltg-bar::after{content:"";position:absolute;left:12%;right:12%;bottom:0;height:1px;pointer-events:none;background:linear-gradient(90deg,transparent,var(--ltg-ac),transparent);opacity:{% if s.glow %}.75{% else %}0{% endif %};}
#ltg-{{ sid }} .ltg-item{gap:9px;font:{{ s.font_weight }} {{ s.font_size }}px/1 var(--font-body-family,-apple-system,BlinkMacSystemFont,"SF Pro Text","Helvetica Neue",Arial,sans-serif);letter-spacing:{{ s.letter_spacing | divided_by: 100.0 }}em;{% if s.uppercase %}text-transform:uppercase;{% endif %}}
#ltg-{{ sid }} .ltg-item a:hover .ltg-t,#ltg-{{ sid }} .ltg-item a:focus-visible .ltg-t{text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--ltg-ac);}
#ltg-{{ sid }} .ltg-item a:focus-visible{outline:2px solid var(--ltg-ac);outline-offset:-2px;border-radius:8px;}
#ltg-{{ sid }} .ltg-ic{width:{{ s.icon_size }}px;height:{{ s.icon_size }}px;color:var(--ltg-ac);}
#ltg-{{ sid }} .ltg-t{opacity:.92;}
#ltg-{{ sid }} .ltg-item-sep{display:none;}
#ltg-{{ sid }} .ltg-dot{width:4px;height:4px;border-radius:50%;background:var(--ltg-ac);opacity:.7;flex:0 0 auto;}
#ltg-{{ sid }} .ltg-row{justify-content:center;gap:clamp(18px,3vw,44px);padding:0 24px;}
#ltg-{{ sid }} .ltg-item--label{display:none;}
@media (max-width:{{ s.breakpoint }}px){
  #ltg-{{ sid }} .ltg-row{display:none;}
  #ltg-{{ sid }} .ltg-mq{display:block;height:100%;-webkit-mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);}
  #ltg-{{ sid }} .ltg-mq .ltg-item{padding-right:28px;gap:8px;}
  #ltg-{{ sid }} .ltg-mq .ltg-dot{margin-left:20px;}
{%- endif %}
  {%- if s.mobile_mode == 'marquee' %}
  #ltg-{{ sid }} .ltg-track{animation:ltg-{{ sid }}-x {{ dur }}s linear infinite;will-change:transform;}
  #ltg-{{ sid }} .ltg-mq:hover .ltg-track,#ltg-{{ sid }} .ltg-mq:active .ltg-track,#ltg-{{ sid }} .ltg-mq:focus-within .ltg-track{animation-play-state:paused;}
  {%- else %}
  #ltg-{{ sid }} .ltg-mq{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;}
  #ltg-{{ sid }} .ltg-mq::-webkit-scrollbar{display:none;}
  #ltg-{{ sid }} .ltg-mq .ltg-item{scroll-snap-align:start;}
  #ltg-{{ sid }} .ltg-clone{display:none;}
  {%- endif %}
}
@media (prefers-reduced-motion:reduce){
  #ltg-{{ sid }} .ltg-track{animation:none !important;}
  #ltg-{{ sid }} .ltg-mq{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;}
  #ltg-{{ sid }} .ltg-mq::-webkit-scrollbar{display:none;}
  #ltg-{{ sid }} .ltg-mq .ltg-item{scroll-snap-align:start;}
  #ltg-{{ sid }} .ltg-clone,#ltg-{{ sid }} .ltg-rep{display:none;}
}
</style>
<section id="ltg-{{ sid }}" class="ltg ltg--{% if formal %}formal{% else %}glass{% endif %}" aria-label="{{ s.aria_label | escape }}">
  <div class="ltg-bar ltg-glass">
    {%- if formal -%}
      <div class="ltg-label">
        {%- if s.show_seal -%}
          <svg class="ltg-seal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          {%- if s.seal_shape == 'seal' -%}
            <circle cx="12" cy="12" r="9.25"/><circle cx="12" cy="12" r="7" stroke-opacity=".55"/><path d="m8.6 12.1 2.3 2.3 4.6-4.7"/>
          {%- else -%}
            <path d="M12 3 5 5.8v5.4c0 4.3 2.9 7.7 7 9.3 4.1-1.6 7-5 7-9.3V5.8z"/><path d="m9 12.1 2.1 2.1 4-4.1"/>
          {%- endif -%}
          </svg>
        {%- endif -%}
        {%- if show_label -%}<span class="ltg-label-t">{{ label | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    {%- for pass in (1..3) -%}
      {%- if pass == 1 -%}<ul class="ltg-list ltg-row" role="list">{%- elsif pass == 2 -%}<div class="ltg-mq"><div class="ltg-track"><ul class="ltg-list" role="list">{%- else -%}<ul class="ltg-list ltg-clone" role="list" aria-hidden="true">{%- endif -%}
      {%- liquid
        assign r = 1
        if pass > 1 and s.mobile_mode == 'marquee'
          assign r = reps
        endif
      -%}
      {%- for k in (1..r) -%}
        {%- if pass > 1 and show_label -%}
          <li class="ltg-item ltg-item--label{% if k > 1 %} ltg-rep{% endif %}"><span class="ltg-t">{{ label | escape }}</span><span class="ltg-item-sep" aria-hidden="true"></span></li>
        {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
        <li class="ltg-item{% if k > 1 %} ltg-rep{% endif %}"{% if pass == 1 and k == 1 %} {{ block.shopify_attributes }}{% endif %}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"{% if pass == 3 %} tabindex="-1"{% endif %}>{%- endif -%}
          {%- assign show_ic = true -%}
          {%- if formal and s.formal_item_icons == false -%}{%- assign show_ic = false -%}{%- endif -%}
          {%- if show_ic and block.settings.custom_icon != blank -%}
            <span class="ltg-ic" aria-hidden="true">{{ block.settings.custom_icon | image_url: width: 64 | image_tag: width: 18, height: 18, alt: '', loading: 'lazy' }}</span>
          {%- elsif show_ic and block.settings.icon != 'none' -%}
            <svg class="ltg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{% if formal %}1.3{% else %}1.6{% endif %}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}<path d="M3 6.5h10.5v9H3z"/><path d="M13.5 9.5h3.8l2.7 3v3h-6.5"/><circle cx="7" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/>
              {%- when 'return' -%}<path d="M9 7 5 11l4 4"/><path d="M5 11h9.5a4.5 4.5 0 0 1 0 9H11"/>
              {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="9.5" rx="2.4"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/><path d="M12 14.2v2.2"/>
              {%- when 'card' -%}<rect x="3" y="6" width="18" height="12.5" rx="2.4"/><path d="M3 10h18"/><path d="M7 15h3.5"/>
              {%- when 'mail' -%}<rect x="3.5" y="6" width="17" height="12.5" rx="2.4"/><path d="m4.5 7.5 7.5 5.5 7.5-5.5"/>
              {%- when 'chat' -%}<path d="M5 17.5V7.8A2.3 2.3 0 0 1 7.3 5.5h9.4A2.3 2.3 0 0 1 19 7.8v6.4a2.3 2.3 0 0 1-2.3 2.3H9z"/>
              {%- when 'shield' -%}<path d="M12 3.5 5 6.3v5.2c0 4.2 2.9 7.5 7 9 4.1-1.5 7-4.8 7-9V6.3z"/><path d="m9.2 12 2 2 3.8-3.8"/>
              {%- when 'box' -%}<path d="m12 3.5 8 4.2v8.6l-8 4.2-8-4.2V7.7z"/><path d="m4 7.7 8 4.2 8-4.2"/><path d="M12 11.9v8.6"/>
              {%- when 'ruler' -%}<rect x="2.5" y="8" width="19" height="8" rx="1.6"/><path d="M6.5 8v3M10 8v2M13.5 8v3M17 8v2"/>
              {%- when 'sparkle' -%}<path d="M12 4v4M12 16v4M4 12h4M16 12h4"/><path d="m7.8 7.8 1.6 1.6M14.6 14.6l1.6 1.6M16.2 7.8l-1.6 1.6M9.4 14.6l-1.6 1.6"/>
            {%- endcase -%}
            </svg>
          {%- endif -%}
          <span class="ltg-t">{{ block.settings.text | escape }}</span>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
          {%- if pass > 1 -%}
            {%- if formal -%}<span class="ltg-item-sep" aria-hidden="true"></span>{%- elsif s.show_dots -%}<span class="ltg-dot" aria-hidden="true"></span>{%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- endfor -%}
      {%- if pass == 1 -%}</ul>{%- elsif pass == 2 -%}</ul>{%- else -%}</ul></div></div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Trust banner",
  "tag": "div",
  "class": "section-lexe-trust-glass",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "formal", "options": [ { "value": "formal", "label": "Formal" }, { "value": "glass", "label": "Glass" } ] },
    { "type": "text", "id": "aria_label", "label": "Label for screen readers", "default": "Store promises" },
    { "type": "color", "id": "page_bg", "label": "Background around the banner", "default": "#ffffff" },
    { "type": "header", "content": "Formal style" },
    { "type": "paragraph", "content": "Keep it the store's own promise: no crests, flags, seals with words, or 'official', 'certified', 'verified', 'approved' or agency/bank names." },
    { "type": "checkbox", "id": "show_label", "label": "Show left label", "default": true },
    { "type": "text", "id": "label_text", "label": "Left label (name the store)", "default": "LEXE by Devici Studios — Customer Assurance" },
    { "type": "checkbox", "id": "show_seal", "label": "Show plain outline icon", "default": true },
    { "type": "select", "id": "seal_shape", "label": "Outline icon", "default": "shield", "options": [ { "value": "shield", "label": "Shield with check" }, { "value": "seal", "label": "Ring with check" } ] },
    { "type": "range", "id": "label_left_pad", "label": "Space left of the label", "min": 8, "max": 64, "step": 2, "unit": "px", "default": 44, "info": "Leaves room for the PULL HERE tab on the left edge." },
    { "type": "range", "id": "seal_size", "label": "Outline icon size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "color", "id": "formal_bg", "label": "Background", "default": "#0B1F3A" },
    { "type": "color", "id": "formal_text", "label": "Text", "default": "#F2EFE6" },
    { "type": "color", "id": "rule_color", "label": "Rules, icon and label (brass or silver)", "default": "#B89B5E" },
    { "type": "color", "id": "divider_color", "label": "Dividers between items", "default": "#3A4B66" },
    { "type": "select", "id": "formal_font", "label": "Type", "default": "serif", "options": [ { "value": "serif", "label": "Serif" }, { "value": "grotesque", "label": "Neutral sans" } ] },
    { "type": "range", "id": "formal_font_size", "label": "Text size", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "checkbox", "id": "formal_item_icons", "label": "Show an icon on each item", "default": false },
    { "type": "checkbox", "id": "show_texture", "label": "Fine line texture", "default": true },
    { "type": "range", "id": "texture_opacity", "label": "Texture strength", "min": 1, "max": 12, "step": 1, "unit": "%", "default": 4 },
    { "type": "range", "id": "formal_height", "label": "Height", "min": 40, "max": 72, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "formal_pad_y", "label": "Space above and below", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Glass style" },
    { "type": "color", "id": "bg_color", "label": "Glass color", "default": "#0b0b0d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent (icons, dots, glow)", "default": "#9966CC" },
    { "type": "checkbox", "id": "glow", "label": "Amethyst edge glow", "default": true },
    { "type": "range", "id": "height", "label": "Height", "min": 36, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "side_pad", "label": "Side spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "font_size", "label": "Text size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "select", "id": "font_weight", "label": "Text weight", "default": "500", "options": [ { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" } ] },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": 0, "max": 20, "step": 1, "default": 2, "info": "In hundredths of an em" },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase", "default": false },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "checkbox", "id": "show_dots", "label": "Dots between messages on phones", "default": true },
    { "type": "header", "content": "Phones (both styles)" },
    { "type": "select", "id": "mobile_mode", "label": "Phone layout", "default": "marquee", "options": [ { "value": "marquee", "label": "Smooth scroll (pauses on touch)" }, { "value": "swipe", "label": "Swipe" } ], "info": "Visitors who turn on Reduce Motion always get Swipe." },
    { "type": "range", "id": "speed", "label": "Scroll time per message", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "breakpoint", "label": "Phone layout below", "min": 600, "max": 1400, "step": 10, "unit": "px", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "none", "label": "None" }, { "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" },
          { "value": "lock", "label": "Lock" }, { "value": "card", "label": "Card" }, { "value": "mail", "label": "Email" },
