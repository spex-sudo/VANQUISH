        },
        {
          "value": "phone",
          "label": "Phone"
        },
        {
          "value": "headset",
          "label": "Headset"
        },
        {
          "value": "clock",
          "label": "Clock"
        },
        {
          "value": "calendar",
          "label": "Calendar"
        },
        {
          "value": "globe",
          "label": "Globe"
        },
        {
          "value": "ruler",
          "label": "Ruler / size guide"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "star",
          "label": "Star (decoration only)"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "gift",
          "label": "Gift"
        },
        {
          "value": "tag",
