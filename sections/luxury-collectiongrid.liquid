{%- comment -%}
  SOVEREIGN ORBIT APEX — v3.4  (Performance Edition + bottom fade)
{%- endcomment -%}

{%- liquid
  assign sid                 = section.id
  assign bg                  = section.settings.bg_color         | default: '#000000'
  assign accent              = section.settings.accent_color     | default: '#d4af37'
  assign eyebrow             = section.settings.eyebrow
  assign heading             = section.settings.heading
  assign tagline             = section.settings.tagline

  assign rendered_count = 0
  for _b in section.blocks
    assign _bc = collections[_b.settings.collection]
    if _bc != blank and _bc != empty
      assign rendered_count = rendered_count | plus: 1
    endif
  endfor

  assign enable_autoscroll   = section.settings.enable_autoscroll
  assign autoscroll_interval = section.settings.autoscroll_interval | default: 6
  assign show_counter        = section.settings.show_counter
  assign show_meta           = section.settings.show_meta
  assign show_noise          = section.settings.show_noise
  assign show_dots           = section.settings.show_dots
  assign enable_schema       = section.settings.enable_schema
  assign enable_nudge        = section.settings.enable_nudge
  assign card_radius         = section.settings.card_radius        | default: 16
  assign card_width_pct      = section.settings.card_width_desktop | default: 70
  assign card_width_mob      = section.settings.card_width_mobile  | default: 80
  assign card_gap_px         = section.settings.card_gap           | default: 40

  assign price_prefix        = section.settings.price_prefix          | default: 'From'
  assign unit_singular       = section.settings.unit_singular         | default: 'piece'
  assign unit_plural         = section.settings.unit_plural           | default: 'pieces'
  assign sr_showing_label    = section.settings.sr_showing_label      | default: 'Showing'
  assign sr_of_label         = section.settings.sr_of_label           | default: 'of'

  assign login_handles       = settings.login_required_collections | remove: ' ' | downcase | split: ','


-%}

{% include 'orbit-apex-style' %}
{% include 'orbit-apex-markup' %}
{% include 'orbit-apex-js' %}

{% schema %}
{
  "name": "Sovereign Orbit Apex",
  "tag": "section",
  "class": "section-orbit-apex",
  "settings": [
    {
      "type": "header",
      "content": "Header Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SOVEREIGN / 2026 / LIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Apex Collections"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Six worlds. One uniform. Curated for those who refuse the default."
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Space below header",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "header",
      "content": "Visual Core"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#d4af37"
    },
    {
      "type": "text",
      "id": "aspect_ratio",
      "label": "Aspect Ratio",
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "padding_v",
      "label": "Vertical Padding",
      "min": 0,
      "max": 150,
      "step": 10,
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "bottom_fade",
      "label": "Fade bottom into next section",
      "default": true,
      "info": "Soft blend from this section into the one below. Set Fade into color to match the next section."
    },
    {
      "type": "color",
      "id": "fade_to_color",
      "label": "Fade into color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "fade_height",
      "label": "Fade height",
      "min": 40,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Title Font",
      "default": "mono"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Max Title Size",
      "min": 20,
      "max": 60,
      "step": 1,
      "default": 36
    },
    {
      "type": "header",
      "content": "Controls"
    },
    {
      "type": "checkbox",
      "id": "enable_blur",
      "label": "Inactive Blur",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ring",
      "label": "Orbital Ring",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_hud",
      "label": "HUD Corner Brackets",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_scanlines",
      "label": "Scanline Texture",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_noise",
      "label": "Film Grain Overlay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show Position Counter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show Collection Meta",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dot Pagination",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_nudge",
      "label": "Auto-Nudge on First Visit",
      "default": true
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Corner Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_width_desktop",
      "label": "Card Width (desktop)",
      "min": 50,
      "max": 85,
      "step": 1,
      "default": 70,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card Width (mobile)",
      "min": 70,
      "max": 92,
      "step": 1,
      "default": 80,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "inactive_scale",
      "label": "Inactive Card Scale",
      "options": [
        {
          "value": "0.8",
          "label": "Small (0.8)"
        },
        {
          "value": "0.9",
          "label": "Medium (0.9)"
        },
        {
          "value": "1.0",
          "label": "Full Size (1.0)"
        }
      ],
      "default": "0.9"
    },
    {
      "type": "header",
      "content": "Autoscroll"
    },
    {
      "type": "checkbox",
      "id": "enable_autoscroll",
      "label": "Enable Autoscroll",
      "default": false
    },
    {
      "type": "range",
      "id": "autoscroll_interval",
      "label": "Seconds per card",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Text Labels"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "text",
      "id": "unit_singular",
      "label": "Unit (singular)",
      "default": "piece"
    },
    {
      "type": "text",
      "id": "unit_plural",
      "label": "Unit (plural)",
      "default": "pieces"
    },
    {
      "type": "text",
      "id": "sr_showing_label",
      "label": "Screen reader 'Showing'",
      "default": "Showing"
    },
    {
      "type": "text",
      "id": "sr_of_label",
      "label": "Screen reader 'of'",
      "default": "of"
    },
    {
      "type": "header",
      "content": "SEO"
    },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Output JSON-LD ItemList schema",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "status_text",
          "label": "Status Label",
          "default": "SYSTEM_READY"
        },
        {
          "type": "color",
          "id": "status_color",
          "label": "Status Color",
          "default": "#d4af37"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Photo"
        },
        {
          "type": "video",
          "id": "video_url",
          "label": "Custom Video"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA Label",
          "default": "Enter"
        },
        {
          "type": "text",
          "id": "price_from",
          "label": "Price From (optional)"
        },
        {
          "type": "header",
          "content": "Tactical Badge"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Badge Background",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "badge_text_color",
          "label": "Badge Text / Glow",
          "default": "#ff4d4d"
        },
        {
          "type": "header",
          "content": "Login required"
        },
        {
          "type": "checkbox",
          "id": "lock_collection",
          "label": "Require login to view",
          "default": false,
          "info": "Card looks normal. Logged-out visitors who open it get a 'log in' pop-up. Also add the handle to Theme settings > Login-required collections so the collection page itself is gated."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sovereign Orbit Apex"
    }
  ]
}
{% endschema %}

