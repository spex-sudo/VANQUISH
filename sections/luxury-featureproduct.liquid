{%- style -%}
  #shopify-section-{{ sid }} {
    --apex-card-w:        {{ computed_width }}px;
    --apex-scroll:        {{ scroll_speed }}s;
    --apex-r-card:        {{ s.card_radius }}px;
    --apex-r-btn:         {{ s.btn_radius }}px;
    --apex-accent:        {{ s.accent_color }};
    --apex-fg:            {{ s.text_color }};
    --apex-fg-muted:      {{ s.text_color }}99;
    --apex-fg-soft:       {{ s.text_color }}66;
    --apex-card-bg:       {{ s.card_bg_color }};
    --apex-hairline:      {{ s.text_color }}14;
    --apex-bg:            {{ s.section_bg_color }};
    --apex-img-bg:        {{ s.img_placeholder_bg }};
    --apex-ease:          cubic-bezier(0.22, 1, 0.36, 1);
    --apex-ease-out:      cubic-bezier(0.16, 1, 0.3, 1);
    --apex-grid-aspect:   {{ s.grid_aspect | default: '3 / 4' }};
    --apex-grid-hero-asp: {{ s.grid_hero_aspect | default: '1 / 1' }};
    --apex-grid-gap:      {{ s.grid_gap | default: 12 }}px;
    --apex-grid-cols-d:   {{ s.grid_cols_desktop | default: '4' }};
    --apex-grid-cols-t:   {{ s.grid_cols_tablet | default: '2' }};
    --apex-grid-cols-m:   {{ s.grid_cols_mobile | default: '2' }};
  }

  .apex-{{ sid }} {
    padding: {{ s.padding_top | divided_by: 1.4 | round }}px 0 {{ s.padding_bottom | divided_by: 1.4 | round }}px;
  }
  @media (min-width: 750px) {
    .apex-{{ sid }} {
      padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
    }
  }

  {%- if s.enable_section_bg -%}
  #shopify-section-{{ sid }} {
    background: {{ s.section_bg_color }} !important;
    margin: 0 !important;
  }
  {%- if s.section_bg_radius > 0 -%}
  #shopify-section-{{ sid }} {
    border-radius: {{ s.section_bg_radius }}px;
    overflow: hidden;
  }
  {%- endif -%}
  {%- endif -%}
{%- endstyle -%}

<style>
/* ═══════════════════════════════════════════════════════════════
   BASE
═══════════════════════════════════════════════════════════════ */
.apex-{{ sid }} {
  color: var(--apex-fg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Inter', system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.apex-wrap-{{ sid }} {
  max-width: {{ s.max_content_width }}px;
  margin: 0 auto;
  padding: 0 clamp(16px, 3vw, 24px);
}

/* ═══════════════════════════════════════════════════════════════
   SECTION HEADER (shared by showcase + grid)
═══════════════════════════════════════════════════════════════ */
.apex-head-{{ sid }} {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin: 0 0 clamp(20px, 3vw, 32px);
}
.apex-head-{{ sid }} .apex-eyebrow {
  display: block;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--apex-accent);
  font-weight: 500;
  margin: 0 0 8px;
}
.apex-head-{{ sid }} h2 {
  font-size: clamp(24px, 3.5vw, {{ s.title_size }}px);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.08;
  margin: 0;
  color: var(--apex-fg);
}

