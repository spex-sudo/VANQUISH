  white-space: nowrap;
}

/* ══════════════════════════════════════════════════════════════
   GRID MODE — View All CTA
══════════════════════════════════════════════════════════════ */
.apex-gviewall-{{ sid }} {
  display: flex;
  justify-content: center;
  margin-top: clamp(24px, 3vw, 44px);
}
.apex-gviewall-{{ sid }} a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 36px;
  border: 1.5px solid var(--apex-fg);
