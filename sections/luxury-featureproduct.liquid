}
.apex-free-{{ sid }} .free-label { color: {{ s.free_color | default: '#9966CC' }}; font-weight: 600; letter-spacing: 0.02em; }
.apex-free-{{ sid }} .free-condition { display: block; margin-top: 6px; font-size: 14px; font-weight: 400; color: var(--apex-fg-muted); }
.apex-free-{{ sid }} .free-condition a { color: inherit; text-decoration: underline; }
.apex-single-desc-{{ sid }} {
  font-size: 16px; line-height: 1.55; color: var(--apex-fg-muted); margin: 0 0 24px;
}
.apex-single-buy-{{ sid }} {
  display: block; width: 100%; padding: 14px 20px;
  background: var(--apex-fg); color: {% if s.single_btn_text_color != blank %}{{ s.single_btn_text_color }}{% else %}var(--apex-card-bg){% endif %};
  border: 0; border-radius: var(--apex-r-btn);
  font-size: 15px; font-weight: 500; cursor: pointer;
  transition: background 0.2s var(--apex-ease), transform 0.18s var(--apex-ease);
  font-family: inherit; text-align: center; text-decoration: none;
}
.apex-single-buy-{{ sid }}:hover { background: var(--apex-accent);{% if s.single_btn_text_color != blank %} color: {{ s.single_btn_text_color }};{% endif %} }
.apex-single-buy-{{ sid }}:active { transform: scale(0.99); }
.apex-single-buy-{{ sid }}:disabled { opacity: 0.5; cursor: not-allowed; }
/* ── LEXE pair selector (single mode, free offer) ── */
.lx-sel-{{ sid }} { --lx-amethyst: {{ s.free_color | default: '#9966CC' }}; --lx-deep: {{ s.accent_color | default: '#3c2366' }}; --lx-size: min(58vw, 240px); display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; text-align: center; color: var(--apex-fg); }
@media (min-width: 750px) {
  .lx-sel-{{ sid }} { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; text-align: left; gap: clamp(24px, 4vw, 56px); --lx-size: 260px; }
  .lx-sel-{{ sid }} .lx-col-media { text-align: center; }
}
.lx-sel-{{ sid }} .lx-col { min-width: 0; }
.lx-sel-{{ sid }} .lx-eyebrow { font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--apex-fg-muted); margin: 0 0 8px; }
.lx-sel-{{ sid }} .lx-viewport { position: relative; overflow: hidden; padding: 18px 0; touch-action: pan-y; border-radius: 8px; outline: none; }
.lx-sel-{{ sid }} .lx-viewport:focus-visible { box-shadow: 0 0 0 2px var(--lx-amethyst); }
.lx-sel-{{ sid }} .lx-track { position: relative; display: flex; gap: 12px; width: max-content; transition: transform 0.45s var(--apex-ease); will-change: transform; }
.lx-sel-{{ sid }} .lx-slide { flex: 0 0 var(--lx-size); width: var(--lx-size); height: var(--lx-size); padding: 0; border: 0; border-radius: 50%; overflow: hidden; background: #f4effa; cursor: pointer; transform: scale(0.7); opacity: 0.55; transition: transform 0.45s var(--apex-ease), opacity 0.45s var(--apex-ease), box-shadow 0.3s var(--apex-ease); }
.lx-sel-{{ sid }} .lx-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
.lx-sel-{{ sid }} .lx-slide.is-active { transform: scale(1); opacity: 1; box-shadow: 0 0 0 4px #fff, 0 0 0 7px var(--lx-amethyst); }
.lx-sel-{{ sid }} .lx-slide:focus-visible { outline: 2px solid var(--lx-deep); outline-offset: 10px; }
.lx-sel-{{ sid }} .lx-arrows { display: flex; justify-content: center; gap: 12px; margin-top: 6px; }
.lx-sel-{{ sid }} .lx-arrow { width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid var(--lx-amethyst); background: transparent; color: var(--lx-deep); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s, color 0.2s; }
.lx-sel-{{ sid }} .lx-arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.lx-sel-{{ sid }} .lx-arrow:hover { background: var(--lx-amethyst); color: #fff; }
.lx-sel-{{ sid }} .lx-arrow:focus-visible { outline: 2px solid var(--lx-deep); outline-offset: 3px; }
.lx-sel-{{ sid }} .lx-name { font-size: clamp(26px, 3.6vw, 40px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.08; margin: 0 0 10px; }
.lx-sel-{{ sid }} .lx-free { margin: 0 0 16px; }
.lx-sel-{{ sid }} .lx-free-label { display: block; font-size: 24px; font-weight: 600; letter-spacing: 0.03em; color: var(--lx-amethyst); }
.lx-sel-{{ sid }} .lx-free-condition { display: block; margin-top: 4px; font-size: 14px; color: var(--apex-fg-muted); }
.lx-sel-{{ sid }} .lx-free-condition a { color: inherit; text-decoration: underline; }
.lx-sel-{{ sid }} .lx-blurb { font-size: 16px; line-height: 1.55; color: var(--apex-fg-muted); margin: 0 0 18px; }
.lx-sel-{{ sid }} .lx-pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; justify-content: center; }
@media (min-width: 750px) { .lx-sel-{{ sid }} .lx-pills { justify-content: flex-start; } }
.lx-sel-{{ sid }} .lx-pill { position: relative; cursor: pointer; }
.lx-sel-{{ sid }} .lx-pill input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.lx-sel-{{ sid }} .lx-pill span { display: inline-block; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--apex-hairline); border-color: {{ s.text_color }}33; font-size: 14px; line-height: 1.2; transition: border-color 0.2s, background 0.2s; }
.lx-sel-{{ sid }} .lx-pill:hover span { border-color: var(--lx-amethyst); }
.lx-sel-{{ sid }} .lx-pill input:checked + span { border-color: var(--lx-amethyst); background: {{ s.free_color | default: '#9966CC' }}1f; font-weight: 500; }
.lx-sel-{{ sid }} .lx-pill input:focus-visible + span { outline: 2px solid var(--lx-deep); outline-offset: 2px; }
.lx-sel-{{ sid }} .lx-claim-row { display: flex; flex-direction: column; gap: 10px; }
@media (min-width: 990px) { .lx-sel-{{ sid }} .lx-claim-row { flex-direction: row; } .lx-sel-{{ sid }} .lx-email { flex: 1; } }
.lx-sel-{{ sid }} .lx-email { font: inherit; font-size: 16px; padding: 14px 20px; border-radius: 999px; border: 1px solid {{ s.text_color }}40; background: #fff; color: var(--apex-fg); min-width: 0; }
.lx-sel-{{ sid }} .lx-email:focus { outline: none; border-color: var(--lx-amethyst); box-shadow: 0 0 0 3px {{ s.free_color | default: '#9966CC' }}33; }
.lx-sel-{{ sid }} .lx-claim-btn { font: inherit; font-size: 16px; font-weight: 700; padding: 15px 34px; border: 0; border-radius: 999px; background: var(--lx-deep); color: #fff; cursor: pointer; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
.lx-sel-{{ sid }} .lx-claim-btn:hover { background: #4e2f85; }
.lx-sel-{{ sid }} .lx-claim-btn:active { transform: scale(0.98); }
.lx-sel-{{ sid }} .lx-claim-btn:focus-visible { outline: 2px solid var(--lx-amethyst); outline-offset: 3px; }
.lx-sel-{{ sid }} .lx-claim-btn[disabled] { opacity: 0.6; cursor: wait; }
.lx-sel-{{ sid }} .lx-consent { font-size: 12.5px; line-height: 1.5; color: var(--apex-fg-muted); margin: 10px 0 0; }
.lx-sel-{{ sid }} .lx-consent a { color: inherit; text-decoration: underline; }
.lx-sel-{{ sid }} .lx-msg { font-size: 14px; margin: 8px 0 0; min-height: 1em; }
.lx-sel-{{ sid }} .lx-msg.is-error { color: #b3261e; }
.lx-sel-{{ sid }} .lx-details { display: inline-block; margin-top: 12px; color: var(--apex-accent); text-decoration: none; font-size: 14px; font-weight: 500; }
@media (prefers-reduced-motion: reduce) { .lx-sel-{{ sid }} .lx-track, .lx-sel-{{ sid }} .lx-slide { transition: none; } }
.lx-sel-{{ sid }} .lx-noimg { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 14%; box-sizing: border-box; text-align: center; font-size: 15px; line-height: 1.25; color: var(--apex-fg-muted); background: #f4effa; }
.lx-sel-{{ sid }} .lx-slide { content-visibility: auto; }
.lx-sel-{{ sid }} .lx-count { align-self: center; min-width: 54px; font-size: 13px; letter-spacing: 0.06em; color: var(--apex-fg-muted); font-variant-numeric: tabular-nums; }
.lx-sel-{{ sid }} .lx-arrows[hidden] { display: none; }
.lx-sel-{{ sid }} [hidden] { display: none !important; }
.lx-sel-{{ sid }} .lx-price { display: flex; align-items: baseline; justify-content: center; gap: 10px; margin: 0 0 16px; font-variant-numeric: tabular-nums; }
@media (min-width: 750px) { .lx-sel-{{ sid }} .lx-price { justify-content: flex-start; } }
.lx-sel-{{ sid }} .lx-price-now { font-size: 24px; font-weight: 600; }
.lx-sel-{{ sid }} .lx-price-was { font-size: 16px; color: var(--apex-fg-soft); text-decoration: line-through; }
.lx-sel-{{ sid }} .lx-vselect { margin: 0 0 22px; }
.lx-sel-{{ sid }} .lx-vs { font: inherit; font-size: 15px; padding: 12px 40px 12px 16px; border-radius: 999px; border: 1px solid {{ s.text_color }}40; background: #fff; color: var(--apex-fg); max-width: 100%; }
.lx-sel-{{ sid }} .lx-vs:focus-visible { outline: 2px solid var(--lx-deep); outline-offset: 2px; }
.lx-sel-{{ sid }} .lx-buy-btn { display: block; width: 100%; font: inherit; font-size: 16px; font-weight: 700; padding: 15px 34px; border: 0; border-radius: 999px; background: var(--lx-deep); color: #fff; cursor: pointer; transition: background 0.2s, transform 0.15s; }
.lx-sel-{{ sid }} .lx-buy-btn:hover { background: #4e2f85; }
.lx-sel-{{ sid }} .lx-buy-btn[disabled] { opacity: 0.6; cursor: wait; }
@media (min-width: 990px) { .lx-sel-{{ sid }} .lx-buy-btn { width: auto; display: inline-block; } }
</style>

<div class="apex-{{ sid }}">
  <div class="apex-wrap-{{ sid }}">

  {%- if mode == 'single' -%}
    {%- liquid
      # ── Gift source: manual Gift products list (default), the source collection, or every product in the selector
      assign gift_src = s.gift_source | default: 'manual'
      assign lx_gift_csv = ','
      for gp in s.free_gift_products limit: 10
        assign lx_gift_csv = lx_gift_csv | append: gp.handle | append: ','
      endfor
      if s.free_gift_handles != blank
        assign lx_extra_handles = s.free_gift_handles | remove: ' ' | remove: '"' | append: ','
        assign lx_gift_csv = lx_gift_csv | append: lx_extra_handles
      endif

      # ── Product source: Products list, Collection, or both (list first, no duplicates), capped
      assign lx_src = s.single_source | default: 'products'
      assign lx_coll = s.single_collection
      assign lx_cap = s.single_max | default: 24
      assign lx_l1 = s.single_products
      assign lx_l2 = nil
      if lx_src == 'collection'
        assign lx_l1 = nil
      endif
      if lx_src != 'products' and lx_coll != blank
        assign lx_l2 = lx_coll.products
      endif
      if lx_l1 == blank and lx_l2 == blank and s.pair_selector_enabled and s.free_gift_products != blank
        assign lx_l1 = s.free_gift_products
      endif
      if lx_src == 'products'
        assign lx_cap = 10
      endif
      assign lx_n = 0
      assign lx_start = 0
      assign lx_keep = ','
      assign lx_first_url = ''
      for lx_pass in (1..2)
        if lx_pass == 1
          assign lx_cur = lx_l1
        else
          assign lx_cur = lx_l2
        endif
      for gp in lx_cur limit: 60
        if lx_n >= lx_cap
          break
        endif
        assign lx_probe = ',' | append: gp.handle | append: ','
        assign lx_dup = false
        if lx_keep contains lx_probe
          assign lx_dup = true
        endif
        if gp.available and lx_dup == false
          assign lx_keep = lx_keep | append: gp.handle | append: ','
          if lx_n == 0
            assign lx_first_url = gp.url
          endif
          if product != blank and gp.handle == product.handle
            assign lx_start = lx_n
          endif
          assign lx_n = lx_n | plus: 1
        endif
      endfor
      endfor
      assign lx_emit = ','
      assign lx_form_id = 'lx-claim-' | append: sid
      assign lx_blurb_lines = s.gift_blurbs | newline_to_br | split: '<br />'
    -%}
    {%- if lx_n > 0 -%}
      <div class="lx-sel-{{ sid }}" id="lx-sel-{{ sid }}" data-start="{{ lx_start }}" data-count="{{ lx_n }}" data-code="{{ s.free_discount_code | default: 'LEXESPECS' | escape }}" data-elig-url="{{ s.free_link_url | default: '/collections/specs-offer-eligible' }}">
        <div class="lx-col lx-col-media">
          {%- if s.selector_eyebrow != blank -%}<p class="lx-eyebrow" data-lx-eyebrow>{{ s.selector_eyebrow | escape }}</p>{%- endif -%}
          <div class="lx-viewport" data-lx-viewport tabindex="0" role="group" aria-roledescription="carousel" aria-label="{{ s.selector_eyebrow | default: 'Pick a product' | escape }}">
            <div class="lx-track" data-lx-track>
              {%- assign lx_i = 0 -%}
              {%- assign lx_emit = ',' -%}
              {%- for lx_pass in (1..2) -%}{%- if lx_pass == 1 -%}{%- assign lx_cur = lx_l1 -%}{%- else -%}{%- assign lx_cur = lx_l2 -%}{%- endif -%}
              {%- for gp in lx_cur limit: 60 -%}
                {%- assign lx_probe = ',' | append: gp.handle | append: ',' -%}
                {%- assign lx_kept = false -%}{%- if lx_keep contains lx_probe -%}{%- assign lx_kept = true -%}{%- endif -%}
                {%- assign lx_done = false -%}{%- if lx_emit contains lx_probe -%}{%- assign lx_done = true -%}{%- endif -%}
                {%- if lx_kept and lx_done == false -%}
                  {%- assign lx_emit = lx_emit | append: gp.handle | append: ',' -%}
                  {%- assign gp_img = gp.featured_image -%}
                  <button type="button" class="lx-slide{% if lx_i == lx_start %} is-active{% endif %}" data-lx-slide="{{ lx_i }}"
                    aria-label="{{ gp.title | escape }}" aria-pressed="{% if lx_i == lx_start %}true{% else %}false{% endif %}">
                    {%- if gp_img -%}
                      <img src="{{ gp_img | image_url: width: 400 }}" alt="" width="200" height="200" loading="{% if lx_i == lx_start %}eager{% else %}lazy{% endif %}" decoding="async" data-lx-img>
                    {%- else -%}
                      <span class="lx-noimg" aria-hidden="true">{{ gp.title | escape | truncate: 22 }}</span>
                    {%- endif -%}
                  </button>
                  {%- assign lx_i = lx_i | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="lx-arrows">
            <button type="button" class="lx-arrow" data-lx-prev aria-label="Previous product" aria-controls="lx-sel-{{ sid }}">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
            <span class="lx-count" data-lx-counter aria-hidden="true"></span>
            <button type="button" class="lx-arrow" data-lx-next aria-label="Next product" aria-controls="lx-sel-{{ sid }}">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        <div class="lx-col lx-col-info">
          <p class="visually-hidden" aria-live="polite" data-lx-announce></p>
          {%- assign lx_i = 0 -%}
          {%- assign lx_emit = ',' -%}
          {%- for lx_pass in (1..2) -%}{%- if lx_pass == 1 -%}{%- assign lx_cur = lx_l1 -%}{%- else -%}{%- assign lx_cur = lx_l2 -%}{%- endif -%}
          {%- for gp in lx_cur limit: 60 -%}
            {%- assign lx_probe = ',' | append: gp.handle | append: ',' -%}
            {%- assign lx_kept = false -%}{%- if lx_keep contains lx_probe -%}{%- assign lx_kept = true -%}{%- endif -%}
            {%- assign lx_done = false -%}{%- if lx_emit contains lx_probe -%}{%- assign lx_done = true -%}{%- endif -%}
            {%- if lx_kept and lx_done == false -%}
              {%- assign lx_emit = lx_emit | append: gp.handle | append: ',' -%}
              {%- liquid
                # gift = allowed by the Gift products source AND offer switched on AND a cost on file AND in the discount's gift collection
                # (the last two are checked in snippets/lexe-gift-rules.liquid); anything else keeps its normal price and Add to cart
                assign lx_gift = false
                assign lx_min = -1
                assign lx_by_source = false
                if gift_src == 'all'
                  assign lx_by_source = true
                elsif gift_src == 'collection'
                  if lx_coll != blank
                    assign lx_pc = gp.collections | map: 'handle'
                    if lx_pc contains lx_coll.handle
                      assign lx_by_source = true
                    endif
                  endif
                elsif lx_gift_csv contains lx_probe
                  assign lx_by_source = true
                endif
                if s.free_offer_enabled and lx_by_source
                  capture lx_min_raw
                    render 'lexe-gift-rules', product: gp
                  endcapture
                  assign lx_min = lx_min_raw | strip | plus: 0
                  if lx_min > 0
                    assign lx_gift = true
                  endif
                endif
                assign lx_lbl = lx_min | money_without_trailing_zeros
                assign gp_blurb = ''
                for line in lx_blurb_lines
                  assign parts = line | split: '|'
                  assign l_handle = parts.first | strip
                  if l_handle == gp.handle and parts.size > 1
                    assign gp_blurb = parts.last | strip
                  endif
                endfor
                if gp_blurb == blank and lx_gift == false
                  assign gp_blurb = gp.description | strip_html | strip_newlines | truncate: 150
                endif
                assign gp_first = gp.selected_or_first_available_variant
                assign gp_many = false
                if gp.variants.size > 12
                  assign gp_many = true
                endif
              -%}
              <div class="lx-panel" data-lx-panel="{{ lx_i }}" data-url="{{ gp.url }}" data-lx-gift="{% if lx_gift %}1{% else %}0{% endif %}" data-lx-min="{{ lx_min }}"{% unless lx_i == lx_start %} hidden{% endunless %}>
                <h2 class="lx-name">{{ gp.title | escape }}</h2>
                {%- if lx_gift -%}
                  <div class="lx-free">
                    <span class="lx-free-label">{{ s.free_label | default: 'FREE' | escape }}</span>
                    {%- if s.free_condition_text != blank -%}
                      <span class="lx-free-condition">{{ s.free_condition_text | replace: '[min]', lx_lbl | replace: '$49', lx_lbl | escape }}{% if s.free_link_text != blank and s.free_link_url != blank %} <a href="{{ s.free_link_url }}">{{ s.free_link_text | escape }}</a>{% endif %}</span>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <div class="lx-price" data-lx-price>
                    <span class="lx-price-now" data-lx-now>{{ gp_first.price | money }}</span>
                    <span class="lx-price-was" data-lx-was{% unless gp_first.compare_at_price > gp_first.price %} hidden{% endunless %}>{% if gp_first.compare_at_price > gp_first.price %}{{ gp_first.compare_at_price | money }}{% endif %}</span>
                  </div>
                {%- endif -%}
                {%- if gp_blurb != blank -%}<p class="lx-blurb">{{ gp_blurb | escape_once }}</p>{%- endif -%}
                {%- unless gp.has_only_default_variant -%}
                  {%- if gp_many -%}
                    <div class="lx-vselect">
                      <label class="visually-hidden" for="lx-vs-{{ sid }}-{{ lx_i }}">{{ gp.options.first | default: 'Option' | escape }} for {{ gp.title | escape }}</label>
                      {%- comment -%} Many variants: only the first one is in the page; the rest load from /products/handle.js when this product is shown. {%- endcomment -%}
                      <select id="lx-vs-{{ sid }}-{{ lx_i }}" class="lx-vs" data-lx-vs data-lx-lazy="{{ gp.handle }}">
                        {%- liquid
                          assign v_img = ''
                          if gp_first.featured_image
                            assign v_img = gp_first.featured_image | image_url: width: 400
                          elsif gp.featured_image
                            assign v_img = gp.featured_image | image_url: width: 400
                          endif
                          assign v_cmp = ''
                          if gp_first.compare_at_price > gp_first.price
                            assign v_cmp = gp_first.compare_at_price | money
                          endif
                        -%}
                        <option value="{{ gp_first.id }}" data-img="{{ v_img }}" data-price="{{ gp_first.price | money | escape }}" data-compare="{{ v_cmp | escape }}" selected>{{ gp_first.title | escape }}</option>
                      </select>
                    </div>
                  {%- else -%}
                    <div class="lx-pills" role="radiogroup" aria-label="{{ gp.options.first | default: 'Colour' | escape }} for {{ gp.title | escape }}">
                      {%- for v in gp.variants -%}
                        {%- if v.available -%}
                          {%- liquid
                            assign v_img = ''
                            if v.featured_image
                              assign v_img = v.featured_image | image_url: width: 400
                            elsif gp.featured_image
                              assign v_img = gp.featured_image | image_url: width: 400
                            endif
                            assign v_cmp = ''
                            if v.compare_at_price > v.price
                              assign v_cmp = v.compare_at_price | money
                            endif
                            assign v_words = v.title | downcase | split: ' '
                            assign v_label = ''
                            for w in v_words
                              assign v_cw = w | capitalize
                              assign v_label = v_label | append: ' ' | append: v_cw
                            endfor
                            assign v_label = v_label | strip
                          -%}
                          <label class="lx-pill">
                            <input type="radio" name="lx-v-{{ sid }}-{{ lx_i }}" value="{{ v.id }}" data-img="{{ v_img }}" data-price="{{ v.price | money | escape }}" data-compare="{{ v_cmp | escape }}"{% if v.id == gp_first.id %} checked{% endif %}>
                            <span>{{ v_label | escape }}</span>
                          </label>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                {%- else -%}
                  <input type="radio" hidden name="lx-v-{{ sid }}-{{ lx_i }}" value="{{ gp_first.id }}" data-img="" data-price="{{ gp_first.price | money | escape }}" data-compare="" checked>
                {%- endunless -%}
              </div>
              {%- assign lx_i = lx_i | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- endfor -%}

          <div data-lx-claim-wrap>
            {%- form 'customer', id: lx_form_id, class: 'lx-claim' -%}
              {%- liquid
                assign lx_posted = false
                if form.posted_successfully?
                  assign lx_posted = true
                endif
              -%}
              <input type="hidden" name="contact[tags]" value="newsletter,specs-offer">
              <input type="hidden" data-lx-variant value="">
              <div class="lx-claim-row">
                <label class="visually-hidden" for="lx-email-{{ sid }}">Email</label>
                <input class="lx-email" id="lx-email-{{ sid }}" type="email" name="contact[email]" required autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="Email address" aria-describedby="lx-consent-{{ sid }} lx-msg-{{ sid }}">
                <button type="submit" class="lx-claim-btn" data-lx-claim>{{ s.claim_button_label | default: 'Claim now' | escape }}</button>
              </div>
              <p class="lx-consent" id="lx-consent-{{ sid }}">You're joining LEXE emails about new pieces and offers. You can unsubscribe anytime. <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy policy</a></p>
              <p class="lx-msg" id="lx-msg-{{ sid }}" role="status" aria-live="polite" data-lx-msg{% if lx_posted %} data-posted="true"{% endif %}{% if form.errors %} data-error="{{ form.errors.translated_fields.email | append: ' ' | append: form.errors.messages.email | strip | escape }}"{% endif %}></p>
            {%- endform -%}
          </div>
          <div data-lx-buy-wrap hidden>
            <form action="{{ routes.cart_add_url }}" method="post" class="apex-atc-form-{{ sid }} lx-buy" data-orig="{{ 'products.product.add_to_cart' | t | escape }}">
              <input type="hidden" name="id" value="" data-lx-buy-id>
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="lx-buy-btn" data-lx-buy>{{ 'products.product.add_to_cart' | t }}</button>
            </form>
          </div>
          <a class="lx-details" href="{{ lx_first_url }}" data-lx-details>{{ 'products.product.view_full_details' | t | default: 'View full details' }} &rarr;</a>
        </div>
      </div>
    {%- elsif product != blank -%}
      {%- liquid
        assign lexe_free = false
        assign lx_probe = ',' | append: product.handle | append: ','
        if s.free_offer_enabled and lx_gift_csv contains lx_probe
          capture lx_min_raw
            render 'lexe-gift-rules', product: product
          endcapture
          assign lx_min_p = lx_min_raw | strip | plus: 0
          if lx_min_p > 0
            assign lexe_free = true
          endif
          assign lx_lbl = lx_min_p | money_without_trailing_zeros
        endif
      -%}
      <div class="apex-single-{{ sid }}{% if s.layout == 'text_first' %} is-text-first{% endif %}">
        <div class="apex-single-media-{{ sid }}">
          {%- if first_image -%}
            <img
              src="{{ first_image | image_url: width: 1100 }}"
              srcset="{{ first_image | image_url: width: 550 }} 550w, {{ first_image | image_url: width: 1100 }} 1100w, {{ first_image | image_url: width: 1500 }} 1500w"
              sizes="(min-width: 750px) 50vw, 100vw"
              alt="{{ first_image.alt | default: product.title | escape }}"
              loading="eager" fetchpriority="high"
              width="{{ first_image.width | default: 1100 }}"
              height="{{ first_image.height | default: 1100 }}">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <div class="apex-single-info-{{ sid }}">
          <h1>{{ product.title | escape }}</h1>
          {%- if lexe_free -%}
            <div class="apex-single-price-{{ sid }} apex-free-{{ sid }}" data-lexe-free="true">
              <span class="free-label">{{ s.free_label | default: 'FREE' | escape }}</span>
              {%- if s.free_condition_text != blank -%}
                <span class="free-condition">{{ s.free_condition_text | replace: '[min]', lx_lbl | replace: '$49', lx_lbl | escape }}{% if s.free_link_text != blank and s.free_link_url != blank %} <a href="{{ s.free_link_url }}">{{ s.free_link_text | escape }}</a>{% endif %}</span>
              {%- endif -%}
            </div>
          {%- else -%}
          <div class="apex-single-price-{{ sid }}">
            <span>{{ cv.price | money }}</span>
            {%- if cv.compare_at_price > cv.price -%}
              <span class="price-compare">{{ cv.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
          {%- endif -%}
          {%- if lexe_free and s.free_description != blank -%}
            <div class="apex-single-desc-{{ sid }}">
              {{ s.free_description | escape }}
            </div>
          {%- elsif product.description != blank -%}
            <div class="apex-single-desc-{{ sid }}">
              {{ product.description | strip_html | truncate: 280 }}
            </div>
          {%- endif -%}
          {%- if cv.available -%}
            {%- liquid
                assign lexe_atc_label = 'products.product.add_to_cart' | t
                if lexe_free and s.free_button_label != blank
                  assign lexe_atc_label = s.free_button_label
                endif
              -%}
            <form action="{{ routes.cart_add_url }}" method="post" class="apex-atc-form-{{ sid }}"
              data-orig="{{ lexe_atc_label | escape }}">
              <input type="hidden" name="id"       value="{{ cv.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="apex-single-buy-{{ sid }}">
                {{ lexe_atc_label | escape }}
              </button>
            </form>
          {%- else -%}
            <button class="apex-single-buy-{{ sid }}" disabled>
              {{ 'products.product.sold_out' | t }}
            </button>
          {%- endif -%}
          <a href="{{ product.url }}" style="display:inline-block;margin-top:14px;color:var(--apex-accent);text-decoration:none;font-size:14px;font-weight:500;">
            {{ 'products.product.view_full_details' | t | default: 'View full details' }} &rarr;
          </a>
        </div>
      </div>
    {%- else -%}
      <p style="text-align:center;color:var(--apex-fg-muted);">Add products in the section settings.</p>
    {%- endif -%}

  {%- elsif mode == 'grid' -%}
  {%- comment -%} ═══ GRID MODE ═══ {%- endcomment -%}

    {%- if s.title != blank or s.eyebrow != blank -%}
      <div class="apex-head-{{ sid }}">
        <div>
          {%- if s.eyebrow != blank -%}<span class="apex-eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
          {%- if s.title != blank -%}<h2>{{ s.title | escape }}</h2>{%- endif -%}
        </div>
        {%- if s.show_view_all and source_kind == 'collection' and s.source_collection != blank -%}
          <a href="{{ s.source_collection.url }}" style="font-size:14px;font-weight:500;color:var(--apex-accent);text-decoration:none;white-space:nowrap;">
            {{ s.view_all_text | default: 'View all' }} &rarr;
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign grid_has_items = false
      if source_kind == 'collection' and s.source_collection.products_count > 0
        assign grid_has_items = true
      elsif source_kind == 'blocks' and p_blocks.size > 0
        assign grid_has_items = true
      endif
    -%}

    {%- if grid_has_items -%}
      <div class="apex-grid-{{ sid }}" data-apex-grid{% if s.grid_hero_first and grid_hero_auto %} data-apex-hero-auto="true"{% endif %}>

        {%- if source_kind == 'collection' -%}
          {%- if grid_hero_product != blank -%}
            {%- liquid
              assign p    = grid_hero_product
              assign pcv  = p.first_available_variant
              if pcv == nil
                assign pcv = p.selected_or_first_available_variant
              endif
              if pcv == nil
                assign pcv = p.variants.first
              endif
              assign pimg  = nil
              assign pimg2 = nil
              if pcv != nil
                assign pimg = pcv.featured_image
              endif
              if pimg == nil
                assign pimg = p.featured_image
              endif
              if pimg == nil and p.images.size > 0
                assign pimg = p.images.first
              endif
              if p.images.size > 1
                assign pimg2 = p.images[1]
              endif
              assign on_sale  = false
              assign disc_pct = 0
              if pcv != nil and pcv.compare_at_price > pcv.price
                assign on_sale  = true
                assign disc_pct = pcv.compare_at_price | minus: pcv.price | times: 100 | divided_by: pcv.compare_at_price
              endif
              assign is_new = false
              if s.new_tag != blank and p.tags contains s.new_tag
                assign is_new = true
              endif
              assign low_stock = false
              if s.show_low_stock and pcv != nil and pcv.inventory_management != blank and pcv.inventory_quantity > 0 and pcv.inventory_quantity <= s.low_stock_threshold
                assign low_stock = true
              endif
            -%}
            <div class="apex-gc-{{ sid }} is-hero{% unless pcv.available %} is-sold-out{% endunless %}"
              style="--apex-stagger:0" data-apex-gcard>
              <div class="apex-gi-{{ sid }} is-hero">
                <a href="{{ p.url }}" class="apex-glink-{{ sid }}" aria-label="{{ p.title | escape }}" tabindex="0">
                  {%- if pimg -%}
                    <img class="img-p"
                      src="{{ pimg | image_url: width: 800 }}"
                      srcset="{{ pimg | image_url: width: 400 }} 400w, {{ pimg | image_url: width: 800 }} 800w, {{ pimg | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 1024px) calc({{ 100 | divided_by: s.grid_cols_desktop | default: 25 }}vw - 24px), 48vw"
                      alt="{{ pimg.alt | default: p.title | escape }}"
                      loading="lazy" decoding="async"
                      width="{{ pimg.width }}" height="{{ pimg.height }}">
                    {%- if s.grid_second_image and pimg2 != nil -%}
                      <img class="img-s"
                        src="{{ pimg2 | image_url: width: 800 }}"
                        srcset="{{ pimg2 | image_url: width: 400 }} 400w, {{ pimg2 | image_url: width: 800 }} 800w"
                        sizes="48vw"
                        alt="{{ pimg2.alt | default: p.title | escape }}"
                        loading="lazy" decoding="async"
                        width="{{ pimg2.width }}" height="{{ pimg2.height }}">
                    {%- endif -%}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                  {%- endif -%}
                </a>
                {%- unless pcv.available -%}<div class="apex-gsold-{{ sid }}">{{ 'products.product.sold_out' | t }}</div>{%- endunless -%}
                {%- if on_sale -%}
                  <span class="apex-gbadge-{{ sid }} is-sale">{%- if s.show_discount_pct and disc_pct > 0 -%}-{{ disc_pct }}%{%- else -%}{{ 'products.product.on_sale' | t | default: 'Sale' }}{%- endif -%}</span>
                {%- endif -%}
                {%- if is_new -%}<span class="apex-gbadge-{{ sid }} is-new">{{ s.new_tag_label | default: 'New' | escape }}</span>{%- endif -%}
                {%- if s.show_quick_add -%}
                  <div class="apex-gqa-{{ sid }}">
                    {%- if pcv.available -%}
                      {%- if p.has_only_default_variant -%}
                        <form action="{{ routes.cart_add_url }}" method="post" class="apex-atc-form-{{ sid }}" data-orig="{{ 'products.product.add_to_cart' | t | escape }}">
                          <input type="hidden" name="id" value="{{ pcv.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="apex-gqabtn-{{ sid }}">{{ 'products.product.add_to_cart' | t }}</button>
                        </form>
                      {%- else -%}
                        <a href="{{ p.url }}" class="apex-gqabtn-{{ sid }}">{{ s.options_text | default: 'Choose Options' | escape }}</a>
                      {%- endif -%}
                    {%- else -%}
                      <button class="apex-gqabtn-{{ sid }}" disabled>{{ 'products.product.sold_out' | t }}</button>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              <div class="apex-ginfo-{{ sid }}">
                {%- if s.show_vendor and p.vendor != blank -%}<span class="apex-gvendor-{{ sid }}">{{ p.vendor | escape }}</span>{%- endif -%}
                <p class="apex-gtitle-{{ sid }}"><a href="{{ p.url }}">{{ p.title | escape }}</a></p>
                {%- unless p.has_only_default_variant -%}
                  {%- for opt in p.options_with_values -%}
                    {%- assign dn = opt.name | downcase -%}
                    {%- if dn == 'color' or dn == 'colour' -%}
                      <div class="apex-gswatches-{{ sid }}">
                        {%- for val in opt.values limit: 6 -%}<span class="apex-gswatch-{{ sid }}" title="{{ val | escape }}" style="background:{{ val | handle }};"></span>{%- endfor -%}
                        {%- if opt.values.size > 6 -%}<span class="apex-gswatch-more-{{ sid }}">+{{ opt.values.size | minus: 6 }}</span>{%- endif -%}
                      </div>
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endunless -%}
                <div class="apex-gprice-{{ sid }}">
                  <span class="gp-current">{% if pcv != nil %}{{ pcv.price | money }}{% else %}{{ p.price | money }}{% endif %}</span>
                  {%- if on_sale -%}<span class="gp-compare">{{ pcv.compare_at_price | money }}</span>{%- endif -%}
                  {%- if low_stock -%}<span class="gp-low-stock">{{ s.low_stock_text | default: 'Low stock' | escape }}</span>{%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- for p in s.source_collection.products limit: grid_max -%}
            {%- liquid
              # Skip if this is the manually-set hero (already rendered above)
              assign skip = false
              if grid_hero_product != blank and p.id == grid_hero_product.id
                assign skip = true
              endif
            -%}
            {%- unless skip -%}
            {%- liquid
              assign pcv = p.first_available_variant
              if pcv == nil
                assign pcv = p.selected_or_first_available_variant
              endif
              if pcv == nil
                assign pcv = p.variants.first
              endif

              assign pimg  = nil
              assign pimg2 = nil
              if pcv != nil
                assign pimg = pcv.featured_image
              endif
              if pimg == nil
                assign pimg = p.featured_image
              endif
              if pimg == nil and p.images.size > 0
                assign pimg = p.images.first
              endif
              if p.images.size > 1
                assign pimg2 = p.images[1]
              endif

              assign on_sale = false
              assign disc_pct = 0
              if pcv != nil and pcv.compare_at_price > pcv.price
                assign on_sale = true
                assign disc_pct = pcv.compare_at_price | minus: pcv.price | times: 100 | divided_by: pcv.compare_at_price
              endif

              assign is_new = false
              if s.new_tag != blank and p.tags contains s.new_tag
                assign is_new = true
              endif

              assign low_stock = false
              if s.show_low_stock and pcv != nil and pcv.inventory_management != blank and pcv.inventory_quantity > 0 and pcv.inventory_quantity <= s.low_stock_threshold
                assign low_stock = true
              endif

              assign stagger_delay = forloop.index0 | times: 55
              if stagger_delay > 440
                assign stagger_delay = 440
              endif

              assign is_hero = false
              if s.grid_hero_first and grid_hero_auto and forloop.first
                assign is_hero = true
              endif
            -%}
            <div class="apex-gc-{{ sid }}{% if is_hero %} is-hero{% endif %}{% unless pcv.available %} is-sold-out{% endunless %}"
              style="--apex-stagger:{{ stagger_delay }}" data-apex-gcard>
              <div class="apex-gi-{{ sid }}{% if is_hero %} is-hero{% endif %}">
                <a href="{{ p.url }}" class="apex-glink-{{ sid }}" aria-label="{{ p.title | escape }}" tabindex="0">
                  {%- if pimg -%}
                    <img class="img-p"
                      src="{{ pimg | image_url: width: 800 }}"
                      srcset="{{ pimg | image_url: width: 400 }} 400w, {{ pimg | image_url: width: 800 }} 800w, {{ pimg | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 1024px) calc({{ 100 | divided_by: s.grid_cols_desktop | default: 25 }}vw - 24px), (min-width: 600px) calc({{ 100 | divided_by: s.grid_cols_tablet | default: 50 }}vw - 20px), 48vw"
                      alt="{{ pimg.alt | default: p.title | escape }}"
                      loading="lazy" decoding="async"
                      width="{{ pimg.width }}" height="{{ pimg.height }}">
                    {%- if s.grid_second_image and pimg2 != nil -%}
                      <img class="img-s"
                        src="{{ pimg2 | image_url: width: 800 }}"
                        srcset="{{ pimg2 | image_url: width: 400 }} 400w, {{ pimg2 | image_url: width: 800 }} 800w"
                        sizes="(min-width: 1024px) calc({{ 100 | divided_by: s.grid_cols_desktop | default: 25 }}vw - 24px), 48vw"
                        alt="{{ pimg2.alt | default: p.title | escape }}"
                        loading="lazy" decoding="async"
                        width="{{ pimg2.width }}" height="{{ pimg2.height }}">
                    {%- endif -%}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                  {%- endif -%}
                </a>

                {%- unless pcv.available -%}
                  <div class="apex-gsold-{{ sid }}">{{ 'products.product.sold_out' | t }}</div>
                {%- endunless -%}

                {%- if on_sale -%}
                  <span class="apex-gbadge-{{ sid }} is-sale">
                    {%- if s.show_discount_pct and disc_pct > 0 -%}-{{ disc_pct }}%{%- else -%}{{ 'products.product.on_sale' | t | default: 'Sale' }}{%- endif -%}
                  </span>
                {%- endif -%}
                {%- if is_new -%}
                  <span class="apex-gbadge-{{ sid }} is-new">{{ s.new_tag_label | default: 'New' | escape }}</span>
                {%- endif -%}

                {%- if s.show_quick_add -%}
                  <div class="apex-gqa-{{ sid }}">
                    {%- if pcv.available -%}
                      {%- if p.has_only_default_variant -%}
                        <form action="{{ routes.cart_add_url }}" method="post" class="apex-atc-form-{{ sid }}"
                          data-orig="{{ 'products.product.add_to_cart' | t | escape }}">
                          <input type="hidden" name="id"       value="{{ pcv.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="apex-gqabtn-{{ sid }}">
                            {{ 'products.product.add_to_cart' | t }}
                          </button>
                        </form>
                      {%- else -%}
                        <a href="{{ p.url }}" class="apex-gqabtn-{{ sid }}">
                          {{ s.options_text | default: 'Choose Options' | escape }}
                        </a>
                      {%- endif -%}
                    {%- else -%}
                      <button class="apex-gqabtn-{{ sid }}" disabled>{{ 'products.product.sold_out' | t }}</button>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

              <div class="apex-ginfo-{{ sid }}">
                {%- if s.show_vendor and p.vendor != blank -%}
                  <span class="apex-gvendor-{{ sid }}">{{ p.vendor | escape }}</span>
                {%- endif -%}
                <p class="apex-gtitle-{{ sid }}"><a href="{{ p.url }}">{{ p.title | escape }}</a></p>
                {%- unless p.has_only_default_variant -%}
                  {%- for opt in p.options_with_values -%}
                    {%- assign dn = opt.name | downcase -%}
                    {%- if dn == 'color' or dn == 'colour' -%}
                      <div class="apex-gswatches-{{ sid }}">
                        {%- for val in opt.values limit: 6 -%}
                          <span class="apex-gswatch-{{ sid }}" title="{{ val | escape }}" style="background:{{ val | handle }};"></span>
                        {%- endfor -%}
                        {%- if opt.values.size > 6 -%}
                          <span class="apex-gswatch-more-{{ sid }}">+{{ opt.values.size | minus: 6 }}</span>
                        {%- endif -%}
                      </div>
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endunless -%}
                <div class="apex-gprice-{{ sid }}">
                  <span class="gp-current">{% if pcv != nil %}{{ pcv.price | money }}{% else %}{{ p.price | money }}{% endif %}</span>
                  {%- if on_sale -%}<span class="gp-compare">{{ pcv.compare_at_price | money }}</span>{%- endif -%}
                  {%- if low_stock -%}<span class="gp-low-stock">{{ s.low_stock_text | default: 'Low stock' | escape }}</span>{%- endif -%}
                </div>
              </div>
            </div>
            {%- endunless -%}
          {%- endfor -%}

        {%- elsif source_kind == 'blocks' -%}
          {%- for block in p_blocks limit: grid_max -%}
            {%- assign p = block.settings.product -%}
            {%- if p != blank -%}
              {%- liquid
                assign pcv = p.first_available_variant
                if pcv == nil
                  assign pcv = p.selected_or_first_available_variant
                endif
                if pcv == nil
                  assign pcv = p.variants.first
                endif
                assign pimg  = nil
                assign pimg2 = nil
                if pcv != nil
                  assign pimg = pcv.featured_image
                endif
                if pimg == nil
                  assign pimg = p.featured_image
                endif
                if pimg == nil and p.images.size > 0
                  assign pimg = p.images.first
                endif
                if p.images.size > 1
                  assign pimg2 = p.images[1]
                endif
                assign on_sale = false
                assign disc_pct = 0
                if pcv != nil and pcv.compare_at_price > pcv.price
                  assign on_sale = true
                  assign disc_pct = pcv.compare_at_price | minus: pcv.price | times: 100 | divided_by: pcv.compare_at_price
                endif
                assign is_new = false
                if s.new_tag != blank and p.tags contains s.new_tag
                  assign is_new = true
                endif
                assign low_stock = false
                if s.show_low_stock and pcv != nil and pcv.inventory_management != blank and pcv.inventory_quantity > 0 and pcv.inventory_quantity <= s.low_stock_threshold
                  assign low_stock = true
                endif
                assign stagger_delay = forloop.index0 | times: 55
                if stagger_delay > 440
                  assign stagger_delay = 440
                endif
                assign is_hero = false
                if s.grid_hero_first and grid_hero_auto and forloop.first
                  assign is_hero = true
                endif
              -%}
              <div class="apex-gc-{{ sid }}{% if is_hero %} is-hero{% endif %}{% unless pcv.available %} is-sold-out{% endunless %}"
                style="--apex-stagger:{{ stagger_delay }}" {{ block.shopify_attributes }} data-apex-gcard>
                <div class="apex-gi-{{ sid }}{% if is_hero %} is-hero{% endif %}">
                  <a href="{{ p.url }}" class="apex-glink-{{ sid }}" aria-label="{{ p.title | escape }}" tabindex="0">
                    {%- if pimg -%}
                      <img class="img-p"
                        src="{{ pimg | image_url: width: 800 }}"
                        srcset="{{ pimg | image_url: width: 400 }} 400w, {{ pimg | image_url: width: 800 }} 800w, {{ pimg | image_url: width: 1200 }} 1200w"
                        sizes="(min-width: 1024px) calc({{ 100 | divided_by: s.grid_cols_desktop | default: 25 }}vw - 24px), (min-width: 600px) calc({{ 100 | divided_by: s.grid_cols_tablet | default: 50 }}vw - 20px), 48vw"
                        alt="{{ pimg.alt | default: p.title | escape }}"
                        loading="lazy" decoding="async"
                        width="{{ pimg.width }}" height="{{ pimg.height }}">
                      {%- if s.grid_second_image and pimg2 != nil -%}
                        <img class="img-s"
                          src="{{ pimg2 | image_url: width: 800 }}"
                          srcset="{{ pimg2 | image_url: width: 400 }} 400w, {{ pimg2 | image_url: width: 800 }} 800w"
                          sizes="48vw"
                          alt="{{ pimg2.alt | default: p.title | escape }}"
                          loading="lazy" decoding="async"
                          width="{{ pimg2.width }}" height="{{ pimg2.height }}">
                      {%- endif -%}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                    {%- endif -%}
                  </a>

                  {%- unless pcv.available -%}
                    <div class="apex-gsold-{{ sid }}">{{ 'products.product.sold_out' | t }}</div>
                  {%- endunless -%}

                  {%- if on_sale -%}
                    <span class="apex-gbadge-{{ sid }} is-sale">
                      {%- if s.show_discount_pct and disc_pct > 0 -%}-{{ disc_pct }}%{%- else -%}{{ 'products.product.on_sale' | t | default: 'Sale' }}{%- endif -%}
                    </span>
                  {%- endif -%}
                  {%- if is_new -%}
                    <span class="apex-gbadge-{{ sid }} is-new">{{ s.new_tag_label | default: 'New' | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.badge != blank -%}
                    <span class="apex-gbadge-{{ sid }} is-custom">{{ block.settings.badge | escape }}</span>
                  {%- endif -%}

                  {%- if s.show_quick_add -%}
                    <div class="apex-gqa-{{ sid }}">
                      {%- if pcv.available -%}
                        {%- if p.has_only_default_variant -%}
                          <form action="{{ routes.cart_add_url }}" method="post" class="apex-atc-form-{{ sid }}"
                            data-orig="{{ 'products.product.add_to_cart' | t | escape }}">
                            <input type="hidden" name="id"       value="{{ pcv.id }}">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="apex-gqabtn-{{ sid }}">{{ 'products.product.add_to_cart' | t }}</button>
                          </form>
                        {%- else -%}
                          <a href="{{ p.url }}" class="apex-gqabtn-{{ sid }}">{{ s.options_text | default: 'Choose Options' | escape }}</a>
                        {%- endif -%}
                      {%- else -%}
                        <button class="apex-gqabtn-{{ sid }}" disabled>{{ 'products.product.sold_out' | t }}</button>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>

                <div class="apex-ginfo-{{ sid }}">
                  {%- if s.show_vendor and p.vendor != blank -%}
                    <span class="apex-gvendor-{{ sid }}">{{ p.vendor | escape }}</span>
                  {%- endif -%}
                  <p class="apex-gtitle-{{ sid }}"><a href="{{ p.url }}">{{ p.title | escape }}</a></p>
                  {%- unless p.has_only_default_variant -%}
                    {%- for opt in p.options_with_values -%}
                      {%- assign dn = opt.name | downcase -%}
                      {%- if dn == 'color' or dn == 'colour' -%}
                        <div class="apex-gswatches-{{ sid }}">
                          {%- for val in opt.values limit: 6 -%}
                            <span class="apex-gswatch-{{ sid }}" title="{{ val | escape }}" style="background:{{ val | handle }};"></span>
                          {%- endfor -%}
                          {%- if opt.values.size > 6 -%}
                            <span class="apex-gswatch-more-{{ sid }}">+{{ opt.values.size | minus: 6 }}</span>
                          {%- endif -%}
                        </div>
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endunless -%}
                  <div class="apex-gprice-{{ sid }}">
                    <span class="gp-current">{% if pcv != nil %}{{ pcv.price | money }}{% else %}{{ p.price | money }}{% endif %}</span>
                    {%- if on_sale -%}<span class="gp-compare">{{ pcv.compare_at_price | money }}</span>{%- endif -%}
                    {%- if low_stock -%}<span class="gp-low-stock">{{ s.low_stock_text | default: 'Low stock' | escape }}</span>{%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

      </div>{%- comment -%}/apex-grid{%- endcomment -%}

      {%- if s.show_view_all and source_kind == 'collection' and s.source_collection != blank -%}
        <div class="apex-gviewall-{{ sid }}">
          <a href="{{ s.source_collection.url }}">
            {{ s.view_all_text | default: 'View all' | escape }}
            <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      <p style="text-align:center;color:var(--apex-fg-muted);padding:40px 0;">
        Pick a collection or add Product blocks in the section settings.
      </p>
    {%- endif -%}

  {%- else -%}
  {%- comment -%} ═══ SHOWCASE (dual-row marquee) ═══ {%- endcomment -%}

    {%- if s.title != blank or s.eyebrow != blank or s.autoscroll_enabled -%}
      <div class="apex-head-{{ sid }}">
        <div>
          {%- if s.eyebrow != blank -%}<span class="apex-eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
          {%- if s.title != blank -%}<h2>{{ s.title | escape }}</h2>{%- endif -%}
        </div>
        {%- if s.autoscroll_enabled and s.show_pause_button -%}
          <div class="apex-controls-{{ sid }}">
            <button type="button" class="apex-pause-{{ sid }}" data-apex-pause data-paused="false"
              aria-label="Pause auto-scroll">
              <svg class="apex-icon-pause" viewBox="0 0 12 12" aria-hidden="true">
                <rect x="3" y="2" width="2" height="8" rx="0.5"/>
                <rect x="7" y="2" width="2" height="8" rx="0.5"/>
              </svg>
              <svg class="apex-icon-play" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M3 2 L10 6 L3 10 Z"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- capture cards -%}
      {%- if source_kind == 'collection' -%}
        {%- for p in s.source_collection.products limit: max_products -%}
          {%- liquid
            assign pcv = p.first_available_variant
            if pcv == nil
              assign pcv = p.selected_or_first_available_variant
            endif
            if pcv == nil
              assign pcv = p.variants.first
            endif
            assign pimg = nil
            if pcv != nil
              assign pimg = pcv.featured_image
            endif
            if pimg == nil
              assign pimg = p.featured_image
            endif
            if pimg == nil and p.images.size > 0
              assign pimg = p.images.first
            endif
            assign on_sale = false
            if pcv != nil and pcv.compare_at_price > pcv.price
              assign on_sale = true
            endif
          -%}
          <div class="apex-card-{{ sid }}">
            <a href="{{ p.url }}" class="apex-card-img-{{ sid }}" aria-label="{{ p.title | escape }}" tabindex="-1">
              {%- if pimg -%}
                <img
                  src="{{ pimg | image_url: width: 600 }}"
                  srcset="{{ pimg | image_url: width: 300 }} 300w, {{ pimg | image_url: width: 600 }} 600w, {{ pimg | image_url: width: 900 }} 900w"
                  sizes="{{ computed_width }}px"
                  alt="{{ pimg.alt | default: p.title | escape }}"
                  loading="lazy" decoding="async"
                  width="{{ pimg.width }}" height="{{ pimg.height }}">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
              {%- if on_sale -%}<span class="apex-sale-{{ sid }}">{{ 'products.product.on_sale' | t | default: 'Sale' }}</span>{%- endif -%}
            </a>
            <div class="apex-card-info-{{ sid }}">
              <p class="apex-card-name-{{ sid }}"><a href="{{ p.url }}">{{ p.title | escape }}</a></p>
              <div class="apex-card-price-{{ sid }}">
                <span class="price-current">{% if pcv != nil %}{{ pcv.price | money }}{% else %}{{ p.price | money }}{% endif %}</span>
                {%- if on_sale -%}<span class="price-compare">{{ pcv.compare_at_price | money }}</span>{%- endif -%}
              </div>
              {%- unless p.has_only_default_variant -%}
                {%- for opt in p.options_with_values -%}
                  {%- assign dn = opt.name | downcase -%}
                  {%- if dn == 'color' or dn == 'colour' -%}
                    <div class="apex-swatches-{{ sid }}">
                      {%- for val in opt.values limit: 5 -%}
                        <span class="apex-swatch-{{ sid }}{% if opt.selected_value == val %} active{% endif %}"
                          title="{{ val | escape }}" style="background:{{ val | handle }};"></span>
                      {%- endfor -%}
                      {%- if opt.values.size > 5 -%}
                        <span class="apex-swatch-more-{{ sid }}">+{{ opt.values.size | minus: 5 }}</span>
                      {%- endif -%}
                    </div>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endunless -%}
              {%- if s.show_quick_add -%}
                {%- if pcv.available -%}
                  <form action="{{ routes.cart_add_url }}" method="post" class="apex-atc-form-{{ sid }}"
                    data-orig="{% if p.has_only_default_variant %}{{ 'products.product.add_to_cart' | t | escape }}{% else %}{{ s.quick_add_text | default: 'Quick Add' | escape }}{% endif %}">
                    <input type="hidden" name="id"       value="{{ pcv.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="apex-atc-{{ sid }}">
                      {%- if p.has_only_default_variant -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ s.quick_add_text | default: 'Quick Add' }}{%- endif -%}
                    </button>
                  </form>
                {%- else -%}
                  <button class="apex-atc-{{ sid }}" disabled>{{ 'products.product.sold_out' | t }}</button>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- elsif source_kind == 'blocks' -%}
        {%- for block in p_blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- liquid
              assign pcv = p.first_available_variant
              if pcv == nil
                assign pcv = p.selected_or_first_available_variant
              endif
              if pcv == nil
                assign pcv = p.variants.first
              endif
              assign pimg = nil
              if pcv != nil
                assign pimg = pcv.featured_image
              endif
              if pimg == nil
                assign pimg = p.featured_image
              endif
              if pimg == nil and p.images.size > 0
                assign pimg = p.images.first
              endif
              assign on_sale = false
              if pcv != nil and pcv.compare_at_price > pcv.price
                assign on_sale = true
              endif
            -%}
            <div class="apex-card-{{ sid }}" {{ block.shopify_attributes }}>
              <a href="{{ p.url }}" class="apex-card-img-{{ sid }}" aria-label="{{ p.title | escape }}" tabindex="-1">
                {%- if pimg -%}
                  <img
                    src="{{ pimg | image_url: width: 600 }}"
                    srcset="{{ pimg | image_url: width: 300 }} 300w, {{ pimg | image_url: width: 600 }} 600w, {{ pimg | image_url: width: 900 }} 900w"
                    sizes="{{ computed_width }}px"
                    alt="{{ pimg.alt | default: p.title | escape }}"
                    loading="lazy" decoding="async"
                    width="{{ pimg.width }}" height="{{ pimg.height }}">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
                {%- if block.settings.badge != blank -%}<span class="apex-badge-{{ sid }}">{{ block.settings.badge | escape }}</span>{%- endif -%}
                {%- if on_sale -%}<span class="apex-sale-{{ sid }}">{{ 'products.product.on_sale' | t | default: 'Sale' }}</span>{%- endif -%}
              </a>
              <div class="apex-card-info-{{ sid }}">
                <p class="apex-card-name-{{ sid }}"><a href="{{ p.url }}">{{ p.title | escape }}</a></p>
                <div class="apex-card-price-{{ sid }}">
                  <span class="price-current">{% if pcv != nil %}{{ pcv.price | money }}{% else %}{{ p.price | money }}{% endif %}</span>
                  {%- if on_sale -%}<span class="price-compare">{{ pcv.compare_at_price | money }}</span>{%- endif -%}
                </div>
                {%- unless p.has_only_default_variant -%}
                  {%- for opt in p.options_with_values -%}
                    {%- assign dn = opt.name | downcase -%}
                    {%- if dn == 'color' or dn == 'colour' -%}
                      <div class="apex-swatches-{{ sid }}">
                        {%- for val in opt.values limit: 5 -%}
                          <span class="apex-swatch-{{ sid }}{% if opt.selected_value == val %} active{% endif %}"
                            title="{{ val | escape }}" style="background:{{ val | handle }};"></span>
                        {%- endfor -%}
                        {%- if opt.values.size > 5 -%}
                          <span class="apex-swatch-more-{{ sid }}">+{{ opt.values.size | minus: 5 }}</span>
                        {%- endif -%}
                      </div>
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endunless -%}
                {%- if s.show_quick_add -%}
                  {%- if pcv.available -%}
                    <form action="{{ routes.cart_add_url }}" method="post" class="apex-atc-form-{{ sid }}"
                      data-orig="{% if p.has_only_default_variant %}{{ 'products.product.add_to_cart' | t | escape }}{% else %}{{ s.quick_add_text | default: 'Quick Add' | escape }}{% endif %}">
                      <input type="hidden" name="id"       value="{{ pcv.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="apex-atc-{{ sid }}">
                        {%- if p.has_only_default_variant -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ s.quick_add_text | default: 'Quick Add' }}{%- endif -%}
                      </button>
                    </form>
                  {%- else -%}
                    <button class="apex-atc-{{ sid }}" disabled>{{ 'products.product.sold_out' | t }}</button>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if item_count == 0 -%}
      <p style="text-align:center;color:var(--apex-fg-muted);padding:40px 0;">
        Pick a collection in the section settings, or add Product blocks to start.
      </p>
    {%- else -%}
      <div class="apex-marquee-{{ sid }}" data-apex-marquee>
        <div class="apex-track-{{ sid }} {% if s.autoscroll_enabled %}is-{{ s.row1_direction }}{% endif %}">
          {{ cards }}{{ cards }}
        </div>
      </div>
      {%- if s.show_second_row -%}
        <div class="apex-marquee-{{ sid }}" data-apex-marquee>
          <div class="apex-track-{{ sid }} {% if s.autoscroll_enabled %}is-{{ s.row2_direction }}{% endif %}">
            {{ cards }}{{ cards }}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  {%- endif -%}

  </div>
</div>

<script>
(function() {
  'use strict';

  /* ── Shared ATC handler (showcase + grid single-variant forms) ── */
  function apexAtcSubmit(e) {
    var form = e.target;
    if (!form || !form.className || form.className.indexOf('apex-atc-form-') === -1) return;
    e.preventDefault();
    var btn      = form.querySelector('button[type="submit"]');
    var origText = form.getAttribute('data-orig') || 'Quick Add';
    if (btn) { btn.setAttribute('data-state', 'loading'); btn.disabled = true; }

    fetch('/cart/add.js', { method: 'POST', body: new FormData(form) })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.status && data.status !== 200) throw new Error(data.description || 'Cart error');
        document.dispatchEvent(new CustomEvent('cart:item-added', { bubbles: true, detail: data }));
        document.dispatchEvent(new CustomEvent('cart:refresh',    { bubbles: true }));
        return fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
          document.querySelectorAll(
            '[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,.cart-count-bubble,.cart-icon-bubble'
          ).forEach(function(el) {
            if ('cartCount'     in el.dataset) el.dataset.cartCount     = cart.item_count;
            if ('cartItemCount' in el.dataset) el.dataset.cartItemCount = cart.item_count;
            if (!el.dataset.cartCount && !el.dataset.cartItemCount) el.textContent = cart.item_count;
          });
          if (btn) {
            btn.setAttribute('data-state', 'added');
            btn.disabled    = false;
            btn.textContent = '\u2713 ' + ({{ s.added_text | default: 'Added' | json }});
            setTimeout(function() {
              if (btn && btn.getAttribute('data-state') === 'added') {
                btn.removeAttribute('data-state');
                btn.textContent = origText;
              }
            }, 2200);
          }
        });
      })
      .catch(function() {
        if (btn) { btn.removeAttribute('data-state'); btn.disabled = false; btn.textContent = origText; }
      });
  }
  document.addEventListener('submit', apexAtcSubmit);

  var section = document.getElementById('shopify-section-{{ sid }}');
  if (!section) return;

  /* ── Showcase marquee: IntersectionObserver pause off-screen ── */
  var marquees = section.querySelectorAll('[data-apex-marquee]');
  if (marquees.length && 'IntersectionObserver' in window) {
    var mio = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.target.classList.contains('is-user-paused')) return;
        if (entry.isIntersecting) entry.target.classList.remove('is-paused');
        else                      entry.target.classList.add('is-paused');
      });
    }, { threshold: 0 });
    marquees.forEach(function(m) { mio.observe(m); });
  }

  var pauseBtn = section.querySelector('[data-apex-pause]');
  if (pauseBtn) {
    pauseBtn.addEventListener('click', function() {
      var paused   = pauseBtn.getAttribute('data-paused') === 'true';
      var newState = !paused;
      pauseBtn.setAttribute('data-paused', String(newState));
      pauseBtn.setAttribute('aria-label', newState ? 'Resume auto-scroll' : 'Pause auto-scroll');
      marquees.forEach(function(m) {
        m.classList.toggle('is-user-paused', newState);
        if (newState) m.classList.add('is-paused');
        else          m.classList.remove('is-paused');
      });
    });
  }

  /* ── Grid: stagger-in on IntersectionObserver ── */
  var grid = section.querySelector('[data-apex-grid]');
  if (grid && 'IntersectionObserver' in window) {
    var gio = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          gio.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    gio.observe(grid);
  } else if (grid) {
    grid.classList.add('is-visible');
  }

  /* ── Grid: auto-rotate hero every 3s (only when no product manually set) ── */
  if (grid && grid.dataset.apexHeroAuto === 'true') {
    var gcards = Array.from(grid.querySelectorAll('[data-apex-gcard]'));
    if (gcards.length > 1) {
      var heroIdx = 0;

      function apexSetHero(nextIdx) {
        var prev = gcards[heroIdx];
        var next = gcards[nextIdx];

        prev.classList.add('is-switching');
        next.classList.add('is-switching');

        setTimeout(function() {
          /* Demote old hero */
          prev.classList.remove('is-hero', 'is-switching');
          prev.querySelector('.apex-gi-{{ sid }}').classList.remove('is-hero');
          prev.style.order = '';

          /* Zero stagger on next card so fade-in has no delay */
          next.style.setProperty('--apex-stagger', '0');
          next.classList.add('is-hero');
          next.classList.remove('is-switching');
          next.querySelector('.apex-gi-{{ sid }}').classList.add('is-hero');
          next.style.order = '-1';

          heroIdx = nextIdx;
        }, 240);
      }

      /* Start: first card is hero at natural DOM position (no order needed) */
      gcards[0].classList.add('is-hero');
      gcards[0].querySelector('.apex-gi-{{ sid }}').classList.add('is-hero');
      gcards[0].style.setProperty('--apex-stagger', '0');

      setInterval(function() {
        apexSetHero((heroIdx + 1) % gcards.length);
      }, 3000);
    }
  }
})();
</script>

{%- if mode == 'single' -%}
<script>
(function () {
  'use strict';
  var root = document.getElementById('lx-sel-{{ sid }}');
  if (!root) return;
  var KEY = 'lexe_gift_pending';
  var CODE = root.getAttribute('data-code') || 'LEXESPECS';
  var vp = root.querySelector('[data-lx-viewport]');
  var track = root.querySelector('[data-lx-track]');
  var slides = Array.prototype.slice.call(root.querySelectorAll('[data-lx-slide]'));
  var panels = Array.prototype.slice.call(root.querySelectorAll('[data-lx-panel]'));
  var announce = root.querySelector('[data-lx-announce]');
  var counter = root.querySelector('[data-lx-counter]');
  var form = root.querySelector('form.lx-claim');
  var claimWrap = root.querySelector('[data-lx-claim-wrap]');
  var buyWrap = root.querySelector('[data-lx-buy-wrap]');
  var buyId = root.querySelector('[data-lx-buy-id]');
  var email = root.querySelector('.lx-email');
  var btn = root.querySelector('[data-lx-claim]');
  var msg = root.querySelector('[data-lx-msg]');
  var hiddenVariant = root.querySelector('[data-lx-variant]');
  var details = root.querySelector('[data-lx-details]');
  var prev = root.querySelector('[data-lx-prev]');
  var next = root.querySelector('[data-lx-next]');
  var n = slides.length;
  var idx = parseInt(root.getAttribute('data-start'), 10) || 0;
  if (idx >= n) idx = 0;
  var btnText = btn ? btn.textContent : '';

  function ss() { try { return window.sessionStorage; } catch (e) { return null; } }
  function money(c) { return '$' + (c / 100).toFixed(2); }
  function say(text, isError, linkHref, linkText) {
    if (!msg) return;
    msg.textContent = text || '';
    if (linkHref) {
      var a = document.createElement('a');
      a.href = linkHref; a.textContent = linkText || 'eligible items';
      msg.appendChild(document.createTextNode(' ')); msg.appendChild(a);
    }
    msg.classList.toggle('is-error', !!isError);
  }
  function busy(on, label) {
    if (!btn) return;
    btn.disabled = !!on;
    btn.textContent = on ? (label || 'Claiming…') : btnText;
  }
  function isGift(i) { var p = panels[i]; return !!p && p.getAttribute('data-lx-gift') === '1'; }
  /* the chosen variant control of a panel: a radio pill, or a select when a product has many variants */
  function currentChoice() {
    var p = panels[idx];
    if (!p) return null;
    var r = p.querySelector('input[type="radio"]:checked');
    if (r) return r;
    var sel = p.querySelector('select[data-lx-vs]');
    return sel && sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex] : null;
  }
  function syncVariant() {
    var r = currentChoice();
    var vid = r ? (r.value || r.getAttribute('value')) : '';
    if (hiddenVariant) hiddenVariant.value = vid || '';
    if (buyId) buyId.value = vid || '';
    var img = slides[idx] && slides[idx].querySelector('[data-lx-img]');
    if (r && img && r.getAttribute('data-img')) img.src = r.getAttribute('data-img');
    var p = panels[idx];
    if (p && !isGift(idx)) {
      var now = p.querySelector('[data-lx-now]'), was = p.querySelector('[data-lx-was]');
      if (r && now && r.getAttribute('data-price')) now.textContent = r.getAttribute('data-price');
      if (r && was) {
        var cmp = r.getAttribute('data-compare');
        was.textContent = cmp || '';
        was.hidden = !cmp;
      }
    }
  }
  /* products with many variants: the full list is fetched only when that product is first shown */
  var lazyDone = {};
  function loadVariants(i) {
    var p = panels[i];
    if (!p || lazyDone[i]) return;
    var sel = p.querySelector('select[data-lx-lazy]');
    if (!sel) return;
    lazyDone[i] = true;
    fetch('/products/' + encodeURIComponent(sel.getAttribute('data-lx-lazy')) + '.js', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (pr) {
        var cur = sel.value;
        function m(c) { return '$' + (c / 100).toFixed(2); } /* store currency is USD */
        var frag = document.createDocumentFragment();
        (pr.variants || []).forEach(function (v) {
          if (!v.available) return;
          var o = document.createElement('option');
          o.value = v.id; o.textContent = v.title;
          var im = (v.featured_image && v.featured_image.src) || (pr.featured_image || '');
          if (im) o.setAttribute('data-img', im.replace(/(\.[a-z]+)(\?|$)/i, '_400x400$1$2'));
          o.setAttribute('data-price', m(v.price));
          o.setAttribute('data-compare', v.compare_at_price && v.compare_at_price > v.price ? m(v.compare_at_price) : '');
          if (String(v.id) === String(cur)) o.selected = true;
          frag.appendChild(o);
        });
        if (frag.childNodes.length) { sel.innerHTML = ''; sel.appendChild(frag); }
        if (i === idx) syncVariant();
      }).catch(function () { lazyDone[i] = false; });
  }
  function syncMode() {
    var gift = isGift(idx);
    if (claimWrap) claimWrap.hidden = !gift;
    if (buyWrap) buyWrap.hidden = gift;
  }
  function center() {
    var s = slides[idx];
    if (!s || !vp) return;
    var tx = vp.clientWidth / 2 - (s.offsetLeft + s.offsetWidth / 2);
    track.style.transform = 'translateX(' + Math.round(tx) + 'px)';
  }
  function select(i, quiet) {
    if (!n) return;
    idx = ((i % n) + n) % n;
    slides.forEach(function (s, k) {
      s.classList.toggle('is-active', k === idx);
      s.setAttribute('aria-pressed', k === idx ? 'true' : 'false');
    });
    panels.forEach(function (p, k) { p.hidden = k !== idx; });
    if (details && panels[idx]) details.href = panels[idx].getAttribute('data-url');
    if (counter) counter.textContent = (idx + 1) + ' / ' + n;
    var eb = root.querySelector('[data-lx-eyebrow]'); if (eb) eb.hidden = !isGift(idx);
    say('');
    center();
    loadVariants(idx);
    syncVariant();
    syncMode();
    if (!quiet && announce && panels[idx]) {
      var name = panels[idx].querySelector('.lx-name');
      announce.textContent = (name ? name.textContent : '') + ' selected, ' + (idx + 1) + ' of ' + n;
    }
  }

  if (n < 2) {
    /* one product: no arrows, no counter, no swipe */
    var ar = root.querySelector('.lx-arrows'); if (ar) ar.hidden = true;
  } else {
    if (prev) prev.addEventListener('click', function () { select(idx - 1); });
    if (next) next.addEventListener('click', function () { select(idx + 1); });
    slides.forEach(function (s, k) { s.addEventListener('click', function () { select(k); }); });
    if (vp) {
      vp.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); select(idx - 1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); select(idx + 1); }
      });
      var x0 = null, y0 = null;
      vp.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
      vp.addEventListener('touchend', function (e) {
        if (x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) select(dx < 0 ? idx + 1 : idx - 1);
        x0 = null;
      }, { passive: true });
    }
  }
  root.addEventListener('change', function (e) {
    if (e.target && (e.target.matches('.lx-pill input') || e.target.matches('select[data-lx-vs]'))) syncVariant();
  });
  window.addEventListener('resize', center);
  window.addEventListener('load', center);

  /* ── Claim flow (gift products only) ── */
  function json(url, body) {
    return fetch(url, {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body)
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (d) {
        if (!r.ok) throw new Error(d.description || d.message || 'Something went wrong. Please try again.');
        return d;
      });
    });
  }
  /* eligible subtotal (cents) from the cart, worked out in Liquid so it matches the discount's own collection */
  function eligibleCents() {
    return fetch('/?sections=lexe-gift-check&t=' + Date.now(), { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var m = /data-cents="(-?\d+)"/.exec((d && d['lexe-gift-check']) || '');
        if (!m) throw new Error('check');
        return parseInt(m[1], 10);
      });
  }
  function finish(variantId, panelIndex) {
    busy(true, 'Checking your cart…');
    var pi = (typeof panelIndex === 'number') ? panelIndex : idx;
    var need = parseInt(panels[pi] && panels[pi].getAttribute('data-lx-min'), 10);
    var guard = (need > 0) ? eligibleCents() : Promise.reject(new Error('nocost'));
    return guard.then(function (have) {
      if (have < need) {
        var s0 = ss(); if (s0) s0.removeItem(KEY);
        busy(false);
        say('Add ' + money(need - have) + ' more in', true, root.getAttribute('data-elig-url') || '/collections/specs-offer-eligible', 'eligible items');
        msg.appendChild(document.createTextNode(' to claim this free pair.'));
        return null;
      }
      busy(true, 'Adding your pair…');
      return fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) { return r.json(); })
        .then(function (cart) {
          /* one gift per order: drop any earlier gift line */
          var updates = {}, had = false;
          (cart.items || []).forEach(function (it) {
            if (it.properties && it.properties._lexe_gift === '1') { updates[it.key] = 0; had = true; }
          });
          var codes = (cart.discount_codes || []).map(function (d) { return d.code; })
            .filter(function (c) { return c && c.toUpperCase() !== CODE.toUpperCase(); });
          codes.push(CODE);
          return (had ? json('/cart/update.js', { updates: updates }) : Promise.resolve())
            .then(function () { return json('/cart/add.js', { items: [{ id: Number(variantId), quantity: 1, properties: { _lexe_gift: '1' } }] }); })
            .then(function () { return json('/cart/update.js', { discount: codes.join(',') }).catch(function () { return null; }); });
        })
        .then(function (cart) {
          var applied = cart && (cart.discount_codes || []).some(function (d) { return d.code && d.code.toUpperCase() === CODE.toUpperCase(); });
          var s = ss(); if (s) s.removeItem(KEY);
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cart } }));
          window.location.href = applied ? '/cart' : '/discount/' + encodeURIComponent(CODE) + '?redirect=/cart';
        });
    }).catch(function (err) {
      var s = ss(); if (s) s.removeItem(KEY);
      busy(false);
      if (err && (err.message === 'check' || err.message === 'nocost')) { say('We could not check your cart just now. Please try again in a moment.', true); return; }
      say(/sold out|not available|already sold/i.test(err.message) ? 'Sorry, that option just sold out. Please pick another.' : err.message, true);
    });
  }
  function nativeSubmit() {
    form.setAttribute('data-lx-native', '1');
    if (typeof form.requestSubmit === 'function') form.requestSubmit(); else form.submit();
  }
  if (form) {
    document.addEventListener('submit', function (e) {
      if (e.target !== form) return;
      if (form.getAttribute('data-lx-native') === '1') return; /* let Shopify's own form handling (incl. CAPTCHA) run */
      e.preventDefault();
      e.stopPropagation();
      say('');
      if (!isGift(idx)) { say('This product is not part of the offer.', true); return; }
      var v = email.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) { say('Please enter a valid email address.', true); email.focus(); return; }
      syncVariant();
      var variantId = hiddenVariant && hiddenVariant.value;
      if (!variantId) { say('Please pick an option first.', true); return; }
      var s = ss();
      if (s) s.setItem(KEY, JSON.stringify({ v: variantId, i: idx, t: Date.now() }));
      busy(true);
      fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin', headers: { 'Accept': 'text/html' } })
        .then(function (r) {
          if (r.ok && /customer_posted=true/.test(r.url)) return finish(variantId, idx);
          nativeSubmit(); /* CAPTCHA, challenge or validation: fall back to a normal post, resume on return */
        })
        .catch(function () { nativeSubmit(); });
    }, true);
  }

  /* ── Resume after a normal form post ── */
  (function resume() {
    var s = ss(); if (!s) return;
    var raw = s.getItem(KEY); if (!raw) return;
    var p; try { p = JSON.parse(raw); } catch (e) { s.removeItem(KEY); return; }
    if (!p || Date.now() - (p.t || 0) > 30 * 60 * 1000) { s.removeItem(KEY); return; }
    if (typeof p.i === 'number' && p.i < n) {
      select(p.i, true);
      var r = panels[idx] && panels[idx].querySelector('input[type="radio"][value="' + p.v + '"]');
      if (r) { r.checked = true; syncVariant(); }
      var so = panels[idx] && panels[idx].querySelector('select[data-lx-vs]');
      if (so) { so.value = p.v; syncVariant(); }
    }
    var posted = /[?&]customer_posted=true/.test(window.location.search) || (msg && msg.getAttribute('data-posted') === 'true');
    var errText = msg && msg.getAttribute('data-error');
    if (posted) {
      if (root.scrollIntoView) root.scrollIntoView({ block: 'center' });
      if (isGift(idx)) finish(p.v, idx);
    } else if (errText !== null && errText !== undefined) {
      s.removeItem(KEY);
      if (root.scrollIntoView) root.scrollIntoView({ block: 'center' });
      say(errText || 'Please check your email address and try again.', true);
    }
  })();

  select(idx, true);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Apex Featured",
  "tag": "section",
  "class": "section apex-featured-section",
  "blocks": [
    {
      "type": "product_card",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text",    "id": "badge",   "label": "Badge", "info": "Optional label, e.g. 'NEW' or 'BESTSELLER'" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Display" },
    {
      "type": "select", "id": "display_mode", "label": "Mode",
      "options": [
        { "value": "auto",     "label": "Auto" },
        { "value": "showcase", "label": "Showcase (dual-row marquee)" },
        { "value": "grid",     "label": "Product Grid" },
        { "value": "single",   "label": "Single product" }
      ],
      "default": "auto",
      "info": "Auto: showcase when a collection or 2+ blocks are set."
    },

    { "type": "header", "content": "Source — Collection or Blocks" },
    {
      "type": "select", "id": "source_mode", "label": "Pull products from",
      "options": [
        { "value": "collection", "label": "A collection (auto)" },
        { "value": "blocks",     "label": "Manually-added blocks" }
      ],
      "default": "collection"
    },
    { "type": "collection", "id": "source_collection", "label": "Collection", "info": "Grid and showcase source." },

    { "type": "header", "content": "Grid Mode — Layout" },
    {
      "type": "range", "id": "grid_max_products", "label": "Products to show",
      "min": 2, "max": 20, "step": 1, "default": 8,
      "info": "Up to 20. Hick's Law: 8–12 is the sweet spot for homepage grids."
    },
    {
      "type": "select", "id": "grid_cols_desktop", "label": "Columns — desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select", "id": "grid_cols_tablet", "label": "Columns — tablet",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "select", "id": "grid_cols_mobile", "label": "Columns — mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "2",
      "info": "2 is the standard. 3–4 works well for accessories or small-format products."
    },
    {
      "type": "range", "id": "grid_mobile_rows", "label": "Rows visible on mobile",
      "min": 1, "max": 4, "step": 1, "default": 4,
      "info": "Cards beyond (columns × rows) are hidden on mobile. Desktop always shows all."
    },
    {
      "type": "range", "id": "grid_gap", "label": "Grid gap",
      "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12,
      "info": "Tight gaps (8–12px) create editorial density."
    },
    {
      "type": "range", "id": "grid_info_padding", "label": "Info section padding",
      "min": 6, "max": 24, "step": 2, "unit": "px", "default": 12
    },

    { "type": "header", "content": "Grid Mode — Hero First Card" },
    {
      "type": "checkbox", "id": "grid_hero_first", "label": "Hero first card (spans 2 columns)",
      "default": true,
      "info": "Von Restorff effect — differentiated item is remembered and clicked more."
    },
    {
      "type": "product", "id": "grid_hero_product", "label": "Featured (hero) product",
      "info": "Pin a specific product as the hero. Leave blank to auto-rotate every 3 seconds."
    },
    {
      "type": "select", "id": "grid_hero_aspect", "label": "Hero image ratio",
      "options": [
        { "value": "1 / 1",  "label": "Square (1:1)" },
        { "value": "4 / 3",  "label": "Landscape (4:3)" },
        { "value": "3 / 2",  "label": "Wide (3:2)" },
        { "value": "3 / 4",  "label": "Portrait (3:4)" }
      ],
      "default": "1 / 1"
    },

    { "type": "header", "content": "Grid Mode — Image" },
    {
      "type": "select", "id": "grid_aspect", "label": "Card image ratio",
      "options": [
        { "value": "1 / 1",  "label": "Square (1:1)" },
        { "value": "3 / 4",  "label": "Portrait 3:4 — apparel standard" },
        { "value": "4 / 5",  "label": "Portrait 4:5 — social/editorial" },
        { "value": "2 / 3",  "label": "Tall 2:3" }
      ],
      "default": "3 / 4",
      "info": "3:4 is the industry standard for fashion and apparel homepage grids (Nike, Zara, Adidas)."
    },
    {
      "type": "checkbox", "id": "grid_second_image", "label": "Hover reveals second product image",
      "default": true,
      "info": "The single highest-impact conversion feature on product grids. Requires 2 product images."
    },

    { "type": "header", "content": "Grid Mode — Badges & Labels" },
    {
      "type": "checkbox", "id": "show_discount_pct", "label": "Show discount % (e.g. –30%)",
      "default": true,
      "info": "Loss-aversion framing outperforms 'SALE' text by 20–40% in A/B tests."
    },
    { "type": "color", "id": "sale_badge_bg", "label": "Sale badge background", "default": "#111111" },
    { "type": "color", "id": "sale_badge_fg", "label": "Sale badge text",       "default": "#ffffff" },
    { "type": "text",  "id": "new_tag",       "label": "Product 'New' tag (exact)",  "info": "Tag name on the product, e.g. 'new'. Case-sensitive." },
    { "type": "text",  "id": "new_tag_label", "label": "'New' badge label",          "default": "New" },

    { "type": "header", "content": "Grid Mode — Stock & Urgency" },
    { "type": "checkbox", "id": "show_low_stock", "label": "Show low-stock indicator", "default": false },
    {
      "type": "range", "id": "low_stock_threshold", "label": "Low-stock threshold",
      "min": 1, "max": 10, "step": 1, "default": 5,
      "info": "Show indicator when inventory ≤ this number. Requires Shopify inventory tracking."
    },
    { "type": "text", "id": "low_stock_text", "label": "Low-stock label", "default": "Low stock" },

    { "type": "header", "content": "Grid Mode — View All" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": true },
    { "type": "text",     "id": "view_all_text", "label": "Button text",            "default": "View all" },

    { "type": "header", "content": "Shared — Quick Add" },
    { "type": "checkbox", "id": "show_quick_add",  "label": "Show Quick Add",         "default": true },
