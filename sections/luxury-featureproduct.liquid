.apex-gtitle-{{ sid }} a { color: inherit; text-decoration: none; }
.apex-gtitle-{{ sid }} a:hover { color: var(--apex-fg-muted); }

.apex-gswatches-{{ sid }} { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; margin-top: 2px; }
.apex-gswatch-{{ sid }} {
  width: clamp(10px, 0.8vw, 13px);
  height: clamp(10px, 0.8vw, 13px);
