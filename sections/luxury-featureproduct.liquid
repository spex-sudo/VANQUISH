  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--apex-fg-muted);
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.apex-gtitle-{{ sid }} {
  font-size: clamp(12px, 0.95vw, 14px);
  font-weight: 400;
  letter-spacing: -0.01em;
  line-height: 1.3;
  margin: 0;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
