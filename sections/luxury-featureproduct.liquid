{%- comment -%}
  ╔═════════════════════════════════════════════════════════════════╗
  ║  APEX — Featured Product (Apple-style)                         ║
  ║                                                                ║
  ║  Modes: single | showcase (dual marquee) | grid                ║
  ║                                                                ║
  ║  Grid mode design philosophy (Nike / Zara / Adidas):           ║
  ║   • Flat editorial grid — no card shadows or borders.          ║
  ║   • Portrait 3:4 default (industry-standard apparel ratio).    ║
  ║   • Second-image cross-fade on hover (primary conversion lift).║
  ║   • Quick-add slides up from image bottom as overlay.         ║
  ║   • Multi-variant → "Choose Options" → PDP (no wrong-variant). ║
  ║   • Hero first card spans 2 cols — Von Restorff effect.        ║
  ║   • Discount % badge — loss aversion (not just "SALE").        ║
  ║   • Low-stock nudge — scarcity without dark patterns.          ║
  ║   • Stagger entrance animation on IntersectionObserver.        ║
  ║   • View All CTA — choice architecture, preserves flow.        ║
  ║   • Sold-out tag is a top-right half pill. Notify me replaces  ║
  ║     the sold-out quick-add button.                            ║
  ║                                                                ║
  ║  Psychology (Cialdini + behavioural economics):                ║
  ║   • Mere-exposure: marquee 2x fluent glances (Zajonc 1968).    ║
  ║   • Peak-end rule: ATC success animation rewards decision.     ║
  ║   • Hick's Law: grid capped, clear CTA preserves speed.        ║
  ║   • Social proof hook: vendor / brand label (authority).       ║
  ║   • Anchoring: compare price shown (willingness-to-pay lift).  ║
  ║   • Scarcity: low-stock text (mild urgency, not anxiety).      ║
  ║   • Self-reference: 'CURATED FOR YOU' eyebrow copy.            ║
  ╚═══════════════════════════════════════════════════════════════════════╝
{%- endcomment -%}

{%- liquid
  # ── Resolve display mode
  assign p_blocks = section.blocks | where: 'type', 'product_card'
  assign mode     = s.display_mode

  # ── Source detection
  assign source_kind = 'none'
  if s.source_mode == 'collection' and s.source_collection != blank and s.source_collection.products_count > 0
    assign source_kind = 'collection'
  elsif p_blocks.size > 0
    assign source_kind = 'blocks'
  endif

  if mode == 'auto'
    if source_kind == 'collection' or p_blocks.size > 1
      assign mode = 'showcase'
    else
      assign mode = 'single'
    endif
  endif

  # ── Single-mode product
  if mode == 'single'
    assign solo = p_blocks | first
    if solo != blank and solo.settings.product != blank
      assign product = solo.settings.product
    else
      assign product = s.product
    endif
    if product != blank
      assign cv          = product.selected_or_first_available_variant
      assign first_image = product.media | first
      if cv.featured_media != null
        assign first_image = cv.featured_media
      endif
    endif
  endif

  # ── Card width with merchant scale multiplier (showcase)
  assign scale_factor   = s.card_scale | default: 100 | divided_by: 100.0
  assign computed_width = s.card_width | times: scale_factor | round
  assign scroll_speed   = s.scroll_speed | default: 60

  # ── Showcase max products
  assign max_products = s.max_products | default: 8
  assign item_count   = 0
  if source_kind == 'collection'
    assign item_count = s.source_collection.products_count
    if item_count > max_products
      assign item_count = max_products
    endif
  elsif source_kind == 'blocks'
    assign item_count = p_blocks.size
  endif

  # ── Grid max products (separate, up to 20)
  assign grid_max = s.grid_max_products | default: 8

  # ── Grid hero product (merchant-selected or auto-rotate)
  assign grid_hero_product = s.grid_hero_product
  assign grid_hero_auto    = true
  if grid_hero_product != blank
    assign grid_hero_auto = false
  endif

  # ── Multi-collection round-robin for grid (equal share across primary collections)
  assign grid_rr_handles = ''
  assign grid_rr_n = 0
  assign grid_use_rr = false
  assign grid_rr_target = grid_max
  if mode == 'grid' and s.grid_collections != blank
    assign grid_rr_seen = '|'
    assign grid_rr_cols = 0
    for _gc in s.grid_collections
      assign grid_rr_cols = grid_rr_cols | plus: 1
    endfor
    if grid_rr_cols > 0
      assign grid_use_rr = true
      if grid_hero_product != blank and s.grid_hero_first
        assign grid_rr_target = grid_max | minus: 1
        if grid_rr_target < 1
          assign grid_rr_target = 1
        endif
      endif
      for _guard in (1..48)
        if grid_rr_n >= grid_rr_target
          break
        endif
        assign grid_rr_added = 0
        for gcol in s.grid_collections
          if grid_rr_n >= grid_rr_target
            break
          endif
          for gp in gcol.products limit: 50
            unless gp.available
              continue
            endunless
            if gp.type == 'Digital Product'
              continue
            endif
            if grid_hero_product != blank and gp.id == grid_hero_product.id
              continue
            endif
            assign grid_rr_tok = '|' | append: gp.id | append: '|'
            if grid_rr_seen contains grid_rr_tok
              continue
            endif
            assign grid_rr_handles = grid_rr_handles | append: gp.handle | append: ','
            assign grid_rr_seen = grid_rr_seen | append: grid_rr_tok
            assign grid_rr_n = grid_rr_n | plus: 1
            assign grid_rr_added = grid_rr_added | plus: 1
            break
          endfor
        endfor
        if grid_rr_added == 0
          break
        endif
      endfor
    endif
  endif

  # ── Grid mobile row cap: hide cards beyond (cols × rows) on mobile
  assign mobile_cols      = s.grid_cols_mobile | default: '2' | plus: 0
  assign mobile_rows      = s.grid_mobile_rows | default: 4
  assign mobile_cap_start = mobile_cols | times: mobile_rows | plus: 1
-%}

