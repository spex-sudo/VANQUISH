{%- comment -%} LEXE preview 2026-10-15: homepage "Latest arrivals" - newest products, excludes needs-clean-image + branded-review handles. {%- endcomment -%}
{%- assign lexe_excl = "liquid-silicone-mobile-phone-case-all-inclusive-for-apple-13promax-protective-cover-iphone12-anti-fall-11promax-red,embroidered-patchwork-leather-sleeveless-top-relaxed-fit,black-stand-up-collar-short-racing-style-zipper-jacket,pu-leather-hooded-jacket,collar-pu-leather-jacket,melkco-leather-case-for-iphone-17-pro-max-full-coverage-genuine-leather-iphone-16-pro-iphone-15-pro-with-skin-design-iphone-14-fashionable-cover,brand-square-sunglasses-woman-oversized-black-style-shades-for-women-big-frame-fashion-sunglasses-female-uv400-glasses,mens-leopard-print-stripe-pants,comes-with-goggles-lychee-leather-shell-suitable-for-iphone-case,mens-round-neck-graphic-statement-t-shirt,sunglasses-are-uv-resistant-large-frame-sunglasses-for-women-with-a-high-end-feel,new-trend-big-frame-women-sunglasses-irregular-street-shooting-sunglasses-men-retro-wide-frame-glasses,skeleton-digital-printed-patchwork-stand-up-collar-leather-jacket,retro-hooded-pu-leather-jacket-cotton-jacket,mens-star-zip-up-long-sleeve-hoodie,pu-leather-three-stripe-baseball-jacket-short-style,punk-sunglasses-steam-glasses-personalized-oval-sunglasses,cross-embroidered-patchwork-leather-jacket,mens-gradient-graphic-short-sleeve-t-shirt,mens-cartoon-round-neck-half-sleeve-t-shirt,pu-leather-jacket-motorcycle-jacket,shoulder-bag-soft-leather-womens-fashionable-backpack-student-minimalist-backpack,baseball-jacket-with-leather-sleeves" | split: ',' -%}
{%- assign shown = 0 -%}
<section id="lexe-latest-arrivals" class="lexe-la" aria-labelledby="lexe-la-h">
  <div class="lexe-la__head">
    <h2 id="lexe-la-h" class="lexe-la__title">{{ section.settings.heading | default: 'Latest arrivals' }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="lexe-la__sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <ul class="lexe-la__grid" role="list">
  {%- paginate collections.all.products by 250 -%}
    {%- assign newest = collections.all.products | sort: 'created_at' | reverse -%}
    {%- for p in newest -%}
      {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
      {%- if p.tags contains 'needs-clean-image' or lexe_excl contains p.handle or p.featured_image == blank -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="lexe-la__card">
        <a href="{{ p.url }}" class="lexe-la__link">
          {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 25vw, 50vw', alt: p.featured_image.alt | default: p.title, class: 'lexe-la__img' }}
          <span class="lexe-la__name">{{ p.title }}</span>
          <span class="lexe-la__price">{{ p.price | money_with_currency }}</span>
        </a>
      </li>
    {%- endfor -%}
  {%- endpaginate -%}
  </ul>
</section>
<style>
  .lexe-la{padding:40px 16px;max-width:1340px;margin:0 auto}
  .lexe-la__title{margin:0 0 4px;font-size:24px}
  .lexe-la__sub{margin:0 0 16px;opacity:.75}
  .lexe-la__grid{list-style:none;margin:16px 0 0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  @media (min-width:990px){.lexe-la__grid{grid-template-columns:repeat(4,1fr)}}
  .lexe-la__link{display:grid;gap:4px;text-decoration:none;color:inherit}
  .lexe-la__img{width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;border-radius:2px;background:#f4f4f2}
  .lexe-la__name{font-size:13px}
  .lexe-la__price{font-size:13px;opacity:.8}
</style>
{% schema %}
{
  "name": "LEXE Latest arrivals",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest arrivals" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The newest pieces, first." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8 }
  ]
}
{% endschema %}
