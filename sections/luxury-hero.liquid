            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
          </button>
          {%- if block.settings.eyebrow != blank -%}<p class="about-eyebrow-{{ sid }}">{{ block.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="about-store-name-{{ sid }}">{{ block.settings.store_name }}</h2>
          <div class="about-divider-{{ sid }}"></div>
          {%- if block.settings.about_description != blank -%}<p class="about-description-{{ sid }}">{{ block.settings.about_description }}</p>{%- endif -%}
          {%- if block.settings.cta_label != blank and block.settings.cta_link != blank -%}
            <a href="{{ block.settings.cta_link }}" class="about-cta-link-{{ sid }}">{{ block.settings.cta_label }}<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M16.01 11H4v2h12.01v3L20 12l-3.99-4z"/></svg></a>
          {%- endif -%}
          {%- assign modal_socials = section.blocks | where: 'type', 'social_link' -%}
          {%- if modal_socials.size > 0 -%}
            <div class="about-social-row-{{ sid }}">
              {%- for s in modal_socials -%}
                <a href="{{ s.settings.url }}" class="about-social-icon-{{ sid }}" target="_blank" rel="noopener" aria-label="{{ s.settings.platform }}">
                  {%- assign ico = 15 -%}
                  {%- case s.settings.platform -%}
                    {%- when 'instagram' -%}<svg width="{{ ico }}" height="{{ ico }}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    {%- when 'tiktok' -%}<svg width="{{ ico }}" height="{{ ico }}" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                    {%- when 'twitter' -%}<svg width="{{ ico }}" height="{{ ico }}" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    {%- when 'facebook' -%}<svg width="{{ ico }}" height="{{ ico }}" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    {%- when 'youtube' -%}<svg width="{{ ico }}" height="{{ ico }}" viewBox="0 0 24 24" fill="currentColor"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
                    {%- else -%}<svg width="{{ ico }}" height="{{ ico }}" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                  {%- endcase -%}
                </a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- if has_wall -%}
    <button class="sig-wall-toggle-{{ sid }}"
      id="sig-toggle-{{ sid }}"
      aria-expanded="false"
      aria-controls="sig-wall-{{ sid }}"
      aria-label="{{ section.settings.wall_btn_label_show }}">
      {%- comment -%} Group people icon — plural default profile silhouette {%- endcomment -%}
      <svg class="sig-toggle-icon-{{ sid }}" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
      </svg>
      <span class="label-show">{{ section.settings.wall_btn_label_show }}</span>
      <span class="label-hide">{{ section.settings.wall_btn_label_hide }}</span>
    </button>
    <button class="sig-addname-btn-{{ sid }}" id="sig-addname-btn-{{ sid }}" aria-label="Add your name to the wall">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
      {{- section.settings.addname_btn_label | default: 'Add my name' -}}
    </button>
  {%- endif -%}

  {%- if section.settings.video_link != blank -%}
    <button class="vid-pause-btn-{{ sid }}" id="vid-pause-{{ sid }}" aria-label="Pause video">
      <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      <svg class="icon-play"  width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    </button>
  {%- endif -%}

  {%- if section.settings.show_scroll -%}
    <div class="scroll-indicator-v11"><div class="scroll-track"><div class="scroll-swipe-line"></div></div></div>
  {%- endif -%}

</section>

{%- comment -%}
  FIX: addname-backdrop and addname-card live OUTSIDE the <section>.
  The hero section has overflow:hidden + CSS transforms which create a
  stacking context that traps position:fixed children — causing the
  backdrop to behave like position:absolute and pushing the hero layout
  upward when opened. Outside the section, they render correctly.
  JS also re-parents them to document.body on first open for safety.
{%- endcomment -%}
<div class="addname-backdrop-{{ sid }}" id="addname-modal-{{ sid }}"></div>
<div class="addname-card-{{ sid }}" id="addname-card-{{ sid }}" role="dialog" aria-modal="true" aria-labelledby="addname-heading-{{ sid }}">
  <button class="addname-close-{{ sid }}" id="addname-close-{{ sid }}" aria-label="Close">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
  </button>
  <div class="addname-form-{{ sid }}" id="addname-form-wrap-{{ sid }}">
    <h2 class="addname-heading-{{ sid }}" id="addname-heading-{{ sid }}">{{ section.settings.addname_heading }}</h2>
    <p class="addname-sub-{{ sid }}">{{ section.settings.addname_subtext }}</p>
    <form id="addname-form-{{ sid }}" novalidate>
      <input type="hidden" name="form_type" value="contact">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="signature-wall">
      <input type="text"  name="contact[body_nickname]" id="addname-nick-{{ sid }}"   class="addname-field-{{ sid }}" placeholder="{{ section.settings.addname_nick_placeholder }}"  autocomplete="nickname" maxlength="30" required>
      <p class="addname-error-msg-{{ sid }}" id="addname-nick-err-{{ sid }}">Please enter a nickname (max 30 characters)</p>
      <input type="email" name="contact[email]"         id="addname-email-{{ sid }}"  class="addname-field-{{ sid }}" placeholder="{{ section.settings.addname_email_placeholder }}" autocomplete="email" required>
      <p class="addname-error-msg-{{ sid }}" id="addname-email-err-{{ sid }}">Please enter a valid email address</p>
      <label class="addname-consent-{{ sid }}">
        <input type="checkbox" id="addname-consent-{{ sid }}" required>
        <span class="addname-consent-label-{{ sid }}">{{ section.settings.addname_consent_text }}{%- if section.settings.addname_privacy_url != blank -%} <a href="{{ section.settings.addname_privacy_url }}" target="_blank" rel="noopener">{{ section.settings.addname_privacy_label }}</a>.{%- endif -%}</span>
      </label>
      <button type="submit" class="addname-submit-{{ sid }}" id="addname-submit-{{ sid }}">{{ section.settings.addname_submit_label }}</button>
    </form>
  </div>
  <div class="addname-success-{{ sid }}" id="addname-success-{{ sid }}" aria-live="polite">
    <div class="addname-success-icon-{{ sid }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="#000"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
    </div>
    <h3 class="addname-success-title-{{ sid }}">{{ section.settings.addname_success_title }}</h3>
    <p class="addname-success-body-{{ sid }}">{{ section.settings.addname_success_body }}</p>
  </div>
</div>

<script>
(function () {
  'use strict';

  var ua          = navigator.userAgent || '';
  var SID         = '{{ sid }}';
  var heroSection = document.getElementById('Hero-' + SID);
  var video       = document.getElementById('hero-video-' + SID);
  var posterImg   = document.getElementById('hero-poster-img-' + SID);
  var pauseBtn    = document.getElementById('vid-pause-' + SID);
  var restricted  = /musical_ly|tiktok|bytedance|Instagram|FBAN|FBAV|FB_IAB|FBIOS|FBSS|Snapchat|TwitterAndroid|TwitteriPhone|LinkedInApp|MicroMessenger/i.test(ua);

  /* ── Video engine ── */
  if (video) {
    if (restricted) {
      video.style.display = 'none';
    } else {
      video.muted = video.defaultMuted = true;
      video.autoplay = true;
      var videoShown = false;
      var fadeTimer  = null;

      function showVideo() {
        if (videoShown) return;
        videoShown = true;
        video.classList.add('vid-ready');
        if (posterImg) { posterImg.style.transition = 'opacity 0.7s ease'; posterImg.style.opacity = '0'; }
        if (pauseBtn) pauseBtn.classList.add('is-visible');
        scheduleFade();
      }
      video.addEventListener('playing', showVideo, { once: true });

      function scheduleFade() {
        clearTimeout(fadeTimer);
        if (!pauseBtn) return;
        fadeTimer = setTimeout(function () {
          if (pauseBtn && !pauseBtn.classList.contains('is-paused')) pauseBtn.classList.add('is-faded');
        }, 3000);
      }
      function wakeBtn() {
        if (!pauseBtn) return;
        pauseBtn.classList.remove('is-faded');
        scheduleFade();
      }
      if (heroSection) {
        heroSection.addEventListener('mousemove', wakeBtn, { passive: true });
        heroSection.addEventListener('touchstart', wakeBtn, { passive: true });
      }
      if (pauseBtn) {
        pauseBtn.addEventListener('click', function () {
          if (video.paused) {
            video.play().catch(function () {});
            pauseBtn.classList.remove('is-paused');
            scheduleFade();
          } else {
            video.pause();
            pauseBtn.classList.add('is-paused');
            clearTimeout(fadeTimer);
            pauseBtn.classList.remove('is-faded');
          }
        });
        video.addEventListener('pause', function () {
          if (pauseBtn) { pauseBtn.classList.add('is-paused'); clearTimeout(fadeTimer); pauseBtn.classList.remove('is-faded'); }
        });
        video.addEventListener('play', function () {
          if (pauseBtn) { pauseBtn.classList.remove('is-paused'); scheduleFade(); }
        });
      }
      function tryPlay() {
        video.muted = true;
        var p = video.play();
        if (p && typeof p.then === 'function') {
          p.then(showVideo).catch(function () {
            var retry = function () { video.play().then(showVideo).catch(function () {}); };
            document.addEventListener('touchstart', retry, { once: true, passive: true });
            document.addEventListener('click', retry, { once: true });
          });
        } else { showVideo(); }
      }
      function startVideo() {
        video.preload = 'auto';
        if (video.readyState >= 3) {
          tryPlay();
        } else {
          video.addEventListener('canplaythrough', function onCPT() {
            video.removeEventListener('canplaythrough', onCPT);
            tryPlay();
          });
          video.load();
          setTimeout(function () { if (!videoShown) tryPlay(); }, 2500);
        }
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries, obs) {
          if (entries[0].isIntersecting) { startVideo(); obs.disconnect(); }
        }, { rootMargin: '200px' });
        io.observe(heroSection || document.body);
      } else { startVideo(); }

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
          video.pause();
        } else if (video.paused && !(pauseBtn && pauseBtn.classList.contains('is-paused'))) {
          video.play().catch(function () {});
        }
      });
    }
  }

  /* ── Hero content reveal ── */
  function revealContent() {
    var el = document.getElementById('content-' + SID);
    if (el) el.classList.add('is-visible');
  }
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', revealContent)
    : revealContent();


  /* ── About modal ── */
  document.querySelectorAll('[id^="about-trigger-' + SID + '-"]').forEach(function (btn) {
    var blockId  = btn.id.replace('about-trigger-' + SID + '-', '');
    var modal    = document.getElementById('about-modal-' + SID + '-' + blockId);
    var closeBtn = document.getElementById('about-close-' + SID + '-' + blockId);
    if (!modal) return;
    var openM  = function () { modal.classList.add('is-open');    document.body.style.overflow = 'hidden'; };
    var closeM = function () { modal.classList.remove('is-open'); document.body.style.overflow = ''; };
    btn.addEventListener('click', openM);
    if (closeBtn) closeBtn.addEventListener('click', closeM);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeM(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('is-open')) closeM(); });
  });

  /* ── Signature wall ── */
  var wallCanvas = document.getElementById('sig-wall-' + SID);
  var wallToggle = document.getElementById('sig-toggle-' + SID);
  var addNameBtn = document.getElementById('sig-addname-btn-' + SID);
  var dataEl     = document.getElementById('sig-wall-data-' + SID);

  if (wallCanvas && wallToggle && dataEl) {
    var WALL_GF   = '{{ section.settings.wall_font }}';
    var SYS_FONTS = [
      '"Georgia","Times New Roman",serif','"Palatino Linotype","Book Antiqua",serif',
      '"Garamond","Cochin",serif','"Helvetica Neue",Arial,sans-serif',
      '"Trebuchet MS","Lucida Grande",sans-serif','Verdana,Geneva,sans-serif',
      '"Courier New","Lucida Console",monospace','"Brush Script MT","Segoe Script",cursive',
      '"Lucida Handwriting","Apple Chancery",cursive','Impact,Charcoal,fantasy',
      '"Copperplate","Copperplate Gothic Light",fantasy'
    ];
    var FONT_POOL;
    if (WALL_GF && WALL_GF.trim() !== '') {
      FONT_POOL = [];
      var gfStack = '"' + WALL_GF + '",' + SYS_FONTS[0];
      for (var _i = 0; _i < 7; _i++) FONT_POOL.push(gfStack);
      FONT_POOL.push(SYS_FONTS[0], SYS_FONTS[3], SYS_FONTS[7]);
    } else { FONT_POOL = SYS_FONTS; }

    var WALL_COLORS = [
      '{{ section.settings.wall_color_1 }}','{{ section.settings.wall_color_2 }}',
      '{{ section.settings.wall_color_3 }}','{{ section.settings.wall_color_4 }}',
      '{{ section.settings.wall_color_5 }}'
    ].filter(function (c) { return c && c.length > 3; });
    if (!WALL_COLORS.length) WALL_COLORS = ['#fff','#f0f0f0','#d4af37','#cccccc','#e8e8e8'];

    function h(str, range) {
      var v = 0;
      for (var i = 0; i < str.length; i++) v = (Math.imul(31, v) + str.charCodeAt(i)) | 0;
      return Math.abs(v) % range;
    }
    var wallBuilt = false;

    function buildWall(names) {
      if (wallBuilt) return;
      wallBuilt = true;
      var count = names.length;
      var minSz, maxSz;
      if      (count < 50)  { minSz = 18; maxSz = 46; }
      else if (count < 200) { minSz = 13; maxSz = 32; }
      else if (count < 500) { minSz = 9;  maxSz = 22; }
      else                  { minSz = 7;  maxSz = 16; }
      var cw = wallCanvas.offsetWidth  || window.innerWidth  || 800;
      var ch = wallCanvas.offsetHeight || window.innerHeight || 600;
      var placed = [], PAD = 6, MAX_ATT = 24;
      function collidePx(cx, cy, hw, hh) {
        for (var i = 0; i < placed.length; i++) {
          var p = placed[i];
          if (Math.abs(cx-p[0]) < hw+p[2]+PAD && Math.abs(cy-p[1]) < hh+p[3]+PAD) return true;
        }
        return false;
      }
      var frag = document.createDocumentFragment();
      var maxDelay = Math.min(count * 6, 1800);
      for (var idx = 0; idx < count; idx++) {
        var name = names[idx];
        if (!name || !name.trim()) continue;
        var s1=name+idx, s2=String(idx)+name, s3=name.split('').reverse().join('')+idx, s4=name.slice(0,4)+String(idx);
        var fi = h(s1, FONT_POOL.length);
        var ci = h(s3, WALL_COLORS.length);
        var fontSize = minSz + h(s4, maxSz-minSz+1);
        var opH = h(s2, 100);
        var opacity = 0.65 + (opH/100)*0.35;
        var fw = [300,400,400,500,600,700][h(s3,6)];
        var rot = h(s1,21)-10;
        var ls = h(s4,15)/100;
        var approxW = name.trim().length*fontSize*0.58;
        var approxH = fontSize*1.3;
        var hw = approxW/2, hh = approxH/2;
        var cx = cw*0.5, cy = ch*0.5;
        var placed_ok = false;
        for (var att=0; att < MAX_ATT; att++) {
          cx=(4+h(s1+att,90))/100*cw; cy=(4+h(s2+att,90))/100*ch;
          if (!collidePx(cx,cy,hw,hh)) { placed_ok=true; break; }
        }
        if (!placed_ok) {
          var smallSz=Math.max(minSz,Math.round(fontSize*0.7));
          var smallW=name.trim().length*smallSz*0.58/2, smallH=smallSz*1.3/2;
          for (var att2=0; att2 < MAX_ATT; att2++) {
            cx=(4+h(s1+att2+50,90))/100*cw; cy=(4+h(s2+att2+50,90))/100*ch;
            if (!collidePx(cx,cy,smallW,smallH)) { fontSize=smallSz; hw=smallW; hh=smallH; break; }
          }
        }
        placed.push([cx,cy,hw,hh]);
        var tx=(cx/cw*100).toFixed(2), ty=(cy/ch*100).toFixed(2);
        var span = document.createElement('span');
        span.className='sig-name'; span.textContent=name.trim();
        span.setAttribute('aria-hidden','true');
        span.style.cssText=
          '--sz:'+fontSize+'px;--cl:'+WALL_COLORS[ci]+';--op:'+opacity.toFixed(2)+
          ';--ff:'+FONT_POOL[fi]+';--fw:'+fw+';--rot:'+rot+'deg;--tx:'+tx+'%;--ty:'+ty+
          '%;--ls:'+ls+'em;--delay:'+Math.round((idx/count)*maxDelay)+'ms';
        frag.appendChild(span);
      }
      wallCanvas.appendChild(frag);
    }

    var names = [];
    try { names = JSON.parse(dataEl.textContent || dataEl.innerHTML || '[]'); } catch(e) {}
    var wallOpen = false;

    function openWall() {
      buildWall(names); wallOpen=true;
      wallCanvas.classList.add('is-visible');
      wallToggle.classList.add('wall-open');
      wallToggle.setAttribute('aria-expanded','true');
      if (addNameBtn) addNameBtn.classList.add('is-visible');
    }
    function closeWall() {
      wallOpen=false;
      wallCanvas.classList.remove('is-visible');
      wallToggle.classList.remove('wall-open');
      wallToggle.setAttribute('aria-expanded','false');
      if (addNameBtn) addNameBtn.classList.remove('is-visible');
    }
    wallToggle.addEventListener('click', function () { wallOpen ? closeWall() : openWall(); });
  }

  /* ══════════════════════════════════════
     ADD MY NAME — INLINE POPOUT
     FIX: Re-parent card + backdrop to document.body on first open.
     The hero's overflow:hidden + transform creates a stacking context
     that traps position:fixed, making backdrop behave like position:absolute
     and pushing the hero section upward. On document.body there is no
     such constraint — fixed and absolute both work correctly.
  ══════════════════════════════════════ */
  var addBackdrop = document.getElementById('addname-modal-' + SID);
  var addCard     = document.getElementById('addname-card-'  + SID);
  var addClose    = document.getElementById('addname-close-' + SID);
  var addForm     = document.getElementById('addname-form-'  + SID);
  var formWrap    = document.getElementById('addname-form-wrap-' + SID);
  var successPnl  = document.getElementById('addname-success-'  + SID);
  var nickField   = document.getElementById('addname-nick-'   + SID);
  var emailField  = document.getElementById('addname-email-'  + SID);
  var consentChk  = document.getElementById('addname-consent-'+ SID);
  var submitBtn   = document.getElementById('addname-submit-' + SID);
  var nickErr     = document.getElementById('addname-nick-err-'  + SID);
  var emailErr    = document.getElementById('addname-email-err-' + SID);
  var addNameBtn2 = document.getElementById('sig-addname-btn-' + SID);
  var movedToBody = false;

  if (addCard) {
    function ensureOnBody() {
      if (movedToBody) return;
      movedToBody = true;
      /* Move both elements to document.body, escaping any stacking context */
      if (addCard     && !document.body.contains(addCard))     document.body.appendChild(addCard);
      if (addBackdrop && !document.body.contains(addBackdrop)) document.body.appendChild(addBackdrop);
    }

    function positionCard() {
      if (!addNameBtn2) return;
      var btnR = addNameBtn2.getBoundingClientRect();
      var cW   = 280;
      /* Use viewport coords + scrollY/X for absolute-to-body positioning */
      var top  = btnR.bottom + window.pageYOffset + 10;
      var left = btnR.left + window.pageXOffset + (btnR.width / 2) - (cW / 2);
      left = Math.max(12, Math.min(left, document.documentElement.clientWidth - cW - 12));
      addCard.style.position = 'absolute';
      addCard.style.top      = top  + 'px';
      addCard.style.left     = left + 'px';
    }

    var popOpen = false;

    var openAdd = function () {
      if (popOpen) return;
      ensureOnBody();
      popOpen = true;
      positionCard();
      addCard.classList.add('is-open');
      if (addBackdrop) addBackdrop.classList.add('is-open');
      if (nickField) setTimeout(function () { nickField.focus(); }, 200);
    };

    var closeAdd = function () {
      if (!popOpen) return;
      popOpen = false;
      addCard.classList.remove('is-open');
      if (addBackdrop) addBackdrop.classList.remove('is-open');
    };

    if (addNameBtn2) addNameBtn2.addEventListener('click', function (e) {
      e.stopPropagation();
      popOpen ? closeAdd() : openAdd();
    });
    if (addClose)    addClose.addEventListener('click', closeAdd);
    if (addBackdrop) addBackdrop.addEventListener('click', closeAdd);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && popOpen) closeAdd();
    });

    function isEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); }
    function setErr(f, el, on) { if (f) f.classList.toggle('field-error', on); if (el) el.classList.toggle('visible', on); }

    if (nickField)  nickField.addEventListener('input',  function () { if (this.value.trim()) setErr(this, nickErr, false); });
    if (emailField) emailField.addEventListener('input', function () { if (isEmail(this.value)) setErr(this, emailErr, false); });

    if (addForm) {
      addForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var nick    = nickField  ? nickField.value.trim()  : '';
        var email   = emailField ? emailField.value.trim() : '';
        var consent = consentChk ? consentChk.checked      : false;
        var ok      = true;
        if (!nick)           { setErr(nickField,  nickErr,  true); ok = false; }
        if (!isEmail(email)) { setErr(emailField, emailErr, true); ok = false; }
        if (!consent)        { if (consentChk) consentChk.focus(); ok = false; }
        if (!ok) return;
        submitBtn.disabled    = true;
        submitBtn.textContent = '{{ section.settings.addname_submit_loading }}';
        var fd = new FormData(addForm);
        fd.set('contact[email]',   email);
        fd.set('contact[body]',    'Signature Wall — Nickname: ' + nick);
        fd.set('contact[subject]', 'Wall Submission: ' + nick);
        fetch('/contact#contact_form', {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: fd
        })
        .then(function (r) { if (r.ok || r.redirected) showSuccess(); else throw 0; })
        .catch(function () { showSuccess(); });
      });
    }

    function showSuccess() {
      if (formWrap) {
        formWrap.style.opacity = '0';
        setTimeout(function () {
          formWrap.style.display = 'none';
          if (successPnl) successPnl.classList.add('visible');
        }, 220);
      }
    }
  }

}());
</script>

