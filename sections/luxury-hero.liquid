{%- liquid
  assign sid         = section.id
  assign has_wall    = false
  if section.settings.wall_names != blank
    assign has_wall = true
  endif
-%}

{%- comment -%}
  Google Fonts — text overlays, about card, and wall font.
  PERFORMANCE LOOPHOLE: We use media="print" onload swap so the font
  request is non-render-blocking. The wall is lazily built on first
  toggle click, so by the time names render the font is already cached.
  Zero LCP penalty; font loads in the background like any stylesheet.
{%- endcomment -%}
{%- assign font_families = '' -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'text_overlay' and block.settings.font_family != blank -%}
    {%- unless font_families contains block.settings.font_family -%}
      {%- assign font_families = font_families | append: block.settings.font_family | append: '|' -%}
    {%- endunless -%}
  {%- endif -%}
  {%- if block.type == 'about_button' and block.settings.about_font != blank -%}
    {%- unless font_families contains block.settings.about_font -%}
      {%- assign font_families = font_families | append: block.settings.about_font | append: '|' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- if section.settings.wall_font != blank -%}
  {%- unless font_families contains section.settings.wall_font -%}
    {%- assign font_families = font_families | append: section.settings.wall_font | append: '|' -%}
  {%- endunless -%}
{%- endif -%}
{%- assign font_array = font_families | split: '|' -%}
{%- if font_array.size > 0 -%}
  {%- assign gf_query = '' -%}
  {%- for f in font_array -%}
    {%- unless f == blank -%}
      {%- assign f_enc = f | replace: ' ', '+' -%}
      {%- assign gf_query = gf_query | append: f_enc | append: ':wght@300;400;600;700;900&family=' -%}
    {%- endunless -%}
  {%- endfor -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ gf_query | remove_last: '&family=' }}&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="https://fonts.googleapis.com/css2?family={{ gf_query | remove_last: '&family=' }}&display=swap" rel="stylesheet"></noscript>
{%- endif -%}

{%- if section.settings.video_poster != blank -%}
  <link rel="preload" as="image" href="{{ section.settings.video_poster | image_url: width: 1920 }}" fetchpriority="high">
{%- elsif section.settings.image != blank -%}
  <link rel="preload" as="image" href="{{ section.settings.image | image_url: width: 1920 }}" fetchpriority="high">
{%- endif -%}

<style>
/* ── Hero shell ── */
.hero-{{ sid }} {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: {{ section.settings.bg_color }};
  min-height: {{ section.settings.height_mobile }}vh;
  justify-content: center;
  {%- if section.settings.video_poster != blank -%}
  background-image: url('{{ section.settings.video_poster | image_url: width: 1920 }}');
  background-size: {{ section.settings.image_fit }};
  background-position: center;
  {%- elsif section.settings.image != blank -%}
  background-image: url('{{ section.settings.image | image_url: width: 1920 }}');
  background-size: {{ section.settings.image_fit }};
  background-position: center;
  {%- endif -%}
}
@media (min-width: 768px) {
  .hero-{{ sid }} {
    min-height: {{ section.settings.height }}vh;
    align-items: {{ section.settings.vertical_alignment }};
    justify-content: {{ section.settings.horizontal_alignment }};
  }
}

/* ── Media layer ── */
.hero-media-{{ sid }} { position: absolute; inset: 0; z-index: 1; }
.hero-asset { width: 100%; height: 100%; object-fit: {{ section.settings.image_fit }}; object-position: center; display: block; }
.hero-poster-{{ sid }} { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: {{ section.settings.image_fit }}; object-position: center; display: block; z-index: 1; }

/* ── Video fade-in ── */
#hero-video-{{ sid }} {
  opacity: 0;
  transition: opacity 0.7s ease;
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: {{ section.settings.image_fit }}; object-position: center;
  display: block; z-index: 2; pointer-events: none;
}
#hero-video-{{ sid }}.vid-ready { opacity: 1; }

/* ── Overlay dim ── */
.hero-overlay-{{ sid }} {
  position: absolute; inset: 0;
  background: {{ section.settings.overlay_color }};
  opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  z-index: 3;
}

/* ── Main content block ── */
.hero-content-{{ sid }} {
  position: relative; z-index: 10;
  width: 100%; max-width: {{ section.settings.content_width }}px;
  padding: 40px 20px;
  display: flex; flex-direction: column;
  align-items: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  text-align: {{ section.settings.text_align }};
  color: {{ section.settings.text_color }};
  opacity: 0; transform: translateY(24px);
  transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1);
}
.hero-content-{{ sid }}.is-visible { opacity: 1; transform: translateY(0); }

.hero-title {
  font-size: clamp(2.5rem, 8vw, {{ section.settings.title_size }}rem);
  line-height: 1.05; margin: 0 0 1.4rem 0;
  font-weight: 300; letter-spacing: -0.02em;
  transition: text-shadow 0.6s ease;
}
.hero-title:hover { text-shadow: 0 0 30px rgba(255,255,255,0.22), 0 0 60px rgba(212,175,55,0.12); }

.lux-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  text-decoration: none; font-family: inherit;
  cursor: pointer; width: fit-content; margin-top: 14px;
  position: relative; overflow: hidden;
  -webkit-font-smoothing: antialiased;
}
.lux-btn--ghost {
  padding: 14px 42px;
  background: transparent;
  color: {{ section.settings.text_color }};
  border: 1px solid rgba(255,255,255,0.4);
  border-radius: {{ section.settings.btn_radius }}px;
  font-size: 0.72rem; font-weight: 400;
  letter-spacing: 0.22em; text-transform: uppercase;
  backdrop-filter: blur(8px) saturate(1.4);
  -webkit-backdrop-filter: blur(8px) saturate(1.4);
  transition: border-color 0.28s ease, background 0.28s ease,
              transform 0.22s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.28s ease;
}
.lux-btn--ghost:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.75);
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.14);
}
.lux-btn--ghost:active { transform: translateY(0); }
.lux-btn--solid {
  padding: 15px 44px;
  background: {{ section.settings.text_color }};
  color: {{ section.settings.bg_color }};
  border: 1.5px solid {{ section.settings.text_color }};
  border-radius: {{ section.settings.btn_radius }}px;
  font-size: 0.72rem; font-weight: 600;
  letter-spacing: 0.22em; text-transform: uppercase;
  transition: background 0.28s ease, color 0.28s ease, border-color 0.28s ease,
              transform 0.22s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.28s ease;
}
.lux-btn--solid:hover {
  background: transparent;
  color: {{ section.settings.text_color }};
  transform: translateY(-2px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.18);
}
.lux-btn--solid:active { transform: translateY(0); }
.lux-btn--text {
  padding: 8px 0;
  background: transparent;
  color: {{ section.settings.text_color }};
  border: none; border-radius: 0;
  font-size: 0.75rem; font-weight: 400;
  letter-spacing: 0.2em; text-transform: uppercase;
  transition: opacity 0.2s ease, gap 0.25s ease;
}
.lux-btn--text::after {
  content: '';
  position: absolute; bottom: 2px; left: 0;
  width: 100%; height: 1px;
  background: {{ section.settings.text_color }};
  transform-origin: left;
  transition: transform 0.3s cubic-bezier(0.65,0,0.35,1);
}
.lux-btn--text:hover { opacity: 0.7; }
.lux-btn--text:hover::after { transform: scaleX(0.4); }
.lux-btn--text .btn-arrow { display: inline-block; transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1); }
.lux-btn--text:hover .btn-arrow { transform: translateX(5px); }

/* ── Scroll indicator ── */
.scroll-indicator-v11 {
  position: absolute; bottom: 32px; left: 50%;
  transform: translateX(-50%); z-index: 20;
  display: flex; flex-direction: column; align-items: center;
  pointer-events: none; gap: 8px;
}
.scroll-track {
  width: 1px; height: 52px;
  background: transparent;
  position: relative; overflow: hidden;
}
.scroll-swipe-line {
  width: 1px; height: 32px;
  background: linear-gradient(to bottom, transparent, {{ section.settings.text_color }} 50%, transparent);
  position: absolute; top: -32px;
  animation: luxSwipe-{{ sid }} 1.8s cubic-bezier(0.4,0,0.6,1) infinite;
}
@keyframes luxSwipe-{{ sid }} {
  0%   { top: -32px; opacity: 0; }
  15%  { opacity: 1; }
  85%  { opacity: 1; }
  100% { top: 52px;  opacity: 0; }
}

/* ── Social glass buttons ── */
.social-glass-wrap-{{ sid }} {
  position: absolute; z-index: 30; display: flex; gap: 8px;
  flex-direction: {{ section.settings.social_direction }};
}
.social-glass-btn {
  display: flex; align-items: center; justify-content: center;
  text-decoration: none; gap: 8px;
  backdrop-filter: blur(14px) saturate(1.8);
  -webkit-backdrop-filter: blur(14px) saturate(1.8);
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.18);
  color: {{ section.settings.social_color }};
  box-shadow: 0 2px 16px rgba(0,0,0,0.14);
  font-size: 0.7rem; letter-spacing: 0.1em;
  text-transform: uppercase; font-weight: 500; white-space: nowrap;
  transition: background 0.28s ease, border-color 0.28s ease, transform 0.22s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.28s ease;
}
.social-glass-btn:hover {
  background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.38);
  transform: translateY(-2px) scale(1.03); box-shadow: 0 6px 28px rgba(0,0,0,0.22);
}
.social-glass-btn svg { flex-shrink: 0; fill: currentColor; }

/* ── Floating text overlays ── */
.text-overlay-block { position: absolute; z-index: 25; pointer-events: none; line-height: 1.3; }

/* ── About trigger pill ── */
.about-trigger-{{ sid }} {
  position: absolute; z-index: 30;
  display: inline-flex; align-items: center; gap: 7px;
  cursor: pointer; text-decoration: none;
  backdrop-filter: blur(14px) saturate(1.6);
  -webkit-backdrop-filter: blur(14px) saturate(1.6);
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.2);
  color: {{ section.settings.text_color }};
  transition: background 0.28s ease, border-color 0.28s ease, transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
  font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 400;
}
.about-trigger-{{ sid }}:hover {
  background: rgba(255,255,255,0.16); border-color: rgba(255,255,255,0.4); transform: translateY(-2px);
}

/* ── About modal ── */
.about-modal-backdrop-{{ sid }} {
  position: fixed; inset: 0; z-index: 9999;
  background: rgba(0,0,0,0.52);
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.32s ease; padding: 20px;
}
.about-modal-backdrop-{{ sid }}.is-open { opacity: 1; pointer-events: all; }
.about-modal-card-{{ sid }} {
  position: relative;
  background: {{ section.settings.about_card_bg }};
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: {{ section.settings.about_card_radius }}px;
  padding: 52px 48px 48px;
  max-width: {{ section.settings.about_card_width }}px; width: 100%;
  color: {{ section.settings.about_text_color }};
  box-shadow: 0 32px 80px rgba(0,0,0,0.48);
  transform: translateY(24px) scale(0.98);
  transition: transform 0.42s cubic-bezier(0.22,1,0.36,1), opacity 0.32s ease;
  opacity: 0;
  {%- if section.settings.about_font != blank %}font-family: '{{ section.settings.about_font }}', sans-serif;{%- endif %}
}
.about-modal-backdrop-{{ sid }}.is-open .about-modal-card-{{ sid }} { transform: translateY(0) scale(1); opacity: 1; }
.about-close-btn-{{ sid }} {
  position: absolute; top: 18px; right: 20px;
  width: 34px; height: 34px; background: transparent; border: none; cursor: pointer;
  color: {{ section.settings.about_text_color }}; opacity: 0.4;
  display: flex; align-items: center; justify-content: center;
  transition: opacity 0.2s ease, transform 0.25s ease; padding: 0; border-radius: 50%;
}
.about-close-btn-{{ sid }}:hover { opacity: 1; transform: rotate(90deg); }
.about-eyebrow-{{ sid }} { font-size: 0.68rem; letter-spacing: 0.28em; text-transform: uppercase; opacity: 0.42; margin: 0 0 12px; }
.about-store-name-{{ sid }} {
  font-size: clamp(1.8rem, 4vw, {{ section.settings.about_title_size }}rem);
  font-weight: {{ section.settings.about_title_weight }};
  line-height: 1.08; margin: 0 0 18px; letter-spacing: -0.02em;
}
.about-divider-{{ sid }} { width: 36px; height: 1px; background: {{ section.settings.about_accent_color }}; margin: 0 0 20px; }
.about-description-{{ sid }} { font-size: 0.93rem; line-height: 1.78; opacity: 0.75; margin: 0 0 26px; }
.about-cta-link-{{ sid }} {
  display: inline-flex; align-items: center; gap: 10px;
  color: {{ section.settings.about_accent_color }};
  text-decoration: none; font-size: 0.76rem; letter-spacing: 0.22em;
  text-transform: uppercase; font-weight: 600; transition: gap 0.25s ease;
}
.about-cta-link-{{ sid }}:hover { gap: 16px; }
.about-social-row-{{ sid }} { display: flex; gap: 12px; margin-top: 22px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,0.07); }
.about-social-icon-{{ sid }} {
  width: 34px; height: 34px; border-radius: 50%;
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: center;
  color: {{ section.settings.about_text_color }}; text-decoration: none;
  transition: background 0.22s ease, transform 0.22s ease;
}
.about-social-icon-{{ sid }}:hover { background: rgba(255,255,255,0.14); transform: translateY(-2px); }

/* ── Video pause button ── */
.vid-pause-btn-{{ sid }} {
  position: absolute; bottom: 22px; right: 22px; z-index: 25;
  width: 38px; height: 38px;
  background: transparent; border: none; border-radius: 50%;
  cursor: pointer; display: none;
  align-items: center; justify-content: center;
  color: rgba(255,255,255,0.5); padding: 0;
  transition: color 0.2s ease, opacity 0.45s ease, background 0.2s ease;
}
.vid-pause-btn-{{ sid }}.is-visible { display: flex; }
.vid-pause-btn-{{ sid }}.is-faded { opacity: 0; pointer-events: none; }
.vid-pause-btn-{{ sid }}:hover { color: rgba(255,255,255,0.95); background: rgba(0,0,0,0.2); }
.vid-pause-btn-{{ sid }} .icon-pause { display: block; }
.vid-pause-btn-{{ sid }} .icon-play  { display: none; }
.vid-pause-btn-{{ sid }}.is-paused .icon-pause { display: none; }
.vid-pause-btn-{{ sid }}.is-paused .icon-play  { display: block; }

/* ── Signature wall ── */
.sig-wall-canvas-{{ sid }} {
  position: absolute; inset: 0; z-index: 15; overflow: hidden;
  pointer-events: none; opacity: 0;
  transition: opacity 0.75s cubic-bezier(0.22,1,0.36,1);
}
.sig-wall-canvas-{{ sid }}.is-visible { opacity: 1; }
.sig-wall-canvas-{{ sid }}::before {
  content: ''; position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(ellipse 80% 60% at 50% 50%,
      {{ section.settings.wall_scrim_color }} {{ section.settings.wall_scrim_opacity | times: 0.6 | round }}%,
      transparent 100%),
    linear-gradient(to bottom,
      {{ section.settings.wall_scrim_color }} 0%,
      transparent 25%,
      transparent 75%,
      {{ section.settings.wall_scrim_color }} 100%);
  opacity: {{ section.settings.wall_scrim_opacity | divided_by: 100.0 }};
}
.sig-name {
  position: absolute;
  white-space: nowrap;
  line-height: 1;
  z-index: 1;
  font-size:      var(--sz);
  color:          var(--cl);
  opacity:        var(--op);
  font-family:    var(--ff);
  font-weight:    var(--fw);
  letter-spacing: var(--ls);
  transform:      rotate(var(--rot)) translate(-50%, -50%);
  top:            var(--ty);
  left:           var(--tx);
  text-shadow:
    0 0 18px rgba(0,0,0,0.8),
    0 2px 6px rgba(0,0,0,0.7),
    0 0 2px rgba(0,0,0,0.9);
  cursor: default;
  user-select: none; -webkit-user-select: none;
  animation: sigFadeIn-{{ sid }} 0.55s cubic-bezier(0.22,1,0.36,1) both;
  animation-delay: var(--delay, 0ms);
}
@keyframes sigFadeIn-{{ sid }} {
  from { opacity: 0; transform: rotate(var(--rot)) translate(-50%, -46%) scale(0.92); }
  to   { opacity: var(--op); transform: rotate(var(--rot)) translate(-50%, -50%) scale(1); }
}

/* ══════════════════════════════════════
   SUPPORTERS BUTTON — social proof pill
   Shows real member count + avatar initials
   Conversion: concrete number, human signal,
   warm copy, frosted glass = premium feel
══════════════════════════════════════ */
.sig-wall-toggle-{{ sid }} {
  position: absolute; z-index: 30;
  display: inline-flex; align-items: center; gap: 10px;
  cursor: pointer;
  background: rgba(0,0,0,0.38);
  backdrop-filter: blur(18px) saturate(1.5);
  -webkit-backdrop-filter: blur(18px) saturate(1.5);
  border: 1px solid rgba(255,255,255,0.18);
  color: #fff;
  border-radius: {{ section.settings.wall_btn_radius }}px;
  padding: {{ section.settings.wall_btn_pad_y }}px {{ section.settings.wall_btn_pad_x }}px;
  font-size: {{ section.settings.wall_btn_size }}px;
  letter-spacing: 0.02em; text-transform: none; font-weight: 400;
  font-family: inherit; white-space: nowrap;
  top: {{ section.settings.wall_btn_y }}%;
  left: {{ section.settings.wall_btn_x }}%;
  transform: translate(-{{ section.settings.wall_btn_anchor_x }}%, -{{ section.settings.wall_btn_anchor_y }}%);
  transition: background 0.24s ease, border-color 0.24s ease,
    box-shadow 0.24s ease, transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
  box-shadow: 0 4px 24px rgba(0,0,0,0.22);
  -webkit-tap-highlight-color: transparent;
}
.sig-wall-toggle-{{ sid }}:hover {
  background: rgba(0,0,0,0.54);
  border-color: rgba(255,255,255,0.32);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  transform: translate(-{{ section.settings.wall_btn_anchor_x }}%, -{{ section.settings.wall_btn_anchor_y }}%) translateY(-2px);
}
.sig-wall-toggle-{{ sid }}:active {
  transform: translate(-{{ section.settings.wall_btn_anchor_x }}%, -{{ section.settings.wall_btn_anchor_y }}%) scale(0.97);
  transition-duration: 0.08s;
}
.sig-wall-toggle-{{ sid }}.wall-open {
  background: rgba(0,0,0,0.56);
  border-color: rgba(255,255,255,0.28);
}
/* Group icon */
.sig-toggle-icon-{{ sid }} {
  flex-shrink: 0; opacity: 0.75;
  transition: opacity 0.2s ease;
}
.sig-wall-toggle-{{ sid }}:hover .sig-toggle-icon-{{ sid }} { opacity: 1; }
/* Show/hide states */
.sig-wall-toggle-{{ sid }} .label-show { display: inline; }
.sig-wall-toggle-{{ sid }} .label-hide { display: none; }
.sig-wall-toggle-{{ sid }}.wall-open .label-show { display: none; }
.sig-wall-toggle-{{ sid }}.wall-open .label-hide { display: inline; }

/* ── Add my name pill ── */
.sig-addname-btn-{{ sid }} {
  position: absolute; z-index: 30;
  display: inline-flex; align-items: center; gap: 7px;
  cursor: pointer;
  background: {{ section.settings.about_accent_color }};
  border: none; color: #000;
  font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
  white-space: nowrap; padding: 10px 20px; border-radius: 50px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.22), 0 6px 24px rgba(0,0,0,0.18);
  opacity: 0; pointer-events: none;
  top: {{ section.settings.addname_pos_y }}%;
  left: {{ section.settings.addname_pos_x }}%;
  transform: translate(-{{ section.settings.addname_anchor_x }}%, -{{ section.settings.addname_anchor_y }}%);
  transition: opacity 0.28s ease, box-shadow 0.22s ease,
    transform 0.28s cubic-bezier(0.34,1.56,0.64,1);
  -webkit-tap-highlight-color: transparent;
}
.sig-addname-btn-{{ sid }}.is-visible { opacity: 1; pointer-events: all; }
.sig-addname-btn-{{ sid }}:hover {
  box-shadow: 0 4px 14px rgba(0,0,0,0.3), 0 10px 32px rgba(0,0,0,0.24);
  transform: translate(-{{ section.settings.addname_anchor_x }}%, -{{ section.settings.addname_anchor_y }}%) translateY(-2px) scale(1.04);
}
.sig-addname-btn-{{ sid }}:active {
  transform: translate(-{{ section.settings.addname_anchor_x }}%, -{{ section.settings.addname_anchor_y }}%) scale(0.97);
}
.sig-addname-btn-{{ sid }} svg { transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1); }
.sig-addname-btn-{{ sid }}:hover svg { transform: rotate(90deg); }

/* ══════════════════════════════════════
   ADD MY NAME POPOUT
   FIX: Card + backdrop live on document.body — appended by JS on first open.
   This escapes the hero's overflow:hidden + transform stacking context
   which was trapping position:fixed children and pushing hero layout.
══════════════════════════════════════ */
.addname-backdrop-{{ sid }} {
  position: fixed; inset: 0; z-index: 9998;
  background: transparent;
  display: none;
}
.addname-backdrop-{{ sid }}.is-open { display: block; }

.addname-card-{{ sid }} {
  /* position:absolute on document.body — JS sets top/left via scroll-aware coords */
  position: absolute;
  z-index: 9999;
  background: linear-gradient(160deg,rgba(18,18,18,0.88) 0%,rgba(10,10,10,0.92) 100%);
  backdrop-filter: blur(32px) saturate(2);
  -webkit-backdrop-filter: blur(32px) saturate(2);
  border: none;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.12),inset 0 -1px 0 rgba(0,0,0,0.3),
    0 8px 32px rgba(0,0,0,0.4),0 24px 64px rgba(0,0,0,0.35),0 0 0 1px rgba(255,255,255,0.08);
  border-radius: 20px;
  padding: 22px 22px 20px;
  width: 280px;
  color: {{ section.settings.about_text_color }};
  transform-origin: top center;
  transform: scaleY(0.85) translateY(-8px);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.32s cubic-bezier(0.22,1,0.36,1), opacity 0.24s ease;
}
.addname-card-{{ sid }}::before {
  content: '';
  position: absolute; top: -7px; left: 50%; transform: translateX(-50%);
  width: 14px; height: 14px;
  background: rgba(22,22,22,0.92);
  border-top: 1px solid rgba(255,255,255,0.1);
  border-left: 1px solid rgba(255,255,255,0.1);
  clip-path: polygon(0 100%, 50% 0, 100% 100%);
}
.addname-card-{{ sid }}.is-open {
  transform: scaleY(1) translateY(0);
  opacity: 1; pointer-events: all;
}
.addname-close-{{ sid }} {
  position: absolute; top: 12px; right: 14px;
  width: 28px; height: 28px; background: transparent; border: none; cursor: pointer;
  color: rgba(255,255,255,0.35);
  display: flex; align-items: center; justify-content: center;
  transition: color 0.18s ease, transform 0.22s ease;
  padding: 0; border-radius: 50%;
}
.addname-close-{{ sid }}:hover { color: rgba(255,255,255,0.9); transform: rotate(90deg); }
.addname-heading-{{ sid }} {
  font-size: 0.88rem; font-weight: 500; letter-spacing: 0.06em;
  margin: 0 0 4px; color: rgba(255,255,255,0.9);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
}
.addname-sub-{{ sid }} { font-size: 0.72rem; opacity: 0.42; margin: 0 0 16px; line-height: 1.5; }
.addname-field-{{ sid }} {
  width: 100%; box-sizing: border-box;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 10px; padding: 10px 12px;
  color: {{ section.settings.about_text_color }};
  font-size: 0.82rem; font-family: inherit; outline: none;
  transition: border-color 0.2s ease, background 0.2s ease;
  margin-bottom: 10px; -webkit-appearance: none;
}
.addname-field-{{ sid }}::placeholder { opacity: 0.32; color: {{ section.settings.about_text_color }}; }
.addname-field-{{ sid }}:focus { border-color: {{ section.settings.about_accent_color }}; background: rgba(255,255,255,0.1); }
.addname-field-{{ sid }}.field-error { border-color: #e05c5c; }
.addname-error-msg-{{ sid }} { font-size: 0.7rem; color: #e07a7a; margin: -6px 0 8px 2px; display: none; }
.addname-error-msg-{{ sid }}.visible { display: block; }
.addname-consent-{{ sid }} { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 14px; cursor: pointer; }
.addname-consent-{{ sid }} input[type="checkbox"] {
  flex-shrink: 0; width: 13px; height: 13px; margin-top: 2px;
  accent-color: {{ section.settings.about_accent_color }}; cursor: pointer;
}
.addname-consent-label-{{ sid }} { font-size: 0.68rem; opacity: 0.4; line-height: 1.45; }
.addname-consent-label-{{ sid }} a { color: {{ section.settings.about_accent_color }}; text-decoration: none; }
.addname-submit-{{ sid }} {
  width: 100%; padding: 12px;
  background: {{ section.settings.about_accent_color }};
  color: #000; border: none; border-radius: 10px;
  font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
  font-weight: 700; cursor: pointer; font-family: inherit;
  transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.34,1.56,0.64,1);
}
.addname-submit-{{ sid }}:hover:not(:disabled) { opacity: 0.88; transform: translateY(-1px); }
.addname-submit-{{ sid }}:active:not(:disabled) { transform: scale(0.97); }
.addname-submit-{{ sid }}:disabled { opacity: 0.35; cursor: not-allowed; }
.addname-success-{{ sid }} { display: none; text-align: center; padding: 8px 0 4px; }
.addname-success-{{ sid }}.visible { display: block; }
.addname-success-icon-{{ sid }} {
  width: 40px; height: 40px; border-radius: 50%;
  background: {{ section.settings.about_accent_color }};
  display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;
}
.addname-success-title-{{ sid }} { font-size: 1rem; font-weight: 400; margin: 0 0 6px; }
.addname-success-body-{{ sid }} { font-size: 0.76rem; opacity: 0.45; line-height: 1.55; margin: 0; }
.addname-form-{{ sid }} { transition: opacity 0.2s ease; }
</style>

<section class="hero-{{ sid }}" id="Hero-{{ sid }}">

  <div class="hero-media-{{ sid }}">
    {%- if section.settings.video_link != blank -%}
      {%- if section.settings.video_poster != blank -%}
        {%- assign poster_alt = section.settings.video_poster.alt | default: '' -%}
        {%- assign poster_src = section.settings.video_poster | image_url: width: 1920 -%}
        <img
          id="hero-poster-img-{{ sid }}"
          class="hero-poster-{{ sid }}"
          src="{{ poster_src }}"
          alt="{{ poster_alt }}"
          loading="eager"
          fetchpriority="high"
          width="{{ section.settings.video_poster.width }}"
          height="{{ section.settings.video_poster.height }}"
        >
      {%- endif -%}
      <video id="hero-video-{{ sid }}" class="hero-asset"
        src="{{ section.settings.video_link }}"
        {%- if section.settings.video_poster != blank %} poster="{{ section.settings.video_poster | image_url: width: 1920 }}"{% endif %}
        autoplay muted loop playsinline webkit-playsinline x5-playsinline
        preload="none" disablepictureinpicture disableremoteplayback
        controlslist="nodownload nofullscreen noremoteplayback"
        x-webkit-airplay="deny">
      </video>
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3000 | image_tag: class: 'hero-asset', loading: 'eager', fetchpriority: 'high' }}
    {%- endif -%}
  </div>

  <div class="hero-overlay-{{ sid }}"></div>

  {%- if section.settings.wall_names != blank -%}
    {%- assign wall_names_arr = section.settings.wall_names | split: ',' -%}
    <div class="sig-wall-canvas-{{ sid }}" id="sig-wall-{{ sid }}" aria-hidden="true"></div>
    <script id="sig-wall-data-{{ sid }}" type="application/json">[{%- for n in wall_names_arr -%}{%- assign t = n | strip | escape -%}{%- unless t == blank -%}"{{ t }}"{%- unless forloop.last -%},{%- endunless -%}{%- endunless -%}{%- endfor -%}]</script>
  {%- endif -%}

  <div class="hero-content-{{ sid }}" id="content-{{ sid }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'heading' or block.type == 'text' or block.type == 'button' -%}
        <div style="width:100%;display:flex;flex-direction:column;align-items:inherit;">
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h1 class="hero-title" {{ block.shopify_attributes }}>{{ block.settings.title }}</h1>
            {%- when 'text' -%}
              <div style="margin-bottom:20px;font-size:1rem;line-height:1.7;opacity:0.8;" {{ block.shopify_attributes }}>{{ block.settings.subtext }}</div>
            {%- when 'button' -%}
              {%- assign bs = section.settings.btn_style -%}
              <a href="{{ block.settings.link }}"
                class="lux-btn {%- if bs == 'solid' %} lux-btn--solid{%- elsif bs == 'text' %} lux-btn--text{%- else %} lux-btn--ghost{%- endif %}"
                {{ block.shopify_attributes }}>
                {{- block.settings.label -}}
                {%- if bs == 'text' -%}<span class="btn-arrow" aria-hidden="true"> →</span>{%- endif -%}
              </a>
          {%- endcase -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- assign has_socials = false -%}
  {%- for block in section.blocks -%}{%- if block.type == 'social_link' -%}{%- assign has_socials = true -%}{%- endif -%}{%- endfor -%}
