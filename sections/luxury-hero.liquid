            style="width:{% if block.settings.show_label %}auto;padding:0 {{ bsz | divided_by: 2 }}px{% else %}{{ bsz }}px{% endif %};height:{{ bsz }}px;border-radius:{{ block.settings.pill_radius }}px;"
