          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'text_overlay' -%}
      <div class="text-overlay-block" style="top:{{ block.settings.pos_y }}%;left:{{ block.settings.pos_x }}%;font-size:{{ block.settings.font_size }}px;color:{{ block.settings.overlay_text_color }};opacity:{{ block.settings.text_opacity | divided_by: 100.0 }};font-weight:{{ block.settings.font_weight }};letter-spacing:{{ block.settings.letter_spacing | divided_by: 100.0 }}em;{%- if block.settings.uppercase %}text-transform:uppercase;{%- endif %}transform:rotate({{ block.settings.rotation }}deg) translate(-{{ block.settings.anchor_x }}%,-{{ block.settings.anchor_y }}%);max-width:{{ block.settings.max_width }}px;{%- if block.settings.font_family != blank %}font-family:'{{ block.settings.font_family }}',sans-serif;{%- endif %}line-height:{{ block.settings.line_height | divided_by: 10.0 }};" {{ block.shopify_attributes }}>{{ block.settings.overlay_text }}</div>
