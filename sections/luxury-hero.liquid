        {{ block.settings.btn_label }}
      </button>
      <div class="about-modal-backdrop-{{ sid }}" id="about-modal-{{ sid }}-{{ block.id }}" role="dialog" aria-modal="true">
        <div class="about-modal-card-{{ sid }}">
