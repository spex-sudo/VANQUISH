{% comment %}
  product-recommendations — restored section
  Original Horizon section was missing from the exported zip.
  Rebuilt by VANQUISH7 STUDIOS.

  Uses Shopify's recommendations API endpoint to render related products.
  Blocks accepted: _product-card, text.
{% endcomment %}

{%- liquid
  assign products_to_show = section.settings.products_to_show | default: 4
  assign heading = section.settings.heading | default: 'You may also like'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <product-recommendations
    class="product-recommendations"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ products_to_show }}&intent=related"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- if heading != blank -%}
        <h2 class="product-recommendations__heading">{{ heading | escape }}</h2>
      {%- endif -%}
      <div class="product-recommendations__grid" style="--columns: {{ products_to_show }};">
        {% content_for 'blocks' %}
        {%- for rp in recommendations.products limit: products_to_show -%}
          <a href="{{ rp.url }}" class="product-recommendations__card">
            {%- if rp.featured_image -%}
              {%- assign ph = 400 | divided_by: rp.featured_image.aspect_ratio | ceil -%}
              <img
                src="{{ rp.featured_image | image_url: width: 600 }}"
                srcset="{{ rp.featured_image | image_url: width: 300 }} 300w, {{ rp.featured_image | image_url: width: 600 }} 600w, {{ rp.featured_image | image_url: width: 900 }} 900w"
                sizes="(min-width: 1024px) 25vw, 50vw"
                alt="{{ rp.featured_image.alt | escape | default: rp.title | escape }}"
                loading="lazy"
                width="400"
                height="{{ ph }}"
              >
            {%- endif -%}
            <div class="product-recommendations__meta">
              <span class="product-recommendations__title">{{ rp.title | escape }}</span>
              <span class="product-recommendations__price">{{ rp.price | money }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </product-recommendations>
</div>

<style>
  .product-recommendations__grid { display: grid; grid-template-columns: repeat(var(--columns, 4), 1fr); gap: 20px; }
  .product-recommendations__heading { text-align: center; margin: 0 0 24px; }
  .product-recommendations__card { display: block; text-decoration: none; color: inherit; }
  .product-recommendations__card img { width: 100%; height: auto; display: block; border-radius: var(--card-corner-radius, 2px); }
  .product-recommendations__meta { margin-top: 8px; display: flex; justify-content: space-between; font-size: 14px; }
  @media (max-width: 749px) { .product-recommendations__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2, "max": 10, "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0, "max": 100, "step": 2, "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0, "max": 100, "step": 2, "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "@theme" },
    { "type": "_product-card" },
    { "type": "text" }
  ],
  "presets": [
    {
      "name": "Product recommendations",
      "category": "Product",
      "settings": { "heading": "You may also like", "products_to_show": 4 }
    }
  ]
}
{% endschema %}
