{% comment %}
  LEXE / VANQUISH — Ultra Contact Form
  Research-backed high-conversion contact section
  Drop on any page. Fully theme-editor controllable.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign form_id = 'LexeContactForm-' | append: sid
  assign heading = section.settings.heading | default: 'Get in touch'
  assign subheading = section.settings.subheading | default: 'We reply within 24 hours. No spam, ever.'
  assign cta_label = section.settings.cta_label | default: 'Send message'
  assign success_msg = section.settings.success_message | default: 'Message received. We’ll get back to you within 24 hours.'
-%}

<section
  id="lexe-contact-{{ sid }}"
  class="lexe-contact"
  style="
    --lc-bg: {{ section.settings.bg_color }};
    --lc-card: {{ section.settings.card_color }};
    --lc-text: {{ section.settings.text_color }};
    --lc-muted: {{ section.settings.muted_color }};
    --lc-accent: {{ section.settings.accent_color }};
    --lc-border: {{ section.settings.border_color }};
    --lc-radius: {{ section.settings.radius }}px;
    --lc-pad: {{ section.settings.padding }}px;
  "
>
  <div class="lexe-contact__inner">
    <div class="lexe-contact__header">
      {%- if heading != blank -%}
        <h2 class="lexe-contact__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="lexe-contact__sub">{{ subheading }}</p>
      {%- endif -%}
    </div>

    {%- form 'contact', id: form_id, class: 'lexe-contact__form' -%}

      {%- if form.posted_successfully? -%}
        <div class="lexe-contact__success" role="status">
          <div class="lexe-contact__success-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <p>{{ success_msg }}</p>
        </div>
      {%- else -%}

        {%- if form.errors -%}
          <div class="lexe-contact__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <!-- Honeypot -->
        <div class="lexe-contact__hp" aria-hidden="true">
          <label for="contact-website-{{ sid }}">Website</label>
          <input type="text" name="contact[website]" id="contact-website-{{ sid }}" tabindex="-1" autocomplete="off">
        </div>

        <div class="lexe-contact__fields">

          <!-- Name -->
          <div class="lexe-contact__field">
            <label class="lexe-contact__label" for="ContactForm-name-{{ sid }}">Name</label>
            <input
              type="text"
              id="ContactForm-name-{{ sid }}"
              name="contact[name]"
              class="lexe-contact__input"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder=" "
              required
            >
          </div>

          <!-- Email -->
          <div class="lexe-contact__field">
            <label class="lexe-contact__label" for="ContactForm-email-{{ sid }}">
              Email <span class="lexe-contact__req">*</span>
            </label>
            <input
              type="email"
              id="ContactForm-email-{{ sid }}"
              name="contact[email]"
              class="lexe-contact__input"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder=" "
              required
              aria-required="true"
            >
          </div>

          {%- if section.settings.show_phone -%}
            <div class="lexe-contact__field">
              <label class="lexe-contact__label" for="ContactForm-phone-{{ sid }}">Phone <span class="lexe-contact__opt">(optional)</span></label>
              <input
                type="tel"
                id="ContactForm-phone-{{ sid }}"
                name="contact[phone]"
                class="lexe-contact__input"
                autocomplete="tel"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder=" "
              >
            </div>
          {%- endif -%}

          {%- if section.settings.show_topic -%}
            <div class="lexe-contact__field">
              <label class="lexe-contact__label" for="ContactForm-topic-{{ sid }}">Topic</label>
              <div class="lexe-contact__select-wrap">
                <select id="ContactForm-topic-{{ sid }}" name="contact[topic]" class="lexe-contact__input lexe-contact__select">
                  <option value="" disabled selected>Select a topic</option>
                  <option value="Order status">Order status</option>
                  <option value="Returns / Refunds">Returns / Refunds</option>
                  <option value="Product question">Product question</option>
                  <option value="Collaboration">Collaboration</option>
                  <option value="Other">Other</option>
                </select>
                <span class="lexe-contact__chevron" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
                </span>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_order -%}
            <div class="lexe-contact__field">
              <label class="lexe-contact__label" for="ContactForm-order-{{ sid }}">Order number <span class="lexe-contact__opt">(optional)</span></label>
              <input
                type="text"
                id="ContactForm-order-{{ sid }}"
                name="contact[order_number]"
                class="lexe-contact__input"
                placeholder=" "
              >
            </div>
          {%- endif -%}

          <!-- Message -->
          <div class="lexe-contact__field lexe-contact__field--full">
            <label class="lexe-contact__label" for="ContactForm-body-{{ sid }}">Message</label>
            <textarea
              id="ContactForm-body-{{ sid }}"
              name="contact[body]"
              class="lexe-contact__input lexe-contact__textarea"
              rows="5"
              placeholder=" "
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
        </div>

        <div class="lexe-contact__footer">
          <button type="submit" class="lexe-contact__submit">
            <span>{{ cta_label }}</span>
            <svg class="lexe-contact__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <p class="lexe-contact__trust">{{ section.settings.trust_text | default: 'We reply by email · Usually within 24 hours' }}</p>
        </div>

      {%- endif -%}
    {%- endform -%}
  </div>
</section>

<style>
  #lexe-contact-{{ sid }} {
    --lc-gap: 1.25rem;
    background: var(--lc-bg);
    color: var(--lc-text);
    padding: var(--lc-pad) 1.25rem;
    font-family: inherit;
  }

  #lexe-contact-{{ sid }} .lexe-contact__inner {
    max-width: 520px;
    margin: 0 auto;
  }

  #lexe-contact-{{ sid }} .lexe-contact__header {
    text-align: center;
    margin-bottom: 2.25rem;
  }

  #lexe-contact-{{ sid }} .lexe-contact__heading {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    line-height: 1.15;
  }

  #lexe-contact-{{ sid }} .lexe-contact__sub {
    margin: 0;
    color: var(--lc-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  #lexe-contact-{{ sid }} .lexe-contact__form {
    background: var(--lc-card);
    border: 1px solid var(--lc-border);
    border-radius: var(--lc-radius);
    padding: 1.75rem 1.5rem 1.5rem;
    box-shadow: 0 12px 40px -12px rgba(0,0,0,0.25);
  }

  #lexe-contact-{{ sid }} .lexe-contact__fields {
    display: flex;
    flex-direction: column;
    gap: var(--lc-gap);
  }

  #lexe-contact-{{ sid }} .lexe-contact__field {
    position: relative;
  }

  #lexe-contact-{{ sid }} .lexe-contact__label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--lc-muted);
    margin-bottom: 0.4rem;
    letter-spacing: 0.01em;
  }

  #lexe-contact-{{ sid }} .lexe-contact__req {
    color: var(--lc-accent);
  }

  #lexe-contact-{{ sid }} .lexe-contact__opt {
    font-weight: 400;
    opacity: 0.7;
  }

  #lexe-contact-{{ sid }} .lexe-contact__input {
    width: 100%;
    appearance: none;
    background: transparent;
    border: 1px solid var(--lc-border);
    border-radius: calc(var(--lc-radius) - 4px);
    padding: 0.9rem 1rem;
    font-size: 1rem;
    color: var(--lc-text);
    line-height: 1.4;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    min-height: 52px;
  }

  #lexe-contact-{{ sid }} .lexe-contact__input:focus {
    outline: none;
    border-color: var(--lc-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--lc-accent) 22%, transparent);
  }

  #lexe-contact-{{ sid }} .lexe-contact__textarea {
    resize: vertical;
    min-height: 140px;
    padding-top: 0.9rem;
  }

  #lexe-contact-{{ sid }} .lexe-contact__select-wrap {
    position: relative;
  }

  #lexe-contact-{{ sid }} .lexe-contact__select {
    padding-right: 2.5rem;
    cursor: pointer;
  }

  #lexe-contact-{{ sid }} .lexe-contact__chevron {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--lc-muted);
  }

  #lexe-contact-{{ sid }} .lexe-contact__footer {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  #lexe-contact-{{ sid }} .lexe-contact__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 54px;
    padding: 0.9rem 1.5rem;
    background: var(--lc-accent);
    color: #111;
    border: none;
    border-radius: calc(var(--lc-radius) - 2px);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.15s ease, box-shadow 0.2s ease;
  }

  #lexe-contact-{{ sid }} .lexe-contact__submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px -6px color-mix(in srgb, var(--lc-accent) 55%, transparent);
  }

  #lexe-contact-{{ sid }} .lexe-contact__submit:active {
    transform: translateY(0);
  }

  #lexe-contact-{{ sid }} .lexe-contact__arrow {
    transition: transform 0.2s ease;
  }

  #lexe-contact-{{ sid }} .lexe-contact__submit:hover .lexe-contact__arrow {
    transform: translateX(3px);
  }

  #lexe-contact-{{ sid }} .lexe-contact__trust {
    margin: 0;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--lc-muted);
  }

  #lexe-contact-{{ sid }} .lexe-contact__success {
    text-align: center;
    padding: 2.5rem 1rem;
  }

  #lexe-contact-{{ sid }} .lexe-contact__success-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--lc-accent) 15%, transparent);
    color: var(--lc-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lexe-contact-{{ sid }} .lexe-contact__success p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  #lexe-contact-{{ sid }} .lexe-contact__error {
    background: #2a1215;
    border: 1px solid #5c2a30;
    color: #f5c2c7;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }

  /* Honeypot */
  #lexe-contact-{{ sid }} .lexe-contact__hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    #lexe-contact-{{ sid }} .lexe-contact__form {
      padding: 2rem 2rem 1.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "LEXE Contact Form",
  "tag": "section",
  "class": "section-lexe-contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We reply within 24 hours. No spam, ever."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Message received. We’ll get back to you within 24 hours."
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust line under button",
      "default": "We reply by email · Usually within 24 hours"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_topic",
      "label": "Show topic dropdown",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_order",
      "label": "Show order number field",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#0c0c0c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#9a9a9a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Button",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Section padding (vertical)",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "LEXE Contact Form",
      "category": "Forms"
    }
  ]
}
{% endschema %}
